#%RAML 1.0 DataType

properties:
  InvokeServiceProvisioningOutput:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System:
            type: object
            properties:
              name:
                type: string
                required: true
              correlationID:
                type: string
                required: true
              processingServer:
                type: string
                required: true
          Service:
            type: object
            properties:
              status:
                type: string
              responseDate:
                type: string
      BodyResponse:
        type: object
        properties:
          response:
            type: object
            properties:
              operation:
                type: string
              result:
                type: string
              system:
                type: string
