#%RAML 1.0 DataType
properties:
  response:
    type: object
    properties:
      system:
        type: string
        example: "RevChain"
      operation:
        type: string
        example: "S"
      result:
        type: string
        example: "S"
      faults:
        type: object
        properties:
          subscriber_data:
            type: object
            properties:
              billing_entity_id:
                type: string
                example: "96"
              billing_prnt_sub_id:
                type: string
                example: ""
              invoice_day:
                type: string
                example: "4"
              reason_code:
                type: string
                example: "5"
              market_type_name:
                type: string
                example: "Corporativo"
              subscriber_type_name: 
                type: string
                example: "Company"
              business_unit:
                type: string
                example: "1"
              period:
                type: string
                example: "Monthly"
              term_type_name:
                type: string
                example: "Monthly Payments"
              tax_plan_data:
                type: object
                properties:
                  type_name:
                    type: string
                    example: "PLAN DE IMPUESTOS ETB LTE"
                  tax_plan_vendor:
                    type: string
                    example: ""
              invoice_method_data:
                type: object
                properties:
                  bill_or_statement:
                    type: string
                    example: "B"
                  invoice_method_name:
                    type: string
                    example: "Cuentas LTE Resumida"
                  invoice_format_name:
                    type: string
                    example: "Detailed Bill"
                  invoice_format_class_name:
                    type: string
                    example: "Bill"
          fault_detail:
            type: object
            properties:
              error_description:
                type: string
                example: "operation is successful"
              error_code:
                type: string
                example: "0"
example:
      !include ../../examples/responses/CycleResp.json
                      
