#%RAML 1.0 DataType

properties:
  InvokeServiceProvisioningOutput:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System: 
            type: object
            properties:
              name:
                type: string
              correlationID:
                type: string
              processingServer:
                type: string
          Service:
            type: object
            properties:
              status:
                type: string
              responseDate:
                type: string
              statusDetail:
                type: object
                properties:
                  errorCode:
                    type: string
                  errorMessage:
                    type: string
      BodyResponse:
        type: object  
        properties:
          response:
            type: object
            properties:
              operation:
                type: string
              result:
                type: string
              system:
                type: string
              faults:
                type: object
                properties:
                  fault_detail:
                    type: string