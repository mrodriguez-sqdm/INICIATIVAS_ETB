#%RAML 1.0 DataType
properties:
  operation:
        type: string
        example: "S"
  system:
        type: string
        example: "RevChain"
  result:
    type: string
    example: "S"
  faults:
    type: object
    properties:
      subscriber_id:
        type: string
        example: "12054124652"
      fault_detail:
        type: object
        properties:
          error_description:
            type: string
            example: "operation is successful"
          error_code:
            type: string
            example: "0"

example:
  !include ../../examples/responses/CreateSubscriberResp.json