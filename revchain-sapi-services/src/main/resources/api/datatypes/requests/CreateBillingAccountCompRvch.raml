#%RAML 1.0 DataType
type:
  properties:
    sfilluminate:
      type: object
      properties:
        operacion:
          type: string
          example: "servicio_av"
        orden_om:
          type: string
          example: "OM-12365478"
        orden_comercial:
          type: string
          example: "OC-12388552"
        cuenta:
          type: object
          properties:
            cuenta_padre:
              type: string
              example: ""
            business_unit:
              type: string
              example: "1"
            fecha_inicio:
              type: string
              example: "dd/mm/yyyy"
            corte:
              type: string
              example: ""
            ciclo:
              type: string
              example: ""
            periodo:
              type: string
              example: "Monthly"
            term_type_name:
              type: string
              example: "Monthly Payments"
            nombres:
              type: string
              example: "ALEJANDRO"
            apellidos:
              type: string
              example: "TEST"
            nombre_cuenta:
              type: string
              example: "ALEJANDRO TEST"
            facturable:
              type: string
              example: "True"
            cod_ciudad:
              type: string
              example: "11001"
            direccion:
              type: string
              example: "KR 54D 135 06 TO 1 AP 904"
            pais:
              type: string
              example: "COL"
            cod_departamento:
              type: string
              example: "11"
            currency_code:
              type: string
              example: "COP"
            tipo_doc:
              type: string
              example: "CC"
            num_doc:
              type: string
              example: "18235616"
            dig_verificacion:
              type: string
              example: ""
            bill_or_statement:
              type: string
              example: "B"
            invoice_delivery_name:
              type: string
              example: "Electronica"
            invoice_format_name:
              type: string
              example: "Detallada"
            invoice_format_class_name:
              type: string
              example: "Bill"
            correo_electronico:
              type: string
              example: "alejandrocf33@gmail.com"

example:
  !include ../../examples/requests/CreateBillingAccountCompRvch.json