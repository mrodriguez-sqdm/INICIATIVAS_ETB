#%RAML 1.0 DataType
properties:
  "subscriber_particulars":
    type: object
    properties:
      "subscriber_data":
        type: object
        properties:
          "action": 
            type: string
            example: "add"
          "parent_id":
            type: array
          "billable_parent_id":
            type: array
          "business_unit":
            type: string
            example: "1"
          "invoice_day": 
            type: string
            example: "4"
          "market_type_name":
            type: string
            example: "Corporativo"
          "reason_code":
            type: string
            example: "5"
          "period":
            type: string
            example: "Monthly"
          "subscriber_type_name":
            type: string
            example: "Company"
          "term_type_name":
            type: string
            example: "Monthly Payments"
          "first_name":
            type: string
            example: "COMPAIA"
          "last_name":
            type: string
            example: "MOVIL"
          "subscriber_name":
            type: string
            example: "COMPAIA DE SEGUROS BOLIVAR TRONCAL SIP MOVIL"
          "subscriber_info1":
            type: array
          "subscriber_info2":
            type: array
          "subscriber_info4":
            type: string
            example: "11001000"
          "billing_entity_id":
            type: string
            example: "96"
          "start_date": 
            type: object
            properties:
              "month":
                type: string
                example: "10"
              "day":
                type: string
                example: "30"
              "year":
                type: string
                example: "2013"
          "billable":
            type: string
            example: "T"
      "tax_plan_data": 
        type: object
        properties:
          "action": 
            type: string
            example: "add"
          "type_name":
            type: string
            example: "PLAN DE IMPUESTOS ETB LTE"
          "geocode":
            type: string
            example: "11001000"
          "tax_plan_vendor":
            type: array
      "billing_address_data": 
        type: object
        properties:
          "action":
            type: string
            example: "add"
          "bill_address1":
            type: string
            example: "KR 10 28 49 TO A PI 4"
          "bill_address_geo_code":
            type: string
            example: "11001000"
          "bill_city":
            type: string
            example: "BOGOTÁ, D.C."
          "bill_country_code":
            type: string
            example: "COL"
          "bill_state_code":
            type: string
            example: "11"
          "bill_billing_name":
            type: string
            example: "COMPAIA DE SEGUROS BOLIVAR TRONCAL SIP MOVIL"
      "address_data":
        type: object
        properties: 
          "action":
            type: string
            example: "add"
          "address1":
            type: string
            example: "KR 10 28 49 TO A PI 4"
          "address_geo_code":
            type: string
            example: "11001000"
          "city":
            type: string
            example: "BOGOTÁ, D.C."
          "country_code":
            type: string
            example: "COL"
          "state_code":
            type: string
            example: "11"
      "currency_data": 
        type: object
        properties: 
          "action":
            type: string
            example: "add"
          "currency_code":
            type: string
            example: "COP"
      "phone1_data":
        type: object
        properties: 
          "action":
            type: string
            example: "add"
          "number1":
            type: string
            example: "13410077"
      "email_data":
        type: object
        properties: 
          "action":
            type: string
            example: "add"
          "email_address":
            type: string
            example: "yeimy.valencia@segurosbolivar.com"
      "characteristics_data":
        type: array
        items:
          type: object
          properties:
            "action":
              type: string
              example: "add"
            "characteristic_group":
              type: string
              example: "2000023"
            "characteristic_type":
              type: string
              example: "2000000"
            "characteristic_value":
              type: string
              example: "NIT" 
      "invoice_method_data":
        type: object
        properties:
          "action":
            type: string
            example: "add"
          "bill_or_statement":
            type: string
            example: "B"
          "invoice_method_name":
            type: string
            example: "Cuentas LTE Resumida"
          "invoice_delivery_name":
            type: string
            example: "Email"
          "invoice_format_name":
            type: string
            example: "Detailed Bill"
          "invoice_format_class_name":
            type: string
            example: "Bill"

example: !include ../../examples/requests/CreateSubscriberReq.json
