                              rate_plan_id:
                                type: string
                                description: "Shouldn't be used with rate_plan_name."
                                required: false
                              start_date:
                                type: complexDate
                                required: false
                              end_date:
                                type: complexDate
                                required: false
                              bill_through_date:
                                type: simpleDate
                                required: false
                        feature_agent:
                          type: array
                          required: false
                          items:
                            type: object
                            properties:
                              ref_id:
                                type: string
                                required: false
                              action:
                                type: string
                                required: false
                              result:
                                type: string
                                required: false
                              message:
                                type: string
                                required: false
                              id:
                                type: string
                                required: false
                              feat_agent_id:
                                type: string
                                required: false
                              agent_id:
                                type: string
                                required: false
                              start_date:
                                type: complexDate
                                required: false
                              end_date:
                                type: complexDate
                                required: false
                        partner:
                          type: array
                          required: false
                          items:
                            type: object
                            properties:
                              ref_id:
                                type: string
                                required: false
                              action:
                                type: string
                                required: false
                              result:
                                type: string
                                required: false
                              message:
                                type: string
                                required: false
                              id:
                                type: string
                                required: false
                              partner_id:
                                type: string
                                required: false
                              partner_subscriber_id:
                                type: string
                                required: false
                              partner_feature_id:
                                type: string
                                required: false
                              partner_service_id:
                                type: string
                                required: false
                              start_date:
                                type: complexDate
                                required: false
                              end_date:
                                type: complexDate
                                required: false
                              partner_rate:
                                type: array
                                required: false
                                items:
                                  type: object
                                  properties:
                                    action:
                                      type: string
                                      required: false
                                    result:
                                      type: string
                                      required: false
                                    message:
                                      type: string
                                      required: false
                                    id:
                                      type: string
                                      required: false
                                    partner_rate_id:
                                      type: string
                                      required: false
                                    step_number:
                                      type: string
                                      required: false
