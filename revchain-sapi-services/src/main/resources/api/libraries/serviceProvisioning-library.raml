                          type: finderType
                          description: "Shouldn't be used with service_connection_id."
                          required: false
                        connection_connection_number_id:
                          type: string
                          required: false
                        connection_type_name:
                          type: string
                          description: "Shouldn't be used with connection_type_id."
                          required: false
                        connection_type_id:
                          type: string
                          description: "Shouldn't be used with connection_type_name."
                          required: false
                        connection_number_type_name:
                          type: string
                          description: "Shouldn't be used with connection_number_type_id."
                          required: false
                        connection_number_type_id:
                          type: string
                          description: "Shouldn't be used with connection_number_type_name."
                          required: false
                        connection_number:
                          type: string
                          required: false
                        connection_description:
                          type: string
                          required: false
                        start_date:
                          type: complexDate
                          required: false
                        end_date:
                          type: complexDate
                          required: false
                        replace_connection_number:
                          type: object
                          required: false
                          properties:
                            connection_number:
                              type: string
                              required: true
                            connection_description:
                              type: string
                              required: false
                            replacement_date:
                              type: complexDate
                              required: true
                  deposit:
                    type: array
                    required: false
                    items:
                      type: object
                      properties:
                        action:
                          type: string
                          required: false
                        result:
                          type: string
                          required: false
                        message:
                          type: string
                          required: false
                        id:
                          type: string
                          required: false
