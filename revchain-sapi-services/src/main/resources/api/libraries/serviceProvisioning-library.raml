                          type: array
                          required: false
                          items:
                            type: object
                            properties:
                              action:
                                type: string
                                required: true
                              sub_curcy_exch_rate_finder:
                                type: object
                                required: false
                                properties:
                                  from_curcy_cd:
                                    type: string
                                    description: "Shouldn't be used with from_curcy_nm."
                                    required: false
                                  from_curcy_nm:
                                    type: string
                                    description: "Shouldn't be used with from_curcy_cd."
                                    required: false
                                  to_curcy_cd:
                                    type: string
                                    description: "Shouldn't be used with to_curcy_nm."
                                    required: false
                                  to_curcy_nm:
                                    type: string
                                    description: "Shouldn't be used with to_curcy_cd."
                                    required: false
                                  active_date:
                                    type: complexDate
                                    required: false
                              from_curcy_cd:
                                type: string
                                description: "Shouldn't be used with from_curcy_nm."
                                required: false
                              from_curcy_nm:
                                type: string
                                description: "Shouldn't be used with from_curcy_cd."
                                required: false
                              to_curcy_cd:
                                type: string
                                description: "Shouldn't be used with to_curcy_nm."
                                required: false
                              to_curcy_nm:
                                type: string
                                description: "Shouldn't be used with to_curcy_cd."
                                required: false
                              exch_rate_strt_date:
                                type: complexDate
                                required: false
                              exch_rate_end_date:
                                type: complexDate
                                required: false
                              exch_rate:
                                type: string
                                required: false
                  connection:
                    type: array
                    required: false
                    items:
                      type: object
                      properties:
                        ref_id:
                          type: string
                          required: false
                        action:
                          type: string
                          required: false
                        result:
                          type: string
                          required: false
                        message:
                          type: string
                          required: false
                        id:
                          type: string
                          required: false
                        service_connection_id:
                          type: string
                          description: "Shouldn't be used with finder."
                          required: false
