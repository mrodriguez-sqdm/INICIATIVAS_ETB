#%RAML 1.0 Library
types:
  servicesType:
    type: object
    properties:
      action:
        type: string
        required: false
      ref_id:
        type: string
        required: false
      service_particulars:
        type: array
        items:
          type: object
          properties:
            ref_id:
              type: string
              required: false
            subscriber_id:
              type: string
              required: true
            service:
              type: array
              required: false
              items:
                type: object
                properties:
                  ref_id:
                    type: string
                    required: false
                  action:
                    type: string
                    required: false
                  create_so:
                    type: string
                    required: false
                  holdServiceOrder:
                    type: string
                    required: false
                  result:
                    type: string
                    required: false
                  message:
                    type: string
                    required: false
                  id:
                    type: string
                    required: false
                  suspensionType:
                    type: string
                    required: false
                  service_id:
                    type: string
                    description: "Shouldn't be used with finder."
                    required: false
                  finder:
                    type: finderType
                    description: "Shouldn't be used with service_id."
                    required: false
                  service_type_name:
                    type: string
                    description: "Shouldn't be used with service_type_id."
                    required: false
                  service_type_id:
                    type: string
                    description: "Shouldn't be used with service_type_name."
                    required: false
                  nickname:
                    type: string
                    required: false
                  due_date:
                    type: complexDate
                    required: false
                  start_date: 
                    type: complexDate
                    required: false
                  end_date: 
                    type: complexDate
                    required: false
                  suspend_start_date: 
                    type: complexDate
                    required: false
                  suspend_end_date: 
                    type: complexDate
                    required: false
                  external_service_id:
                    type: string
                    required: false
                  service_transfer:
                    type: object
                    required: false
                    properties:
                      transfer_type:
                        type: string
                        required: true
                      transfer_to_subscriber:
                        type: string
                        required: true
                      transfer_date:
                        type: complexDate
                        required: true
                  user_name:
                    type: string
                    required: false
                  feature:
                    type: array
                    required: false
                    items:
                      type: object
                      properties:
                        ref_id:
                          type: string
                          required: false
                        action:
                          type: string
                          required: false
                        result:
                          type: string
                          required: false
                        message:
                          type: string
                          required: false
                        id:
                          type: string
                          required: false
                        suspensionType:
                          type: string
                          required: false
