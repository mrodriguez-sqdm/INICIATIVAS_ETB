                          type: string
                          required: false
                        last_refund_date:
                          type: complexDate
                          required: false
                        deposit_status:
                          type: string
                          required: false
                  suspension:
                    type: array
                    required: false
                    items:
                      type: object
                      properties:
                        suspension_id:
                          type: string
                          required: true

  finderType:
    type: object
    properties:
      external_service_id: 
        type: string
        required: false
      active_date:
        type: complexDate
        required: false

  complexDate:
    type: object
    properties:
      month:
        type: string
        required: true
      day:
        type: string
        required: true
      year:
        type: string
        required: true
      hour:
        type: string
        required: false
      minute:
        type: string
        required: false
      second:
        type: string
        required: false

  simpleDate:
    type: object
    properties:
      month:
        type: string
        required: true
      day:
        type: string
        required: true
      year:
        type: string
        required: true