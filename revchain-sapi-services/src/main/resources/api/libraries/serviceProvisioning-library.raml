                          type: finderType
                          description: "Shouldn't be used with feature_id."
                          required: false
                        feature_type_name:
                          type: string
                          description: "Shouldn't be used with feature_type_id."
                          required: false
                        feature_type_id:
                          type: string
                          description: "Shouldn't be used with feature_type_name."
                          required: false
                        start_date:
                          type: complexDate
                          required: false
                        end_date:
                          type: complexDate
                          required: false
                        suspend_start_date:
                          type: complexDate
                          required: false
                        suspend_end_date:
                          type: complexDate
                          required: false
                        last_invoice_date:
                          type: simpleDate
                          required: false
                        parameter:
                          type: array
                          required: false
                          items:
                            type: object
                            properties:
                              ref_id:
                                type: string
                                required: false
                              action:
                                type: string
                                required: false
                              result:
                                type: string
                                required: false
                              message:
                                type: string
                                required: false
                              id:
                                type: string
                                required: false
                              parameter_id:
                                type: string
                                required: false
                              parameter_type_name:
                                type: string
                                description: "Shouldn't be used with parameter_type_id."
                                required: false
                              parameter_type_id:
                                type: string
                                description: "Shouldn't be used with parameter_type_name."
                                required: false
                              parameter_value:
                                type: string
                                required: false
                              start_date:
                                type: complexDate
                                required: false
                              end_date:
                                type: complexDate
                                required: false
