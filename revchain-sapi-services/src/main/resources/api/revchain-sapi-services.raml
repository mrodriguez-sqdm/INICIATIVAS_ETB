#%RAML 1.0
title: revchain-sapi-services
version: v1
uses:
  billing-api-services: libraries/billing-api-services-library.raml
mediaType: 
  - application/json

traits:
  security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml


/v1:
  /cycles:
    post:  
    is: [security-client-id, tibcoHeaders]
    type: 
      billing-api-services.collection

  /subscribers:
    post:
    patch:
    is: [security-client-id, tibcoHeaders]
    type:
      billing-api-services.collection

  /billing_accounts:
    post:
    is: [security-client-id, tibcoHeaders]
    type:
      billing-api-services.collection

  /billing_operation:
    post:
    is: [security-client-id, tibcoHeaders]
    type:
      billing-api-services.collection
      
  /billingAdjustment:
    post:
    is: [security-client-id, tibcoHeaders]
    type:
      billing-api-services.collection

  /billing_products:
    post:
      is:
       - security-client-id
       - tibcoHeaders
      displayName: Billing Products
      description: Service to bill products in revchain
      body:
        type: !include datatypes/requests/BillingProducts.raml
      responses:
        200:
          body:
            type: !include datatypes/responses/CreateBillingOperationCompRvch.raml
  /orders:
    /{order_id}:
      patch:
        is:
          - security-client-id
          - tibcoHeaders
        displayName:        
        description: 
        body:
          application/json:
            type: !include datatypes/requests/PortabilityCompensationIntfRequest.raml
        responses: 
          201:
            body:
              application/json: 
                type: !include datatypes/responses/PortabilityCompensationIntfResponse200.raml
                
          400:
            body:
              application/json:
                type: !include datatypes/responses/PortabilityCompensationIntfResponse405.raml
                examples: 
                  example1: !include examples/responses/PortabilityCompensationIntfResponse405example1.json
                  example2: !include examples/responses/PortabilityCompensationIntfResponse405example2.json
                  example3: !include examples/responses/PortabilityCompensationIntfResponse405example3.json
                  example4: !include examples/responses/PortabilityCompensationIntfResponse405example4.json
          500:
            body:
              application/json:
                type: !include datatypes/responses/PortabilityCompensationIntfResponse500.raml           
        
  /tipologyRVC:
      patch:
        is:
          - security-client-id
          - tibcoHeaders
        body:
          application/xml:
            example: !include examples/requests/updateTipology.xml
        responses:
          200:
            body:
              application/json:
                example: !include examples/responses/updateTypologyResponse.json    
  /billing:
    /provisioning:
      /services:
        post:
          is:
            - security-client-id
            - tibcoHeaders
          displayName: Invoke Service Provisioning
          description: Invoke Service Provisioning
          body:
            application/json:
              !include datatypes/requests/invokeServiceProvisioningType.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/responses/invokeServiceProvisioningResponse201.raml
                  example: !include examples/responses/invokeServiceProvisioning201Response.json
            500:
              body:
                application/json:
                  type: !include datatypes/responses/invokeServiceProvisioningResponse500.raml
                  example: !include examples/responses/invokeServiceProvisioning500Response.json
    /concepts:
      get:
        is:
          - security-client-id
          - tibcoHeaders
        displayName: Obtener conceptos facturables
        description: Obtener conceptos facturables
        queryParameters:
          cuentaFacturacion:
            type: string | nil
            required: false
          numeroConexion:
            type: string | nil
            required: false
          numeroFactura:
            type: string | nil
            required: false
        responses:
          200:
            body:
              application/json:
                example: !include examples/responses/response-billingConcepts.json
    /variations:
      get:
        is:
          - security-client-id
          - tibcoHeaders
        displayName: Obtener variacion de facturas
        description: Obtener variacion de facturas
        queryParameters:
          cuentaFacturacion:
            type: string | nil
            required: false
          numeroConexion:
            type: string | nil
            required: false
        responses:
          200:
            body:
              application/json:
                example: !include examples/responses/response-billingVariations.json
  /numberAndPrice:
    patch:
      is: [security-client-id, tibcoHeaders]
      displayName: Update Connection Number and Price
      description: Endpoint to update connectionNumber and price
      body:
        application/json:
          type: !include datatypes/requests/patchNumberAndPrice.raml
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/responses/patchNumberAndPrice.raml