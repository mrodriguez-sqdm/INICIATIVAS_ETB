			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="transWrite" ><![CDATA[%dw 2.0
output application/java
import replaceAll from dw::core::Strings
---

replaceAll(replaceAll(replaceAll(replaceAll(replaceAll(replaceAll((write(payload, 'application/xml') replace "<?xml version='1.0' encoding='UTF-8'?>" with "" ),"<","&lt;"),">","&gt;"),"\n",""),"'","&quot;"),"xsd\"","xsd&quot;"),"\"http","&quot;http")

]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<parse-template doc:name="Transform Request input" doc:id="3270eed9-e24a-4284-96f6-6cfb7ac3dadc" location="soap/schemas/templates/template-revchain-portabilityCompensationIntf-soap.xml"/>
		<flow-ref doc:name="Go to Service - Revchain" doc:id="8180e328-25bd-49c0-8910-2ca5e9ac1a0c" name="patch-portabilityCompensationIntf-clientSub_Flow"/>
		<ee:transform doc:name="Transform response to Json" doc:id="b0c0128e-eaca-4c3e-b954-a5fd636130bd">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload.Envelope.Body.compensacionPortabilidadResponse]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;var response = (read(payload.return,"application/xml"))&#10;---&#10;response.replies.reply.response]' doc:name="Set Response variable" doc:id="f7e4045d-dba8-4d47-a70a-d4d4e8d45ee4" variableName="response"/>
