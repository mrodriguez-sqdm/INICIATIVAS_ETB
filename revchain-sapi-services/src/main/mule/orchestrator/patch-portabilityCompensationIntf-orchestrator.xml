		<choice doc:name="Choice" doc:id="c1d96fcf-2f6e-499e-8dce-24e4b59a330f" >
			<when expression='#[payload.portalfija_data.resultado == "0" and payload.portalfija_data.descError == "OK"]'>
				<set-variable value="201" doc:name="Set Variable" doc:id="37389f4f-4ae7-4d20-8572-a353b4205c2a" variableName="httpStatus"/>
			</when>
			<otherwise >
				<set-variable value="400" doc:name="Set Variable" doc:id="85f1955a-4834-46bc-b1eb-f02af0b2ec8d" variableName="httpStatus"/>
