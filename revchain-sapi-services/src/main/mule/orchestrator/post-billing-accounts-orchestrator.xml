<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-billing-accounts-orchestratorSub_Flow" doc:id="631feba7-3af8-4176-b962-363a3822d812" >
		<ee:transform doc:name="Transform JSON to XML" doc:id="907d91de-9d06-4a8f-aa63-35c776027c36">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/xml
ns fact http://factcorpws.etb.com/fact
ns soapenv http://schemas.xmlsoap.org/soap/envelope/
---
soapenv#Envelope @("xmlns:fact": fact): {
    soapenv#Header: {},
    soapenv#Body: {
        'fact:CreacionCuenta': {
            xmlString: write(payload, 'application/xml')
        }
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="e01c0ad8-cef5-42f9-ba87-eff2d7098e0f" message="#[payload]"/>
		<flow-ref doc:name="Go to comp rvch client - billing accounts" doc:id="43a198ec-b338-4f14-9e64-fbecf20305eb" name="billing-accounts-clientSub_Flow"/>
		<logger level="INFO" doc:name="Logger" doc:id="1d677bbe-9b71-4c23-baf0-8cd4d3aa5f77" message="#[payload]"/>
		<ee:transform doc:name="Mapping response" doc:id="49fbb5b6-8485-4967-9a04-7674f848ba5b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
sfilluminate: read(payload.Envelope.Body.CreacionCuentaResponse.return, 'application/xml').replies.reply.response.sfilluminate]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
