<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-billing-operation-orchestratorSub_Flow" doc:id="087a4014-a34f-455a-a8e7-128bdc6c99ab" >
		<ee:transform doc:name="Transform JSON to XML" doc:id="1efc7b08-f6f7-4692-b60c-0ff19eb3a048" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
ns fact http://factcorpws.etb.com/fact
ns soapenv http://schemas.xmlsoap.org/soap/envelope/
---
soapenv#Envelope @("xmlns:fact": fact): {
    soapenv#Header: {},
    soapenv#Body: {
        'fact:Operacion': {
            xmlString: write(payload, 'application/xml')
        }
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Go to comp rvch client - billing accounts" doc:id="73dd2a34-bffa-470b-8cfe-03e011960fb0" name="billing-accounts-clientSub_Flow" />
		<ee:transform doc:name="Mapping response" doc:id="9ea5a378-e764-44e7-8e11-586c9337f21a" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
sfilluminate: read(payload.Envelope.Body.OperacionResponse.return, 'application/xml').replies.reply.response.sfilluminate]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
