#%RAML 1.0 DataType
type: object
properties:
  action:
    type: string
    required: true
    enum: [
            "AccountRegistration"
          ]
  origin:
    type: string
    required: true
    enum: [
            "PortalMovilidad",
            "PortalFija",
            "Collections"
          ]
  procedure:
    type: string
    required: false
  type:
    type: string
    required: true
    enum: [
            "orden",
            "servicio"
          ]
  id:
    type: string
    required: true
    example: "MDM-FIBRA-000547784"
  isRollback:
    type: boolean | nil
    required: false