#%RAML 1.0 DataType
type: object
properties:
  RequestSolicitudPortacion:
    type: object
    required: true
    properties:
      Header:
        type: object
        required: true
        properties:
          IdIntegracion:
            type: string
            required: true
            example: "MDM-MOV-328963"
          System:
            type: string
            required: true
            example: "MDM-MOV"
      MensajeABD:
        type: object
        required: true
        properties:
          CabeceraMensaje:
            type: object
            required: true
            properties:
              IdentificadorProceso:
                type: string
                required: true
                example: "00007202405310100004"
              IdentificadorMensaje:
                type: string
                required: true
                example: "00007202405310000016"
              FechaCreacionMsg:
                type: string
                required: true
                example: "20240620145729"
              Operacion:
                type: string
                required: true
                example: "01"
              TipoMsg:
                type: string
                required: true
                example: "1001"
              CodigoOperador:
                type: string
                required: true
                example: "00007"
              Path:
                type: string
                required: true
                example: "D:\\ETB\\Documentacion"
              Observaciones:
                type: string
                required: true
                example: ""
          CuerpoMensaje:
            type: object
            required: true
            properties:
              SolicitudPortacion:
                type: object
                required: true
                properties:
                  Nombre:
                    type: string
                    required: true
                    example: "XXXXXXXXXXXXXXXXXXXXXXXX"
                  TipoDocumentoIdentificacion:
                    type: string
                    required: true
                    example: "3"
                  Direccion:
                    type: string
                    required: true
                    example: "XXXXXXXXXX"
                  NumeroIdentidad:
                    type: string
                    required: true
                    example: "65468976546"
                  FechaExpedicionIdentificacion:
                    type: string
                    required: true
                    example: "20081229"
                  TipoDocumentoIdentificacionRepresentanteLegal:
                    type: string
                    required: true
                    example: "1"
                  IdentificacionRepresentanteLegal:
                    type: string
                    required: true
                    example: "80456987"
                  FechaExpedicionIdentificacionRepresentanteLegal:
                    type: string
                    required: true
                    example: "20080416"
                  OperadorDonante:
                    type: string
                    required: true
                    example: "00004"
                  TipoUsuario:
                    type: string
                    required: true
                    example: "2"
                  TipoServicio:
                    type: string
                    required: true
                    example: "2"
                  NIP:
                    type: string
                    required: true
                    example: "12345"
                  NRN:
                    type: string
                    required: true
                    example: "176"
                  VentanaAmplia:
                    type: string
                    required: true
                    example: "1"
                  SolicitudTercero:
                    type: string
                    required: true
                    example: "0"
                  ListaNumeracion:
                    type: object
                    required: true
                    properties:
                      Numeracion:
                        type: array
                        required: true
                        items:
                          type: string
                          example: "3104XXX244"
                  DocumentoID:
                    type: string
                    required: true
                    example: "aslkdlkasjd.pdf"
                  DocumentoAT:
                    type: string
                    required: true
                    example: "sfwefwefdfd.pdf"
                  DocumentoCC:
                    type: string
                    required: true
                    example: "iewiedjdjdj.pdf"

example: !include ../../examples/request/post-solicitudPortacion.json