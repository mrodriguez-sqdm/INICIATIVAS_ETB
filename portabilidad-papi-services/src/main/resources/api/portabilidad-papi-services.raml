#%RAML 1.0
title: portabilidad-papi-services
version: "1"
protocols:
  - HTTP
mediaType: 
- application/json
baseUri: http://portabilidad-papi-services-{env}.us-e2.cloudhub.io/
description: This API exposes services to handle portability orchestration.

traits:
  security_client_id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  request_headers: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

types:
  AccountRegistration-response: !include examples/response/accountRegistration.json

/v1:
  /mediafon:
    /portabilidad:
      /getMsg:
        post:
          is: [security_client_id, request_headers]
          displayName: "Get Message"
          description: "Obtains a new ABD message"
          body:
            application/json:
              type: !include datatypes/request/post-getMessage.raml
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/post-getMessage.raml
      /{numOrder}:
        /programacionPortacion:
          post:
            is: [security_client_id, request_headers]
            displayName: "Programacion Portacion"
            description: "Programacion Portacion"
            body:
              application/json:
                type: !include datatypes/request/post-programacionPortacion.raml
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/post-programacion-portacion.json
        /reenvioNip:
          post:
            is: [security_client_id, request_headers]
            displayName: "Reenvio NIP"
            description: "Reenvio NIP"
            body:
              application/json:
                type: !include datatypes/request/post-reenvioNip.raml
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/post-reenvioNip.json
        /respuestaSolicitudPortacionDonante:
          post:
            is: [security_client_id, request_headers]
            displayName: "Respuesta Solicitud Portacion Donante"
            description: "Respuesta Solicitud Portacion Donante"
            body:
              application/json:
                type: !include datatypes/request/post-requestResSolPortDon.raml
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/post-requestResSolPortDon.json
        /solicitudNip:
          post:
            is: [security_client_id, request_headers]
            displayName: "Solicitud NIP"
            description: "Solicitud NIP"
            body:
              application/json:
                type: !include datatypes/request/post-solicitudNip.raml
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/post-solicitudNip.json
        /solicitudPortacion:
          post:
            is: [security_client_id, request_headers]
            displayName: "Solicitud portación"
            description: "Solicitud portación"
            body:
              application/json:
                type: !include datatypes/request/post-solicitudPortacion.raml
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/post-solicitudPortacion.json
        /solicitudCancelacion:
          post:
            is: [security_client_id, request_headers]
            displayName: "Solicitud cancelación"
            description: "Solicitud cancelación"
            body:
              application/json:
                type: !include datatypes/request/post-solicitudCancelacion.raml
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/post-solicitudCancelacion.json

  /DGO:
    post:
      is: [security_client_id, request_headers]
      displayName: DGO for services
      description: DGO for services
      body:
        application/json:
          type: !include datatypes/request/post-dgo.raml
      responses:
        200:
          body:
            application/json:
              type:  AccountRegistration-response

  /infrastructure:
    /services:
      /feasibility:
        /bookingFeasibility:
          post:
            is: [security_client_id, request_headers]
            displayName: Booking feasibility
            description: Interface to consult booking feasibility
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: any
        /createBooking:
          post:
            is: [security_client_id, request_headers]
            displayName: Create booking
            description: Interface to create services booking
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpCreateBooking.json
        /consultBooking:
          post:
            is: [security_client_id, request_headers]
            displayName: Consult booking
            description: Interface to consult services booking
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpConsultBooking.json
        /cancelBooking:
          post:
            is: [security_client_id, request_headers]
            displayName: Cancel booking
            description: Interface to cancel services booking
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpCancelBooking.json
      /activation:
        /ont:
          post:
            is: [security_client_id, request_headers]
            displayName: ONT service activation
            description: Interface to activate ont services
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpActivateOnt.json
        /service:
          post:
            is: [security_client_id, request_headers]
            displayName: Service activation
            description: Interface to activate services
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpActivateService.json
      /deactivation:
        /ont:
          post:
            is: [security_client_id, request_headers]
            displayName: ONT service deactivation
            description: Interface to deactivate ont services
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpDeactivateOnt.json
        /service:
          post:
            is: [security_client_id, request_headers]
            displayName: Service deactivation
            description: Interface to deactivate services
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpDeactivateService.json
      /support:
        /resetONT:
          post:
            is: [security_client_id, request_headers]
            displayName: ONT reset
            description: Interface to reset ont
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpResetONT.json
        /consultLevels:
          post:
            is: [security_client_id, request_headers]
            displayName: Consult levels
            description: Interface to measure the signal levels of the ONTs
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpConsultLevels.json
        /consultSpeed:
          post:
            is: [security_client_id, request_headers]
            displayName: Consult speed
            description: Interface to check the information of the speed configured for the client
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpConsultSpeed.json
        /consultState:
          post:
            is: [security_client_id, request_headers]
            displayName: Consult state
            description: Interface to check the status of the ONT
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpConsultState.json
        /consultNeighbors:
          post:
            is: [security_client_id, request_headers]
            displayName: Consult neighbors
            description: Interface to view neighboring clients
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpConsultNeighbors.json
      /modification:
        /serviceSuspension:
          post:
            is: [security_client_id, request_headers]
            displayName: Service suspension
            description: Interface to suspend a service
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpServiceSuspension.json
        /serviceReactivation:
          post:
            is: [security_client_id, request_headers]
            displayName: Service reactivation
            description: Interface to reactivate a service
            queryParameters:
              provider:
                required: true
                enum: [ATP, ATP_CHANGEONT]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpServiceReactivation.json
      /speedChange:
        post:
          is: [security_client_id, request_headers]
          displayName: Speed change
          description: Interface to do speed change
          queryParameters:
            provider:
              required: true
              enum: [ATP]
          body:
            application/json:
              type: any
          responses:
            200:
              body:
                application/json:
                  example: !include examples/response/atpSpeedChange.json
        /feasibility:
          post:
            is: [security_client_id, request_headers]
            displayName: Speed change booking feasibility
            description: Interface to get change speed feasibility
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpSpeedChangeFeasibility.json
        /createBooking:
          post:
            is: [security_client_id, request_headers]
            displayName: Speed change create booking
            description: Interface to create change speed bookin
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpSpeedChangeCreateBooking.json
        /cancelBooking:
          post:
            is: [security_client_id, request_headers]
            displayName: Speed change cancel booking
            description: Interface to cancel change speed booking
            queryParameters:
              provider:
                required: true
                enum: [ATP]
            body:
              application/json:
                type: any
            responses:
              200:
                body:
                  application/json:
                    example: !include examples/response/atpSpeedChangeCancelBooking.json
