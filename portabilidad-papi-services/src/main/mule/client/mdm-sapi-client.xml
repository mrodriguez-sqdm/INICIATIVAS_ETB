			<http:headers ><![CDATA[#[output application/java
---
{
	"client_id" : p('etb-mdm-sapi.client_id'),
	"client_secret" : p('etb-mdm-sapi.client_secret'),
	"name" : attributes.headers.'name',
	"X-CORRELATION-ID": vars.idIntegration default payload.MensajeABD.CabeceraMensaje.IdentificadorProceso,
	"systemId": vars.systemId,
	"source" : attributes.headers.'source'
}]]]></http:headers>
		</http:request>
	</sub-flow>
	<sub-flow name="get-idMessage-client" doc:id="882b50fa-4179-4f5e-be0f-3764de00ddc9" >
		<try doc:name="Try" doc:id="e5ccf07d-20a6-461a-8c9d-f04d7e53c794" >
			<http:request method="GET" doc:name="Get id Message" doc:id="9be3f1ca-924c-472e-90a5-0782793ae35c" config-ref="HTTP_Request_configuration_etb-mdm" path="${etb-mdm-sapi.path.get-idMessage}">
			<http:headers><![CDATA[#[output application/java
---
{
	"client_id" : p('etb-mdm-sapi.client_id'),
	"client_secret" : p('etb-mdm-sapi.client_secret'),
	"name" : attributes.headers.'name',
	"X-CORRELATION-ID": correlationId,
	"systemId": vars.systemId,
	"source" : attributes.headers.'source'
}]]]></http:headers>
		</http:request>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="d1f59636-aca1-4765-b5ad-a6e49c567653" >
					<ee:transform doc:name="Map Error" doc:id="f08e057e-1d3c-4613-b9a8-8eced3f0c1b6" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": "FAIL"
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
	<sub-flow name="get-idProceso-client" doc:id="82f9004f-c19e-4a2b-ac62-7820f1208d65" >
