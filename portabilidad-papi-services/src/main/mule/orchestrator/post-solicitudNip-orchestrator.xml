		<ee:transform doc:name="Portabilidad solicitudes" doc:id="2aca7913-c07e-4bbe-a85a-df482d1e5248">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "DireccionAbonado" : null,
  "IdProceso": payload.RequestSolicitudNIP.MensajeABD.CabeceraMensaje.IdentificadorProceso,
  "IdMensaje": payload.RequestSolicitudNIP.MensajeABD.CabeceraMensaje.IdentificadorMensaje,
