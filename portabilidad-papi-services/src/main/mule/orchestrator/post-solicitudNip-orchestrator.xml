  "NumeroRepresentante": payload.RequestSolicitudNIP.MensajeABD.CuerpoMensaje.SolicitudNIP.NumeroRepresentante,
  "Numeracion": payload.RequestSolicitudNIP.MensajeABD.CuerpoMensaje.SolicitudNIP.ListaNumeracion.Numeracion map Numero: $,
  "TipoMensaje": payload.RequestSolicitudNIP.MensajeABD.CabeceraMensaje.TipoMensaje,
  "FechaCreacionMsg": payload.RequestSolicitudNIP.MensajeABD.CabeceraMensaje.FechaCreacion as LocalDateTime {format: "yyyyMMddHHmmss"} as DateTime >> "America/Bogota",
  "Emisor": payload.RequestSolicitudNIP.MensajeABD.CabeceraMensaje.CodigoOperador,
  "Donante": payload.RequestSolicitudNIP.MensajeABD.CuerpoMensaje.SolicitudNIP.OperadorDonante,
  "Sistema_Origen": payload.RequestSolicitudNIP.Header.System,
  "RespuestaSolicitud": {
    	"RespuestaABD": vars.sisextSendMsgResp.receiveMessageResponse.receiveMessageReturn,
    	"NumeracionRechazada": []
    }
//  "ActualizacionExtractor": "1"
}]]></ee:set-payload>
