#%RAML 1.0 DataType 
type: object
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: Success
    required: false
  bag:
    type: object
    properties:
      id:
        type: string
        example: '12345'
        required: false
      name:
        type: string
        example: PasaGigas 1GB
        required: false
      description:
        type: string
        example: Servicio de datos adicionales para navegación móvil
        required: false
      benefits:
        type: string
        example: 1GB de datos adicionales para navegación
        required: false
      channel:
        type: string
        example: Móvil
        required: false
      value:
        type: integer
        example: 15000
        required: false
      valueStr:
        type: string
        example: $15.000
        required: false
      validity:
        type: string
        example: 30 días
        required: false
      instructions:
        type: string
        example: Activar desde la aplicación MiETB o llamando al 123
        required: false
      technicalConditions:
        type: string
        example: Válido por 30 días desde la activación
        required: false
      image:
        type: object
        properties:
          icon:
            type: string
            example: https://cdn.etb.com/icons/pasagigas.png
            required: false
          logo:
            type: string
            example: https://cdn.etb.com/logos/pasagigas-logo.png
            required: false
      tooltip:
        type: array
        items:
          type: string