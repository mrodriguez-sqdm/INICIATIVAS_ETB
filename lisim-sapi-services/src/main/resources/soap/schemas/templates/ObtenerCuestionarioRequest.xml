<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <ns0:ObtenerCuestionario xmlns:ns0 = "http://tempuri.org/">
		<ns0:objSolicitud>
			<ns0:Usuario>#[vars.usuario]</ns0:Usuario>
			<ns0:Contrasena>#[vars.contrasena]</ns0:Contrasena>
			<ns0:TipoIdentificacion>#[vars.documentTypeId]</ns0:TipoIdentificacion>
			<ns0:Identificacion>#[vars.documentId]</ns0:Identificacion>
			<ns0:Apellido>#[vars.lastName]</ns0:Apellido>
			<ns0:FechaExpedicion>#[vars.documentExpeditionDate]</ns0:FechaExpedicion> 
			<ns0:Departamento>#[vars.department]</ns0:Departamento>
			<ns0:Ciudad>#[vars.city]</ns0:Ciudad>
			<ns0:Modelo>#[vars.modelId]</ns0:Modelo>
			<ns0:Asesor>#[vars.adviser]</ns0:Asesor>
			<ns0:CanalVenta>#[vars.salesChannel]</ns0:CanalVenta>
			<ns0:Proveedor>#[vars.supplier]</ns0:Proveedor>
			<ns0:Portal>#[vars.portal]</ns0:Portal>
		</ns0:objSolicitud>
	</ns0:ObtenerCuestionario>
   </soapenv:Body>
</soapenv:Envelope>