#%RAML 1.0
title: lisim-sapi-services
baseUri:  http://lisim-sapi-services-{env}.us-e2.cloudhub.io
description: lisim system api
protocols:
  - HTTPS

traits:
  security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml

mediaType: 
  - application/json
                          
/v1:
  /scoring:
    post:
      is: [security-client-id,tibcoHeaders]
      displayName: Solicitud Scoring
      description: Solicitud Scoring
      body:
        application/json:
          type: !include datatypes/request/scoringRequest.raml
          example: !include examples/request/scoringRequest.json
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/response/scoringResponse.raml
              example: !include examples/response/scoringResponse.json
  /cuestionario:
    get:
      is: [security-client-id,tibcoHeaders]
      displayName: Solicitud de cuestionario
      description: Solicitud de cuestionario
      queryParameters:
        TipoIdentificacion:
          type: string
          example: "CC"
        Identificacion:
          type: string
          example: "1235413456"
        RegValidacion:
          type: string
          example: "?"
        Apellido:
          type: string
          example: "PEREZ"
        FechaExpedicion:
          type: string
          example: "24/09/2008 02:40:50.3456"
          minLength: 1
        Nombre?:
          type: string | nil
          example: "JUAN"
        Modelo?:
          type: string | nil
          example: "2"
        Departamento?:
          type: integer | nil
          example: 1
        Ciudad?:
          type: integer | nil
          example: 1
        Asesor?:
          type: string | nil
          example: "?"
        CanalVenta?:
          type: string | nil
          example: "?"
        Proveedor?:
          type: string | nil
          example: "?"
        Portal?:
          type: string | nil
          example: "?"
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/cuestionarioResponse.raml
              example: !include examples/response/cuestionarioResponse.json
/v2:                
  /otp:
    /resend:
      post:
        is: [security-client-id, tibcoHeaders]
        displayName: Reenvío de OTP
        description: |
          Reenvía el código OTP asociado a una validación de identidad.
        body:
          application/json:
            type: !include datatypes/request/otpResendRequest.raml
            example: !include examples/request/otpResendRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpResendResponse.raml
                example: !include examples/response/otpResendResponse.json
    /validation:
      post:
        is: [security-client-id, tibcoHeaders]
        displayName: Validación de OTP
        description: |
          Valida el código OTP ingresado por el cliente.
        body:
          application/json:
            type: !include datatypes/request/otpValidationRequest.raml
            example: !include examples/request/otpValidationRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpValidationResponse.raml
                example: !include examples/response/otpValidationResponse.json
  /identityValidation:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Validación de Identidad
      description: |
        Realiza la validación de identidad del cliente en el sistema LISIM.
        Retorna un objeto JSON con información de la validación.
      body:
        application/json:
          type: !include datatypes/request/identityValidationRequest.raml
          example: !include examples/request/identityValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/identityValidationResponse.raml
              example: !include examples/response/identityValidationResponse.json
  /score:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Consulta de Score
      description: |
        Consulta el score del cliente a partir de una validación de identidad.
      body:
        application/json:
          type: !include datatypes/request/scoreValidationRequest.raml
          example: !include examples/request/scoreValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/scoreValidationResponse.raml
              example: !include examples/response/scoreValidationResponse.json
  /questionnaire:
  get:
    is: [security-client-id, tibcoHeaders]
    displayName: Solicitud de cuestionario
    description: Solicitud de cuestionario
    queryParameters:
      IdentificationType:
        type: string
        example: "CC"
      Identification:
        type: string
        example: "1235413456"
      ValidationReg:
        type: string
        example: "?"
      LastName:
        type: string
        example: "PEREZ"
      IssueDate:
        type: string
        example: "24/09/2008 02:40:50.3456"
        minLength: 1
      FirstName?:
        type: string | nil
        example: "JUAN"
      Model?:
        type: string | nil
        example: "2"
      Department?:
        type: integer | nil
        example: 1
      City?:
        type: integer | nil
        example: 1
      Advisor?:
        type: string | nil
        example: "?"
      SalesChannel?:
        type: string | nil
        example: "?"
      Provider?:
        type: string | nil
        example: "?"
      Portal?:
        type: string | nil
        example: "?"
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/questionnaireResponse.raml
            example: !include examples/response/questionnaireResponse.json
  /questionaries:
      /{questionarie-id}:
        /validation:
          uriParameters:
              questionarie-id:
                type: number
                example: 2652
          post:
            is: [security-client-id, tibcoHeaders]
            displayName: Validate Evidence LISIM
            description: Validate Evidence LISIM
            body:
              application/json:
                type: !include datatypes/request/evidentVerificationLISIM.raml
                example: !include examples/request/evidentVerificationLISIM.json
            responses:
              200:
                body:
                  application/json:
                    type: !include datatypes/response/evidentVerificationLISIM.raml
                    example: !include examples/response/evidentVerificationLISIM.json