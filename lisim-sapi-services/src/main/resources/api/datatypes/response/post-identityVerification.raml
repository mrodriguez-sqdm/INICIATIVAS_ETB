#%RAML 1.0 DataType
type: object
properties:
  Valor:
    type: any | nil
    example: null
    required: false
  Codigo_Error:
    type: string
    example: "999"
    required: false
  Descripcion_Error:
    type: string
    example: "Fecha de expedicion no valida"
    required: false
  Caracteristicas:
    type: array
    required: false
    items:
      type: object
      properties:
        Nombre:
          type: string
          example: "APELLIDO"
        Valor:
          type: string
          example: "PEREZ"
