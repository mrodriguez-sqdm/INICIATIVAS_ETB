#%RAML 1.0 DataType
type: object
properties:
  WSResponseScoring:
    type: object
    properties:
      WSResponseHeader:
        type: object
        properties:
          System:
            type: string | nil
            required: false
          Service:
            type: object
            properties:
              status:
                type: string | nil
                required: false
      GestionClientes:
        type: object
        properties:
          head:
            type: object
            properties:
              Interfaz:
                type: string | nil
                required: false
              Destino:
                type: string | nil
                required: false
              Respuesta:
                type: object
                properties:
                  CodigoRespuesta:
                    type: string | nil
                    required: false
                  FechaRespuesta:
                    type: string | nil
                    required: false
                  CodigoError:
                    type: string | nil
                    required: false
                  DescripcionError:
                    type: string | nil
                    required: false
              CodigoIntegracion:
                type: string | nil
                required: false            
          body:
            type: object
            properties:
              Cliente:
                type: object
                properties:
                  TipoDocumento:
                    type: string | nil
                    required: false
                  NumeroDocumento:
                    type: string | nil
                    required: false
                  EstadoDocumento:
                    type: string | nil
                    required: false
                  FechaExpedicionDocumento:
                    type: string | nil
                    required: false
                  DepartamentoExpedicionDocumento:
                    type: string | nil
                    required: false
                  Nombres:
                    type: string | nil
                    required: false
                  PrimerApellido:
                    type: string | nil
                    required: false
                  SegundoApellido:
                    type: string | nil
                    required: false
                  Genero:
                    type: string | nil
                    required: false
                  Ciudad:
                    type: string | nil
                    required: false
                  MercadoCuenta:
                    type: string | nil
                    required: false
                  Score:
                    type: object
                    properties:
                      tipo:
                        type: string | nil
                        required: false
                      puntaje:
                        type: string | nil
                        required: false
                      clasificacion:
                        type: string | nil
                        required: false
          