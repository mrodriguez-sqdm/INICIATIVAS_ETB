#%RAML 1.0 DataType 
type: object
properties:
  DocumentType:
    type: integer
    example: 1
    required: false
  DocumentNumber:
    type: string
    example: '9130026'
    required: false
  DateExpedition:
    type: date-only
    example: '1973-02-27'
    required: false
  Surname:
    type: string
    example: PEDRAZA
    required: false
  Cellphone:
    type: string
    example: '3214958838'
    required: false
  Email:
    type: string
    example: '12321345'
    required: false
  Adviser:
    type: string
    example: '12321345'
    required: false
  Channel:
    type: integer
    example: 1
    required: false
  Provider:
    type: integer
    example: 1
    required: false
  Portal:
    type: integer
    example: 1
    required: false
