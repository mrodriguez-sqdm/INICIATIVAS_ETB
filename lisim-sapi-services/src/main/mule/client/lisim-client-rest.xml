	<sub-flow name="lisim-token-client-restSub_Flow" doc:id="21b527aa-e8f7-4660-b4bd-ff33bc9af472" >
		<http:request method="POST" doc:name="Request to lisim token" doc:id="ee5ebeb9-f86e-4146-b5af-92df80218ead" path="${lisim-client.base-path}${lisim-client.resources.authentication.path}" config-ref="HTTP_Request_configuration_lisim_client_rest">
				<http:body ><![CDATA[#[%dw 2.0
output application/json
---
{
  Username: p("lisim-client.usuario"),
  Password: p("lisim-client.contrasena")
}]]]></http:body>
			<http:headers><![CDATA[#[vars.headers default {}]]]></http:headers>
				<http:query-params><![CDATA[#[vars.queryParameters default {}]]]></http:query-params>
			</http:request>
		<set-variable value="#[payload.token]" doc:name="Set Variable" doc:id="eea54a47-bc8a-417d-a2c4-2bfd0109891c" variableName="token"/>
	</sub-flow>
