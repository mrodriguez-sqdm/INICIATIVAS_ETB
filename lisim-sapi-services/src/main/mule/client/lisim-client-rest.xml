			<http:body><![CDATA[#[vars.identityValidationPayload]]]></http:body>
			<http:headers><![CDATA[#[%dw 2.0
output application/java
---
{
  Authorization: "Bearer " ++ (vars.token default "")
}]]]></http:headers>
			<http:query-params><![CDATA[#[vars.queryParameters default {}]]]></http:query-params>
		</http:request>
