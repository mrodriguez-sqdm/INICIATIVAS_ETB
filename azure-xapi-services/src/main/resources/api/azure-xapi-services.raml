#%RAML 1.0
title: azure-xapi-services

version: "1"
protocols:
  - HTTPS

baseUri: azure-xapi-services-{env}.us-e2.cloudhub.io

securitySchemes:
  etb_oauth_2_0: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

traits:
  tibcoRequestHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.4/tibcorequestheaders.raml

/v1:
 /entries:
    /{entryId}:
      /{formName}:
        uriParameters:
          entryId:
            type: string
            example: "000000051652"
          formName:
            type: string
            example: "PBIform"
        get:
          securedBy:
            - etb_oauth_2_0
          is: [tibcoRequestHeaders]
          displayName: Get PBI from ProductBacklog
          description: Get PBI from ProductBacklog
          responses:
            200:
              body:
                application/json:
                  example: !include /examples/response/entries-response.json
        put:
          securedBy:
            - etb_oauth_2_0
          is: [tibcoRequestHeaders]
          displayName: Update entry status
          description: Update entry status
          body:
            application/json:
              type: !include /datatypes/request/put-entries.raml
              example: !include /examples/request/put-entries-request.json
          responses:
            201:
              body:
                application/json:
                  properties:
                    codigo:
                      type: string
                      example: "204"
                    respuesta:
                      type: string
                      example: "OK"
