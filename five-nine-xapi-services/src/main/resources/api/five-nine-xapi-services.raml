#%RAML 1.0
title: five-nine-xapi-services
protocols:
  - HTTPS

baseUri: https://five-nine-xapi-services-{env}.us-e2.cloudhub.io/
traits: 
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.4/tibcorequestheaders.raml

securitySchemes:
  etb_oauth_2_0: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml
  

/v1:
  /notificacionResponsys:
    post:
      is: tibcoHeaders
      securedBy: etb_oauth_2_0
      displayName: Notification Responsys
      description: Notification Responsys
      body:
        application/xml:
          example: !include examples/requestExamples/responsysExample.raml
      responses:
        201:
          body:
            application/xml:
              example: !include examples/responsesExamples/responsysExample.raml
              

  
  /notificacionTipoEntidad:
    post:
      is: tibcoHeaders
      securedBy: etb_oauth_2_0
      displayName: Notification Tipo entity
      description: Notification Tipo entity
      body:
        application/xml:
          example: !include examples/requestExamples/entityExample.raml
      responses:
        201:
          body:
            application/xml:
              example: !include examples/responsesExamples/entityExample.raml

  /validacionCantidadLineas:
    post:
      is: tibcoHeaders
      securedBy: etb_oauth_2_0
      displayName: Validate number of lines
      description: Validate number of lines
      body:
        application/json:
          type: !include datatypes/validacionCantidadLineas-request.raml
          example: !include examples/requestExamples/validationLines.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/validacionCantidadLineas-response.raml
              example: !include examples/responsesExamples/validationLinesExample.raml

  /operations:
    /v1:
      /document:
        /validation:
          post:
            is: tibcoHeaders
            securedBy: etb_oauth_2_0
            displayName: Verificar Documento CIFIN
            description: wsVerificaDocumentoCIFIN
            body:
              application/json:
                type: !include datatypes/verificaDocumentoCIFIN-request.raml
            responses:
              200:
                body:
                  application/json:
                    type: !include datatypes/verificaDocumentoCIFIN-response.raml
                    example: !include examples/responsesExamples/verificaDocumentoCIFIN-response.json