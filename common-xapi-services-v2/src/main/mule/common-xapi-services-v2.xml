<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="common-xapi-services-main"
		doc:id="2306c180-c13c-4610-8e96-f4c8d3a9003b">
		<http:listener doc:name="Listener"
			doc:id="35033e11-31ef-44e9-94fb-26bb6c983013"
			config-ref="common-xapi-services-httpListenerConfig"
			path="${api.basePath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="Call initial Logger"
			doc:id="8ef35bd7-a754-4fc8-b8ff-475e0058a66f"
			name="initial-loggin-Sub_Flow" />
		<apikit:router
			doc:id="8774ca0d-e985-4475-a93b-e3907aa20518"
			config-ref="common-xapi-services-config" doc:name="APIkit Router" />
		<async doc:name="Async"
			doc:id="912b65dc-8618-4b81-8cbf-bba7ec2d0420">
			<flow-ref doc:name="Call logger"
				doc:id="44603d2b-ae58-46f2-a785-2121ff34e807"
				name="loggin-client-call" />
		</async>
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="common-xapi-services-console"
		doc:id="f1ed750e-50f9-42bc-af84-78899142fce9">
		<http:listener doc:name="Listener"
			doc:id="30f311f3-5b19-470c-ab3c-b86fe37adce4"
			config-ref="common-xapi-services-httpListenerConfig"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			doc:id="31fd18bb-fea9-48f4-82ec-585d91aecbc0"
			config-ref="common-xapi-services-config" doc:name="APIkit Console" />
	</flow>
	<flow name="get:\parameters:common-xapi-services-config"
		doc:id="789bb260-56de-4621-a9ab-871285ddda05">
		<flow-ref doc:name="parameters-get-common-papi-v2-client"
			doc:id="ed3d367c-7ba1-401e-8b4b-0a16ca48c473"
			name="parameters-get-common-papi-v2-client" />
	</flow>
	<flow
		name="post:\documents:application\json:common-xapi-services-config"
		doc:id="a7b8c9d0-e123-4567-0123-abcdefabcdef">
		<flow-ref doc:name="documents-post-common-papi-v2-client"
			doc:id="b8c9d0e1-f234-5678-1234-abcdefabcdef"
			name="documents-post-common-papi-v2-client" />
	</flow>
	<flow
		name="post:\communications\message:application\json:common-xapi-services-config">
		<flow-ref doc:name="post-comm-message-client"
			doc:id="d42c43c4-552b-4d28-b008-af55400b8d0d"
			name="post-comm-message-client" />
	</flow>
</mule>
