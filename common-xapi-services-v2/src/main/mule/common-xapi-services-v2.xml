	<flow name="common-xapi-services-main" doc:id="f9dd7fec-61d1-468e-a13b-b9fc469b5495" >
		<http:listener doc:name="Listener" doc:id="49b3f608-005b-43b4-a014-1099cf0cb364" config-ref="common-xapi-services-httpListenerConfig" path="/v2/*" >
			<http:response statusCode="#[vars.httpStatus default 200]" >
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="Call initial Logger" doc:id="fb698e93-6a9e-4120-9e60-445fa224e0ea" name="initial-loggin-Sub_Flow" />
		<apikit:router doc:id="3b3a71ac-4e4b-404d-b771-bd465ee450f9" config-ref="common-xapi-services-config" doc:name="APIkit Router" />
		<async doc:name="Async" doc:id="e4d94eaf-4e58-43e9-86bd-b65ba820cc32" >
			<flow-ref doc:name="Call logger" doc:id="1b59c24c-9e8e-4e7f-a37b-b39651d6a0e0" name="loggin-client-call" />
		</async>
		<error-handler ref="error-handlerError_Handler" />
	</flow>
	<flow name="common-xapi-services-console" doc:id="f1ed750e-50f9-42bc-af84-78899142fce9" >
		<http:listener doc:name="Listener" doc:id="30f311f3-5b19-470c-ab3c-b86fe37adce4" config-ref="common-xapi-services-httpListenerConfig" path="/console/*" >
			<http:response statusCode="#[vars.httpStatus default 200]" >
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console doc:id="31fd18bb-fea9-48f4-82ec-585d91aecbc0" config-ref="common-xapi-services-config" doc:name="APIkit Console" />
	</flow>
