<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">
	<http:listener-config
		name="common-xapi-services-httpListenerConfig">
		<http:listener-connection
			host="${https.host}" port="${https.port}"
			readTimeout="${https.readTimeout}" tlsContext="TLS_Context"
			protocol="HTTPS" />
	</http:listener-config>
	<apikit:config name="common-xapi-services-config"
		api="common-xapi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<http:request-config
		name="HTTP_Common_PAPI_Request_Config"
		doc:name="HTTP Pau Request Config" basePath="${commonPapi.basePath}">
		<http:request-connection
			host="${commonPapi.host}"
			connectionIdleTimeout="${commonPapi.connectionIdleTimeout}"
			protocol="${commonPapi.protocol}" port="${commonPapi.port}">
			<reconnection>
				<reconnect
					frequency="${commonPapi.reconnection.frequency}"
					count="${commonPapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="Operations_HTTP_Request_configuration"
		doc:name="HTTP Request configuration"
		doc:id="b11dfeb7-589b-46da-b215-98cc422117eb"
		basePath="${operationsPapi.basePath}"
		responseTimeout="${operationsPapi.responseTimeout}">
		<http:request-connection
			protocol="${operationsPapi.protocol}" host="${operationsPapi.host}"
			port="${operationsPapi.port}"
			connectionIdleTimeout="${operationsPapi.connectionIdleTimeout}" />
	</http:request-config>
	<tls:context name="TLS_Context" doc:name="TLS Context"
		doc:id="ab53cfd8-10f8-4fd5-a8b6-b526088c0521">
		<tls:key-store type="${tls.type}" path="${tls.path}"
			keyPassword="${secure::tls.keyPassword}"
			password="${secure::tls.password}" />
	</tls:context>
	<import doc:name="Import"
		doc:id="aed8f999-11e6-447c-97fa-994d70943a4c"
		file="error-handler-v2.xml" />
	<import doc:name="Import"
		doc:id="cb2de01d-98ed-4861-8c37-0bc94ffdc13d" file="loggin.xml" />
	<import doc:name="Import"
		doc:id="92294b0e-fc7a-46cf-b98e-e98671840c6c"
		file="audits-sapi-client.xml" />
	<import doc:name="Import"
		doc:id="62ae9419-96bd-4ae3-b327-9118e08c57e1"
		file="etb-common-lib.xml" />
	<import doc:name="Import"
		doc:id="a951c5e1-7445-45c0-a5e9-97c21985d95c" file="insert-audit.xml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="46e34d80-3fe3-4545-8d0d-eeeadda8dc2f"
		file="properties/${env}-properties.yaml" />
	<api-gateway:autodiscovery apiId="${api.id}"
		ignoreBasePath="true" doc:name="API Autodiscovery"
		doc:id="d5d9cd85-790c-4bda-9b6d-1b7b3d895ab8"
		flowRef="common-xapi-services-main" />
	<secure-properties:config
		name="Secure_Properties_Config" doc:name="Secure Properties"
		doc:id="ce6964d3-e3c7-44e3-a8e4-abd192bd9f8e"
		file="secureProperties/${env}-secure-properties.yaml"
		key="${secure.key}">
		<secure-properties:encrypt
			algorithm="Blowfish" />
	</secure-properties:config>
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="82a9c238-8a37-486a-b600-786b7c4243fe"
		file="properties/common-properties.yaml" />
</mule>
