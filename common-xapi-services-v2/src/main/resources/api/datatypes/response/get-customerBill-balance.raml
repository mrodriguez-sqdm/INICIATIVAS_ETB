#%RAML 1.0 DataType
type: object
description: |
  Unified balance response supporting customer balance
  and ZSmart billing account balance structures.

  Customer balance response includes balance details,
  available resources, promotional resources and offers.

  ZSmart billing balance response includes account summary,
  failed accounts and billing account balances.

  Negative billing balance = account has money.
  Positive billing balance = account has debt.
  Expired balances are not included.

properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: 'OK'
    required: false
  balance:
    type: object
    required: false
    description: Customer balance information.
    properties:
      availableCoin:
        type: string
        example: 'string'
        required: false
      availableCoinValue:
        type: string
        example: 'number'
        required: false
      promotionCoin:
        type: string
        example: 'string'
        required: false
      promotionCoinValue:
        type: string
        example: 'number'
        required: false
      detailed:
        type: object
        required: false
        properties:
          detail:
            type: array
            required: false
            items:
              type: object
              properties:
                sectionName:
                  type: string
                  example: 'string'
                  required: false
                boxes:
                  type: array
                  required: false
                  items:
                    type: object
                    properties:
                      boxName:
                        type: string
                        example: 'string'
                        required: false
                      groupName:
                        type: string
                        example: 'string'
                        required: false
                      unitType:
                        type: string
                        example: 'string'
                        required: false
                      available:
                        type: string
                        example: 'string'
                        required: false
                      consumed:
                        type: string
                        example: 'string'
                        required: false
                      provisioned:
                        type: string
                        example: 'string'
                        required: false
                      offers:
                        type: array
                        required: false
                        items:
                          type: object
                          properties:
                            offerName:
                              type: string
                              example: 'string'
                              required: false
                            available:
                              type: string
                              example: 'string'
                              required: false
                            consumed:
                              type: string
                              example: 'string'
                              required: false
                            provisioned:
                              type: string
                              example: 'string'
                              required: false
                            expirationDate:
                              type: string
                              example: 'string'
                              required: false
      summary:
        type: object
        required: false
        properties:
          resource:
            type: array
            required: false
            items:
              type: object
              properties:
                name:
                  type: string
                  example: 'string'
                  required: false
                available:
                  type: string
                  example: 'string'
                  required: false
                consumed:
                  type: string
                  example: 'string'
                  required: false
                provisioned:
                  type: string
                  example: 'string'
                  required: false
                expirationDate:
                  type: string
                  example: 'string'
                  required: false
  summary:
    type: object
    required: false
    description: |
      Summary of billing accounts processed by ZSmart.
    properties:
      totalAccounts:
        type: integer
        description: Total billing accounts.
        example: 2
        required: true
      processedAccounts:
        type: integer
        description: Successfully processed billing accounts.
        example: 2
        required: true
      failedAccounts:
        type: integer
        description: Failed billing accounts count.
        example: 0
        required: true
  failedAccounts:
    type: array
    required: false
    description: List of failed billing accounts.
    items:
      type: object
      properties:
        status:
          type: string
          description: Failure status.
          example: 'failed'
          required: true
        billingError:
          type: string
          description: Billing execution error.
          example: 'error description'
          required: true
        accountNumber:
          type: string
          description: Failed billing account number.
          example: '14000001234'
          required: true
  accounts:
    type: array
    required: false
    description: |
      List of billing accounts with their balance data.

      Single account query: one account.
      Multiple account query: N accounts.
    items:
      type: object
      properties:
        accountNumber:
          type: string
          description: |
            Billing account number from ZSmart or MDM.
          example: '14000001234'
          required: true
        balances:
          type: array
          required: false
          description: |
            Balance entries for this specific account.
            ZSmart: queryAccountbalance.
          items:
            type: object
            properties:
              balanceId:
                type: string
                description: "Balance instance ID. ZSmart: balID"
                example: '1105'
                required: false
              balanceTypeCode:
                type: string
                description: "Balance type code. ZSmart: acctResCode"
                example: 'LOCAL_CURRENCY'
                required: false
              balanceTypeName:
                type: string
                description: "Balance type name. ZSmart: acctResName"
                example: 'Local Currency'
                required: false
              balance:
                type: string
                description: |
                  Current available balance in PESO.
                  Negative = account has money.
                  Positive = account has debt.
                  ZSmart: balance.
                example: '-145000.00'
                required: false
              effectiveDate:
                type: string
                description: |
                  Balance effective date YYYY-MM-DD HH:MM:SS.
                  ZSmart: effDate.
                example: '2026-01-01 00:00:00'
                required: false
              expirationDate:
                type: string
                description: |
                  Balance expiration date YYYY-MM-DD HH:MM:SS.
                  ZSmart: expDate.
                example: '2049-12-31 23:59:59'
                required: false
              lastUpdateDate:
                type: string
                description: |
                  Date of latest balance update YYYY-MM-DD HH:MM:SS.
                  ZSmart: updateDate.
                example: '2026-03-10 13:56:44'
                required: false
