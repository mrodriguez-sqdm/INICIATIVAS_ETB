#%RAML 1.0 DataType
type: object
properties:
  code:
    type: string
    example: "201"
    required: false
  message:
    type: string
    example: "PQR actualizada correctamente"
    required: false
  result?:
    type: object
    properties:
      databaseId?:
        type: string
        example: "CUN986532"
        required: false
      operationResult?:
        type: string
        example: "2026-03-16"
        required: false
      operationResultDescription?:
        type: string
        example: "PQR_TYPE"
        required: false
      mongoId?:
        type: string
        example: "2026-03-16"
        required: false
example: !include ../../examples/response/patch-trouble-ticket-response.json
