#%RAML 1.0 DataType 
type: object
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: operacion realizada exitosamente
    required: false
  customer:
    type: object
    properties:
      documentType:
        type: string
        example: CC
        required: false
      documentNumber:
        type: string
        example: '5412454'
        required: false
      token:
        type: object
        properties:
          id:
            type: string
            example: 5811f9a3-8f52-463f-8082-fefa933126a3
            required: false