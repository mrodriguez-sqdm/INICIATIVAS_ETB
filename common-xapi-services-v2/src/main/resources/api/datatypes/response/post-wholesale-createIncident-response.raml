#%RAML 1.0 DataType
type: object
properties:
  ticketNumber:
    type: string
    required: true
    description: Remedy Work Order Item ID mapped from OUT_WorkOrderID.
    example: "WOI-000012345"
  status:
    type: string
    required: true
    description: Remedy WOI state mapped from OUT_EstadoWOI.
    example: "Assigned"
