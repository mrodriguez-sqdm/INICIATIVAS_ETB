#%RAML 1.0 DataType
type: object
properties:
  assignedGroup:
    type: string
    required: false
    description: Support group currently assigned to the ticket.
    example: "Aseguramiento Terreno"
  status:
    type: string
    required: false
    description: Current status of the incident in Remedy.
    example: "progress"
  observations:
    type: string
    required: false
    description: Summary or description of the incident.
    example: "Falla de conexion FTTH en sector norte"
  priority:
    type: string
    required: false
    description: Priority assigned to the incident in Remedy.
    example: "high"
