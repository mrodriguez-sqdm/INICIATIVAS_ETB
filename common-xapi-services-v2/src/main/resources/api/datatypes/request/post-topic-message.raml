#%RAML 1.0 DataType
type: object
additionalProperties: true
properties:
  orderNumber:
    type: string
    required: false
    example: "Os-ZSMART-0001"
  procedure:
    type: string
    required: false
    example: "Suspend"
  serviceAccountId:
    type: string
    required: false
    example: "CS-1065096"
  serviceId:
    type: string
    required: false
    example: "SR-7101460"
  crm:
    type: string
    required: false
    example: "SUMA"
  technology:
    type: string
    required: false
    example: "1"
