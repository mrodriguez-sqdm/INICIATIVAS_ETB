#%RAML 1.0 DataType 
type: object
properties:
  customer:
    type: object
    properties:
      customerID:
        type: string
        example: '12813'
        required: false
  thirdApp:
    type: object
    properties:
      partnerCode:
        type: string
        example: PRIME_VIDEO
        required: false
  notificationType:
    type: string
    example: ActivateRefresh
    required: false
  deliveryChannel:
    type: object
    properties:
      sendMail:
        type: boolean
        example: true
        required: false
examples: 
  directvPrime: !include ../../examples/request/post-dtv-prime-third-party-message.json