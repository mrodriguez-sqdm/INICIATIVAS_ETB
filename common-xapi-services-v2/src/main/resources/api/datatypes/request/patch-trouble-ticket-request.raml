#%RAML 1.0 DataType
displayName: Trouble Ticket Request
description: Represents a trouble ticket with customer, service and pqr data.
type: object
properties:
  ticket:
    type: object
    properties:
      pqrId:
        type: string
        example: "PRQ12345"
        required: true
      customer:
        type: object
        properties:
          documentNumber:
            type: string
            example: "87654321"
            required: true
          documentType:
            type: string
            example: "CC"
            required: true
      service:
        type: object
        properties:
          product:
            type: string
            example: "INTERNET_FIBRA"
            required: false
          orderNumber:
            type: string
            example: "ORD78965426"
            required: false
          connectionNumber:
            type: string
            example: "CONN2132658"
            required: false
          serviceAccountId:
            type: string
            example: "ORD78965426"
            required: false
      pqr:
        type: object
        properties:
          assignedUser?:
            type: string
            description: Usuario que se asigna al PQR
            example: "NICOLAS MORA"
          pqrStatus?:
            type: string
            description: Nuevo estado del PQR
            example: "CERRADO"
          activity?:
            type: object
            description: Datos de la actividad del PQR a actualizar
            properties:
              activityName?:
                type: string
                description: Nombre de la actividad
                example: "Validacion de facturacion"
              activityStatus?:
                type: string
                description: Estado de la actividad
                example: "En progreso"
              comments?:
                type: string
                description: Comentarios sobre la gestion realizada
                example: "Cliente contactado telefonicamente"
              description?:
                type: string
                description: Descripcion detallada de la actividad
                example: "Se revisa el historico de facturacion del cliente"
              management?:
                type: string
                description: Gestion asociada a la actividad
                example: "Facturacion"
              managementGroup?:
                type: string
                description: Grupo de gestion asociado a la actividad
                example: "MIXTA"
              managementDescription?:
                type: string
                description: Descripcion de la gestion realizada
                example: "Revision de ciclo de facturacion"
              class?:
                type: string
                description: Clase relacionada a la actividad
                example: "PETICION"
              reason?:
                type: string
                description: Motivo relacionado a la actividad
                example: "ASEGURAMIENTO"
              activityGroup?:
                type: string
                description: Grupo de gestion asignado a la actividad
                example: "Back Office Facturacion"
              assignedUser?:
                type: string
                description: Usuario asignado a la actividad
                example: "NICOLAS MORA"
              activityCreatedByUser?:
                type: string
                description: Usuario que creo la actividad
                example: "jgomez"
              activityStartDate?:
                type: string
                description: Fecha de inicio de la actividad
                example: "2026-09-25T09:00:00-05:00"
              currentStatusDate?:
                type: string
                description: Fecha del estado actual de la actividad
                example: "2026-09-25T10:00:00-05:00"
              activityDueDate?:
                type: string
                description: Fecha de vencimiento de la actividad
                example: "2026-09-27T17:00:00-05:00"
              isFinal?:
                type: string
                description: Indicador de si es la actividad final del PQR
                example: "N"
              priority?:
                type: string
                description: Prioridad de la actividad
                example: "Alta"
              disconnectionDate?:
                type: string
                description: Fecha de desconexion asociada a la actividad
                example: ""
              reconnectionDate?:
                type: string
                description: Fecha de reconexion asociada a la actividad
                example: ""
              duration?:
                type: string
                description: Duracion de la actividad
                example: "1"
              account?:
                type: string
                description: Cuenta asociada a la actividad
                example: "ACC-11223344"
              notification?:
                type: string
                description: Indicador de notificacion de la actividad
                example: "S"
              statusLight?:
                type: string
                description: Semaforo de estado de la actividad
                example: "Verde"
              businessDays?:
                type: string
                description: Dias habiles asociados a la actividad
                example: "1"
              secondaryManagement?:
                type: string
                description: Gestion secundaria de la actividad
                example: ""
              activityAttachments?:
                type: array
                description: Adjuntos asociados a la actividad (equivalente a actividades_adjuntas / PQR_ADJUNTOS_ACTIVIDAD en el XML)
                items:
                  type: object
                  properties:
                    activityAttachment?:
                      type: string
                      description: URL o referencia del archivo adjunto de la actividad (equivalente a adjuntos_actividades en el XML)
                      example: "http://ejemplo.etb.com.co/adjuntos/act0001.pdf"   
          characteristics?:
            type: array
            description: Caracteristicas del PQR a crear o actualizar
            items:
              type: object
              properties:
                name?:
                  type: string
                  description: Nombre de la caracteristica
                  example: "Estrato"
                value?:
                  type: string
                  description: Valor de la caracteristica
                  example: "3"
                setType?:
                  type: string
                  description: tipo de caracteristica
                  example: "U"
examples: 
  PQR_ACTIVITY_UPDATE: !include ../../examples/request/patch-trouble-ticket-activity-request.json
  PQR_CHARACTERISTICS_UPDATE: !include ../../examples/request/patch-trouble-ticket-characteristic-request.json
  PQR_STATUS_UPDATE: !include ../../examples/request/patch-trouble-ticket-status-request.json
  PQR_USER_UPDATE: !include ../../examples/request/patch-trouble-ticket-user-request.json