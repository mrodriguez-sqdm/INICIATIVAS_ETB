#%RAML 1.0 DataType
type: object
properties:
  orderNumber:
    type: string
    required: true
    description: Wholesale order number used by the PAPI to retrieve order data from MongoDB.
    example: "OM-2026-001234"
  idCausal:
    type: string
    required: true
    description: Causal code used by the PAPI to resolve Motivo[0] in MongoDB.
    example: "15"
  idMayorista:
    type: string
    required: true
    description: Wholesale operator identifier. Used by the PAPI to validate ownership of the order and to determine the operator opening the trouble ticket.
    example: "TIGO"
  observations:
    type: string
    required: true
    description: Observations or comments describing the reported issue. Included in the Remedy Work Order as the incident summary/description.
    example: "Ok"
  user:
    type: string
    required: true
    description: User identifier of the operator creating the trouble ticket. Used for traceability and audit purposes during the incident creation process.
    example: "jlopez01"