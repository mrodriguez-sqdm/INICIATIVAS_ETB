#%RAML 1.0 DataType
displayName: Communications Message Request
description: Represents a communication message with sender, receiver, and template details.
type: object
properties:
  state:
    type: string
    description: The current state of the message. Used for notification audit purposes
    enum: [started, completed]
    example: started
  priority:
    type: string
    description: The priority level of the message. Used for notification audit purposes.
    enum: [low, medium, high]
    example: medium
  messageChannel:
    type: string
    description: The origin channel of the message.
    enum: [SMS, EMAIL, WHATSAPP]
    example: EMAIL
  messageType:
    type: string
    description: The type of the message. Used for notification audit purposes
    enum: [COMERCIAL, OUTBOUND, INBOUND]
    example: OUTBOUND
  template:
    type: object
    properties:
      id:
        type: string
        description: The template identifier code. Required for EMAIL, SMS, and WHATSAPP.
        example: "OrderConfirmation_ES"
      listFolderName?:
        type: string
        description: Template list folder name. Required for EMAIL and SMS
        example: "Warmup_Oracle"
      listObjectName?:
        type: string
        description: Template list object name. Required for EMAIL and SMS
        example: "Warmup_Oracle"
      emailFormat?:
        type: string
        description: Template email format. Required for EMAIL.
        example: "Warmup_Oracle"
  templateVariables?:
    type: array
    description: Array of template variables used for dynamic content replacement.
    items:
      type: object
      properties:
        name:
          type: string
          description: Variable name. Only used for notifications EMAIL AND SMS
          required: false
          example: "NAME"
        value:
          type: string
          description: Variable value.
          example: "Juan"
    example: [
      { "name": "FIRST_NAME", "value": "Juan"    },
      { "name": "ORDER_ID",   "value": "12345"   },
      { "name": "AMOUNT",     "value": "$ 1,500" }
    ]
  receiver?:
    type: object
    description: Information about the message receiver. Used for notification and audit purposes.
    properties:
      recipientId?:
        type: string
        description: ID of the recipient. Used for RESPONSYS.
        example: "986532"
      documentNumber?:
        type: string
        description: ID of the receiver.
        example: "987654321"
      documentType?:
        type: string
        description: Type of ID document.
        example: "DNI"
      name:
        type: string
        description: Name of the receiver.
        example: "Jane Smith"
      phoneNumber?:
        type: string | nil
        description: Phone number of the receiver. Required for SMS and WHATSAPP, optional for EMAIL.
        example: "+0987654321"
      email?:
        type: string | nil
        description: Email address of the receiver. Required for EMAIL channel.
        example: "jane.smith@example.com"

examples: 
  email: !include ../../examples/request/post-comm-message-email-request.json
  sms: !include ../../examples/request/post-comm-message-sms-request.json
  whatsapp: !include ../../examples/request/post-comm-message-whatsapp-request.json