#%RAML 1.0 DataType
displayName: Communications Message Request
description: Represents a communication message with sender, receiver, and template details.
example: !include ../../examples/request/post-comm-message-request.json
type: object
properties:
  state:
    type: string
    description: The current state of the message.
    enum: [initial, inProgress, completed, cancelled, failed]
    example: initial
  priority:
    type: string
    description: The priority level of the message.
    enum: [low, medium, high]
    example: medium
  messageChannel:
    type: string
    description: The origin channel of the message.
    enum: [SMS, EMAIL, WHATSAPP]
    example: EMAIL
  messageType:
    type: string
    description: The type of the message.
    enum: [COMERCIAL, OUTBOUND, INBOUND]
    example: OUTBOUND
  messageContent:
    type: string
    description: The content of the communication message.
    example: "Hello, this is a test message."
  redirectionLink?:
    type: string
    description: The redirection link to complete further actions. Optional.
    example: "https://example.com/action"
  templateSubject?:
    type: string
    description: The title of the message. Required for EMAIL, optional for WHATSAPP and SMS.
    example: "Welcome to our service"
  templateId?:
    type: string
    description: The template identifier code. Required for EMAIL and WHATSAPP, optional for SMS.
    example: "TPL-001"
  templateName?:
    type: string
    description: The template name. Required for EMAIL and WHATSAPP, optional for SMS.
    example: "welcome-template"
  templateVariables?:
    type: array
    items: string
    description: Array of template variables used for dynamic content replacement.
    example: ["John", "2026-04-24", "Premium"]
  sender:
    type: object
    description: Information about the message sender.
    properties:
      documentNumber:
        type: string
        description: ID of the sender.
        example: "123456789"
      documentType:
        type: string
        description: Type of ID document.
        example: "DNI"
      name:
        type: string
        description: Name of the sender.
        example: "John Doe"
      phoneNumber?:
        type: string
        description: Phone number of the sender. Required for SMS and WHATSAPP, optional for EMAIL.
        example: "+1234567890"
      email?:
        type: string
        description: Email address of the sender. Required for EMAIL channel.
        example: "john.doe@example.com"
  receiver:
    type: object
    description: Information about the message receiver.
    properties:
      documentNumber:
        type: string
        description: ID of the receiver.
        example: "987654321"
      documentType:
        type: string
        description: Type of ID document.
        example: "DNI"
      name:
        type: string
        description: Name of the receiver.
        example: "Jane Smith"
      phoneNumber?:
        type: string
        description: Phone number of the receiver. Required for SMS and WHATSAPP, optional for EMAIL.
        example: "+0987654321"
      email?:
        type: string
        description: Email address of the receiver. Required for EMAIL channel.
        example: "jane.smith@example.com"