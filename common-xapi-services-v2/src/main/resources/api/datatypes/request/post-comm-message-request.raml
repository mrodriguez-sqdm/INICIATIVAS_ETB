#%RAML 1.0 DataType
displayName: Communications Message Request
description: Represents a communication message with sender, receiver, and template details.
type: object
properties:
  state:
    type: string
    description: The current state of the message.
    enum: [initial, inProgress, completed, cancelled, failed]
    example: initial
  priority:
    type: string
    description: The priority level of the message.
    enum: [low, medium, high]
    example: medium
  messageChannel:
    type: string
    description: The origin channel of the message.
    enum: [SMS, EMAIL, WHATSAPP]
    example: EMAIL
  messageType:
    type: string
    description: The type of the message.
    enum: [COMERCIAL, OUTBOUND, INBOUND]
    example: OUTBOUND
  template:
    type: object
    properties:
      id:
        type: string
        description: The template identifier code. Required for EMAIL, SMS, and WHATSAPP.
        example: "OrderConfirmation_ES"
  templateVariables?:
    type: array
    description: Array of template variables used for dynamic content replacement.
    items:
      type: object
      properties:
        name:
          type: string
          description: Variable name.
          example: "NAME"
        value:
          type: string
          description: Variable value.
          example: "Juan"
    example: [
      { "name": "FIRST_NAME", "value": "Juan"    },
      { "name": "ORDER_ID",   "value": "12345"   },
      { "name": "AMOUNT",     "value": "$ 1,500" }
    ]
  sender?:
    type: object
    description: Information about the message sender.
    properties:
      documentNumber?:
        type: string
        description: ID of the sender.
        example: "123456789"
      documentType?:
        type: string
        description: Type of ID document.
        example: "DNI"
      name:
        type: string
        description: Name of the sender.
        example: "John Doe"
      phoneNumber?:
        type: string | nil
        description: Phone number of the sender. Required for SMS and WHATSAPP, optional for EMAIL.
        example: "+1234567890"
      email?:
        type: string | nil
        description: Email address of the sender. Required for EMAIL channel.
        example: "john.doe@example.com"
  receiver?:
    type: object
    description: Information about the message receiver.
    properties:
      documentNumber?:
        type: string
        description: ID of the receiver.
        example: "987654321"
      documentType?:
        type: string
        description: Type of ID document.
        example: "DNI"
      name:
        type: string
        description: Name of the receiver.
        example: "Jane Smith"
      phoneNumber?:
        type: string | nil
        description: Phone number of the receiver. Required for SMS and WHATSAPP, optional for EMAIL.
        example: "+0987654321"
      email?:
        type: string | nil
        description: Email address of the receiver. Required for EMAIL channel.
        example: "jane.smith@example.com"

examples: 
  email: !include ../../examples/request/post-comm-message-email-request.json
  sms: !include ../../examples/request/post-comm-message-sms-request.json
  whatsapp: !include ../../examples/request/post-comm-message-whatsapp-request.json