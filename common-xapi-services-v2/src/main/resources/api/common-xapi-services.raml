#%RAML 1.0
title: Common XAPI Services
version: v2
baseUri:  https://common-xapi-services-{env}.us-e2.cloudhub.io/{version}
description: |
  ## API Overview

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml
  security_client_id: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/troubleTicket:
  post:
    is: [tibcoHeaders, security_client_id]
    displayName: Post Trouble Ticket
    description: Creates a CUN or PQR Ticket
    headers:
      x-system-id:
        required: true
        type: string
        enum: [MIR, peticionario, retenciones, simra, Siebel, GPNBA, OPENFLEX, servicemanager, portales, SAAW, SIEBEL_NPLAY, INFOCABLE, SALESFORCE, CONTACTCENTER LTE, Financiador, KIOSKOS, GestionDeReclamos, MDM]
        example: "SALESFORCE"
        description: "Parameter that allows the system origin of the request to be identified"
      x-channel-id:
        required: true
        type: string
        example: "WEB"
        description: "Parameter that allows the channel of the request to be identified"
    body:
      application/json:
        type: !include /datatypes/request/post-trouble-ticket-request.raml
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/post-trouble-ticket-response.raml
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
  /wholesale:
    /{ticketNumber}:
      uriParameters:
        ticketNumber:
          type: string
          description: |
            Remedy incident identifier returned by POST /troubleTicket/wholesale.
            Format: INC followed by 12 digits.
          pattern: "INC\\d{12}"
          example: "INC000006276669"
      get:
        displayName: Get Wholesale Trouble Ticket
        description: |
          Retrieves the current state of a wholesale trouble ticket from Remedy
          REST API (arsys/v1/entry/WOI:WorkOrder).
          Standard: TMF621 — GET /troubleTicket/{id} (Common APIs).
          Returns assigned group, status, observations and priority.
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        headers:
          origin:
            type: string
            required: true
            description: Wholesale operator identifier. Required — returns HTTP 400 if absent.
            example: "1"
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-wholesale-getIncident-response.raml
                example: !include examples/response/get-wholesale-getIncident-response-200.json
          400:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-500.json
/communications:
  /third-party:
    /message:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Send Notification to Third-Party Application
        description: Sends notifications or messages to third-party applications (OTT or external platforms) based on a defined notification type and delivery channel, including customer identification and partner integration data.
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
          OTT_PLATFORM:
            type: string
            enum:
              - DIRECTV
            example: "DIRECTV"
            description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY).
        body:
          application/json:
            type: !include /datatypes/request/post-dtv-prime-third-party-message.raml
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/post-dtv-prime-third-party-message.raml
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/parameters:
    get:
      is:
          - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Get parameters
      description: get list of parameters from collections
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        FILTERS:
          type: string
          example: "TypeParameter:Motivos;"
          description: "String used to apply filters to the query (follow example), separate the filter type and its value with a colon, and separate the number of filters with a semicolon. (TypeParameter:Motivos; o TypeParameter:SubMotivos; o TypeParameter:Motivos_SubMotivos;)"
          required: false
        OPERATION_TYPE:
          type: string
          example: "consulta"
          description: "type operation"
          required: false
        OPERATION:
          type: string
          examples: 
            parameters:
              value: "PARAMETROS_RETENCION"
            operators:
              value: "OPERADORES"
            bussinessdays:
              value: "DIAS_HABILES"
          description: "parameter used to identify the target query collection, "
          required: false
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
        OFFSET:
          type: string
          description: "used to organize information and establish a logical order"
          required: false
      responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/servicios-utilitarios.raml
                examples:
                  parametersRetention: 
                    value: !include /examples/response/get-parametersRetention.json
                  businessDays: 
                    value: !include /examples/response/get-businessDays.json
                  operators: 
                    value: !include /examples/response/get-operators.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json

/documents:
    post:
      is:
          - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Upload document
      description: Uploads a document to Azure storage or SFTP portability path based on file.storage (AZURE or SFTP).
      body:
        application/json:
          type: !include /datatypes/request/post-upload-document.raml
          examples:
            azure:
              value: !include /examples/request/post-upload-document-azure.json
            sftp:
              value: !include /examples/request/post-upload-document-sftp.json
      responses:
          201:
            body:
              application/json:
                type: !include /datatypes/response/post-upload-document.raml
                example: !include /examples/response/post-upload-document.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/userIdp:
    get:
      is: [security_client_id, tibcoHeaders]
      securedBy: [etb_oauth_2_0]
      displayName: Get user IDP
      description: get information user IDP
      queryParameters:
        email:
          type: string
          example: "useridp@email.com"
          description: "Parameter that allows the origin of the request to be identified"
          required: false
        documentType:
          type: string
          example: "CC"
          description: "type document"
          required: false
        documentNumber:
          type: string
          example: "54215454"
          description: "number document"
          required: false
      responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/user-Idp.raml
                examples:
                  parametersRetention: 
                    value: !include /examples/response/user-Idp.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
    delete:
      is: [security_client_id, tibcoHeaders]
      securedBy: [etb_oauth_2_0]
      displayName: delete user IDP
      description: delete user IDP
      queryParameters:
        email:
          type: string
          example: "useridp@email.com"
          description: "Parameter that allows the origin of the request to be identified"
          required: false
        documentType:
          type: string
          example: "CC"
          description: "type document"
          required: false
        documentNumber:
          type: string
          example: "54215454"
          description: "number document"
          required: false
      responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/user-Idp.raml
                examples:
                  parametersRetention: 
                    value: !include /examples/response/user-Idp.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
    post:
      is: [security_client_id, tibcoHeaders]
      securedBy: [etb_oauth_2_0]
      displayName: Create User IDP
      description: Create User IDP
      body:
        application/json:
          type: !include /datatypes/request/user-Idp.raml
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/user-Idp.raml
              example: !include /examples/response/user-Idp.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
