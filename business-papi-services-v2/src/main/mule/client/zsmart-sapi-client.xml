<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="zsmart-sapi-clientSub_Flow"
		doc:id="1805cc45-4f53-455f-b925-816d1942d8b6">
		<logger level="INFO" doc:name="Log Request" doc:id="ef0e76d7-52e5-4515-b0c4-1167cf960f00" message='#["HTTP CLIENT START | cid: " ++ correlationId]' />
		<http:request method="#[vars.zsmartRequest.method]"
			doc:name="HTTP zsmart-sapi-services"
			doc:id="a500585e-96b2-4e9a-8b13-ed23fc7ecff9"
			path="#[vars.zsmartRequest.path]" sendCorrelationId="AUTO"
			responseTimeout="#[vars.zsmartRequest.responseTimeout]"
			config-ref="ZSMART_Sapi_HTTP_Request_configuration">
			<http:headers><![CDATA[#[vars.zsmartRequest.headers default {}]]]></http:headers>
			<http:uri-params><![CDATA[#[vars.zsmartRequest.uriParameters default {}]]]></http:uri-params>
			<http:query-params ><![CDATA[#[vars.zsmartRequest.queryParameters default {}]]]></http:query-params>
		</http:request>
		<logger level="INFO" doc:name="Log Response" doc:id="84b9f7ee-104c-4fdb-862a-5c98ceb7d997" message='#["HTTP CLIENT END | cid: " ++ correlationId ++ " | status: OK"]' />
	</sub-flow>
</mule>
