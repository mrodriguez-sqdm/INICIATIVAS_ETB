<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<sub-flow name="patch-subscriber-orchestratorSub_Flow">
		<set-variable value="#[attributes.uriParams.id]" variableName="subscriberId" doc:name="Set subscriberId" />

		<ee:transform doc:name="Prepare context variables">
			<ee:variables>
				<ee:set-variable variableName="systemId"><![CDATA[attributes.headers.systemId]]></ee:set-variable>
				<ee:set-variable variableName="processname"><![CDATA['subscriber-orchestrator']]></ee:set-variable>
				<ee:set-variable variableName="logs"><![CDATA[attributes.headers.logs]]></ee:set-variable>
			</ee:variables>
		</ee:transform>

		<try doc:name="JSC patch subscriber con manejo HTTP">
			<flow-ref doc:name="PATCH subscriber (JSC)" name="patch-subscriber-jsc-clientSub_Flow" />

			<ee:transform doc:name="Transform success response">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "200",
    code: "Ok",
    message: {
        message: if (isEmpty(payload) or payload == null) "Actualización exitosa."
                 else if (payload is String) payload
                 else "Actualización exitosa."
    },
    messageServer: "",
    cause: [
        {
            origin: "",
            message: ""
        }
    ]
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>

			<error-handler>
				<on-error-continue enableNotifications="true" logException="true"
					doc:name="Error HTTP desde JSC"
					type="HTTP:NOT_FOUND, HTTP:BAD_REQUEST, HTTP:UNAUTHORIZED, HTTP:FORBIDDEN, HTTP:METHOD_NOT_ALLOWED, HTTP:NOT_ACCEPTABLE, HTTP:UNSUPPORTED_MEDIA_TYPE, HTTP:TOO_MANY_REQUESTS, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE, HTTP:GATEWAY_TIMEOUT, HTTP:CONNECTIVITY, HTTP:TIMEOUT">
					<set-variable variableName="httpStatus"
						value="#[error.errorMessage.attributes.statusCode default error.cause.errorMessage.attributes.statusCode default (if (error.errorType.identifier == &quot;NOT_FOUND&quot;) 404 else 500)]"
						doc:name="httpStatus desde respuesta JSC" />
					<flow-ref doc:name="build-common-error" name="build-common-error" />
				</on-error-continue>
				<on-error-propagate doc:name="Propagar resto de errores" type="ANY" />
			</error-handler>
		</try>
	</sub-flow>
</mule>

