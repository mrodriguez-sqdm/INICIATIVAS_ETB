#%RAML 1.0 DataType
type: !include ../billing-process-response-base.raml
discriminatorValue: SALE
properties:
  transactionId:
    type: string
    example: a1b2c3d4-e5f6-7890-abcd-ef1234567890
    required: false
  processCode:
    type: string
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  createdAt:
    type: string
    example: '2026-03-19T10:00:01Z'
    required: false
  result:
    type: object
    required: false
    properties:
      customerId:
        type: string
        example: '12345678'
        required: false
      accountId:
        type: string
        example: ACC-001-2026
        required: false
      serviceId:
        type: string
        example: '98765'
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false