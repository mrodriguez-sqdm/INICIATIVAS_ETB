#%RAML 1.0 DataType
type: !include ../billing-process-response-base.raml
discriminatorValue: PLAN_CHANGE
properties:
  transactionId:
    type: string
    example: b2c3d4e5-f6a7-8901-bcde-f01234567890
    required: false
  processCode:
    type: string
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  updatedAt:
    type: string
    example: '2026-03-19T10:00:01Z'
    required: false
  result:
    type: object
    required: false
    properties:
      customerId:
        type: string
        example: '12345678'
        required: false
      serviceId:
        type: string
        example: '98765'
        required: false
      previousOfferCode:
        type: string
        example: PLAN_100
        required: false
      newOfferCode:
        type: string
        example: PLAN_200
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false