#%RAML 1.0 DataType
type: !include ../billing-process-response-base.raml
discriminatorValue: OWNERSHIP_TRANSFER
properties:
  transactionId:
    type: string
    example: TRX20260319012345
    required: false
  processCode:
    type: string
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  updatedAt:
    type: string
    example: '2026-03-19T10:00:01Z'
    required: false
  result:
    type: object
    required: false
    properties:
      sourceCustomerId:
        type: string
        description: "Cedente — ZSmart: header.custId"
        example: '12345678'
        required: false
      targetCustomerId:
        type: string
        description: "Cesionario — ZSmart: header.newCustId"
        example: '87654321'
        required: false
      accountId:
        type: string
        example: '14000001234'
        required: false
      serviceId:
        type: string
        example: '98765'
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false
