#%RAML 1.0 DataType
type: object
properties:
  codeResponse:
    type: string
    required: false
    example: "200"
  responseMessage:
    type: string
    required: false
    example: "The request was successful"
  thirdParty:
    type: object
    required: false
    properties:
      connectionNumber:
        type: string
        required: false
        example: "3182097931"
        description: Parent account connection number
      subscriber:
        type: object
        required: false
        properties:
          chargingCycle:
            type: string
            required: false
            example: "25"
          subscriptionDate:
            type: datetime
            required: false
            example: "2026-07-31T15:09:00.000Z"
          connectionNumber:
            type: string
            required: false
            example: "3057854301"
            description: Referred subscriber connection number
          product:
            type: string | nil
            required: false
