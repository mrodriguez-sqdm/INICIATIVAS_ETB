#%RAML 1.0 DataType 
type: object
properties:
  id:
    type: string
    example: ''
    required: false
  fullName:
    type: string
    example: ''
    required: false
  status:
    type: string
    example: active
    required: false
  contactMedium:
    type: array
    required: false
    items:
      type: object
      properties:
        mediumType:
          type: string
          example: ''
          required: false
        value:
          type: string
          example: ''
          required: false
  idNumber:
    type: string
    example: '1023456789'
    required: false
  firstName:
    type: string
    example: JUAN CARLOS
    required: false
  lastName:
    type: string
    example: PEREZ GOMEZ
    required: false
  jobTitle:
    type: string
    example: INGENIERO DE DESARROLLO
    required: false
  email:
    type: string
    example: juan.perez@etb.com.co
    required: false
  costCenter:
    type: string
    example: TECNOLOGIA E INNOVACION
    required: false
  managerCode:
    type: integer
    example: 79845612
    required: false
  vicePresidency:
    type: string
    example: VICEPRESIDENCIA DE TECNOLOGIA
    required: false
  payrollClass:
    type: integer
    example: 4
    required: false
  startDate:
    type: date-only
    example: '2022-03-15'
    required: false
  maritalStatus:
    type: string
    example: SOLTERO
    required: false

