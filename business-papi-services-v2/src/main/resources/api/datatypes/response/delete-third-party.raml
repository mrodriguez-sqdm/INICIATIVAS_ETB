#%RAML 1.0 DataType
type: object
properties:
  codeResponse:
    type: string
    required: false
    example: "200"
  responseMessage:
    type: string
    required: false
    example: "The request was successful"
  thirdParty:
    type: object
    required: false
    properties:
      connectionNumber:
        type: string
        required: false
        example: "3058194088"
        description: Parent account connection number
      subscriber:
        type: object
        required: false
        properties:
          connectionNumber:
            type: string
            required: false
            example: "3227122059"
            description: Referred subscriber connection number that was removed
