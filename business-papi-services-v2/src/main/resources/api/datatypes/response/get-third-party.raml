#%RAML 1.0 DataType
type: object
properties:
  codeResponse:
    type: string
    required: false
    example: "200"
  responseMessage:
    type: string
    required: false
    example: "The request was successful"
  thirdParty:
    type: array
    required: false
    items:
      type: object
      properties:
        connectionNumber:
          type: string
          required: false
          example: "3182097931"
        modificationDate:
          type: string
          required: false
          example: "2026-07-27T14:38:01.291Z"
        subscribers:
          type: array
          required: false
          items:
            type: object
            properties:
              chargingCycle:
                type: string
                required: false
                example: "25"
              subscriptionDate:
                type: string
                required: false
                example: "2026-07-27T14:38:01.291Z"
              connectionNumber:
                type: string
                required: false
                example: "3057854301"
              product:
                type: string | nil
                required: false
                example: null