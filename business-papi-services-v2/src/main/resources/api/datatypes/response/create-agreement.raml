#%RAML 1.0 DataType
description: COD_RES / RES — unified create agreement response.
type: object
properties:
  responseCode:
    type: string
    example: "200"
  response:
    type: string
    example: "Success"
  agreementNumber:
    type: string
    required: false
    description: Agreement identifier returned by the signing system (when successful).
    example: "AGR-2026-0001"
