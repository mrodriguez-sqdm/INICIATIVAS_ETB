#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: CUSTOMER_UPDATE
description: |
  Update customer profile. ZSmart: serviceEventId=802 (Change customer profile).
  billing-papi resolves: serviceEventId=802, cust(operate=M, custId).
  Only fields present in the request are updated — send only what changes.
  header.prodInstId and header.acctId are NOT required for this operation.
properties:
  processCode:
    type: string
    enum: [CUSTOMER_UPDATE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319014567
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319014567-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    description: "Customer to update. -> cust (operate=M). Send only fields that change."
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. Mandatory for profile update. -> header.custId / cust.custId"
        example: '12345678'
        required: true
      firstName:
        type: string
        description: "First name. -> cust.firstName"
        example: Juan
        required: false
      lastName:
        type: string
        description: "Last name. -> cust.lastName"
        example: Perez
        required: false
      middleName:
        type: string
        description: "Middle name. -> cust.middleName"
        example: Carlos
        required: false
      secondLastName:
        type: string
        description: "Second last name. -> cust.secondLastName"
        example: Gomez
        required: false
      custName:
        type: string
        description: "Business name (B2B). -> cust.custName"
        example: Empresa SAS
        required: false
      docType:
        type: string
        description: "Document type. -> cust.docType"
        example: CC
        required: false
      docNumber:
        type: string
        description: "Document number. -> cust.docNumber"
        example: '1023456789'
        required: false
      contactPhone:
        type: string
        description: "Primary mobile phone. -> cust.contactPhone"
        example: '3009876543'
        required: false
      email:
        type: string
        description: "Primary email. -> cust.email"
        example: juan.nuevo@email.com
        required: false
      country:
        type: string
        description: "Country of residential address. -> cust.country"
        example: Colombia
        required: false
      departament:
        type: string
        description: "DANE department code. -> cust.departament"
        example: '11'
        required: false
      city:
        type: string
        description: "DANE city code. -> cust.city"
        example: '11001'
        required: false
      district:
        type: string
        description: "Locality/Commune. -> cust.district"
        example: Chapinero
        required: false
      address:
        type: string
        description: "Residential address. -> cust.address"
        example: Cra 15 # 80-20
        required: false
      customerSegment:
        type: string
        description: "Customer segment. -> cust.customerSegment"
        example: RESIDENCIAL
        required: false
      subSegmento:
        type: string
        description: "Customer subsegment. -> cust.subSegmento"
        example: MASS
        required: false
      categoria:
        type: string
        description: "Gold|Silver|Bronze|Platinum. -> cust.categoria"
        example: Bronze
        required: false
      habeasData:
        type: string
        description: "Data treatment consent Yes/No. -> cust.habeasData"
        example: 'Yes'
        required: false
      autoretentionFlag:
        type: string
        description: "Self-withholding tax flag Yes/No. -> cust.autoretentionFlag"
        example: 'No'
        required: false
      contacts:
        type: array
        required: false
        description: "Contacts to add or modify. -> cust.contactDtoList"
        items:
          type: object
          properties:
            contactType:
              type: string
              enum: ['501', '502', '503', '504']
              description: "501=Commercial, 502=Legal, 503=Notification, 504=Delivery. -> contactDto.contactType"
              example: '501'
              required: true
            operate:
              type: string
              enum: [A, M]
              description: "A=Add, M=Modify. -> contactDto.operate"
              example: M
              required: true
            contactId:
              type: string
              description: "ZSmart contact ID. Required when operate=M. -> contactDto.contactId"
              example: '1234'
              required: false
            firstName:
              type: string
              description: "Contact first name. -> contactDto.firstName"
              example: Juan
              required: false
            lastName:
              type: string
              description: "Contact last name. -> contactDto.lastName"
              example: Perez
              required: false
            email:
              type: string
              description: "Contact email. -> contactDto.email"
              example: juan.nuevo@email.com
              required: false
            mobilePhone:
              type: string
              description: "Contact phone. -> contactDto.mobilePhone"
              example: '3009876543'
              required: false
