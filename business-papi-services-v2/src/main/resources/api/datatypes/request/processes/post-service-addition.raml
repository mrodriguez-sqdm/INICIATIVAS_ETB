#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SERVICE_ADDITION
description: |
  Add a service to an existing customer (e.g. second line). ZSmart: serviceEventId=1 (New Connection).
  Use when customer and account already exist in ZSmart.
  For new customers use SALE (which includes cust and account nodes).
  billing-papi resolves: serviceEventId=1, billProdInstList[0].billProdInst(operate=A),
  billOfferInstList(operate=A), currencyId=1.
  cust and account nodes are NOT sent to ZSmart — customer/account already exist.
  Fields eliminated in v0.8: productCode, paymentModeCd, ownerCustId, prodInstAcctRelList.
  offerInstanceId is Number (not String) in v0.8.
properties:
  processCode:
    type: string
    enum: [SERVICE_ADDITION]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319009012
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319009012-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        description: "DANE department code of sales agent. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        description: "DANE city code of sales agent. -> header.salesCity"
        example: '11001'
        required: false
  customer:
    type: object
    required: true
    description: "Existing customer reference. cust node is NOT sent to ZSmart. -> header.custId"
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID (already exists). -> header.custId"
        example: '12345678'
        required: true
  account:
    type: object
    required: true
    description: "Existing billing account. account node is NOT sent to ZSmart. -> header.acctId"
    properties:
      externalId:
        type: string
        description: "ZSmart billing account ID (already exists). -> header.acctId"
        example: '14000001234'
        required: true
  service:
    type: object
    required: true
    description: "New service to add. -> billProdInstList[0].billProdInst (operate=A) + billOfferInstList (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM product instance ID for the new service. -> billProdInst.prodInstId"
        example: '98766'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5559876'
        required: true
      effectiveDate:
        type: string
        description: "Service effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
      offerCode:
        type: string
        description: "Offer code for the new service. -> billProdInst.offerCode + billOfferInst.offerCode"
        example: PLAN_PSTN_100
        required: true
      offerInstanceId:
        type: integer
        description: "CRM offer instance ID (Number in v0.8). -> billOfferInst.offerInstId"
        example: 20260011
        required: true
      department:
        type: string
        description: "DANE department where service is installed. -> billProdInst.Department"
        example: '11'
        required: false
      city:
        type: string
        description: "DANE city where service is installed. -> billProdInst.City"
        example: '11001'
        required: false
      address:
        type: string
        description: "Address where service is installed. -> billProdInst.Address"
        example: Cra 7 # 32-16
        required: false
      charges:
        type: array
        required: false
        minItems: 1
        description: "One-off or advance charges for the new service. -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> charge.chargeType"
              example: ONE_OFF
              required: true
            amount:
              type: string
              description: "Charge amount in PESO. -> charge.basicCharge"
              example: '15000'
              required: true
            itemTypeCode:
              type: string
              description: "Account item type code. -> charge.acctItemTypeCode"
              example: CONN_FEE
              required: true
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
              example: 'N'
              required: true
