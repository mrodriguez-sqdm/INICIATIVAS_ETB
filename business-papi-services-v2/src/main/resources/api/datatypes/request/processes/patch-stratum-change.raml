#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: STRATUM_CHANGE
description: |
  Change socioeconomic stratum of a service. ZSmart: serviceEventId=50 (Change Main Product Feature / Change Subscriber Information).
  billing-papi resolves: serviceEventId=50, billProdInst(operate=M, socialLevel), currencyId=1.
  Only header + billProdInst are sent — no billOfferInstList or chargeList.
  socialLevel impacts subsidy/discount calculation configured in ZSmart for the subscriber's plan.
properties:
  processCode:
    type: string
    enum: [STRATUM_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319012345
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319012345-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=M, socialLevel)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate"
        example: '2026-04-01 00:00:00'
        required: true
      socialLevel:
        type: string
        enum: ['', '1', '2', '3', '4', '5', '6']
        description: "Colombian socioeconomic stratum (1-6) or empty string to clear. -> billProdInst.socialLevel"
        example: '3'
        required: true
