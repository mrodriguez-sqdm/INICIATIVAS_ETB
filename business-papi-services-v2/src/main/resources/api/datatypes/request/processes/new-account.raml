#%RAML 1.0 DataType
type: object #!include ../billing-process-base.raml
discriminatorValue: NEW_ACCOUNT
description: |
  Create a new billing account for an existing customer. ZSmart: serviceEventId=807 (Create account).
  business-papi resolves: serviceEventId=807, account(operate=A, custId).
  Use when a customer already has a ZSmart custId but needs a new billing account.
  Nodes map: transaction->header, account->account,
             account.attributes[]->acctAttrList,
             account.contacts[]->account.contactDtoList.
properties:
  processCode:
    type: string
    enum: [NEW_ACCOUNT]
    required: true
  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: integer
        maximum: 999999999999999
        description: "Unique transaction ID. -> header.transactionId"
        example: 202603190088
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319018901-001
        required: true
      custId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart customer ID. Mandatory — account must be linked to an existing customer. -> header.custId"
        example: 12345678
        required: true
      acctId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart account ID (max 15 digits). Mandatory when account already exists. Not required for prepaid. -> header.acctId"
        example: 14000001234
        required: false
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. -> header.salesCity"
        example: '11001'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 200
        description: "Order comments. -> header.comments"
        example: 'New account for corporate services'
        required: false

  account:
    type: object
    required: true
    description: "New billing account data. -> account (operate=A)"
    properties:
      acctName:
        type: string
        minLength: 1
        maxLength: 256
        description: "Billing account name. ZSmart generates if not sent (customer_name+3-digit seq). -> account.acctName"
        example: 'Juan Perez 002'
        required: false
      acctId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart account ID (max 15 digits). Mandatory when account already exists. Not required for prepaid. -> header.acctId"
        example: 14000001234
        required: false
      billDeliveryType:
        type: string
        minLength: 1
        maxLength: 30
        description: "B=Email, A=Post, W=WhatsApp, S=SMS. Comma-separated for multiple. Default B. Mandatory for postpaid. -> account.billDeliveryType"
        example: 'B'
        required: false
      corte:
        type: string
        minLength: 1
        maxLength: 15
        description: "Billing cut day (1-28). Mandatory for new postpaid accounts. -> account.corte"
        example: '15'
        required: false
      parentAcctId:
        type: integer
        maximum: 999999999999999
        description: "Parent account ID for hierarchical accounts. Not applied for prepaid. -> account.parentAcctId"
        example: 14000000001
        required: false
      billFlag:
        type: string
        enum: ['Yes', 'No']
        description: "Payment responsible flag. Not applied for prepaid. -> account.billFlag"
        example: 'Yes'
        required: true
      taxExempt:
        type: string
        enum: ['Yes', 'No']
        description: "Tax exemption flag. -> account.taxExempt"
        example: 'No'
        required: false
      dunningExemption:
        type: string
        enum: ['No', 'Temporary', 'Total']
        description: "Dunning exemption. Not applied for prepaid. -> account.dunningExemption"
        example: 'No'
        required: false
      dunningExemEff:
        type: string
        minLength: 19
        maxLength: 19
        description: "Dunning exemption start date YYYY-MM-DD HH:MM:SS. Only effective when dunningExemption=Temporary. -> account.dunningExemEff"
        example: '2026-03-19 00:00:00'
        required: false
      dunningExemExp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Dunning exemption end date YYYY-MM-DD HH:MM:SS. Only effective when dunningExemption=Temporary. -> account.dunningExemExp"
        example: '2026-12-31 23:59:59'
        required: false
      contractName:
        type: string
        minLength: 1
        maxLength: 60
        description: "Contract name. One contract per account. -> account.contractName"
        example: 'CONTRATO-2026-001'
        required: false
      roundingAdjustmentFlag:
        type: string
        minLength: 1
        maxLength: 6
        description: "Flag for rounding adjustment to nearest ten on invoice. -> account.roundingAdjustmentFlag"
        example: 'No'
        required: false
      previousBalanceFlag:
        type: string
        minLength: 1
        maxLength: 6
        description: "Flag for displaying previous balance on invoice. -> account.previousBalanceFlag"
        example: 'Yes'
        required: false
      coverPageOnlyFlag:
        type: string
        minLength: 1
        maxLength: 6
        description: "Flag for sending only the invoice cover page. -> account.coverPageOnlyFlag"
        example: 'No'
        required: false
      interestChargeFlag:
        type: string
        minLength: 1
        maxLength: 6
        description: "Flag for charging late payment interest. -> account.interestChargeFlag"
        example: 'No'
        required: false
      interestRateType:
        type: string
        enum: ['1', '2']
        description: "1=Interbank, 2=Subsidiary. Required when interestChargeFlag=Yes. -> account.interestRateType"
        example: '1'
        required: false
      dunningManagementTime:
        type: string
        minLength: 1
        maxLength: 6
        description: "Portfolio management timeframe 1=first, 2=second, 3=third overdue invoice. -> account.dunningManagementTime"
        example: '1'
        required: false
      country:
        type: string
        minLength: 1
        maxLength: 15
        description: "Country of account address. -> account.country"
        example: Colombia
        required: true
      department:
        type: string
        minLength: 1
        maxLength: 15
        description: "DANE department code. -> account.department"
        example: '11'
        required: true
      city:
        type: string
        minLength: 1
        maxLength: 15
        description: "DANE city code. -> account.city"
        example: '11001'
        required: true
      district:
        type: string
        minLength: 1
        maxLength: 15
        description: "Locality/Commune. -> account.district"
        example: Chapinero
        required: false
      address:
        type: string
        minLength: 1
        maxLength: 200
        description: "Account address. -> account.address"
        example: Cra 7 # 32-16
        required: false
      paymentTerm:
        type: string
        minLength: 1
        maxLength: 6
        description: "Payment period for postpaid invoice in days, default 0. -> account.paymentTerm"
        example: '0'
        required: false
      attributes:
        type: array
        required: false
        minItems: 1
        description: "Extended account attributes. -> acctAttrList"
        items: !include ../common/AttributeItem.raml
      contacts:
        type: array
        required: false
        minItems: 1
        description: "Account contacts. Not applied for prepaid. contactType - 505=Bill Delivery, 506=Cobranza, 507=Commercial Register, 508=Administrator, 509=Collection Notification, 511=Ley 2300. -> account.contactDtoList"
        items: !include ../common/ContactItem.raml
examples:
  NEW_ACCOUNT: !include ../../../examples/request/new-account.json