#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: ADD_CHARGE
description: |
  Add ad-hoc charge to a subscriber account. ZSmart: serviceEventId=804 (Charge additional fee).
  Covers: generic ad-hoc charges AND Retoma de Equipos (equipment retrieval fee).
  For Retoma de Equipos use itemTypeCode=EQUIP_CHANGE_FEE with a positive basicCharge.
  billing-papi resolves: serviceEventId=804, chargeList.custId from customer.externalId,
  chargeList.prodInstId from service.externalId, chargeList.acctId and chargeList.paymentAcctId
  from account.externalId, currencyId=1.
  No service status, offer, or subscriber data is modified — only header + chargeList is sent to ZSmart.
  Fields eliminated in v0.8: billingCycleId, isNewConnection.
properties:
  processCode:
    type: string
    enum: [ADD_CHARGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: integer
        maximum: 999999999999999
        description: "Unique transaction ID. -> header.transactionId"
        example: 202603190023
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319008901-001
        required: true
      serviceNumber:
        type: string
        minLength: 1
        maxLength: 30
        example: "98765"
        required: true
        description: "CRM subscriber instance ID for this order. Must match the prodInstId of the main service in services[]. -> header.serviceNumber"
      acctId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart account ID (max 15 digits). Mandatory when account already exists. Not required for prepaid. -> header.acctId"
        example: 14000001234
        required: false
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: false
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. Used for tax calculation. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. Used for tax calculation. -> header.salesCity"
        example: '11001'
        required: false
      po:
        type: string
        minLength: 1
        maxLength: 200
        description: "Purchase order number. -> header.po"
        example: 'PO-2026-00123'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 200
        description: "Order comments. -> header.comments"
        example: 'Customer requested e-invoice'
        required: false
  charges:
    type: array
    required: false
    minItems: 1
    description: "One-off or advance charges for this service. -> chargeList (charge.prodInstId resolved from services[].prodInstId by business-papi)"
    items:
      type: object
      properties:
        billingNbr:
          type: string
          minLength: 1
          maxLength: 30
          description: "Service number with prefix (e.g. 601-5551234). -> charge.billingNbr"
          example: '601-5551234'
          required: false
        basicCharge:
          type: string
          minLength: 1
          maxLength: 30
          description: "Charge amount in PESO. Must be positive. -> charge.basicCharge"
          example: '15000'
          required: true
        type:  
          type: string
          enum: ['1', '7']
          description: "1=One-off charge/Installment, 7=Advance payment. -> charge.chargeType"
          example: '1'
          required: true
        acctId:
          type: integer
          maximum: 999999999999999
          description: "Account ID. Optional, resolved by business-papi if not sent. -> charge.acctId"
          example: 14000001234
          required: false
        acctItemTypeCode:
          type: string
          minLength: 1
          maxLength: 30
          description: "Account item type code configured in ZSmart. -> charge.acctItemTypeCode"
          example: CONN_FEE
          required: true
        currencyId:
          type: string
          minLength: 1
          maxLength: 4
          description: "Currency. 1=PESO (default, resolved by business-papi). -> charge.currencyId"
          example: '1'
          required: true
examples:
  ADD_CHARGE: !include ../../../examples/request/patch-add-charge.json