#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SVA
description: |
  Add/Remove/Modify Value-Added Services (additional offers). ZSmart: serviceEventId=189 (Change additional offer).
  Supports add, delete, and modify of additional offers (SVAs, discount packages, value added services).
  business-papi resolves: serviceEventId=189, billProdInst(operate=M), billOfferInst.instanceId=prodInstId.
  Nodes map: transaction->header, service->billProdInst, service.offers[]->billOfferInstList,
  service.attributes[]->billOfferInstAttrList, service.charges[]->chargeList.
properties:
  processCode:
    type: string
    enum: [SVA]
    required: true

  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: string
        minLength: 1
        maxLength: 15
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX202603190034
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples. business-papi must NOT strip separators before forwarding."
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319003456-001
        required: true
      prodInstId:
        type: integer
        maximum: 999999999999999
        description: "CRM subscriber instance ID for this order. Must match service.prodInstId. -> header.prodInstId"
        example: 98765
        required: false
      custId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart customer ID (max 15 digits). Identifies who requests the order. -> header.custId"
        example: 12345678
        required: false
      acctId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart account ID (max 15 digits). -> header.acctId"
        example: 14000001234
        required: false
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. Used for tax calculation. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. Used for tax calculation. -> header.salesCity"
        example: '11001'
        required: false
      po:
        type: string
        minLength: 1
        maxLength: 200
        description: "Purchase order number. -> header.po"
        example: 'PO-2026-00123'
        required: false
      billType:
        type: string
        enum: ['1', '2']
        description: "1=Monthly invoice (default), 2=Sales invoice. Only for postpaid. -> header.billType"
        example: '1'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 200
        description: "Order comments. -> header.comments"
        example: 'Customer requested additional offer'
        required: false

  services:
    type: array
    description: "Services to add/remove/modify SVAs on. -> billProdInstList[] (operate=M)"
    items:
      type: object
      properties:
        prodInstId:
          type: integer
          maximum: 999999999999999
          description: "CRM product instance ID (max 15 digits). -> billProdInst.prodInstId / billOfferInst.instanceId"
          example: 98765
          required: true
        areaCode:
          type: string
          minLength: 1
          maxLength: 16
          description: "Service number area prefix. -> billProdInst.areaCode"
          example: '601'
          required: true
        serviceNumber:
          type: string
          minLength: 1
          maxLength: 24
          description: "Service number without prefix. -> billProdInst.serviceNumber"
          example: '5551234'
          required: true
        effectiveDate:
          type: string
          minLength: 19
          maxLength: 19
          description: "Service effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
          example: '2026-03-19 10:00:00'
          required: true
        bundleIdCRM:
          type: string
          minLength: 1
          maxLength: 9
          description: "Bundle code. Cannot be modified. -> billProdInst.bundleIdCRM"
          example: 'BND202601'
          required: false
        offers:
          type: array
          required: true
          minItems: 1
          description: "Additional offers to add (A), delete (D) or modify (M). instanceId is resolved by business-papi from service.prodInstId. -> billOfferInstList"
          items: !include ../common/OfferItemWithOperate.raml
        attributes:
          type: array
          required: false
          description: "Attributes to add or modify on offer instances. -> billOfferInstAttrList"
          items: !include ../common/AttributeItemWithOperate.raml
        charges:
          type: array
          required: false
          minItems: 1
          description: "Optional charges for this SVA operation. -> chargeList"
          items: !include ../common/ChargeItem.raml
