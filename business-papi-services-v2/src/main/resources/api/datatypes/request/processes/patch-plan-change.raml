#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: PLAN_CHANGE
description: |
  Change main offer (plan). ZSmart: serviceEventId=329 (Change Main Offer).
  Single atomic call. Only supports standalone plan change — one prodInstId per call.
  billing-papi resolves: serviceEventId=329, billProdInst(operate=M, offerCode=newOfferCode),
  billOfferInstList[D](offerInstId=currentOfferInstanceId) + billOfferInstList[A](offerInstId=newOfferInstanceId),
  currencyId=1.
  Fields eliminated in v0.8: productCode, paymentModeCd, statusCd, ownerCustId.
  offerInstanceId is Number (not String) in v0.8.
properties:
  processCode:
    type: string
    enum: [PLAN_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319002345
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319002345-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInstList[0].billProdInst (operate=M) + billOfferInstList (D then A)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
      currentOfferCode:
        type: string
        description: "Active offer code to remove. -> billOfferInst[D].offerCode"
        example: PLAN_PSTN_100
        required: true
      currentOfferInstanceId:
        type: integer
        description: "ZSmart instance ID of the active offer (Number in v0.8). -> billOfferInst[D].offerInstId"
        example: 20260001
        required: true
      newOfferCode:
        type: string
        description: "New offer code to activate. -> billProdInst.offerCode + billOfferInst[A].offerCode"
        example: PLAN_PSTN_200
        required: true
      newOfferInstanceId:
        type: integer
        description: "New offer instance ID (Number in v0.8). -> billOfferInst[A].offerInstId"
        example: 20260002
        required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "Optional charges (e.g. plan change fee). -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> charge.chargeType"
              example: ONE_OFF
              required: true
            amount:
              type: string
              description: "Charge amount in PESO. -> charge.basicCharge"
              example: '5000'
              required: true
            itemTypeCode:
              type: string
              description: "Account item type code. -> charge.acctItemTypeCode"
              example: PLAN_CHANGE_FEE
              required: true
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
              example: 'N'
              required: true
