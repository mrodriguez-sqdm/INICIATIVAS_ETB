#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: VOLUNTARY_CANCELLATION
description: |
  Permanent service termination. ZSmart: serviceEventId=46 (Terminate).
  billing-papi resolves: serviceEventId=46, billProdInst(operate=D), currencyId=1.
  Fields eliminated in v0.8: productCode, paymentModeCd, statusCd, ownerCustId,
  offerCode, offerInstanceId, billOfferInstList, prodInstAcctRelList.
  ZSmart cleans up offers and account relationships internally.
  account node is no longer required in v0.8 — ZSmart resolves it by prodInstId.
properties:
  processCode:
    type: string
    enum: [VOLUNTARY_CANCELLATION]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319007890
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319007890-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=D)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Termination effective date YYYY-MM-DD HH:MM:SS. Mandatory in v0.8. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "Optional final charges. -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> charge.chargeType"
              example: ONE_OFF
              required: true
            amount:
              type: string
              description: "Charge amount in PESO. -> charge.basicCharge"
              example: '0'
              required: true
            itemTypeCode:
              type: string
              description: "Account item type code. -> charge.acctItemTypeCode"
              example: CANCEL_FEE
              required: true
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
              example: 'N'
              required: true
  confirmation:
    type: object
    required: true
    description: "Explicit confirmation required before executing irreversible termination"
    properties:
      confirmed:
        type: boolean
        description: "Must be true to proceed with cancellation"
        example: true
        required: true
      reason:
        type: string
        description: "Cancellation reason provided by the customer"
        example: Cliente solicita baja del servicio por traslado
        required: true
