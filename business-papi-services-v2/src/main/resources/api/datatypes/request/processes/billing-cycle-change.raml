#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: BILLING_CYCLE_CHANGE
description: |
  Change billing cycle cut day. ZSmart: serviceEventId=234 (Modify Billing Cycle Type).
  Account-level operation — only applies to postpaid accounts.
  business-papi resolves: serviceEventId=234, account(operate=M, corte, effDate).
  header.prodInstId is NOT sent — no service-level node involved.
  Nodes map: transaction->header, account->account.
properties:
  processCode:
    type: string
    enum: [BILLING_CYCLE_CHANGE]
    required: true

  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: integer
        maximum: 999999999999999
        description: "Unique transaction ID. -> header.transactionId"
        example: 202603190083
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319013456-001
        required: true
      custId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart customer ID (max 15 digits). -> header.custId"
        example: 12345678
        required: true
      acctId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart billing account ID (max 15 digits). -> header.acctId"
        example: 14000001234
        required: false
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. -> header.salesCity"
        example: '11001'
        required: false
      po:
        type: string
        minLength: 1
        maxLength: 200
        description: "Purchase order number. -> header.po"
        example: 'PO-2026-00126'
        required: false
      billType:
        type: string
        enum: ['1', '2']
        description: "1=Monthly invoice (default), 2=Sales invoice. Only for postpaid. -> header.billType"
        example: '1'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 200
        description: "Order comments. -> header.comments"
        example: 'Billing cycle change requested by customer'
        required: false

  account:
    type: object
    required: true
    description: "Postpaid billing account to update. -> account (operate=M)"
    properties:
      corte:
        type: string
        minLength: 1
        maxLength: 15
        description: "New billing cycle cut day. Calculated by CRM. Only applies to postpaid accounts. -> account.corte"
        example: '6'
        required: true
      effectiveDate:
        type: string
        minLength: 19
        maxLength: 19
        description: "Date from which the new cycle applies YYYY-MM-DD HH:MM:SS. -> account.effDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
        example: '2026-05-01 00:00:00'
        required: true
examples:
  BILLING_CYCLE_CHANGE: !include ../../../examples/request/billing-cycle-change.json