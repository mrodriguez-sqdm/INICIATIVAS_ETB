#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SERVICE_REMOVAL
description: |
  Remove a specific service from an existing customer. ZSmart: serviceEventId=46 (Terminate).
  Use when the customer has multiple services and only one is being removed.
  The customer and account remain active in ZSmart after the operation.
  For full customer cancellation use VOLUNTARY_CANCELLATION.
  billing-papi resolves: serviceEventId=46, billProdInst(operate=D), currencyId=1.
  Fields eliminated in v0.8: productCode, paymentModeCd, statusCd, ownerCustId,
  offerCode, offerInstanceId, billOfferInstList, prodInstAcctRelList.
properties:
  processCode:
    type: string
    enum: [SERVICE_REMOVAL]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319010123
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319010123-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  account:
    type: object
    required: true
    description: "Billing account reference. -> header.acctId"
    properties:
      externalId:
        type: string
        description: "ZSmart billing account ID. -> header.acctId"
        example: '14000001234'
        required: true
  service:
    type: object
    required: true
    description: "Service to remove. -> billProdInst (operate=D)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID to terminate. -> header.prodInstId / billProdInst.prodInstId"
        example: '98766'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5559876'
        required: true
      effectiveDate:
        type: string
        description: "Termination effective date YYYY-MM-DD HH:MM:SS. Mandatory in v0.8. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
