#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: OWNERSHIP_TRANSFER
description: |
  Transfer service ownership (Cesión de contrato). ZSmart: serviceEventId=67 (Transfer ownership).
  billing-papi resolves: serviceEventId=67, billProdInst(operate=M),
  header.newCustId from customer.targetExternalId,
  header.newAcctId from account.targetExternalId.
  The cesionario must already exist in ZSmart before calling this operation.
  If cesionario is new, create them first via SALE, then call OWNERSHIP_TRANSFER.
properties:
  processCode:
    type: string
    enum: [OWNERSHIP_TRANSFER]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319011234
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319011234-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID of cedente (current owner). -> header.custId"
        example: '12345678'
        required: true
      targetExternalId:
        type: string
        description: "ZSmart customer ID of cesionario (must already exist). -> header.newCustId"
        example: '99999999'
        required: true
  account:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart billing account ID of cedente. -> header.acctId"
        example: '14000001234'
        required: true
      targetExternalId:
        type: string
        description: "ZSmart billing account ID of cesionario (must already exist). -> header.newAcctId"
        example: '14000009999'
        required: true
  service:
    type: object
    required: true
    description: "Service being transferred. -> billProdInst (operate=M)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Transfer effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
