#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: STRATUM_CHANGE
description: |
  Change socioeconomic stratum of a service. ZSmart: serviceEventId=50 (Change Subscriber Information).
  business-papi resolves: serviceEventId=50, billProdInst(operate=M, socialLevel), currencyId=1.
  Only header + billProdInst are sent — no billOfferInstList or chargeList.
  Nodes map: transaction->header, service->billProdInst.
properties:
  processCode:
    type: string
    enum: [STRATUM_CHANGE]
    required: true

  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: string
        minLength: 1
        maxLength: 15
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX202603190089
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples. business-papi must NOT strip separators before forwarding."
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319019012-001
        required: true
      prodInstId:
        type: integer
        maximum: 999999999999999
        description: "CRM subscriber instance ID. Must match service.prodInstId. -> header.prodInstId"
        example: 98765
        required: true
      custId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart customer ID (max 15 digits). -> header.custId"
        example: 12345678
        required: true
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. -> header.salesCity"
        example: '11001'
        required: false
      po:
        type: string
        minLength: 1
        maxLength: 200
        description: "Purchase order number. -> header.po"
        example: 'PO-2026-00130'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 200
        description: "Order comments. -> header.comments"
        example: 'Stratum change requested by customer'
        required: false

  services:
    type: array
    description: "Services to update stratum on. -> billProdInstlist[0] (operate=M)"
    items:
      type: object
      properties:
        prodInstId:
          type: integer
          maximum: 999999999999999
          description: "CRM product instance ID. Must match transaction.prodInstId. -> billProdInst.prodInstId"
          example: 98765
          required: true
        areaCode:
          type: string
          minLength: 1
          maxLength: 16
          description: "Service number area prefix. -> billProdInst.areaCode"
          example: '601'
          required: true
        serviceNumber:
          type: string
          minLength: 1
          maxLength: 24
          description: "Service number without prefix. -> billProdInst.serviceNumber"
          example: '5551234'
          required: true
        effectiveDate:
          type: string
          minLength: 19
          maxLength: 19
          description: "Effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
          example: '2026-04-01 00:00:00'
          required: true
        socialLevel:
          type: string
          enum: ['', '1', '2', '3', '4', '5', '6']
          description: "New socioeconomic stratum 1-6, or empty string to clear. -> billProdInst.socialLevel"
          example: '3'
          required: true
