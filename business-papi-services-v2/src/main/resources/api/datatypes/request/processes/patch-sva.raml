#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SVA
description: |
  Add/Remove Value-Added Services. ZSmart: serviceEventId=189 (Change additional offer).
  billing-papi resolves: serviceEventId=189, billProdInst(operate=M, subscriber level),
  billOfferInstList[A] for additions, billOfferInstList[D] for removals,
  billOfferInst.instanceId=prodInstId, currencyId=1.
  At least one of additions or removals must be present.
  offerInstanceId is Number (not String) in v0.8.
  Fields eliminated in v0.8: statusCd.
properties:
  processCode:
    type: string
    enum: [SVA]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319003456
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319003456-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=M, subscriber level) + billOfferInstList"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId / billOfferInst.instanceId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8 for billProdInst. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. Mandatory in v0.8. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate / billOfferInst[A].effDate"
        example: '2026-03-19 10:00:00'
        required: true
      additions:
        type: array
        required: false
        description: "SVAs to add. -> billOfferInstList (operate=A)"
        items:
          type: object
          properties:
            offerCode:
              type: string
              description: "SVA offer code. -> billOfferInst.offerCode"
              example: SVA_VOICEMAIL
              required: true
            offerInstanceId:
              type: integer
              description: "CRM offer instance ID (Number in v0.8). -> billOfferInst.offerInstId"
              example: 20260001
              required: true
      removals:
        type: array
        required: false
        description: "SVAs to remove. -> billOfferInstList (operate=D)"
        items:
          type: object
          properties:
            offerCode:
              type: string
              description: "SVA offer code to remove. -> billOfferInst.offerCode"
              example: SVA_CALLWAIT
              required: true
            offerInstanceId:
              type: integer
              description: "ZSmart instance ID of the SVA (Number in v0.8). -> billOfferInst.offerInstId"
              example: 20259099
              required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "Optional charges. -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> charge.chargeType"
              example: ONE_OFF
              required: true
            amount:
              type: string
              description: "Charge amount in PESO. -> charge.basicCharge"
              example: '3000'
              required: true
            itemTypeCode:
              type: string
              description: "Account item type code. -> charge.acctItemTypeCode"
              example: SVA_ADD_FEE
              required: true
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
              example: 'N'
              required: true
