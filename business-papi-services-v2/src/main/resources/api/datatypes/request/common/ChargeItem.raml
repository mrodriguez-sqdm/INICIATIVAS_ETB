#%RAML 1.0 DataType
description: "One-off or advance charge. Used in chargeList. business-papi resolves: prodInstId from parent service, currencyId=1 default."
type: object
properties:
  type:
    type: string
    enum: ['1', '7']
    description: "1=One-off charge/Installment, 7=Advance payment. -> charge.chargeType"
    example: '1'
    required: true
  basicCharge:
    type: string
    minLength: 1
    maxLength: 30
    description: "Charge amount in PESO. Must be positive. -> charge.basicCharge"
    example: '15000'
    required: true
  acctItemTypeCode:
    type: string
    minLength: 1
    maxLength: 30
    description: "Account item type code configured in ZSmart. -> charge.acctItemTypeCode"
    example: CONN_FEE
    required: true
  paidFlag:
    type: string
    enum: ['Y', 'N']
    description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
    example: 'N'
    required: true
  acctId:
    type: integer
    maximum: 999999999999999
    description: "Account ID. Optional, resolved by business-papi if not sent. -> charge.acctId"
    example: 14000001234
    required: false
  billingNbr:
    type: string
    minLength: 1
    maxLength: 30
    description: "Service number with prefix (e.g. 601-5551234). -> charge.billingNbr"
    example: '601-5551234'
    required: false
  currencyId:
    type: string
    minLength: 1
    maxLength: 4
    description: "Currency. 1=PESO (default, resolved by business-papi). -> charge.currencyId"
    example: '1'
    required: false
  perCharge:
    type: string
    minLength: 1
    maxLength: 30
    description: "Monthly charge amount for installment plans. -> charge.perCharge"
    example: '5000'
    required: false
  installmentPlanId:
    type: integer
    maximum: 999999999999
    description: "Installment plan ID configured in ZSmart (max 12 digits). Only for ONE_OFF installment charges. -> charge.installmentPlanId"
    example: 12
    required: false
  prodInstFlag:
    type: string
    enum: ['0', '1']
    description: "Restrict charge to this subscriber only. 0=No, 1=Yes. Only used in negative charge. -> charge.prodInstFlag"
    example: '0'
    required: false
  origAcctItemTypeCode:
    type: string
    minLength: 1
    maxLength: 30
    description: "Original account item type code. Only used during installment. -> charge.origAcctItemTypeCode"
    example: CONN_FEE_ORIG
    required: false
