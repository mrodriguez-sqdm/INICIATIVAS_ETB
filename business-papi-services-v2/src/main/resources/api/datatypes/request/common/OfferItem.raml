#%RAML 1.0 DataType
description: "Offer instance associated with a service. Used in billOfferInstList. business-papi resolves instanceId from parent service.prodInstId."
type: object
properties:
  offerInstanceIdCRM:
    type: string
    minLength: 1
    maxLength: 30
    description: "CRM offer instance ID (max 15 digits). -> billOfferInst.offerInstIdCRM"
    example: "20260001"
    required: true
  offerCode:
    type: string
    minLength: 1
    maxLength: 60
    description: "Offer code (main or additional). -> billOfferInst.offerCode"
    example: PLAN_PSTN_100
    required: true
  effectiveDate:
    type: string
    minLength: 19
    maxLength: 19
    description: "Offer effective date YYYY-MM-DD HH:MM:SS. -> billOfferInst.effDate"
    example: '2026-03-19 10:00:00'
    required: true
  expirationDate:
    type: string
    minLength: 19
    maxLength: 19
    description: "Offer expiration date YYYY-MM-DD HH:MM:SS. -> billOfferInst.expDate"
    example: '2049-12-31 23:59:59'
    required: false
  attributes:
    type: array
    required: false
    description: "Extended attributes for this offer instance. -> billOfferInstAttrList"
    items: !include AttributeItem.raml
