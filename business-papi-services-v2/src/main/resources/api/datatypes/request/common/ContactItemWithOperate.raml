#%RAML 1.0 DataType
description: |
  Contact with explicit operate field. Used when CRM controls add/modify of contacts (e.g. customer-update, account-update).
  All fields are optional except operate — send only what changes.
  Valid contactType values by context:
    Customer: 501=Commercial, 502=Legal, 503=Notification, 504=Delivery Address
    Account:  505=Bill Delivery, 506=Cobranza, 507=Commercial Register, 508=Administrator, 509=Collection Notification, 511=Ley 2300
    Service:  510=Authorized User
type: object
properties:
  operate:
    type: string
    enum: ['A', 'M']
    description: "A=Add, M=Modify. -> contactDto.operate"
    example: 'A'
    required: true
  contactType:
    type: string
    minLength: 1
    maxLength: 6
    description: "Contact role code. See parent object description for valid values per context. -> contactDto.contactType"
    example: '501'
    required: false
  contactId:
    type: string
    minLength: 1
    maxLength: 20
    description: "ZSmart contact ID. Mandatory when operate=M. -> contactDto.contactId"
    example: '1234'
    required: false
  firstName:
    type: string
    minLength: 1
    maxLength: 255
    description: "-> contactDto.firstName"
    example: Juan
    required: false
  lastName:
    type: string
    minLength: 1
    maxLength: 255
    description: "-> contactDto.lastName"
    example: Perez
    required: false
  email:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.email"
    example: juan.perez@email.com
    required: false
  mobilePhone:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.mobilePhone"
    example: '3001234567'
    required: false
  fixedPhone:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.fixedPhone"
    example: '6015551234'
    required: false
  sms:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.sms"
    example: '3001234568'
    required: false
  whatsApp:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.whatsApp"
    example: '3001234567'
    required: false
  contactDocType:
    type: string
    enum: [CC, CE, NIT, PEP, PPT]
    description: "Document type. -> contactDto.contactDocType"
    example: CC
    required: false
  contactDocNo:
    type: string
    minLength: 1
    maxLength: 60
    description: "Document number. -> contactDto.contactDocNo"
    example: '1023456789'
    required: false
  contactDocExpDate:
    type: string
    minLength: 10
    maxLength: 10
    description: "Document expiry date YYYY-MM-DD. -> contactDto.contactDocExpDate"
    example: '2030-12-31'
    required: false
  country:
    type: string
    minLength: 1
    maxLength: 120
    description: "Only Colombia accepted. -> contactDto.country"
    example: Colombia
    required: false
  department:
    type: string
    minLength: 1
    maxLength: 15
    description: "DANE department code. -> contactDto.department"
    example: '11'
    required: false
  city:
    type: string
    minLength: 1
    maxLength: 15
    description: "DANE city code. -> contactDto.city"
    example: '11001'
    required: false
  district:
    type: string
    minLength: 1
    maxLength: 100
    description: "Locality/Commune. -> contactDto.district"
    example: Chapinero
    required: false
  addressName:
    type: string
    minLength: 1
    maxLength: 255
    description: "Street name. -> contactDto.addressName"
    example: 'Cra 7 # 32-16'
    required: false
