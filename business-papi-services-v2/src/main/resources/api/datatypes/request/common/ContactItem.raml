#%RAML 1.0 DataType
description: |
  Contact person associated with a customer, account or service.
  Valid contactType values by context:
    Customer (custAttrList):  501=Commercial, 502=Legal, 503=Notification, 504=Delivery Address
    Account (acctAttrList):   505=Bill Delivery, 506=Cobranza, 507=Commercial Register, 508=Administrator, 509=Collection Notification, 511=Ley 2300
    Service (billProdInst):   510=Authorized User
type: object
properties:
  contactType:
    type: string
    minLength: 1
    maxLength: 6
    description: "Contact role code. See parent object description for valid values per context. -> contactDto.contactType"
    example: '503'
    required: true
  contactId:
    type: string
    minLength: 1
    maxLength: 6
    description: "Unique ID of ZSmart, it’s mandatory for modify a contact. -> contactDto.contactId"
    example: '65982'
    required: false
  firstName:
    type: string
    minLength: 1
    maxLength: 255
    description: "-> contactDto.firstName"
    example: Juan
    required: true
  lastName:
    type: string
    minLength: 1
    maxLength: 255
    description: "-> contactDto.lastName"
    example: Perez
    required: true
  email:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.email"
    example: juan.perez@email.com
    required: false
  sms:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.sms"
    example: '3001234567'
    required: false
  mobilePhone:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.mobilePhone"
    example: '3001234567'
    required: false
  fixedPhone:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.fixedPhone"
    example: '6015551234'
    required: false
  whatsApp:
    type: string
    minLength: 1
    maxLength: 60
    description: "-> contactDto.whatsApp"
    example: '3001234567'
    required: false
  contactDocType:
    type: string
    enum: [CC, CE, NIT, PEP, PPT]
    description: "Document type. -> contactDto.contactDocType"
    example: CC
    required: true
  contactDocNo:
    type: string
    minLength: 1
    maxLength: 60
    description: "Document number. -> contactDto.contactDocNo"
    example: '1023456789'
    required: true
  contactDocExpDate:
    type: string
    minLength: 10
    maxLength: 10
    description: "Document expiry date YYYY-MM-DD. -> contactDto.contactDocExpDate"
    example: '2030-12-31'
    required: false
  country:
    type: string
    minLength: 1
    maxLength: 120
    description: "Only Colombia accepted. -> contactDto.country"
    example: 'Colombia'
    required: true
  department:
    type: string
    minLength: 1
    maxLength: 15
    description: "DANE department code. -> contactDto.department"
    example: '11'
    required: true
  city:
    type: string
    minLength: 1
    maxLength: 15
    description: "DANE city code. -> contactDto.city"
    example: '11001'
    required: true
  district:
    type: string
    minLength: 1
    maxLength: 100
    description: "Locality/Commune. -> contactDto.district"
    example: Chapinero
    required: false
  addressName:
    type: string
    minLength: 1
    maxLength: 200
    description: "Street name. -> contactDto.addressName"
    example: 'Cra 7 # 32-16'
    required: true
