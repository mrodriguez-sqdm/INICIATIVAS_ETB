#%RAML 1.0 DataType
displayName: BillingProcessBase
type: object
discriminator: processCode
description: |
  Base type for all billing process requests.
  The processCode field discriminates which ZSmart operation sequence to execute.
properties:
  processCode:
    type: string
    enum: [SALE, PLAN_CHANGE, SVA, SUSPENSION, RESTORATION, NUMBER_CHANGE, VOLUNTARY_CANCELLATION, ADD_CHARGE, SERVICE_ADDITION, SERVICE_REMOVAL, STRATUM_CHANGE, OWNERSHIP_TRANSFER, BILLING_CYCLE_CHANGE, CUSTOMER_UPDATE, ACCOUNT_UPDATE, ADDRESS_CHANGE]
    description: "Billing process discriminator."
    required: true