#%RAML 1.0 DataType
description: |
  Crear acuerdo (canal + IP, suscriptor, acuerdo, trámite). Alineado funcionalmente con support-papi create agreements, nombres en inglés.
type: object
properties:
  identip:
    type: object
    required: false
    description: Channel and client IP (ORIGEN / IP).
    properties:
      channelOrigin:
        type: string
        required: false
        example: "WEB"
      clientIp:
        type: string
        required: false
        example: "192.168.1.10"
  subscriber:
    type: object
    required: true
    description: Subscriber identification (OBJ_SUSCRIPTOR).
    properties:
      documentType:
        type: string
        required: true
        example: "CC"
      documentNumber:
        type: string
        required: true
        example: "1234567890"
  agreement:
    type: object
    required: true
    description: Agreement and document metadata (OBJ_ACUERDO).
    properties:
      name:
        type: string
        required: true
        example: "Service contract John Doe"
      expirationDate:
        type: string
        required: true
        description: Agreement expiration date (YYYY-MM-DD)
        example: "2026-12-31"
      advisorCopyRequired:
        type: string
        required: false
        description: '"1" or "0" — whether the advisor receives a copy'
        example: "0"
      advisorEmail:
        type: string
        required: false
        example: "advisor@example.com"
      emailMessage:
        type: string
        required: false
      documents:
        type: array
        required: true
        items:
          type: object
          properties:
            fileName:
              type: string
              required: true
              example: "Contract_ETB.pdf"
            container:
              type: string
              required: true
              description: Azure blob container (storage key used by azure-sapi GET).
              example: "contracts-container"
            mimeType:
              type: string
              required: false
              example: "application/pdf"
      recipients:
        type: array
        required: false
        items:
          type: object
          properties:
            email:
              type: string
            firstName:
              type: string
            lastName:
              type: string
            documentType:
              type: string
            documentNumber:
              type: string
            mobile:
              type: string
  procedure:
    type: object
    required: true
    description: Order and procedure type (OBJ_TRAMITE).
    properties:
      orderNumber:
        type: string
        required: true
        example: "MDM_FIBRA_07756764"
      type:
        type: string
        required: true
        description: Procedure type (e.g. VENTA_HOGARES) — drives validation and mongo routing.
        example: "VENTA_HOGARES"
      user:
        type: string
        required: true
        description: User initiating the agreement flow (audit).
        example: "jdoe"
