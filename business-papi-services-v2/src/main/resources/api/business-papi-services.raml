#%RAML 1.0
title: business-papi-services
version: v2
baseUri: http://business-papi-services-v2-{env}.us-e2.cloudhub.io/{version}
protocols:
  - HTTP

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml
  security_client_id: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
mediaType: 
  - application/json


/partyInteraction:
  post:
    is: [security_client_id,tibcoHeaders]
    displayName: Register Customer Interaction
    description: Creates a new customer interaction to record actions or intentions from the customer, such as cancellations, term acceptance, or retention cases.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: "Parameter that allows the origin of the request to be identified"
    body:
      application/json:
        type: !include /datatypes/request/interaction.raml
        example: !include /examples/request/interaction.json
    responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/create-interaction.raml
        400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
  patch:
      is: [security_client_id,tibcoHeaders]
      displayName: Update Customer Interaction
      description: Updates the status or outcome of an existing customer interaction.
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
      body:
        application/json:
          type: !include /datatypes/request/interaction.raml
          example: !include /examples/request/interaction.json
      responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/update-interaction.raml
          400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/billingAccount:
  get:
    is: [security_client_id,tibcoHeaders]
    displayName: Retrieve Billing Account
    description: Retrieves billing account details such as cycle, due date, and financial status. 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        BILLING_ACCOUNT:
          type: string
          example: "12552454"
          description: Billing account
          required: false
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
        OFFSET:
          type: string
          description: "used to organize information and establish a logical order"
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-billingAccount.raml
                example: !include /examples/response/get-billingAccount.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json

/agreement:
  get:
    is: [security_client_id,tibcoHeaders]
    displayName: Retrieve Agreement Information
    description: Retrieves contract details including start date, end date, and minimum commitment clause. 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        INTERACTION_ID:
          type: string
          example: "12552454"
          description: "Number Interaction"
          required: false
        PARENT_ACCOUNT:
          type: string
          example: "9876543210"
          description: "Parent account number associated with the customer"
          required: false
        ACTIVE_DATE:
          type: datetime
          example: "2022-05-12T19:21:55.190Z"
          description: "Date used to filter active records as of the specified timestamp (ISO 8601 format)"
          required: false
        FILTERS:
          type: string
          example: ""
          description: "String used to apply filters such as start date, end date, penalty value, and clause duration. Follow the example: separate the filter name and its value with a colon, and multiple filters with a semicolon."
          required: false
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
        OFFSET:
          type: string
          description: "used to organize information and establish a logical order"
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-agreement.raml
                example: !include /examples/response/get-agreement.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
  post:
    is: [security_client_id,tibcoHeaders]
    displayName: Create Agreement
    description: |
      Creates an agreement — validates input, retrieves the document from Azure, creates the agreement in sisext (AZSign),
      persists in mongo-sapi by procedure type, and registers traceability in common-sapi.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: "Parameter that allows the origin of the request to be identified"
    body:
      application/json:
        type: !include /datatypes/request/post-create-agreement.raml
        example: !include /examples/request/post-create-agreement.json
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/create-agreement.raml
            example: !include /examples/response/create-agreement-200.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
/party:
  get:
    is: [security_client_id,tibcoHeaders]
    displayName: verification of field crews
    description: verification of field crews
    queryParameters:
        LONGITUDE:
          type: number
          format: double
          example: 45.621
          description: "Number Interaction"
          required: true
        LATITUDE:
          type: number
          format: double
          example: 545.25
          description: "Parent account number associated with the customer"
          required: true
        RADIUS:
          type: number
          example: 10
          description: "meters around"
          required: true
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-party.raml
                example: !include /examples/response/get-party.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
  /{id}:
    get:
      is: [security_client_id,tibcoHeaders]
      displayName: secure employee validation
      description: secure employee validation
      responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/get-employee.raml
                  example: !include /examples/response/get-employee.json
            400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
            401:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-401.json
            404:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-404.json
            500:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json

/subscriber:
  /{id}:
    patch:
      is: [security_client_id,tibcoHeaders]
      displayName: Update Subscriber
      description: Updates subscriber information through JSC.
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
      body:
        application/json:
          type: !include /datatypes/request/update-subscriber.raml
          example: !include /examples/request/patch-subscriber.json
      responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/update-interaction.raml
                example: !include /examples/response/patch-subscriber.json
          400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/parties:
  post:
    is: [security_client_id,tibcoHeaders]
    displayName: Create OTT Subscriber
    description: Creates a new customer (Party) and registers the subscriber in a third-party OTT platform, including customer data, product association, and access credentials.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: "Parameter that allows the origin of the request to be identified"
      OTT_PLATFORM:
        type: string
        enum:
          - DIRECTV
        example: "DIRECTV"
        description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY).
    body:
      application/json:
        type: !include /datatypes/request/post-dtv-parties.raml
        example: !include /examples/request/post-dtv-parties.json
    responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/post-dtv-parties.raml
              example: !include /examples/response/post-dtv-parties.json
        400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
              
/thirdParty:
  get:
    is: [security_client_id,tibcoHeaders]
    displayName: Retrieve Third Party Resource Sharing
    description: Retrieves the resource-sharing document for a parent connection number, including subscribers.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Parameter that allows the origin of the request to be identified
        required: false
      connectionNumber:
        type: string
        example: "3182097931"
        description: Parent account connection number. Only numeric values are allowed, with exactly 10 digits.
        required: true
        pattern: ^[0-9]{10}$
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/get-third-party.raml
            example: !include /examples/response/get-third-party.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json

  post:
    is: [security_client_id,tibcoHeaders]
    displayName: Add Third Party Subscriber
    description: Adds a referred subscriber into the parent connection subscribers list. chargingCycle is calculated server-side; product is always null.
    body:
      application/json:
        type: !include /datatypes/request/post-third-party.raml
        example: !include /examples/request/post-third-party.json
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/create-third-party.raml
            example: !include /examples/response/create-third-party.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      409:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-409.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
            
  delete:
    is: [security_client_id,tibcoHeaders]
    displayName: Remove Third Party Subscriber
    description: Removes a referred subscriber from the parent connection subscribers list. Does not delete the parent document.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Parameter that allows the origin of the request to be identified
        required: false
      connectionNumber:
        type: string
        example: "3058194088"
        description: Parent account connection number. Only numeric values are allowed, with exactly 10 digits.
        required: true
        pattern: ^[0-9]{10}$
      referredConnectionNumber:
        type: string
        example: "3227122059"
        description: Referred subscriber connection number to remove. Only numeric values are allowed, with exactly 10 digits.
        required: true
        pattern: ^[0-9]{10}$
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/delete-third-party.raml
            example: !include /examples/response/delete-third-party.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json