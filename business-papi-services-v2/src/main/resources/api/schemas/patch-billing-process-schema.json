{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BillingProcessPatchRequest",
  "type": "object",
  "required": ["processCode", "transaction"],
  "properties": {
    "processCode": {
      "type": "string",
      "enum": ["PLAN_CHANGE","SVA","SUSPENSION","SUSPENSION_FRAUD","RESTORATION","RESTORATION_FRAUD",
               "NUMBER_CHANGE","VOLUNTARY_CANCELLATION","STRATUM_CHANGE","ADDRESS_CHANGE",
               "OWNERSHIP_TRANSFER","ACCOUNT_UPDATE","BILLING_CYCLE_CHANGE","CUSTOMER_UPDATE"]
    }
  },
  "if":   { "properties": { "processCode": { "const": "PLAN_CHANGE" } } },
  "then": { "$ref": "#/definitions/PlanChange" },
  "else": {
    "if":   { "properties": { "processCode": { "const": "SVA" } } },
    "then": { "$ref": "#/definitions/Sva" },
    "else": {
      "if":   { "properties": { "processCode": { "const": "SUSPENSION" } } },
      "then": { "$ref": "#/definitions/Suspension" },
      "else": {
        "if":   { "properties": { "processCode": { "const": "SUSPENSION_FRAUD" } } },
        "then": { "$ref": "#/definitions/SuspensionFraud" },
        "else": {
          "if":   { "properties": { "processCode": { "const": "RESTORATION" } } },
          "then": { "$ref": "#/definitions/Restoration" },
          "else": {
            "if":   { "properties": { "processCode": { "const": "RESTORATION_FRAUD" } } },
            "then": { "$ref": "#/definitions/RestorationFraud" },
            "else": {
              "if":   { "properties": { "processCode": { "const": "NUMBER_CHANGE" } } },
              "then": { "$ref": "#/definitions/NumberChange" },
              "else": {
                "if":   { "properties": { "processCode": { "const": "VOLUNTARY_CANCELLATION" } } },
                "then": { "$ref": "#/definitions/VoluntaryCancellation" },
                "else": {
                  "if":   { "properties": { "processCode": { "const": "STRATUM_CHANGE" } } },
                  "then": { "$ref": "#/definitions/StratumChange" },
                  "else": {
                    "if":   { "properties": { "processCode": { "const": "ADDRESS_CHANGE" } } },
                    "then": { "$ref": "#/definitions/AddressChange" },
                    "else": {
                      "if":   { "properties": { "processCode": { "const": "OWNERSHIP_TRANSFER" } } },
                      "then": { "$ref": "#/definitions/OwnershipTransfer" },
                      "else": {
                        "if":   { "properties": { "processCode": { "const": "ACCOUNT_UPDATE" } } },
                        "then": { "$ref": "#/definitions/AccountUpdate" },
                        "else": {
                          "if":   { "properties": { "processCode": { "const": "BILLING_CYCLE_CHANGE" } } },
                          "then": { "$ref": "#/definitions/BillingCycleChange" },
                          "else": { "$ref": "#/definitions/CustomerUpdate" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },

  "definitions": {

    "TransactionBase": {
      "type": "object",
      "required": ["id", "timestamp", "orderItemId", "salesChannel"],
      "properties": {
        "id":              { "type": "string",  "minLength": 1, "maxLength": 15 },
        "timestamp":       { "type": "string",  "minLength": 19, "maxLength": 19 },
        "orderItemId":     { "type": "string",  "minLength": 1, "maxLength": 22 },
        "salesChannel":    { "type": "integer", "enum": [1, 2, 4, 5, 7, 106] },
        "serviceNumber":   { "type": "string",  "minLength": 1, "maxLength": 30 },
        "custId":          { "type": "integer", "maximum": 999999999999999 },
        "acctId":          { "type": "integer", "maximum": 999999999999999 },
        "newCustId":       { "type": "integer", "maximum": 999999999999999 },
        "newAcctId":       { "type": "integer", "maximum": 999999999999999 },
        "salesDepartment": { "type": "string",  "minLength": 1, "maxLength": 10 },
        "salesCity":       { "type": "string",  "minLength": 1, "maxLength": 10 },
        "po":              { "type": "string",  "minLength": 1, "maxLength": 200 },
        "billType":        { "type": "string",  "enum": ["1", "2"] },
        "comments":        { "type": "string",  "minLength": 1, "maxLength": 200 }
      }
    },

    "AttributeItemWithOperate": {
      "type": "object",
      "required": ["operate", "attrCode", "value"],
      "properties": {
        "operate":        { "type": "string", "enum": ["A", "M", "D"] },
        "attrCode":       { "type": "string", "minLength": 1, "maxLength": 30 },
        "value":          { "type": "string", "minLength": 1, "maxLength": 255 },
        "effectiveDate":  { "type": "string", "minLength": 19, "maxLength": 19 },
        "expirationDate": { "type": "string", "minLength": 19, "maxLength": 19 }
      }
    },

    "AttributeItem": {
      "type": "object",
      "required": ["attrCode", "value"],
      "properties": {
        "attrCode": { "type": "string", "minLength": 1, "maxLength": 30 },
        "value":    { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },

    "ContactItemWithOperate": {
      "type": "object",
      "required": ["operate"],
      "properties": {
        "operate":          { "type": "string", "enum": ["A", "M"] },
        "contactType":      { "type": "string", "minLength": 1, "maxLength": 6 },
        "contactId":        { "type": "string", "minLength": 1, "maxLength": 20 },
        "firstName":        { "type": "string", "maxLength": 255 },
        "lastName":         { "type": "string", "maxLength": 255 },
        "email":            { "type": "string", "maxLength": 60 },
        "sms":              { "type": "string", "maxLength": 60 },
        "mobilePhone":      { "type": "string", "maxLength": 60 },
        "fixedPhone":       { "type": "string", "maxLength": 60 },
        "whatsApp":         { "type": "string", "maxLength": 60 },
        "contactDocType":   { "type": "string", "enum": ["CC","CE","NIT","PEP","PPT"] },
        "contactDocNo":     { "type": "string", "maxLength": 60 },
        "contactDocExpDate":{ "type": "string", "minLength": 10, "maxLength": 10 },
        "country":          { "type": "string", "maxLength": 120 },
        "department":       { "type": "string", "maxLength": 15 },
        "city":             { "type": "string", "maxLength": 15 },
        "district":         { "type": "string", "maxLength": 100 },
        "addressName":      { "type": "string", "maxLength": 255 }
      }
    },

    "ContactItem": {
      "type": "object",
      "required": ["contactType", "firstName", "lastName", "contactDocType", "contactDocNo", "country", "department", "city", "addressName"],
      "properties": {
        "contactType":      { "type": "string", "minLength": 1, "maxLength": 6 },
        "contactId":        { "type": "string", "minLength": 1, "maxLength": 6 },
        "firstName":        { "type": "string", "maxLength": 255 },
        "lastName":         { "type": "string", "maxLength": 255 },
        "email":            { "type": "string", "maxLength": 60 },
        "sms":              { "type": "string", "maxLength": 60 },
        "mobilePhone":      { "type": "string", "maxLength": 60 },
        "fixedPhone":       { "type": "string", "maxLength": 60 },
        "whatsApp":         { "type": "string", "maxLength": 60 },
        "contactDocType":   { "type": "string", "enum": ["CC","CE","NIT","PEP","PPT"] },
        "contactDocNo":     { "type": "string", "maxLength": 60 },
        "contactDocExpDate":{ "type": "string", "minLength": 10, "maxLength": 10 },
        "country":          { "type": "string", "maxLength": 120 },
        "department":       { "type": "string", "maxLength": 15 },
        "city":             { "type": "string", "maxLength": 15 },
        "district":         { "type": "string", "maxLength": 100 },
        "addressName":      { "type": "string", "maxLength": 255 }
      }
    },

    "OfferItemAD": {
      "type": "object",
      "required": ["operate", "offerInstanceIdCRM", "offerCode", "effectiveDate"],
      "properties": {
        "operate":            { "type": "string", "enum": ["A", "D"] },
        "offerInstanceIdCRM": { "type": "integer", "maximum": 999999999999999 },
        "offerCode":          { "type": "string", "minLength": 1, "maxLength": 60 },
        "effectiveDate":      { "type": "string", "minLength": 19, "maxLength": 19 },
        "expirationDate":     { "type": "string", "minLength": 19, "maxLength": 19 }
      }
    },

    "OfferItemWithOperate": {
      "type": "object",
      "required": ["operate", "offerInstanceIdCRM", "offerCode", "effectiveDate"],
      "properties": {
        "operate":            { "type": "string", "enum": ["A", "M", "D"] },
        "offerInstanceIdCRM": { "type": "integer", "maximum": 999999999999999 },
        "offerCode":          { "type": "string", "minLength": 1, "maxLength": 60 },
        "effectiveDate":      { "type": "string", "minLength": 19, "maxLength": 19 },
        "expirationDate":     { "type": "string", "minLength": 19, "maxLength": 19 }
      }
    },

    "ChargeItem": {
      "type": "object",
      "required": ["type", "acctItemTypeCode", "paidFlag", "currencyId"],
      "properties": {
        "type":                 { "type": "string", "enum": ["1", "7"] },
        "basicCharge":          { "type": "string", "minLength": 1, "maxLength": 30 },
        "acctItemTypeCode":     { "type": "string", "minLength": 1, "maxLength": 30 },
        "paidFlag":             { "type": "string", "enum": ["Y", "N"] },
        "acctId":               { "type": "integer", "maximum": 999999999999999 },
        "billingNbr":           { "type": "string", "minLength": 1, "maxLength": 30 },
        "currencyId":           { "type": "string", "minLength": 1, "maxLength": 4 },
        "perCharge":            { "type": "string", "minLength": 1, "maxLength": 30 },
        "installmentPlanId":    { "type": "integer", "maximum": 999999999999 },
        "prodInstFlag":         { "type": "string", "enum": ["0", "1"] },
        "origAcctItemTypeCode": { "type": "string", "minLength": 1, "maxLength": 30 }
      }
    },

    "ServiceBase": {
      "type": "object",
      "required": ["serviceNumber"],
      "properties": {
        "areaCode":      { "type": "string", "minLength": 1, "maxLength": 16 },
        "serviceNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "effectiveDate": { "type": "string", "minLength": 19, "maxLength": 19 },
        "charges": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/ChargeItem" }
        }
      }
    },

    "PlanChange": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["PLAN_CHANGE"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              {
                "required": ["effectiveDate", "newOfferCode", "offers"],
                "properties": {
                  "newOfferCode": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "socialLevel":  { "type": "string", "enum": ["","1","2","3","4","5","6"] },
                  "bundleIdCRM":  { "type": "string", "minLength": 1, "maxLength": 9 },
                  "attributes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/AttributeItemWithOperate" } },
                  "offers": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/OfferItemAD" } }
                }
              }
            ]
          }
        }
      }
    },

    "Sva": {
      "required": ["processCode", "transaction", "offers"],
      "properties": {
        "processCode": { "type": "string", "enum": ["SVA"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "offers": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/OfferItemWithOperate" }
        },
        "attributes": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/AttributeItemWithOperate" }
        },
        "charges": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/ChargeItem" }
        }
      }
    },

    "Suspension": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["SUSPENSION"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              { "required": ["areaCode", "effectiveDate"] }
            ]
          }
        }
      }
    },

    "SuspensionFraud": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["SUSPENSION_FRAUD"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              { "required": ["areaCode", "effectiveDate"] }
            ]
          }
        }
      }
    },

    "Restoration": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["RESTORATION"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              { "required": ["areaCode", "effectiveDate"] }
            ]
          }
        }
      }
    },

    "RestorationFraud": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["RESTORATION_FRAUD"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              { "required": ["areaCode", "effectiveDate"] }
            ]
          }
        }
      }
    },

    "NumberChange": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["NUMBER_CHANGE"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              {
                "required": ["effectiveDate", "newAreaCode", "newServiceNumber"],
                "properties": {
                  "newAreaCode":      { "type": "string", "minLength": 1, "maxLength": 16 },
                  "newServiceNumber": { "type": "string", "minLength": 1, "maxLength": 24 }
                }
              }
            ]
          }
        }
      }
    },

    "VoluntaryCancellation": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["VOLUNTARY_CANCELLATION"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              {
                "required": ["effectiveDate"],
                "properties": {
                  "bundleIdCRM": { "type": "string", "minLength": 1, "maxLength": 9 }
                }
              }
            ]
          }
        }
      }
    },

    "StratumChange": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["STRATUM_CHANGE"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber", "custId"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              {
                "properties": {
                  "socialLevel": { "type": "string", "enum": ["","1","2","3","4","5","6"] },
                  "contacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ContactItemWithOperate" } },
                  "attributes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/AttributeItemWithOperate" } }
                }
              }
            ]
          }
        }
      }
    },

    "AddressChange": {
      "required": ["processCode", "transaction", "services"],
      "properties": {
        "processCode": { "type": "string", "enum": ["ADDRESS_CHANGE"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber", "custId"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              {
                "required": ["areaCode", "effectiveDate"],
                "properties": {
                  "department":         { "type": "string", "minLength": 1, "maxLength": 15 },
                  "city":               { "type": "string", "minLength": 1, "maxLength": 15 },
                  "address":            { "type": "string", "minLength": 1, "maxLength": 15 },
                  "socialLevel":        { "type": "string", "enum": ["","1","2","3","4","5","6"] },
                  "offerCode":          { "type": "string", "minLength": 1, "maxLength": 60 },
                  "originalDepartment": { "type": "string", "minLength": 1, "maxLength": 15 },
                  "originalCity":       { "type": "string", "minLength": 1, "maxLength": 15 },
                  "originalAddress":    { "type": "string", "minLength": 1, "maxLength": 15 },
                  "destDepartment":     { "type": "string", "minLength": 1, "maxLength": 15 },
                  "destCity":           { "type": "string", "minLength": 1, "maxLength": 15 },
                  "destAddress":        { "type": "string", "minLength": 1, "maxLength": 15 },
                  "attributes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/AttributeItemWithOperate" } },
                  "offers":     { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/OfferItemWithOperate" } }
                }
              }
            ]
          }
        }
      }
    },

    "OwnershipTransfer": {
      "required": ["processCode", "transaction"],
      "properties": {
        "processCode": { "type": "string", "enum": ["OWNERSHIP_TRANSFER"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["serviceNumber", "custId", "acctId"] }
          ]
        },
        "services": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/ServiceBase" },
              { "required": ["areaCode", "effectiveDate"] }
            ]
          }
        },
        "newCustomer":     { "$ref": "#/definitions/NewCustomer" },
        "newCustAttributes": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/AttributeItem" }
        },
        "newAccount":      { "$ref": "#/definitions/NewAccount" },
        "newAcctAttributes": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/definitions/AttributeItem" }
        }
      }
    },

    "AccountUpdate": {
      "required": ["processCode", "transaction", "account"],
      "properties": {
        "processCode": { "type": "string", "enum": ["ACCOUNT_UPDATE"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["custId"] }
          ]
        },
        "account": {
          "type": "object",
          "required": ["acctId"],
          "properties": {
            "acctId":                { "type": "integer", "maximum": 999999999999999 },
            "acctName":              { "type": "string",  "minLength": 1, "maxLength": 256 },
            "billDeliveryType":      { "type": "string",  "minLength": 1, "maxLength": 30 },
            "parentAcctId":          { "type": "integer", "maximum": 999999999999999 },
            "billFlag":              { "type": "string",  "enum": ["Yes","No"] },
            "taxExempt":             { "type": "string",  "enum": ["Yes","No"] },
            "dunningExemption":      { "type": "string",  "enum": ["No","Temporary","Total"] },
            "dunningExemEff":        { "type": "string",  "minLength": 19, "maxLength": 19 },
            "dunningExemExp":        { "type": "string",  "minLength": 19, "maxLength": 19 },
            "contractName":          { "type": "string",  "minLength": 1, "maxLength": 60 },
            "roundingAdjustmentFlag":{ "type": "string",  "minLength": 1, "maxLength": 6 },
            "previousBalanceFlag":   { "type": "string",  "minLength": 1, "maxLength": 6 },
            "coverPageOnlyFlag":     { "type": "string",  "minLength": 1, "maxLength": 6 },
            "interestChargeFlag":    { "type": "string",  "minLength": 1, "maxLength": 6 },
            "interestRateType":      { "type": "string",  "enum": ["1","2"] },
            "dunningManagementTime": { "type": "string",  "minLength": 1, "maxLength": 6 },
            "country":               { "type": "string",  "minLength": 1, "maxLength": 15 },
            "departament":           { "type": "string",  "minLength": 1, "maxLength": 15 },
            "city":                  { "type": "string",  "minLength": 1, "maxLength": 15 },
            "district":              { "type": "string",  "minLength": 1, "maxLength": 15 },
            "address":               { "type": "string",  "minLength": 1, "maxLength": 200 },
            "paymentTerm":           { "type": "string",  "minLength": 1, "maxLength": 6 },
            "attributes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/AttributeItemWithOperate" } },
            "contacts":   { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ContactItemWithOperate" } }
          }
        }
      }
    },

    "BillingCycleChange": {
      "required": ["processCode", "transaction", "account"],
      "properties": {
        "processCode": { "type": "string", "enum": ["BILLING_CYCLE_CHANGE"] },
        "transaction": { "$ref": "#/definitions/TransactionBase" },
        "account": {
          "type": "object",
          "required": ["corte", "effectiveDate"],
          "properties": {
            "corte":         { "type": "string", "minLength": 1, "maxLength": 15 },
            "effectiveDate": { "type": "string", "minLength": 19, "maxLength": 19 }
          }
        }
      }
    },

    "CustomerUpdate": {
      "required": ["processCode", "transaction", "customer"],
      "properties": {
        "processCode": { "type": "string", "enum": ["CUSTOMER_UPDATE"] },
        "transaction": {
          "allOf": [
            { "$ref": "#/definitions/TransactionBase" },
            { "required": ["custId"] }
          ]
        },
        "customer": {
          "type": "object",
          "properties": {
            "custId":          { "type": "integer", "maximum": 999999999999999 },
            "firstName":       { "type": "string",  "minLength": 1, "maxLength": 255 },
            "lastName":        { "type": "string",  "minLength": 1, "maxLength": 255 },
            "middleName":      { "type": "string",  "minLength": 1, "maxLength": 255 },
            "secondLastName":  { "type": "string",  "minLength": 1, "maxLength": 255 },
            "custName":        { "type": "string",  "minLength": 1, "maxLength": 255 },
            "nombreJuridico":  { "type": "string",  "minLength": 1, "maxLength": 100 },
            "gender":          { "type": "string",  "minLength": 1, "maxLength": 15 },
