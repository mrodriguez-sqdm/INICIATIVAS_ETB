{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BillingProcessPostRequest",
  "type": "object",
  "required": [
    "processCode",
    "transaction"
  ],
  "properties": {
    "processCode": {
      "type": "string",
      "enum": [
        "SALE",
        "SALE_BUNDLE",
        "NEW_CUSTOMER",
        "NEW_ACCOUNT"
      ]
    }
  },
  "if": {
    "properties": {
      "processCode": {
        "const": "SALE"
      }
    }
  },
  "then": {
    "$ref": "#/definitions/Sale"
  },
  "else": {
    "if": {
      "properties": {
        "processCode": {
          "const": "SALE_BUNDLE"
        }
      }
    },
    "then": {
      "$ref": "#/definitions/SaleBundle"
    },
    "else": {
      "if": {
        "properties": {
          "processCode": {
            "const": "NEW_CUSTOMER"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/NewCustomer"
      },
      "else": {
        "$ref": "#/definitions/NewAccount"
      }
    }
  },
