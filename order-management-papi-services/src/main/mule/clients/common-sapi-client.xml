<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="generate-cun-subFlow"
		doc:id="7555fd1f-d02c-4756-85d6-5329893b9eb9">

		<http:request doc:name="POST CUN"
			doc:id="4d0df5c8-60eb-472b-b384-055faab94e81"
			config-ref="HTTP_common-sapi_Request_Config"
			method="POST"
			path="${common-sapi.postCunAssigment.path}" sendCorrelationId="AUTO"
			responseTimeout="${backend.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
	"client_secret" : p('secure::credentials.client-secret'),
	"client_id" : p('secure::credentials.client-id'),
	"name": vars.headers.name,
	"X-CORRELATION-ID": vars.headers."X-CORRELATION-ID",
	"source": vars.headers.source,
	"systemId": vars.headers.systemId
}]]]></http:headers>
		</http:request>
	</sub-flow>
</mule>
