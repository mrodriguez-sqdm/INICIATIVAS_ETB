#%RAML 1.0 DataType 
type: object
properties:
  customer:
    type: object
    required: false
    properties:
      documentType:
        type: string
        enum: [CC, NIT]
        example: CC
        required: false
      documentNumber:
        type: string
        example: '5412454'
        required: false
      mail:
        type: string
        example: sqdmpruebasqabcd3@yopmail.co
        required: false
      password:
        type: string
        example: sdfsddf54dfsgdfg5454=
        required: false