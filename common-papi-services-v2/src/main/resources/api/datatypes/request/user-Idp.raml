#%RAML 1.0 DataType 
type: object
properties:
  customer:
    type: object
    properties:
      documentType:
        type: string
        example: CC
        required: false
      documentNumber:
        type: string
        example: '5412454'
        required: false
      email:
        type: string
        example: sqdmpruebasqabcd3@yopmail.co
        required: false
      password:
        type: object
        required: false
        properties:
          value:
            type: string
            example: base64_encryptp
            required: true
          iv:
            type: string
            example: base_64key
            required: true