#%RAML 1.0 DataType
type: object
description: Upload document request. file.storage routes to Azure (multipart) or SFTP/portability (JSON to common-sapi).
properties:
  origin:
    type: string
    description: Source channel or client IP identifier
    required: false
    example: "10.0.0.5"
  file:
    type: object
    required: true
    properties:
      storage:
        type: string
        enum: [AZURE, SFTP]
        description: Target storage — AZURE uses azure-sapi agreements upload; SFTP uses common-sapi portability documents
      contentBase64:
        type: string
        description: File content encoded in Base64 (required for both flows)
      fileName:
        type: string
        description: File name including extension
      mimeType:
        type: string
        description: MIME type; Azure upload typically expects application/pdf
        required: false
        default: "application/pdf"
        example: "application/pdf"
      container:
        type: string
        description: Azure blob container (required when storage is AZURE)
        required: false
      remotePath:
        type: string
        description: Optional subpath or folder for SFTP portability upload (maps to filePath in downstream)
        required: false
        example: ""
