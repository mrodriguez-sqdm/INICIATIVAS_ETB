#%RAML 1.0 DataType
displayName: Trouble Ticket Request
description: Represents a trouble ticket with customer, service and pqr data.
example: !include ../../examples/request/post-trouble-ticket-request.json
type: object
properties:
  ticket:
    type: object
    properties:
      cun:
        type: boolean
        example: true
        required: true
      customer:
        type: object
        properties:
          user?:
            type: string
            example: "USUARIO_SISTEMA"
            required: false
          documentNumber:
            type: string
            example: "87654321"
            required: true
          documentType:
            type: string
            example: "CC"
            required: true
          email?:
            type: string
            example: "user@email.com"
            required: false
          phone:
            type: string
            example: "3057000421"
            required: false
      service:
        type: object
        properties:
          product:
            type: string
            example: "INTERNET_FIBRA"
            required: true
          orderNumber:
            type: string
            example: "ORD78965426"
            required: true
          connectionNumber:
            type: string
            example: "CONN2132658"
            required: false
          serviceAccountId:
            type: string
            example: "ORD78965426"
            required: true
      pqr:
        type: object
        properties:
          pqrType:
            type: string
            example: "PQR_TYPE"
            required: true
          pqrDate:
            type: string
            example: "2025-03-16"
            required: true
          description:
            type: string
            example: "Descripcion del problema reportado"
            required: true
          contact:
            type: object
            properties:
              documentNumber:
                type: string
                example: "12345678"
                required: false
              documentType:
                type: string
                example: "CC"
                required: false
              phone:
                type: string
                example: "3001234567"
                required: false
              email:
                type: string
                example: "customer_email@domain.com"
                required: false
          cunMassiveFailure:
            type: string
            example: "CUN-MASIVA-001"
            required: false
          cunRelated:
            type: string
            example: "CUN-RELACIONADO-001"
            required: false
          failure?:
            type: object
            properties:
              botRequest:
                type: string
                example: "FALLA_INTERNET"
                required: false
              causal:
                type: string
                example: "FALLA_TECNICA"
                required: false
              class:
                type: string
                example: "INTERNET"
                required: false
              description:
                type: string
                example: "Descripcion de la falla"
                required: false
              reason:
                type: string
                example: "FALLA_TECNICA"
                required: false
              symptom:
                type: string
                example: "SIN_CONEXION"
                required: false
              activityS1N:
                type: string
                example: "Activity S1N"
                required: false
          solution:
            type: string
            example: "Solucion aplicada"
            required: true
          state:
            type: string
            example: "ABIERTA"
            required: true
          attachment?:
            type: array
            items:
              type: object
              properties:
                id:
                  type: string
                  example: "ATTACHMENT1235"
                  required: true
                description:
                  type: string
                  example: "Descripcion adjuntos"
                  required: true
                attachmentType:
                  type: string
                  example: "image"
                  required: true
                mimeType:
                  type: string
                  example: "image/png"
                  required: true
                file:
                  type: string
                  example: "JVBERi0xLjQKJcOkw7zDtsO..."
                  required: true
                name:
                  type: string
                  example: "Factura Marzo"
                  required: true
                size:
                  type: string
                  example: "2.5 Mb"
                  required: true
                url:
                  type: string
                  example: "http://host.com/image_url_path"
                  required: true