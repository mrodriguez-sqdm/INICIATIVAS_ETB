#%RAML 1.0 DataType
displayName: Trouble Ticket Request
description: Represents a trouble ticket with customer, service and pqr data.
type: object
properties:
  ticket:
    type: object
    properties:
      pqrId:
        type: string
        example: "PRQ12345"
        required: true
      customer:
        type: object
        properties:
          documentNumber:
            type: string
            example: "87654321"
            required: true
          documentType:
            type: string
            example: "CC"
            required: true
      service:
        type: object
        properties:
          product:
            type: string
            example: "INTERNET_FIBRA"
            required: false
          orderNumber:
            type: string
            example: "ORD78965426"
            required: false
          connectionNumber:
            type: string
            example: "CONN2132658"
            required: false
          serviceAccountId:
            type: string
            example: "ORD78965426"
            required: false
      pqr:
        type: object
        properties:
          assignedUser?:
            type: string
            description: Usuario que se asigna al PQR
            example: "NICOLAS MORA"
          pqrStatus?:
            type: string
            description: Nuevo estado del PQR
            example: "CERRADO"
          activity?:
            type: object
            description: Datos de la actividad del PQR a crear o actualizar
            properties:
              name?:
                type: string
                description: Nombre o identificador de la actividad
                example: "Validacion de facturacion"
              managementGroup?:
                type: string
                description: Grupo de gestion asignado a la actividad
                example: "Back Office Facturacion"
              activityClass?:
                type: string
                description: Clase o categoria de la actividad
                example: "Tecnica"
              reason?:
                type: string
                description: Motivo asociado a la actividad
                example: "Ajuste de facturacion"
              description?:
                type: string
                description: Descripcion detallada de la actividad
                example: "Se revisa el historico de facturacion del cliente"
              observations?:
                type: string
                description: Observaciones adicionales sobre la gestion realizada
                example: "Cliente contactado telefonicamente"
              activityType?:
                type: string
                description: Tipo de actividad
                example: "Gestion"
              closePqr?:
                type: string
                description: Indicador de si esta actividad da cierre al PQR
                example: "S"
              status?:
                type: string
                description: Estado de la actividad
                example: "Completada"
              setType?:
                type: string
                description: tipo de actividad
                example: "U"
              startDate?:
                type: string
                description: Fecha de inicio de la actividad
                example: "2026-09-07T09:00:00-05:00"
              endDate?:
                type: string
                description: Fecha de finalizacion de la actividad
                example: "2026-09-07T17:00:00-05:00"
              version?:
                type: string
                description: Version del registro de la actividad, usada para control de concurrencia
                example: "1"
          characteristics?:
            type: array
            description: Caracteristicas del PQR a crear o actualizar
            items:
              type: object
              properties:
                name?:
                  type: string
                  description: Nombre de la caracteristica
                  example: "Estrato"
                value?:
                  type: string
                  description: Valor de la caracteristica
                  example: "3"
                setType?:
                  type: string
                  description: tipo de caracteristica
                  example: "U"
examples: 
  PQR_ACTIVITY_UPDATE: !include ../../examples/request/patch-trouble-ticket-activity-request.json
  PQR_CHARACTERISTICS_UPDATE: !include ../../examples/request/patch-trouble-ticket-characteristic-request.json
  PQR_STATUS_UPDATE: !include ../../examples/request/patch-trouble-ticket-status-request.json
  PQR_USER_UPDATE: !include ../../examples/request/patch-trouble-ticket-user-request.json