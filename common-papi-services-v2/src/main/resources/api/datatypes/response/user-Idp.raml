#%RAML 1.0 DataType 
type: object
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: consulta realizadaexitosamente
    required: false
  customer:
    type: object
    required: false
    properties:
      idp:
        type: object
        properties:
          creationDate:
            type: datetime
            example: '2026-05-26T22:05:10.960Z'
            required: false
          id:
            type: string
            example: 5811f9a3-8f52-463f-8082-fefa933126a3
            required: false
          lastUpdateDate:
            type: datetime
            example: '2026-05-26T22:05:10.960Z'
            required: false
          status:
            type: boolean
            example: true
            required: false
      mail:
        type: string
        example: sqdmpruebasqabcd3@yopmail.co
        required: false
