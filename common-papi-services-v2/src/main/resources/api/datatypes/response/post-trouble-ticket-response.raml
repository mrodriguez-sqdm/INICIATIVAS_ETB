#%RAML 1.0 DataType
type: object
properties:
  code:
    type: string
    example: "200"
  message:
    type: string
    example: "Operacion exitosa"
  cun?:
    type: object
    properties:
      cunNumber:
        type: string
        example: "CUN986532"
        required: true
      cunDate:
        type: string
        example: "2026-03-16"
        required: true
      pqrType:
        type: string
        example: "PQR_TYPE"
        required: true
      pqrDate:
        type: string
        example: "2026-03-16"
        required: true
      system:
        type: string
        example: "TBD"
        required: true
      orderNumber:
        type: string
        example: "ORD123265"
        required: true
      documentType:
        type: string
        example: "CC"
        required: true
      documentNumber:
        type: string
        example: "98653212"
        required: true
      connectionNumber:
        type: string
        example: "CONN54976"
        required: true
  pqr?:
    type: object
    properties:
      databaseId:
        type: string
        example: "PQR879865"
        required: true
      operationResult:
        type: string
        example: "Success"
        required: true
      operationResultDescription:
        type: string
        example: "PQR Created successfully"
        required: true
      mongoId:
        type: string
        example: "546898654651"
        required: true
examples:
  cun: !include ../../examples/response/post-trouble-ticket-cun-response.json
  pqr: !include ../../examples/response/post-trouble-ticket-pqr-response.json