<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">
	<sub-flow name="patch-trouble-ticket-orchestrator-sub-flow"
		doc:id="b1ab798f-96bb-4230-8837-11fcfce8bab3">
		<try doc:name="Try" doc:id="1720a960-cbdd-4ceb-8031-e366943a17ab" >
			<validation:is-false doc:name="validate body to update" doc:id="067d7062-b9bf-4dec-a68c-ef54bbc322e3" expression="#[sizeOf(payload.ticket.pqr) &gt; 1]" message="The current service only supports one operation at the time. Please send one of user, status, activity or characteristics."/>
			<ee:transform doc:name="set intialPayload - httpheader - pqrUpdateType" doc:id="75400652-cebc-42ef-8d67-e8fd81099c6b">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="initialPayload"><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
				<ee:set-variable variableName="headers"><![CDATA[%dw 2.0
output application/java
---
{
	"client_secret" : p('secure::api.clientSecret'),
	"client_id" : p('secure::api.clientId'),
	"name": attributes.headers.name,
	"X-CORRELATION-ID": attributes.headers."x-correlation-id",
	"source": attributes.headers.source,
	"systemId": attributes.headers.systemId
}]]></ee:set-variable>
					<ee:set-variable variableName="pqrUpdateType" ><![CDATA[%dw 2.0
import * from dw::Runtime
output application/java
---
if(payload.ticket.pqr.activity?) "activity" 
else if(payload.ticket.pqr.characteristics?) "characteristics" 
else if(payload.ticket.pqr.status?) "status" 
else if(payload.ticket.pqr.assignedUser?) "user" 
else fail("The pqr update cannot be performed")]]></ee:set-variable>
			
</ee:variables>
				</ee:variables>
			</ee:transform>
			<choice doc:name="validate pqr activity"
				doc:id="5c108077-a4b9-4ff3-8b58-1288808710b4">
				<when expression='#[vars.pqrUpdateType == "activity"]'>
					<flow-ref doc:name="validate-pqr-activity"
						doc:id="ffeb4d80-2707-458f-bef6-61c66284f580"
						name="validate-pqr-activity" />
				</when>
				<otherwise>
					<logger level="DEBUG" doc:name="No validation"
						doc:id="1ffebe26-cc10-427c-8460-5d71cdbd60fc"
						message="PQR activity validation skipped -- the process will continue" />
				</otherwise>
			</choice>
			<flow-ref doc:name="validate-pqr-details"
				doc:id="dc0d6bd1-c8f0-47be-a4a7-b787a06b798d"
				name="validate-pqr-details" />
			<ee:transform doc:name="set patch pqr request"
				doc:id="c72291ce-eb4c-4bec-a288-9f3bc43afd65">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"
---
{
  "activity": vars.initialPayload.ticket.pqr.activity,
  "characteristics": vars.initialPayload.ticket.pqr.characteristics,
  "pqrStatus": vars.initialPayload.ticket.pqr.status,
  "assignedUser": vars.initialPayload.ticket.pqr.assignedUser
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="uriParameters"><![CDATA[%dw 2.0
output application/json
---
if ((vars.pqrUpdateType == "activity") or (vars.pqrUpdateType == "characteristics"))
{
	pqrId: vars.pqrDetails.pqr[0].id
}
else
{
	pqrId: vars.initialPayload.ticket.pqrId
}]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref
				doc:name="patch-pqr-by-id-datalogic-sapi-client-sub-flow"
				doc:id="10f0ecfe-3ece-4404-97a7-db7ca2206e5e"
				name="patch-pqr-by-id-datalogic-sapi-client-sub-flow" />
			<error-handler>
				<on-error-continue enableNotifications="true"
					logException="true" doc:name="On Error Continue"
					doc:id="a094ca9f-7d5b-489e-88c0-fb27901cea8f"
					type="VALIDATION:INVALID_BOOLEAN">
					<ee:transform doc:name="set pqr body error"
						doc:id="412d6191-43cc-41e2-807b-7bdd2afecee2">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": "400",
    "code": "PATCH_TROUBLE_TICKET:BAD_REQUEST",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "customer-papi-services-v2",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables>
							<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
				<on-error-continue enableNotifications="true"
					logException="true" doc:name="On Error Continue"
					doc:id="ccbc1c4c-aeac-4864-87fe-45b74e96ca39"
					type="VALIDATION:MULTIPLE">
					<ee:transform doc:name="set pqr validation error"
						doc:id="11b821be-6f4f-40cd-a675-65305b868c85">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "status": "400",
    "code": "PATCH_TROUBLE_TICKET:INVALID_PARAMS",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "customer-papi-services-v2",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables>
							<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
	<sub-flow name="validate-pqr-activity"
		doc:id="22f23adc-bec1-4600-8408-181ce8c4cc98">
		<ee:transform doc:name="set mongo dynamicQuery request"
			doc:id="2066a8d7-125d-4f14-a91a-5c1b53bba74e">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"
---
{
	basePath: p("mongoDbSapi.basePath"),
	host: p("mongoDbSapi.host"),
	port: p("mongoDbSapi.port"),
	method: p('mongoDbSapi.dynamicQuery.post.method'),
	path: p('mongoDbSapi.dynamicQuery.path'),
	body: {
		"query": {
			"aggregate": "PQR_ACTIVIDAD",
			"pipeline": [{
				"actividad": vars.initialPayload.ticket.pqr.activity.activityName,
				"grupo_gestion": vars.initialPayload.ticket.pqr.activity.managementGroup,
				"clase": vars.initialPayload.ticket.pqr.activity.class,
				"motivo": vars.initialPayload.ticket.pqr.activity.reason,
				"estado": "ACTIVO"
			}],
			"cursor": {
			}
		}
	},
	headers: vars.headers,
	queryParameters: {
	},
	uriParameters: {
	}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref
			doc:name="mongo-db-sapi-common-request (PQR_ACTIVIDAD)"
			doc:id="12c27bd6-935e-43b7-95cc-d1ec798c7143"
			name="mongo-db-sapi-common-request" target="pqrActivitiesResponse" />
		<validation:is-false
			doc:name="validate pqr typology"
			doc:id="4126ec0c-3491-44ba-a530-54e90ae20735"
			expression="#[isEmpty(vars.pqrActivitiesResponse.result default [])]"
			message="The PQR activity does not match with the PQR activities in our system." />
	</sub-flow>
	<sub-flow name="validate-pqr-details"
		doc:id="f87eebaf-8795-40d3-b740-e908bdfd4cdc">
		<ee:transform doc:name="set get pqr request"
			doc:id="bda03000-616d-4900-b460-63f944c8e47c">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="queryParameters"><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"
---
{
	pqrNumber: vars.initialPayload.ticket.pqrId
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="get-pqr-datalogic-sapi-client-sub-flow"
			doc:id="56ad419e-dda8-424f-86a7-1327937cb274"
			name="get-pqr-datalogic-sapi-client-sub-flow" target="pqrDetails" />
		<validation:all doc:name="All"
			doc:id="9039358d-a542-4439-90d6-77a574dc467b">
			<validation:is-false
				doc:name="validate pqr status"
				doc:id="64a83263-5360-4e32-96fd-7ce56a04612a"
				expression='#[(lower(vars.pqrDetails.pqr[0].pqrStatus) == "cerrado") or (lower(vars.pqrDetails.pqr[0].pqrStatus) == "terminado") or  (lower(vars.pqrDetails.pqr[0].pqrStatus) == "anulado")]'
				message="The PQR is already closed" />
			<validation:is-false
				doc:name="validate pqr customer docType "
				doc:id="09d8ed5b-4112-419e-9ab4-c24100f28d9b"
				expression="#[(vars.initialPayload.ticket.customer.documentType != vars.pqrDetails.pqr[0].documentType)]"
				message="The customer's document type does not match with the PQR details in our system." />
			<validation:is-false
				doc:name="validate pqr customer docNumber"
				doc:id="a7133632-2079-4b36-bcb5-8cb0b7b3a56e"
				expression="#[(vars.initialPayload.ticket.customer.documentNumber != vars.pqrDetails.pqr[0].identificationNumber)]"
				message="The customer's document number does not match with the PQR details in our system." />
			<validation:is-false doc:name="validate product"
				doc:id="34a93617-989d-4239-967f-b563300e5ee2"
				expression="#[(vars.initialPayload.ticket.service.product != vars.pqrDetails.pqr[0].product)]"
				message="The product does not match with the PQR details in our system." />
			<validation:is-false
				doc:name="validate connectionNumber"
				doc:id="99f1d4a7-c95b-490e-9667-1eb9073b0919"
				expression="#[(vars.initialPayload.ticket.service.connectionNumber != vars.pqrDetails.pqr[0].connectionNumber)]"
				message="The connection number does not match with the PQR details in our system." />
			<validation:is-false
				doc:name="validate serviceAccount"
				doc:id="f23a18ec-3c3b-45de-a371-b3e32ef174a4"
				expression="#[(vars.initialPayload.ticket.service.serviceAccountId != vars.pqrDetails.pqr[0].serviceAccount)]"
				message="The service account Id does not match with the PQR details in our system." />
		</validation:all>
	</sub-flow>
</mule>
