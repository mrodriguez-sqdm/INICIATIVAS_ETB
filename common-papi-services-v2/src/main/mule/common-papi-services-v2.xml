<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="common-papi-services-main"
		doc:id="db99357d-c3ed-41d4-a57c-fffa8055d8a7">
		<http:listener doc:name="Listener"
			doc:id="bff849e5-2e1b-4a38-9a6b-29494705b5c1"
			config-ref="common-papi-services-v2-httpListenerConfig"
			path="${api.basePath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="initial-loggin-Sub_Flow"
			doc:id="e0a7ff6c-3277-47fe-a935-fa6f45fdc61d"
			name="initial-loggin-Sub_Flow" />
		<apikit:router doc:name="APIkit Router"
			doc:id="eab82395-ccc1-4d6d-99e9-03a7d3224359"
			config-ref="common-papi-services-config" />
		<async doc:name="Async"
			doc:id="1f5e7c61-ab30-4b1c-9fc7-2319abdce901">
			<flow-ref doc:name="loggin-client-call"
				doc:id="9ea5abd9-e69d-404a-a430-08cf15eeba3e"
				name="loggin-client-call" />
		</async>
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="common-papi-services-console"
		doc:id="f99e6432-3a71-43e5-92a4-598964da740a">
		<http:listener doc:name="Listener"
			doc:id="084bc601-c42f-4641-b7bd-494feb556793"
			config-ref="common-papi-services-v2-httpListenerConfig"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console doc:name="APIkit Console"
			doc:id="3f883827-754f-4511-b7ff-146abfe352e4"
			config-ref="common-papi-services-config" />
	</flow>
	<flow name="get:\parameters:common-papi-services-config"
		doc:id="3f08ecc0-d567-4ddc-b073-b6b65cfedde9">
		<flow-ref doc:name="Flow Reference"
			doc:id="2f7e1aaf-788c-4565-ab40-58b70deb2db2"
			name="parametersRetention-get-orchestadorSub_Flow" />
	</flow>
	<flow
		name="post:\documents:application\json:common-papi-services-config"
		doc:id="c3d4e5f6-a7b8-9012-cdef-123456789abc">
		<flow-ref doc:name="Flow Reference"
			doc:id="d4e5f6a7-b890-1234-def0-abcdef123456"
			name="document-upload-orchestratorSub_Flow" />
	</flow>
	<flow
		name="post:\communications\message:application\json:common-papi-services-config">
		<flow-ref doc:name="post-comm-message-orchestrator"
			doc:id="bbc9f3c5-bf4f-4af6-af51-f277898b4900"
			name="post-comm-message-orchestrator" />
	</flow>
</mule>
