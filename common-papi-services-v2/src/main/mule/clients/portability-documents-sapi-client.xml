<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="portability-documents-post-clientSub_Flow"
		doc:id="c3d4e5f6-a7b8-9012-cdef-123456789012">
		<http:request method="${portabilityDocumentsSapi.upload.post.method}"
			doc:name="POST portability documents"
			doc:id="d4e5f6a7-b890-1234-def0-234567890123"
			config-ref="HTTP_Request_configuration_portability_documents_sapi"
			path="${portabilityDocumentsSapi.upload.path}">
			<http:headers><![CDATA[#[output application/java
---
{
	"client_secret" : p('secure::api.clientSecret'),
	"client_id" : p('secure::api.clientId'),
	"name": vars.headers.name,
	"X-CORRELATION-ID": vars.headers."X-CORRELATION-ID",
	"source": vars.headers.source,
	"systemId": vars.headers.systemId
}]]]></http:headers>
		</http:request>
	</sub-flow>
</mule>
