<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow
		name="post-pqr-attachments-azure-sapi-client-sub-flow"
		doc:id="9b51636e-cb30-410b-bdfa-922ada7501be">
		<http:request
			method="${azureSapi.pqrAttachments.post.method}"
			doc:name="POST /pqr/attachments"
			doc:id="364bff26-4412-4c45-8c16-660adeedf5c7"
			config-ref="HTTP_Request_configuration_azure_sapi"
			path="${azureSapi.pqrAttachments.path}" sendCorrelationId="AUTO">
			<http:headers><![CDATA[#[vars.headers default {}]]]></http:headers>
			<http:uri-params><![CDATA[#[vars.fileDetails default {}]]]></http:uri-params>
		</http:request>
	</sub-flow>
	<sub-flow name="azure-sapi-post-agreements-clientSub_Flow"
		doc:id="0a99e061-bcf7-4851-8540-6bcd5ec5a176">
		<http:request method="${azureSapi.agreements.post.method}"
			doc:name="POST azure agreements"
			doc:id="1a85d23f-7132-4c83-8c3c-5c2b49fe5303"
			config-ref="HTTP_Request_configuration_azure_sapi"
			path="${azureSapi.agreements.path}" sendCorrelationId="AUTO">
			<http:headers><![CDATA[#[output application/java
---
{
	"client_secret" : p('secure::api.clientSecret'),
	"client_id" : p('secure::api.clientId'),
	"name": vars.headers.name,
	"X-CORRELATION-ID": vars.headers."X-CORRELATION-ID",
	"source": vars.headers.source,
	"systemId": vars.headers.systemId
}]]]></http:headers>
		</http:request>
	</sub-flow>
</mule>
