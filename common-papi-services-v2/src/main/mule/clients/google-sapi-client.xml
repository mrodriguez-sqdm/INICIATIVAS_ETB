<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">

	<sub-flow name="google-sapi-clientSub_Flow"
		doc:id="939e9451-4543-462c-b7ad-7a589fb05891">
		<http:request method="#[payload.method]"
			doc:name="Request" doc:id="d32b8766-afe6-4594-a1fe-5d4e649db18f"
			config-ref="HTTP_Request_configuration_google-sapi" path="#[payload.path]">
			<http:body><![CDATA[#[payload.body]]]></http:body>
			<http:headers><![CDATA[#[payload.headers default {}]]]></http:headers>
			<http:uri-params><![CDATA[#[payload.uriParameters default {}]]]></http:uri-params>
			<http:query-params><![CDATA[#[payload.queryParameters default {}]]]></http:query-params>
		</http:request>
	</sub-flow>

</mule>
