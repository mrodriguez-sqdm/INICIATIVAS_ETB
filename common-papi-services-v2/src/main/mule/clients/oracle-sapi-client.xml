<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="post-notification-oracle-sapi-client"
		doc:id="9daf08cc-304f-4e24-acbb-b93aabb33491">
		<logger level="INFO" doc:name="Log Request"
			doc:id="98108c83-b37e-4bdb-9832-1843590ccffb"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /notificacions"]' />
		<http:request
			method="${oracleSapi.notifications.post.method}"
			doc:name="POST /notifications"
			doc:id="c7dccfe8-0bec-4eb5-a4e3-556e43430b8a"
			config-ref="HTTP_Oracle_SAPI_Request_Config"
			path="${oracleSapi.notifications.path}" sendCorrelationId="AUTO">
			<http:headers><![CDATA[#[output application/java
---
{
	"client_secret" : p('secure::api.clientSecret'),
	"client_id" : p('secure::api.clientId'),
	"name": vars.headers.name,
	"X-CORRELATION-ID": vars.headers."X-CORRELATION-ID",
	"source": vars.headers.source,
	"systemId": vars.headers.systemId
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			doc:id="32fe93af-4ca8-49fb-9a68-3a6efbdf9808"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /notificacions | status=CREATED"]' />
	</sub-flow>
</mule>
