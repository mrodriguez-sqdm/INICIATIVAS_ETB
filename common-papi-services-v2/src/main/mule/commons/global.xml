<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">
	<http:listener-config
		name="common-papi-services-v2-httpListenerConfig">
		<http:listener-connection
			host="${http.private.host}" port="${http.private.port}"
			readTimeout="${http.private.readTimeout}" />
	</http:listener-config>
	<apikit:config name="common-papi-services-config"
		api="common-papi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<http:request-config
		name="HTTP_Mongo_SAPI_Request_Config"
		doc:name="HTTP Mongo Request Config"
		doc:id="d19e7238-cabf-4fd5-ba2c-c0d272a048e5"
		basePath="${mongoDbSapi.basePath}"
		responseTimeout="${mongoDbSapi.responseTimeout}">
		<http:request-connection
			protocol="${mongoDbSapi.protocol}" host="${mongoDbSapi.host}"
			port="${mongoDbSapi.port}"
			connectionIdleTimeout="${mongoDbSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${mongoDbSapi.reconnection.frequency}"
					count="${mongoDbSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_azure_sapi"
		doc:name="HTTP Request configuration"
		doc:id="a1b2c3d4-5678-90ab-cdef-111111111111"
		basePath="${azureSapi.basePath}"
		responseTimeout="${azureSapi.responseTimeout}">
		<http:request-connection
			protocol="${azureSapi.protocol}" host="${azureSapi.host}"
			port="${azureSapi.port}"
			connectionIdleTimeout="${azureSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect frequency="${azureSapi.reconnection.frequency}"
					count="${azureSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_portability_documents_sapi"
		doc:name="HTTP Request configuration"
		doc:id="6586a9fe-a13a-4557-97f3-67ce0f60cdf1"
		basePath="${portabilityDocumentsSapi.basePath}"
		responseTimeout="${portabilityDocumentsSapi.responseTimeout}">
		<http:request-connection
			protocol="${portabilityDocumentsSapi.protocol}"
			host="${portabilityDocumentsSapi.host}"
			port="${portabilityDocumentsSapi.port}"
			connectionIdleTimeout="${portabilityDocumentsSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${portabilityDocumentsSapi.reconnection.frequency}"
					count="${portabilityDocumentsSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_directv-sapi"
		doc:name="HTTP Request configuration"
		basePath="${directvSapi.basePath}"
		responseTimeout="${directvSapi.responseTimeout}">
		<http:request-connection
			protocol="${directvSapi.protocol}" host="${directvSapi.host}"
			port="${directvSapi.port}"
			connectionIdleTimeout="${directvSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${directvSapi.reconnection.frequency}"
					count="${directvSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
   <http:request-config
		name="HTTP_Request_configuration_google-sapi"
		doc:name="HTTP Request configuration"
		basePath="${google-sapi.base-path}"
		responseTimeout="${google-sapi.responseTimeout}">
		<http:request-connection
			protocol="${google-sapi.protocol}" host="${google-sapi.host}"
			port="${google-sapi.port}"
			connectionIdleTimeout="${google-sapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${google-sapi.reconnection.frequency}"
					count="${google-sapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config name="client_sapi_config"
		doc:name="HTTP Request configuration"
		doc:id="228092c2-74d1-49bb-ac87-e2dfc2c3cca5"
		basePath="#[payload.basePath]"
		responseTimeout="${clientSapi.responseTimeout}">
		<http:request-connection
			host="#[payload.host]" port="#[payload.port]"
			connectionIdleTimeout="${clientSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${clientSapi.reconnection.frequency}"
					count="${clientSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="Common_SAPI_HTTP_Request_configuration"
		doc:name="HTTP Request configuration"
		doc:id="497eefb7-258d-484a-915d-51dccfed78c5"
		basePath="${commonSapi.basePath}"
		responseTimeout="${commonSapi.responseTimeout}">
		<http:request-connection
			protocol="${commonSapi.protocol}" host="${commonSapi.host}"
			port="${commonSapi.port}"
			connectionIdleTimeout="${commonSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${commonSapi.reconnection.frequency}"
					count="${commonSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="Datalogic_SAPI_HTTP_Request_configuration"
		doc:name="HTTP Request configuration"
		doc:id="087a3aea-9270-4914-9269-636c8275011f"
		basePath="${dataLogicSapi.basePath}"
		responseTimeout="${dataLogicSapi.responseTimeout}">
		<http:request-connection
			protocol="${dataLogicSapi.protocol}" host="${dataLogicSapi.host}"
			port="${dataLogicSapi.port}"
			connectionIdleTimeout="${dataLogicSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${dataLogicSapi.reconnection.frequency}"
					count="${dataLogicSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<import doc:name="Error Handler v2"
		doc:id="3b8a6815-9a1e-4eda-a64c-81ec74ec28f7"
		file="error-handler-v2.xml" />
	<import doc:name="ETB Common Lib"
		doc:id="2c7d1e20-ef75-4da1-b910-a39402fe7f3b"
		file="etb-common-lib.xml" />
	<import doc:name="Logging"
		doc:id="0f7d24fc-fb80-480f-8b28-6b1e040efde2" file="loggin.xml" />
	<import doc:name="Audits SAPI Client"
		doc:id="de2027cd-7dfd-4f85-b852-00e7a5a317b4"
		file="audits-sapi-client.xml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="bf34c7cf-cb8f-48a3-a9c8-0b92f000f2bf"
		file="properties/${env}-properties.yaml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="e9153bf0-750b-4c6b-8006-ca0fb0f880e1"
		file="properties/common-properties.yaml" />
	<secure-properties:config
		name="Secure_Properties_Config" doc:name="Secure Properties"
		doc:id="d46ae86e-dbf1-499a-94db-555cd1e2d998"
		file="secureProperties/${env}-secure-properties.yaml"
		key="${secure.key}">
		<secure-properties:encrypt
			algorithm="Blowfish" />
	</secure-properties:config>
	<api-gateway:autodiscovery apiId="${api.id}"
		ignoreBasePath="true" doc:name="API Autodiscovery"
		doc:id="b9096cc1-3a0e-4243-b1a3-77e69441d9fb"
		flowRef="common-papi-services-main" />
	<http:request-config name="HTTP_Request_configuration_wbd" doc:name="HTTP Request configuration" doc:id="0119aa86-f3d2-40ab-82b8-07eb56d326eb" basePath="${wbd-sapi.basePath}" responseTimeout="${wbdSapi.responseTimeout}">
		<http:request-connection protocol="${wbd-sapi.protocol}" host="${wbd-sapi.host}" port="${wbd-sapi.port}" connectionIdleTimeout="${wbdSapi.connectionIdleTimeout}">
			<reconnection >
				<reconnect frequency="${wbdSapi.reconnection.frequency}" count="${wbdSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
</mule>
