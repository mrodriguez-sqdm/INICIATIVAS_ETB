<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<http:listener-config
		name="common-papi-services-v2-httpListenerConfig">
		<http:listener-connection
			host="${http.private.host}" port="${http.private.port}"
			readTimeout="${http.private.readTimeout}" />
	</http:listener-config>
	<apikit:config name="common-papi-services-config"
		api="common-papi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<http:request-config
		name="HTTP_Mongo_SAPI_Request_Config"
		doc:name="HTTP Oracle Request Config"
		doc:id="1ad8b32d-0c43-48bd-9763-b461e7b7ece0"
		basePath="${mongoDbSapi.basePath}"
		responseTimeout="${mongoDbSapi.responseTimeout}">
		<http:request-connection
			protocol="${mongoDbSapi.protocol}" host="${mongoDbSapi.host}"
			port="${mongoDbSapi.port}"
			connectionIdleTimeout="${mongoDbSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${siliceSapi.reconnection.frequency}"
					count="${siliceSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_azure_sapi"
		doc:name="HTTP Request configuration"
		doc:id="a1b2c3d4-5678-90ab-cdef-111111111111"
		basePath="${azureSapi.basePath}"
		responseTimeout="${azureSapi.responseTimeout}">
		<http:request-connection
			protocol="${azureSapi.protocol}" host="${azureSapi.host}"
			port="${azureSapi.port}"
			connectionIdleTimeout="${azureSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect frequency="${azureSapi.reconnection.frequency}"
					count="${azureSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_portability_documents_sapi"
		doc:name="HTTP Request configuration"
		doc:id="b2c3d4e5-6789-01ab-cdef-222222222222"
		basePath="${portabilityDocumentsSapi.basepath}"
		responseTimeout="${portabilityDocumentsSapi.responseTimeout}">
		<http:request-connection
			protocol="${portabilityDocumentsSapi.protocol}"
			host="${portabilityDocumentsSapi.host}"
			port="${portabilityDocumentsSapi.port}"
			connectionIdleTimeout="${portabilityDocumentsSapi.connectionIdleTimeout}">
			<reconnection>
				<reconnect
					frequency="${portabilityDocumentsSapi.reconnection.frequency}"
					count="${portabilityDocumentsSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Silice_SAPI_Request_Config"
		doc:name="HTTP Silice Request Config"
		basePath="${siliceSapi.basePath}">
		<http:request-connection
			host="${siliceSapi.host}"
			connectionIdleTimeout="${siliceSapi.connectionIdleTimeout}"
			protocol="${siliceSapi.protocol}" port="${siliceSapi.port}">
			<reconnection>
				<reconnect
					frequency="${siliceSapi.reconnection.frequency}"
					count="${siliceSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_Oracle_SAPI_Request_Config"
		doc:name="HTTP Oracle Request Config"
		basePath="${oracleSapi.basePath}">
		<http:request-connection
			host="${oracleSapi.host}"
			connectionIdleTimeout="${oracleSapi.connectionIdleTimeout}"
			protocol="${oracleSapi.protocol}" port="${oracleSapi.port}">
			<reconnection>
				<reconnect
					frequency="${oracleSapi.reconnection.frequency}"
					count="${oracleSapi.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<import doc:name="Error Handler v2"
		doc:id="76bc9346-0d38-405d-a11d-672b4a9e2280"
		file="error-handler-v2.xml" />
	<import doc:name="ETB Common Lib"
		doc:id="caa1a64f-8dc0-49c6-9204-964966ccd48d"
		file="etb-common-lib.xml" />
	<import doc:name="Logging"
		doc:id="1343e19d-3927-4f38-8080-4b03c3c69b46" file="loggin.xml" />
	<import doc:name="Audits SAPI Client"
		doc:id="d4f521e6-1b32-4159-b65d-dfc1295d1b44"
		file="audits-sapi-client.xml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="56a45ccb-81c9-4463-90a0-3534099fee83"
		file="properties/${env}-properties.yaml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="ac621877-efe7-4099-8747-e171ffc6ba9c"
		file="properties/common-properties.yaml" />
	<secure-properties:config
		name="Secure_Properties_Config" doc:name="Secure Properties"
		doc:id="2a8d2968-ebd1-4dbe-be7b-a53033f056fc"
		file="secureProperties/${env}-secure-properties.yaml"
		key="${secure.key}">
		<secure-properties:encrypt
			algorithm="Blowfish" />
	</secure-properties:config>
	<api-gateway:autodiscovery apiId="${api.id}"
		ignoreBasePath="true" doc:name="API Autodiscovery"
		doc:id="965e6c20-858f-4f3b-8808-11f442bcca3d"
		flowRef="common-papi-services-main" />
	<ee:object-store-caching-strategy
		name="campaigns-cache-strategy" doc:name="Caching Strategy"
		doc:id="8b44485e-0072-409c-a7c6-fe005c9ea91f"
		keyGenerationExpression="#['campaigns-data']"
		objectStore="campaigns-object-store">
	</ee:object-store-caching-strategy>
	<os:object-store name="campaigns-object-store"
		doc:name="Object store" doc:id="543b56be-1191-473a-b97f-202cff75fc83"
		entryTtl="24" entryTtlUnit="HOURS" expirationIntervalUnit="HOURS" />
</mule>
