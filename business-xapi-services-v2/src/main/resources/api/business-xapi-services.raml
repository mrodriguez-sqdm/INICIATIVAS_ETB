#%RAML 1.0
title: Business Experience API Services
version: v2
baseUri: https://business-xapi-services-v2-{env}.us-e2.cloudhub.io/{version}
protocols:
  - HTTPS

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

annotationTypes:
  operationId: string

types:
  BillingProcessBase:               !include datatypes/request/billing-process-base.raml
  BillingSaleRequest:               !include datatypes/request/processes/post-sale.raml
  BillingPlanChangeRequest:         !include datatypes/request/processes/patch-plan-change.raml
  BillingSvaRequest:                !include datatypes/request/processes/patch-sva.raml
  BillingSuspensionRequest:         !include datatypes/request/processes/patch-suspension.raml
  BillingRestorationRequest:        !include datatypes/request/processes/patch-restoration.raml
  BillingNumberChangeRequest:       !include datatypes/request/processes/patch-number-change.raml
  BillingVolCancRequest:            !include datatypes/request/processes/patch-voluntary-cancellation.raml
  BillingAddChargeRequest:          !include datatypes/request/processes/patch-add-charge.raml
  BillingServiceAddRequest:         !include datatypes/request/processes/post-service-addition.raml
  BillingServiceRemRequest:         !include datatypes/request/processes/patch-service-removal.raml
  BillingStratumChangeRequest:      !include datatypes/request/processes/patch-stratum-change.raml
  BillingOwnershipTransferRequest:  !include datatypes/request/processes/patch-ownership-transfer.raml
  BillingCycleChangeRequest:        !include datatypes/request/processes/patch-billing-cycle-change.raml
  BillingCustomerUpdateRequest:     !include datatypes/request/processes/patch-customer-update.raml
  BillingAccountUpdateRequest:      !include datatypes/request/processes/patch-account-update.raml
  BillingAddressChangeRequest:      !include datatypes/request/processes/patch-address-change.raml


/partyInteraction:
  post:
    is: 
    - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Register Customer Interaction
    description: Creates a new customer interaction to record actions or intentions from the customer, such as cancellations, term acceptance, or retention cases.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: "Parameter that allows the origin of the request to be identified"
    body:
      application/json:
        type: !include /datatypes/request/interaction.raml
        example: !include /examples/request/interaction.json
    responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/create-interaction.raml
        400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
  patch:
      is: 
      - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Update Customer Interaction
      description: Updates the status or outcome of an existing customer interaction.
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
      body:
        application/json:
          type: !include /datatypes/request/interaction.raml
          example: !include /examples/request/interaction.json
      responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/update-interaction.raml
          400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/billingAccount:
  get:
    is: 
    - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Retrieve Billing Account
    description: Retrieves billing account details such as cycle, due date, and financial status. 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        BILLING_ACCOUNT:
          type: string
          example: "12552454"
          description: Billing account
          required: false
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
        OFFSET:
          type: string
          description: "used to organize information and establish a logical order"
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-billingAccount.raml
                example: !include /examples/response/get-billingAccount.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json

/agreement:
  get:
    is: 
    - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Retrieve Agreement Information
    description: Retrieves contract details including start date, end date, and minimum commitment clause. 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        INTERACTION_ID:
          type: string
          example: "12552454"
          description: "Number Interaction"
          required: false
        PARENT_ACCOUNT:
          type: string
          example: "9876543210"
          description: "Parent account number associated with the customer"
          required: false
        ACTIVE_DATE:
          type: string
          example: "2025-10-22T00:00:00Z"
          description: "Date used to filter active records as of the specified timestamp (ISO 8601 format)"
          required: false
        FILTERS:
          type: string
          example: ""
          description: "String used to apply filters such as start date, end date, penalty value, and clause duration. Follow the example: separate the filter name and its value with a colon, and multiple filters with a semicolon."
          required: false
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
        OFFSET:
          type: string
          description: "used to organize information and establish a logical order"
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-agreement.raml
                example: !include /examples/response/get-agreement.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/party:
  get:
    is: 
    - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: verification of field crews
    description: verification of field crews
    queryParameters:
        LONGITUDE:
          type: number
          format: double
          example: 45.621
          description: "Number Interaction"
          required: true
        LATITUDE:
          type: number
          format: double
          example: 545.25
          description: "Parent account number associated with the customer"
          required: true
        RADIUS:
          type: number
          example: 10
          description: "meters around"
          required: true
        LIMIT:
          type: number
          description: "Limit on orders to display"
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-party.raml
                example: !include /examples/response/get-party.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
  /{id}:
    get:
      is: 
       - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: secure employee validation
      description: secure employee validation
      responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/get-employee.raml
                  example: !include /examples/response/get-employee.json
            400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
            401:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-401.json
            404:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-404.json
            500:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json
/billing-process:
  post:
    (operationId): create-BillingProcess
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Create Billing Resource
    description: |
      Creates a new resource in ZSmart.
      Accepted processCodes:
        - SALE             → serviceEventId=1. Creates customer, account and service in one call.
        - SERVICE_ADDITION → serviceEventId=1. Adds a service to an existing customer/account.
    body:
      application/json:
        type: !include datatypes/request/billing-process-request.raml
        examples:
          SALE:             !include examples/request/post-sale.json
          SERVICE_ADDITION: !include examples/request/post-service-addition.json
    responses:
      201:
        description: Resource created successfully.
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            examples:
              SALE:             !include examples/response/post-sale.json
              SERVICE_ADDITION: !include examples/response/post-service-addition.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      409:
        description: Duplicate request — transaction.id already processed within 24h.
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            example: !include examples/response/post-sale.json
      422:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-422.json
      503:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-503.json
      504:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-504.json

  patch:
    (operationId): update-BillingProcess
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Update Billing Resource
    description: |
      Modifies or terminates an existing resource in ZSmart.
      Accepted processCodes:
        - PLAN_CHANGE            → serviceEventId=329
        - SVA                    → serviceEventId=189
        - SUSPENSION             → serviceEventId=28
        - RESTORATION            → serviceEventId=29
        - NUMBER_CHANGE          → serviceEventId=32
        - VOLUNTARY_CANCELLATION → serviceEventId=46
        - ADD_CHARGE             → serviceEventId=804 (also covers Retoma de Equipos)
        - STRATUM_CHANGE         → serviceEventId=50
        - OWNERSHIP_TRANSFER     → serviceEventId=67
        - SERVICE_REMOVAL        → serviceEventId=46
        - BILLING_CYCLE_CHANGE   → serviceEventId=234 (postpaid accounts only)
        - CUSTOMER_UPDATE        → serviceEventId=802
        - ACCOUNT_UPDATE         → serviceEventId=803
        - ADDRESS_CHANGE         → serviceEventId=805
    body:
      application/json:
        type: !include datatypes/request/billing-process-request.raml
        examples:
          PLAN_CHANGE:            !include examples/request/patch-plan-change.json
          SVA:                    !include examples/request/patch-sva.json
          SUSPENSION:             !include examples/request/patch-suspension.json
          RESTORATION:            !include examples/request/patch-restoration.json
          NUMBER_CHANGE:          !include examples/request/patch-number-change.json
          VOLUNTARY_CANCELLATION: !include examples/request/patch-voluntary-cancellation.json
          ADD_CHARGE:             !include examples/request/patch-add-charge.json
          SERVICE_REMOVAL:        !include examples/request/patch-service-removal.json
          STRATUM_CHANGE:         !include examples/request/patch-stratum-change.json
          OWNERSHIP_TRANSFER:     !include examples/request/patch-ownership-transfer.json
          BILLING_CYCLE_CHANGE:   !include examples/request/patch-billing-cycle-change.json
          CUSTOMER_UPDATE:        !include examples/request/patch-customer-update.json
          ACCOUNT_UPDATE:         !include examples/request/patch-account-update.json
          ADDRESS_CHANGE:         !include examples/request/patch-address-change.json
    responses:
      200:
        description: Resource modified successfully.
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            examples:
              PLAN_CHANGE:            !include examples/response/patch-plan-change.json
              SVA:                    !include examples/response/patch-sva.json
              SUSPENSION:             !include examples/response/patch-suspension.json
              RESTORATION:            !include examples/response/patch-restoration.json
              NUMBER_CHANGE:          !include examples/response/patch-number-change.json
              VOLUNTARY_CANCELLATION: !include examples/response/patch-voluntary-cancellation.json
              ADD_CHARGE:             !include examples/response/patch-add-charge.json
              SERVICE_REMOVAL:        !include examples/response/patch-service-removal.json
              STRATUM_CHANGE:         !include examples/response/patch-stratum-change.json
              OWNERSHIP_TRANSFER:     !include examples/response/patch-ownership-transfer.json
              BILLING_CYCLE_CHANGE:   !include examples/response/patch-billing-cycle-change.json
              CUSTOMER_UPDATE:        !include examples/response/patch-customer-update.json
              ACCOUNT_UPDATE:         !include examples/response/patch-account-update.json
              ADDRESS_CHANGE:         !include examples/response/patch-address-change.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      409:
        description: Duplicate request — transaction.id already processed within 24h.
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            example: !include examples/response/patch-plan-change.json
      422:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-422.json
      503:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-503.json
      504:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-504.json