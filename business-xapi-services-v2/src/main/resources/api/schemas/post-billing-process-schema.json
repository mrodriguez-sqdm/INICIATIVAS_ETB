{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BillingProcessRequest",
  "type": "object",
  "required": [
    "processCode",
    "transaction"
  ],
  "if": {
    "properties": {
      "processCode": {
        "const": "SALE"
      }
    }
  },
  "then": {
    "$ref": "#/definitions/Sale"
  },
  "else": {
    "if": {
      "properties": {
        "processCode": {
          "const": "NEW_CUSTOMER"
        }
      }
    },
    "then": {
      "$ref": "#/definitions/NewCustomer"
    },
    "else": {
      "$ref": "#/definitions/NewAccount"
    }
  },
  "definitions": {
    "AttributeItem": {
      "type": "object",
      "required": [
        "attrCode",
        "value"
      ],
      "properties": {
        "attrCode": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19
        }
      }
    },
    "ContactItem": {
      "type": "object",
      "required": [
        "contactType"
      ],
      "properties": {
        "contactType": {
          "type": "string"
        },
        "firstName": {
          "type": "string",
          "maxLength": 255
        },
        "lastName": {
          "type": "string",
          "maxLength": 255
        },
        "email": {
          "type": "string",
          "maxLength": 60
        },
        "mobilePhone": {
          "type": "string",
          "maxLength": 20
        },
        "contactDocType": {
          "type": "string",
          "enum": [
            "CC",
            "CE",
            "NIT",
            "PEP",
            "PPT"
          ]
        },
        "contactDocNo": {
          "type": "string",
          "maxLength": 15
        },
        "contactDocExpDate": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "maxLength": 15
        },
        "department": {
          "type": "string",
          "maxLength": 15
        },
        "city": {
          "type": "string",
          "maxLength": 15
        },
        "district": {
          "type": "string",
          "maxLength": 15
        },
        "addressName": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "Transaction": {
      "type": "object",
      "required": [
        "id",
        "timestamp",
        "orderItemId",
        "salesChannel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "timestamp": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19
        },
        "orderItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22
        },
        "prodInstId": {
          "type": "integer",
          "maximum": 999999999999999
        },
        "salesChannel": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            5,
            7,
            106
          ]
        },
        "salesDepartment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "salesCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "custId": {
          "type": "integer",
          "maximum": 999999999999999
        },
        "acctId": {
          "type": "integer",
          "maximum": 999999999999999
        },
        "po": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "billType": {
          "type": "string",
          "enum": [
            "1",
            "2"
          ]
        },
        "comments": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "Customer": {
      "type": "object",
      "required": [
        "typeFlag",
        "contactPhone",
        "email",
        "country",
        "departament",
        "city",
        "customerSegment",
        "subSegmento",
        "categoria",
        "habeasData"
      ],
      "properties": {
        "typeFlag": {
          "type": "string",
          "enum": [
            "1",
            "2"
          ]
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "middleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "secondLastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "custName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "nombreJuridico": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "docType": {
          "type": "string",
          "enum": [
            "CC",
            "CE",
            "NIT",
            "PEP",
            "PPT"
          ]
        },
        "docNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "issueLugar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "issueDate": {
          "type": "string"
        },
        "docExpDate": {
          "type": "string"
        },
        "birthday": {
          "type": "string"
        },
        "gender": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "occupation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "industry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contactPhone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "departament": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "customerSegment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "subSegmento": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "categoria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "habeasData": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "autoretentionFlag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "vipFlag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "paymentRiskLevel": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ]
        },
        "blockNotification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContactItem"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeItem"
          }
        }
      }
    },
    "Account": {
      "type": "object",
      "required": [
        "billFlag",
        "country",
        "departament",
        "city"
      ],
      "properties": {
        "acctName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "billDeliveryType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "paymentMode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "corte": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "parentAcctId": {
          "type": "integer"
        },
        "billFlag": {
          "type": "string",
          "enum": [
            "Yes",
            "No"
          ]
        },
        "taxExempt": {
          "type": "string",
          "enum": [
            "Yes",
            "No"
          ]
        },
        "dunningExemption": {
          "type": "string",
          "enum": [
            "No",
            "Temporary",
            "Total"
          ]
        },
        "dunningExemEff": {
          "type": "string"
        },
        "dunningExemExp": {
          "type": "string"
        },
        "contractName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "roundingAdjustmentFlag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "previousBalanceFlag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "coverPageOnlyFlag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "interestChargeFlag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "interestRateType": {
          "type": "string",
          "enum": [
            "1",
            "2"
          ]
        },
        "dunningManagementTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "departament": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "paymentTerm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContactItem"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeItem"
          }
        }
      }
    },
    "OfferItem": {
      "type": "object",
      "required": [
        "offerCode",
        "effectiveDate"
      ],
      "properties": {
        "offerInstanceId": {
          "type": "integer"
        },
        "offerCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "effectiveDate": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19
        },
        "expirationDate": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeItem"
          }
        }
      }
    },
    "ChargeItem": {
      "type": "object",
      "required": [
        "type",
        "basicCharge",
        "acctItemTypeCode",
        "paidFlag",
        "billingNbr"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "1",
            "2"
          ]
        },
        "basicCharge": {
          "type": "string"
        },
        "acctItemTypeCode": {
          "type": "string"
        },
        "paidFlag": {
          "type": "string",
          "enum": [
            "Y",
            "N"
          ]
        },
        "billingNbr": {
          "type": "string"
        },
        "currencyId": {
          "type": "string"
        },
        "installmentPlanId": {
          "type": "integer",
          "maximum": 999999999999
        },
        "acctId": {
          "type": "integer",
          "maximum": 999999999999999
        }
      }
    },
    "ServiceItem": {
      "type": "object",
      "required": [
        "areaCode",
        "serviceNumber",
        "effectiveDate",
        "offerCode",
        "offers"
      ],
      "properties": {
        "prodInstId": {
          "type": "integer",
          "maximum": 999999999999999
        },
        "areaCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "serviceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "effectiveDate": {
          "type": "string",
          "minLength": 19,
          "maxLength": 19
        },
        "offerCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "socialLevel": {
          "type": "string",
          "enum": [
            "",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6"
          ]
        },
        "bundleIdCRM": {
          "type": "string",
          "minLength": 1,
          "maxLength": 9
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "originalDepartment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "originalCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "originalAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "destDepartment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "destCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "destAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContactItem"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeItem"
          }
        },
        "offers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/OfferItem"
          }
        },
        "charges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ChargeItem"
          }
        }
      }
    },
    "Sale": {
      "properties": {
        "processCode": {
          "type": "string",
          "enum": [
            "SALE"
          ]
        },
        "transaction": {
          "$ref": "#/definitions/Transaction"
        },
        "customer": {
          "$ref": "#/definitions/Customer"
        },
        "account": {
          "$ref": "#/definitions/Account"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ServiceItem"
          }
        }
      },
      "required": [
        "processCode",
        "transaction",
        "services"
      ]
    },
    "NewCustomer": {
      "properties": {
        "processCode": {
          "type": "string",
          "enum": [
            "NEW_CUSTOMER"
          ]
        },
        "transaction": {
          "$ref": "#/definitions/Transaction"
        },
        "customer": {
          "$ref": "#/definitions/Customer"
        }
      },
      "required": [
        "processCode",
        "transaction",
        "customer"
      ]
    },
    "NewAccount": {
      "properties": {
        "processCode": {
          "type": "string",
          "enum": [
            "NEW_ACCOUNT"
          ]
        },
        "transaction": {
          "allOf": [
            {
              "$ref": "#/definitions/Transaction"
            },
            {
              "required": [
                "custId"
              ]
            }
          ]
        },
        "account": {
          "$ref": "#/definitions/Account"
        }
      },
      "required": [
        "processCode",
        "transaction",
        "account"
      ]
    }
  }
}