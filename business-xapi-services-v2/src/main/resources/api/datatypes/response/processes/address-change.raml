#%RAML 1.0 DataType
type: !include ../billing-process-response-base.raml
discriminatorValue: ADDRESS_CHANGE
properties:
  transactionId:
    type: string
    example: TRX20260319016789
    required: false
  processCode:
    type: string
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  updatedAt:
    type: string
    example: '2026-03-19T10:00:01Z'
    required: false
  result:
    type: object
    required: false
    properties:
      customerId:
        type: string
        example: '12345678'
        required: false
      serviceId:
        type: string
        example: '98765'
        required: false
      department:
        type: string
        description: "DANE department code of new address"
        example: '11'
        required: false
      city:
        type: string
        description: "DANE city code of new address"
        example: '11001'
        required: false
      address:
        type: string
        example: 'Cra 100 # 15-30'
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false
