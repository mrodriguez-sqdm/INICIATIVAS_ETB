#%RAML 1.0 DataType
type: !include ../billing-process-response-base.raml
discriminatorValue: SERVICE_ADDITION
properties:
  transactionId:
    type: string
    example: f6a7b8c9-d0e1-2345-fabc-345678901234
    required: false
  processCode:
    type: string
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  createdAt:
    type: string
    example: '2026-03-19T10:00:01Z'
    required: false
  result:
    type: object
    required: false
    properties:
      customerId:
        type: string
        example: '12345678'
        required: false
      accountId:
        type: string
        example: '14000001234'
        required: false
      serviceId:
        type: string
        example: '98766'
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false