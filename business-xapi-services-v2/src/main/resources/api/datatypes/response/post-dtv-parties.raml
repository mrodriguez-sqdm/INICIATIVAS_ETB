#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Subscriber created successfully
    required: false
  data:
    type: object
    properties:
      CustomerId:
        type: string
        example: '1111111'
        required: false
      ControlSeguridad:
        type: string
        example: 12334xxxxx23244
        required: false
