#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SALE
description: |
  New Connection. ZSmart: serviceEventId=1 (New Connection).
  Single atomic call — creates customer, account and service in one ZSmart transaction (v0.8).
  billing-papi resolves: serviceEventId=1, operate=A, chargeType mapping, currencyId=1.
  cust and account nodes are included only when customer/account are new in ZSmart.
  Fields eliminated in v0.8: statusCd, paymentModeCd, ownerCustId, prodCode, prodInstAcctRelList, isNewConnection, billingCycleId.
properties:
  processCode:
    type: string
    enum: [SALE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319001234
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319001234-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        description: "DANE department code of sales agent. Used for tax calculation. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        description: "DANE city code of sales agent. Used for tax calculation. -> header.salesCity"
        example: '11001'
        required: false
  customer:
    type: object
    required: true
    description: "New customer data. Omit if customer already exists in ZSmart — send transaction.customerId instead. -> cust node (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM customer ID. -> cust.custId"
        example: '12345678'
        required: true
      typeFlag:
        type: string
        enum: ['1', '2']
        description: "1=Personal, 2=Business. -> cust.typeFlag"
        example: '1'
        required: true
      firstName:
        type: string
        description: "First name (individual). -> cust.firstName"
        example: Juan
        required: false
      lastName:
        type: string
        description: "Last name (individual). -> cust.lastName"
        example: Perez
        required: false
      middleName:
        type: string
        description: "Middle name. -> cust.middleName"
        example: Carlos
        required: false
      secondLastName:
        type: string
        description: "Second last name. -> cust.secondLastName"
        example: Gomez
        required: false
      custName:
        type: string
        description: "Business name (B2B only). -> cust.custName"
        example: Empresa SAS
        required: false
      nombreJuridico:
        type: string
        description: "Legal registered name (B2B). -> cust.nombreJuridico"
        example: Empresa S.A.S.
        required: false
      docType:
        type: string
        description: "Document type. Mandatory for new customer. -> cust.docType"
        example: CC
        required: false
      docNumber:
        type: string
        description: "Document number. Mandatory for new customer. -> cust.docNumber"
        example: '1023456789'
        required: false
      birthday:
        type: string
        description: "Birth date yyyy-mm-dd. -> cust.birthday"
        example: '1990-05-15'
        required: false
      gender:
        type: string
        description: "Male|Female|Company. -> cust.gender"
        example: Male
        required: false
      contactPhone:
        type: string
        description: "Primary mobile phone. -> cust.contactPhone"
        example: '3001234567'
        required: true
      email:
        type: string
        description: "Primary email. -> cust.email"
        example: juan.perez@email.com
        required: true
      country:
        type: string
        description: "Country of residential address. -> cust.country"
        example: Colombia
        required: true
      departament:
        type: string
        description: "DANE department code. -> cust.departament"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code. -> cust.city"
        example: '11001'
        required: true
      district:
        type: string
        description: "Locality/Commune. -> cust.district"
        example: Chapinero
        required: false
      address:
        type: string
        description: "Registered address. -> cust.address"
        example: Cra 7 # 32-16
        required: false
      customerSegment:
        type: string
        description: "Customer segment. -> cust.customerSegment"
        example: RESIDENCIAL
        required: true
      subSegmento:
        type: string
        description: "Customer subsegment. -> cust.subSegmento"
        example: MASS
        required: true
      categoria:
        type: string
        description: "Gold|Silver|Bronze|Platinum. -> cust.categoria"
        example: Bronze
        required: true
      habeasData:
        type: string
        description: "Data treatment consent Yes/No. -> cust.habeasData"
        example: 'Yes'
        required: true
  account:
    type: object
    required: true
    description: "New billing account. Omit if account already exists in ZSmart. -> account node (operate=A)"
    properties:
      billDeliveryType:
        type: string
        description: "B=Email, A=Post, W=WhatsApp, S=SMS. Default B. -> account.billDeliveryType"
        example: 'B'
        required: false
      corte:
        type: string
        description: "Billing cut day (1-28). Mandatory for postpaid. -> account.corte"
        example: '15'
        required: false
      billFlag:
        type: string
        description: "Payment responsible: Yes/No. -> account.billFlag"
        example: 'Yes'
        required: true
      country:
        type: string
        description: "Country. -> account.country"
        example: Colombia
        required: true
      departament:
        type: string
        description: "DANE department code. -> account.departament"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code. -> account.city"
        example: '11001'
        required: true
      taxExempt:
        type: string
        description: "Tax exempt: Yes/No. -> account.taxExempt"
        example: 'No'
        required: false
      paymentTerm:
        type: string
        description: "Payment period days. Default 0. -> account.paymentTerm"
        example: '0'
        required: false
  service:
    type: object
    required: true
    description: "Service instance to create. -> billProdInstList[0].billProdInst (operate=A) + billOfferInstList (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM product instance ID. -> billProdInst.prodInstId / header.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Service effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
      offerCode:
        type: string
        description: "Main offer code. -> billProdInst.offerCode + billOfferInst.offerCode"
        example: PLAN_PSTN_100
        required: true
      offerInstanceId:
        type: integer
        description: "CRM offer instance ID (Number in v0.8). -> billOfferInst.offerInstId"
        example: 20260001
        required: true
      department:
        type: string
        description: "DANE department where service is installed. -> billProdInst.Department"
        example: '11'
        required: false
      city:
        type: string
        description: "DANE city where service is installed. -> billProdInst.City"
        example: '11001'
        required: false
      address:
        type: string
        description: "Address where service is installed. -> billProdInst.Address"
        example: Cra 7 # 32-16
        required: false
      charges:
        type: array
        required: false
        minItems: 1
        description: "One-off or advance charges. -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> charge.chargeType"
              example: ONE_OFF
              required: true
            amount:
              type: string
              description: "Charge amount in PESO. -> charge.basicCharge"
              example: '15000'
              required: true
            itemTypeCode:
              type: string
              description: "Account item type code configured in ZSmart. -> charge.acctItemTypeCode"
              example: CONN_FEE
              required: true
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
              example: 'N'
              required: true
