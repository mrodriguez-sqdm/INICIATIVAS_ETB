#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: NEW_ACCOUNT
description: |
  Create a new billing account for an existing customer in ZSmart (serviceEventId=807).
  Use when a customer already has a ZSmart custId but needs a new billing account,
  for example a second account for a new product line or corporate hierarchy.
  billing-papi resolves: serviceEventId=807, account.operate=A.
  Nodes: transaction->header, account->account, acctAttributes[]->acctAttrList.
properties:
  processCode:
    type: string
    enum: [NEW_ACCOUNT]
    required: true

  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319001234
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319001234-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      custId:
        type: integer
        description: "ZSmart customer ID. Mandatory — account must be linked to an existing customer. -> header.custId"
        example: 12345678
        required: true
      comments:
        type: string
        description: "Order comments. -> header.comments"
        example: 'New account for corporate services'
        required: false

  account:
    type: object
    required: true
    description: "New billing account. -> account node (operate=A)"
    properties:
      acctName:
        type: string
        description: "Billing account name. ZSmart generates if not sent (customer_name+3-digit seq). -> account.acctName"
        example: 'Juan Perez 002'
        required: false
      billDeliveryType:
        type: string
        description: "B=Email, A=Post, W=WhatsApp, S=SMS. Comma-separated for multiple. Default B. Mandatory for postpaid. -> account.billDeliveryType"
        example: 'B'
        required: false
      paymentMode:
        type: string
        description: "Pre-paid or Post-paid. Defined by ZSmart per offer config. Default postpaid. -> account.paymentMode"
        example: 'Post-paid'
        required: false
      corte:
        type: string
        description: "Billing cut day (1-28). Mandatory for postpaid new account. -> account.corte"
        example: '15'
        required: false
      parentAcctId:
        type: integer
        description: "Parent account ID for hierarchy. Not applied for prepaid. -> account.parentAcctId"
        example: 14000000001
        required: false
      billFlag:
        type: string
        description: "Payment responsible: Yes/No. Not applied for prepaid. -> account.billFlag"
        example: 'Yes'
        required: true
      taxExempt:
        type: string
        description: "Tax exempt: Yes/No. -> account.taxExempt"
        example: 'No'
        required: false
      dunningExemption:
        type: string
        description: "Dunning exemption: No/Temporary/Total. Not applied for prepaid. -> account.dunningExemption"
        example: 'No'
        required: false
      dunningExemEff:
        type: string
        description: "Dunning exemption start YYYY-MM-DD HHMMSS. Only when dunningExemption=Temporary. -> account.dunningExemEff"
        example: '2026-03-19 000000'
        required: false
      dunningExemExp:
        type: string
        description: "Dunning exemption end YYYY-MM-DD HHMMSS. Only when dunningExemption=Temporary. -> account.dunningExemExp"
        example: '2026-06-19 000000'
        required: false
      contractName:
        type: string
        description: "Contract name. One contract per account. -> account.contractName"
        example: PLATINUM_ANNUAL_CONTRACT
        required: false
      roundingAdjustmentFlag:
        type: string
        description: "Apply rounding to nearest ten: Yes/No. Not applied for prepaid. -> account.roundingAdjustmentFlag"
        example: 'No'
        required: false
      previousBalanceFlag:
        type: string
        description: "Show previous balance on invoice: Yes/No. Not applied for prepaid. -> account.previousBalanceFlag"
        example: 'Yes'
        required: false
      coverPageOnlyFlag:
        type: string
        description: "Invoice cover page only: Yes/No. -> account.coverPageOnlyFlag"
        example: 'No'
        required: false
      interestChargeFlag:
        type: string
        description: "Charge late payment interest: Yes/No. Not applied for prepaid. -> account.interestChargeFlag"
        example: 'No'
        required: false
      interestRateType:
        type: string
        description: "1=Interbank, 2=Subsidiary. Required if interestChargeFlag=Yes. Not applied for prepaid. -> account.interestRateType"
        example: '1'
        required: false
      dunningManagementTime:
        type: string
        description: "Collections start from 1st/2nd/3rd overdue invoice. Not applied for prepaid. -> account.dunningManagementTime"
        example: '1'
        required: false
      country:
        type: string
        description: "Country. -> account.country"
        example: Colombia
        required: true
      departament:
        type: string
        description: "DANE department code. -> account.departament"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code. -> account.city"
        example: '11001'
        required: true
      district:
        type: string
        description: "Locality/Commune. -> account.district"
        example: Chapinero
        required: false
      address:
        type: string
        description: "Registered address. -> account.address"
        example: Cra 7 # 32-16
        required: false
      paymentTerm:
        type: string
        description: "Payment period days. Default 0. Not applied for prepaid. -> account.paymentTerm"
        example: '0'
        required: false
      contactList:
        type: array
        required: false
        description: "Account contacts. Not applied for prepaid. (505=Bill Delivery, 506=Cobranza, 507=Commercial Register, 508=Administrator, 509=Collection Notification). -> account.contactDtoList"
        items:
          type: object
          properties:
            contactType:
              type: string
              description: "505=Bill Delivery, 506=Cobranza, 507=Commercial Register, 508=Administrator, 509=Collection Notification. -> contactDto.contactType"
              example: '505'
              required: true
            firstName:
              type: string
              description: "-> contactDto.firstName"
              example: Juan
              required: true
            lastName:
              type: string
              description: "-> contactDto.lastName"
              example: Perez
              required: true
            email:
              type: string
              description: "-> contactDto.email"
              example: juan.perez@email.com
              required: true
            mobilePhone:
              type: string
              description: "-> contactDto.mobilePhone"
              example: '3001234567'
              required: true
            contactDocType:
              type: string
              description: "CC, CE, NIT, PEP, PPT. -> contactDto.contactDocType"
              example: CC
              required: true
            contactDocNo:
              type: string
              description: "-> contactDto.contactDocNo"
              example: '1023456789'
              required: true
            contactDocExpDate:
              type: string
              description: "Document expiry date YYYY-MM-DD. -> contactDto.contactDocExpDate"
              example: '2030-12-31'
              required: false
            country:
              type: string
              description: "Only Colombia accepted. -> contactDto.country"
              example: Colombia
              required: true
            department:
              type: string
              description: "DANE department code. -> contactDto.department"
              example: '11'
              required: true
            city:
              type: string
              description: "DANE city code. -> contactDto.city"
              example: '11001'
              required: true
            district:
              type: string
              description: "Locality/Commune. -> contactDto.district"
              example: Chapinero
              required: false
            addressName:
              type: string
              description: "Street name. -> contactDto.addressName"
              example: Cra 7 # 32-16
              required: true

  acctAttributes:
    type: array
    required: false
    description: "Extended attributes for the billing account. -> acctAttrList (operate=A)"
    items:
      type: object
      properties:
        attrCode:
          type: string
          description: "Attribute code as configured in ZSmart. -> acctAttr.attrCode"
          example: INVOICE_FORMAT
          required: true
        value:
          type: string
          description: "Attribute value. -> acctAttr.value"
          example: PDF
          required: true
        effectiveDate:
          type: string
          description: "Effective date YYYY-MM-DD HH:MM:SS. -> acctAttr.effDate"
          example: '2026-03-19 10:00:00'
          required: false
