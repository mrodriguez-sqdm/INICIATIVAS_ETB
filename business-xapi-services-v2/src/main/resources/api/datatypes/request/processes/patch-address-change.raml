#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: ADDRESS_CHANGE
description: |
  Change service installation address (Traslado). ZSmart: serviceEventId=805 (Change Installation address).
  ZSmart activates 806 (new customer) and 807 (new account) internally if required by the relocation.
  MuleSoft only sends serviceEventId=805.
  billing-papi resolves: serviceEventId=805, billProdInst(operate=M) with new address fields.
  service.department, service.city, service.address are Mandatory for the relocation.
  service.socialLevel is optional — include only if stratum changes with the relocation.
properties:
  processCode:
    type: string
    enum: [ADDRESS_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319016789
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319016789-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "Service to relocate. -> billProdInst (operate=M) with new address"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. Mandatory in v0.8. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Relocation effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate"
        example: '2026-04-01 00:00:00'
        required: true
      department:
        type: string
        description: "DANE department code of new installation address. -> billProdInst.Department"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code of new installation address. -> billProdInst.City"
        example: '11001'
        required: true
      address:
        type: string
        description: "New installation address. -> billProdInst.Address"
        example: Cra 100 # 15-30
        required: true
      socialLevel:
        type: string
        enum: ['', '1', '2', '3', '4', '5', '6']
        description: "New socioeconomic stratum if changed by relocation. -> billProdInst.socialLevel"
        example: '4'
        required: false
