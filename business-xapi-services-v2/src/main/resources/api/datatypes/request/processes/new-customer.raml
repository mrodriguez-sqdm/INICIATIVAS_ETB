#%RAML 1.0 DataType
type: object #!include ../billing-process-base.raml
#discriminatorValue: NEW_CUSTOMER
description: |
  Create a new customer in ZSmart without a service. ZSmart: serviceEventId=806 (Create customer).
  business-papi resolves: serviceEventId=806, cust(operate=A).
  Use when customer must exist in ZSmart before a SALE and does not yet have a custId.
  Nodes map: transaction->header, customer->cust,
             customer.attributes[]->custAttrList,
             customer.contacts[]->cust.contactDtoList.
properties:
  processCode:
    type: string
    enum: [NEW_CUSTOMER]
    required: true
  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: string
        pattern: ^[0-9]+$
        minLength: 1
        maxLength: 15
        description: "Unique transaction ID. -> header.transactionId"
        example: '202603190087'
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319017890-001
        required: true
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. -> header.salesCity"
        example: '11001'
        required: false
      po:
        type: string
        minLength: 1
        maxLength: 200
        description: "Purchase order number. -> header.po"
        example: 'PO-2026-00128'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 255
        description: "Order comments. -> header.comments"
        example: 'New B2C customer registration'
        required: false

  customer:
    type: object
    required: true
    description: "New customer data. -> cust (operate=A)"
    properties:
      typeFlag:
        type: string
        enum: ['1', '2']
        description: "Customer type. 1=Personal, 2=Business. -> cust.typeFlag"
        example: '1'
        required: true
      firstName:
        type: string
        minLength: 1
        maxLength: 255
        description: "First name (individual). -> cust.firstName"
        example: Juan
        required: false
      lastName:
        type: string
        minLength: 1
        maxLength: 255
        description: "Last name (individual). -> cust.lastName"
        example: Perez
        required: false
      middleName:
        type: string
        minLength: 1
        maxLength: 255
        description: "Middle name. -> cust.middleName"
        example: Carlos
        required: false
      secondLastName:
        type: string
        minLength: 1
        maxLength: 255
        description: "Second last name. -> cust.secondLastName"
        example: Gomez
        required: false
      custName:
        type: string
        minLength: 1
        maxLength: 255
        description: "Business name (B2B only). -> cust.custName"
        example: Empresa SAS
        required: false
      nombreJuridico:
        type: string
        minLength: 1
        maxLength: 255
        description: "Legal registered name (B2B). -> cust.nombreJuridico"
        example: Empresa S.A.S.
        required: false
      gender:
        type: string
        minLength: 1
        maxLength: 15
        description: "Male, Female or Company. -> cust.gender"
        example: Male
        required: false
      title:
        type: string
        minLength: 1
        maxLength: 15
        description: "Title (Mr. or Mrs.). -> cust.title"
        example: Mr.
        required: false
      birthday:
        type: string
        minLength: 10
        maxLength: 10
        description: "Birth date YYYY-MM-DD. -> cust.birthday"
        example: '1990-05-15'
        required: false
      docType:
        type: string
        enum: [CC, CE, NIT, PEP, PPT]
        description: "Document type. -> cust.docType"
        example: CC
        required: false
      docNumber:
        type: string
        minLength: 1
        maxLength: 15
        description: "Document number. -> cust.docNumber"
        example: '1023456789'
        required: false
      issueLugar:
        type: string
        minLength: 1
        maxLength: 60
        description: "Organization where the document was issued. -> cust.issueLugar"
        example: 'Registraduria Nacional'
        required: false
      issueDate:
        type: string
        minLength: 10
        maxLength: 10
        description: "Document issue date YYYY-MM-DD. -> cust.issueDate"
        example: '2010-03-15'
        required: false
      docExpDate:
        type: string
        minLength: 10
        maxLength: 10
        description: "Document expiry date YYYY-MM-DD. -> cust.docExpDate"
        example: '2035-03-15'
        required: false
      occupation:
        type: string
        minLength: 1
        maxLength: 60
        description: "Profession. -> cust.occupation"
        example: Engineer
        required: false
      industry:
        type: string
        minLength: 1
        maxLength: 60
        description: "Industry type (B2B). -> cust.industry"
        example: Technology
        required: false
      contactPhone:
        type: string
        minLength: 1
        maxLength: 20
        description: "Primary mobile phone. -> cust.contactPhone"
        example: '3001234567'
        required: true
      email:
        type: string
        minLength: 1
        maxLength: 60
        description: "Primary email. -> cust.email"
        example: juan.perez@email.com
        required: true
      country:
        type: string
        minLength: 1
        maxLength: 15
        description: "Country of residential address. -> cust.country"
        example: Colombia
        required: true
      departament:
        type: string
        minLength: 1
        maxLength: 15
        description: "DANE department code. -> cust.departament"
        example: '11'
        required: true
      city:
        type: string
        minLength: 1
        maxLength: 15
        description: "DANE city code. -> cust.city"
        example: '11001'
        required: true
      district:
        type: string
        minLength: 1
        maxLength: 15
        description: "Locality/Commune. -> cust.district"
        example: Chapinero
        required: false
      address:
        type: string
        minLength: 1
        maxLength: 200
        description: "Residential address. -> cust.address"
        example: Cra 7 # 32-16
        required: false
      customerSegment:
        type: string
        minLength: 1
        maxLength: 15
        description: "Customer segment. -> cust.customerSegment"
        example: RESIDENCIAL
        required: true
      subSegmento:
        type: string
        minLength: 1
        maxLength: 15
        description: "Customer subsegment. -> cust.subSegmento"
        example: MASS
        required: true
      categoria:
        type: string
        minLength: 1
        maxLength: 15
        description: "Gold|Silver|Bronze|Platinum. -> cust.categoria"
        example: Bronze
        required: true
      habeasData:
        type: string
        minLength: 1
        maxLength: 15
        description: "Data treatment consent Yes/No. -> cust.habeasData"
        example: 'Yes'
        required: true
      autoretentionFlag:
        type: string
        minLength: 1
        maxLength: 15
        description: "Self-withholding tax flag Yes/No. -> cust.autoretentionFlag"
        example: 'No'
        required: false
      vipFlag:
        type: string
        minLength: 1
        maxLength: 15
        description: "VIP customer flag Yes/No. -> cust.vipFlag"
        example: 'No'
        required: false
      paymentRiskLevel:
        type: string
        enum: ['1', '2', '3', '4', '5', '6']
        description: "Payment risk level. 1=Normal_High, 2=Normal_Very High, 3=Normal_High Medium, 4=Normal_Medium, 5=Normal_Low, 6=Normal_Very Low. Default 6. -> cust.paymentRiskLevel"
        example: '6'
        required: false
      blockNotification:
        type: string
        minLength: 1
        maxLength: 30
        description: "Block dunning channels. E=Email, C=Call, W=WhatsApp, S=SMS. Comma-separated. -> cust.blockNotification"
        example: 'E, C'
        required: false
      attributes:
        type: array
        required: false
        minItems: 1
        description: "Extended customer attributes. -> custAttrList"
        items: !include ../common/AttributeItem.raml
      contacts:
        type: array
        required: false
        minItems: 1
        description: "Customer contacts. contactType: 501=Commercial, 502=Legal, 503=Notification, 504=Delivery Address. -> cust.contactDtoList"
        items: !include ../common/ContactItem.raml
examples:
  NEW_CUSTOMER: !include ../../../examples/request/new-customer.json