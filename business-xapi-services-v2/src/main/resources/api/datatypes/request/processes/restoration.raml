#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: RESTORATION
description: |
  Restore suspended service. ZSmart: serviceEventId=29 (Reactivation Under Request).
  business-papi resolves: serviceEventId=29, billProdInst(operate=M), currencyId=1 default.
  Nodes map: transaction->header, service->billProdInst, service.charges[]->chargeList.
properties:
  processCode:
    type: string
    enum: [RESTORATION]
    required: true

  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: string
        minLength: 1
        maxLength: 15
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX202603190056
        required: true
      timestamp:
        type: string
        minLength: 19
        maxLength: 19
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples. business-papi must NOT strip separators before forwarding."
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        minLength: 1
        maxLength: 22
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319005678-001
        required: true
      serviceNumber:
        type: string
        minLength: 1
        maxLength: 30
        example: "98765"
        required: true
        description: "CRM subscriber instance ID for this order. Must match the prodInstId of the main service in services[]. -> header.serviceNumber" 
      custId:
        type: integer
        maximum: 999999999999999
        description: "ZSmart customer ID (max 15 digits). Identifies who requests the order. -> header.custId"
        example: 12345678
        required: false
      salesChannel:
        type: integer
        enum: [1, 2, 4, 5, 7, 106]
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      salesDepartment:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE department code of sales agent. Used for tax calculation. -> header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        minLength: 1
        maxLength: 10
        description: "DANE city code of sales agent. Used for tax calculation. -> header.salesCity"
        example: '11001'
        required: false
      po:
        type: string
        minLength: 1
        maxLength: 200
        description: "Purchase order number. -> header.po"
        example: 'PO-2026-00123'
        required: false
      billType:
        type: string
        enum: ['1', '2']
        description: "1=Monthly invoice (default), 2=Sales invoice. Only for postpaid. -> header.billType"
        example: '1'
        required: false
      comments:
        type: string
        minLength: 1
        maxLength: 200
        description: "Order comments. -> header.comments"
        example: 'Customer requested restoration'
        required: false

  services:
    type: array
    description: "Services to restore. -> billProdInstList[0] (operate=M)"  
    items:
      type: object
      properties:
        areaCode:
          type: string
          minLength: 1
          maxLength: 16
          description: "Service number area prefix. -> billProdInst.areaCode"
          example: '601'
          required: true
        serviceNumber:
          type: string
          minLength: 1
          maxLength: 24
          description: "Service number without prefix. -> billProdInst.serviceNumber"
          example: '5551234'
          required: true
        effectiveDate:
          type: string
          minLength: 19
          maxLength: 19
          description: "Restoration effective date YYYY-MM-DD HH:MM:SS. -> billProdInst.effDate. ZSmart spec defines length 14 (YYYYMMDDHHMMSS) but accepts format with separators as confirmed by real request samples."
          example: '2026-03-19 10:00:00'
          required: true
        charges:
          type: array
          required: false
          minItems: 1
          description: "Optional restoration charges. -> chargeList"
          items: !include ../common/ChargeItem.raml
examples:
  RESTORATION: !include ../../../examples/request/restoration.json