#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: NEW_CUSTOMER
description: |
  Create a new customer in ZSmart without a service (serviceEventId=806).
  Use when the customer must exist in ZSmart before a SALE or SERVICE_ADDITION is processed
  and the customer does not yet have a ZSmart custId.
  billing-papi resolves: serviceEventId=806, cust.operate=A.
  Nodes: transaction->header, customer->cust, custAttributes[]->custAttrList.
properties:
  processCode:
    type: string
    enum: [NEW_CUSTOMER]
    required: true

  transaction:
    type: object
    required: true
    description: "Transaction header. -> header"
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319001234
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS. -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319001234-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID. 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
      custId:
        type: integer
        description: "ZSmart customer ID. Optional for new customer. -> header.custId"
        example: 12345678
        required: false
      comments:
        type: string
        description: "Order comments. -> header.comments"
        example: 'New B2C customer registration'
        required: false

  customer:
    type: object
    required: true
    description: "New customer data. -> cust node (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM customer ID. -> cust.custId"
        example: '12345678'
        required: false
      typeFlag:
        type: string
        enum: ['1', '2']
        description: "1=Personal, 2=Business. -> cust.typeFlag"
        example: '1'
        required: true
      firstName:
        type: string
        description: "First name (individual). -> cust.firstName"
        example: Juan
        required: false
      lastName:
        type: string
        description: "Last name (individual). -> cust.lastName"
        example: Perez
        required: false
      middleName:
        type: string
        description: "Middle name. -> cust.middleName"
        example: Carlos
        required: false
      secondLastName:
        type: string
        description: "Second last name. -> cust.secondLastName"
        example: Gomez
        required: false
      custName:
        type: string
        description: "Business name (B2B only). -> cust.custName"
        example: Empresa SAS
        required: false
      nombreJuridico:
        type: string
        description: "Legal registered name (B2B). -> cust.nombreJuridico"
        example: Empresa S.A.S.
        required: false
      title:
        type: string
        description: "Title (M., Mrs., etc.). -> cust.title"
        example: Mr.
        required: false
      docType:
        type: string
        description: "Document type: CC, CE, NIT, PEP, PPT. Mandatory for new customer. -> cust.docType"
        example: CC
        required: false
      docNumber:
        type: string
        description: "Document number. Mandatory for new customer. -> cust.docNumber"
        example: '1023456789'
        required: false
      issueLugar:
        type: string
        description: "Organization where the document was issued. -> cust.issueLugar"
        example: 'Registraduria Nacional'
        required: false
      issueDate:
        type: string
        description: "Document issue date yyyy-mm-dd. -> cust.issueDate"
        example: '2010-03-15'
        required: false
      docExpDate:
        type: string
        description: "Document expiry date yyyy-mm-dd. -> cust.docExpDate"
        example: '2035-03-15'
        required: false
      birthday:
        type: string
        description: "Birth date yyyy-mm-dd. -> cust.birthday"
        example: '1990-05-15'
        required: false
      gender:
        type: string
        description: "Male|Female|Company. -> cust.gender"
        example: Male
        required: false
      occupation:
        type: string
        description: "Profession of the customer. -> cust.occupation"
        example: Engineer
        required: false
      industry:
        type: string
        description: "Industry type (B2B). -> cust.industry"
        example: Technology
        required: false
      contactPhone:
        type: string
        description: "Primary mobile phone. -> cust.contactPhone"
        example: '3001234567'
        required: true
      email:
        type: string
        description: "Primary email. -> cust.email"
        example: juan.perez@email.com
        required: true
      country:
        type: string
        description: "Country of residential address. -> cust.country"
        example: Colombia
        required: true
      departament:
        type: string
        description: "DANE department code. -> cust.departament"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code. -> cust.city"
        example: '11001'
        required: true
      district:
        type: string
        description: "Locality/Commune. -> cust.district"
        example: Chapinero
        required: false
      address:
        type: string
        description: "Registered address. -> cust.address"
        example: Cra 7 # 32-16
        required: false
      customerSegment:
        type: string
        description: "Customer segment. -> cust.customerSegment"
        example: RESIDENCIAL
        required: true
      subSegmento:
        type: string
        description: "Customer subsegment. -> cust.subSegmento"
        example: MASS
        required: true
      categoria:
        type: string
        description: "Gold|Silver|Bronze|Platinum. -> cust.categoria"
        example: Bronze
        required: true
      habeasData:
        type: string
        description: "Data treatment consent Yes/No. -> cust.habeasData"
        example: 'Yes'
        required: true
      autoretentionFlag:
        type: string
        description: "Self-withholding tax flag Yes/No. -> cust.autoretentionFlag"
        example: 'No'
        required: false
      vipFlag:
        type: string
        description: "VIP customer flag Yes/No. -> cust.vipFlag"
        example: 'No'
        required: false
      paymentRiskLevel:
        type: string
        description: "Payment risk level 1-6. Default 6 (Normal_Very Low). -> cust.paymentRiskLevel"
        example: '6'
        required: false
      blockNotification:
        type: string
        description: "Block dunning channels. E=Email, C=Call, W=WhatsApp, S=SMS. Comma-separated. -> cust.blockNotification"
        example: 'E, C'
        required: false
      contactList:
        type: array
        required: false
        description: "Customer contacts (501=Commercial, 502=Legal, 503=Notification, 504=Delivery Address). -> cust.contactDtoList"
        items:
          type: object
          properties:
            contactType:
              type: string
              description: "501=Commercial, 502=Legal, 503=Notification, 504=Delivery Address. -> contactDto.contactType"
              example: '501'
              required: true
            firstName:
              type: string
              description: "-> contactDto.firstName"
              example: Juan
              required: true
            lastName:
              type: string
              description: "-> contactDto.lastName"
              example: Perez
              required: true
            email:
              type: string
              description: "-> contactDto.email"
              example: juan.perez@email.com
              required: true
            mobilePhone:
              type: string
              description: "-> contactDto.mobilePhone"
              example: '3001234567'
              required: true
            contactDocType:
              type: string
              description: "CC, CE, NIT, PEP, PPT. -> contactDto.contactDocType"
              example: CC
              required: true
            contactDocNo:
              type: string
              description: "-> contactDto.contactDocNo"
              example: '1023456789'
              required: true
            contactDocExpDate:
              type: string
              description: "Document expiry date YYYY-MM-DD. -> contactDto.contactDocExpDate"
              example: '2030-12-31'
              required: false
            country:
              type: string
              description: "Only Colombia accepted. -> contactDto.country"
              example: Colombia
              required: true
            department:
              type: string
              description: "DANE department code. -> contactDto.department"
              example: '11'
              required: true
            city:
              type: string
              description: "DANE city code. -> contactDto.city"
              example: '11001'
              required: true
            district:
              type: string
              description: "Locality/Commune. -> contactDto.district"
              example: Chapinero
              required: false
            addressName:
              type: string
              description: "Street name. -> contactDto.addressName"
              example: Cra 7 # 32-16
              required: true

  custAttributes:
    type: array
    required: false
    description: "Extended attributes for the customer. -> custAttrList (operate=A)"
    items:
      type: object
      properties:
        attrCode:
          type: string
          description: "Attribute code as configured in ZSmart. -> custAttr.attrCode"
          example: PREFERRED_LANG
          required: true
        value:
          type: string
          description: "Attribute value. -> custAttr.value"
          example: ES
          required: true
        effectiveDate:
          type: string
          description: "Effective date YYYY-MM-DD HH:MM:SS. -> custAttr.effDate"
          example: '2026-03-19 10:00:00'
          required: false
