#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: BILLING_CYCLE_CHANGE
description: |
  Change billing cycle cut day. ZSmart: serviceEventId=234 (Modify Billing Cycle Type).
  Account-level operation — only applies to postpaid accounts.
  billing-papi resolves: serviceEventId=234, account(operate=M, acctId, corte, effDate).
  header.prodInstId is NOT sent — no service-level node involved.
properties:
  processCode:
    type: string
    enum: [BILLING_CYCLE_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319013456
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319013456-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  account:
    type: object
    required: true
    description: "Postpaid billing account to update. -> account (operate=M)"
    properties:
      externalId:
        type: string
        description: "ZSmart billing account ID. -> header.acctId / account.acctId"
        example: '14000001234'
        required: true
      corte:
        type: string
        description: "New billing cut day (1-28). -> account.corte"
        example: '6'
        required: true
      effectiveDate:
        type: string
        description: "Date from which the new cycle applies YYYY-MM-DD HH:MM:SS. -> account.effDate"
        example: '2026-05-01 00:00:00'
        required: true
