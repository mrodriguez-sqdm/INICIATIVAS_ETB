#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: ACCOUNT_UPDATE
description: |
  Update billing account profile. ZSmart: serviceEventId=803 (Change account profile).
  billing-papi resolves: serviceEventId=803, account(operate=M, acctId).
  Only fields present in the request are updated — send only what changes.
  NOTE: To change billing cycle (corte) use BILLING_CYCLE_CHANGE (234) — not this operation.
  header.prodInstId is NOT required for this operation.
  Fields eliminated in v0.8: corte (use BILLING_CYCLE_CHANGE), defaultAccount.
properties:
  processCode:
    type: string
    enum: [ACCOUNT_UPDATE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319015678
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319015678-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  account:
    type: object
    required: true
    description: "Billing account to update. -> account (operate=M). Send only fields that change."
    properties:
      externalId:
        type: string
        description: "ZSmart billing account ID. Mandatory. -> header.acctId / account.acctId"
        example: '14000001234'
        required: true
      acctName:
        type: string
        description: "Account name. -> account.acctName"
        example: Juan Perez Premium
        required: false
      billDeliveryType:
        type: string
        description: "Bill delivery: B=Email, A=Post, W=WhatsApp, S=SMS. Combined: 'A, B'. -> account.billDeliveryType"
        example: 'S'
        required: false
      billFlag:
        type: string
        description: "Payment responsible Yes/No. -> account.billFlag"
        example: 'Yes'
        required: false
      taxExempt:
        type: string
        description: "Tax exempt Yes/No. -> account.taxExempt"
        example: 'No'
        required: false
      dunningExemption:
        type: string
        enum: [No, Temporary, Total]
        description: "Dunning exemption. -> account.dunningExemption"
        example: No
        required: false
      dunningExemEff:
        type: string
        description: "Dunning exemption start date YYYY-MM-DD HH:MM:SS. Only when dunningExemption=Temporary. -> account.dunningExemEff"
        example: '2026-04-01 00:00:00'
        required: false
      dunningExemExp:
        type: string
        description: "Dunning exemption end date YYYY-MM-DD HH:MM:SS. Only when dunningExemption=Temporary. -> account.dunningExemExp"
        example: '2026-12-31 23:59:59'
        required: false
      contractName:
        type: string
        description: "Contract name. -> account.contractName"
        example: PLATINUM_ANNUAL_CONTRACT
        required: false
      country:
        type: string
        description: "Country of account address. -> account.country"
        example: Colombia
        required: false
      departament:
        type: string
        description: "DANE department code. -> account.departament"
        example: '11'
        required: false
      city:
        type: string
        description: "DANE city code. -> account.city"
        example: '11001'
        required: false
      address:
        type: string
        description: "Account address. -> account.address"
        example: Cra 15 # 80-20
        required: false
      paymentTerm:
        type: string
        description: "Payment period days. -> account.paymentTerm"
        example: '0'
        required: false
      contacts:
        type: array
        required: false
        description: "Contacts to add or modify. -> account.contactDtoList"
        items:
          type: object
          properties:
            contactType:
              type: string
              enum: ['505', '506', '507', '508', '509']
              description: "505=Bill Delivery, 506=Cobranza, 507=Commercial Register, 508=Administrator, 509=Collection Notification. -> contactDto.contactType"
              example: '505'
              required: true
            operate:
              type: string
              enum: [A, M]
              description: "A=Add, M=Modify. -> contactDto.operate"
              example: M
              required: true
            contactId:
              type: string
              description: "ZSmart contact ID. Required when operate=M. -> contactDto.contactId"
              example: '2001'
              required: false
            firstName:
              type: string
              description: "Contact first name. -> contactDto.firstName"
              example: Maria
              required: false
            lastName:
              type: string
              description: "Contact last name. -> contactDto.lastName"
              example: Lopez
              required: false
            email:
              type: string
              description: "Contact email. -> contactDto.email"
              example: maria.lopez@email.com
              required: false
            mobilePhone:
              type: string
              description: "Contact phone. -> contactDto.mobilePhone"
              example: '3001234567'
              required: false
