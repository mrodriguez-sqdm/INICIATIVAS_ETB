#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: NUMBER_CHANGE
description: |
  Change service number (same exchange). ZSmart: serviceEventId=32 (Number Shifting).
  billing-papi resolves: serviceEventId=32, billProdInst(operate=M) with
  areaCodeNew/serviceNumberNew + areaCodeOld/serviceNumberOld, currencyId=1.
  Fields eliminated in v0.8: productCode, paymentModeCd, statusCd, ownerCustId,
  offerCode, offerInstanceId, newOfferInstanceId — number change does not modify offers.
properties:
  processCode:
    type: string
    enum: [NUMBER_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> header.transactionId"
        example: TRX20260319006789
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYY-MM-DD HH:MM:SS (v0.8). -> header.createDate"
        example: '2026-03-19 10:00:00'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> header.orderItemId"
        example: OI20260319006789-001
        required: true
      salesChannel:
        type: integer
        description: "Channel ID (Mandatory v0.8). 1=POS, 2=WAP, 4=SMS, 5=USSD, 7=IVR, 106=System default. -> header.salesChannel"
        example: 1
        required: true
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=M) with old and new number fields"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      areaCode:
        type: string
        description: "Current area code (maps to areaCodeOld in v0.8). -> billProdInst.areaCodeOld"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Current service number (maps to serviceNumberOld in v0.8). -> billProdInst.serviceNumberOld"
        example: '5551234'
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYY-MM-DD HH:MM:SS. Mandatory in v0.8. -> billProdInst.effDate"
        example: '2026-03-19 10:00:00'
        required: true
      newNumber:
        type: object
        required: true
        description: "New number to assign. -> billProdInst.areaCodeNew + billProdInst.serviceNumberNew"
        properties:
          areaCode:
            type: string
            description: "New area code prefix. -> billProdInst.areaCodeNew"
            example: '601'
            required: true
          serviceNumber:
            type: string
            description: "New service number without prefix. -> billProdInst.serviceNumberNew"
            example: '5559999'
            required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "Optional number change fee. -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> charge.chargeType"
              example: ONE_OFF
              required: true
            amount:
              type: string
              description: "Charge amount in PESO. -> charge.basicCharge"
              example: '8000'
              required: true
            itemTypeCode:
              type: string
              description: "Account item type code. -> charge.acctItemTypeCode"
              example: NUM_CHANGE_FEE
              required: true
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> charge.paidFlag"
              example: 'N'
              required: true
