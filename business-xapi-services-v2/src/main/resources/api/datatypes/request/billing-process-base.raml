#%RAML 1.0 DataType
displayName: BillingProcessBase
type: object
discriminator: processCode
description: |
  Base type for all billing process requests.
  The processCode field discriminates which ZSmart operation sequence to execute.
properties:
  processCode:
    type: string
    enum: [SALE, SALE_BUNDLE, PLAN_CHANGE, PLAN_CHANGE_BUNDLE, ADD_CHARGE, SVA, SUSPENSION, RESTORATION, SUSPENSION_FRAUD, RESTORATION_FRAUD, NUMBER_CHANGE, VOLUNTARY_CANCELLATION, STRATUM_CHANGE, OWNERSHIP_TRANSFER, BILLING_CYCLE_CHANGE, CUSTOMER_UPDATE, ACCOUNT_UPDATE, ADDRESS_CHANGE, NEW_CUSTOMER, NEW_ACCOUNT]
    description: "Billing process discriminator."
    required: true