#%RAML 1.0 DataType
type: !include OfferItem.raml
description: "Offer instance with explicit operate field. Used when CRM controls add/modify/delete of additional offers (e.g. address-change billOfferInstList)."
properties:
  operate:
    type: string
    enum: ['A', 'M', 'D']
    description: "A=Add, M=Modify, D=Delete. -> operate"
    example: 'A'
    required: true
