#%RAML 1.0 DataType
type: !include AttributeItem.raml
description: "Extended attribute with explicit operate field. Used when CRM controls add/modify/delete of attributes (e.g. plan-change billProdInstAttrList)."
properties:
  operate:
    type: string
    enum: ['A', 'M', 'D']
    description: "A=Add, M=Modify, D=Delete. -> operate"
    example: 'A'
    required: true
