#%RAML 1.0 DataType
type: !include OfferItem.raml
description: "Offer instance with operate A or D only. Used in plan-change where the only valid operations are delete current offer (D) and add new offer (A)."
properties:
  operate:
    type: string
    enum: ['A', 'D']
    description: "A=Add new offer, D=Delete current offer. -> operate"
    example: 'A'
    required: true
