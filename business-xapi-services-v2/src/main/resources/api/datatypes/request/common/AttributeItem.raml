#%RAML 1.0 DataType
description: "Extended attribute key-value pair. Used in custAttrList, acctAttrList, billProdInstAttrList, billOfferInstAttrList."
type: object
properties:
  attrCode:
    type: string
    minLength: 1
    maxLength: 30
    description: "Attribute code as configured in ZSmart. -> attrCode"
    example: PREFERRED_LANG
    required: true
  value:
    type: string
    minLength: 1
    maxLength: 255
    description: "Attribute value. -> value"
    example: ES
    required: true
  effectiveDate:
    type: string
    minLength: 19
    maxLength: 19
    description: "Effective date YYYY-MM-DD HH:MM:SS. -> effDate"
    example: '2026-03-19 10:00:00'
    required: false
