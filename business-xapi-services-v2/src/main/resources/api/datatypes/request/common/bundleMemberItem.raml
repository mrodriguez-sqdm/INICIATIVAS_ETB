#%RAML 1.0 DataType
description: |
  Bundle members associated with a service.
type: object
properties:
  operate:
    type: string
    enum: ['A', 'M']
    description: "A=Add new bundle subscriber, M=Modify existing subscriber to bundle. -> bundleMemberList.operate"
    example: 'A'
    required: true
  serviceNumber:
    type: string
    minLength: 1
    maxLength: 30
    description: "Service number of subscriber without prefix. -> bundleMemberList.serviceNumber"
    example: '98653621'
    required: true