#%RAML 1.0 DataType 
type: object
properties:
  customer:
    type: object
    properties:
      address:
        type: object
        properties:
          city:
            type: string
            example: Medellin
            required: false
          streetNumber:
            type: string
            example: '123'
            required: false
          streetName:
            type: string
            example: Calle Principal
            required: false
      contact:
        type: object
        properties:
          phone:
            type: string
            example: '34912345678'
            required: false
      person:
        type: object
        properties:
          firstName:
            type: string
            example: Juan
            required: false
          lastName:
            type: string
            example: Perez
            required: false
          birthDate:
            type: datetime-only
            example: '1990-05-15T00:00:00'
            required: false
          identification:
            type: object
            properties:
              type:
                type: string
                example: CC
                required: false
              number:
                type: string
                example: '40302568'
                required: false
  product:
    type: object
    properties:
      id:
        type: integer
        example: 456
        required: false
      partyId:
        type: string
        example: SR-8392440
        required: false
  credentials:
    type: object
    properties:
      username:
        type: string
        example: juan.perez@example.com
        required: false
      password:
        type: string
        example: Segura123!
        required: false
