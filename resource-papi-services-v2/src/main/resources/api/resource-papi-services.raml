#%RAML 1.0
title: ETB Resource Process API
version: v2
baseUri: http://resource-papi-services-v2-{env}.us-e2.cloudhub.io/{version}
description: |
  Process API para orquestación de recursos (v2). **Consultar disponibilidad** enruta hacia JSC/BSS (GET /v1/msisdn, GET /v1/sim/{id}) según tipo/nombre de recurso.

protocols:
  - HTTP

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml
  security_client_id: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml

mediaType:
  - application/json

/availability:
  /consultation:
    post:
      displayName: Consultar disponibilidad
      description: |
        Orquesta consulta de disponibilidad (MSISDN y/o SIM).  
        Misma forma que la Experience API; capa proceso aplica reglas TELEFONIA/LTE y llamadas a sistemas.
      is:
        - security_client_id
        - tibcoHeaders
      queryParameters:
        ORIGIN:
          type: string
          required: false
          description: Origen de la petición (canal).
          example: "WEB"
      body:
        application/json:
          type: !include datatypes/request/availability-consultation-request.raml
          example: !include examples/request/availability-consultation.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/availability-consultation-response.raml
              example: !include examples/response/availability-consultation.json
        400:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-500.json
