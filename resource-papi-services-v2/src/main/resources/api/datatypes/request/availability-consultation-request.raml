#%RAML 1.0 DataType
type: object
description: |
  Entrada para consultar disponibilidad (MSISDN y/o SIM según recursos).
properties:
  origenIp:
    type: string
    description: Identificación del origen (IP o canal), según diseño.
    required: false
    example: "10.0.0.1"
  recursos:
    type: array
    minItems: 1
    description: Objetos con tipo/nombre/id de recurso a consultar.
    items:
      type: object
      properties:
        tipoRecurso:
          type: string
          description: TELEFONIA, LTE, etc.
          example: "LTE"
        nombreRecurso:
          type: string
          description: MSISDN, SIM (p. ej. bajo LTE).
          example: "MSISDN"
        idRecurso:
          type: string
          description: MSISDN, ICCID u otro id según nombreRecurso.
          example: "573001234567"
  servicio:
    type: object
    required: false
    description: Objeto de trámite/categoría (informativo u orquestación).
    properties:
      tipoTramite:
        type: string
        required: false
      categoria:
        type: string
        required: false
