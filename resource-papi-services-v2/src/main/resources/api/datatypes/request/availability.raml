#%RAML 1.0 DataType
type: object
description: |
  Entrada para consultar disponibilidad (MSISDN y/o SIM según recursos).
properties:
  availabilityRequest:
    type: object
    properties:

      header:
        type: object
        properties:
          availabilityId:
            type: string
            example: "MDM-FIBRA-000646963"
          provisioningOrderNumber:
            type: string
            example: "MDM-FIBRA-000646963"
          revisionNumber:
            type: string
            example: "1"
          technology:
            type: string
            example: "FTTH"
          requestDate:
            type: string
            example: "2026-04-17 14:00:05.05"

      detail:
        type: object
        properties:
          queryMode:
            type: string
            example: "NO"
          availabilityType:
            type: string
            example: "NORMAL"

          orderItem:
            type: array
            items:
              type: object
              properties:

                technicalProductId:
                  type: string
                  example: "Broadband Service Class"

                serviceId:
                  type: string
                  example: "SR-7081997"

                parentServiceId:
                  type: string

                rootServiceId:
                  type: string

                action:
                  type: string
                  example: "ADD"

                serviceUsage:
                  type: string
                  example: "01"

                parentTechnicalProductId:
                  type: string

                rootTechnicalProductId:
                  type: string

                serviceAccount:
                  type: object
                  properties:
                    id:
                      type: string
                      example: "CS-1066440"

                    place:
                      type: array
                      items:
                        type: object
                        properties:

                          id:
                            type: string
                            example: "612802304578067395"

                          stateOrProvince:
                            type: string
                            example: "11"

                          cityCode:
                            type: string
                            example: "11001"

                          country:
                            type: string
                            example: "57"

                          formattedAddress:
                            type: string
                            example: "KR 55C 162 50 IN 1 AP 302"

                          geographicLocation:
                            type: object
                            properties:
                              latitude:
                                type: string
                                example: "4.745532286"
                              longitude:
                                type: string
                                example: "-74.05738482"

                          technology:
                            type: array
                            items:
                              type: object
                              properties:
                                name:
                                  type: string
                                  example: "FIBRA"
                                priority:
                                  type: string
                                zone:
                                  type: string
                                  example: "TOBERIN"
                                coverage:
                                  type: object
                                  properties:
                                    type:
                                      type: string
                                      example: "MOLECULA"
                                    name:
                                      type: string
                                      example: "FTO02"

                characteristic:
                  type: array
                  items:
                    type: object
                    properties:
                      name:
                        type: string
                      value:
                        type: string
                      action:
                        type: string