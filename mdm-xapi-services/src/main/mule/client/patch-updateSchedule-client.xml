<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="patch-updateSchedule-remedyClientSub_Flow" doc:id="036ff893-1821-442a-b975-15fbcb44f647" >
		<http:request method="PATCH" doc:name="Request" doc:id="19703c45-613e-4ff9-93dd-ce6feb9fa8db" config-ref="remedy_sapi" path="#[p('remedy-sapi.path.incidence') ++ '{incidence_id}' ++ p('remedy-sapi.path.schedule') ++ '{schedule_id}']">
			<http:headers ><![CDATA[#[output application/java
---
{
	"source" : attributes.headers.source,
	"X-CORRELATION-ID" : correlationId,
	"name" : attributes.headers.name,
	"client_secret" : p('credentials.client_secret'),
	"client_id" : p('credentials.client_id'),
	"systemId": vars.systemId
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"schedule_id" : vars.schedule_id,
	"incidence_id" : vars.incidence_id
}]]]></http:uri-params>
		</http:request>
	</sub-flow>
	<sub-flow name="patch-operations-schedule-clientSub_Flow" doc:id="c2b4340c-39d3-48ba-a8a8-f8f8ecfd54ec" >
		<http:request method="PATCH" doc:name="Request" doc:id="504e798a-c365-49e1-86c3-ff3c98d74810" path="${remedy-sapi.path.scheduleO}" config-ref="remedy_sapi">
			<http:headers ><![CDATA[#[{
	"X-CORRELATION-ID" : correlationId,
	"name" : attributes.headers.'name',
	"client_secret" : p('credentials.client_secret'),
	"client_id" : p('credentials.client_id'),
	"source": attributes.headers.source,
	"systemId": vars.systemId
}]]]></http:headers>
		</http:request>
	</sub-flow>
</mule>
