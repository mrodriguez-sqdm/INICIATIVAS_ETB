	"client_id" : p('credentials.client_id'),
	"source": attributes.headers.source,
	"systemId": vars.systemId
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"order_id" : attributes.uriParams.'order_id'
}]]]></http:uri-params>
		</http:request>
		<logger level="INFO" doc:name="After Call" doc:id="9bc1cf3c-ed5c-4e88-bf63-9be8c810f7dd" message="#[payload]"/>
