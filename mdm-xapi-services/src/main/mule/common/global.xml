		<http:request-connection protocol="${sisext-sapi.protocol}" host="${sisext-sapi.host}" port="${sisext-sapi.port}" />
	</http:request-config>
	<http:request-config name="HTTP_Request_configuration_ASAP" doc:name="HTTP Request configuration" doc:id="ae601fdd-aac0-41f0-bf37-8eda5aea395d" basePath="${asap-sapi.basepath}" responseTimeout="${configurationTimeout.asap-sapi}">
