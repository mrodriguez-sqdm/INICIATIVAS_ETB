    <http:listener-config name="mdm-xapi-services-httpListenerConfig">
        <http:listener-connection host="${https.host}" port="${https.port}" tlsContext="TLS_Context" protocol="HTTPS" />
    </http:listener-config>
    <apikit:config outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" name="mdm-xapi-services-config" api="mdm-xapi-services.raml" />
	<configuration-properties doc:name="Configuration properties" doc:id="9d487489-502e-4c9c-9205-bcea50b6a994" file="${env}-properties.yaml" />
