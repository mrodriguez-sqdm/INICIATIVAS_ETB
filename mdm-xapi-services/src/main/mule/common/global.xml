		<http:request-connection protocol="${etb-mdm.protocol}" host="${etb-mdm.host}" port="${etb-mdm.port}" />
	</http:request-config>
	<http:request-config name="sap-sapi-services-config" doc:name="HTTP Request configuration" doc:id="de34fcc7-3901-46c1-b59a-4fdb44f5a4c9" basePath="#[p('sap-sapi.basePath')]" responseTimeout="${configurationTimeout.sap-sapi}">
		<http:request-connection host="#[p('sap-sapi.host')]" port="#[p('sap-sapi.port')]" />
	</http:request-config>
	<http:request-config name="HTTP_Request_configuration_to_JAR" doc:name="HTTP Request configuration" doc:id="5925168a-a60e-4db1-a6c9-5d1dd4dbfdd2" basePath="${salesforce-jar.basePath}" responseTimeout="${configurationTimeout.salesforce-jar}">
		<http:request-connection protocol="${salesforce-jar.protocol}" host="${salesforce-jar.host}" />
	</http:request-config>
	<import doc:name="Import" doc:id="435e44f7-fd6b-4d9d-b730-71fdc2ed101b" file="error-handler.xml" />
	<import doc:name="Import" doc:id="9ed717e4-ebc0-434f-a471-cadb9abc747e" file="loggin.xml" />
	<import doc:name="Import" doc:id="aff69655-93cf-493c-974c-938ca10b6b9a" file="audits-sapi-client.xml" />
	<import doc:name="Import" doc:id="ca00b5cf-97a5-4a0b-8aa5-26d8f21fb560" file="etb-common-lib.xml" />
