		<tls:trust-store insecure="true" />
		<tls:key-store type="jks" path="security/keystore.jks" keyPassword="password" password="password" />
	</tls:context>
		<http:request-config name="remedy_sapi" doc:name="HTTP Request configuration" doc:id="4b641507-d439-4d20-859e-b33b05897a5c" basePath="${remedy-sapi.basePath}" responseTimeout="${configurationTimeout.remedy-sapi}">
		<http:request-connection protocol="${remedy-sapi.protocol}" host="${remedy-sapi.host}" port="${remedy-sapi.port}" />
	</http:request-config>	
	<api-gateway:autodiscovery apiId="${autodiscovery}" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="3e4cbfde-3d21-414b-b0cb-ea0c14dbbb43" flowRef="mdm-xapi-services-main" />
