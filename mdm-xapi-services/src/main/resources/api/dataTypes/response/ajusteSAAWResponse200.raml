#%RAML 1.0 DataType

properties: 
  AjusteSAAWResponse:
    type: object
    properties:
      wsResponseHeader:
        type: object
        properties:
          system:
            type: object
            properties:
              name:
                type: string
                example: "Mulesoft"
              correlationId:
                type: string
                example: "MDM-MOV-2306254-OL-1-OL"
              processingServer:
                type: string
                example: "MDM"
          service: 
            type: object
            properties:
              status:
                type: string
                example: "PASS"
              responseDate:
                type: string
                example: "2022-04-24T08:34:57.22-05:00"
      ajuste_saawResponse:
        type: object
        properties:
          result:
            type: string
            example: "Exitoso"