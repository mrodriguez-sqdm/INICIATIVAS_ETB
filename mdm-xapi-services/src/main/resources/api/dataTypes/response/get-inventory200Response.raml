#%RAML 1.0 DataType
type: object
properties:
  System:
    properties:
      correlationID:
        type: string
        example: INC000006148440
      processingServer:
        type: string
        example: Mulesoft
      responseDate: 
        type: datetime
        example: 2021-12-01T01:19:39.436-05:00
  Response:
    properties:
      ResponseInventario:
        type: array
        items:
          type: object
          properties:
            ID_Producto: 
              type: string
              example: 5da091ea5ab20c0df4911c7e
            codigo_sap:
              type: string
              example: 120-04681
            descripcion:
              type: string
              example: DEMARCADOR RAISECOM RAX 711 AC/DC
            id_inventario:
              type: string
              example: 5ec205ae5ab20c10300ff2fc
            respuesta:
              type: string
              example: Resultado exitoso
            serial:
              type: string
              example: 123002021200S18525S0096G
