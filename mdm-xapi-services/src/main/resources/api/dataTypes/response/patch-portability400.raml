#%RAML 1.0 DataType
properties:
  PortabilityCompensationOUT:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System: !include ../subDatatypes/System.raml
          Service:
            type: object
            properties:
              status:
                type: string
                example: FAIL
              responseDate:
                type: datetime-only
                example: 2022-06-29T14:35:55
              statusDetail:
                type: object
                properties:
                  errorCode:
                    type: string | nil
                    example: "1"
                  errorMessage:
                    type: string
                    example: "No se encontraron datos"
      PortabilityCompensationOutput:
        type: object
        properties:
          ResponseService:
            type: object
            properties:
              Result:
                type: string
                required: true 
                example: "E"
              DescriptionError:
                type: string
                example: "No se encontraron datos"