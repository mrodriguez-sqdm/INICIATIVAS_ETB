#%RAML 1.0 DataType
properties:
  GetBillsOutput:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System: !include ../subDatatypes/Header.raml
          Service:
            type: object
            properties:
              status:
                type: string
                example: "PASS"
      Bills: !include ../subDatatypes/Bills.raml
      Result:
        type: object
        properties:
          code: 
            type: string
            example: "SUCCESS"
          description:
            type: string
            example: ""