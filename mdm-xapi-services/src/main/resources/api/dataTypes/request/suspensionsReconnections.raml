#%RAML 1.0 DataType
type: object
properties:
  body:
    type: object
    required: true
    properties:
      wsInputSuspensionsReconnections:
        type: object
        required: true
        properties:
          wsRequestHeader:
            type: object
            required: true
            properties:
              system:
                type: array
                items:
                  type: object
                  properties:
                    correlationID:
                      type: string
                      required: true
                      example: ""
                    processingServer:
                      type: string
                      required: true
                      example: ""
              property:
                type: object
                required: true
                properties:
                  name:
                    type: string
                    required: true
                    example: ""            
                  value:
                    type: string
                    required: true
                    example: ""              
          inputSuspensionsReconnections:
            type: array
            items:
              type: object
              properties:
                misdn:
                  type: string
                  required: true
                  example: ""              
                actionRS:
                  type: string
                  required: true
                  example: ""  
                recursos:
                  type: string
                  required: true
                  example: ""                     
