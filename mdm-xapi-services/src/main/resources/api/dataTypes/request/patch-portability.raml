#%RAML 1.0 DataType
properties:
  PortabilityCompensationIN:
    type: object
    properties:
      WSRequestHeader2:
        type: object
        properties:
          System: !include ../subDatatypes/System.raml
      PortabilityCompensationInput:
        type: object
        properties:
          portalfija_data:
            type: object
            properties:
              PortabilityCompensation:
                type: object
                properties:
                  Id:
                    type: string
                    required: true
                    example: "1"
                  Account: 
                    type: string
                    required: true 
                    example: "15052852998"
                  ext_srvc_id:
                    type: string
                    required: true
                    example: "MDM-MOV-308665-1"
                  Hours:
                    type: string
                    required: true
                    example: "35.03"