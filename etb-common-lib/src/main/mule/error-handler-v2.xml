<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ================================================= -->
    <!-- COMMON ERROR HANDLER V2 -->
    <!-- ================================================= -->

    <error-handler name="common-error-handler-v2">

        <!-- ======================= -->
        <!-- APIKIT ERRORS           -->
        <!-- ======================= -->

        <on-error-propagate type="APIKIT:BAD_REQUEST">
            <flow-ref name="build-error-response-400" doc:name="build-error-response-400"/>
        </on-error-propagate>

        <on-error-propagate type="APIKIT:NOT_FOUND">
            <flow-ref name="build-error-response-404" doc:name="build-error-response-404"/>
        </on-error-propagate>

        <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
            <flow-ref name="build-error-response-405" doc:name="build-error-response-405"/>
        </on-error-propagate>

        <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
            <flow-ref name="build-error-response-406" doc:name="build-error-response-406"/>
        </on-error-propagate>

        <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
            <flow-ref name="build-error-response-415" doc:name="build-error-response-415"/>
        </on-error-propagate>

        <!-- ======================= -->
        <!-- HTTP ERRORS             -->
        <!-- ======================= -->

         <on-error-propagate type="HTTP:NOT_FOUND">
            <flow-ref name="build-error-response-404" doc:name="build-error-response-404"/>
        </on-error-propagate>

        <on-error-propagate type="HTTP:BAD_REQUEST">
            <flow-ref name="build-error-response-400" doc:name="build-error-response-400"/>
        </on-error-propagate>
 
        <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="b3e31a83-3736-4261-b351-b8988c7deed7" type="HTTP:UNAUTHORIZED">
			<flow-ref doc:name="build-error-response-401" doc:id="7424e02d-253f-4402-833e-1587574e7f74" name="build-error-response-401"/>
		</on-error-propagate>
		
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="fea24830-7ad1-404a-9eea-32c1cf35f87f" type="HTTP:FORBIDDEN" >
			<flow-ref doc:name="build-error-response-403" doc:id="9bcc5ac9-b98c-4339-980d-8fa78e2f6c10" name="build-error-response-403" />
		</on-error-propagate>

        <on-error-propagate type="HTTP:CONNECTIVITY, HTTP:TIMEOUT" enableNotifications="true" logException="true">
            <flow-ref name="build-error-response-504" doc:name="build-error-response-504"/>
        </on-error-propagate>
        
        <!-- ======================= -->
        <!-- DEFAULT / ANY           -->
        <!-- ======================= -->

        <on-error-propagate type="ANY">
            <flow-ref name="build-error-response-500" doc:name="build-error-response-500"/>
        </on-error-propagate>

    </error-handler>

    <!-- ================================================= -->
    <!-- ERROR RESPONSE BUILDERS                          -->
    <!-- ================================================= -->
    <sub-flow name="build-error-response-400">
        <set-variable variableName="httpStatus" value="400" />
		<flow-ref name="build-common-error"/>
    </sub-flow>
    
    <sub-flow name="build-error-response-401" doc:id="0c3e92d8-614f-4c03-bd21-af1b9e449b19">
		<set-variable variableName="httpStatus" value="401" />
		<flow-ref name="build-common-error"/>
    </sub-flow>
    
    <sub-flow name="build-error-response-403" doc:id="b38155ff-6e70-4ee4-8137-6cb4a1cbe8bd">
		<set-variable value="403" doc:name="Set Variable" doc:id="07f9c403-d91c-4d51-afe6-f0ce1c7ed9bc" variableName="httpStatus" />
		<flow-ref doc:name="Flow Reference" doc:id="cb5c69e9-0184-4a20-a86a-d5a89afb932f" name="build-common-error" />
	</sub-flow>

    <sub-flow name="build-error-response-404">
        <set-variable variableName="httpStatus" value="404" />
		<flow-ref name="build-common-error"/>
    </sub-flow>

    <sub-flow name="build-error-response-405">
        <set-variable variableName="httpStatus" value="405" />
		<flow-ref name="build-common-error"/>
    </sub-flow>

    <sub-flow name="build-error-response-406">
        <set-variable variableName="httpStatus" value="406" />
		<flow-ref name="build-common-error"/>
    </sub-flow>

    <sub-flow name="build-error-response-415">
        <set-variable variableName="httpStatus" value="415" />
		<flow-ref name="build-common-error"/>
    </sub-flow>

    <sub-flow name="build-error-response-504">
        <set-variable variableName="httpStatus" value="504" />
		<flow-ref name="build-common-error"/>
    </sub-flow>
	<sub-flow name="build-error-response-500">
        <set-variable variableName="httpStatus" value="500" />
		<flow-ref name="build-common-error"/>
    </sub-flow>

    <!-- ================================================= -->
    <!-- COMMON ERROR BUILDER                             -->
    <!-- ================================================= -->

    <sub-flow name="build-common-error">

        <ee:transform doc:name="Build Error Payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
var currentApi = p("app.name")
fun getError(errorPayload, defaultCause, appName) = do {
	var origin = {
		"origin": appName
	}
	var currentCause = if ( errorPayload is Object ) errorPayload.cause else []
	var errorCause = errorPayload match {
		case is Object ->  [origin ++ {
			"message": defaultCause
		}]
	case is String -> [origin ++ {
			message: errorPayload
		}]
	case is Null -> [origin ++ {
			message: defaultCause
		}]
	else -> [origin ++ {
			message: "Unexpected Error: Please contact support."
		}]
	}
	---
	currentCause ++ errorCause
}
fun getErrorMessage(errorMessage, defaultMessage, appName) = 
	errorMessage match {
	case is Object -> if(errorMessage.message is Object) errorMessage.message.message else errorMessage.message
		case is String -> appName ++ ": " ++ errorMessage
		case is Null -> appName ++ ": " ++ defaultMessage
		else -> "Unexpected Error: Please contact support."
}
---
{
	status: vars.httpStatus,
	code: error.errorType.namespace ++ ":" ++ error.errorType.identifier,
	message: getErrorMessage(error.errorMessage.payload, (error.description default "Unexpected Error"), currentApi),
	messageServer: error.failingComponent default "Unexpected Error",
	cause: getError(error.errorMessage.payload, error.cause.message, currentApi)
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <async>
            <flow-ref name="loggin-client-call"/>
        </async>

    </sub-flow>

</mule>
