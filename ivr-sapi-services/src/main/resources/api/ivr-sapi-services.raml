#%RAML 1.0
title: ivr-sapi-services
version: v1
protocols:
  - HTTP
baseUri: http://ivr-sapi-services-{env}.us-e2.cloudhub.io/ivr/
  
traits:
  security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml
  imeiParams: !include traits/imeiQueryParameters.raml
uses:
  support-api-services: libraries/support-api-services-library.raml 
  insertPositiveRecord-lib: libraries/insertPositiveRecord-lib.raml

/v1:
  /imei:
    get:
      is: [security-client-id, tibcoHeaders,imeiParams]
      displayName: Consulta IMEI
      description: Consulta de los IMEI Registrados
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/responses/ResponseBDO.raml
  /positiveRecord:
    post:
      is: [support-api-services.security-clientid-trait]
      displayName: Insert positive record
      description: This method creates a positive record
      body:
        application/xml:
          type: insertPositiveRecord-lib.WSRegistroPositivo
          example: !include examples/requests/insertPositiveRecord.raml
      responses:
          201:
            description: Response for the status 200
            body: 
              application/json:
                example: !include examples/responses/postPositiveRecord200Response.json
          500:
            description: Response for the status 500
            body:
              application/json:
                example: !include examples/responses/postPositiveRecord500Response.json              