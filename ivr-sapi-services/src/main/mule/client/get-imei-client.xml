<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:scripting="http://www.mulesoft.org/schema/mule/scripting" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/scripting http://www.mulesoft.org/schema/mule/scripting/current/mule-scripting.xsd">
	<sub-flow name="imei-clientSub_Flow" doc:id="e87798ee-ad12-4f93-ba54-0f6e6c837706" >
		<async doc:name="Async" doc:id="04ff6208-ac58-4306-ba2f-4db1be39681d" >
			<flow-ref doc:name="Call logger before" doc:id="116c7232-bbed-48be-bb72-26682b3b5674" name="loggin-client-call"/>
		</async>
		<http:request method="POST" doc:name="Request" doc:id="17bbf034-1fa3-4f93-8c28-389b3dda4bd8" config-ref="HTTP_Request_IMEI_configuration" path="#[p('imei.basepath')]" />
		<async doc:name="Async" doc:id="51b78c75-8df0-4c4a-94ec-1aaeb38acd3f" >
			<flow-ref doc:name="Call logger after" doc:id="da2c75d4-f968-46d4-ae54-ebf869fc8987" name="loggin-client-call"/>
		</async>
		<try doc:name="Try" doc:id="b11bccac-acf4-4ce1-b75c-32849b2ebc16">
					<ee:transform doc:name="Transform to Json Format" doc:id="a9590373-5f4d-48b3-a3a7-211ab4801f81">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"IMEI":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.IMEI,
	"Estado":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.Estado,
	"Marca":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.Marca,
	"CodigoRespuestaListas":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.CodigoRespuestaListas,
	"Modelo":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.Modelo,
	"RespuestaGSMA":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.RespuestaGSMA,
	"ProbadoRedETB":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.ProbadoRedETB,
	"RespuestaPruebaRedETB":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.RespuestaPruebaRedETB,
	"HomologadoColombia":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.HomologadoColombia,
	"TamanoSIM":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.TamanoSIM,
	"PartNumberSIM":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.PartNumberSIM,
	"CodigoError":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.CodigoError,
	"DescripcionError":payload.Envelope.Body.ConsultaBDOResponse.ConsultaBDOResult.DescripcionError
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<error-handler>
						<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="a48a36c7-14ed-4fd2-af6d-5466f448193a">
							<ee:transform doc:name="Transform Message" doc:id="4f5e0188-a502-4629-b602-f2c841cf2724">
								<ee:message />
								<ee:variables>
									<ee:set-variable variableName="httpCode"><![CDATA[404]]></ee:set-variable>
								</ee:variables>
							</ee:transform>
							<set-payload value="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	&#10;}]" doc:name="Set Payload" doc:id="51b45b36-8d45-4bcf-a54f-23c296188418" />
						</on-error-continue>
					</error-handler>
				</try>
	</sub-flow>
</mule>
