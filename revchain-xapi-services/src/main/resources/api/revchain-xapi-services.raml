#%RAML 1.0
title: revchain-xapi-services
version: "1"
protocols:
  - HTTPS

baseUri: http://revchain-xapi-services-{env}.us-e2.cloudhub.io/

traits: 
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.4/tibcorequestheaders.raml
  security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml

uses:
  definitions: types/library.raml

mediaType: 
  - application/json
  - application/xml

/billing:
  /v1:
    /accounts/revchain:
      patch:
        is:
          - tibcoHeaders
          - security-client-id
        displayName: Servicio para Notificación de Creación Cuenta
        description: Servicio para Notificación de Creación Cuenta
        body:
          application/xml:
            type: definitions.Revchain_Respuesta_Proceso

