#%RAML 1.0 DataType
displayName: CUN Assignment Response
type: object
properties:
  code:
    type: string
    example: "200"
  message:
    type: string
    example: "Operacion exitosa"
  cun?:
    type: object
    properties:
      errorCode?:
        type: string | nil
        example: null
        required: false
      errorName?:
        type: string | nil
        example: null
        required: false
      cunNumber:
        type: string
        example: "CUN986532"
        required: true
      cunDate:
        type: string
        example: "2026-03-16"
        required: true
      pqrType:
        type: string
        example: "PQR_TYPE"
        required: true
      pqrDate:
        type: string
        example: "2026-03-16"
        required: true
      system:
        type: string
        example: "TBD"
        required: true
      orderNumber:
        type: string
        example: "ORD123265"
        required: true
      identificationType:
        type: string
        example: "CC"
        required: true
      identification:
        type: string
        example: "98653212"
        required: true
      connectionNumber:
        type: string
        example: "CONN54976"
        required: true
example: !include ../../examples/responses/post-cun-assignment-response.json