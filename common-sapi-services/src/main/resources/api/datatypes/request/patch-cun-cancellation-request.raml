#%RAML 1.0 DataType
displayName: CUN Cancellation Request
type: object

properties:
  cunNumber:
    type: string
    example: "CUN986532"
    required: true
  incidentDate:
    type: string
    example: "16/05/2026 14:40:09"
    required: true
  typology:
    type: string
    example: "CANCELLATION_TYPE"
    required: true
  identificationType:
    type: string
    example: "CC"
    required: true
  identification:
    type: string
    example: "12014261"
    required: true
  reportDate:
    type: string
    example: "16/05/2026 14:45:00"
    required: true
  creatorUser:
    type: string
    example: "MDM"
    required: true
  customerIdentificationType:
    type: string
    example: "CC"
    required: true
  customerIdentification:
    type: string
    example: "12014261"
    required: true
  connectionNumber:
    type: string
    example: "CONN54976"
    required: true
  system:
    type: string
    example: "MDM"
    required: true
  orderNumber:
    type: string
    example: "MDM-FIBRA-0006481210"
    required: true
  pqrDate:
    type: string
    example: "16/05/2026 14:40:09"
    required: true
  user:
    type: string
    example: "MDM"
    required: true
  password:
    type: string
    example: "USUARIO_PASS"
    required: false

examples:
  cunCancellation: !include ../../examples/request/patch-cun-cancellation-request.json