    example: '20270519'
    required: false
  Hora_Vigencia_Ini:
    type: time-only
    example: '00:00:00'
    required: false
  Fch_Vigencia_Fin:
    type: string
    example: '20270524'
    required: false
  Hora_Vigencia_Fin:
    type: time-only
    example: '00:00:00'
    required: false
  Vigencia_Rec:
    type: integer
    example: 165
    required: false
  ID_Gestor_Rec:
    type: integer
    example: 103
    required: false
  Gestor_Rec:
    type: integer
    example: 102
    required: false
  Modalidad_pago:
    type: string
    example: PREPAGO
    required: false
  Modalidad_pago_abonado_a:
    type: string
    example: PREPAGO
    required: false
  Modalidad_pago_abonado_b:
    type: string
    example: CONTROL
