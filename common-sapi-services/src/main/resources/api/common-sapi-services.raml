#%RAML 1.0
title: common-sapi-services
baseUri: common-sapi-services-dev.us-e2.cloudhub.io/common/
description: The following API will handle modifications done to the record of un-normalized addresses.
mediaType: 
- application/json
version: 1
protocols:
  - HTTP

traits: 
  security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  tibcoHeaders: !include /exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml
  

/v1:
  /catalogs/{id_catalog}/ids/{id_nit}:
    uriParameters:
      id_catalog:
        type: string
        required: true
      id_nit:
        type: string
        required: true
    get:
      is: [security-client-id, tibcoHeaders]
      displayName: Homologation
      description: filter by id_catalog and id_nit
      responses:
        200: 
          body:
            type: !include datatypes/responses/catalogsResponse.raml
  /auditLogs:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Post of loggers
      description: Post new entry logs
      body:
        application/json:
          type: !include datatypes/request/post-auditLogs.raml
      responses:
        201: 
          body:
            application/json:
              type: !include datatypes/responses/post-logs201.raml
  /spnpqrLogs:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Post of logs PQR
      description: Post de logs PQR en soporte de primer nivel
      body:
        application/json:
          type: !include datatypes/request/post-spnpqrLogs.raml
      responses:
        201: 
          body:
            application/json:
              type: !include datatypes/responses/post-logs201.raml
  /conversationLogs:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Post of conversation logs
      description: Post of conversation logs
      body:
        application/json:
          type: !include datatypes/request/post-conversationLogs.raml
      responses:
        201: 
          body:
            application/json:
              type: !include datatypes/responses/post-logs201.raml
  /sumaLogs:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Post of SUMA logs
      description: Post of SUMA logs
      body:
        application/json:
          type: !include datatypes/request/post-sumaLogs.raml
      responses:
        201: 
          body:
            application/json:
              type: !include datatypes/responses/post-logs201.raml
  /convertibilityLogs:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Post of Convertibility logs
      description: Post of Convertibility logs
      body:
        application/json:
          type: !include datatypes/request/post-convertibilityLogs.raml
      responses:
        201: 
          body:
            application/json:
              type: !include datatypes/responses/post-logs201.raml
  /traceabilityLogs:
    post:
      is: [security-client-id, tibcoHeaders]
      displayName: Post of Traceability logs
      description: Post of Traceability logs
      body:
        application/json:
          type: !include datatypes/request/post-traceabilityLogs.raml
      responses:
        201: 
          body:
            application/json:
              type: !include datatypes/responses/post-logs201.raml
    /edr:
      post:
        is: [security-client-id, tibcoHeaders]
        displayName: Post of Traceability logs EDR
        description: Post of Traceability logs EDR
        body:
          application/json:
            type: !include datatypes/request/post-traceabilityLogsEDR.raml
            examples:
              activacion: !include examples/request/post-traceabilityLogs-activacion.json
              pasasaldo: !include examples/request/post-traceabilityLogs-pasasaldo.json
              recarga: !include examples/request/post-traceabilityLogs-recarga.json
              sva: !include examples/request/post-traceabilityLogs-sva.json
        responses:
          202:
            body:
              application/json:
                type: !include datatypes/responses/post-logs201.raml
  /portability:
    /documents:
      /{pathFile}:
        uriParameters:
          pathFile:
            type: string
            example: "000022024060632238-CC.pdf"
        get:
          is: [security-client-id, tibcoHeaders]
          displayName: Obtain portability document
          description: Obtains a portability document
          queryParameters:
            defaultPath:
              type: string | nil
              required: false
              example: "ON"
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/responses/portabilityDocumentResponse.raml 
      post:
        is: [security-client-id, tibcoHeaders]
        displayName: Insert portability document
        description: Inserts a new portability document
        body:
          application/json:
            type: !include datatypes/request/portabilityDocumentInsertion.raml
        responses:
          201: 
            body:
              application/json:
                type: !include datatypes/responses/portabilityDocumentInsertion.raml
  /cun:
    /assignments:
      post:
        is: [security-client-id, tibcoHeaders]
        displayName: Post CUN Assigment
        description: Post CUN Assigment
        body:
          application/json:
            type: !include datatypes/request/post-cun-assignment-request.raml
        responses:
          201: 
            body:
              application/json:
                type: !include datatypes/responses/post-cun-assignment-response.raml
