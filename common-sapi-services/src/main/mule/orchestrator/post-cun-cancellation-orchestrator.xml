<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-cun-cancellation-orchestrator-sub-flow" doc:id="ac0977db-e375-4593-aa04-5e0e7b0ee61b" >
		<try doc:name="Try" doc:id="2da19f6b-8ff3-4e42-9604-47a1ae690646" >
			<ee:transform doc:name="set xml request" doc:id="d9854520-93d0-4482-9914-5e84dd763b16" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0

ns tem http://tempuri.org/
output application/xml skipNullOn = "everywhere", writeDeclaredNamespaces = "All"

var origin = lower(payload.user)
var user = "secure::cun.soap.credentials." ++ origin ++ ".user"
var pass = "secure::cun.soap.credentials." ++ origin ++ ".pass"

---
{
  tem#AnularCUN: {
    tem#Numcun: payload.cunNumber,
    tem#FechaIncidente: payload.incidentDate,
    tem#Tipologia: payload.typology,
    tem#TipoIdentificacion: payload.identificationType,
    tem#Identificacion: payload.identification,
    tem#FechaReporte: payload.reportDate,
    tem#UsuCreador: payload.creatorUser,
    tem#TipoIdentificacionCl: payload.customerIdentificationType,
    tem#IdentificacionCl: payload.customerIdentification,
    tem#NumConexion: payload.connectionNumber,
    tem#Sistema: payload.system,
    tem#NumOrden: payload.orderNumber,
    tem#FechaPQR: payload.pqrDate,
    tem#Usuario: p(user),
    tem#Contrasena: p(pass)
  }
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<flow-ref doc:name="cun-soap-cancellation-clientSub_Flow" doc:id="0da689e2-1006-4f3a-8ace-141413466ec9" name="cun-soap-cancellation-clientSub_Flow" />
			<choice doc:name="validate soap response" doc:id="15da612a-7569-47dd-9ae5-c0928baa12ab" >
				<when expression='#[payload.body.AnularCunResponse.AnularCunResult.CodError == "5015" or payload.body.AnularCunResponse.AnularCunResult.CodError == "5014"]' >
					<ee:transform doc:name="set json response" doc:id="5ae2f7fa-26f9-4b44-941b-1084c658ca08" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0

ns tem http://tempuri.org/

output application/json

var result = payload.body.tem#AnularCUNResponse.tem#AnularCUNResult

---
{
    code: "200",
    message: "CUN cancelled correctly",
    cun: {
        errorCode: result.tem#CodError,
        errorMessage: result.tem#NomError
    }
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</when>
				<otherwise >
					<raise-error doc:name="POST_CUN_CANCELLATION:RESULT_ERROR" doc:id="b3bb2dad-5645-4ddf-bf1c-98fe0f386bef" type="POST_CUN_CANCELLATION:RESULT_ERROR" description='#["CancellationCUNResult: " ++ (payload.body.AnularCunResponse.AnularCunResult.CodError as String) ++ " - " ++ (payload.body.AnularCunResponse.AnularCunResult.NomError as String)]' />
				</otherwise>
			</choice>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="5740aa88-6163-4f12-a09d-af4ecceaef31" type="POST_CUN_CANCELLATION:RESULT_ERROR" >
					<ee:transform doc:name="set result error" doc:id="bdecbf2d-6c81-4da5-8004-66a0fba75753" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": "400",
	"code": "POST_CUN_CANCELLATION:RESULT_ERROR",
	"message": error.description,
	"messageServer": error.description,
	"cause": [{
		"origin": "common-sapi-services",
		"message": error.description
	}]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
				<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="7b2a68e5-f5cd-4888-a318-6ee277c89488" type="WSC:SOAP_FAULT" >
					<ee:transform doc:name="set fault error" doc:id="f42c4dc9-549d-4e93-8fd3-23a3215aaabf" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": "500",
	"code": "WSC:SOAP_FAULT",
	"message": error.description,
	"messageServer": error.description,
	"cause": [{
		"origin": "common-sapi-services",
		"message": error.description
	}]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-propagate>
			</error-handler>
		</try>
	</sub-flow>
</mule>
