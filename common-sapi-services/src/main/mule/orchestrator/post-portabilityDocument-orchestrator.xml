<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-portabilityDocument-orchestratorSub_Flow" doc:id="228dc067-8793-40d5-894e-543aa3270f52" >
		<ee:transform doc:name="Prepare document params" doc:id="49fb70e7-5ee9-4b44-82c8-2c92e2bfd525" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="filePath" ><![CDATA[%dw 2.0
output application/java
---
(if (!isEmpty(payload.filePath)) payload.filePath else p('sftp-portability.path')) ++ payload.fileName]]></ee:set-variable>
				<ee:set-variable variableName="fileContent" ><![CDATA[%dw 2.0
output application/octet-stream
---
payload.fileContent]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Go to Client" doc:id="620e9893-6bdc-4dc0-8e9a-5bc93107daca" name="post-portabilityDocument-client"/>
		<ee:transform doc:name="Prepare output" doc:id="0a27de4e-5d5d-4c98-8065-91bc126e89e2" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	status: "OK",
	code: "201",
	description: "Document inserted successfully"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
