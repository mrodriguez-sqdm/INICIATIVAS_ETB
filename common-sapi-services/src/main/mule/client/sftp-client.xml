    <flow name="sftp-convertibilityLogs-clientFlow" doc:id="857f441d-e9fb-468c-85dc-59a4da099646" >
        <sftp:listener doc:name="On New or Updated File ConvertibilityLogger" doc:id="50babaa9-5af0-4b4e-bdfc-2a4ee4e3b4b2" config-ref="SFTP_Config_AuditLogs" directory="${convertibilityLogs.path}" moveToDirectory="${convertibilityLogs.path}" renameTo="#[p('convertibilityLogs.file') ++ &quot;.&quot; ++ sizeOf(vars.numberOfEntries)]" recursive="false">
            <scheduling-strategy >
