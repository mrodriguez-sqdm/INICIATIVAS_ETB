            <sftp:matcher filenamePattern="${conversationLogs.regex}"/>
        </sftp:list>
    </flow>
    <flow name="sftp-sumaLogs-clientFlow" doc:id="2e9bfb75-fcf1-483c-8d3a-4b346a99f135" >
        <sftp:listener doc:name="On New or Updated File SumaLogger" doc:id="281662cb-89d0-4d22-a740-5a3ba8601edb" config-ref="SFTP_Config_AuditLogs" directory="${sumaLogs.path}" moveToDirectory="${sumaLogs.path}" renameTo="#[p('sumaLogs.file') ++ &quot;.&quot; ++ sizeOf(vars.numberOfEntries)]" recursive="false">
            <scheduling-strategy >
