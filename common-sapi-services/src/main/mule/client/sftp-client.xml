        <sftp:listener doc:name="On New or Updated File SPNPQRLogger" doc:id="34c97055-69cd-40f9-af9d-609d4e2e5f72" config-ref="SFTP_Config_AuditLogs" directory="${spnpqrLogs.path}" moveToDirectory="${spnpqrLogs.path}" renameTo="#[p('spnpqrLogs.file') ++ &quot;.&quot; ++ sizeOf(vars.numberOfEntries)]" recursive="false">
            <scheduling-strategy >
                <fixed-frequency/>
            </scheduling-strategy>
            <sftp:matcher filenamePattern="${spnpqrLogs.file}" minSize="${spnpqrLogs.fileMaxSize}"/>
        </sftp:listener>
        <sftp:list doc:name="List" doc:id="f9219726-8147-4fa1-947b-aec5addb370b" config-ref="SFTP_Config_AuditLogs" directoryPath="${spnpqrLogs.path}" target="numberOfEntries">
            <sftp:matcher filenamePattern="${spnpqrLogs.regex}"/>
        </sftp:list>
    </flow>
