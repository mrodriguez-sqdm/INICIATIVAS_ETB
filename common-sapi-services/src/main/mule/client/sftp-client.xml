	<flow name="sftp-traceabilityLogs-clientFlow" doc:id="469df19f-000e-446e-8b23-44edaeba46f7" >
        <sftp:listener doc:name="On New or Updated File TraceabilityLogger" doc:id="41020612-0dcf-40ed-a347-d357698f49b8" config-ref="SFTP_Config_TraceabilityLogs" directory="${traceabilityLogs.path}" moveToDirectory="${traceabilityLogs.path}" renameTo="#[p('traceabilityLogs.finalFileName') ++ (now() as String {format: &quot;yyyyMMddHHmmss&quot;}) ++ p('traceabilityLogs.fileFormat')]" recursive="false">
            <scheduling-strategy >
                <fixed-frequency/>
            </scheduling-strategy>
            <sftp:matcher filenamePattern="${traceabilityLogs.file}" minSize="${traceabilityLogs.fileMaxSize}"/>
        </sftp:listener>
		<logger level="INFO" doc:name="Rename" doc:id="60b64778-72d1-4d7d-ba8b-45a47272a7a5" message='#["Traceability file rename successful"]'/>
    </flow>
	<sub-flow name="post-logs-client" doc:id="88d9249f-65df-4020-8829-9d8f79812d66">
		<try doc:name="Try" doc:id="cd373ed0-d0cb-4e3b-b3a0-1c0f497df7ce" >
			<sftp:write doc:name="Write File" doc:id="2f875c3c-0c3f-4f1f-8569-690d8e538fc6" config-ref="SFTP_Config_AuditLogs" path="#[vars.filePath]" mode="#[vars.fileAction]" lock="true">
			<sftp:content><![CDATA[#[vars.fileContent]]]></sftp:content>
		</sftp:write>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="c1166d72-f7dc-4366-a18e-8aead27e03bd" type="SFTP:ILLEGAL_PATH">
					<ee:transform doc:name="Change fileAction" doc:id="09dd6bcd-741e-47c6-b19a-13b7981e2348" >
						<ee:message >
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="fileAction" ><![CDATA[%dw 2.0
output application/java
---
"CREATE_NEW"]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<flow-ref doc:name="Retry write" doc:id="2b0ff91f-f530-41b5-8450-a205e5fff056" name="post-logs-client" />
				</on-error-continue>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="d92e54a1-487a-4a65-addb-c3f92ba15296" type="SFTP:FILE_LOCK">
					<flow-ref doc:name="Go to retry JMS" doc:id="fb804239-d001-4288-aa3b-6071712151b9" name="publish-to-JMS" />
				</on-error-continue>
			</error-handler>
		</try>

	
</sub-flow>
<sub-flow name="post-traceabilityLogs-client" doc:id="d89d25e3-fb30-44f2-8eb1-9a8b7bb73ea6">
		<try doc:name="Try" doc:id="f746514a-8551-4c05-b6ed-b274b004e19e" >
			<sftp:read doc:name="Read" doc:id="43c21f3e-9f01-478c-91c1-860735593cef" config-ref="SFTP_Config_TraceabilityLogs" path="#[p('traceabilityLogs.path') ++ p('traceabilityLogs.file')]" target="checkFileExistence"/>
			<sftp:write doc:name="Write File" doc:id="1aaa19dc-e383-4f8a-aa9a-4e815b437713" config-ref="SFTP_Config_TraceabilityLogs" path="#[vars.filePath]" mode="#[vars.fileAction]" lock="true">
			<sftp:content><![CDATA[#[vars.fileContent]]]></sftp:content>
		</sftp:write>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="88907cdf-29f9-4f87-acbd-1b7e4713e9e2" type="SFTP:ILLEGAL_PATH">
					<ee:transform doc:name="Change fileAction" doc:id="c6150656-593c-4fb2-ac4a-27e7c0b7d1fe" >
						<ee:message >
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="fileAction" ><![CDATA[%dw 2.0
output application/java
---
"CREATE_NEW"]]></ee:set-variable>
							<ee:set-variable variableName="fileContent" ><![CDATA[%dw 2.0
output text/plain
---
((p('traceabilityLogs.fileHeader') splitBy ",") joinBy p('traceabilityLogs.separator')) ++ "\n" ++ vars.fileContent]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<sftp:write doc:name="Write File" doc:id="78154e71-9625-44ea-883e-f670f558faba" config-ref="SFTP_Config_TraceabilityLogs" path="#[vars.filePath]" lock="true" mode="#[vars.fileAction]" >
						<sftp:content ><![CDATA[#[vars.fileContent]]]></sftp:content>
					</sftp:write>
				</on-error-continue>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="4c6cc149-21f0-4115-955a-08f70276a52c" type="SFTP:FILE_LOCK">
					<flow-ref doc:name="Go to retry JMS" doc:id="3469c409-db66-474d-8c22-a283a1f2fb3b" name="publish-to-JMS" />
				</on-error-continue>
			</error-handler>
		</try>

	
</sub-flow>
	<sub-flow name="get-portabilityDocuments-client" doc:id="0eb5973a-896d-48d1-b18d-7d28534f932b" >
		<async doc:name="Async" doc:id="060ee1a5-5440-4212-be1c-4b6a2a16f7c1">
			<flow-ref doc:name="Call logger" doc:id="f2ac8ca4-8655-429b-8a76-eeefc36badf3" name="loggin-client-call" />
		</async>
		<sftp:read doc:name="Read" doc:id="d7b92357-33e9-4ede-aeaf-0a0925b4d522" config-ref="SFTP_Config_portability" path="#[vars.filePath]"/>
		<async doc:name="Async" doc:id="4a2be241-82f9-40a2-ad27-febdf70d2dce" >
			<flow-ref doc:name="Call logger" doc:id="9b270d5d-90b3-4b57-9513-4a736be6abcb" name="loggin-client-call" />
		</async>
	</sub-flow>
	<sub-flow name="post-portabilityDocument-client" doc:id="684311ad-c719-4346-a217-5ad8f22d2d14" >
		<async doc:name="Async" doc:id="41b5f8d1-afb2-4a82-a600-ee6dbfdd83ee" >
			<flow-ref doc:name="Call logger" doc:id="8906d7ef-0800-4ecf-b436-50c9e58090a3" name="loggin-client-call"/>
		</async>
		<sftp:write doc:name="Write" doc:id="bdb38d20-056a-4205-bf5c-19b5838da34e" config-ref="SFTP_Config_portability" path="#[vars.filePath]">
			<sftp:content ><![CDATA[#[vars.fileContent]]]></sftp:content>
		</sftp:write>
		<async doc:name="Async" doc:id="9f5bdb15-77e4-4357-8434-2c781318c551" >
			<flow-ref doc:name="Call logger" doc:id="e4974647-3f59-4130-a7f7-a5a853bbd6dd" name="loggin-client-call" />
		</async>
	</sub-flow>
	</mule>
