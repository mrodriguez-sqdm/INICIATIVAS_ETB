            <sftp:matcher filenamePattern="${sumaLogs.file}" minSize="${sumaLogs.fileMaxSize}"/>
        </sftp:listener>
        <sftp:list doc:name="List" doc:id="0e385ce5-cbbc-4d64-ac36-0421531c2a89" config-ref="SFTP_Config_AuditLogs" directoryPath="${sumaLogs.path}" target="numberOfEntries">
            <sftp:matcher filenamePattern="${sumaLogs.regex}"/>
