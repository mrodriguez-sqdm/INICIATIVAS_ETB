        <sftp:listener doc:name="On New or Updated File ConversationLogger" doc:id="c240bb02-a2b9-4d13-ae20-279f21047f47" config-ref="SFTP_Config_AuditLogs" directory="${conversationLogs.path}" moveToDirectory="${conversationLogs.path}" renameTo="#[p('conversationLogs.file') ++ &quot;.&quot; ++ sizeOf(vars.numberOfEntries)]" recursive="false">
