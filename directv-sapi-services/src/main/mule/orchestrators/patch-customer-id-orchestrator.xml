<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-customer-id-orchestrator" doc:id="9b510811-91e4-4dee-ab3d-3bd2b1ba3e56" >
		<logger level="INFO" doc:name="Log Orchestration Start" doc:id="d3927d2e-bb54-4d24-bded-7bdb5719013d" message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=PATCH /customerId"]' />
		<ee:transform doc:name="Transform Message" doc:id="faf8e86a-b36a-41bc-ac64-9a96fc58fb8d">
			<ee:variables>
				<ee:set-variable variableName="customerId"><![CDATA[attributes.uriParams.'customerId']]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="ca4d8b50-5e41-4f6f-8876-b23493e25785" >
			<when expression="#[payload.actionType == 'CancelCustomerProducts']">
				<flow-ref doc:name="post-cancelar-directv-client" doc:id="0c46e466-7bab-4485-92cb-48b9ac3629a5" name="post-cancellation-directv-orchestrator" />
			</when>
			<when expression="#[payload.actionType == 'ReconnectCustomerProduct']">
				<flow-ref doc:name="post-reconexionCustomer-directv-orchestrator" doc:id="c5ae660a-49ad-42b0-b49c-68589e4c5def" name="post-reconexionCustomer-directv-orchestrator" />
			</when>
		</choice>
		<logger level="INFO" doc:name="Log Orchestration End" doc:id="f8ca8f8f-02c1-4848-b580-6e56250b177f" message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=PATCH /customerId"]' />
	</sub-flow>
</mule>
