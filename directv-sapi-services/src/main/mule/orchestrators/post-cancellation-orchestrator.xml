<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-cancellation-directv-orchestrator" doc:id="9b510811-91e4-4dee-ab3d-3bd2b1ba3e56" >
		<!-- [STUDIO:"Log Orchestration Start"]<logger level="INFO" doc:name="Log Orchestration Start" doc:id="d3927d2e-bb54-4d24-bded-7bdb5719013d" message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=POST /cancellation"&#93;' /> [STUDIO] -->
		<flow-ref doc:name="post-token-directv-client" doc:id="9482de1a-bc55-4e21-9c4e-48595e0f00c9" name="post-token-directv-client" target="responseToken" />
		<logger level="INFO" doc:name="Logger" doc:id="0e6f6094-4829-4a78-b5e4-a214cfbd1810" message="#[vars.responseToken]"/>
		<ee:transform doc:name="set request" doc:id="f55212e5-f15c-4c69-bd35-7661e04c85eb">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  CancelCustomerProducts:
    {
      Customer: {
        ID: vars.customerId
      },
      inmediate: payload.inmediate
    }
    ++
    if (payload.actionType == "CancelCustomerProductsAmazon")
    {
      ProductCollection: {
        Product: [
          {
            productCategory: {
              id: vars.productId
            }
          }
        ]
      }
    }
    else {}
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
		<flow-ref doc:name="post-cancelar-directv-client" doc:id="0c46e466-7bab-4485-92cb-48b9ac3629a5" name="post-cancelar-directv-client" />
		<ee:transform doc:name="set response" doc:id="2f88a1c5-2561-4c5f-b359-e7840a9b2219" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Log Orchestration End" doc:id="f8ca8f8f-02c1-4848-b580-6e56250b177f" message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=POST /cancellation"]' />
	</sub-flow>
</mule>
