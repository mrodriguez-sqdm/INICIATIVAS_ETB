		<http:request config-ref="HTTP_directv_Request_Config"
			method="${directv.estadoCliente.get.method}"
			path="${directv.estadoCliente.path}" doc:name="GET /resources"
			sendCorrelationId="AUTO" responseTimeout="${directv.responseTimeout}">
			<http:headers><![CDATA[#[%dw 2.0
output application/java
---
{
    "accept": "application/json",
    "authorization": "Bearer " ++ vars.responseToken.access_token,
    "metadata-sendercountry": p("directv.sendercountry")
}]]]></http:headers>
			<http:uri-params><![CDATA[#[output application/java
---
{
	"id" : vars.customerId
}]]]></http:uri-params>
		</http:request>

		<flow-ref doc:name="auditSub_Flow" doc:id="78f6eef4-e45c-4dd4-b85f-0a5d6599831f" name="auditSub_Flow" />
