	<sub-flow name="post-token-directv-client"
		doc:id="90cdd6ec-8e96-4cb0-811c-b072621481a6">
		<logger level="INFO" doc:name="Log Request" doc:id="e63d9e90-a823-431d-9ab4-626a924f9ce5" message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /token"]' />
		<http:request method="${directv.token.post.method}"
			doc:name="POST /resources"
			doc:id="e969da4f-332e-4e0e-b34f-cade0dead31f"
			config-ref="HTTP_directv_Request_Config" path="${directv.token.path}"
			sendCorrelationId="AUTO" responseTimeout="${directv.responseTimeout}">
			<http:body><![CDATA[#[%dw 2.0
output application/x-www-form-urlencoded
---
{
  grant_type: "client_credentials"
}]]]></http:body>
			<http:headers><![CDATA[#[output application/java
---
{
    "Content-Type": "application/x-www-form-urlencoded",
    "Authorization": "Basic" ++ p('secure::directv.token.basic')
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			doc:id="10a82533-c463-402d-8b25-84e665679611"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /token"]' />
	</sub-flow>
