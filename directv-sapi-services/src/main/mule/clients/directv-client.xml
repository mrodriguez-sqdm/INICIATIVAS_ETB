<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-token-directv-client" doc:id="90cdd6ec-8e96-4cb0-811c-b072621481a6">
		<logger level="INFO" doc:name="Log Request" doc:id="e63d9e90-a823-431d-9ab4-626a924f9ce5" message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /resources"]' />
		<http:request method="${directv.token.post.method}" doc:name="POST /resources" doc:id="e969da4f-332e-4e0e-b34f-cade0dead31f" config-ref="HTTP_directv_Request_Config" path="${directv.token.path}" sendCorrelationId="AUTO" responseTimeout="${directv.responseTimeout}">
			<http:body ><![CDATA[#[%dw 2.0
output application/x-www-form-urlencoded
---
{
  grant_type: "client_credentials"
}]]]></http:body>
			<http:headers><![CDATA[#[output application/java
---
{
    "Content-Type": "application/x-www-form-urlencoded",
    "Authorization": "Basic" ++ p('secure::directv.token.basic')
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response" doc:id="10a82533-c463-402d-8b25-84e665679611" message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /resources | status=CREATED"]' />
	</sub-flow>
	<sub-flow name="get-estadoCliente-directv-client"
		doc:id="a0ad8c52-b545-4454-b69c-aa6b485e2208">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=GET /resources"]' />

		<http:request config-ref="HTTP_directv_Request_Config"
			method="${directv.estadoCliente.get.method}"
			path="${directv.estadoCliente.path}" doc:name="GET /resources" sendCorrelationId="AUTO"
			responseTimeout="${directv.responseTimeout}">
			<http:headers><![CDATA[#[%dw 2.0
output application/java
---
{
    "accept": "application/json",
    "authorization": "Bearer " ++ vars.responseToken.access_token,
    "metadata-sendercountry": p("directv.sendercountry")
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"id" : vars.customerId
}]]]></http:uri-params>
		
</http:request>

		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=GET /resources | status=OK"]' />
	</sub-flow>
