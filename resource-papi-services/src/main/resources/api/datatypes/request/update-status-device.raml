#%RAML 1.0 DataType 
type: object
properties:
  device:
    type: object
    properties:
      mac:
        type: string
        example: AA:BB:CC:DD:EE:FF
        required: true
      serviceAccount:
        type: string
        example: '6001234567'
        required: true
      serial:
        type: string
        example: ZTEGC1234567
        required: false
      state:
        type: boolean
        example: true
        required: true
