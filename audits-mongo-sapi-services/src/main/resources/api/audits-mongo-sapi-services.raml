#%RAML 1.0
title: audits-mongo-sapi-services
baseUri: audits-mongo-sapi-services-{env}.us-e2.cloudhub.io/audits
traits:
  common-headers: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml

/v1:
  /logs:
    is: [common-headers]
    displayName: Logging Service
    description: Service to save the traceability in ETB API enviroment
    /apis/{api_id}:
      uriParameters:
        api_id:
          type: string
          description: This subresource describe the source of the log  
          example:
            sap-sapi-services
      post:
        body:
          application/json:
            type: any
        responses:
          201:
            description: Created
            body:
              application/json: 
                type: any
          400:
            description: Bad request
          401:
            description: Not authorized.
            