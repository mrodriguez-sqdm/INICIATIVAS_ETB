#%RAML 1.0 DataType
type: object
properties:
  doCompletarOrdenInventario:
    type: object
    properties:
      PeticionCompletarOrdenInventario:
        type: object
        properties:
          EncabezadoMensaje:
            type: object
            properties:
              IdDisponibilidad: string
              NumeroOrdenAprovisionador: string
              NumeroRevision: number
              FechaPeticionOrden: string
              TecnologiaETB: string
          DetalleMensaje:
            type: object
            properties:
              CuentasServicio:
                type: object
                properties:
                  CuentaServicio:
                    type: array
                    items:
                      type: object
                      properties:
                        IdCuentaServicio: string
                        ServiciosCompletar:
                          type: array
                          items:
                            type: object
                            properties:
                              IdServicio: string
                              Accion: string
                              Equipos:
                                type: array
                                items:
                                  type: object
                                  properties:
                                    IdServicio:
                                      type: string
                                      required: false
                                    SerialEquipo: string
                                    MacEquipo: string
                                    EstadoEquipo: string
                                    Accion: string
                                    Puertos:
                                      type: array
                                      items:
                                        type: object
                                        properties:
                                          NombrePuerto: string
                                          ServiciosPuerto:
                                            type: object
                                            properties:
                                              IdServicioPuerto: string
                  Origen: string