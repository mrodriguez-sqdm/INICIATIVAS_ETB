#%RAML 1.0 DataType
type: object
properties:
  doValidarEquiposPremisaInstalar:
    type: object
    properties:
      PeticionValidarEquiposPremisaInstalar:
        type: object
        properties:
          EncabezadoMensaje:
            type: object
            properties:
              IdDisponibilidad: string
              NumeroOrdenAprovisionador: string
              NumeroRevision: number
              FechaPeticionOrden: string
              TecnologiaETB: string
          DetalleMensaje:
            type: object
            properties:
              Direccion:
                type: object
                properties:
                  CodigoUnicoDireccion: string
                  IdCuentaServicio: string
                  Equipos:
                    type: array
                    items:
                      type: object
                      properties:
                        IdServicio:
                          type: string
                          required: false
                        SerialEquipo: string
                        MacEquipo: string
                        Puertos:
                          type: array
                          items:
                            type: object
                            properties:
                              NombrePuerto: string
                              ServiciosPuerto:
                                type: object
                                properties:
                                  IdServicioPuerto: string
                        EquipoInstalado: string