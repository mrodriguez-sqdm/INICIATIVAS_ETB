#%RAML 1.0 DataType
type: object
properties:
  CEDULA:
    type: string
    example: "123456"
  NOMBRES:
    type: string
    example: "JUAN"
  APELLIDOS:
    type: string
    example: "PEREZ"
  CARGO:
    type: string
    example: "ANALISTA"
  CORREO:
    type: string
    example: "juan.perez@etb.com.co"
  CENTRO_COSTO:
    type: string
    example: "CENTRO DE COSTOS TI"
  COD_FREP:
    type: number
    example: 987654
  VICEPRESIDENCIA:
    type: string
    example: "VICEPRESIDENCIA TECNOLOGIA"
  CLASE_DE_NOMINA:
    type: number
    example: 1
  FECHA_INICIO:
    type: string
    example: "2020-01-15T00:00:00"
