#%RAML 1.0 DataType
type: object
description: Respuesta estándar de validación de equipos en premisa para instalación.

properties:

  cod_res:
    type: string
    description: Código de resultado de la operación.
    example: "200"
  res:
    type: string
    description: Mensaje descriptivo del resultado.
    example: "Validación de equipo exitosa."
  objValidacionEquipo:
    type: object
    required: false
    description: Resultado de la validación del equipo en premisa.
    properties:

      header:
        type: object
        description: Información de encabezado de la petición.
        properties:
          availabilityId:
            type: string
            example: "MDM-FIBRA-000138871"
          provisioningOrderId:
            type: string
            example: "MDM-FIBRA-000138871"
          revisionNumber:
            type: integer
            example: 1
          requestDate:
            type: datetime
            example: "2026-04-22T09:06:20.020-05:00"
      data:
        type: object
        description: Información del equipo validado.
        properties:
          equipment:
            type: object
            properties:
              brand:
                type: string
                example: "ZTE"
              serviceId?:
                type: string
                description: Identificador del servicio asociado (puede venir vacío).
              obsolescenceIndicator:
                type: string
                example: "NO"
              serialNumber:
                type: string
                example: "ZTEQA066TJ3L"
              macAddress:
                type: string
                example: "AAAAAAAAA141"
              equipmentType:
                type: string
                example: "CPE-ONT"
              model:
                type: string
                example: "ZTE-F660"
              version:
                type: string
                example: "MODELOZTE"
              compatibilityIndicator:
                type: string
                example: "SI"
              compatibilityResponse?:
                type: string
                description: Respuesta adicional de compatibilidad (puede venir vacío).
              attributes:
                type: array
                description: Lista de atributos del equipo.
                items:
                  type: object
                  properties:
                    name:
                      type: string
                      example: "terminalID"
                    value:
                      type: string
                      example: "344758"