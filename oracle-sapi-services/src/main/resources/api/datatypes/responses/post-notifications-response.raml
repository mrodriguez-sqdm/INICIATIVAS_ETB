#%RAML 1.0 DataType
displayName: Notification Response
description:  This is the Responsts data that will be returned after a notification is sent.
example: !include ../../examples/response/post-notifications-response.json
type: object
properties:
  status:
    type: string
    required: true
    description: HTTP-like status code of the operation
    example: "201"
  message:
    type: string
    required: true
    description: Human-readable message describing the result
    example: "Notification Sent Successfully"
  result:
    type: object
    required: true
    properties:
      success:
        type: boolean
        required: true
        description: Indicates if the notification was successfully processed
        example: true
      recipientId:
        type: integer
        required: false
        description: Internal identifier of the recipient
        example: 72067
      externalMessageId:
        type: string
        required: false
        description: Identifier generated by the external system (Responsys)
        example: "msg-responsys-9988776"
      errorCode?:
        type: string
        required: false
        description: Error code returned in case of failure
        example: "NO_RECIPIENT_FOUND"
      errorDetail?:
        type: string
        required: false
        description: Detailed error message
        example: "Mobile number not found in profile list"
      retryCount:
        type: integer
        required: true
        description: Number of retry attempts performed
        example: 0