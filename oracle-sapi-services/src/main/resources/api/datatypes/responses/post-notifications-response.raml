#%RAML 1.0 DataType
displayName: Notification Response
description:  This is the Responsts data that will be returned after a notification is sent.
example: !include ../../examples/response/post-notifications-response.json
type: object
properties:
  status:
    type: string
    required: true
    description: HTTP-like status code of the operation
    example: "201"
  message:
    type: string
    required: true
    description: Human-readable message describing the result
    example: "Notification Sent Successfully"
  result:
    type: object
    required: true
    properties:
      success:
        type: boolean
        required: true
        description: Indicates if the notification was successfully processed
        example: true
      recipientId:
        type: integer
        required: false
        description: Internal identifier of the recipient
        example: 72067
      errorMessage?:
        type: string
        required: false
        description: Error message returned in case of failure
        example: "NO_RECIPIENT_FOUND"