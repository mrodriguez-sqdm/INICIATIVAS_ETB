#%RAML 1.0 DataType
type: object
properties:
  cod_res:
    type: string
    description: Código de resultado de la operación.
    example: "200"
  res:
    type: string
    description: Mensaje descriptivo del resultado.
    example: "Consulta exitosa."
  doValidarEquiposPremisaInstalarResponse:
    type: object
    properties:
      RespuestaPeticionValidarEquiposPremisaInstalar:
        type: object
        properties:
          EncabezadoMensaje:
            type: object
            properties:
              IdDisponibilidad: string
              NumeroOrdenAprovisionador: string
              NumeroRevision: number
              FechaPeticionOrden: string
          DetalleMensaje:
            type: object
            properties:
              Equipo:
                type: object
                properties:
                  MarcaEquipo: string
                  IdServicio:
                    type: string
                    required: false
                  IndicadorObsolescencia: string
                  SerialEquipo: string
                  MacEquipo: string
                  TipoEquipo: string
                  ModeloEquipo: string
                  IndicadorCompatibilidad: string
                  RespuestaCompatibilidad:
                    type: string
                    required: false
                  Atributos:
                    type: array
                    items:
                      type: object
                      properties:
                        Atributo: string
                        Valor: string