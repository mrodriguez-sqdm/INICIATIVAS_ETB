#%RAML 1.0 DataType
type: object
properties:
  cod_res:
    type: string
    description: Código de resultado de la operación.
    example: "200"
  res:
    type: string
    description: Mensaje descriptivo del resultado.
    example: "Consulta exitosa."
  doCompletarOrdenInventarioResponse:
    type: object
    properties:
      RespuestaPeticionCompletarOrdenInventario:
        type: object
        properties:
          EncabezadoMensaje:
            type: object
            properties:
              IdDisponibilidad: string
              NumeroOrdenAprovisionador: string
              NumeroRevision: number
              FechaPeticionOrden: string
              TecnologiaETB: string