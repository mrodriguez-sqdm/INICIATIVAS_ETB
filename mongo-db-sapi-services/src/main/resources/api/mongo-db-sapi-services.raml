  ##MDM_VALIDACION_CLIENTE##
  /identity:
    /validation:
      get:
        is: [security_client_id,request_headers]
        displayName: Get Identity Validation
        description: Realiza consulta de validacion de identidad de un cliente en MDM_VALIDACION_CLIENTE
        queryParameters:
          documentType:
            type: string
            example: "1"
            required: true
          documentNumber:
            type: string
            example: "1235367"
            required: true
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-identity-client.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml               
      post:
        is: [security_client_id,request_headers]
        displayName: Post Identity Validation
        description: Crea un registro de validacion de identidad de un cliente en MDM_VALIDACION_CLIENTE
        body:
          application/json:
            type: !include /datatypes/requests/post-identity-client.raml
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/post-identity-client.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
      /{documentType}/{documentNumber}:
        uriParameters:
          documentType:
            type: string
            example: "CC"
          documentNumber:
            type: string
            example: "6578930302"
        patch:
          is: [security_client_id,request_headers]
          displayName: Patch Identity Validation
          description: Actualiza un registro de validacion de identidad de un cliente en MDM_VALIDACION_CLIENTE
          body:
            application/json:
              type: !include /datatypes/requests/patch-identity-client.raml
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/responses/patch-identity-client.raml
            404:
              body:
                application/json:
                  type: !include /datatypes/responses/error.raml
            500:
              body:
                application/json:
                  type: !include /datatypes/responses/error.raml

  ##MDM_SCORE_ASIGNACION_VARIABLES##
  /score:
    /variables:
      get:
        is: [security_client_id,request_headers]
        displayName: Get Score Variables
        description: Realiza consulta de validacion de variables de score en MDM_SCORE_ASIGNACION_VARIABLES
        queryParameters:
          technology:
            type: string
            description: Technology type
            enum:
              - LTE
              - FIJA
            required: true
            example: "LTE"
          segment:
            type: string
            description: Market Segment 
            enum:
              - Hogares
              - MiPymes
            required: true
            example: "Hogares"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-score-variables.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
  ##MDM_SCORE_GEOREFERENCIACION##
    /georeference:
      get:
        is: [security_client_id,request_headers]
        displayName: Get Score Geroreference
        description: Realiza consulta de valores de score en MDM_SCORE_GEOREFERENCIACION
        queryParameters:
          tableNumber:
            type: string
            description: Table number
            required: true
            example: "4"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-score-georeference.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
