  ##PQR DUPLICIDAD Y VALIDACION PARENT##
  /pqrs:
    post:
      is: [security_client_id,request_headers]
      displayName: Post PQR
      description: Crea PQR dentro de mongo PRQ_PQR
      body:
        application/json:
          type: !include /datatypes/requests/post-pqr.raml
      responses:
        201:
          body:
            application/json:
              type: !include /datatypes/responses/post-pqr.raml
        404:
          body:
            application/json:
              type: !include /datatypes/responses/error.raml
        500:
          body:
            application/json:
              type: !include /datatypes/responses/error.raml
    /categories:
      get:
        is: [security_client_id,request_headers]
        displayName: Get PQR Types
        description: Realiza consulta de tipologias de PQR en PQR_TIPOLOGIA
        queryParameters:
          botRequest:
            type: string
            description: Peticion hecha a bot
            required: false
            example: "FALLA_INTERNET"
          causal:
            type: string
            description: Causal de falla
            required: false
            example: "FALLA_TECNICA"
          class:
            type: string
            description: Clase de falla
            required: false
            example: "INTERNET"
          reason:
            type: string
            description: Razon de falla
            required: false
            example: "FALLA TECNICA"
          symptom:
            type: string
            description: sintomas de falla
            required: false
            example: "SIN_CONEXION"
          product:
            type: string
            description: Producto relacionado a la falla
            required: false
            example: "INTERNET_FIBRA"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-pqrs-categories.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
    /duplicates:
      get:
        is: [security_client_id,request_headers]
        displayName: Get PQR Types
        description: Realiza consulta de tipologias de PQR en PQR_TIPOLOGIA
        queryParameters:
          documentType:
            type: string
            description: Tipo de documento
            required: false
            example: "CC"
          documentNumber:
            type: string
            description: Numero de documento
            required: false
            example: "987654321"
          causal:
            type: string
            description: Causal de falla
            required: false
            example: "FALLA_TECNICA"
          class:
            type: string
            description: Clase de falla
            required: false
            example: "INTERNET"
          reason:
            type: string
            description: Razon de falla
            required: false
            example: "FALLA TECNICA"
          symptom:
            type: string
            description: sintomas de falla
            required: false
            example: "SIN_CONEXION"
          state:
            type: string
            description: status de la pqr
            required: false
            example: "ABIERTA"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-pqrs-duplicates.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
    /parents:
      get:
        is: [security_client_id,request_headers]
        displayName: Get PQR Types
        description: Realiza consulta de tipologias de PQR en PQR_TIPOLOGIA
        queryParameters:
          serviceAccount:
            type: string
            description: Cuenta de servicio
            required: false
            example: "21354689"
          reason:
            type: string
            description: Razon de falla
            required: false
            example: "FALLA TECNICA"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-pqrs-parents.raml
          404:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
          500:
            body:
              application/json:
                type: !include /datatypes/responses/error.raml
