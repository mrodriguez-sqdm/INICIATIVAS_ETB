#%RAML 1.0 DataType
displayName: Notifications Audit Update Request
description: Represents a notification audit record update with notification and audit details .
example: !include ../../examples/request/patch-notification-audit-request.json
type: object
properties:
  updatedDate?: 
    type: string
    description: Notification updated date in audit collection
    example: '2026-03-05T10:30:00Z'
  notificationId?:
    type: string
    description: Notification ID from the provider
    example: "3068"
  state?:
    type: string
    description: The current state of the message.
    enum: [initial, inProgress, completed, cancelled, failed]
    example: completed