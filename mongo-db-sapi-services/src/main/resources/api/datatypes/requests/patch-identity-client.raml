#%RAML 1.0 DataType 
type: object
properties:
  apellido?:
    type: string
    example: "Perez"
    required: false
  fecha_exp?:
    type: datetime
    example: "2018-06-01T05:00:00.000Z"
    required: false
  num_doc?:
    type: string
    example: "51225"
    required: false
  tipo_doc?:
    type: string
    example: "CC"
    required: false
  fecha_consulta?:
    type: date-only
    example: "2026-01-18"
    required: false
  nombres?:
    type: string
    example: "Pablo"
    required: false
  segundo_apellido?:
    type: string
    example: "Pereira"
    required: false
  estado?:
    type: string
    enum:
      - VIGENTE
      - NO VIGENTE
    example: "VIGENTE"
    required: false
  causal?:
    type: string
    example: "VALIDACION OBTENIDA EXITOSAMENTE"
    required: false
  estado_financiacion?:
    type: string
    example: "estado financiacion"
    required: false
  porcentaje_financiacion?:
    type: string
    example: "85"
    required: false
  razon_estado?:
    type: string
    example: "razon estado"
    required: false
  score_fija?:
    type: object
    properties:
      Valor?:
        type: string
        example: "995"
        required: false
      Fecha?:
        type: date-only
        example: "2026-08-08"
        required: false
  score_movil?:
    type: object
    properties:
      Valor?:
        type: string
        example: "995"
        required: false
      Fecha?:
        type: date-only
        example: "2026-08-08"
        required: false
example: !include ../../examples/request/patch-identity-client.json