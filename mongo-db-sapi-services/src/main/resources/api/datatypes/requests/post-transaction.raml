#%RAML 1.0 DataType
type: object
properties:
  id_transaccion:
    type: string
    example: TX-30001
    required: true
  CUS:
    type: string
    example: link_prod_8f3b9c2a1d
    required: false
  atributos_pasarela:
    type: object
    properties:
      pasarela:
        type: string
        example: WOMPI
        required: false
      tipo_pasarela:
        type: string
        example: API
        required: false
  metodo_pago:
    type: string
    example: CARD
    required: false
  referencias:
    type: object
    properties:
      referencia:
        type: string
        example: ORDER-2024-002
        required: true
      descripcion:
        type: string
        example: Pago consolidado servicios
        required: false
      moneda:
        type: string
        example: COP
        required: true
      valor_pagar:
        type: string
        example: '120000'
        required: false
      impuestos:
        type: array
        items:
          type: object
          properties:
            tipo:
              type: string
              example: IVA
              required: false
            porcentaje:
              type: integer
              example: 19
              required: false
            valor:
              type: string
              example: '19000'
              required: false
      detalle_referencias:
        type: array
        items:
          type: object
          properties:
            referencia:
              type: string
              example: FAC-1001
              required: false
            descripcion:
              type: string
              example: Internet service payment
              required: false
            moneda:
              type: string
              example: COP
              required: false
            valor_pagar:
              type: string
              example: '60000'
              required: false
            impuestos:
              type: array
              items:
                type: object
                properties:
                  tipo:
                    type: string
                    example: IVA
                    required: false
                  porcentaje:
                    type: integer
                    example: 19
                    required: false
                  valor:
                    type: string
                    example: '11400'
                    required: false
  cliente:
    type: object
    properties:
      tipo_documento:
        type: string
        example: CC
        required: false
      numero_documento:
        type: string
        example: '111111111'
        required: false
      nombre_completo:
        type: string
        example: Juan Perez
        required: false
      correo:
        type: string
        example: juan@email.com
        required: false
      telefono:
        type: string
        example: '3000000000'
        required: false
  concepto:
    type: string
    example: Pago consolidado servicios
    required: false
  entidad_bancaria:
    type: string
    example: BANCOLOMBIA
    required: false
  estado_transaccion:
    type: string
    example: PENDIENTE
    required: true
  fecha_registro:
    type: string
    example: '2026-03-05T10:30:00Z'
    required: false
  fecha_respuesta_pasarela:
    type: string
    example: '2026-03-05T10:30:00Z'
    required: false
  fecha_actualizacion:
    type: string
    example: '2026-03-05T10:30:00Z'
    required: false