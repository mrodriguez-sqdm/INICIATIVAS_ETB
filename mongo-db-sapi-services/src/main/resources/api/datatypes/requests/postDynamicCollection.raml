#%RAML 1.0 DataType
displayName: Post a Dynamic Object
type: object
properties:
  fields:
    type: array
    items:
      type: string
    required: true
    description: >
      An array of objects, where each object represents a field to be inserted or updated in the document.
    example:
      [
      "Estatura",
      "Peso",
      "EstadoCivil",
      "DirResidencia"
      ]
  filters:
    type: array
    items:
      type: object
      properties:
        field:
          type: string
          description: The name of the field you want to filter by.
        operator?:
          type: string
          enum:
            - eq
            - in
          default: eq
        value:
          type: any
          description: El valor para el filtro.
    required: true
    description: >
      An array of objects, where each object represents a filter for the query
    example:
      [
        { "field": "EstadoCivil", "operator": "eq", "value": "Casado" },
        { "field": "Profesion", "operator": "eq", "value": "Ing de Sistemas" },
        { "field": "Cargo", "operator": "eq", "value": "Desarrollador" }
      ]
  limit?:
    type: integer
    example: 10
      
    