#%RAML 1.0 DataType
description: Tipo de dato para una PQR
type: object
properties:
  actualizacion_extractor:
    type: string
    description: Fecha de actualización del extractor (formato DD/MM/YYYY)
    example: "22/04/2018"
  row_id_pqr:
    type: string
    description: Identificador de fila único de la PQR
    example: "MDM-PQR-19828"
  numero_pqr:
    type: string
    description: Número único de la PQR
    example: "MDM-PQR-19828"
  tipo_documento:
    type: string
    description: Tipo de documento del cliente (ej. NIT, CC, CE)
    example: "NIT"
  numero_identificacion:
    type: string
    description: Número de identificación del cliente
    example: "899999061"
  contacto_tipo_documento:
    type: string
    description: Tipo de documento del contacto
    example: "CC"
  contacto_numero_documento:
    type: string
    description: Número de documento del contacto
    example: "52108502"
  id_servicio:
    type: string
    description: Identificador del servicio asociado
    required: false
  numero_conexion:
    type: string
    description: Número de conexión del servicio
    required: false
  cuenta_servicio:
    type: string
    description: Cuenta del servicio
    required: false
  cuenta_facturacion:
    type: string
    description: Cuenta de facturación
    required: false
  producto:
    type: string
    description: Producto asociado a la PQR
    example: "NINGUNO"
  numnumero_pedido:
    type: string
    description: Número de pedido relacionado
    required: false
  pqr_reclamo_pqr:
    type: string
    description: Referencia interna del reclamo PQR
    required: false
  tipo_pqr_reclamo:
    type: string
    description: Tipo de reclamo de la PQR
    required: false
  cun:
    type: string
    description: Código Único de Notificación (CUN)
    example: "4347170004574581"
  servicio:
    type: string
    description: Descripción del servicio
    required: false
  tecnologia:
    type: string
    description: Tecnología del servicio
    required: false
  tipo_pqr:
    type: string
    description: Tipo de PQR
    example: "NINGUNO"
  clase_pqr:
    type: string
    description: Clase de la PQR (ej. PETICION, QUEJA, RECLAMO)
    example: "PETICION"
  motivo_pqr:
    type: string
    description: Motivo de la PQR
    example: "RECLAMO INTERNO"
  causal_pqr:
    type: string
    description: Causal que originó la PQR
    example: "PREVENTIVO"
  urgencia_pqr:
    type: string
    description: Nivel de urgencia de la PQR
    required: false
  impacto:
    type: string
    description: Impacto de la PQR
    required: false
  sintoma_pqr:
    type: string
    description: Síntoma o descripción técnica de la PQR
    example: "NAP MANTENIMIENTO"
  valor_reclamado:
    type: string
    description: Valor monetario reclamado
    example: "0"
  valor_ajustado:
    type: string
    description: Valor monetario ajustado tras análisis
    example: "0"
  fecha_creacion:
    type: string
    description: Fecha y hora de creación de la PQR (ISO 8601)
    example: "2017-12-28T21:29:23.000Z"
  fecha_radicacion:
    type: string
    description: Fecha y hora de radicación de la PQR (ISO 8601)
    example: "2017-12-12T21:38:00.000Z"
  fecha_solucion:
    type: string
    description: Fecha y hora de solución de la PQR (ISO 8601)
    example: "2018-01-04T20:26:53.000Z"
  solucion:
    type: string
    description: Texto con la solución o respuesta otorgada a la PQR
    required: false
  imputabilidad:
    type: string
    description: Imputabilidad de la falla o caso
    required: false
  estado_pqr:
    type: string
    description: Estado actual de la PQR (ej. Cerrado, Abierto, En gestión)
    example: "Cerrado"
  estado_envio_remedy:
    type: string
    description: Estado de envío a la herramienta Remedy
    required: false
  Tipo_cierre:
    type: string
    description: Tipo de cierre de la PQR
    example: "ACCEDE PARCIALMENTE"
  medio_notificacion_pqr:
    type: string
    description: Medio utilizado para notificar al cliente
    example: "CORREO ORDINARIO"
  medio_recepcion:
    type: string
    description: Medio por el cual fue recibida la PQR
    example: "Virtual/Correo electrónico"
  descripcion_pqr:
    type: string
    description: Descripción detallada de la PQR ingresada por el cliente
    required: false
  respuesta_pqr:
    type: string
    description: Respuesta formal emitida al cliente
    required: false
  num_incidendia_remedy:
    type: string
    description: Número de incidencia en Remedy
    required: false
  respuesta_remedy:
    type: string
    description: Respuesta generada desde Remedy
    required: false
  id_sistema_origen:
    type: string
    description: Identificador del sistema de origen de la PQR
    example: "MDM_PQR"
  sistema_origen:
    type: string
    description: Nombre del sistema de origen
    required: false
  lsp_origen_llamada:
    type: string
    description: LSP de origen de la llamada
    required: false
  lsp_tercer_destino:
    type: string
    description: LSP de tercer destino
    required: false
  indicador_pqr_completa:
    type: string
    description: Indicador de si la PQR está completa
    required: false
  correo_electronico:
    type: string
    description: Correo electrónico del cliente o contacto
    required: false
  cun_falla_masiva:
    type: string
    description: CUN asociado a falla masiva relacionada
    required: false
  direccion_notificacion_escrita:
    type: string | nil
    description: Dirección física para notificación escrita
    required: false
  radicado_externo:
    type: string
    description: Número de radicado en entidad externa (ej. Alcaldía)
    example: "2873232017"
  flag_recurso_apelacion:
    type: boolean
    description: Indica si la PQR tiene recurso de apelación
    example: false
  flag_traslado_gobierno:
    type: boolean
    description: Indica si la PQR fue trasladada a una entidad de gobierno
    example: false
  flag_reapertura:
    type: boolean
    description: Indica si la PQR fue reabierta
    example: false
  prioridad:
    type: string
    description: Prioridad asignada a la PQR
    required: false
  usuario_creador:
    type: string
    description: Usuario que creó la PQR en el sistema
    example: "luismart"
  usuario_asignado:
    type: string
    description: Usuario actualmente asignado para gestionar la PQR
    example: "sandvasl"
  comentarios:
    type: string
    description: Comentarios adicionales sobre la PQR
    required: false
  nombre_cliente:
    type: string
    description: Nombre completo o razón social del cliente
    example: "INSTITUTO DISTRITAL DE PROTECCIÓN Y BIENESTAR ANIMAL IDPYBA"
  segmento_cliente:
    type: string
    description: Segmento al que pertenece el cliente
    required: false
  codigo_resolucion:
    type: string | nil
    description: Código de la resolución aplicada
    required: false
  descripcion_resolucion:
    type: string | nil
    description: Descripción de la resolución aplicada
    required: false
  subcanal:
    type: string
    description: Subcanal por el que se recibió la PQR
    example: "AREAS DE APOYO"
  punto:
    type: string
    description: Punto de atención o filtro de la PQR
    example: "FILTRO"
  proveedor:
    type: string
    description: Proveedor o empresa gestora del caso
    example: "DIGITEX"
  gerencia:
    type: string
    description: Gerencia responsable de la PQR
    example: "GERENCIA EXPERIENCIA AL CLIENTE"
  semaforo:
    type: string
    description: Indicador de color de semáforo de gestión (rojo, amarillo, verde)
    example: "rojo"
  dias_habiles:
    type: string
    description: Número de días hábiles para gestión de la PQR
    example: "15"
  Fecha_Inicio_Espera:
    type: datetime | nil
    description: Fecha de inicio del período de espera
    required: false
  Fecha_Fin_Espera:
    type: datetime | nil
    description: Fecha de fin del período de espera
    required: false
  cun_relacionado:
    type: string
    description: CUN de otra PQR relacionada
    required: false
  nombre_contacto:
    type: string
    description: Nombre de la persona de contacto del cliente
    example: "RUBIELA REYES"
  canal_recepcion:
    type: string
    description: Canal por el que fue recibida la PQR
    example: "ESCRITA"
  version_pqr:
    type: string
    description: Versión de la PQR
    example: "1"
  flag_notificacion:
    type: boolean
    description: Indica si se ha enviado notificación al cliente
    example: false
  flag_fallaJoven:
    type: boolean
    description: Indica si la PQR corresponde a una falla joven
    example: false
  tipo_falla:
    type: string
    description: Tipo de falla asociada a la PQR (ej. LOGICA, FISICA)
    example: "LOGICA"
  pqr_extensiones:
    type: array
    description: Lista de extensiones o PQRs hijas relacionadas
    items:
      type: object
    required: false
  pqr_archivos_adjuntos:
    type: array
    description: Lista de archivos adjuntos asociados a la PQR
    items:
      type: object
      properties:
        archivo_adjunto:
          type: string
          description: Nombre del archivo adjunto
          example: "MDM-PQR-19828.pdf"
  pqr_actividades_pqr:
    type: array
    description: Lista de actividades o gestiones realizadas sobre la PQR
    items:
      type: object
      properties:
        actualizacion_extractor:
          type: string
          description: Fecha de actualización del extractor (formato DD/MM/YYYY)
          example: "08/03/2018"
        row_id_actividad:
          type: string
          description: Identificador único de la actividad
          example: "MDM-PQR-ACT-43333"
        nombre_actividad:
          type: string
          description: Nombre de la actividad realizada
          example: "NOTIFICACION"
        estado_actividad:
          type: string
          description: Estado actual de la actividad
          example: "Cerrado"
        comentarios:
          type: string
          description: Comentarios sobre la actividad
          required: false
        descripcion:
          type: string
          description: Descripción de la actividad
          required: false
        gestion:
          type: string
          description: Tipo de gestión realizada
          example: "SIN NOTIFICAR"
        descripcion_gestion:
          type: string
          description: Descripción detallada de la gestión
          example: "SIN TEXTO"
        grupo_actividad:
          type: string
          description: Grupo al que pertenece la actividad
          example: "SIN NOTIFICAR"
        usuario_asignado:
          type: string
          description: Usuario asignado a la actividad
          example: "luismart"
        usuario_creador_actividad:
          type: string
          description: Usuario que creó la actividad
          example: "luismart"
        fecha_inicio_actividad:
          type: datetime
          description: Fecha y hora de inicio de la actividad (ISO 8601)
          example: "2017-12-28T21:38:40.000Z"
        fecha_estado_actual:
          type: datetime
          description: Fecha y hora del estado actual de la actividad (ISO 8601)
          example: "2018-01-05T21:38:40.000Z"
        fecha_vencimiento_actividad:
          type: datetime
          description: Fecha y hora de vencimiento de la actividad (ISO 8601)
          example: "2018-01-05T21:38:40.000Z"
        final:
          type: string
          description: Indicador de cierre final
          required: false
        prioridad:
          type: string
          description: Prioridad de la actividad
          required: false
        fecha_desconexion:
          type: string
          description: Fecha de desconexión del servicio
          required: false
        fecha_reconexion:
          type: string
          description: Fecha de reconexión del servicio
          required: false
        duracion:
          type: string
          description: Duración total de la actividad
          required: false
        cuenta:
          type: string
          description: Cuenta asociada a la actividad
          required: false
        notificacion:
          type: string
          description: Indicador de notificación de la actividad
          required: false
        semaforo:
          type: string
          description: Color de semáforo de la actividad
          example: "rojo"
        dias_habiles:
          type: string
          description: Días hábiles para la actividad
          example: "5"
        actividades_adjuntas:
          type: array
          description: Sub-actividades o adjuntos de la actividad
          items:
            type: object
          required: false
example: !include ../../examples/request/post-pqr.json