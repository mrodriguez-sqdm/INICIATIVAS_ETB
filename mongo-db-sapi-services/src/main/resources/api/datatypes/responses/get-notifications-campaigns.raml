#%RAML 1.0 DataType
type: object
additionalProperties: false
properties:
  status: string
  message: string
  result:
    type: object
    properties:
      _id:
        type: object
        additionalProperties: false
        properties:
          "$oid": string
      nombre: string
      estado:
        type: string
        enum: [ACTIVO]
      usuario_creacion: string
      usuario_modificacion: string
      fecha_creacion:
        type: object
        additionalProperties: false
        properties:
          "$date": datetime
      fecha_modificacion:
        type: object
        additionalProperties: false
        properties:
          "$date": datetime
      descripcion: string
      valor:
        type: array
        minItems: 0
        items:
          type: object
          additionalProperties: false
          properties:
            campaignId: string
            campaignName: string
            channel:
              type: string
              enum: [EMAIL, SMS, WHATSAPP]
            provider:
              type: string
              enum: [RESPONSYS, PAU]
            status:
              type: string
              enum: [ACTIVE, INACTIVE]
            description: string
            responsysConfig?:
              type: object
              additionalProperties: false
              properties:
                campaignName: string
                folderName: string
                listObjectName: string
                campaignType:
                  type: string
                  enum: [EMAIL, SMS]
            pauConfig?:
              type: object
              additionalProperties: false
              properties:
                templateName: string
                templateLanguage: string
                phoneNumberId: string
            senderDefaults:
              type: object
              additionalProperties: false
              properties:
                email: string | nil
                phoneNumber: string | nil
                name: string
                documentNumber: string
                documentType: string
            defaultVariables:
              type: array
              minItems: 0
              items:
                type: object
                additionalProperties: false
                properties:
                  name: string
                  value: string
                  overridable: boolean
        
example: !include ../../examples/responses/get-notifications-campaigns.json