#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: "200"
    required: false
  message:
    type: string
    example: "Consulta realizada con exito"
    required: false
  pqrCategory?:
    type: array
    items:
      type: object
      properties:
        _id:
          type: object
          properties:
            $oid:
              type: string
              example: "5a055cabc128ff8eddb35d60"
              required: false
        clase?:
          type: string
          example: "QUEJA"
          required: false
        motivo?:
          type: string
          example: "CALIDAD/ COBERTURA DE SERVICIO"
          required: false
        actividad?:
          type: string
          example: "ACTIVIDADES MANUALES/AUTOMATICAS/SEMIAUTOMATICAS SEGÚN RM"
          required: false
        cun?:
          type: string
          example: "SI"
          required: false
        remedy?:
          type: string
          example: "NO"
          required: false
        portal?:
          type: string
          example: "NO"
          required: false
        pedido?:
          type: string
          example: "SI"
          required: false
        queja?:
          type: string
          example: "NO"
          required: false
        motivo_tecnico?:
          type: string
          example: "NO"
          required: false
        tecnologia?:
          type: string
          example: "FO"
          required: false
        producto?:
          type: string
          example: "AGILE"
          required: false
        causal?:
          type: string
          example: "NO DISPONIBILIDAD DEL SERVICIO"
          required: false
        sintoma?:
          type: string
          example: "N/A"
          required: false
        estado?:
          type: string
          example: "ACTIVO"
          required: false
        version?:
          type: integer
          example: 1
          required: false
        fecha_modificacion?:
          type: string
          example: ""
          required: false
        fecha_inicio?:
          type: string
          example: ""
          required: false
        fecha_fin?:
          type: string
          example: ""
          required: false

example: !include ../../examples/responses/get-pqrs-categories.json