#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: "200"
    required: false
  message:
    type: string
    example: "Consulta realizada con exito"
    required: false
  botSystem?:
    type: array
    items:
      type: object
      properties:
        _id:
          type: object
          properties:
            $oid:
              type: string
              example: "5a055cabc128ff8eddb35d60"
              required: false
        Sistema_Origen?:
          type: string
          example: "PQR_WEB"
          required: false
        Sistema_Destino?:
          type: string
          example: "PQR_WEB"
          required: false
        Usuario?:
          type: string
          example: "PortalLTE"
          required: false
        Canal_PQR?:
          type: string
          example: "Digital"
          required: false
        SubCanal_PQR?:
          type: string
          example: "Pagina Web"
          required: false
        Punto_PQR?:
          type: string
          example: "Autogestion"
          required: false
        Medio_Atencion_PQR?:
          type: string
          example: "Pagina Web"
          required: false
        Usuario_Promocion?:
          type: string
          example: "Ecommerce"
          required: false
        Medio_Notificacion_PQR?:
          type: string
          example: "CORREO ELECTRONICO"
          required: false

example: !include ../../examples/responses/get-bots-systems.json