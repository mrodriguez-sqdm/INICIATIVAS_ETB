#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: "200"
    required: false
  message:
    type: string
    example: "Consulta realizada con exito"
    required: false
  pqrDuplicate?:
    type: array
    items:
      type: object
      properties:
        _id:
          type: object
          properties:
            $oid:
              type: string
              example: "5a055cabc128ff8eddb35d60"
              required: false
        row_id_pqr?:
          type: string
          example: "MDM-PQR-19828"
          required: false
        numero_pqr?:
          type: string
          example: "MDM-PQR-19828"
          required: false
        cun?:
          type: string
          example: "4347170004574581"
          required: false
example: !include ../../examples/responses/get-pqrs-duplicates.json