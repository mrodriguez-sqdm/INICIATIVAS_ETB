#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Consulta realizada con exito
    required: false
  georeference?:
    type: array
    items:
      type: object
      properties:
        _id:
          type: object
          properties:
            $oid:
              type: string
              example: "5a055cabc128ff8eddb35d60"
              required: false
        Estado?:
          type: string
          example: "Activo"
          required: false
        Fecha_Actualizacion?:
          type: object
          properties:
            $date:
              type: datetime 
              example: "2023-06-23T13:45:41.671Z"
              required: false
        Fecha_Creacion?:
          type: object
          properties:
            $date:
              type: datetime 
              example: "2023-06-23T13:45:41.671Z"
              required: false
        Nombre_Tabla?:
          type: string
          example: "RANGO SCORE MÓVIL HOGARES Y MIPYMES LTE DEFAULT"
          required: false
        Numero_Tabla?:
          type: integer
          example: 4
          required: false
        Tabla_Asignada?:
          type: boolean
          example: true
          required: false
        Tipo_Servicio?:
          type: string
          example: "LTE"
          required: false
        Rangos?:
          type: array
          items:
            type: object
            properties:
              Codigo:
                type: string
                example: "500_699"
                required: false
              Estado:
                type: string
                example: "Activo"
                required: false
              Detalle:
                type: array
                items:
                  type: object
                  properties:
                    Nombre:
                      type: string
                      example: "ALTO"
                      required: false
                    Valor:
                      type: string
                      example: "0"
                      required: false
example: !include ../../examples/responses/get-score-georeference.json