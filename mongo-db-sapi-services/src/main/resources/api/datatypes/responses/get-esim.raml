#%RAML 1.0 DataType
type: object
properties:
  _id:
    type: object
    required: false
    properties:
      $oid:
        type: string
        example: 6a87211ffafd413814ef46a1
        required: false
  ICCID:
    type: string
    example: "89571871150033683221"
    required: false
  Numero_Orden:
    type: string
    example: "MDM-MOV-337732"
    required: false
  Usuario_Creacion:
    type: string
    example: "PortalLTE"
    required: false
  Usuario_Modificacion:
    type: string
    example: "PortalLTE"
    required: false
  Fecha_Creacion:
    type: any
    required: false
  Fecha_Modificacion:
    type: any
    required: false
  Canal:
    type: string
    example: "MDM"
    required: false
  Estado:
    type: string
    example: "RESERVADO"
    required: false
  EnvioResponsys:
    type: boolean
    example: true
    required: false
  Fecha_Activacion:
    type: any
    example: null
    required: false
  MSISDN:
    type: string
    example: "3058194318"
    required: false
  IMSI:
    type: string
    example: "732187105676843"
    required: false
  Numero_Documento:
    type: string
    example: "53892680"
    required: false
  Tipo_Documento:
    type: string
    example: "CC"
    required: false
  Tramite:
    type: string
    example: "VTA"
    required: false
  ParametrosResponsys:
    type: array
    required: false
    items:
      type: object
      properties:
        Parametro:
          type: string
          example: "EMAIL_ADDRESS_"
          required: false
        Valor:
          type: any
          example: ""
          required: false
  Reenvio:
    type: array
    required: false
    items:
      type: object
      properties:
        Canal:
          type: string
          required: false
        Envio:
          type: boolean
          required: false
        Fecha_Envio:
          type: string
          required: false
