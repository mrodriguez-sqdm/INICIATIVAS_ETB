			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if(isEmpty(payload))
{
  "status": 404,
  "code": "NOT_FOUND",
  "message": {
    "message": ""
  },
  "messageServer": "Data not found",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.exception.NotFoundExcecption"
    }
  ]
}
else
payload[0] -'_id']]></ee:set-payload>
			</ee:message>
