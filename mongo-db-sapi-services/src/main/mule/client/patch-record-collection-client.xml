			<mongo:query ><![CDATA[#[vars.query]]]></mongo:query>
			<mongo:content-to-update ><![CDATA[#[vars.update]]]></mongo:content-to-update>
		</mongo:update-documents>
		<ee:transform
			doc:name="Transform Message"
			doc:id="089ae58a-fa09-4de8-9b96-8996c91c4dc0">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	status: "success",
	data: payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>