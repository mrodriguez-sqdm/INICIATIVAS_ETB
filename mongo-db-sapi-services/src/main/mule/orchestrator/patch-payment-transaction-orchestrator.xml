<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-payment-transaction-orchestratorSub_Flow" doc:id="e5100173-cda9-44aa-a000-d47b5ef22ca1" >
		<ee:transform doc:name="Transform Message" doc:id="2e5610d7-b1c8-4e4d-8cbe-7552f3f83c5c">
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
fun fechaHoraColombia() =
  (now() >> "America/Bogota") as String {
    format: "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
  }

var fechaColombia = fechaHoraColombia()
---
{
	"estado_transaccion": payload.estado,
	"fecha_actualizacion": fechaColombia
}]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="transaccionId" ><![CDATA[attributes.uriParams.'transaccionId']]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Go to client" doc:id="bb859b22-4287-4444-9236-f13255f5e5cd" name="patch-payment-transaction-client" />
	</sub-flow>
</mule>
