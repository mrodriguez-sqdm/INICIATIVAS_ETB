                      type: boolean
                      example: true
                    es_inventario:
                      type: boolean
                      example:
                    es_obligatorio:
                    es_respuesta:
                      type: boolean
                      example: false
                    id_campo_dependiente:
                    id_lista:
                    nombre:
                      type: string
                      example: HORARIO DE TRABAJO 
                    tipo:
                      type: string
                      example: Texto
                    ValorMultiple:
                    id_tarea:
                      type: string
                      example: 5b07302c929c4e12b03f0f67
                    order_visualizacion:
                      type: number
                      example: 0
                    tarea:
                      type: string
                      example: VALIDACION APV 
                    valor:
                      type: number
                      example: 7
    configuracion_servicio:
