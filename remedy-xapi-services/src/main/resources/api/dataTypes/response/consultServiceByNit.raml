#%RAML 1.0 DataType
  properties:
    WSResponseHeader2:
      properties:
        System:
          properties:
            name:
              type: string
              example: Portal
            correlationID:
              type: string
              example: b5a95a63.f190.4c91.880a.5b54512fa6b1
            processingServer:
        Service:
          properties:
            status:
              type: string
              example: PASS
            responseDate:
              type: string
              example: "2022-08-04T13:09:16.1420739-03:00"
    ConsultarServicioClienteByNitResult:
      properties:     
        svc_PS_SERVICIO_CLIENTE:
