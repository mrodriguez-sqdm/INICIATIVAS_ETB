            id:
              type: string
              example: 62e29bf7f46b1623602494cf
            FechaActualizacion:
              type: string
              example: "2022-07-28T09:31:14.952-05:00"
            FechaBloqueo:
            FechaCreacion:
              type: string
              example: "2022-07-28T09:23:51.855-05:00"
            UsuarioBloqueo:
            UsuarioCreacion:
              type: string
              example: GESTOR
            UsuarioModificacion:
              type: string
              example: crisalms
            actualizacion_id:
            aliado_colaborador:
