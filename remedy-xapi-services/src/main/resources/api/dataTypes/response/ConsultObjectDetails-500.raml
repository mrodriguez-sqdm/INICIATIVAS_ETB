#%RAML 1.0 DataType
properties:
  Body:
    properties:
      ConsultObjectDetailsSFOutput:
        properties:
          WSResponseHeader2:
            properties:
              System:
                properties:
                  name:
                    type: string
                    example: "Tibco"
                  correlationID:
                    type: string
                    example: "INC000006634557"
                  processingServer:
                    type: string
                    example: "Tibco"
              Service:
                properties:
                  status:
                    type: string
                    example: "FAIL"
                  responseDate:
                    type: string
                    example: "2022-06-05T17:34:45.118-05:00"
                  statusDetail:
                    properties:
                      errorCode:
                        type: string
                        example: "NOK"
                      errorMessage:
                        type: string
                        example: "BWENGINE-100029"