<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="post-ConsultObjectDetails-clientSub_Flow" doc:id="60173e73-22aa-4c9d-9373-66ef63fee86c" >
		<http:request method="GET" doc:name="Request" doc:id="bd3bd6e0-4b41-4af9-b170-f117d49ec7ae" config-ref="HTTP_Request_configuration_salesforce_sapi" path="${salesforce-sapi.path.consultObjectDetail}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"client_secret" : p('credentials.client_secret'),
	"client_id" : p('credentials.client_id'),
	"source": attributes.headers.source,
	"name": attributes.headers.name,
	"X-CORRELATION-ID": correlationId,
	"systemId": vars.systemId
}]]]></http:headers>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"username" : p('salesforce-sapi.username'),
	"password" : p('salesforce-sapi.password')
}]]]></http:query-params>
		</http:request>
	</sub-flow>
	<sub-flow name="post-ConsultObjectDetails-JAR" doc:id="dbed1ad0-f6c0-4e96-a901-a6eaf7553c85" >
		<http:request method="POST" doc:name="Call to JAR" doc:id="3a0bb539-39dc-450c-acd4-1b520fed7fa7" config-ref="HTTP_Request_configuration-JAR" path="${salesforce-jar.path}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Content-Type": p('salesforce-jar.contentType'),
	"SOAPAction": p('salesforce-jar.Soapaction')
}]]]></http:headers>
		</http:request>
	</sub-flow>
</mule>
