output application/java
---
"PROCESO VIABILIDAD DESDE SF DESHABILITADO TEMPORALMENTE"]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>
                    </when>
                    <otherwise>
                        <flow-ref doc:name="Go to Handler (SF) - DESAHHIBILITADO TEMPORALMENTE" doc:id="defda4a3-9dd4-4651-b191-e0c6fa182e9a" name="post-productOrderState-salesforce-handler" />
