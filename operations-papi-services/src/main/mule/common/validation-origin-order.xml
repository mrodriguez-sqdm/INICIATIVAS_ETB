<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">
	<sub-flow name="validation-origin-orderSub_Flow" doc:id="2a6544fc-3dc7-4e31-b5e5-7b28188241de" >
		<ee:transform doc:name="Transform Message" doc:id="fe15c0f4-0016-4486-9b85-d62585314162">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="headers"><![CDATA[%dw 2.0
output application/json
---
attributes.headers]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="17e5b082-1efd-4cfe-a3de-569318970a2a" >
			<when expression="#[(!isEmpty(attributes.uriParams.idServiceAccount))]">
				<ee:transform doc:name="Transform Message"
			doc:id="5c8d1757-dceb-4964-816e-f9c334d93215">
			<ee:message>
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "query": {
    "find": "MDM_CD_ORDEN",
    "filter": {
      "Servicio_Tramite.Id_Cuenta_Servicio": attributes.uriParams.idServiceAccount
    }
  }
}]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dw/call-dynamic-query-method.dwl" variableName="method" />
				<ee:set-variable
					resource="dw/call-dynamic-query-path.dwl" variableName="path" />
			</ee:variables>
		</ee:transform>
				<flow-ref doc:name="mongo-db-sapi-dynamic-querySub_Flow" doc:id="2d5ab305-bc63-4c93-87b3-69d2dde383e0" name="mongo-db-sapi-dynamic-querySub_Flow" target="getOrderNumberByidServiceAccount"/>
			</when>
			<when expression="#[(!isEmpty(attributes.uriParams.orderNumber))]">
				<logger level="INFO" doc:name="Logger" doc:id="6316e733-0501-4796-9710-bb9be7255cc5" message='#["Entro por uriParam orderNumber"]' />
			</when>
			<otherwise >
				<choice doc:name="Choice" doc:id="20f02194-48f9-4ba0-8c80-99444096a74e" >
					<when expression="#[(!isEmpty(payload.idServiceAccount))]">
						<ee:transform doc:name="Transform Message1" doc:id="30ed2505-1f5c-440b-8103-fda84b4ee064">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "query": {
    "find": "MDM_CD_ORDEN",
    "filter": {
      "Servicio_Tramite.Id_Cuenta_Servicio": payload.idServiceAccount
    }
  }
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable resource="dw/call-dynamic-query-method.dwl" variableName="method" />
						<ee:set-variable resource="dw/call-dynamic-query-path.dwl" variableName="path" />
					</ee:variables>
				</ee:transform>
						<flow-ref doc:name="mongo-db-sapi-dynamic-querySub_Flow" doc:id="25517197-d1fc-4821-bede-5e8891e95ece" name="mongo-db-sapi-dynamic-querySub_Flow" target="getOrderNumberByidServiceAccount" />
					</when>
					<otherwise >
						<logger level="INFO" doc:name="Logger" doc:id="bdd09407-361f-41e2-bd0e-a7c456c770bd" message='#["Entro por payload orderNumber"]' />
					</otherwise>
				</choice>
			</otherwise>
		</choice>
		<ee:transform doc:name="Transform Message" doc:id="b18fd6d1-0b73-483e-8fe1-8674872defcf">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="result"><![CDATA[%dw 2.0
output application/json
var normalizeOrigin =
    upper(
        if ( isEmpty(vars.headers.origin default "") ) "TIGO"
        else
            vars.headers.origin
    )
var baseKey =
    if ( !isEmpty(vars.getOrderNumberByidServiceAccount.result[0].Numero_Orden default "") ) vars.getOrderNumberByidServiceAccount.result[0].Numero_Orden
    else if ( !isEmpty(attributes.uriParams.orderNumber default "") ) attributes.uriParams.orderNumber
    else if ( !isEmpty(payload.orderNumber default "") ) payload.orderNumber
    else
        ""
var keyObjectStore =
    normalizeOrigin ++ "_" ++ baseKey
---
keyObjectStore]]></ee:set-variable>
				<ee:set-variable variableName="orderNumberValidation" ><![CDATA[%dw 2.0
output application/json
var ordNmbr =
	if ( !isEmpty(vars.getOrderNumberByidServiceAccount.result[0].Numero_Orden default "") ) vars.getOrderNumberByidServiceAccount.result[0].Numero_Orden
    else if ( !isEmpty(attributes.uriParams.orderNumber default "") ) attributes.uriParams.orderNumber
    else if ( !isEmpty(payload.orderNumber default "") ) payload.orderNumber
    else
        ""
---
ordNmbr]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Contains Result Key Value" doc:id="90d5325e-5b0a-4ae7-9352-9c5e0a83dd44" name="get-key-order-number-Sub-Flow" target="resultOS" />
		<choice doc:name="Choice" doc:id="308014d5-779a-4a27-93db-984bd7067220">
			<when expression="#[vars.resultOS == true]">
				<logger level="INFO" doc:name="Logger" doc:id="939291b3-9037-4f2a-9103-6ca57845f0d0" message="The Object Store contains a record for the request origin and order." />
			</when>
			<otherwise>
				<flow-ref doc:name="Get Order By Order Number" doc:id="243af34e-cd1e-4c15-8065-cab55ccdbc9d" name="get-order-status-by-order-numberSub_Flow" target="resultDB" />
				<ee:transform doc:name="Transform Message" doc:id="088d299e-f81e-42ba-a5f2-a53d79fe9562">
					<ee:message>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="filterResultDB" ><![CDATA[%dw 2.0
output application/json

var firstResult = vars.resultDB[0] default {}

var mayorista = firstResult.Caracteristica_Orden filter ($.Caracteristica == "MAYORISTA")
---
((mayorista[0].Valor default "") ++ "_" ++ (firstResult.Numero_Orden default "")) == (vars.result default "")
]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<choice doc:name="Choice" doc:id="00773428-a7d3-4427-9afc-1966b55618d6">
			<when expression="#[vars.filterResultDB == true]">
				<logger level="INFO" doc:name="Logger" doc:id="eaae9621-226e-4f58-a832-a71af269bb34" message="The Data Base contains a record for the request origin and order." />
			</when>
			<otherwise>
						<raise-error doc:name="Raise error" doc:id="e17b0e86-771a-4150-bb43-a515c5a79a35" type="MDM:INVALID_DATA" description="Error trying to validate origin or order information."/>
			</otherwise>
		</choice>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
