<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="loggerSub_Flow" doc:id="b82b67da-a1f3-41c0-97d0-591f26f57ef8" >
		<ee:transform doc:name="Set logger" doc:id="4f3f07f4-68d7-4d88-8357-a414ee4a4837" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="logger" ><![CDATA[%dw 2.0
output application/json
---
{
    "Identificador_Peticion" : vars.id,
    "Sistema_Origen" : "MULESOFT",
    "Servicio" : app.name,
    "Operacion" : vars.operation,
    "Fecha_Peticion" : vars.timePetition,
    "Fecha_Respuesta" : (now() >> "America/Bogota") as String {format : p('format-date')},
    "Datos_Entrada" : vars.inputPayload,
    "Datos_Salida" : payload,
    "Observaciones" : "OK",
    "IP" : vars.host
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="1ee5d1a2-e169-4a7a-b5fd-49c4663efd96" message="#[vars.logger]"/>
	</sub-flow>
	<sub-flow name="get_loggerVariables" doc:id="34fb6792-e6c3-431f-90df-ffb6ecc3fcd6" >
		<ee:transform doc:name="Set variables global" doc:id="081f158e-f4ea-44b8-979a-71ff2c31926b" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="timePetition" ><![CDATA[%dw 2.0
output application/java
---
(now() >> "America/Bogota") as String {format : p('format-date')}]]></ee:set-variable>
				<ee:set-variable variableName="host" ><![CDATA[%dw 2.0
output application/java
---
attributes.headers.host]]></ee:set-variable>
				<ee:set-variable variableName="inputPayload" ><![CDATA[%dw 2.0
output application/java
---
{
	uriParams: attributes.uriParams,
	queryParams: attributes.queryParams,
	body: payload
}]]></ee:set-variable>
				<ee:set-variable variableName="originInput" ><![CDATA[attributes.headers.origin default ""]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
