<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-portability-orchestratorSub_Flow" doc:id="752617d4-d610-4a6f-8653-9085d2169e51" >
		<flow-ref doc:name="Go to Object Store Process ID" doc:id="53ccd0b4-ed16-452b-9649-c87a262b8c05" name="get_consecutive_number_Sub_Flow_Process_ID" target="consecutiveNumber1"/>
		<flow-ref doc:name="Go to Object Store Message ID" doc:id="b444370d-aeae-441d-a249-57c570d20dbd" name="get_consecutive_number_Sub_Flow_Message_ID" target="consecutiveNumber2"/>
		<flow-ref doc:name="Go to Object Store Document ID" doc:id="7569965a-e0be-4ec8-88ee-241c04799202" name="get_consecutive_number_Sub_Flow_Document_ID" target="consecutiveNumber3"/>
		<choice doc:name="Choice" doc:id="599dfefe-e201-4286-b252-28573570e4e4" >
			<when expression="vars.consecutiveNumber1 &gt; 99999">
				<set-variable value="MaximoDiarioAlcanzado" doc:name="Set Variable" doc:id="4279be21-b7a5-4180-832c-3d2b0e1df1b9" variableName="processID"/>
			</when>
			<otherwise >
				<set-variable value='#[%dw 2.0&#10;import * from dw::core::Strings&#10;output application/json&#10;---&#10;leftPad(vars.consecutiveNumber1 as String, 5, "0")]' doc:name="Set Process ID Consecutive Number in String" doc:id="14d40649-498f-4206-954e-0c9e007c9cc4" variableName="processIDConsecutiveNumber" />
				<flow-ref doc:name="Go to Generate Process ID" doc:id="cad13666-2b29-4db9-bf89-6de3f0ef9593" name="generate_process_id_Sub_Flow" />
			</otherwise>
		</choice>
		<choice doc:name="Choice" doc:id="c88e7f93-b7e5-4d23-892a-de6b8782bda7" >
			<when expression="#[vars.consecutiveNumber2 &gt; 99999]">
				<set-variable value="MaximoDiarioAlcanzado" doc:name="Set Variable" doc:id="a4c82551-8f89-4184-a192-37a5c6efe9b0" variableName="messageID"/>
			</when>
			<otherwise >
				<set-variable value='#[%dw 2.0&#10;import * from dw::core::Strings&#10;output application/json&#10;---&#10;leftPad(vars.consecutiveNumber2 as String, 5, "0")]' doc:name="Set Message ID Consecutive Number in String" doc:id="e7ee55d3-94a4-41a5-970a-20087ebc1b88" variableName="MessageIDConsecutiveNumber" />
				<flow-ref doc:name="Go to Generate Message ID" doc:id="7ce49db2-f77a-4779-b54f-b44db56b30e9" name="generate_message_id_Sub_Flow" />
			</otherwise>
		</choice>
		<choice doc:name="Choice" doc:id="07cc69ec-bf7d-4022-a09a-031102e834c8" >
			<when expression="vars.consecutiveNumber3 &gt; 99999">
				<set-variable value="MaximoDiarioAlcanzado" doc:name="Set Variable" doc:id="997be857-8030-43b8-bec1-54558bf652a8" variableName="documentID"/>
			</when>
			<otherwise >
				<set-variable value='#[%dw 2.0&#10;import * from dw::core::Strings&#10;output application/json&#10;---&#10;leftPad(vars.consecutiveNumber3 as String, 5, "0")]' doc:name="Set Document ID Consecutive Number in String" doc:id="96097c57-90e9-4d70-b4bf-2815f242abcf" variableName="DocumentIDConsecutiveNumber" />
				<flow-ref doc:name="Go to Generate Document ID" doc:id="b3a007d2-6eed-49c1-a95c-a9574211f6da" name="generate-document-idSub_Flow" />
			</otherwise>
		</choice>
		<ee:transform doc:name="Transform Message" doc:id="2e85abc3-abd5-4187-91ad-b11a42c5e8ac" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	idProcess:vars.processID,
	idMessage:vars.messageID,
	idDocuments:vars.documentID
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
