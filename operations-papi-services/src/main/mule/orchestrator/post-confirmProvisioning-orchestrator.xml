				<choice doc:name="O90?" doc:id="a7d828bf-8598-41ea-af8c-cff8f0d07c78" >
					<when expression='#[vars.ordenComercialCode == "O90" and (&#10;    (&#10;        (vars.orderData[0].Orden_Activacion.Servicios &#10;        filter ($.Estado_Servicio.Codigo == "50" and $.Nombre == "ACCESO DE RED")&#10;        ).Nombre[0] == "ACCESO DE RED"&#10;    ) &#10;    or &#10;    (&#10;        ((vars.orderData[0].Orden_Activacion.Servicios&#10;		filter ($.Nombre == "ACCESO DE RED")&#10;		).Servicios_Hijos[0] &#10;		filter ($.Estado_Servicio.Codigo == "50" and $.Nombre == "ONT/DSL")).Nombre[0] == "ONT/DSL"&#10;    )&#10;)]' >
						<flow-ref doc:name="go to normal flow" doc:id="d9aaa343-29af-4434-bef6-62da6be7b820" name="orquestador-subFlow" />
					</when>
					<otherwise >
						<ee:transform doc:name="set error Response" doc:id="3f181a78-3bc8-421a-909e-6b4432568e74" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 500,
  "code": "INTERNAL_SERVER_ERROR",
  "message": {
    "message": "The order state is invalid"
  },
  "messageServer": "",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
    }
  ]
}]]></ee:set-payload>
							</ee:message>
							<ee:variables >
								<ee:set-variable variableName="httpStatus" ><![CDATA[500]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</otherwise>
				</choice>
			</when>
			<otherwise >
				<choice doc:name="statusCode?" doc:id="f16970a6-0af2-44b4-b803-ba3cbcd1157e" >
					<when expression='#[vars.ordenComercialCode == "O90"]' >
						<flow-ref doc:name="Go to retry flow" doc:id="74768aae-b1bc-4c9a-8ab3-9584966c6059" name="retry-flow" />
					</when>
					<when expression='#[vars.ordenComercialCode == "O160"]' >
