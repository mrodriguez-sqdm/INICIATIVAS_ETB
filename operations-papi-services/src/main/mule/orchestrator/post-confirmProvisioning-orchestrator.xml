	<sub-flow name="states-to-retry" doc:id="2475c6e0-e7ba-40d8-9957-f3f2119eafde">
		<set-variable value="#[vars.orderData[0].Estado_Orden_Comercial.Codigo]" doc:name="Set ordenComercialCode" doc:id="e6d5ec3c-60f2-4a36-9d12-00ae28cf1498" variableName="ordenComercialCode" />
		<choice doc:name="Characteristic to retry?" doc:id="01193061-4045-4866-aff5-0c8ed0fec2e0" >
