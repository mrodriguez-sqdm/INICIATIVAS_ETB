		<set-variable value="#[vars.orderData[0].Tramite.Tipo_Tramite]" doc:name="tipoTramite" doc:id="990e0ec5-416c-40ba-ac62-f9fac23dea67" variableName="tipoTramite" />
		<choice doc:name="Choice" doc:id="6fee3cd8-4c76-469d-bc46-7e72d83e255f" >
			<when expression='#[vars.tipoTramite == "PRCHM" or vars.tipoTramite == "VTAM" or vars.tipoTramite == "ASEGM"]'>
