							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": vars.orderData[0].Estado_Orden_Comercial.Codigo,
  "orderNumber": vars.orderNumber,
  "description": vars.orderData[0].Estado_Orden_Comercial.Descripcion
}]]></ee:set-payload>
							</ee:message>
							<ee:variables />
						</ee:transform>
					</when>
					<otherwise >
						<ee:transform doc:name="set error Response" doc:id="416ba2ff-0f20-4d82-a205-da644fbe3cda" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 500,
  "code": "INTERNAL_SERVER_ERROR",
  "message": {
    "message": "The order state is invalid"
  },
  "messageServer": "",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
    }
  ]
}]]></ee:set-payload>
							</ee:message>
							<ee:variables >
								<ee:set-variable variableName="httpStatus" ><![CDATA[500]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
					</otherwise>
				</choice>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="retry-flow" doc:id="8c17cb4d-f3a6-4bd9-8b32-7ea01a467787" >
		<ee:transform doc:name="wait 10 seconds" doc:id="147e81c8-63db-4f54-bc9b-30ab4375d80a">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/java
import wait from dw::Runtime
---
"" wait 10000]]></ee:set-payload>
									</ee:message>
								</ee:transform>
		<try doc:name="Try" doc:id="d16177a2-69fe-4b9c-be21-ba6c05384e16">
									<until-successful maxRetries="#[p('retryConfig-mayorista.maxRetry')]" doc:name="Until Successful" doc:id="8f71f5c8-ba73-4bae-9967-d74f13f0cfee" millisBetweenRetries="#[p('retryConfig-mayorista.timeMs')]">
									<flow-ref doc:name="getOrderByOrderNumber" doc:id="1059d738-4b9d-430e-9fc1-d9fbafeaeaea" name="getOrderByOrderNumber" />
									<validation:is-true doc:name="Is true" doc:id="bc4cd8b5-5330-4467-91b7-9e19dc143b65" expression='#[vars.orderData[0].Estado_Orden_Comercial.Codigo != "O90"]' message='#["Not changed"]' />
								</until-successful>
									<error-handler>
										<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="d5870e3a-d4bd-473d-8aa3-794713f67b73">
											<ee:transform doc:name="Set error" doc:id="798c1ee0-389b-4779-b568-f6e429028106">
												<ee:message>
													<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
error.description]]></ee:set-payload>
												</ee:message>
											</ee:transform>
										</on-error-continue>
									</error-handler>
								</try>
		<async doc:name="Async" doc:id="5b3d2366-94ef-43d9-a4af-71f9a480f334">
											<ee:transform doc:name="orderStatus Remove characteristic" doc:id="6a37277e-870a-414a-a90a-2b7aed1286a0">
											<ee:message />
											<ee:variables>
												<ee:set-variable variableName="orderStatus"><![CDATA[%dw 2.0
output application/json
---
{
    "updateStateCharateristic": "remove",
    "characteristics": vars.orderData[0].Caracteristica_Orden
}]]></ee:set-variable>
											</ee:variables>
										</ee:transform>
											<flow-ref doc:name="Go to update order" doc:id="dc38ce26-9178-4546-93fc-51e3f48dba30" name="patchOrderByOrderNumber" target="patchOrderResponse"/>
										</async>
		<choice doc:name="Choice" doc:id="ffd6edaa-e2cf-42f5-bd2a-21a670128f59">
									<when expression='#[payload == "Not changed"]'>
				<flow-ref doc:name="go to orquestador subFlow" doc:id="8bb85dea-899a-4f3f-90bd-865b9b0dc20e" name="orquestador-subFlow" />
									</when>
									<otherwise>
										<flow-ref doc:name="evaluate-status" doc:id="455581a8-db48-4fa7-8a7f-3d0476763dc7" name="evaluate-status" />
									</otherwise>
								</choice>
	</sub-flow>
