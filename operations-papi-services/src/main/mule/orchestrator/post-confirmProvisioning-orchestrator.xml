			<otherwise >
				<ee:transform doc:name="set error Response" doc:id="bcb7c820-9b6d-4d43-9995-29df87d73842" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 500,
  "code": "INTERNAL_SERVER_ERROR",
  "message": {
    "message": "The order state is invalid"
  },
  "messageServer": "",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
    }
  ]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[500]]></ee:set-variable>
