	<sub-flow name="orquestador-subFlow" doc:id="73542e15-9cf4-48c7-8864-19cb05938e90" >
		<ee:transform doc:name="set orchestador request" doc:id="cea5a2ca-8c59-4ea4-8dd4-5d7b0ad099cc" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="orquestatorRequest" ><![CDATA[%dw 2.0
output application/xml
ns tem http://tempuri.org/
ns orq http://www.etb.com.co/orquestador
ns soapenv http://schemas.xmlsoap.org/soap/envelope/
---
{            
  tem#"ProcesarOrden": {
	tem#"solicitudOrden": {
		orq#"Encabezado": {
			orq#"Propiedades": {
				orq#"Propiedad": {
					orq#"Nombre": "",
					orq#"Valor": ""
				}
			},
			orq#"Sistema": {
				orq#"IdCorrelacion": vars.orderNumber,
				orq#"Nombre": "Mulesoft",
				orq#"Servidor": "Mulesoft"
			}
		},
		orq#"DatosSolicitud": {
			orq#"EstadoOrden": vars.orderData[0].'Estado_Orden_Comercial'.Codigo,
			orq#"NumeroOrden": vars.orderNumber,
			orq#"Tramite": vars.orderData[0].Tramite.'Tipo_Tramite',
			orq#"UsuarioEvento": ""
		}
	}
  }
}
]]></ee:set-variable>
				<ee:set-variable variableName="orquestadorOperation" ><![CDATA[%dw 2.0
output application/java
---
p('orquestador.operation.procesarOrden')]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
<flow-ref doc:name="Process Order" doc:id="06a27f79-3b4d-4cf9-82ec-eac4de0bc175" name="post-provisioning-order-client" />
		<choice doc:name="Choice" doc:id="71fc9844-89b2-4f72-a7ea-aa33a4a94217" >
			<when expression='#[payload.ProcesarOrdenResponse.Resultado.Encabezado.Servicio.Estado == "OK"]'>
				<async doc:name="Async" doc:id="c3552c2f-71c5-4862-b30c-aee3bbd1a1c0">
					<flow-ref doc:name="Go to salesforce subFlow" doc:id="cd5f3e19-4595-4c66-b35f-d9e3588a3680" name="salesforceSub_Flow" />
		</async>
				<logger level="INFO" doc:name="Logger" doc:id="439fd540-f843-443e-8717-bc1ab03021ca" message="#[payload]" />
				<ee:transform doc:name="set final response" doc:id="eba1712c-1d79-46db-b471-59e05cbfb66b">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": payload.ProcesarOrdenResponse.Resultado.Estado.Codigo default "",
  "orderNumber": vars.orderNumber,
  "description": payload.ProcesarOrdenResponse.Resultado.Estado.Descripcion default ""
}]]></ee:set-payload>
			</ee:message>
			<ee:variables>
			</ee:variables>
		</ee:transform>
			</when>
			<otherwise >
				<ee:transform doc:name="Set response FAIL" doc:id="bd3622b9-38bb-49d9-9836-287b3575ac6c" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 500,
  "code": "INTERNAL_SERVER_ERROR",
  "message": {
    "message": payload.ProcesarOrdenResponse.Resultado.Encabezado.Servicio.DetalleEstado
  },
  "messageServer": "",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
    }
  ]
}
]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="salesforceSub_Flow" doc:id="fce76953-e539-4c94-8e9a-4508ed0d8531" >
		<flow-ref doc:name="salesforce-auth" doc:id="8175096a-6f7e-4716-8a3e-c14b66b9e503" name="salesforce-auth" />
		<set-variable value="#[vars.orderData[0].Servicio_Tramite.Id_Cuenta_Servicio]" doc:name="set id service account" doc:id="0aded8fb-0c12-46ee-8182-4d0790bafdb2" variableName="idServiceAccount" />
		<flow-ref doc:name="get service by ID" doc:id="99c6e9b0-a243-4293-92ef-159e0d0cc203" name="get-serviceByIdServiceAccount" target="obtainedServiceById" />
		<ee:transform doc:name="IdAsset" doc:id="6babff2a-6e5f-4333-82da-e88ed5aa92e4">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="idAsset"><![CDATA[%dw 2.0
output application/json
---
(vars.obtainedServiceById.Caracteristica_Servicio[0] 
    filter (upper($.Caracteristica) == upper("IDASSETSF"))).Valor[0] default null]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<try doc:name="Try Salesforce update/insert" doc:id="2f9c52d1-a8ad-48ef-9123-114e80d4f6f0">
			<choice doc:name="Choice" doc:id="e59542bf-7fdb-45d2-b31c-53a92c04a8c0" >
				<when expression='#[vars.tipoTramite == "PRCHM"]'>
					<ee:transform doc:name="Mapping Update Speed" doc:id="ec19b21a-49cc-4d98-8527-bea241ddf1bb" >
						<ee:message />
						<ee:variables >
							<ee:set-variable variableName="requestSalesforce" ><![CDATA[%dw 2.0
output application/json
var atributos = ((vars.orderData[0].Servicio_Tramite.Bundle.Primarios 
					filter $.Subtipo_Servicio == "FTTH INTERNET")[0].Secundarios 
					filter $.Subtipo_Servicio == "FTTH INTERNET")[0].Atributos
---
{
	Id: vars.idAsset,
	parametros: [
		{
			codigo: "VelocidaddeSubida__c",
			valor: (atributos filter "VelocidadSubida" == $.Nombre)[0].Valor
		},
		{
			codigo: "VelocidaddeBajada__c",
			valor: (atributos filter "VelocidadBajada" == $.Nombre)[0].Valor
		}
	]

}]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<flow-ref doc:name="updateAsset" doc:id="dc36f0f7-876e-4860-9e6e-6f15f1ae351b" name="salesforce-updateAsset" />
				</when>
				<otherwise >
					<ee:transform doc:name="Mapping insert Asset" doc:id="56a7d45a-650d-4a8f-b0af-024b97bb0d94" >
						<ee:message />
						<ee:variables >
							<ee:set-variable variableName="requestSalesforce" ><![CDATA[%dw 2.0
output application/json
---
{        
	"attributes" : {"type" : "Asset"},
    "Name": vars.orderData[0].Servicio_Tramite.Id_Cuenta_Servicio, 
    "Account": {
        "External_Id__c": (vars.orderData[0].Caracteristica_Orden filter ($.Caracteristica == "MAYORISTA")).Valor[0]
    },
    "Status": "Active", 
    "Departamento__c": vars.orderData[0].Cliente_Tramite.Direcciones[0].Departamento, 
    "Ciudad__c": vars.orderData[0].Cliente_Tramite.Direcciones[0].Municipio,  
    "Direccion_Instalacion__c": vars.orderData[0].Cliente_Tramite.Direcciones[0].Direccion_Normalizada,
    "VelocidaddeBajada__c": (vars.orderData[0].Servicio_Tramite.Bundle.Primarios[0].Secundarios[0].Atributos filter ($.Nombre == "VelocidadBajada")).Valor[0], 
    "VelocidaddeSubida__c": (vars.orderData[0].Servicio_Tramite.Bundle.Primarios[0].Secundarios[0].Atributos filter ($.Nombre == "VelocidadSubida")).Valor[0], 
    "NumerodeAgrupacion__c": vars.orderData[0].Servicio_Tramite.Bundle.Numero_Agrupacion,
    "NumerodePuerto__c": ((vars.orderData[0].Orden_Activacion.Servicios filter ($.Clase_Servicio == "Access Service Class")).Atributos[0] filter ($.Nombre == "objectName")).Valor[0] default "",
    "vlocity_cmt__JSONAttribute__c": "{\"ATT_Nemonico\":\"" ++ vars.orderData[0].Servicio_Tramite.Id_Cuenta_Servicio ++ "\",\"ATT_Numero_Agrupacion\":" ++ vars.orderData[0].Servicio_Tramite.Bundle.Numero_Agrupacion ++ ",\"ATT_Operador\":\"TIGO\"}",
    "fecha": (now() >> "America/Bogota") as String {format: p('dateSalesForce')},
}
]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<flow-ref doc:name="salesforce-insertAsset" doc:id="bc98f3b6-cfde-4ba5-b3e7-27e2c5cb1bb9" name="salesforce-insertAsset" />
				</otherwise>
			</choice>
			<error-handler>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue SF" doc:id="761468c8-acd6-41d0-b35d-00b10bcaf35f">
					<ee:transform doc:name="Set status SF by exception" doc:id="236a306f-cd84-47a7-b6e7-a25a69a4151b">
						<ee:message />
						<ee:variables>
							<ee:set-variable variableName="statusSalesforce"><![CDATA[%dw 2.0
output application/json
var errorNamespace = upper(error.errorType.namespace default "")
var errorIdentifier = upper(error.errorType.identifier default "")
---
if (
	(errorNamespace == "HTTP" and (errorIdentifier == "TIMEOUT" or errorIdentifier == "CONNECTIVITY"))
	or (errorNamespace == "MULE" and errorIdentifier == "RETRY_EXHAUSTED")
) "SIN_RESPUESTA_SF"
else "ERROR_SF"]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
		<choice doc:name="Define status salesforce" doc:id="4eaadf96-f36a-46ff-bec6-f11dcfc5a7df">
			<when expression="#[isEmpty(vars.statusSalesforce)]">
				<ee:transform doc:name="Set status by response" doc:id="5359ea78-a807-4c97-95b4-301ef891e6ab">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="statusSalesforce"><![CDATA[%dw 2.0
output application/json
---
if (vars.responseSalesforce.success default false) "EXITOSO" else "ERROR_SF"]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
		</choice>
		<flow-ref doc:name="update order" doc:id="bf63c704-5bed-4189-a9e9-1cd98b3e034c" name="update-order" target="patchOrderResponse" />
		<choice doc:name="Choice" doc:id="e1a52464-188d-4253-8e1b-0020ff3533b2" >
			<when expression='#[vars.tipoTramite == "VTAM" and vars.statusSalesforce == "EXITOSO"]'>
				<flow-ref doc:name="update service" doc:id="34189e43-adf1-413b-87bc-5e7f4354b523" name="update-service" target="updatedServiceResult" />
			</when>
		</choice>
	</sub-flow>
	<sub-flow name="update-service" doc:id="90397d0a-a957-48cf-9032-733061853fd0" >
		<ee:transform doc:name="update service characteristic" doc:id="35cd1486-6a0c-4d48-9357-d8c8c1565b92">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="serviceUpdate"><![CDATA[%dw 2.0
output application/json
---
{
	characteristics: vars.obtainedServiceById[0].Caracteristica_Servicio,
	newCharacteristic: p('interaction-params.characteristics.salesforceAsset'),
	newValue: vars.responseSalesforce.id,
	action: "add"
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="update service by id" doc:id="64a843cb-12e3-4000-97bb-dc3a88ee5a6d" name="patch-serviceByIdServiceAccount" target="patchService"/>
	</sub-flow>
	<sub-flow name="update-order" doc:id="dae89696-2ee9-44c4-be78-edc42fb249ee">
		<flow-ref doc:name="getOrderByOrderNumber" doc:id="b2eca46e-5d86-4e97-b031-e33914f75445" name="getOrderByOrderNumber" />
		<ee:transform doc:name="update order request" doc:id="d56fc5c5-c97c-4e0e-b7fe-2a05b4a4a7a7">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="orderStatus"><![CDATA[%dw 2.0
output application/json
---
{
  "updateStateCharateristic": "add",
  "updateComponent": "salesforce",
  "characteristics": vars.orderData[0].Caracteristica_Orden <<
    {
        "Caracteristica": p('interaction-params.characteristics.salesforceResponse'),
        "Valor": vars.statusSalesforce
    }
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Go to update order" doc:id="c0a6f13c-0e28-4efb-903b-f682c738133a" name="patchOrderByOrderNumber" target="patchOrderResponse"/>
	</sub-flow>
</mule>
