					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": vars.orderData[0].Estado_Orden_Comercial.Codigo,
  "orderNumber": vars.orderNumber,
  "description": vars.orderData[0].Estado_Orden_Comercial.Descripcion
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
					</ee:variables>
				</ee:transform>
				<async doc:name="Async" doc:id="a6af447d-805e-4cef-9a95-bf1174795425" >
