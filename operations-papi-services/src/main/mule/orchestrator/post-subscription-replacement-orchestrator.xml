<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-subscription-replacement-orchestratorSub_Flow" doc:id="27c14081-03b2-46ef-9da0-645a5e6bb848" >
		<try doc:name="Try" doc:id="582657c1-4dce-423d-b612-a3a29286c5ca" >
			<flow-ref doc:name="get-token-client" doc:id="f0ae66f6-3677-4f01-b079-db0bdfaff704" name="get-token-client" />
			<flow-ref doc:name="Get subscription" doc:id="403314d9-fbbc-4229-b91b-9d0b909668c3" name="get-subscription-client-by-msisdn" />
			<choice doc:name="Choice" doc:id="fff9cd25-c7b7-441b-afc5-5dfb17531aa3">
			<when expression="#[!isEmpty(payload.content)]">
				<set-variable value="#[payload.content.id[0]]" doc:name="subscriptionId" doc:id="3da15c61-5955-4c5b-afbb-d32496e2aeba" variableName="subscriptionId" />
				<flow-ref doc:name="Get Msisdn" doc:id="3abbe893-a333-4a07-891e-5bc05bdefcb8" name="get-msisdn-client" />
					<ee:transform doc:name="Set payload order" doc:id="9183cb4e-82de-4302-87ff-634496e6b0aa">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "type": "RETAIL",
  "salesChannel": "OWN_CALLCENTER",
  "status": "CONFIRMED",
  "packages": [
    {
      "id": p('jsc-sapi.replacement.packageId')
    }
  ],
  "subscription": {
    "id": vars.subscriptionId
  }
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<flow-ref doc:name="Create order" doc:id="4ee5a2ae-7984-4371-bd21-605712f80aff" name="post-order-client" />
				<ee:transform doc:name="Set payload msisdn" doc:id="b5b76c61-65fd-4ac3-8b43-d031e8df3925">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"id": vars.newMsisdn,
	"name": p('createMsisdn.name'),
	"status": p('createMsisdn.status'),
	"storeStatus": p('createMsisdn.storeStatus'),
	"pool": {
		"id": p('createMsisdn.pool.id'),
    	"name": p('createMsisdn.pool.name')
	},
	"sourcePool": {
		"id": p('createMsisdn.sourcePool.id'),
    	"name": p('createMsisdn.sourcePool.name')
	}
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<flow-ref doc:name="Create Msisdn" doc:id="da805d2d-883d-46b4-b93d-5f312e8365c3" name="post-createMsisdn-client" />
				<ee:transform doc:name="Clean Payload" doc:id="eea93630-2136-426e-9671-9d0596837541">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<flow-ref doc:name="Reserva msisdn" doc:id="60cfac7e-79cc-498e-aa97-b417e34221ce" name="patch-reservaMsisdn-client" />
					<ee:transform doc:name="Clean Payload1" doc:id="a95d9539-1458-4bed-8290-0ef4fee02b0d">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<flow-ref doc:name="Apply order" doc:id="a945f75d-71ea-41e8-ba7f-cc41ea3c8483" name="patch-endOrder-client" />
				<ee:transform doc:name="Clean Payload2" doc:id="c41d7963-5e23-4988-8779-43155506c353">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<flow-ref doc:name="Delete Msisdn" doc:id="c6af6067-439c-46b9-b354-5cd309694907" name="delete-msisdn-client" />
					<ee:transform doc:name="Set response" doc:id="cc70c0f2-5bf0-489d-b8bb-bb69d57f238a">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": "Successful"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="Error Output" doc:id="368477cf-c4e8-40b5-be49-af5b9e67406d">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"status": 404,
	"code": "NOT_FOUND",
	"message": {
		"message": "Data not found"
	},
	"messageServer": "",
	"cause": [{
		"origin": app.name,
		"message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
	}]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[%dw 2.0
output application/java
---
404]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="fbc3e785-eb1d-44a9-b310-7f4cb20aaf68" >
					<ee:transform doc:name="Error output" doc:id="e968498e-574f-4e0b-907d-9f237efd1a0e" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"status": 500,
	"code": "",
	"message": {
	  "message": (vars.errorMessageOutput default "") ++ " Respuesta JSC: " ++ payload.message.message default ""
	},
	"messageServer": "",
	"cause": [
	  {
	    "origin": app.name,
	    "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
	  }
	]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
</mule>
