		<try doc:name="Try" doc:id="a16cd4f8-a4b7-4a84-b1e8-e21b0ed44a51" >
			<wsc:consume operation="#[vars.orquestadorOperation]" doc:name="Consume OrquestadorService" doc:id="cac7d2a0-df20-45eb-8f04-84a487cc3f30" config-ref="Orquestador_Web_Service_Consumer_Config" >
