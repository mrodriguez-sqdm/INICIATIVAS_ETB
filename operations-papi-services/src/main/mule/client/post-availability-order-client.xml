			<error-handler >
				<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="2be19bbd-192d-4e17-ac14-5ae1786025a1" type="WSC:TIMEOUT" >
					<async doc:name="Async - Add order characteristic" doc:id="bd53e9fb-c02b-4d6e-bdbe-d1e452a075bd" >
						<ee:transform doc:name="orderStatus add characteristic" doc:id="35c85457-20f9-46a1-b782-1e7952c3e863" >
							<ee:message />
							<ee:variables >
								<ee:set-variable variableName="orderStatus" ><![CDATA[%dw 2.0
output application/json
---
{
    "updateStateCharateristic": "add",
    "updateComponent" : "orquestador",
    "characteristics": vars.orderData[0].Caracteristica_Orden
}]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<flow-ref doc:name="Go to update order" doc:id="382021aa-01e6-44a3-82a7-c3d9a4d785ba" name="patchOrderByOrderNumber" target="patchOrderResponse"/>
					</async>
				</on-error-propagate>
			</error-handler>
		</try>
<logger level="INFO" doc:name="Logger" doc:id="87535160-5c24-4cba-9da8-41e4c5654e7d" message="POST provisioning-orderclient AFTER #[payload]"/>
