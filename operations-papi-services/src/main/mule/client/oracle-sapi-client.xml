<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="oracle-sapi-client-Get-Process-ID-Sub_Flow" doc:id="c5261056-9c82-4c3a-b79f-15a2d21cf505" >
		<http:request method="GET" doc:name="Get Portability" doc:id="cb558c6d-39cc-4171-86be-16b62b6383b7" config-ref="HTTP_Request_configuration_oracle" path="${oracle-sapi.portability.path}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"client_secret" : p('oracle-sapi.client_secret'),
	"client_id" : p('oracle-sapi.client_id'),
	"X-CORRELATION-ID": correlationId,
	"name": attributes.headers.'name',
	"source": attributes.headers.'source',
	"systemId": vars.systemId
}]]]></http:headers>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"salesforce-id" : vars.initialPayload.integrationId
}]]]></http:query-params>
		</http:request>
		<logger level="INFO" doc:name="Logger" doc:id="56d59a2e-b33a-4348-9dd1-46ceaccd232e" message="payload"/>
	</sub-flow>
	<sub-flow name="oracle-sapi-client-responsysEnviogeneral-Sub_Flow" doc:id="4aa86b89-1dfa-421c-ad64-d918915be00e" >
		<http:request method="POST" doc:name="Request" doc:id="f69e0546-e5df-490e-84e4-b026de38558b" config-ref="HTTP_Request_configuration_procesos_suma" path="${procesos-suma.path}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Content-Type" : "application/json"
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Logger" doc:id="2c7fdef1-dfad-4baf-9554-62b89f197c46" message="#[payload]"/>
	</sub-flow>
</mule>
