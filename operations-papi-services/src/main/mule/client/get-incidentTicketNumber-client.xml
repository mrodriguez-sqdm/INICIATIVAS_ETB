		<logger level="INFO" doc:name="Logger" doc:id="c6e2f8db-f689-4606-bab2-f8b3d5aa889f" message="GET incidentTicketNumber BEFORE #[payload]"/>
		<http:request method="GET" doc:name="Request" doc:id="3a54d816-ae5c-4da7-8ba8-527ff92fc05e" config-ref="HTTP_Request_remedy-ws-login" path="#[p('remedy-ws-login.pathWorkOrder')]">
			<http:headers ><![CDATA[#[output application/java
---
{
	"Authorization" : payload as String
}]]]></http:headers>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"q" : vars.workOrder
}]]]></http:query-params>
		</http:request>
<logger level="INFO" doc:name="Logger" doc:id="7a35f6bd-8a12-414b-8558-345a8ff0073c" message="GET incidentTicketNumber AFTER #[payload]"/>
		<!-- [STUDIO:"Async"]		<async doc:name="Async" doc:id="3699cfe0-8ea8-4c9b-b4d3-8ca0e2a39457">
