		<ee:transform doc:name="Transform Message" doc:id="e8b543f2-74f4-4deb-a8d9-d8ae96824d50" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"
---
{
    "assignedGroup": payload.entries[0].values."Support Group Name",
    "status": payload.entries[0].values.Status,
    "observations": payload.entries[0].values.Summary,
    "priority": payload.entries[0].values.Priority
}]]></ee:set-payload>
