	<flow name="salesforce-client-getToken" doc:id="df7b4868-fc8e-4389-863f-ea4cebab2cb7" >
		<scheduler doc:name="Scheduler" doc:id="2f6ecc1c-8c76-4208-8ff9-b15416fed424" >
			<scheduling-strategy >
				<cron expression="${sfdc.scheduler.cron}" timeZone="${sfdc.scheduler.timezone}" />
