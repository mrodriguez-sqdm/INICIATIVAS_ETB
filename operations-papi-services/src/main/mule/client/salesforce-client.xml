		<ee:transform doc:name="set sfdcToken" doc:id="d009aeb2-9d54-4f52-b7ef-51ce1f988230">
			<ee:message>
			</ee:message>
			<ee:variables>
						<ee:set-variable variableName="sfdcToken"><![CDATA[%dw 2.0
output application/json
---
{
	token: vars.authResponse.'token_type' ++ " " ++ vars.authResponse.'access_token',
	url: vars.authResponse.'instance_url'
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="token to store" doc:id="c5bc7ccd-9caf-43fe-8082-fb4203808261" message='#[{"token to store": vars.sfdcToken}]' />
