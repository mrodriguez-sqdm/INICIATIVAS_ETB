			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "wm": {
        "idPlantilla": vars.campania,
        "numeroEnvio": vars.plantilla[0].atributos.numeroEnvio[0],
        "fechaHoraEnvio": (now() >> "America/Bogota") as String {format: "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"},
        "listconacto": [
            {
                "nombres": vars.inputPayload.nombres,
                "apellidos": vars.inputPayload.apellidos,
                "numeroCelular": vars.inputPayload.numeroCelular,
                "NumerodeIdentificacion": vars.inputPayload.numeroDocumento,
                "Tipodedocumento": vars.inputPayload.tipoDocumento,
                "listFieldTemplate": vars.inputPayload.listaTemplate map (value, index) -> {
                    "apiField": "DEG_templatefield" ++ (index + 1) ++ "__c",
                    "textField": value.textField
                }
            }
        ]
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
