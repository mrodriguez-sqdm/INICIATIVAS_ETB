<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-productOrder-handlerFlow" doc:id="d60d2e2a-5c8e-400d-9223-eaa1e503ebea" >
		<set-variable value="#[payload.productOrder.ordenOM]" doc:name="ordenOM" doc:id="fef4e8f5-464d-4e5c-8612-136b0f2ee0c3" variableName="ordenOM" />
		<set-variable value="#[payload.productOrder.correlationId]" doc:name="correlationId" doc:id="7ea6db92-9f44-4654-8dc3-47cfdadf8f2b" variableName="correlationId" />
		<flow-ref doc:name="Go To Orchestrator" doc:id="39ff8f40-8906-440f-83f1-4ae14ff23020" name="post-productOrder-orchestratorSub_Flow" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="2e4bdf61-2641-4548-8580-28795521465b" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="a8bff7e7-a251-414b-94cc-8285f67a4d00" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
