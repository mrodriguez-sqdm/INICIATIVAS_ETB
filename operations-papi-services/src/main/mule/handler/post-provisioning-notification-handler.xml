<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-provisioning-notification-handlerFlow" doc:id="4ec13760-0051-45d6-be75-32e2cd63a686" >
		<set-variable value="#[attributes.headers.source]" doc:name="source" doc:id="3b60c1c7-0be8-493e-a129-0d7b1dd89659" variableName="source"/>
		<set-variable value="#[payload.numeroOrden]" doc:name="OrdenOm" doc:id="11d4044f-6c14-4a8f-9556-0fd2c5512f8a" variableName="ordenOM" />
		<flow-ref doc:name="Go to Orchestrator" doc:id="dc8829ea-d1f5-4b07-91ef-f41860f981de" name="post-provisioning-notification-orchestrator" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="41d1c377-d129-4b78-b950-b200a42e607f" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="2ec6644b-762a-4dca-8d17-8db7262d7abd" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
