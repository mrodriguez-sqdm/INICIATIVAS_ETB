<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-productOrderState-salesforce-handler" doc:id="972a69c6-74a5-44e8-b8de-70d2f05bafa8" >
		<set-variable value="#[payload]" doc:name="Object Response" doc:id="75b7063b-dfe0-40cd-8f8b-42c49fa655b2" variableName="object_response" />
		<set-variable value="#[attributes.headers.'source']" doc:name="Set source" doc:id="590b9c2b-e54e-4f3a-9c7c-3b755359a02d" variableName="source" />
		<set-variable value="#[vars.object_response.ordenOM]" doc:name="ordenOM" doc:id="cd8d75dc-3c90-4783-8710-ac7c170378e6" variableName="ordenOM" />
		<flow-ref doc:name="Go to Orchestrator-Salesforce" doc:id="df67d8b9-d2d0-4b97-9add-8f04de59444e" name="post-productOrderState-salesforce-orchestrator" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="554ca056-d706-4e73-be85-429b066dfdb0" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="1ce11eec-50b3-4cd8-8139-841a1ce80eb7" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
