<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-subscription-replacement-handlerSub_Flow" doc:id="6860a3ea-b735-4cb6-8be3-22784e6febe1" >
		<set-variable value="#[payload.newMsisdn]" doc:name="Set newMsisdn" doc:id="7df7a937-2e52-4268-975c-a43fa339fad8" variableName="newMsisdn"/>
		<set-variable value="#[payload.oldMsisdn]" doc:name="Set oldMsisdn" doc:id="9f4448ff-5413-40ee-9adc-adb936ac37a5" variableName="oldMsisdn"/>
		<set-variable value="#[vars.oldMsisdn]" doc:name="Set msisdn" doc:id="07fa909c-712b-40eb-b361-4e9ed3c20d49" variableName="msisdn"/>
		<choice doc:name="Choice" doc:id="49feb77d-a88a-4c26-ba3e-839a96872dc4" >
			<when expression='#[upper(attributes.headers.origenTransaccion) == upper("salesforce-xapi-services")]'>
				<set-variable value='#["oracle"]' doc:name="Set logs" doc:id="1f34071d-11d7-4e8c-a13e-4171948bbf1e" variableName="logs" />
				<set-variable value='#["TRANSACCCIONES_OM"]' doc:name="systemId" doc:id="5ae73288-3f2a-4b74-bd23-23ec67225165" variableName="systemId" />
			</when>
			<otherwise >
				<set-variable value='#["mongo"]' doc:name="Set logs" doc:id="39ca7f2c-78b9-49ce-8e47-17ca8d99aa59" variableName="logs" />
			</otherwise>
		</choice>
		<flow-ref doc:name="Go to orchestrator" doc:id="c02d8572-4716-4c5e-8c3c-e72e753b1800" name="post-subscription-replacement-orchestratorSub_Flow"/>
	</sub-flow>
</mule>
