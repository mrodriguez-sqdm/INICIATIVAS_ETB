<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-provisioning-handlerFlow" doc:id="23131235-7627-4ab2-a396-42b5eb30993f" >
		<set-variable value="#[payload.respuestaAprovisionamiento.ordenOM]" doc:name="ordenOM" doc:id="ef93e221-c19c-4209-8592-d74796f58377" variableName="ordenOM" />
		<set-variable value="#[payload.respuestaAprovisionamiento.correlationId]" doc:name="correlationId" doc:id="0fecd95e-7258-49a8-b103-6298fbe154fc" variableName="correlationId" />
		<set-variable value="#[payload.respuestaAprovisionamiento.identificador]" doc:name="identificador" doc:id="0b8a5938-0003-4ebf-ad07-8dac0afb9f2e" variableName="identificador" />
		<set-variable value="#[payload]" doc:name="InputBody" doc:id="5f700c68-90f9-4bdd-8705-4043956bcaff" variableName="inputBody" />
		<flow-ref doc:name="Go to orchestrator" doc:id="59a9f093-2277-4b7e-bf6d-cfad228d5b81" name="post-provisioning-orchestratorSub_Flow" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="f6647857-efd6-4750-9777-916ba7e34af3" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="87a84ca8-e6c8-4ac6-b662-dfdee110cf54" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
