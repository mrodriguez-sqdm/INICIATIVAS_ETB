<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-viability-notification-handlerFlow" doc:id="46df584b-4574-4b8e-854b-f01d89f46ec9" >
		<set-variable value="#[payload.numeroOrden]" doc:name="OrdenOm" doc:id="e705685d-04cd-4575-b60f-635e2dc8d981" variableName="ordenOM" />
		<set-variable value="#[payload.idViabilidad]" doc:name="IdViabilidad" doc:id="36c84c0c-8ec2-4ade-82e2-a41d3cfaee4f" variableName="idViabilidad" />
		<flow-ref doc:name="Go to Orchestrator" doc:id="47a522de-9367-4f73-a16f-749329eec3e0" name="post-viability-notification-orchestratorFlow" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="b173f830-ce23-4fbe-963a-704212069ccc" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="0207b991-02c3-4661-934e-537194eeb7da" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
