<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-viability-handlerFlow" doc:id="c458f572-554c-4f76-b293-d9b2a358cc60" >
		<set-variable value="#[payload.respuestaViabilidad.ordenOM]" doc:name="ordenOM" doc:id="c69de54c-ebe9-4b23-8d50-e2ce49720326" variableName="ordenOM" />
		<set-variable value="#[payload.respuestaViabilidad.idViabilidad]" doc:name="idViabilidad" doc:id="e53a276d-dc99-4bc8-9ce7-488328667567" variableName="idViabilidad"/>
		<set-variable value="#[payload.respuestaViabilidad.correlationId]" doc:name="correlationId" doc:id="37041a05-8a4c-4bdc-b9d6-b76c42e068a8" variableName="correlationId" />
		<flow-ref doc:name="Go to Orchestrator" doc:id="04349dd0-be37-4e62-a116-d4876b99b075" name="post-viability-orchestratorSub_Flow" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="aeae9a1f-67c5-4b78-8c1f-40b209fff774" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="a9125052-8622-4135-976d-d320a89106aa" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
