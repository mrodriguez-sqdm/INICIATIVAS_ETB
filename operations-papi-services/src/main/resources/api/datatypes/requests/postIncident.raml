#%RAML 1.0 DataType
properties:
  orderNumber:
    type: string
    required: true
    example: "MDM-MAY-00001"
  idCausal:
    type: string
    required: true
    example: "1"
  idMayorista:
    type: string
    required: true
    example: "1"
  observations:
    type: string
    required: true
    example: "OK"
  user:
    type: string
    required: true
    example: "xyz"

example: !include ../../examples/requests/postIncident.json