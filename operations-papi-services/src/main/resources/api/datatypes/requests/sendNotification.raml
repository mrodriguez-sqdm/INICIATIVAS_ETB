#%RAML 1.0 DataType
properties:
  tipoDocumento:
    type: string
    example: "Cédula de ciudadanía"
  numeroDocumento:
    type: string
    example: "9774689"
  numeroCelular:
    type: string
    example: "3105330192"
  nombres:
    type: string
    example: "LEANDRO"
  apellidos:
    type: string
    example: "GARCIA"
  listaTemplate:
    type: array
    items:
      properties:
        textField: 
          type: string
          example: "Traslado Parameter 3"