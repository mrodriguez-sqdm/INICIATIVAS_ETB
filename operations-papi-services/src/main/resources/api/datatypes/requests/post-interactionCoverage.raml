#%RAML 1.0 DataType
properties:
  departmentId:
    type: string
    example: "11"
    required: true
  cityId:
    type: string
    example: "11001"
    required: true
  normalizedAddress:
    type: string
    example: "CL 163 BIS 2 60 ESTE"
    required: true
  mayoristaId:
    type: string
    example: '1'
    required: true
  transactType:
    type: string
    example: "VTAM"
    required: true
