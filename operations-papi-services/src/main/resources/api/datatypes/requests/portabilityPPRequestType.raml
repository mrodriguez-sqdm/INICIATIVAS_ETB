#%RAML 1.0 DataType
type: object
properties:
  portability:
    type: object
    required: true
    properties:
      Header:
        properties:
          identifier: 
            description: Portability transaction Id
            type: string
            example: "MDM-MOV-55002"
            required: true
          observations:
            description: Comments related to portability transaction
            example: "observaciones"
            type: string
            required: true
      Body:
        properties:
          ProgramacionPortacion:
            properties:
              FechaVentanaCambio:
                description: Date of change
                type: string
                example: "01/12/2021 09:07:56"
                required: true