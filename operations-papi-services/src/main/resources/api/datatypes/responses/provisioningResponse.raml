#%RAML 1.0 DataType
properties:
  resultado:
    type: string
    required: true
    minLength: 1
    example: resultado
  fecha:
    type: string
    required: true
    minLength: 1
    example: 2015-07-04 21:00:00
  descripcion:
    type: string
    required: false
    example: "descripcion"
  ordenOM:
    type: string
    example: "123"
  agrupador:
    type: string
    example: "123"