#%RAML 1.0 DataType

properties: 
  getCoverageOPOutput:
    type: object 
    properties:
      wsResponseHeader2:
        type: object
        properties:
          system:
            type: object
            properties:
              name:
                type: string
              correlationID: 
                type: string
              processingServer:
                type: string
          service: 
            type: object
            properties:
              status: 
                type: string
              responseDate:
                type: string 
              statusDetail:
                type: object
                properties:
                  errorCode:
                    type: string
                  errorMessage:
                    type: string
