#%RAML 1.0 DataType
properties:
  IdProcess:
    description: Process Id
    type: string
    example: "00007202111220101137"
  IdMessage:
    description: Message Id
    type: string
    example: "00007202111220100180"
  IdDocuments:
    description: Document Id
    type: string
    example: "00007202111220200001-CC.pdf"