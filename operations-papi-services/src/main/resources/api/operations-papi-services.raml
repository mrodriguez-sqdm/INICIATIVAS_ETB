#%RAML 1.0
title: Operations PAPI Services
baseUri: operations-papi-services-{env}.us-e2.cloudhub.io/operations
description: This API has an interface for operations with Operations PAPI Services
version: 1
mediaType: 
- application/json 
types:
  provisioningSalesforce: !include datatypes/requests/provisioningSalesforce.raml
  viabilitySalesforce: !include datatypes/requests/provisioningSalesforce.raml
  provisioningExperience: !include datatypes/requests/provisioningExperience.raml
  patch-order-numOrden-adicion: !include datatypes/requests/patch-order-numOrden-adicion.raml
  patch-order-numOrden-eliminacion: !include datatypes/requests/patch-order-numOrden-eliminacion.raml
  patch-order-numOrden-sustitucion: !include datatypes/requests/patch-order-numOrden-sustitucion.raml
protocols:
  - HTTP
uses:
  productOrder-lib: libraries/productOrder-library.raml
  processId-lib: libraries/processId-library.raml
  portabilityRSPD-lib: libraries/portabilityRSPD-library.raml
  processViability-lib: libraries/processViability-library.raml
  processProvisioning-lib: libraries/processProvisioning-library.raml

traits:
  securityClient: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  request_headers: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml

/v1:
  /cuestionario:
    post:
      is: [securityClient,request_headers]
      displayName: Solicitud de cuestionario
      description: Solicitud de cuestionario
      body:
        application/json:
          type: !include datatypes/requests/cuestionarioRequest.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/responses/cuestionarioResponse.raml
              example: !include examples/responses/cuestionarioResponse.json
  /coverages:
    /details:
      is: [securityClient,request_headers]
      post:
        displayName: Get Converage
        body:   
          application/json:
            type: !include datatypes/requests/getConverageInput.raml
        responses:
          200: 
            body:
              application/json:
                type: !include datatypes/responses/getCoverageResponse200.raml
          400:
            body:
              application/json:
                type: !include datatypes/responses/getCoverageResponse400.raml
                examples:
                  altResponse1: !include /examples/responses/getCoverageResponse400-1.json
                  altResponse2: !include /examples/responses/getCoverageResponse400-2.json
                  altResponse3: !include /examples/responses/getCoverageResponse400-3.json
                  altResponse4: !include /examples/responses/getCoverageResponse400-4.json
          500:        
            body:
              application/json:
                type: !include datatypes/responses/getCoverageResponse500.raml
  /orders:
    /{orderNumber}:
      uriParameters:
        orderNumber:
          type: string
          example: MDM-MAY-00001
      get:
        is: [securityClient, request_headers]
        displayName: Get order status
        description: check order status in MDM
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/responses/getOrderState.raml
                example: !include examples/responses/getOrderStatus.json
  /productOrder:
    is: [securityClient,request_headers]
    post:
      displayName: Register data from Salesforce applications
      description: Service to register data from saleforce applications
      body:
        type: productOrder-lib.productOrder
        example: !include examples/requests/productOrderRequest.json
      responses:
        201:
          body:
            type: !include datatypes/responses/productOrderResponse.raml

  /order:
    is: [securityClient,request_headers]
    post:
      displayName: Process a order
      description: Service to process orders from saleforce applications
      body:
        type: !include datatypes/requests/processOrderType.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/responses/processOrderResponse.raml
    /{numOrden}:
      uriParameters:
        numOrden:
          type: string
      patch:
        is: [securityClient]
        displayName: Update order in fractalia
        description: Update order in fractalia 
        queryParameters:
          accion:
            enum: ["ADICION","SUSTITUCION", "ELIMINACION", "CREARUSUARIO"]
        body:
          application/json:
            type: patch-order-numOrden-adicion | patch-order-numOrden-sustitucion | patch-order-numOrden-eliminacion
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/patch-order-numOrden.raml
  
  /provisioning:
    is: [securityClient,request_headers]    
    post:
      headers:
        source:
          type: string
          examples:
            gestor: "gestor-xapi-services"
            salesforce: "salesforce-xapi-services"
            experience: "experience-xapi-services"
      displayName: Process a provisioning response.
      description: Service to process provisioning response, consult and update OM order.
      body:
        type:  processProvisioning-lib.provisioning | provisioningSalesforce
      responses:
        200:
          body:
            type: !include datatypes/responses/provisioningResponse.raml
            example: !include examples/responses/provisioningResponse.json 
    /notification:
      post:
        is: [securityClient,request_headers]
        headers:
          source:
            type: string
            examples:
              gestor: "gestor-xapi-services"
        displayName: Process the provisioning response to salesforce.
        description: Service to process response from Order Handler for provisionings to salesforce.
        body:
          type: !include /datatypes/requests/sendResponseSalesforceRequestType-provisioning.raml
          example: !include /examples/requests/sendResponseSalesforceRequestType-provisioning.json
        responses:
          201:
            body:
              type: !include /datatypes/responses/sendResponseSalesforceResponseType-provisioning.raml
              example: !include /examples/responses/sendResponseSalesforceResponse-provisioning.json
    /confirm:
      post:
        is: [securityClient,request_headers]
        displayName: Confirm Privisioning
        description: Process that confirms that a provisioning has been done.
        body: 
          type: !include datatypes/requests/postConfirmProvisioning.raml
        responses:
          201:
            body:
              type: !include datatypes/responses/201confirmProvisioning.raml
              example: !include examples/responses/201confirmProvisioning.json
          406:
            body:
              type: !include datatypes/responses/406confirmProvisioningType.raml
              example: !include examples/responses/406confirmPrivisioningExample.raml

            
  /viability:    
    is: [securityClient,request_headers]    
    post:
      displayName: Process a viability response.
      description: Service to process response from saleforce and gestor applications. 
      body:
        type: processViability-lib.processViability | viabilitySalesforce
      responses:
        201:
          body:
            type: !include datatypes/responses/processViabilityResponse.raml
    /notification:
      post:
        is: [securityClient,request_headers]
        displayName: Process the viability response to salesforce.
        description: Service to process response from Order Handler for viabilities to salesforce.
        body:
          type: !include /datatypes/requests/sendResponseSalesforceRequestType.raml
        responses:
          201:
            body:
              type: !include /datatypes/responses/sendResponseSalesforceResponseType.raml
              example: !include /examples/responses/sendResponseSalesforceResponse.json
            
  /portabilitySP:        
    post:
      is: [securityClient,request_headers]
      displayName: IdProcess, IdMessage and IdDocuments generator
      description: Id generator for message, process and document elements.
      body:
        type: !include datatypes/requests/portabilitySPRequestType.raml
        example:
          !include examples/requests/portabilitySPRequest.json
      responses:
        201:
          body:
            type: !include datatypes/responses/portabilitySPResponseType.raml
            example: !include examples/responses/portabilitySPResponse.json

  /portabilityRSPD:        
    post:
      is: [securityClient,request_headers] 
      displayName: Mock service using Identifier field as a reference 
      description: Based on Identifier field value mock the result, either success and failed process.
      body:
        application/json:
          type: portabilityRSPD-lib.portability
          example:
            !include examples/requests/portabilityRSPDRequest.json
      responses:
        201:
          body:
            type: !include datatypes/responses/portabilityRSPDResponseType.raml
            example: !include examples/responses/portabilityRSPDResponse.json

  /processId:        
    patch:
      is: [securityClient,request_headers]
      displayName: Update process id 
      description: This function inserts or updates the processId in the database using the salesforce id.
      body:
        application/json:
          type: processId-lib.processIdRequest
          example: !include examples/requests/processIdRequest.json
      responses:
        200:
          body:
            type: processId-lib.processIdResponse
            examples: 
              sucessInsertResponse: !include examples/responses/processIdInsertResponse.json
              sucessUnsertResponse: !include examples/responses/processIdUpdateResponse.json
  
  /portabilityPP:
    post:
      is: [securityClient,request_headers]
      displayName: IdProcess, IdMessage and IdDocuments generator
      description: Id generator for message, process and document elements.
      body:
        type: !include datatypes/requests/portabilityPPRequestType.raml
        example:
          !include examples/requests/portabilityPPRequest.json
      responses:
        201:
          body:
            type: !include datatypes/responses/portabilityPPResponseType.raml
            example: !include examples/responses/portabilityPPResponse.json

  /provisionings:
    is: [securityClient, request_headers]
    post:
      displayName: Set Provisioning.
      description: Service to set provisioning response, consult and update OM order.
      body:
        type: provisioningExperience
      responses:
        200:
          body:
            type: !include datatypes/responses/provisioningExperienceResponse.raml 
  /interaction:
    /coverage: 
      post:
        is: [securityClient, request_headers]
        displayName: Create coverage
        description: Create coverage
        body:
          application/json:
            type: !include datatypes/requests/post-interactionCoverage.raml
            example: !include examples/requests/post-interactionCoverage.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/post-interactionCoverage.raml
                example: !include examples/responses/postInteractionCoverage.json

    /cancelService: 
      post:
        is: [securityClient, request_headers]
        displayName: Cancel Service
        description: Cancel Service
        body:
          application/json:
            type: !include datatypes/requests/post-interactionCancelService.raml
            example: !include examples/requests/post-interactionCancelService.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/post-interactionCancelService.raml
                example: !include examples/responses/postInteractionCancelService.json

    /changeSpeed: 
      post:
        is: [securityClient, request_headers]
        displayName: Change speed
        description: Change speed
        body:
          application/json:
            type: !include datatypes/requests/post-interactionChangeSpeed.raml
            example: !include examples/requests/post-interactionChangeSpeed.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/post-interactionChangeSpeed.raml
                example: !include examples/responses/postInteractionChangeSpeed.json
    /changeONT: 
      post:
        is: [securityClient, request_headers]
        displayName: Change ONT
        description: Change ONT
        body:
          application/json:
            type: !include datatypes/requests/post-interactionChangeONT.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/post-interactionChangeSpeed.raml
  /availability:
    /{orderNumber}:
      uriParameters:
        orderNumber:
          type: string
          required: true
          example: "MDM-MAY-0000001"
      post:
        is: [securityClient, request_headers]
        displayName: Check Order Availability
        description: Check Order Availability
        body:
          application/json:
            type: !include datatypes/requests/postAvailabilityOrder.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/postAvailabilityOrder.raml
          500:
            body:
              application/json:
                type: !include datatypes/responses/postAvailabilityOrderFail.raml
  /inventory:
    /{idServiceAccount}:
      get:
        is: [securityClient, request_headers]
        displayName: Consult Inventory
        description: This method consults inventory for a service account
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/responses/getInventory.raml
                example: !include examples/responses/getInventory.json


  /incident:
    post:
      is: [securityClient, request_headers]
      displayName: Create incident
      description: This operation create an incident
      body:
        application/json:
          type: !include datatypes/requests/postIncident.raml
          example: !include examples/requests/postIncident.json
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/responses/postIncident.raml
              example: !include /examples/responses/postIncident.json
    /{ticketNumber}:
        uriParameters:
          ticketNumber:
            type: string
            example: ""
        get:
          is: [securityClient,request_headers]        
          displayName: Get incident
          description: This operation gets an incident in Remedy
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/responses/GetIncident_response.raml
                  example: !include /examples/responses/GetIncident_responseExample.json
  
  /delivery:
    /manageReconnect:
      patch:
        is: [securityClient, request_headers]
        displayName: Manage Reconnect
        description: Manage Reconnect
        body:
          application/json:
            type: !include datatypes/requests/manageReconnectType.raml
            example: !include examples/requests/manageReconnectExample.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/responses/manageReconnectResponse.raml
                example: !include examples/responses/manageReconnect201Example.raml
  /borrowing-capacities:
    post:
      is: [securityClient, request_headers]
      displayName: Consult quota
      description: COnsult quota
      body:
        application/json:
          type: !include datatypes/requests/consultNegQuotaLISIM.raml
          example: !include examples/requests/consultNeguotaLISIM.raml
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/responses/consultNegQuotaLISIM.raml
              example: !include examples/responses/consultNegQuotaLISIM.raml
        500:
          body:
            application/json:
              type: !include datatypes/responses/errorResponseDataType.raml
  
  /cancelOrder:
    post:
      is: [securityClient, request_headers]
      displayName: Cancel Order
      description: Cancel Order
      body:
        application/json:
          type: !include datatypes/requests/postCancelOrder.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/responses/postCancelOrder.raml
        500:
          body:
            application/json:
              type: !include datatypes/responses/postCancelOrderFail.raml
  /subscription/replacement:
    post:
      is: [securityClient, request_headers]
      displayName: Subscription replacement
      description: Subscription replacement
      body:
        application/json:
          type: !include datatypes/requests/postSubscriptionReplacement.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/responses/postSubscriptionReplacement.raml
        500:
          body:
            application/json:
              type: !include datatypes/responses/internalServerError.raml            

  /omnicanalidad:
    /interaction:
      post:
        is: [securityClient, request_headers]
        displayName: Create interaction
        description: Create interaction in MDM_HSM_INTERACCION
        body:    
          application/json:  
            type: !include /datatypes/requests/post-omnicanalidadInteraction.raml
        responses:
          200:
            body:
              application/json:
                properties:
                  codigo:
                    type: string
                    example: "OK"
                  descripcion:
                    type: string
                    example: "Registro insertado"      
      get:
        is: [securityClient, request_headers]
        displayName: Get interaction by numeroWhatsapp
        description: Retrieve information about a interaction from MDM_HSM_INTERACCION
        queryParameters:
          numeroWhatsapp:
            type: string
            example: "999999999"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/responses/get-omnicanalidadInteraction.raml
      patch:
        is: [securityClient, request_headers]
        displayName: Update interaction and create interaction log
        description: Update interaction in MDM_HSM_INTERACCION and create a new interaction in MDM_HSM_INTERACCION_LOG
        queryParameters:
          numeroWhatsapp:
            type: string
            example: "999999999"
          idIteracion:
            type: string
            example: "ID"
        responses:
          200:
            body:
              application/json:
                properties:
                  codigo:
                    type: string
                    example: "OK"
                  descripcion:
                    type: string
                    example: "Registro actualizado"   
                
/sendNotification:
  /{campania}:
    uriParameters:
      campania:
        type: string
        example: "deg_notificacion1"
    post:
      is: [securityClient, request_headers]
      displayName: Gestionar los envíos de las notificaciones 
      description: Gestionar los envíos de las notificaciones
      body:
        application/json:
          type: !include /datatypes/requests/sendNotification.raml
          example: !include /examples/requests/sendNotification.json
      responses:
        200:
          description: Notificación enviada exitosamente
          body:
            application/json:
              properties:
                codigo: 
                  type: string
                  example: "200"
                descripcion: 
                  type: string
                  example: "Notificación enviada exitosamente"
        404:
          description: No se encontró la campaña
          body:
            application/json:
              properties:
                codigo: 
                  type: string
                  example: "404"
                descripcion: 
                  type: string
                  example: "La campaña solicitada no existe"
        500:
          description: Se ha generado una exceptión técnica y no fue posible continuar
          body:
            application/json:
              properties:
                codigo: 
                  type: string
                  example: "500"
                descripcion: 
                  type: string
                  example: "Se ha generado una exceptión técnica y no fue posible continuar"

/v1/esim/solicitarQResim:
  post:
    description: Procesar la solicitud de obtener y enviar una imagen png asociado a una eSIM.
    body:
      application/json:
        type: !include /datatypes/requests/solicitarQResimRequest.raml
        example: !include /examples/requests/solicitarQResimRequest.json
    responses:
      200:
        description: Documento PDF entregado exitosamente
        body:
          application/pdf:
            example: !binary |
              JVBERi0xLjQKJcTl8uXrp/Og0MTGCjQgMCBvYmogICUgZW50cmllcwo8PC9UeXBlIC9DYXRh
              bG9nL1BhZ2VzIDIgMCBSCj4+CmVuZG9iago1IDAgb2JqCjw8L1R5cGUgL1BhZ2UvUGFyZW50
              IDIgMCBSCi9NZWRpYUJveCBbMCAwIDU5NSA4NDJdCi9Db250ZW50cyA2IDAgUgo+PgplbmRv
              YmoK...
      400:
        description: Error en la solicitud
        body:
          application/json:
            type: object
            properties:
              status: integer
              code: string
              message:
                type: object
                properties:
                  message: string
              messageServer: string
              cause:
                type: array
                items:
                  type: object
                  properties:
                    origin: string
                    message: string
            #example: !include /examples/response/solicitarQResimResponse400.json
  