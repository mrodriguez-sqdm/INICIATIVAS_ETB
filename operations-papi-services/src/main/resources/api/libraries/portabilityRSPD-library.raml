#%RAML 1.0 Library
uses:
  numeracion: rejectedNumeration-library.raml
types:
  portability:
    type: object
    properties:
      portability:
        type: object
        required: true
        properties:
          Header:
            properties:
              identifier: 
                description: Portability transaction Id
                type: string
                example: "a174y00000B9WiMAAV"
                required: true
              observations:
                description: Comments related to port transaction
                type: string
                required: true
          Body:
            properties:
              RespuestaSolicitudPortacionDonante:
                properties:
                  RespuestaABD:
                    description: Request accepted or denied
                    type: string
                    example: "0"
                    required: true   
                  ListaNumeracionRechazada:
                    type: numeracion.rejectedNumerationType[]
                    required: true

