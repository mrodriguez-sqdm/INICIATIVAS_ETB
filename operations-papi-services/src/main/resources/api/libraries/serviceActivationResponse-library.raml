#%RAML 1.0 Library
types:
  customKey:
    type: object
    properties:
      applicationDN:
        type: string
        required: false
      'type':
        type: string
        required: false
      primaryKey:
        type: string
        required: false
  serviceActivationResponse:
    type: object
    properties:
      serviceActivationResponse:
        type: object
        required: true
        properties:
          applicationDN:
            type: string
            required: false
          eventTime:
            type: string
            required: false
          currentState:
            type: string
            required: false
          orderKey:
            type: customKey
            required: false
          reason:
            type: string
            required: false
          externalSystemId:
            type: string
            required: false
          eventId:
            type: string
            required: false
          eventStatus:
            type: string
            required: false
          infoParams:
            type: array
            required: false
            minItems: 1
            items:
              type: object
              properties:
                infoParam:
                  type: object
                  properties:
                    label:
                      type: string
                      required: true
                    group:
                      type: string
                      required: true
                    value:
                      type: string
                      required: true
                    serviceKey:
                      type: customKey
                      required: true
                    serviceId:
                      type: string
                      required: true
                    description:
                      type: string
                      required: true
          except:
            type: string
            required: false
          rollbackExcept:
            type: string
            required: false
  serviceActivationError:
    type: object
    properties:
      serviceActivationError:
        type: object
        required: true
        properties:
          applicationDN:
            type: string
            required: true
          eventTime:
            type: string
            required: true
          currentState:
            type: string
            required: true
          orderKey:
            type: customKey
            required: false
          reason:
            type: string
            required: true
          externalSystemId:
            type: string
            required: true
          eventId:
            type: string
            required: true
          eventStatus:
            type: string
            required: true
          serviceKey:
            type: customKey
            required: true
          infoParams:
            type: array
            required: false
            minItems: 1
            items:
              type: object
              properties:
                infoParam:
                  type: object
                  properties:
                    label:
                      type: string
                      required: true
                    group:
                      type: string
                      required: true
                    value:
                      type: string
                      required: true
                    serviceKey:
                      type: customKey
                      required: true
                    serviceId:
                      type: string
                      required: true
                    description:
                      type: string
                      required: true
          rollbackExcept:
            type: string
            required: true