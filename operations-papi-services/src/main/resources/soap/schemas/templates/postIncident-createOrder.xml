<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_WOIOrder_Create">
   <soapenv:Header>
      <urn:AuthenticationInfo>
         <urn:userName>#[p('remedy-ws.userName')]</urn:userName>
         <urn:password>#[p('remedy-ws.password')]</urn:password>
         <urn:authentication></urn:authentication>
         <urn:locale></urn:locale>
         <urn:timeZone></urn:timeZone>
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Create>
         <urn:ACCION>#[p('remedy-ws.action')]</urn:ACCION>
         <urn:IN_TipoIdentificacion>#[vars.orderData.Cliente_Tramite.Tipo_Documento]</urn:IN_TipoIdentificacion>
         <urn:IN_IdenCliente>#[vars.orderData.Cliente_Tramite.Numero_Documento]</urn:IN_IdenCliente>
         <urn:IN_Nro_OrdenSuma>#[vars.orderData.Numero_Orden]</urn:IN_Nro_OrdenSuma>
         <urn:IN_IDCTAServicio>#[vars.orderData.Servicio_Tramite.Id_Cuenta_Servicio]</urn:IN_IDCTAServicio>
         <urn:WOI_Notas>#[vars.inputPayload.body.observations]</urn:WOI_Notas>
         <urn:WOI_Resumen>#[vars.inputPayload.body.observations]</urn:WOI_Resumen>
         <urn:WOI_Nivel1>#[p('remedy-ws.level1')]</urn:WOI_Nivel1>
         <urn:WOI_Nivel2>#[vars.nivel2]</urn:WOI_Nivel2>
         <urn:IN_ID_Cuenta_Cliente>#[vars.orderData.Cliente_Tramite.Id_Cuenta_Cliente]</urn:IN_ID_Cuenta_Cliente>
         <urn:IN_Nombres_Cliente>#[vars.orderData.Cliente_Tramite.Nombres]</urn:IN_Nombres_Cliente>
         <urn:IN_Apellidos_Cliente>#[vars.orderData.Cliente_Tramite.Primer_Apellido]</urn:IN_Apellidos_Cliente>
         <urn:IN_Telefono_Cliente>#[vars.orderData.Cliente_Tramite.Telefono_Fijo]</urn:IN_Telefono_Cliente>
         <urn:IN_E-Mail_Cliente>#[vars.orderData.Cliente_Tramite.Email]</urn:IN_E-Mail_Cliente>
         <urn:IN_Ubicacion_Cliente>#[vars.orderData.Cliente_Tramite.Direcciones[0].Direccion_Normalizada]</urn:IN_Ubicacion_Cliente>
         <urn:IN_Direccion_Norm_Cliente>#[vars.orderData.Cliente_Tramite.Direcciones[0].Direccion_Normalizada]</urn:IN_Direccion_Norm_Cliente>
         <urn:IN_Direccion_No_Norm_Cliente>#[vars.orderData.Cliente_Tramite.Direcciones[0].Direccion_Normalizada]</urn:IN_Direccion_No_Norm_Cliente>
         <urn:IN_Codigo_Pais_Cliente>#[p('remedy-ws.idCountry')]</urn:IN_Codigo_Pais_Cliente>
         <urn:IN_Codigo_Edo_Prov_Cliente>#[vars.orderData.Cliente_Tramite.Direcciones[0].Codigo_Departamento]</urn:IN_Codigo_Edo_Prov_Cliente>
         <urn:IN_Codigo_Cd_Mun_Cliente>#[vars.orderData.Cliente_Tramite.Direcciones[0].Codigo_Municipio]</urn:IN_Codigo_Cd_Mun_Cliente>
         <urn:IN_UsuarioEscala>#[vars.inputPayload.body.user]</urn:IN_UsuarioEscala>
         <urn:IN_NroConexion></urn:IN_NroConexion>
         <urn:IN_Propietario_Red></urn:IN_Propietario_Red>
         <urn:IN_Vias_Acceso></urn:IN_Vias_Acceso>
      </urn:Create>
   </soapenv:Body>
</soapenv:Envelope>