    <flow name="bot-xapi-services-main">
        <http:listener path="/*" config-ref="bot-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <flow-ref doc:name="Call initial Logger" doc:id="81098545-97fc-425b-bb7a-e6e34fd1b97b" name="initial-loggin-Sub_Flow" />
        <apikit:router config-ref="bot-xapi-services-config" />
        <async doc:name="Async" doc:id="fcb55b49-b645-4079-a119-76d43179d2a0">
            <flow-ref doc:name="Call logger" doc:id="22f90db6-72ec-4ef4-8133-0567dbfe509c" name="loggin-client-call" />
        </async>
        <error-handler ref="common-error-handler-v2" />
    </flow>
    <flow name="bot-xapi-services-console">
        <http:listener path="/console/*" config-ref="bot-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="bot-xapi-services-config" />
    </flow>
