		<set-variable value='#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;    processname: "getParametersCities",&#10;}]' doc:name="Set variables" doc:id="3c97e241-705e-4db6-9d34-f618d3baa86e" variableName="variablesRequest" />
		<ee:transform doc:name="Set payload encrypted" doc:id="d496db42-511f-402e-bf7a-67622415ba5b">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var dane = attributes.queryParams.departamentDANE default null
---
{
  WSRequestHeader: {
    System: {
      Name: vars.headers.source,
      CorrelationID: vars.headers."x-correlation-id",
      ProcessingServer: vars.headers.source
    },
    Property: []
  },
  WSRequestBody: 
    {
      Audit: {
        Canal: vars.headers.name
      }
    } ++ 
    (
      if (dane != null and dane != "")
        { Departament_DANE: dane }
      else
        {}
    )
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Flow Reference" doc:id="622fe176-038e-430b-932d-7aa22acdaccd" name="get-parameters-sendClient-orchestadorSub_Flow"/>
