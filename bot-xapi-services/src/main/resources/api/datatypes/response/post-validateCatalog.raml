#%RAML 1.0 DataType

properties:
  responseHeader:
    type: object
    properties:
      system:
        type: !include objects/system.raml
        required: false
      service:
        type: !include objects/serviceStatus.raml
        required: false
      properties:
        type: array
        items: !include objects/property.raml
        required: false

  responseBody:
    type: object
    properties:
      result:
        type: object
        required: false
        properties:
          code:
            type: string
            required: false
          detail:
            type: string
            required: false
          message:
            type: string
            required: false
          messageUser:
            type: string
            required: false
          state:
            type: boolean
            required: false
          statusCode:
            type: integer
            required: false
      optionalServices:
        type: array
        required: false
        items:
          type: object          
          properties:
            id:
              type: string
              required: false
            name:
              type: string
              required: false
      serviceLine:
        type: string
        required: false