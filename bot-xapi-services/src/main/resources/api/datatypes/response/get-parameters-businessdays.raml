#%RAML 1.0 DataType

properties:
  responseHeader:
    type: object
    properties:
      system:
        type: !include objects/system.raml
        required: false
      service:
        type: !include objects/serviceStatus.raml
        required: false
      properties:
        type: array
        items: !include objects/property.raml
        required: false

  responseBody:
    type: object
    properties:
      businessDays:
        type: array
        items:
          type: object
          properties:
            date:
              type: string
              example: '2025-06-16T23:46:29.5644856+00:00'
              required: false
            day:
              type: string
              example: '16'
              required: false
            month:
              type: string
              example: '06'
              required: false
            monthStr:
              type: string
              example: Jun
              required: false
            year:
              type: string
              example: '2025'
              required: false
