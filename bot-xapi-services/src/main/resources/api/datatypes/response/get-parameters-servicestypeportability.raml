#%RAML 1.0 DataType

properties:
  responseHeader:
    type: object
    properties:
      system:
        type: !include objects/system.raml
        required: false
      service:
        type: !include objects/serviceStatus.raml
        required: false
      properties:
        type: array
        items: !include objects/property.raml
        required: false

  responseBody:
    type: object
    properties:
      servicesType:
        type: array
        items:
          type: object
          properties:
            serviceType:
              type: string
              example: "Prepago"
              required: false
            serviceTypeValue:
              type: string
              example: "1"
              required: false
