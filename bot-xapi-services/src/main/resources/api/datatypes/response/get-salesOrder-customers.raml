#%RAML 1.0 DataType

properties:
  responseHeader:
    type: object
    properties:
      system:
        type: !include objects/system.raml
        required: false
      service:
        type: !include objects/serviceStatus.raml
        required: false
      properties:
        type: array
        items: !include objects/property.raml
        required: false

  responseBody:
    type: object
    properties:
      address:
        type: string
        required: false
        example: "CRA 7 20 00"
      addresses: 
        type: array
        items: !include objects/address.raml
        required: false
      birthday:
        type: string
        required: false
        example: "2025-01-01"
      business:
        type: object
        required: false
        properties:
          address:
            type: string
            required: false
          businessName:
            type: string
            required: false
          department:
            type: string
            required: false
          economicActivity:
            type: string
            required: false
          email:
            type: string
            required: false
          legalRepresentative:
            type: !include objects/contact.raml
            required: false
          phone:
            type: string
            required: false
          city:
            type: string
            required: false
      category:
        type: string
        required: false
      city:
        type: string
        required: false
      cityDane:
        type: string
        required: false
      cityMongo:
        type: string
        required: false
      civilStatus:
        type: string
        required: false
      contacts: 
        type: array
        items: !include objects/contact.raml
        required: false
      companyShortName:
        type: string
        required: false
      customerType:
        type: string
        required: false
      datacreditAuthorization:
        type: string
        required: false
      departament:
        type: string
        required: false
      departamentDane:
        type: string
        required: false
      departamentMongo:
        type: string
        required: false
      district:
        type: string
        required: false
      documentIssuance:
        type: object
        required: false
        properties:
          city:
            type: string
            required: false
          cityDane:
            type: string
            required: false
          date:
            type: string
            required: false
          department:
            type: string
            required: false
          departmentDane:
            type: string
            required: false
      documentNumber:
        type: string
        required: false
      documentType:
        type: string
        required: false
      email:
        type: string
        required: false
      habeasData:
        type: !include objects/habeasData.raml
        required: false
      landLine:
        type: string
        required: false
      location:
        type: string
        required: false
      mobilePhone:
        type: string
        required: false
      name:
        type: string
        required: false
      names:
        type: string
        required: false
      scoreFttx:
        type: !include objects/score.raml
        required: false
      scoreLte:
        type: !include objects/score.raml
        required: false
      secondSurname:
        type: string
        required: false
      segment:
        type: string
        required: false
      segmentUen:
        type: string
        required: false
      services:
        type: array
        required: false
        items: any
      state:
        type: string
        required: false
      surname:
        type: string
        required: false
      uen:
        type: string
        required: false
      validationCode:
        type: object
        required: false
        properties:
          lockCode:
            type: boolean
            required: false
          validationLisim:
            type: boolean
            required: false
      value:
        type: string
        required: false