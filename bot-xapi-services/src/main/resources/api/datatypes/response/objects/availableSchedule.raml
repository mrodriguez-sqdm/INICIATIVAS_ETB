#%RAML 1.0 DataType
properties:
  date:
    type: string
    required: false
  booking:
    type: boolean
    required: false
  timeSlots:
    type: array
    required: false
    items:
      type: object
      properties:
        timeSlot:
          type: string
          required: false
        timeSlotUser:
          type: string
          required: false