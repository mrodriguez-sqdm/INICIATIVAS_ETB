#%RAML 1.0 DataType
properties:
  features:
    type: array
    required: false
    items:
      type: object
      properties:
        description:
          type: string
          required: false
        differential:
          type: boolean
          required: false
        discount:
          type: boolean
          required: false
        outstanding:
          type: boolean
          required: false
        type:
          type: string
          required: false
  month:
    type: integer
    required: false
  saving:
    type: number
    required: false
  savingStr:
    type: string
    required: false
  state:
    type: string
    required: false
  value:
    type: number
    required: false
  valueStr:
    type: string
    required: false