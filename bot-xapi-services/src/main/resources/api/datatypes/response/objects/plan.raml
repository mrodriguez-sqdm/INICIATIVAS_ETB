#%RAML 1.0 DataType
properties:
  available:
    type: boolean
    required: false
  contracted:
    type: boolean
    required: false
  description:
    type: array
    items: string
    required: false
  executionPlan:
    type: array
    items: !include executionPlan.raml
    required: false
  id:
    type: string
    required: false
  idsPackaging:
    type: array
    items: string
    required: false
  installationCharges:
    type: !include installationCharges.raml
    required: false
  isPacking:
    type: boolean
    required: false
  isZoned:
    type: boolean
    required: false
  name:
    type: string
    required: false
  nameTechnical:
    type: string
    required: false
  outStanding:
    type: boolean
    required: false
  price:
    type: !include price.raml
    required: false
  retencion:
    type: boolean
    required: false
  saving:
    type: number
    required: false
  savingStr:
    type: string
    required: false
  stratum:
    type: string
    required: false
  subType:
    type: string
    required: false
  svasFeatured:
    type: array
    required: false
    items:
      type: object
      properties:
        description:
          type: string
          required: false
        link:
          type: string
          required: false
  svasIncluded:
    type: array
    required: false
    items:
      type: object
      properties:
        id:
          type: string
          required: false
        mandatory:
          type: boolean
          required: false
  technology:
    type: string
    required: false
  type:
    type: string
    required: false
  value:
    type: number
    required: false
  valueStr:
    type: string
    required: false
  zoned:
    type: !include zoned.raml
    required: false
  home:
    type: object
    required: false
    properties:
      internet:
        type: !include internet.raml
        required: false
      tv:
        type: !include tv.raml
        required: false
      voice:
        type: !include voice.raml
        required: false
  mobile:
    type: !include mobile.raml
    required: false
  internet:
    type: !include internet.raml
    required: false
  promotions:
    type: array
    items: !include promotion.raml
    required: false
  rateIncrease:
    type: array
    required: false
    items:
      properties:
        date:
          type: datetime
          required: false
        value:
          type: !include value.raml
          required: false
        withdrawal:
          type: !include order.raml
          required: false
  rateIncreaseTotal:
    type: !include value.raml
    required: false
  order:
    type: !include order.raml
    required: false
  sms:
    type: !include sms.raml
    required: false
  totalDevices:
    type: integer
    required: false
  tv:
    type: !include tv.raml
    required: false
  voice:
    type: !include voice.raml
    required: false