#%RAML 1.0 DataType
properties:
  address:
    type: string
    required: false
  authorized:
    type: boolean
    required: false
  documentNumber:
    type: string
    required: false
  documentType:
    type: string
    required: false
  email:
    type: string
    required: false
  phone:
    type: string
    required: false
  habeasData:
    type: !include habeasData.raml
    required: false
  name:
    type: string
    required: false
  firstName:
    type: string
    required: false
  secondName:
    type: string
    required: false
  secondSurname:
    type: string
    required: false
  surname:
    type: string
    required: false