#%RAML 1.0 DataType
properties:
  scheduleInfo:
    type: object
    required: false
    properties:
      available:
        type: array
        items: !include scheduleData.raml
        required: false
      isPending:
        type: boolean
        required: false
      selected:
        type: !include scheduleData.raml
        required: false
      trackingMap:
        type: string
        required: false
  basicInformation:
    type: object
    required: false
    properties:
      cun:
        type: string
        required: false
      id:
        type: string
        required: false
      origin:
        type: object
        required: false
        properties:
          channel:
            type: string
            required: false
          creationDate:
            type: datetime
            required: false
          subChannel:
            type: string
            required: false
          user:
            type: string
            required: false
      state:
        type: string
        required: false
      type:
        type: string
        required: false
  files:
    type: array
    required: false
    items:
      type: object
      properties:
        name:
          type: string
          required: false
        url:
          type: string
          required: false
  withdrawalDate:
    type: datetime
    required: false