#%RAML 1.0 DataType
properties:
  date:
    type: datetime
    required: false
  technician:
    type: object
    required: false
    properties:
      id:
        type: string
        required: false
      name:
        type: string
        required: false
  timeSlot:
    type: array
    required: false
    items:
      type: object
      properties:
        technique:
          type: string
          required: false
        user:
          type: string
          required: false
  state:
    type: string
    required: false