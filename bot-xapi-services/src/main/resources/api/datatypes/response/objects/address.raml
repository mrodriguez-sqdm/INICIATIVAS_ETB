#%RAML 1.0 DataType
properties:
  address:
    type: string
    required: false
    example: "CRA 7 20 00"
  addressType:
    type: string
    required: false
    example: "INSTALACION"
  id:
    type: integer
    required: false
    example: 1
  name:
    type: string
    required: false
    example: ""
  selected:
    type: boolean
    required: false
  state:
    type: string
    required: false
    example: ""
  city:
    type: object
    required: false
    properties:
      id:
        type: string
        required: false
      name:
        type: string
        required: false
  department:
    type: object
    required: false
    properties:
      id:
        type: string
        required: false
      name:
        type: string
        required: false
  country:
    type: object
    required: false
    properties:
      id:
        type: string
        required: false
      name:
        type: string
        required: false
  coverage:
    type: object
    required: false
    properties:
      distanceType:
        type: string
        required: false
      gisAddress:
        type: string
        required: false
      idPlot:
        type: string
        required: false
      latitude:
        type: number
        required: false
      longitude:
        type: number
        required: false
      molecule:
        type: string
        required: false
      name:
        type: string
        required: false
      olt:
        type: string
        required: false
      owner:
        type: string
        required: false