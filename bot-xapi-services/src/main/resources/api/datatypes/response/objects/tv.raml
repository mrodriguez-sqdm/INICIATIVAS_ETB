#%RAML 1.0 DataType
properties:
  channels:
    type: array
    required: false
    items:
      type: object
      properties:
        name:
          type: string
          required: false
        number:
          type: string
          required: false
        section:
          type: string
          required: false
  numberOfChannels:
    type: integer
    required: false
  planType:
    type: string
    required: false
  secundary:
    type: array
    items: !include secundary.raml
    required: false
  svas:
    type: array
    items: !include sva.raml
    required: false