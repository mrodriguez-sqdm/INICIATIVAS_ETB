#%RAML 1.0 DataType
properties:
  apps:
    type: array
    items:
      type: object
      properties:
        description:
          type: string
          required: false
        icon:
          type: string
          required: false
        name:
          type: string
          required: false
    required: false
  internet:
    type: !include internet.raml
    required: false
  pasagigas:
    type: object
    required: false
    properties:
      enabled:
        type: boolean
        required: false
      quantity:
        type: boolean
        required: false
  preactiveSims:
    type: object
    required: false
    properties:
      quantity:
        type: integer
        required: false
      message:
        type: string
        required: false
  sms:
    type: !include sms.raml
    required: false
  voice:
    type: !include voice.raml
    required: false