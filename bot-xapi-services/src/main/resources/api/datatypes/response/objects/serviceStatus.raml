#%RAML 1.0 DataType
properties:
  status:
    type: string
    required: false
    example: "OK"
  responseDate:
    type: datetime
    required: false
    example: 2025-01-29T18:09:16.210669Z
  processingServer:
    type: string
    required: false
    example: ""
  statusDetail:
    type: array
    required: false
    items:
      type: object
      properties:
        errorCode:
          type: string
          required: false
          example: "OK_01"
        errorDetailCode:
          type: string
          required: false
          example: "La solicitud fue exitosa, el cliente fue consultado"
        errorMessage:
          type: string
          required: false
          example: "La solicitud TIENDA-29012025189-411648690 fue exitosa. El cliente fue consultado."
        errorMessageUser:
          type: string
          required: false
          example: "Falla por error de parametros"