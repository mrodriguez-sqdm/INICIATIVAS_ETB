#%RAML 1.0 DataType

properties:
  responseHeader:
    type: object
    properties:
      system:
        type: !include objects/system.raml
        required: false
      service:
        type: !include objects/serviceStatus.raml
        required: false
      properties:
        type: array
        items: !include objects/property.raml
        required: false

  responseBody:
    type: object
    required: false
    properties:
      isNew:
        type: boolean
        required: false
      schedule:
        type: object
        required: false
        properties:
          date:
            type: string
            required: false
            example: "2025-01-31"
          isBooking:
            type: boolean
            required: false
          timeSlot:
            type: string
            required: false
          timeSlotUser:
            type: string
            required: false
      communications:
        type: object
        required: false        
        properties:
          communicationChannels:
            type: string
            required: false
          communicationSchedules:
            type: string
            required: false
          communicationUpdate:
            type: boolean
            required: false
      contact:
        type: !include objects/contact.raml
        required: false
      creationDate:
        type: datetime
        required: false
      cun:
        type: string
        required: false
      customer:
        type: !include objects/customer.raml
        required: false
      executionPlan:
        type: array
        items: !include objects/executionPlan.raml
        required: false
      installationAddress:
        type: object
        required: false
        properties:
          address:
            type: string
            required: false
            example: "CRA 7 20 00"
          city:
            type: string
            required: false
          codCityDane:
            type: string
            required: false
          codDeptoDane:
            type: string
            required: false
          department:
            type: string
            required: false
          latitude:
            type: number
            required: false
          longitude:
            type: number
            required: false
          stratum:
            type: string
            required: false
          zone:
            type: string
            required: false
      installationCharges:
        type: !include objects/installationCharges.raml
        required: false
      notifications:
        type: array
        required: false
        items:
          type: object
          properties:
            configuration:
              type: object
              required: false
              properties:
                isEnabled:
                  type: boolean
                  required: false
                isEnabledAlerts:
                  type: boolean
                  required: false
                isEnabledPreviews:
                  type: boolean
                  required: false
                isEnabledSound:
                  type: boolean
                  required: false
            date:
              type: datetime
              required: false
            isCampaign:
              type: boolean
              required: false
            read:
              type: boolean
              required: false
            message:
              type: string
              required: false
            recipient:
              type: string
              required: false
            subject:
              type: string
              required: false
            type:
              type: string
              required: false
      numOrder:
        type: string
        required: false
      plan:
        type: !include objects/plan.raml
        required: false
      retake:
        type: object
        required: false
        properties:
          isAvailable:
            type: boolean
            required: false
          reasonState:
            type: string
            required: false
          state:
            type: string
            required: false
          step:
            type: string
            required: false
      svas:
        type: array
        items: !include objects/sva.raml
        required: false
      idValidation:
        type: integer
        required: false
      reachTheScore:
        type: boolean
        required: false
      score:
        type: integer
        required: false
      scheduleAvailable:
        type: array
        items: !include objects/availableSchedule.raml
        required: false