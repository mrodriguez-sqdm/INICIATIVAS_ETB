#%RAML 1.0 DataType 
type: object
properties:
  billingAddress:
    type: string
    example: ''
    required: false
  deliveryAddress:
    type: object
    properties:
      address:
        type: string
        example: 'Cl. 83 Bis #23, Bogotá, Colombia'
        required: false
      city:
        type: string
        example: BOGOTA D.C.
        required: false
      cityDane:
        type: string
        example: '11001'
        required: false
      department:
        type: string
        example: BOGOTA
        required: false
      departmentDane:
        type: string
        example: '11'
        required: false
      district:
        type: string
        example: Pastranita
        required: false
  deliveryType:
    type: string
    example: ENTREGA ESPECIALIZADA
    required: false
  deliveryInvoiceType:
    type: string
    example: Electronica
    required: false
  orderNumber:
    type: string
    example: MDM-PLTE-022940
    required: false
  order:
    type: object
    properties:
      flow:
        type: string
        example: LTE
        required: false
