#%RAML 1.0 DataType
properties:
  typeDocument:
    type: string
    enum: ["CC","CE","TI","NIT","RUT"]
    required: false
    example: "CC"
  numberDocument:
    type: string
    maxLength: 80
    required: false    
    example: "10266547962"
  groupNumbers:
    required: false
    type: array
    items:
      type: object
      properties:
        id:
          type: string
          required: false
        name:
          type: string
          required: false
  filter:
    required: false
    type: object
    properties:
      contractedOffer:
        type: boolean
        required: false
  numOrder:
    type: string
    required: false
  phone:
    type: string
    required: false
  score:
    type: string
    required: false