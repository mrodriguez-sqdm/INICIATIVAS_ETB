#%RAML 1.0 DataType 
type: object
properties:
  orderNumber:
    type: string
    example: MDM-PLTE-022940
    required: false
  attributes:
    type: array
    items:
      type: object
      properties:
        attribute:
          type: string
          example: usuarioId
          required: false
        value:
          type: string
          example: '6707'
          required: false
