#%RAML 1.0 DataType
type: object
properties:
  codeResponse:
    type: string
    example: "200"
  messageResponse:
    type: string
    example: "OK"
  resultCode:
    type: string
    example: "0000"
  resultMsg:
    type: string
    example: "success"
  accountStatement:
    type: string
    description: Base64-encoded document (e.g. PDF) content
    example: "JVBERi0xLjQKJeLjz9MKNCAwIG9iago8PC9GaWx0ZXIv..."