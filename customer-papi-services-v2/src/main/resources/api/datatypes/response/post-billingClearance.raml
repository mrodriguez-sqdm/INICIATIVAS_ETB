#%RAML 1.0 DataType
type: object
description: |
  Response for billingClearance (applyETBCertification). ZSmart: applyETBCertification v0.9.
  dueAmount='0' means no debt — certificate was sent to the provided email.
  dueAmount>0 means active debt — certificate NOT sent; channel must inform the customer of the amount owed.
  resultCode != '0000' means a ZSmart business error — see resultMsg for detail.
properties:
  codeResponse:
    type: string
    description: "HTTP-level response code from ZSmart. '200' = success."
    example: '200'
    required: true
  messageResponse:
    type: string
    description: "HTTP-level response message from ZSmart."
    example: 'OK'
    required: true
  resultCode:
    type: string
    description: "'0000' = success. Any other value = ZSmart business error — see resultMsg."
    example: '0000'
    required: true
  resultMsg:
    type: string
    description: "Descriptive result message from ZSmart."
    example: 'Success'
    required: true
  dueAmount:
    type: string
    description: "Outstanding balance with 2 decimals. '0' = no debt, certificate sent. Positive value (e.g. '234334.90') = active debt, certificate NOT sent."
    example: '0'
    required: true
