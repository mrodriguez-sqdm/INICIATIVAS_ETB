    type: array
    required: false
  interactionsInfo:
    type: array
    required: false
  pqrsInfo:
    type: array
    required: false
  billingsInfo:
    type: array
    required: false
  withholdingsInfo:
    type: array
    required: false
  promotionsInfo:
    type: array
    required: false
  servicesInfo:
    type: array
    required: false
  ordersInfo:
    type: array
    required: false
  schedulingInfo:
    type: array
    required: false