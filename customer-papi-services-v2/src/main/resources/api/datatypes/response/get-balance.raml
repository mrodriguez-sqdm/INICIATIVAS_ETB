#%RAML 1.0 DataType
description: Consulta de balance — COD_RES (responseCode) / RES (response) y OBJ BALANCE (balance).
type: object
properties:
  responseCode:
    type: string
    example: "200"
  response:
    type: string
    example: "OK"
  balance:
    type: object
    description: Mapped subscription/balance view (TMF-aligned fields from JSC subscription).
    additionalProperties: true
