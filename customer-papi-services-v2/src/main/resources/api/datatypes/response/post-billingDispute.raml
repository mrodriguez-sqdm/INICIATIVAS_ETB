#%RAML 1.0 DataType
type: object
description: |
  Response for billingDispute (CreateDispute). ZSmart: CreateDispute v2.1.
properties:
  codeResponse:
    type: string
    description: "HTTP-level response code from ZSmart. '200' = success."
    example: '200'
    required: true
  messageResponse:
    type: string
    description: "HTTP-level response message from ZSmart."
    example: 'OK'
    required: true
  resultCode:
    type: string
    description: "'0000' = success. Any other value = ZSmart business error — see resultMsg."
    example: '0000'
    required: true
  resultMsg:
    type: string
    description: "Descriptive result message from ZSmart."
    example: 'Success'
    required: true
  transactionId:
    type: string
    minLength: 1
    maxLength: 60
    description: "transaction ID that generate by external system (e.g. 20260918220345) -> result.transactionID"
    example: "20260918220345"
    required: true
  disputes:
    type: array
    required: true
    items:
      type: object
      properties:
        disputeId:
          type: string
          minLength: 1
          maxLength: 12
          description: "Dispute ID (e.g. 542132659854). -> result.disputeExParam[n].disputeId"
          example: '542132659854'
          required: true
        charge:
          type: string
          minLength: 1
          maxLength: 18
          description: "Dispute Amount (e.g. 800000). -> content.disputeExParam[n].disputeId"
          example: '800000'
          required: true
example: !include ../../examples/response/post-billingDispute.json
