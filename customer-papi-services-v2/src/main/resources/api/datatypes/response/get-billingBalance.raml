#%RAML 1.0 DataType
type: object
description: |
  Subscriber billing account balance from ZSmart (queryAccountbalance — v0.8).
  Negative balance = account has money; positive = account has debt.
  Expired balances are not included in the response.

  **Single Account (by CONNECTION_NUMBER or BILLING_ACCOUNT):**
  Returns balance data in `accounts[0].balances[]` array for that single account.

  **Multiple Accounts (Document Lookup by CUSTOMER_ID_TYPE + CUSTOMER_ID):**
  customer-papi resolves document to multiple billing accounts via mongo-sapi (MDM_CUENTA_FACTURACION).
  For each account, ZSmart queryAccountbalance is called independently.
  Returns array of account results in `accounts[]`, where each item contains accountNumber + balances[].
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: 'OK'
    required: false
  
  summary:
    type: object
    required: false
    description: |
      Summary of billing accounts proccessed
    properties:
      totalAccounts:
        type: integer
        description: "total accounts"
        example: 2
        required: true
      processedAccounts:
        type: integer
        description: "sucessful accounts"
        example: 2
        required: true
      failedAccounts:
        type: integer
        description: "Failed accounts"
        example: 0
        required: true

  failedAccounts:
    type: array
    required: false
    description: |
      List of failed billing accounts 
    items:
      type: object
      properties:
        status:
          type: string
          description: "failed status"
          example: 'failed'
          required: true
        billingError:
          type: string
          description: "billing execution error"
          example: 'error description'
          required: true
        accountNumber:
          type: string
          description: "Failed billing account number"
          example: '14000001234'
          required: true
  
  accounts:
    type: array
    required: false
    description: |
      List of billing accounts with their balance data.
      - Single account query (by CONNECTION_NUMBER or BILLING_ACCOUNT): array with 1 item
      - Multiple account query (by CUSTOMER_ID_TYPE + CUSTOMER_ID): array with N items (one per resolved account from MDM)
    items:
      type: object
      properties:
        accountNumber:
          type: string
          description: "Billing account number (from ZSmart or MDM_CUENTA_FACTURACION)"
          example: '14000001234'
          required: true
        balances:
          type: array
          required: false
          description: "Balance entries for this specific account (ZSmart queryAccountbalance result)"
          items:
            type: object
            properties:
              balanceId:
                type: string
                description: "Balance instance ID. ZSmart: balID"
                example: '1105'
                required: false
              balanceTypeCode:
                type: string
                description: "Balance type code. ZSmart: acctResCode"
                example: LOCAL_CURRENCY
                required: false
              balanceTypeName:
                type: string
                description: "Balance type name. ZSmart: acctResName"
                example: Local Currency
                required: false
              balance:
                type: string
                description: |
                  Current available balance in PESO.
                  Negative = account has money (e.g. -200.20 means customer has $200.20 credit).
                  Positive = account has debt.
                  ZSmart: balance
                example: '-145000.00'
                required: false
              effectiveDate:
                type: string
                description: "Balance effective date YYYY-MM-DD HH:MM:SS. ZSmart: effDate"
                example: '2026-01-01 00:00:00'
                required: false
              expirationDate:
                type: string
                description: "Balance expiration date YYYY-MM-DD HH:MM:SS. ZSmart: expDate"
                example: '2049-12-31 23:59:59'
                required: false
              lastUpdateDate:
                type: string
                description: "Date of latest balance update YYYY-MM-DD HH:MM:SS. ZSmart: updateDate"
                example: '2026-03-10 13:56:44'
                required: false
