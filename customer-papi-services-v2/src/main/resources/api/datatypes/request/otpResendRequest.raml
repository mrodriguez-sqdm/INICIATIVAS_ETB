#%RAML 1.0 DataType
type: object
properties:
  id:
    type: integer
    description: Client Identity ID
    required: true
    example: 1234
  type:
    type: integer
    required: true
    enum: [1, 2, 3]
    description: |
      Send type used for OTP Resend:
        - 1 = SMS  
        - 2 = Phone Call
        - 3 = Email