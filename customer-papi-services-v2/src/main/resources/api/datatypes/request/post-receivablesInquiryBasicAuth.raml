#%RAML 1.0 DataType
type: object
additionalProperties: false
properties:
  username:
    type: string
    example: "banco_bogota_etb"
    required: true
  password:
    type: string
    example: "**********"
    required: true
  origin:
    type: string
    example: "BANCO"
    required: true
  channelCode:
    type: string
    example: "USSD"
    description: Codigo de Canal
    required: true
  connectionNumber:
    type: string
    example: "6015551234"
    description: |
      Service MSISDN (area code + number). Search key.
      ZSmart: msisdn. At least one search key must be present.
    required: false
  billingAccount:
    type: string
    example: "14000001234"
    description: |
      ZSmart billing account number. Search key.
      ZSmart: accountNumber. At least one search key must be present.
    required: false
  customerIdType:
    type: string
    enum: ["CC","CE","NIT","PEP","PPT"]
    example: "CC"
    description: |
      Document type. Compound key — must be sent together with CUSTOMER_ID. ZSmart spec values:
      - CC: CEDULA DE CIUDADANIA
      - CE: CEDULA DE EXTRANJERIA
      - NIT: NIT
      - PEP: PERMISO ESPECIAL PERMANENCIA
      - PPT: PERMISO PROECCION TEMPORAL
    required: false
  customerId:
    type: string
    example: "1023456789"
    description: |
      Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
      ZSmart: resolved to accountNumber via customer lookup.
    required: false
example: !include ../../examples/request/post-receivablesInquiryBasicAuth.json