#%RAML 1.0 DataType
displayName: Transfer Balance Request
type: object
properties:
  msisdnOrig:
    type: string
    description: MSISDN de la línea de origen
    example: "3058966578"
  msisdnDest:
    type: string
    description: MSISDN de la línea de destino
    example: "3054126598"
  amount:
    type: number
    description: Monto a transferir
    example: 500
  externalIDorig?:
    type: string
    description: Identificador externo de la línea de origen (opcional)
    example: "MDM-PLTE-021957-1"
  externalIDest?:
    type: string
    description: Identificador externo de la línea de destino (opcional)
    example: "MDM-PLTE-056478-1"
