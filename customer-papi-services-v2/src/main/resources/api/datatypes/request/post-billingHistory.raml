#%RAML 1.0 DataType
type: object
additionalProperties: false
properties:
  # user:
  #   type: string
  #   description: User Credential Provided from the bank
  #   required: true
  #   example: "BANK_USER"
  # pass:
  #   type: string
  #   description: Pass Credential Provided from the bank
  #   required: true
  #   example: "BANK_PASS"
  origin:
    type: string
    example: "BANCOLOMBIA"
    description: Banco de origen
    required: true
  channelCode:
    type: string
    example: "USSD"
    description: Codigo de Canal
    required: true
  connectionNumber:
    type: string
    example: "6015551234"
    description: |
      Service MSISDN (area code + number). Search key.
      ZSmart: msisdn. At least one search key must be present.
    required: false
  billingAccount:
    type: string
    example: "14000001234"
    description: |
      ZSmart billing account number. Search key.
      ZSmart: accountNumber. At least one search key must be present.
    required: false
  customerIdType:
    type: string
    enum: ["CC","CE","NIT","PEP","PPT"]
    example: "CC"
    description: |
      Document type. Compound key — must be sent together with CUSTOMER_ID. ZSmart spec values:
      - CC: CEDULA DE CIUDADANIA
      - CE: CEDULA DE EXTRANJERIA
      - NIT: NIT
      - PEP: PERMISO ESPECIAL PERMANENCIA
      - PPT: PERMISO PROECCION TEMPORAL
    required: false
  customerId:
    type: string
    example: "1023456789"
    description: |
      Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
      ZSmart: resolved to accountNumber via customer lookup.
    required: false
  invoiceNumber:
    type: string
    example: "INV-2026-001234"
    description: "Filter by specific invoice number. ZSmart: invoiceNumber."
    required: false
  startTime:
    type: string
    example: "2026-01-01"
    description: |
      Filter start date YYYY-MM-DD. If provided, END_TIME is also required.
      Bills filtered by billing cycle end date within the range.
      ZSmart: startTime.
    required: false
  endTime:
    type: string
    example: "2026-03-31"
    description: |
      Filter end date YYYY-MM-DD. If provided, START_TIME is also required.
      Max range: 6 months from START_TIME. ZSmart: endTime.
    required: false
  billType:
    type: string
    enum: ["1","2","3"]
    example: "1"
    description: |
      Invoice type filter. 1=Monthly invoice, 2=Sales invoice, 3=Instant Bill.
      Omit to return all types. ZSmart: billType.
    required: false
  limit:
    type: number
    example: 10
    description: Maximum number of invoices to return.
    required: false
  offset:
    type: number
    example: 0
    description: Pagination offset.
    required: false
example: !include ../../examples/request/post-billingHistory.json