#%RAML 1.0 DataType 
type: object
properties:
  channel:
    type: integer
    description: Channel Identifier
    example: 1
    required: false
  documentNumber:
    type: string
    description: Client document number
    example: '12345678'
    required: true
  documentType:
    type: integer
    description: Client document type
    example: 1
    required: true
  names:
    type: string
    description: Client name or names
    example: "Juan Manuel"
    required: false
  firstLastName:
    type: string
    description: Client first last name
    example: "Perez"
    required: true
  secondLastName:
    type: string
    description: Client second last name
    example: "Pereira"
    required: false
  cellphone:
    type: string
    description: Client mobile number
    example: '3001234567'
    required: true
  email:
    type: string
    description: Client email address
    example: 'laim@lisim.com'
    required: true
  dateExpedition:
    type: datetime-only
    description: Document expedition date
    example: '2020-01-01T00:00:00'
    required: true
  provider:
    type: integer
    description: Identifier for LISIM
    example: 1
    required: false
  adviser:
    type: string
    description: Restrictions for LISIM
    example: '1'
    required: false
  portal:
    type: integer
    description: LISIM app identifier
    example: 1
    required: false
  model:
    type: object
    properties:
      technology:
        type: string
        description: Technology type
        enum:
          - LTE
          - FIJA
        required: true
      segment:
        type: string
        description: Market Segment 
        enum:
          - Hogares
          - MiPymes
        required: true