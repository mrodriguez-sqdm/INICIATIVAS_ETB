#%RAML 1.0 DataType
type: object
description: |
  Request body for billingClearance (paz y salvo / debt-free certificate).
  Queries the customer's due amount in ZSmart (applyETBCertification).
  If the customer is not in dunning status, a certification document is sent to the provided email.
properties:
  msisdn:
    type: string
    minLength: 1
    maxLength: 20
    description: "MSISDN with area code (e.g. 6015551234). -> applyETBCertification.msisdn"
    example: '6015551234'
    required: true
  email:
    type: string
    minLength: 1
    maxLength: 100
    description: "Destination email for the paz y salvo certificate. Only sent by ZSmart if dueAmount is '0'. -> applyETBCertification.email"
    example: 'juan.perez@email.com'
    required: true
