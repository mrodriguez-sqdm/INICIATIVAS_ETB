<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-customerBillBalance-orchestratorSub_Flow" doc:id="68cef838-14a3-4229-850d-b88ea2241d66" >
		<ee:transform doc:name="set billing variables" doc:id="6bff95bc-155f-495d-8b44-e67917660da4">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="headers" ><![CDATA[%dw 2.0
output application/json
---
{
	"client_secret": p('mongo-db-sapi.security.client-secret'),
	"client_id": p('mongo-db-sapi.security.client-id'),
	"name": vars.headers.name,
	"X-CORRELATION-ID": vars.headers."X-CORRELATION-ID",
	"source": vars.headers.source,
	"systemId": vars.headers.systemId
}]]></ee:set-variable>
				<ee:set-variable variableName="parameters" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams]]></ee:set-variable>
				<ee:set-variable variableName="targetSystem" ><![CDATA[%dw 2.0
output application/java
---
attributes.headers.'x-target-system']]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="f918ba92-4a4e-415e-aa48-6c04ce127c2b" >
			<when expression='#[vars.targetSystem == "2"]' >
				<flow-ref doc:name="get-billingBalance-zsmart-orchestratorSub_Flow" doc:id="6b596028-7924-44d8-bb24-13ff60d68177" name="get-billingBalance-zsmart-orchestratorSub_Flow" />
			</when>
			<otherwise >
				<flow-ref doc:name="post-getbalance-bill-orchestratorSub_Flow" doc:id="17191eb9-1080-4e95-a241-14d7612e5edc" name="post-getbalance-bill-orchestratorSub_Flow" />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
