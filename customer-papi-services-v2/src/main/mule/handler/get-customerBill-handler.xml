<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-customerBill-handlerSub_Flow" doc:id="b4432beb-4785-4516-a605-8b9451287118" >
		<ee:transform doc:name="set headers - parameters - targetSystem variables" doc:id="493d99b1-3162-4770-b23a-dcb3cec0d7fd" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="parameters" ><![CDATA[%dw 2.0
output application/java
---
attributes.queryParams]]></ee:set-variable>
				<ee:set-variable variableName="targetSystem" ><![CDATA[%dw 2.0
output application/java
---
attributes.headers.'x-target-system']]></ee:set-variable>
				<ee:set-variable variableName="headers" ><![CDATA[%dw 2.0
output application/json
---
{
	"client_secret": p('bot-sapi.security.client-secret'),
	"client_id": p('bot-sapi.security.client-id'),
	"name": attributes.headers.name,
	"X-CORRELATION-ID": attributes.headers."X-CORRELATION-ID",
	"source": attributes.headers.source,
	"systemId": attributes.headers.systemId
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="validate targetSystem" doc:id="c5b94196-5b05-4d59-b3f9-5e679375c34a" >
			<when expression='#[vars.targetSystem == "1"]'>
				<flow-ref doc:name="get-customerBill-rmca-orchestratorSub_Flow" doc:id="d2ffd5b6-d6b5-4a47-a180-da002bcc186f" name="get-customerBill-rmca-orchestratorSub_Flow"/>
			</when>
			<otherwise >
				<flow-ref doc:name="get-customerBill-zsmart-orchestratorSub_Flow" doc:id="50d948e7-8d2c-438b-a273-f7ff1c38cec6" name="get-customerBill-zsmart-orchestratorSub_Flow"/>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
