#%RAML 1.0 DataType
properties:
  integrationId:
    description: "Identificador único de la línea LTE a relacionar a la bolsa compartida."
    type: string
    required: false
    example: "AC-0000000"
  msisdn:
    description: "Identificador único de la línea LTE MSISDN relacionar a la bolsa compartida."
    type: string
    required: false
    example: "3057135005"
  id:
    description: "Identificador del paquete/APN. Se usa en CreateOrder (packages[0].id)."
    type: string
    required: true
    example: "D000"
  direccionIP:
    description: "Corresponde al PDP IP Address a relacionar al subscripton."
    type: string
    required: true
    example: "111.22.11.0"
  nombreAPNCliente:
    description: "Nombre del APN privado o virtual del cliente. Se usa para el feature DataStrategy (extString)."
    type: string
    required: true
    example: "COMPANY123DATOS.ETB.NET.CO"
  ETBInternet_Espejo:
    description: "Indica si la característica ETBInternet_Espejo está activa."
    type: boolean
    required: false
  LTE_ETBInternet_Espejo:
    description: "Indica si la característica LTE_ETBInternet_Espejo está activa."
    type: boolean
    required: false