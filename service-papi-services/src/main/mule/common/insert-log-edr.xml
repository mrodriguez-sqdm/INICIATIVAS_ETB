<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="insert-log-edrSub_Flow" doc:id="4db437ee-d7ef-401c-a739-c7dc80ab8ced" >
		<choice doc:name="Choice" doc:id="a471033e-151d-42cc-9b73-a94fcb92c9f0" >
			<when expression='#[vars.httpStatusCode == 201 or vars.httpStatusCode == 200]'>
				<ee:transform doc:name="Transform Message" doc:id="754aef21-4f27-4e3c-bf86-3a01c6bd2da2" >
					<ee:message >
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="requestPath" ><![CDATA[%dw 2.0
output application/json

var gateway = vars.eventType

---
gateway match {

	case "SVA" ->
		readUrl('classpath://dwScripts/logEdr/setPostSvaRequest.dwl', 'text/plain')

	case "SVAS" ->
		readUrl('classpath://dwScripts/logEdr/setPostSvasRequest.dwl', 'text/plain')
	
	case "ACTIVACION" ->
		readUrl('classpath://dwScripts/logEdr/setPostActivacionRequest.dwl', 'text/plain')
	
	case "PASASALDO" ->
		readUrl('classpath://dwScripts/logEdr/setPostPasaSaldoRequest.dwl', 'text/plain')
		
	case "RECARGAS" ->
		readUrl('classpath://dwScripts/logEdr/setPostRecargasRequest.dwl', 'text/plain')
		
	else -> ""
}]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<ee:dynamic-evaluate doc:name="Dynamic Evaluate" doc:id="3fea0192-d266-4b4e-b18a-f7cb18af5382" expression="#[vars.requestPath]"/>
				<flow-ref doc:name="Flow Reference" doc:id="3c8d36f5-7677-4ab0-b443-9c87680eab27" name="common-sapi-log-edr-clientSub_Flow"/>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="bc589023-de68-44ed-81af-1e00229bf896" />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
