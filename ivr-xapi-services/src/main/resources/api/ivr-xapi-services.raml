#%RAML 1.0
title: ivr-xapi-services
baseUri: https://ivr-xapi-services-{env}.us-e2.cloudhub.io/ivr
version: 1.0
protocols:
  - HTTPS

mediaType: 
- application/json
description: ivr-xapi-services

traits:
  channel-headers: !include /exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/channelheaders/1.0.1/channelheaders.raml
  tibcoHeaders: !include /exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.3/tibcorequestheaders.raml

securitySchemes:
  etb-oauth: !include /exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml  

/v1:
  /send-context:
    post:
      securedBy: [etb-oauth]
      displayName: Consultar Falla Masiva
      description: Consultar Falla Masiva
      queryParameters:
        bponame:
          type: string
          required: true
          example: "five9"
      body:
        application/json:
          type: !include datatypes/request/send-context.raml
          example: !include examples/request/send-context-example.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/send-context.raml
              example: !include examples/response/send-context-success-example.json
              
  /contactos-frecuentes: 
    post:
      is:
        - channel-headers
      securedBy: [etb-oauth]
      displayName: Consultar Contacto Frecuente
      description: Consulta Contacto Frecuente
      queryParameters:
        tipoConsulta:
          type: string
          required: true
          enum: ["cliente", "numero"]
          example: "cliente"
      body:
        application/json:
          type: !include datatypes/request/post-contactoFrecuente.raml
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/post-contactoFrecuente.raml
          
/operations:
  /v1:
    /process: 
      /reconnection:
        patch:
          is:
            - tibcoHeaders
          securedBy: [etb-oauth]
          displayName: ReconnectionRMCAIntf
          description: ReconnectionRMCAIntf
          body:
            application/json:
              type: !include libraries/reconnectionRMCA-lib.raml
              example: !include examples/request/reconnectionRMCAIntf-example.json
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/reconnectionRMCA-200responseDataType.raml
            500:
              body:
                application/json:
                  type: !include datatypes/response/reconnectionRMCA-500responseDataType.raml