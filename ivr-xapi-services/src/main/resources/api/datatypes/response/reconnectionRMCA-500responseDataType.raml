#%RAML 1.0 DataType

properties:
  ReconnectionRMCAOutput:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System:
            type: object
            properties:
              name:
                type: string
                required: true
              correlationID:
                type: string
                required: true
              processingServer:
                type: string
                required: true
          Service:
            type: object
            properties:
              status:
                type: string
                required: true
              responseDate:
                type: string
                required: false
              statusDetail:
                type: object
                properties:
                  errorCode:
                    type: string
                    required: true
                  errorMessage:
                    type: 
                    required: true
          
    

     
        
