#%RAML 1.0 DataType

properties:
  ReconnectionRMCAOutput:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System:
            type: object
            properties:
              name:
                type: string
                example: "Tibco"
              correlationID:
                type: string
                example: "$Start/root/pfx7:ReconnectionRMCAInput/pfx6:WSRequestHeader2/System/correlationID"
              processingServer:
                type: string
                example: "Tibco"
          Service:
            type: object
            properties:
              status:
                type: string
                example: "PASS"
              responseDate:
                type: string
                example:  "2022-07-29"
      ZRFC_TRAMITE_RECONEXIONResponse:
        type: object
        properties:
          T_RETURN:
            type: array
            items:
              properties:
                TYPE:
                  type: string
                  required: false
                ID:
                  type: string
                  required: false
                NUMBER:
                  type: integer
                  required: false
                MESSAGE: 
                  type: string
                  required: false
                LOG_NO:
                  type: string
                  required: false
                LOG_MSG_NO:
                  type: integer
                  required: false
                MESSAGE_V1:
                  type: string
                  required: false
                MESSAGE_V2:
                  type: string
                  required: false
                MESSAGE_V3:
                  type: string
                  required: false
                MESSAGE_V4:
                  type: string
                  required: false

                  
            
          

                  
                  