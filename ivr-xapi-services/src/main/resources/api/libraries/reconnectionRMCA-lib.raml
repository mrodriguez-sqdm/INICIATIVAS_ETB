#%RAML 1.0 DataType

properties:
  WSInputReconnectionRMCA:
    type: object
    properties:
      part1:
        properties:
          ReconnectionRMCAInput:
            properties:
              WSRequestHeader2:
                properties:
                  System:
                    properties:
                      name:
                        type: string
                        example: "IVR"
                        required: true
                        minLength: 1
                      correlationID:
                        type: string
                        example: "REALIZAR-RECONEXION-1638335409"
                        required: true
                        minLength: 1
                      processingServer:
                        type: string
                        example: "192.168.170.195"
                        required: true
                        minLength: 1
              ZRFC_TRAMITE_RECONEXION:
                type: object
                properties:
                  CANAL:
                    type: string
                    example: "IVR"
                    required: true
                    minLength: 1
                  CORRELATIONID:
                    type: string
                    example: "REALIZAR-RECONEXION-1638335409"
                    required: true
                    minLength: 1
                  FECHA:
                    type: date-only
                    example: "2021-12-01"
                    required: true
                  TRAMITE:
                    type: integer
                    example: 10197
                    required: true
                  VKONA:
                    type: integer
                    example: 12053567662
                    required: true
                      


  

                      

                      
                                   
                            

  