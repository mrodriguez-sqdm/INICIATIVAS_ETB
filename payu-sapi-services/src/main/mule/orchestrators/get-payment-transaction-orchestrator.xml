<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-payment-transaction-orchestrator" doc:id="ff2ebb2a-310f-48f2-a10d-b6199f84ab58" >
		<ee:transform doc:name="set transaction detail request">
            <ee:message >
				<ee:set-payload resource="dwScripts/getPaymentTransaction/setTransactionRequest.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable resource="dwScripts/getPaymentTransaction/setHttpRequest.dwl" variableName="httpRequest" />
            </ee:variables>
        </ee:transform>
		<flow-ref doc:name="payu-client-sub-flow" doc:id="4b840122-8b9f-4d1f-a9d5-eea57248e455" name="payu-client-sub-flow"/>
		<ee:transform doc:name="set transction detail response" doc:id="ae892b23-2c79-4e1b-8890-1c1539e0c018" >
			<ee:message >
				<ee:set-payload resource="dwScripts/getPaymentTransaction/setTransactionResponse.dwl" />
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
