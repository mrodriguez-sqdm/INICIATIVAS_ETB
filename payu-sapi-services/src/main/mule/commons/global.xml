<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:json-logger="http://www.mulesoft.org/schema/mule/json-logger"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
						http://www.mulesoft.org/schema/mule/json-logger http://www.mulesoft.org/schema/mule/json-logger/current/mule-json-logger.xsd
						http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
						http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
						http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">
	<http:listener-config
		name="payu-sapi-services-httpListenerConfig">
		<http:listener-connection
			host="${http.private.host}" port="${http.private.port}" />
	</http:listener-config>
	<apikit:config name="payu-sapi-services-config"
		api="resource::35a39a92-efa9-49b6-8f13-d66508fd2f35:payu-sapi-services:1.0.7:raml:zip:payu-sapi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<global-property doc:name="Global Property"
		doc:id="edb331d2-018a-4e38-9211-e944a8c7532e" name="env"
		value="development" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="6526cb64-c3c4-4a0e-867d-05cc12dacca9"
		file="properties\common-properties.yaml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="f3bf335a-b640-4975-be5c-7f60abe9101d"
		file="properties/${env}-properties.yaml" />
	<secure-properties:config
		name="Secure_Properties_Config" doc:name="Secure Properties Config"
		doc:id="2784f3a7-9c46-406c-a51c-ba1cfb58ea21"
		file="secureProperties/${env}-secure-properties.yaml"
		key="${secure.key}">
		<secure-properties:encrypt
			algorithm="Blowfish" />
	</secure-properties:config>
	<api-gateway:autodiscovery apiId="${app.id}"
		ignoreBasePath="true" doc:name="API Autodiscovery"
		doc:id="c1e62ffc-71fb-4717-bb40-840ca3875444"
		flowRef="payu-sapi-services-main" />
	<http:request-config
		name="HTTP_Payu_Request_configuration"
		doc:name="HTTP Request configuration"
		doc:id="19c8f672-1e03-48c1-b14e-741f422256ae">
		<http:request-connection protocol="HTTPS"
			host="#[vars.httpRequest.host]" />
	</http:request-config>
	<import doc:name="error-handler-v2"
		doc:id="cfa27a54-597c-4128-b38b-3c740943cb97"
		file="error-handler-v2.xml" />
	<import doc:name="etb-common-lib"
		doc:id="b907e3d7-5c00-4622-af49-a92717f21305"
		file="etb-common-lib.xml" />
	<import doc:name="logging"
		doc:id="f6148516-8e54-4104-b292-444b88768944" file="loggin.xml" />
	<import doc:name="audit-sapi-client"
		doc:id="c52a135a-3375-49f9-b915-40d557c56e1e"
		file="audits-sapi-client.xml" />
</mule>