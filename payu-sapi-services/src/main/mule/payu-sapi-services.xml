<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:tracing="http://www.mulesoft.org/schema/mule/tracing"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd  http://www.mulesoft.org/schema/mule/tracing http://www.mulesoft.org/schema/mule/tracing/current/mule-tracing.xsd">
	<flow name="payu-sapi-services-main">
		<http:listener
			config-ref="payu-sapi-services-httpListenerConfig" path="/api/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<!-- [STUDIO:"Async"]<async doc:name="Async" doc:id="670006b4-af60-42f6-91fe-922b9c051a23" >
			<flow-ref doc:name="call initial logger" doc:id="a0902191-fd5b-4808-ab25-b857720247d1" name="initial-loggin-Sub_Flow" />
		</async> [STUDIO] -->
		<apikit:router config-ref="payu-sapi-services-config" />
		<!-- [STUDIO:"Async"]<async doc:name="Async"
			doc:id="f1ca74d7-321e-422e-97ac-62b9a7a2ba81">
			<flow-ref doc:name="call logger client"
				doc:id="0555eda4-fd6a-4736-81bf-97ffb0b6f8a9"
				name="loggin-client-call" />
		</async> [STUDIO] -->
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="payu-sapi-services-console">
		<http:listener
			config-ref="payu-sapi-services-httpListenerConfig" path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console config-ref="payu-sapi-services-config" />
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="get:\health-check:payu-sapi-services-config">
		<flow-ref doc:name="get-health-check-orchestrator-sub-flow"
			doc:id="170c67e0-95e9-468b-8b61-1711df78f6f2"
			name="get-health-check-orchestrator-sub-flow" />
	</flow>
	<flow name="get:\v1\banks:payu-sapi-services-config">
		<flow-ref doc:name="get-banks-orchestrator-sub-flow"
			doc:id="69eb786e-db81-4bc3-8f47-2fed96d62ccd"
			name="get-banks-orchestrator-sub-flow" />
	</flow>
	<flow name="get:\v1\ping:payu-sapi-services-config">
		<flow-ref doc:name="get-ping-orchestrator-sub-flow"
			doc:id="37bd8a02-aac1-4046-9906-eacc33ba85aa"
			name="get-ping-orchestrator-sub-flow" />
	</flow>
	<flow name="get:\v1\transactions\(id):payu-sapi-services-config">
		<flow-ref doc:name="get-payment-transaction-orchestrator"
			doc:id="b3e72988-4d0d-45ef-af22-66cb32a092ba"
			name="get-payment-transaction-orchestrator" />
	</flow>
	<flow
		name="post:\v1\transactions:application\json:payu-sapi-services-config">
		<flow-ref
			doc:name="post-payment-transaction-orchestrator-sub-flow"
			doc:id="19c1eff0-0245-416e-a0ad-c90a8cfc57cb"
			name="post-payment-transaction-orchestrator-sub-flow" />
	</flow>
</mule>
