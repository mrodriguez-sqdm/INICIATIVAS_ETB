#%RAML 1.0 DataType
type: object
properties:
  code:
    type: string
    required: true
  error:
    type: any
    required: false
  transactionResponse:
    type: object
    required: true
    properties:
      orderId:
        type: number
        required: true
      transactionId:
        type: string
        required: true
      state:
        type: string
        required: true
      paymentNetworkResponseCode:
        type: string
        required: true
      paymentNetworkResponseErrorMessage:
        type: any
        required: false
      trazabilityCode:
        type: string
        required: true
      authorizationCode:
        type: string
        required: true
      pendingReason:
        type: any
        required: false
      responseCode:
        type: string
        required: true
      errorCode:
        type: any
        required: false
      responseMessage:
        type: string
        required: true
      transactionDate:
        type: any
        required: false
      transactionTime:
        type: any
        required: false
      operationDate:
        type: number
        required: true
      referenceQuestionnaire:
        type: any
        required: false
      extraParameters:
        type: object
        required: true
        properties:
          BANK_REFERENCED_CODE:
            type: string
            required: true
      additionalInfo:
        type: object
        required: true
        properties:
          paymentNetwork:
            type: string
            required: true
          rejectionType:
            type: string
            required: true
          responseNetworkMessage:
            type: any
            required: false
          travelAgencyAuthorizationCode:
            type: any
            required: false
          cardType:
            type: string
            required: true
          transactionType:
            type: string
            required: true             
        