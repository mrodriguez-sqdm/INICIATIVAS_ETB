#%RAML 1.0 DataType
type: object
properties:
  code:
    type: string
    example: "SUCCESS"
  error:
    type: string | nil
  result:
    type: object
    properties:
      payload:
        type: object
        properties:
          state:
            type: string
            description: Estado de la transacción.
            example: "APPROVED"
          paymentNetworkResponseCode:
            type: string
            description: Código de respuesta de la red de pagos.
            example: "00"
          paymentNetworkResponseErrorMessage:
            type: string | nil
            description: Mensaje de error de la red de pagos, si aplica.
          trazabilityCode:
            type: string
            description: Código de trazabilidad de la transacción.
            example: "00006535-00000086725"
          authorizationCode:
            type: string
            description: Código de autorización.
            example: "012747"
          pendingReason:
            type: string | nil
            description: Razón de un estado pendiente, si aplica.
          responseCode:
            type: string
            description: Código de respuesta de la operación.
            example: "APPROVED"
          errorCode:
            type: string | nil
            description: Código de error, si lo hay.
          responseMessage:
            type: string
            description: Mensaje de respuesta descriptivo.
            example: "Approved"
          transactionDate:
            type: string | nil
            description: Fecha de la transacción.
          transactionTime:
            type: string | nil
            description: Hora de la transacción.
          operationDate:
            type: number
            description: Fecha de la operación en formato epoch.
            example: 1756388666960
          extraParameters:
            type: string | nil
            description: Parámetros adicionales.