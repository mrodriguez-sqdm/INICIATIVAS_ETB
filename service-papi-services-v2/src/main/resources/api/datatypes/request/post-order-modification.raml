#%RAML 1.0 DataType
description: "Order modification request (LTE). Channel identification, holder, resource to change, optional plan and service type (LTE | TELEFONIA - only LTE implemented in PAPI)."
type: object
properties:
  identip:
    type: object
    required: false
    description: Channel / origin identification (OBJ IDENTIP / IP).
    properties:
      channelOrigin:
        type: string
        required: false
        example: "WEB"
      clientIp:
        type: string
        required: false
        example: "192.168.1.10"
  holder:
    type: object
    required: true
    description: Subscriber / owner data (OBJ TITULAR).
    properties:
      documentType:
        type: string
        required: true
        example: "CC"
      documentNumber:
        type: string
        required: true
        example: "1234567890"
      externalId:
        type: string
        required: false
        description: Optional external identifier; if absent, documentType.concat(documentNumber) is used for JSC.
      cycleDay:
        type: string
        required: false
        description: Billing cycle day when creating a new BA (Titular / MSISDN flows); maps to PAM in JSC.
        example: "15"
      billingAccountNumber:
        type: string
        required: false
        description: "Destination billing account external id (JSC GET/POST BA). If omitted, uses externalId or documentType+documentNumber (same pattern as post-cambioSuscriptorLTECorp)."
  resource:
    type: object
    required: true
    description: OBJ RECURSO — route by type (Titular, SIM, Plan, MSISDN).
    properties:
      type:
        type: string
        enum: ["Titular", "SIM", "Plan", "MSISDN"]
        required: true
      msisdn:
        type: string
        required: false
        description: Current line MSISDN (Titular, SIM, Plan, MSISDN flows).
        example: "573001234567"
      iccid:
        type: string
        required: false
        description: New SIM ICCID (SIM replacement).
      oldMsisdn:
        type: string
        required: false
        description: Previous MSISDN (MSISDN change).
      newMsisdn:
        type: string
        required: false
        description: Target MSISDN (MSISDN change).
      simChangePackageId:
        type: string
        required: false
        description: Optional package id for SIM replacement order (JSC product id).
  plan:
    type: object
    required: false
    description: Plan change (aligned with legacy post-replacement-plan).
    properties:
      packageId:
        type: string
        required: false
        description: Target price plan / package id (JSC).
        example: "D123456"
      modality:
        type: string
        required: false
        description: "pospago-pospago, pospago-prepago, prepago-prepago: JSC order + apply (patch endOrder) only. prepago-pospago: order + billing account creation + move subscription to that BA + apply. If omitted, behaviour matches pospago-pospago."
        example: "pospago-prepago"
      billingCycleDay:
        type: string
        required: false
        description: Billing cycle day (PAM) when creating BA for modality prepago-pospago; falls back to holder.cycleDay or "15".
        example: "20"
  serviceType:
    type: string
    enum: ["LTE", "TELEFONIA"]
    required: true
    description: Only LTE is implemented; TELEFONIA returns 501.
