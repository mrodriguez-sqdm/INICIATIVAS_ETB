#%RAML 1.0 DataType 
type: object
properties:
  id:
    type: string
    example: 1d732753-ae1f-45f8-82f7-7243d395b1ac
    required: false
  event_type:
    type: string
    example: user_registered | product_added | product_terminated | error_notification
    required: false
  user_id:
    type: string
    example: 4fc94354-1e23-438b-9572-554f0343ef55
    required: false
  partner_user_id:
    type: string
    example: 67334b1d-b7d3-43c7-8561-ec8132dd2e0a
    required: false
  timestamp:
    type: integer
    example: 1649711958
    required: false
  event_data:
    type: object
    properties:
      product:
        type: object
        required: false
        properties:
          code:
            type: string
            example: MAX_ADFREE
            required: false
          sub_id:
            type: string
            example: ETB-SUB-987654
            required: false
          starts:
            type: integer
            example: 1649711958
            required: false
          expires:
            type: integer
            example: 1652303958
            required: false
      action:
        type: string
        example: multi_product_added
        required: false
      products_added:
        type: array
        required: false
        items:
          type: object
          properties:
            code:
              type: string
              example: MAX_ADFREE
              required: false
            sub_id:
              type: string
              example: ETB-SUB-987654
              required: false
            starts:
              type: integer
              example: 1649711958
              required: false
      products_terminated:
        type: array
        required: false
        items:
          type: object
          properties:
            code:
              type: string
              example: MAX_BASIC
              required: false
            sub_id:
              type: string
              example: ETB-SUB-123456
              required: false
            expires:
              type: integer
              example: 1649711958
              required: false
      account_id_changed:
        type: object
        required: false
        properties:
          new_partner_user_id:
            type: string
            example: ETB-USER-NEW-123456
            required: false
      error:
        type: string
        example: service_regression
        required: false
      error_description:
        type: string
        example: Platform is encountering an internal issue.
        required: false
