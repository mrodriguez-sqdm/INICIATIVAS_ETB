#%RAML 1.0 DataType
description: "Eliminar orden (SVAS). Campos en body; al menos subscriptionId o connectionNumber para resolver la suscripción en JSC."
type: object
properties:
  origin:
    type: string
    required: false
    description: Canal u origen de la petición
    example: "WEB"
  order:
    type: string
    required: false
    description: Referencia de orden en canal (auditoría)
  orderType:
    type: string
    required: false
    description: Tipo de orden
  connectionNumber:
    type: string
    required: false
    description: MSISDN para buscar suscripción cuando no se envía subscriptionId
    example: "573001234567"
  productType:
    type: string
    required: true
    description: Familia de producto — solo SVAS implementado
    example: "SVAS"
  subscriptionId:
    type: string
    required: false
    description: Identificador de suscripción JSC; si se omite, se obtiene por connectionNumber
