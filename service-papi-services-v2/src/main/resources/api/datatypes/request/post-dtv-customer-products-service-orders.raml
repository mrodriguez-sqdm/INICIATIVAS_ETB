#%RAML 1.0 DataType
type: object
description: Unified request for customer product operations (cancel, reconnect, capture, activation)


properties:

  action:
    type: string
    required: false
    example: "capture"
    
  customer:
    type: object
    required: false
    properties:
      customerKey:
        type: string
        required: false
        example: "69978242"

  product:
    type: object
    required: false
    properties:

      id:
        type: number
        required: false
        example: 449

      productKey:
        type: number
        required: false
        example: 449

      productCategory:
        type: object
        required: false
        properties:
          type:
            type: object
            required: false
            properties:
              code:
                type: string
                required: false
                example: "PREMIUM"

  flags:
    type: object
    required: false
    properties:
      immediate:
        type: boolean
        required: false
        example: true
      deleteOffer:
        type: string
        required: false
        example: "false"
      activateInAllDevices:
        type: string
        required: false
        example: "false"
  
  eventId:
    type: string
    example: 1d732753-ae1f-45f8-82f7-7243d395b1ac
    required: false
  eventType:
    type: string
    example: >-
      account_provision | account_terminated | multi_product_added |
      multi_product_terminated | multi_product_switched | multi_product_paused |
      multi_product_resumed
    required: false
  occurredAt:
    type: string
    example: '2026-08-11T12:30:00-05:00'
    required: false
  eventData:
        type: object
        required: false
        properties:
          email:
            type: string
            example: cliente@correo.com
            required: false
          phoneNumber:
            type: string
            example: '+573001234567'
            required: false
          name:
            type: string
            example: Daniel Cardenas
            required: false
          address:
            type: object
            required: false
            properties:
              country:
                type: string
                example: CO
                required: false
          products:
            type: array
            required: false
            items:
              type: object
              properties:
                code:
                  type: string
                  example: MAX_ADFREE
                  required: false
                name:
                  type: string
                  example: Max Sin Anuncios
                  required: false
                starts:
                  type: integer
                  example: 1786469400
                  required: false
                renews:
                  type: integer
                  example: 1789147800
                  required: false
                expires:
                  type: integer
                  example: 1791739800
                  required: false
                subscriptionId:
                  type: string
                  example: ETB-SUB-987654
                  required: false
                transactionId:
                  type: string
                  example: ETB-TX-123456
                  required: false
                status:
                  type: string
                  example: ACTIVE
                  required: false
                reason:
                  type: string
                  example: OFFER_EXPIRED
                  required: false
          productsTerminated:
            type: array
            required: false
            items:
              type: object
              properties:
                code:
                  type: string
                  example: MAX_BASIC
                  required: false
                subscriptionId:
                  type: string
                  example: ETB-SUB-987654
                  required: false
          productsAdded:
            type: array
            required: false
            items:
              type: object
              properties:
                code:
                  type: string
                  example: MAX_ADFREE
                  required: false
                subscriptionId:
                  type: string
                  example: ETB-SUB-987655
                  required: false
                renews:
                  type: integer
                  example: 1789147800
                  required: false
                transactionId:
                  type: string
                  example: ETB-TX-456789
                  required: false
          effectiveDate:
            type: integer
            example: 1786469400
            required: false
          reason:
            type: string
            example: USER_PAUSED
            required: false
          details:
            type: string
            example: Pause requested by customer
            required: false