#%RAML 1.0 DataType
type: object
description: Unified request for customer product operations (cancel, reconnect, capture, activation)

properties:

  action:
    type: string
    required: true
    example: "capture"

  customer:
    type: object
    required: false
    properties:
      customerKey:
        type: string
        required: false
        example: "ClientId"

  product:
    type: object
    required: false
    properties:

      id:
        type: number
        required: false
        example: 449

      productKey:
        type: number
        required: false
        example: 449

      productOffer:
        type: string
        required: false
        example: ""

      productCategory:
        type: object
        required: false
        properties:
          description:
            type: string
            required: false
            example: "Prime Video"
          id:
            type: number
            required: false
            example: 449
          type:
            type: object
            required: false
            properties:
              code:
                type: string
                required: false
                example: "PREMIUM"
              name:
                type: string
                required: false
                example: "P - PREMIUM"
              id:
                type: number
                required: false
                example: 1

      productPrice:
        type: object
        required: false
        properties:
          validFor:
            type: string
            required: false
            example: ""
          price:
            type: object
            required: false
            properties:
              amount:
                type: number
                required: false
                example: 5000
          name:
            type: number
            required: false
            example: 2
          priceType:
            type: number
            required: false
            example: 79801
          description:
            type: string
            required: false
            example: "Monthly"
          unitofmeasure:
            type: string
            required: false
            example: ""

      productCharacteristicValue:
        type: array
        required: false
        items:
          type: object
          properties:
            validFor:
              type: string
              required: false
              example: ""
            value:
              type: any
              required: false
              example: "A"
            productSpecCharacteristic:
              type: object
              required: false
              properties:
                name:
                  type: string
                  required: false
                  example: "Priority"

  flags:
    type: object
    required: false
    properties:
      immediate:
        type: boolean
        required: false
        example: true
      deleteOffer:
        type: string
        required: false
        example: "false"
      activateInAllDevices:
        type: string
        required: false
        example: "false"