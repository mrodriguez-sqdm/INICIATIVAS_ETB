#%RAML 1.0 DataType
type: object
description: Unified request for customer product operations (cancel, reconnect, capture, activation)

properties:

  action:
    type: string
    required: true
    example: "capture"

  product:
    type: object
    required: false
    properties:

      id:
        type: number
        required: false
        example: 449

      productKey:
        type: number
        required: false
        example: 449

      productCategory:
        type: object
        required: false
        properties:
          type:
            type: object
            required: false
            properties:
              code:
                type: string
                required: false
                example: "PREMIUM"

  flags:
    type: object
    required: false
    properties:
      immediate:
        type: boolean
        required: false
        example: true
      deleteOffer:
        type: string
        required: false
        example: "false"
      activateInAllDevices:
        type: string
        required: false
        example: "false"