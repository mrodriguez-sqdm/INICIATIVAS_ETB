#%RAML 1.0 DataType
description: Respuesta unificada eliminar orden (SVAS en mayúsculas).
type: object
properties:
  responseCode:
    type: string
    example: "200"
  response:
    type: object
    properties:
      SVAS:
        type: object
        description: Agregado por productType SVAS (respuesta JSC y metadatos de canal)
        additionalProperties: true
