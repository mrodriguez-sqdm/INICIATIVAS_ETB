#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Registration URL generated successfully
    required: false
  result:
    type: object
    properties:
      redirectUrl:
        type: string
        example: >-
          https://{WBD_HOST}/complete/{RESOURCE_ID_1}/{RESOURCE_ID_2}?grant_type=jwt&code={JWT}
        required: false
      expiresAt:
        type: string
        example: '2026-08-06T16:30:00Z'
        required: false