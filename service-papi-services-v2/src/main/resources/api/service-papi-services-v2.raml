#%RAML 1.0
title: service-papi-services
version: v2
baseUri:  http://service-papi-services-v2-{env}.us-e2.cloudhub.io/{version}
description: The service-papi-services API exposes process-level services that orchestrate and coordinate service-related business logic, ensuring consistent management and integration of service information across systems
protocols:
  - HTTP

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml
  security_client_id: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
mediaType: 
  - application/json

/service:
   get:
      is: [security_client_id,tibcoHeaders]
      displayName: service
      description: resource service information
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        SERVICE_ACCOUNT:
          type: string
          example: "12552454"
          description: "number account service"
          required: false
        BILLING_ACCOUNT:
          type: string
          example: "12552454"
          description: "number billing account"
          required: false
        CONNECTION_NUMBER:
          type: string
          example: "542545454"
          description: "Number connection, this number is phone"
          required: false
        RESOURCE_ID:
          type: string
          description: "Network element to which the query is applied"
          required: false
        RESOURCE_TYPE:
          type: string
          description: "resource type"
          required: false
        OPERATION:
          type: string
          example: "LTE"
          description: "operation on the requested query"
          required: false
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/get-service.raml
              examples:
                LTE:
                  value: !include /examples/response/get-service-lte.json
                FTTH:
                  value: !include /examples/response/get-service-ftth.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
   post:
      is: [security_client_id,tibcoHeaders]
      displayName: service activate
      description: SERVICE ACTIVATE
      body:
        application/json:
          type: !include /datatypes/request/post-service-activate.raml
          example: !include /examples/request/post-service-activate.json
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/post-service-activate.raml
              example: !include /examples/response/post-service-activate-200.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

/order:
  post:
    is: [security_client_id,tibcoHeaders]
    displayName: Crear orden (LTE)
    description: "Creación / orquestación de orden (LTE) — enruta por resource.type (Titular, SIM, Plan, MSISDN) hacia JSC. TELEFONIA no implementado."
    body:
      application/json:
        type: !include /datatypes/request/post-order-modification.raml
        example: !include /examples/request/post-order-modification.json
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/post-order-modification.raml
            example: !include /examples/response/post-order-modification-200.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
      501:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
  delete:
    is: [security_client_id,tibcoHeaders]
    displayName: Eliminar orden (SVAS)
    description: "Elimina / da de baja la orden de servicio según productType. Para SVAS resuelve suscripción por subscriptionId o connectionNumber (MSISDN) y delega en JSC (terminación de suscripción). Body JSON permitido en DELETE."
    body:
      application/json:
        type: !include /datatypes/request/delete-order.raml
        example: !include /examples/request/delete-order.json
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/delete-order.raml
            example: !include /examples/response/delete-order-200.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
/customer-products:
  /{id}:
    /service-orders:
      post:
        is: [security_client_id,tibcoHeaders]
        displayName: Manage OTT Service Orders
        description: |
          Creates a service order to manage OTT subscriptions, supporting activation (add) and state changes (modify such as cancel or reconnect).
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
          OTT_PLATFORM:
            type: string
            enum:
              - DIRECTV
            example: "DIRECTV"
            description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY).
        body:
          application/json:
            type: !include /datatypes/request/post-dtv-customer-products-service-orders.raml
            examples: 
                  activation: !include /examples/request/post-dtv-customer-products-service-orders-activation.json
                  cancelCustomer: !include /examples/request/post-dtv-customer-products-service-orders-cancelCustomer.json
                  reconnectCustomer: !include /examples/request/post-dtv-customer-products-service-orders-reconnectCustomer.json
                  cancelAmazon: !include /examples/request/post-dtv-customer-products-service-orders-cancelAmazon.json
                  reconnectAmazon: !include /examples/request/post-dtv-customer-products-service-orders-reconnectAmazon.json
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/post-dtv-customer-products-service-orders.raml
                examples: 
                  activation: !include /examples/response/post-dtv-customer-products-service-orders-activation.json
                  cancelCustomer: !include /examples/response/post-dtv-customer-products-service-orders-cancelCustomer.json
                  reconnectCustomer: !include /examples/response/post-dtv-customer-products-service-orders-reconnectCustomer.json
                  cancelAmazon: !include /examples/response/post-dtv-customer-products-service-orders-cancelAmazon.json
                  reconnectAmazon: !include /examples/response/post-dtv-customer-products-service-orders-reconnectAmazon.json

          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
          501:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
    /service:
      get:
        is: [security_client_id,tibcoHeaders]
        displayName: Retrieve OTT Subscriber Details
        description: |
          Retrieves detailed information of a subscriber in a third-party OTT platform, including customer profile, product subscriptions, service status, and interaction history.
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
          OTT_PLATFORM:
            type: string
            enum:
              - DIRECTV
            example: "DIRECTV"
            description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY).
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-dtv-customer-products-service.raml
                example: !include /examples/response/get-dtv-customer-products-service.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
          501:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
      /reprovision:
        post:
          is: [security_client_id,tibcoHeaders]
          displayName: Reaprovision product OTT
          description: |
            Sincroniza el estado de una suscripción en Amazon:
            1. Consulta el estado actual en la plataforma de Amazon.
            2. Si está activa (CREATED), solicita una URL tokenizada para refrescar el acceso.
            3. Si no se encuentra la suscripción, inicia el flujo para crear una nueva.
          body:
            application/json:
              type: !include /datatypes/request/post-dtv-reprovision.raml
              example: !include /examples/request/post-dtv-reprovision.json
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/post-dtv-reprovision.raml
                  example: !include /examples/response/post-dtv-reprovision.json
            400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
            401:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-401.json
            404:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-404.json
            500:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json
            501:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json

/product:
   get:
      is: [security_client_id,tibcoHeaders]
      displayName: Product consultation
      description: "Consulta de producto por tipo (productType). Para SVAS orquesta JSC (suscripción por msisdn, consumo por id de suscripción) y mongo-sapi (ofertas por número de agrupación). Otros productType pueden agregarse en el futuro."
      queryParameters:
        origin:
          type: string
          description: Source channel identifier
          required: false
          example: "WEB"
        ip:
          type: string
          description: Client IP (audit / routing)
          required: false
        productType:
          type: string
          description: Product family — SVAS triggers JSC + mongo offer flow
          required: true
          example: "SVAS"
        category:
          type: string
          description: Product category filter (reserved for future use)
          required: false
        product:
          type: string
          description: Product or line identifier — for SVAS used as MSISDN if connectionNumber is not sent
          required: false
        connectionNumber:
          type: string
          description: MSISDN for SVAS subscription lookup (preferred over product)
          required: false
        cdrDetailType:
          type: string
          description: Consumption detail type sent to JSC (required when productType is SVAS)
          required: false
          example: "DATA"
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/get-product-consultation.raml
              example: !include /examples/response/get-product-consultation-svas.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json