#%RAML 1.0 DataType
type: object
description: |
  Entrada para consultar disponibilidad de recursos (MSISDN y/o SIM según tipo/nombre).
  La PAPI enruta hacia GET /v1/msisdn y/o GET /v1/sim/{id} en JSC/BSS.
properties:
  sourceIp:
    type: string
    description: Identificación del origen (IP o canal), según diseño.
    required: false
    example: "10.0.0.1"
  resources:
    type: array
    minItems: 1
    description: Objetos con tipo/nombre/id de recurso a consultar.
    items:
      type: object
      properties:
        resourceType:
          type: string
          description: TELEFONIA, LTE, etc.
          example: "LTE"
        resourceName:
          type: string
          description: MSISDN, SIM (p. ej. bajo LTE).
          example: "MSISDN"
        resourceId:
          type: string
          description: MSISDN, ICCID u otro id según nombreRecurso.
          example: "573001234567"
  service:
    type: object
    required: false
    description: Objeto de trámite/categoría (informativo u orquestación).
    properties:
      processType:
        type: string
        required: false
      category:
        type: string
        required: false
