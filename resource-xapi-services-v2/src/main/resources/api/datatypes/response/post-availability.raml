#%RAML 1.0 DataType 
type: object
properties:
  status:
    type: integer
    required: false
  code:
    type: string
    required: false
  message:
    type: object
    properties:
      message:
        type: string
        required: false
  availabilityResponse:
    type: object
    properties:

      header:
        type: object
        properties:
          availabilityId:
            type: string
            example: "MDM-FIBRA-000646963"
          provisioningOrderNumber:
            type: string
            example: "MDM-FIBRA-000646963"
          revisionNumber:
            type: string
            example: "1"
          technology:
            type: string
            example: ""
          requestDate:
            type: string
            example: "2026-04-17T14:00:05.005-825124"

      detail:
        type: object
        properties:

          overall:
            type: object
            properties:
              qualificationResult:
                type: string
                example: "FACTIBLE"
              reason:
                type: object
                properties:
                  parentServiceId:
                    type: string
                  resource:
                    type: string
                  description:
                    type: string

          orderItem:
            type: array
            items:
              type: object

          result:
            type: object
            properties:
              status:
                type: string
                example: "OK"
              errorCode:
                type: string
              errorMessage:
                type: string