#%RAML 1.0 DataType
type: object
properties:
  status:
    type: integer
    required: false
  code:
    type: string
    required: false
  message:
    type: object
    properties:
      message:
        type: string
        required: false
  completeInventoryOrderResponse:
    type: object
    properties:
      messageHeader:
        type: object
        properties:
          availabilityId: string
          provisioningOrderNumber: string
          revisionNumber: number
          orderRequestDate: string
          etbTechnology: string