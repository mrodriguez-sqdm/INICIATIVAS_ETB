#%RAML 1.0 DataType
type: object
properties:
  status:
    type: integer
    required: false
  code:
    type: string
    required: false
  message:
    type: object
    properties:
      message:
        type: string
        required: false
  validatePremiseEquipmentInstall:
    type: object
    properties:
      messageHeader:
        type: object
        properties:
          availabilityId: string
          provisioningOrderNumber: string
          revisionNumber: number
          orderRequestDate: string
      detail:
        type: object
        properties:
          equipment:
            type: object
            properties:
              equipmentBrand: string
              serviceId:
                type: string
                required: false
              obsolescenceIndicator: string
              equipmentSerial: string
              equipmentMac: string
              equipmentType: string
              equipmentModel: string
              compatibilityIndicator: string
              compatibilityResponse:
                type: string
                required: false
              attributes:
                type: array
                items:
                  type: object
                  properties:
                    attribute: string
                    value: string