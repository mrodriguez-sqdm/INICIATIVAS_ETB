#%RAML 1.0 DataType
type: object
description: Respuesta estándar con objeto de disponibilidad agregado.
properties:
  cod_res:
    type: string
    example: "200"
  res:
    type: string
    example: "Consulta exitosa."
  objDisponibilidad:
    type: object
    required: false
    description: |
      Resultado agregado (p. ej. resultados por MSISDN, SIM; TELEFONIA/fijo puede indicar no disponible en backend).
    properties:
      resultadoMsisdn:
        type: object
        required: false
      resultadoSim:
        type: object
        required: false
      resultadoFijo:
        type: string
        description: Indicación cuando no existe backend para fijo (según diseño).
        required: false
