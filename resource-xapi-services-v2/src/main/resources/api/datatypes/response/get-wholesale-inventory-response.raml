#%RAML 1.0 DataType
# Wholesale Resource Inventory — response contract
# New endpoint: GET /v2/resource/wholesale/{serviceAccount}
# Standard: TMF639 — Resource Inventory Management
# Migrated from: operations-papi-services/datatypes/responses/getInventory.raml

type: object
properties:
  status:
    type: string
    required: true
    description: |
      Current operational state of the FTTH resource.
      Source: Acceso.Estado_Servicio.Descripcion from ConsultarInventario response.
    example: "Active"
  nap:
    type: string
    required: false
    description: NAP identifier — optical distribution point serving the service account.
    example: "N1CU29_A7"
  portNap:
    type: string
    required: false
    description: Port number on the NAP assigned to this service account.
    example: "15"
  olt:
    type: string
    required: false
    description: OLT shelf identifier — Optical Line Terminal serving the NAP.
    example: "BOCUZTC60115"
  oltCard:
    type: string
    required: false
    description: OLT line card identifier.
    example: "BOCUZTC60115G01"
  oltPto:
    type: string
    required: false
    description: PON port on the OLT card serving this NAP.
    example: "PON PORT2"
  onuid:
    type: string
    required: false
    description: ONT/ONU serial number installed at the customer premise.
    example: ""
  serviceAccount:
    type: string
    required: true
    description: Wholesale service account identifier echoed from the path param.
    example: "GPONMAY_000001"
  objectName:
    type: string
    required: false
    description: Network object name — OLT port path in the network management system.
    example: "BOSIZTC30011:1-1-2-6-24"
