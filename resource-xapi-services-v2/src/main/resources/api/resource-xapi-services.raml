#%RAML 1.0
title: ETB Resource Experience API
version: v2
baseUri: https://resource-xapi-services-v2-{env}.us-e2.cloudhub.io/{version}
description: |
  Experience API para gestión de recursos (v2). Incluye **Consultar disponibilidad** (MSISDN / SIM vía PAPI → JSC/BSS).

protocols:
  - HTTPS

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType:
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/availability:
  get:
    displayName: Consultar disponibilidad
    description: |
      Consulta disponibilidad de recursos (MSISDN y/o SIM) usando query params.
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    queryParameters:
      ORIGIN:
        type: string
        required: false
        description: Origen de la petición (canal), alineado al diseño.
        example: "WEB"
      msisdn:
        type: string
        required: false
        description: Número MSISDN a consultar.
        example: "573001234567"
      sim:
        type: string
        required: false
        description: ICCID de la SIM a consultar.
        example: "8955050000000000000"
    responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/availability-response.raml
              example: !include examples/response/availability.json
        400:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-500.json
  post:
    displayName: Valida la disponibilidad
    description: |
      Permite validar la disponibilidad de recursos físicos necesarios para la instalación de servicios, como puertos en MSS para FTTH, SIMCARD para LTE y otros elementos de red.
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]  
    queryParameters:
      ORIGIN:
        type: string
        required: false
        description: Origen de la petición (canal).
        example: "WEB"
    body:
      application/json:
        type: !include datatypes/request/post-availability.raml
        example: !include examples/request/post-availability.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/post-availability.raml
            example: !include examples/response/post-availability.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json
/configurations:
  get:
    displayName: Consulta la configuración
    description: |
      Permite consultar la configuración actual de los recursos físicos de red, incluyendo equipos, puertos y topología asociada a un cliente o servicio.
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    queryParameters:
      ORIGIN:
        type: string
        required: false
        description: Origen de la petición (canal).
        example: "WEB"
      id:
        type: string
        required: true
        description: Id de disponibilidad.
        example: "CS-9012096"
      externalId:
        type: string
        required: true
        description: Numero de Orden de Aprovisionador.
        example: "CS-9012096"
      serviceId:
        type: string
        required: true
        description: Id de servicio.
        example: "CS-9012096"
      technology:
        type: string
        required: true
        description: Tipo de tecnología.
        example: "FTTH"
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-configurations.raml
            example: !include examples/response/get-configurations.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json
/eligibility:
  post:
    displayName: Consulta de equipos.
    description: |
      Permite determinar qué productos o equipos son elegibles para un cliente o cuenta de servicio, según reglas técnicas, comerciales y condiciones de red.
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    queryParameters:
      ORIGIN:
        type: string
        required: false
        description: Origen de la petición (canal).
        example: "WEB"
    body:
      application/json:
        type: !include datatypes/request/post-eligibility.raml
        example: !include examples/request/post-eligibility.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/post-eligibility.raml
            example: !include examples/response/post-eligibility.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json
/reservations:
  post:
    displayName: Realiza reserva de recursos físicos.
    description: |
      Permite realizar la reserva de recursos físicos en el inventario, garantizando su disponibilidad para procesos de instalación.
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    queryParameters:
      ORIGIN:
        type: string
        required: false
        description: Origen de la petición (canal).
        example: "WEB"
    body:
      application/json:
        type: !include datatypes/request/post-reservations.raml
        example: !include examples/request/post-reservations.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/post-reservations.raml
            example: !include examples/response/post-reservations.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json
/resource:
  /wholesale:
    /{serviceAccount}:
      uriParameters:
        serviceAccount:
          type: string
          description: |
            Wholesale service account identifier assigned during availability confirm.
            Pattern: GPONMAY_XXXXXX.
          example: "GPONMAY_000001"
          required: true
      get:
        displayName: Consult wholesale resource inventory
        description: |
          Returns the FTTH network topology installed for a wholesale service account.
          Queries the Orquestador ETB via SOAP ConsultarInventario (Integracion.svc).
          Standard: TMF639 — Resource Inventory Management.
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        headers:
          origin:
            type: string
            description: |
              Wholesale operator identifier. Used by the PAPI to validate that the
              requesting operator owns the service account being queried.
              Must match Caracteristica_Orden[MAYORISTA].Valor in MDM_CD_ORDEN.
            example: "1"
            required: true
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-wholesale-inventory-response.raml
                example: !include examples/response/get-wholesale-inventory-response-200.json
          400:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-401.json
          500:
            body:
              application/json:
                type: !include datatypes/response/error.raml
                example: !include examples/response/error-500.json