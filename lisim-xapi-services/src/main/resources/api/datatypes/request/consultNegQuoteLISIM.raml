#%RAML 1.0 DataType

properties:
  wsNegQuoteQueryRequest:
    type: object
    properties:
      wsRequestHeader:
        type: object
        properties:
          property:
            type: object
            properties:
              APELLIDO:
                type: string
                required: false
              NOMBRE:
                type: string
                required: false
              TRAMITE:
                type: string
                required: false
              USUARIO:
                type: string
                required: false
              CANAL:
                type: string
                required: false
              PROVEEDOR:
                type: string
                required: false
              CIUDAD:
                type: string
                required: false
              DEPARTAMENTO:
                type: string
                required: false
              SISTEMA_ORIGEN:
                type: string
                required: false
              MODELO:
                type: string
                required: false
      quoteCalculation:
        type: object
        properties:
          calculationObject:
            type: object
            properties:
              requestId:
                type: number
                required: true
              companyBasicInformation:
                type: object
                required: false
                properties:
                  businessName:
                    type: string
                    required: false
                  identificationType:
                    type: number
                    required: true
                  identification:
                    type: string
                    required: false
                  city:
                    type: number
                    required: true
                  address:
                    type: string
                    required: false
              companyAdditionalInformation:
                type: object
                required: false
                properties:
                  economicActivity:
                    type: number | nil
                    required: false 
                  constitutionDate:
                    type: string
                    required: true
                  stratum:
                    type: number
                    required: true
                  zoneId:
                    type: number
                    required: true
              legalRepresentative:
                type: object
                required: false
                properties:
                  names:
                    type: string
                    required: false
                  surnames:
                    type: string
                    required: false
                  identificationType:
                    type: number
                    required: true
                  identification:
                    type: string
                    required: false
                  dateBirth:
                    type: string
                    required: true
              generalBalance:
                type: object
                required: false
                properties:
                  totalCurrentAssets:
                    type: number
                    required: true
                  inventories:
                    type: number
                    required: true
                  totalAssets:
                    type: number
                    required: true
                  totalCurrentLiabilities:
                    type: number
                    required: true
                  totalLiabilities:
                    type: number
                    required: true
                  totalPatrimony:
                    type: number
                    required: true
              statusResults:
                type: object
                required: false
                properties:
                  currentYearOperatingRevenue:
                    type: number
                    required: true
                  currentYearNoOperatingRevenue:
                    type: number
                    required: true
                  previousYearOperatingRevenue:
                    type: number
                    required: true
                  previousYearNoOperatingRevenue:
                    type: number
                    required: true
                  costSale:
                    type: number
                    required: true
                  operationalExpenses:
                    type: number
                    required: true
                  operationalProfit:
                    type: number
                    required: true
                  otherExpenses:
                    type: number
                    required: true
                  netProfit:
                    type: number
                    required: true
                  beforeTaxProfit:
                    type: number
                    required: true
                  incomeTaxAndComplementary:
                    type: number
                    required: true
                  accountReceivable:
                    type: number
                    required: true
                  financialObligations:
                    type: number
                    required: true
              policy:
                type: object
                required: false
                properties:
                  description:
                    type: string
                    required: false