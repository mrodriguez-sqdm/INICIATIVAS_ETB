#%RAML 1.0 DataType
type: object
properties:
  wsIdentificationValidationNegResponse:
    type: object
    required: true
    properties:
      wsResponseHeader:
        type: object
        required: true
        properties:
          system:
            type: object
            required: true
            properties:
              name:
                type: string
                required: true
                example: "name"
              correlationId:
                type: string
                required: true
                example: "b5a95a63.f190.4c91.880a.5b54512fa6b1"
              processingServer:
                type: string
                required: true
                example: "source"
          service:
            type: object
            required: true
            properties:
              status:
                type: string
                required: true
                example: "PASS"
              responseDate:
                type: string
                required: true
                example: "2022-11-03T13:33:45.9229125-05:00"
              statusDetail:
                type: object
                required: true
                properties:
                  errorCode:
                    type: string
                    required: true
                    example: ""
                  errorDetailCode:
                    type: string
                    required: true
                    example: ""  
                  errorMessage:
                    type: string
                    required: true
                    example: ""                                      
              property?:
                type: array | nil
      identificationValidationResponse:
        type: object
        required: true
        properties:
          ValidarIdentificacionResult:
            type: object
            required: true
            properties:
              IdSolicitud:
                type: string
                required: true
                example: "1709"
              FechaControl:
                type: string
                required: true
                example: "2022-11-03T12:10:24.1221696-05:00"
              Existe:
                type: string
                required: true
                example: "false"
              Vigente:
                type: string
                required: true
                example: "false"
              IdError:
                type: string
                required: true
                example: "0"