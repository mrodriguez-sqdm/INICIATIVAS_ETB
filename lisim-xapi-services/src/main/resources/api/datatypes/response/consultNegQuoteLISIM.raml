#%RAML 1.0 DataType

properties:
  wsQuotaCalculationResponse:
    type: object
    required: false
    properties:
      wsResponseHeader:
        type: object
        required: false
        properties:
          system:
            type: object
            required: false
            properties:
              name:
                type: string
                required: false
                example: "Portal"
              correlationId:
                type: string
                required: false
                example: "1234"
              processingServer:
                type: string
                required: false
                example: "Test"
          service:
            type: object
            required: false
            properties:
              status:
                type: string
                required: false
                example: "PASS"
              responseDate:
                type: string
                required: false
                example: "2022-09-26T16:50:19.1526342-03:00"
              statusDetail:
                type: object
                required: false
                properties:
                  errorCode:
                    type: string
                    required: false
                    example: ""
                  errorDetailCode:
                    type: string
                    required: false
                    example: ""
                  errorMessage:
                    type: string
                    required: false
                    example: ""
          property:
            type: object
            required: false
            example: {}
      quotaCalculationResponse:
        type: object
        required: false
        properties:
          quotaCalculationResult:
            type: object
            required: false
            properties:
              requestId:
                type: number
                required: true
                example: 1
              controlDate:
                type: string
                required: true
                example: "2022-09-27T13:03:52.64"
              businessName:
                type: string
                required: false
                example: "Elcacharrito"
              nit:
                type: string
                required: false
                example: "800013931"
              approvedQuota:
                type: number
                required: true
                example: 1635000.0000
              score:
                type: number
                required: true
                example: 905
              riskLevel:
                type: string
                required: false
                example: "Medio"
              errorId:
                type: number
                required: true
                example: 0
              errorMessage:
                type: string
                required: false
                example: ""
              rejectionReason:
                type: string
                required: false