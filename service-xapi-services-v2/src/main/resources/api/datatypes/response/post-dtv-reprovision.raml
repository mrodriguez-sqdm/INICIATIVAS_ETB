#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Reprovision processed successfully
    required: false
  data:
    type: object
    required: false
    properties:
      responseMetadata:
        type: object
        properties:
          timeStamp:
            type: date-only
            example: '2025-12-11'
            required: false
          requestID:
            type: string
            example: '12345'
            required: false