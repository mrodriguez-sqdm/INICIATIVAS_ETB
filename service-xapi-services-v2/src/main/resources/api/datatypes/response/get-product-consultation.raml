#%RAML 1.0 DataType
description: Product consultation — responseCode plus response payload; when productType is SVAS, response.SVAS aggregates subscription, consumption and offers.
type: object
properties:
  responseCode:
    type: string
    example: "200"
  response:
    type: object
    additionalProperties: true
    properties:
      SVAS:
        type: object
        description: Present when productType is SVAS — raw subscription, consumption and product offers from downstream systems
        additionalProperties: true
        required: false
