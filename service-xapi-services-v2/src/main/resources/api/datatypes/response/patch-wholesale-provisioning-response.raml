#%RAML 1.0 DataType
# Wholesale Provisioning — response contract
# Endpoint: PATCH /v2/service/wholesale/provisioning/{orderNumber}
# Standard: TMF641 — PATCH /serviceActivation/{id}

type: object
properties:
  status:
    type: string
    required: true
    description: |
      Commercial order status after provisioning attempt.
      Key values:
      O90 : scheduling confirmed (provisioning triggered)
      O95 : provisioning in progress / ONT being activated
    example: "O95"
  orderNumber:
    type: string
    required: true
    description: Wholesale product order identifier.
    pattern: "MDM-MAY-\\d+"
    example: "MDM-MAY-00001"
  description:
    type: string
    required: false
    description: |
      Human-readable description of the provisioning result.
      When status is O95 with Orden_Activacion.Codigo==35,
      this field contains the ONT primary key (serial registered in OLT).
    example: "HWTCA12345678"
  serviceAccount:
    type: string
    required: false
    description: |
      Wholesale service account identifier.
      Source: Servicio_Tramite.Id_Cuenta_Servicio in MDM_CD_ORDEN.
    example: "GPONMAY_000001"
  activationDate:
    type: string
    required: false
    description: |
      Timestamp of provisioning completion, as returned by the Orquestador.
      Format: ISO 8601.
    example: "2024-08-29T13:38:10.573Z"
