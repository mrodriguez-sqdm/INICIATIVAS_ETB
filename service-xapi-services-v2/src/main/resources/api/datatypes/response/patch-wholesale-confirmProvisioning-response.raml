#%RAML 1.0 DataType
# Wholesale Confirm Provisioning — response contract
# Endpoint: PATCH /v2/service/wholesale/provisioning/{orderNumber}/confirm
# Standard: TMF641 — PATCH /serviceActivation/{id}
# Migrated from: operations-papi-services/datatypes/responses/201confirmProvisioning.raml

type: object
properties:
  status:
    type: string
    required: true
    description: |
      Commercial order status after confirmation attempt.
      Key values:
      O95  : ONT provisioned but confirmation still in progress (async retry path).
      O160 : activation completed — service is live.
    example: "O160"

  orderNumber:
    type: string
    required: true
    description: Wholesale product order identifier.
    pattern: "MDM-MAY-\\d+"
    example: "MDM-MAY-00001"

  description:
    type: string
    required: false
    description: |
      Human-readable description of the confirmation result.
      When status O95: contains Estado_Orden_Comercial.Excepcion.
      When status O160: contains Estado_Orden_Comercial.Descripcion or
      ProcesarOrdenResponse.Resultado.Estado.Descripcion.
    example: "Aprovisionamiento completado"
