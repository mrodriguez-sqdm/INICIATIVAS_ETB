#%RAML 1.0 DataType

type: object

properties:

  eventId:
    type: string
    example: 1d732753-ae1f-45f8-82f7-7243d395b1ac
    required: false

  eventType:
    type: string
    example: >-
      account_provision | error_notification | multi_product_added |
      multi_product_switched | multi_product_terminated |
      product_added | product_terminated | user_registered
    required: false

  userId:
    type: string
    example: 4fc94354-1e23-438b-9572-554f0343ef55
    required: false

  partnerUserId:
    type: string
    example: 67334b1d-b7d3-43c7-8561-ec8132dd2e0a
    required: false

  occurredAt:
    type: datetime
    example: 2022-04-11T21:19:18Z
    required: false

  eventData:
    type: object
    required: false
    properties:

      address:
        type: object
        required: false
        properties:
          country:
            type: string
            example: US
            required: false

      email:
        type: string
        example: user_email@example.com
        required: false

      phoneNumber:
        type: string
        example: '+1 (425) 555-1212'
        required: false

      name:
        type: string
        example: John Doe
        required: false

      action:
        type: string
        example: multi_product_added
        required: false

      newAccountIdChanged:
        type: string
        example: 83334b1d-b7d3-43c7-8561-ec8132dd2e83
        required: false

      error:
        type: string
        example: service_regression
        required: false

      errorDescription:
        type: string
        example: Platform is encountering an internal issue.
        required: false

      product:
        type: object
        required: false
        properties:

          code:
            type: string
            example: product123
            required: false

          subscriptionId:
            type: string
            example: e3a99020-b8d8-4f23-99c8-8f8d4c041328
            required: false

          starts:
            type: datetime
            example: 2022-04-09T21:28:24Z
            required: false

          expires:
            type: datetime
            example: 2019-12-05T14:24:13Z
            required: false

      products:
        type: array
        required: false
        items:
          type: object
          properties:

            code:
              type: string
              example: product123
              required: false

            name:
              type: string
              example: product A
              required: false

            starts:
              type: datetime
              example: 2021-12-01T15:36:40Z
              required: false

            renews:
              type: datetime
              example: 2022-01-01T00:00:00Z
              required: false

            expires:
              type: datetime
              example: 2023-01-01T00:00:00Z
              required: false

            subscriptionId:
              type: string
              example: 3d1abea8-dfe0-4f8e-8db9-6d45d7984576
              required: false

            transactionId:
              type: string
              example: ETB-TX-123456
              required: false

            status:
              type: string
              example: ACTIVE
              required: false

            reason:
              type: string
              example: OFFER_EXPIRED
              required: false

      productsTerminated:
        type: array
        required: false
        items:
          type: object
          properties:

            code:
              type: string
              example: product123
              required: false

            subscriptionId:
              type: string
              example: 3d1abea8-dfe0-4f8e-8db9-6d45d7984576
              required: false

      productsAdded:
        type: array
        required: false
        items:
          type: object
          properties:

            code:
              type: string
              example: product567
              required: false

            subscriptionId:
              type: string
              example: e3a99020-b8d8-4f23-99c8-8f8d4c041328
              required: false

            starts:
              type: datetime
              example: 2021-12-01T15:36:40Z
              required: false

            renews:
              type: datetime
              example: 2022-01-01T00:00:00Z
              required: false

            transactionId:
              type: string
              example: ETB-TX-456789
              required: false

      effectiveDate:
        type: datetime
        example: 2021-12-01T15:37:05Z
        required: false

      reason:
        type: string
        example: USER_PAUSED
        required: false

      details:
        type: string
        example: Pause requested by customer
        required: false