#%RAML 1.0 DataType
type: object
properties:
  productType:
    type: string
    enum: ["SVA","SVAS","SVAC","Movil","LTEC"]
    required: false
  gestor:
    type: string
    required: false

  msisdn:
    type: string
    required: false
  numeroConexion:
    type: string
    required: false
  svas:
    type: array
    required: false
    items:
      type: object
      properties:
        action:
          type: string
          required: false
        packageId:
          type: string
          required: false
        id:
          type: string
          required: false

  addonPackage:
    type: array
    required: false
    items:
      type: object
      properties:
        id:
          type: string
          required: false

  parentMSISDN:
    type: string
    required: false
  integrationId:
    type: string
    required: false
  billingAccountNumber:
    type: string
    required: false
  invoicingCycle:
    type: string
    required: false
  iccid:
    type: string
    required: false
  documentType:
    type: string
    required: false
  documentNumber:
    type: string
    required: false
