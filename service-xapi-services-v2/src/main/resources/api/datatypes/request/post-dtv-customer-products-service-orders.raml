#%RAML 1.0 DataType
type: object
description: Unified request for customer product operations (cancel, reconnect, capture, activation)

properties:

  action:
    type: string
    required: false
    example: "capture"

  product:
    type: object
    required: false
    properties:

      id:
        type: number
        required: false
        example: 449

      productKey:
        type: number
        required: false
        example: 449

      productCategory:
        type: object
        required: false
        properties:
          type:
            type: object
            required: false
            properties:
              code:
                type: string
                required: false
                example: "PREMIUM"

  flags:
    type: object
    required: false
    properties:
      immediate:
        type: boolean
        required: false
        example: true
      deleteOffer:
        type: string
        required: false
        example: "false"
      activateInAllDevices:
        type: string
        required: false
        example: "false"

  partnerUserId:
    type: string
    example: 4fc94354-1e23-438b-9572-554f0343ef55
    required: false

  occurredAt:
    type: datetime
    example: 2021-12-01T15:37:05Z
    required: false

  eventType:
    type: string
    example: >-
      account_provision | account_terminated | multi_product_added |
      multi_product_paused | multi_product_resumed |
      multi_product_switched | multi_product_terminated
    required: false

  eventData:
    type: object
    required: false
    properties:

      address:
        type: object
        required: false
        properties:
          country:
            type: string
            example: CA
            required: false

      email:
        type: string
        example: user_email@example.com
        required: false

      phoneNumber:
        type: string
        example: '+1 (425) 555-1212'
        required: false

      name:
        type: string
        example: John Doe
        required: false

      products:
        type: array
        required: false
        items:
          type: object
          properties:

            code:
              type: string
              example: productA
              required: false

            name:
              type: string
              example: product A
              required: false

            starts:
              type: datetime
              example: 2021-12-01T15:36:40Z
              required: false

            renews:
              type: datetime
              example: 2022-01-01T00:00:00Z
              required: false

            expires:
              type: datetime
              example: 2023-01-01T00:00:00Z
              required: false

            subscriptionId:
              type: string
              example: 6444ee9e-3b85-46ad-9f9c-54c01af31a0d
              required: false

            transactionId:
              type: string
              example: ETB-TX-456789
              required: false

            status:
              type: string
              example: ACTIVE
              required: false

            reason:
              type: string
              example: OFFER_EXPIRED
              required: false

      productsTerminated:
        type: array
        required: false
        items:
          type: object
          properties:

            code:
              type: string
              example: product123
              required: false

            subscriptionId:
              type: string
              example: 3d1abea8-dfe0-4f8e-8db9-6d45d7984576
              required: false

      productsAdded:
        type: array
        required: false
        items:
          type: object
          properties:

            code:
              type: string
              example: product567
              required: false

            subscriptionId:
              type: string
              example: e3a99020-b8d8-4f23-99c8-8f8d4c041328
              required: false

            starts:
              type: datetime
              example: 2026-08-06T16:50:00Z
              required: false

            renews:
              type: datetime
              example: 2022-01-01T00:00:00Z
              required: false

            transactionId:
              type: string
              example: 5bc887dd-031f-44e2-bd6c-795bfc58e53f
              required: false

      effectiveDate:
        type: datetime
        example: 2021-12-01T15:37:05Z
        required: false

      reason:
        type: string
        example: USER_PAUSED
        required: false

      details:
        type: string
        example: Pausa temporal solicitada por el cliente
        required: false