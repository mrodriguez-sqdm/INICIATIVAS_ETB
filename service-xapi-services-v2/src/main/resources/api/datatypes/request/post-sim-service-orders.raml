#%RAML 1.0 DataType 
type: object
properties:
  documentType:
    type: string
    example: CC
    required: false
  documentNumber:
    type: string
    example: '1095846957'
    required: false
  planPackage:
    type: array
    items:
      type: object
      properties:
        id:
          type: string
          example: '1231'
          required: false
  suscriberId:
    type: string
    example: '147896325'
    required: false
  MSISDN:
    type: string
    example: '70222479'
    required: false
  ICCID:
    type: string
    example: '12345678990123456987'
    required: false
  PAM:
    type: string
    example: '20'
    required: false
  integrationId:
    type: string
    example: '35547892514'
    required: false
