#%RAML 1.0 DataType
# Wholesale Provisioning — request contract
# Endpoint: PATCH /v2/service/wholesale/provisioning/{orderNumber}
# Standard: TMF641 — PATCH /serviceActivation/{id}
# orderNumber goes in the URI path, not in the body

type: object
properties:
  serial:
    type: string
    required: true
    description: |
      ONT (Optical Network Terminal) serial number installed at the customer premise.
    example: "HWTCA12345678"
  ontType:
    type: string
    required: true
    description: |
      ONT model code. Must match a valid entry in the MongoDB type-parameter catalog
      (typeParameter.provisionings). If not found, the PAPI returns HTTP 500.
    example: "HWTCA"
  transactType:
    type: string
    required: true
    enum: [ Commit, Rollback ]
    description: |
      Transaction type:
      Commit — confirms provisioning (triggers ProcesarOrden O90).
      Rollback — reverts a failed provisioning (triggers RestaurarProcesoOrden on O95).
    example: "Commit"
  cvlanHSI:
    type: string
    required: false
    description: Customer VLAN for HSI (High Speed Internet) service.
    example: "100"
  cvlanTR69:
    type: string
    required: false
    description: Customer VLAN for TR-069 (remote management) service.
    example: "200"
  cvlanVOIP:
    type: string
    required: false
    description: Customer VLAN for VoIP service.
    example: "300"
  serialOld:
    type: string | nil
    required: false
    description: Previous ONT serial number. Required when replacing an existing ONT.
    example: "HWTCA00000000"
  ontTypeOld:
    type: string | nil
    required: false
    description: Previous ONT model code. Required when replacing an existing ONT.
    example: "HWTCA"
