#%RAML 1.0 DataType 
type: object
properties:
  id:
    type: string
    example: 1d732753-ae1f-45f8-82f7-7243d395b1ac
    required: false
  event_type:
    type: string
    example: product_terminated
    required: false
  user_id:
    type: string
    example: 4fc94354-1e23-438b-9572-554f0343ef55
    required: false
  partner_user_id:
    type: string
    example: 67334b1d-b7d3-43c7-8561-ec8132dd2e0a
    required: false
  timestamp:
    type: integer
    example: 1649711958
    required: false
  event_data:
    type: object
    required: false
    properties:
      product:
        type: object
        required: false
        properties:
          code:
            type: string
            example: product123
            required: false
          sub_id:
            type: string
            example: e3a99020-b8d8-4f23-99c8-8f8d4c041328
            required: false
          starts:
            type: integer
            example: 16495421041
            required: false
          expires:
            type: integer
            example: 1575555853
            required: false
          reason:
            type: string
            example: PRODUCT_CANCELED
            required: false
      address:
        type: object
        required: false
        properties:
          country:
            type: string
            example: US
            required: false
      email:
        type: string
        example: user_email@example.com
        required: false
      phone_number:
        type: string
        example: +1 (425) 555-1212
        required: false
      name:
        type: string
        example: John Doe
        required: false
      products:
        type: array
        required: false
        items:
          type: object
          properties:
            code:
              type: string
              example: product123
              required: false
            sub_id:
              type: string
              example: 3d1abea8-dfe0-4f8e-8db9-6d45d7984576
              required: false
            status:
              type: string
              example: PENDING
              required: false
            starts:
              type: integer
              example: 1638365000
              required: false
            expires:
              type: integer
              example: 1638365025
              required: false
            reason:
              type: string
              example: OFFER_EXPIRED
              required: false
      action:
        type: string
        example: multi_product_added
        required: false
      products_added:
        type: array
        required: false
        items:
          type: object
          properties:
            code:
              type: string
              example: product567
              required: false
            sub_id:
              type: string
              example: e3a99020-b8d8-4f23-99c8-8f8d4c041328
              required: false
            starts:
              type: string
              example: '1638365000'
              required: false
      products_terminated:
        type: array
        required: false
        items:
          type: object
          properties:
            code:
              type: string
              example: product123
              required: false
            sub_id:
              type: string
              example: 3d1abea8-dfe0-4f8e-8db9-6d45d7984576
              required: false
      effective_date:
        type: integer
        example: 1638365025
        required: false
      error:
        type: string
        example: service_regression
        required: false
      error_description:
        type: string
        example: Platform is encountering an internal issue.
        required: false
      new_account_id_changed:
        type: string
        example: 83334b1d-b7d3-43c7-8561-ec8132dd2e83
        required: false