#%RAML 1.0 DataType
description: "Delete order (SVAS). Body fields; send subscriptionId or connectionNumber to resolve JSC subscription."
type: object
properties:
  origin:
    type: string
    required: false
    example: "WEB"
  order:
    type: string
    required: false
  orderType:
    type: string
    required: false
  connectionNumber:
    type: string
    required: false
    example: "573001234567"
  productType:
    type: string
    required: true
    example: "SVAS"
  subscriptionId:
    type: string
    required: false
