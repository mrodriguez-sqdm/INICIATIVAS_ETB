#%RAML 1.0
title: service-xapi-services
version: v2
baseUri: https://service-xapi-services-v2-{env}.us-e2.cloudhub.io/{version}
protocols:
  - HTTPS

description: "# Service Experience API Services"

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/service:
   get:
      is:
          - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: service
      description: resource service information
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: "Parameter that allows the origin of the request to be identified"
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        SERVICE_ACCOUNT:
          type: string
          example: "12552454"
          description: "number account service"
          required: false
        BILLING_ACCOUNT:
          type: string
          example: "12552454"
          description: "number billing account"
          required: false
        CONNECTION_NUMBER:
          type: string
          example: "542545454"
          description: "Number connection, this number is phone"
          required: false
        RESOURCE_ID:
          type: string
          description: "Network element to which the query is applied"
          required: false
        RESOURCE_TYPE:
          type: string
          description: "resource type"
          required: false
        OPERATION:
          type: string
          example: "LTE"
          description: "operation on the requested query"
          required: false
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/get-service.raml
              examples:
                LTE:
                  value: !include /examples/response/get-service-lte.json
                FTTH:
                  value: !include /examples/response/get-service-ftth.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
   post:
      is:
          - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: service activate
      description: SERVICE ACTIVATE
      body:
        application/json:
          type: !include /datatypes/request/post-service-activate.raml
          example: !include /examples/request/post-service-activate.json
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/post-service-activate.raml
              example: !include /examples/response/post-service-activate-200.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

/order:
  post:
    is:
        - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Crear orden (XAPI)
    description: "Experience API — creación de orden (LTE); delega en service-papi-services-v2 POST /order. TELEFONIA devuelve 501 desde PAPI."
    body:
      application/json:
        type: !include /datatypes/request/post-order-modification.raml
        example: !include /examples/request/post-order-modification.json
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/post-order-modification.raml
            example: !include /examples/response/post-order-modification-200.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
      501:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
  delete:
    is:
        - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Eliminar orden (XAPI)
    description: "Experience API — DELETE /order con body; delega en service-papi-services-v2."
    body:
      application/json:
        type: !include /datatypes/request/delete-order.raml
        example: !include /examples/request/delete-order.json
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/delete-order.raml
            example: !include /examples/response/delete-order-200.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json

/product:
   get:
      is:
          - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Product consultation
      description: "Consulta de producto (Experience). Parámetros en query; delega en service-papi-services-v2 GET /product. Para SVAS incluye suscripción JSC, consumo y ofertas mongo."
      queryParameters:
        origin:
          type: string
          description: Source channel identifier
          required: false
        ip:
          type: string
          description: Client IP
          required: false
        productType:
          type: string
          required: true
          example: "SVAS"
        category:
          type: string
          required: false
        product:
          type: string
          description: For SVAS, MSISDN if connectionNumber is omitted
          required: false
        connectionNumber:
          type: string
          description: MSISDN for SVAS (preferred)
          required: false
        cdrDetailType:
          type: string
          description: CDR detail filter sent to JSC consumption details (mandatory when productType is SVAS)
          required: false
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/get-product-consultation.raml
              example: !include /examples/response/get-product-consultation-svas.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
/customer-products:
  /{id}:
    /service-orders:
      post:
        is:
            - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Manage OTT Service Orders
        description: |
          Creates a service order to manage OTT subscriptions, supporting activation (add) and state changes (modify such as cancel or reconnect).
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
          OTT_PLATFORM:
            type: string
            enum:
              - DIRECTV
              - HBO
            example: "DIRECTV"
            description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY, HBO).
        body:
          application/json:
            type: !include /datatypes/request/post-dtv-customer-products-service-orders.raml
            examples: 
                  activation: !include /examples/request/post-dtv-customer-products-service-orders-activation.json
                  cancelCustomer: !include /examples/request/post-dtv-customer-products-service-orders-cancelCustomer.json
                  reconnectCustomer: !include /examples/request/post-dtv-customer-products-service-orders-reconnectCustomer.json
                  cancelAmazon: !include /examples/request/post-dtv-customer-products-service-orders-cancelAmazon.json
                  reconnectAmazon: !include /examples/request/post-dtv-customer-products-service-orders-reconnectAmazon.json

                  accountProvision: !include /examples/request/post-hbo-customer-products-service-orders-accountProvision.json
                  accountTerminated: !include /examples/request/post-hbo-customer-products-service-orders-accountTerminated.json
                  multiProductAdded: !include /examples/request/post-hbo-customer-products-service-orders-multiProductAdded.json
                  multiProductTerminated: !include /examples/request/post-hbo-customer-products-service-orders-multiProductTerminated.json
                  multiProductSwitched: !include /examples/request/post-hbo-customer-products-service-orders-multiProductSwitched.json
                  multiProductPaused: !include /examples/request/post-hbo-customer-products-service-orders-multiProductPaused.json
                  multiProductResumed: !include /examples/request/post-hbo-customer-products-service-orders-multiProductResumed.json
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/post-dtv-customer-products-service-orders.raml
                examples: 
                  activation: !include /examples/response/post-dtv-customer-products-service-orders-activation.json
                  cancelCustomer: !include /examples/response/post-dtv-customer-products-service-orders-cancelCustomer.json
                  reconnectCustomer: !include /examples/response/post-dtv-customer-products-service-orders-reconnectCustomer.json
                  cancelAmazon: !include /examples/response/post-dtv-customer-products-service-orders-cancelAmazon.json
                  reconnectAmazon: !include /examples/response/post-dtv-customer-products-service-orders-reconnectAmazon.json

                  accountProvision: !include /examples/response/post-hbo-customer-products-service-orders-accountProvision.json
                  accountTerminated: !include /examples/response/post-hbo-customer-products-service-orders-accountTerminated.json
                  multiProductAdded: !include /examples/response/post-hbo-customer-products-service-orders-multiProductAdded.json
                  multiProductTerminated: !include /examples/response/post-hbo-customer-products-service-orders-multiProductTerminated.json
                  multiProductSwitched: !include /examples/response/post-hbo-customer-products-service-orders-multiProductSwitched.json
                  multiProductPaused: !include /examples/response/post-hbo-customer-products-service-orders-multiProductPaused.json
                  multiProductResumed: !include /examples/response/post-hbo-customer-products-service-orders-multiProductResumed.json

          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
          501:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
    /service:
      get:
        is:
            - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Retrieve OTT Subscriber Details
        description: |
          Retrieves detailed information of a subscriber in a third-party OTT platform, including customer profile, product subscriptions, service status, and interaction history.
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
          OTT_PLATFORM:
            type: string
            enum:
              - DIRECTV
              - HBO
            example: "DIRECTV"
            description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY, HBO).
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-dtv-customer-products-service.raml
                examples:
                  DIRECTV: !include /examples/response/get-dtv-customer-products-service.json
                  HBO: !include /examples/response/get-hbo-customer-products-service.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
          501:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
      /reprovision:
        post:
          is:
              - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Reaprovision product OTT
          description: |
            Sincroniza el estado de una suscripción en Amazon:
            1. Consulta el estado actual en la plataforma de Amazon.
            2. Si está activa (CREATED), solicita una URL tokenizada para refrescar el acceso.
            3. Si no se encuentra la suscripción, inicia el flujo para crear una nueva.
          body:
            application/json:
              type: !include /datatypes/request/post-dtv-reprovision.raml
              example: !include /examples/request/post-dtv-reprovision.json
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/post-dtv-reprovision.raml
                  example: !include /examples/response/post-dtv-reprovision.json
            400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
            401:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-401.json
            404:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-404.json
            500:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json
            501:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json
  /redirect:
    /{providerId}:
      get:
        is:
            - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Generate OTT Registration URL
        description: |
          This service generates a temporary redirect URL to OTT. Discovery to initiate or continue a customer's registration or login process on ott.
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
          OTT_PLATFORM:
            type: string
            enum:
              - HBO
            example: "HBO"
            description: Identifies the third-party OTT provider to which the request is directed (e.g., DIRECTV, PRIME_VIDEO, DISNEY, HBO).
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-ott-customer-products-redirect-providerId.raml
                examples:
                  HBO: !include /examples/response/get-hbo-customer-products-redirect-providerId.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
          501:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
  /event-listener:
    post:
      displayName: Receive WBD Events
      description: |
        Receives registration, subscription and error events generated by Warner Bros. Discovery.

      headers:
        Date:
          type: string
          required: true
          description: |
            Request date and time in UTC using RFC-1123 format.
          example: "Fri, 01 Dec 2021 01:23:45 UTC"

        Digest:
          type: string
          required: true
          description: |
            SHA-512 digest of the request body encoded in Base64.
          example: "SHA-512=Zj4TA4TlWrVIQDKP4vZ+R3TrGiTsx/K0v3zfMDmSgRoZQiOLn1v1FDKXOPJUPd8F7rzkBW/BFwttypR+KZgHmQ=="

        Signature:
          type: string
          required: true
          description: |
            HTTP digital signature generated by WBD using its private key.
          example: 'keyId="abc123def456_test",algorithm="hs2019",created=1638365025,headers="host date (request-target) digest",signature="0uKeDxj+Mg2Bh9cBnZ/25lXJs5n+qj93FvPkYpnqtTE="'

      body:
        application/json:
          type: !include /datatypes/request/post-hbo-customer-products-event-listener.raml
          examples:
            accountProvision: !include /examples/request/post-hbo-customer-products-event-listener-account-provision.json
            userRegistered: !include /examples/request/post-hbo-customer-products-event-listener-user-registered.json
            productAdded: !include /examples/request/post-hbo-customer-products-event-listener-product-added.json
            productTerminated: !include /examples/request/post-hbo-customer-products-event-listener-product-terminated.json
            errorNotificationEventProduct: !include /examples/request/post-hbo-customer-products-event-listener-error-notification-multi-product-added.json
            errorNotificationEventUser: !include /examples/request/post-hbo-customer-products-event-listener-error-notification-event-user.json
            multiProductAdded: !include /examples/request/post-hbo-customer-products-event-listener-multi-product-added.json
            multiProductTerminated: !include /examples/request/post-hbo-customer-products-event-listener-multi-product-terminated.json
            multiProductSwitched: !include /examples/request/post-hbo-customer-products-event-listener-multi-product-switched.json
      responses:
        204:
          description: Event received successfully.
    /sim-service-orders:
      post:
        is:
            - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Create SIM Service Order
        description: |
          Creates a service order to activate a SIM card and provision the associated mobile service.
        queryParameters:
          ORIGIN:
            type: string
            example: "WHATSAPP"
            description: "Parameter that allows the origin of the request to be identified"
        body:
          application/json:
            type: !include /datatypes/request/post-sim-service-orders.raml
            examples: 
              activation: !include /examples/request/post-sim-service-orders-activation.json
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/post-sim-service-orders.raml
                examples: 
                  activation: !include /examples/response/post-sim-service-orders-activation.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
          501:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json