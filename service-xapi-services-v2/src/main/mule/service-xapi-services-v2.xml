			name="service-papi-post-activate-sim-clientSub_Flow" />
	</flow>
	<flow
		name="patch:\service\wholesale\provisioning\(orderNumber):application\json:service-xapi-services-config"
		doc:id="1f338ffb-9062-418c-904e-4486dee53ec5">
		<flow-ref
			doc:name="patch-service-wholesale-provisioning-clientSub_Flow"
			doc:id="e01a5a07-eef7-43f0-a80b-0e2b5d38826a"
			name="patch-service-wholesale-provisioning-clientSub_Flow" />
	</flow>
	<flow name="patch:\service\wholesale\provisioning\(orderNumber)\confirm:service-xapi-services-config" doc:id="9f821bc1-386c-4d50-a05c-77f37eb48cda" >
		<flow-ref doc:name="patch-service-wholesale-provisioning-confirm-clientSub_Flow" doc:id="3daff71c-45a2-4e4e-9954-746d037a01d8" name="patch-service-wholesale-provisioning-confirm-clientSub_Flow" />
	</flow>
</mule>
