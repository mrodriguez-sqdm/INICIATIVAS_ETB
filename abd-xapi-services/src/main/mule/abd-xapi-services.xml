		<ee:transform doc:name="Authentication" doc:id="2dc92aea-664d-43b1-a1af-dd2c2e168b5e">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="authenticated"><![CDATA[%dw 2.0
output application/java
import * from dw::core::Binaries
import * from dw::Runtime
var user = (try(() -> payload.body.receiveMessage.userId)).result
var pass = (try(() -> payload.body.receiveMessage.password)).result
---
if (!isBlank(user))
    if (!isBlank(pass))
        if(toBase64(user ++ ":" ++ pass) == p('auth.basic'))
            {
                "authenticated": true,
                "description": null
            }
        else 
            {
                "authenticated": false,
                "description": {
                    "Fault": {
                        faultcode: "soap:Client",
                        faultstring: "Unauthorized. Username or password invalid"
                    }
                }
            }
    else
        {
                "authenticated": false,
                "description": {
                    "Fault": {
                        faultcode: "soap:Server",
                        faultstring: "Missing required element 'password'"
                    }
                }
            }
else
    {
        "authenticated": false,
        "description": {
            "Fault": {
                faultcode: "soap:Server",
                faultstring: "Missing required element 'userId'"
            }
        }
    }]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
