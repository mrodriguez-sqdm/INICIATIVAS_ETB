#%RAML 1.0 DataType
properties:
  email:
    type: string
    example: "testing@etb.com"
  eid:
    type: string
    example: "CS-2203942"
  cuentaServicio: 
    type: string
    example: "CS-2203942"
    required: false
  sku:
    type: array
    items:
      properties: 
        code:
          type: string
          example: "PREDIR"
        amount:
          type: integer
          example: 1

example:
  !include ../../examples/request/post-sku.json
