#%RAML 1.0
title: asap-sapi-services
baseUri: http://asap-sapi-services-dev.us-e2.cloudhub.io/asap
description: 
mediaType: 
  - application/json
protocols:
  - HTTP

traits: 
  security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml

/v1:
  /publish:
    post:
      is: [security-client-id,tibcoHeaders]
      displayName: Pushes message to ASAP.
      description: Pushes message to JMS queue in ASAP.
      body:
        application/json:
          type: !include datatypes/request/publishMessage.raml
          example: !include examples/request/inputMessageASAP2.json
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/response/publishMessage.raml
  /user:
    post:
      is: [security-client-id]
      displayName: Dar de alta un usario.
      description: Dar de alta un usario.
      body:
        application/json:
          type: !include datatypes/request/post-user.raml
          example: !include examples/request/post-user.json
      responses:
        201:
          body:
            application/json:
              type: {}
    delete:        
      is: [security-client-id]
      displayName: Dar de baja a un usario.
      description: Dar de baja a un usario.
      body:
        application/json:
          type: !include datatypes/request/delete-user.raml
          example: !include examples/request/delete-user.json
      responses:
        201:
          body:
            application/json:
              type: {}
  /sku:
    post:
      is: [security-client-id]
      displayName: Dar de alta SKU.
      description: Dar de alta SKU.
      body:
        application/json:
          type: !include datatypes/request/post-sku.raml
          example: !include examples/request/post-sku.json
      responses:
        201:
          body:
            application/json:
              type: {}
    delete:
      is: [security-client-id]
      displayName: Dar de baja un SKU.
      description: Dar de baja un SKU.
      body:
        application/json:
          type: !include datatypes/request/delete-sku.raml
          example: !include examples/request/delete-sku.json
      responses:
        201:
          body:
            application/json:
                type: {}