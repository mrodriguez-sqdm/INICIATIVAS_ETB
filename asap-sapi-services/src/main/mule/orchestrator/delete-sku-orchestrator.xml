<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="delete-sku-orchestratorSub_Flow" doc:id="a60329ba-4163-4ee4-94ef-648228fb7880" >
		<ee:transform doc:name="Request payload" doc:id="88314509-cea6-46c1-9462-01c1b55f3b3b">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "email": payload.email,
  "eid": payload.eid,
  "skus": {
    "code": payload.skus[0].code,
    "amount": payload.skus[0].amount
  }
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="5a9879fc-9457-41bc-92db-60dac6a1f355" message="#[payload]" />
		<flow-ref doc:name="Go to client" doc:id="9c5f26a0-da31-40fa-9c3e-3d9de2a45711" name="delete-sku-clientSub_Flow"/>
		<choice doc:name="Choice" doc:id="2fe8ed2e-0670-47d9-b566-40aa88d1dcbc" >
			<when expression="#[payload.status != 200]">
				<set-variable value="#[payload.status]" doc:name="Set httpStatus" doc:id="3b004d25-e1b9-4c5d-8ac6-b6970f815096" variableName="httpStatus" />
				<ee:transform doc:name="Error Response" doc:id="066b600a-7337-47ed-97cc-d95244492804">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	code: payload.status,
	description: payload.message
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<ee:transform doc:name="Success response" doc:id="8eef1140-4053-42f0-a6ad-1b8bcbeaef8b">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	code: payload.status,
	description: "Proceso exitoso"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
