#%RAML 1.0 DataType 
type: object
properties:
  WSRequestHeader:
    type: !include objects/header.raml
    required: true
  WSRequestBody:
    type: object
    properties:
      Agrupation_Number:
        type: integer
        example: 12345
        required: false
      Name:
        type: string
        example: PasaGigas 1GB
        required: false
      Audit:
        type: object
        properties:
          Canal:
            type: string
            example: Web
            required: false
          Id_Device:
            type: string
            example: DESKTOP-ABC123
            required: false
          SO:
            type: string
            example: Windows 10
            required: false
          IP_Address:
            type: string
            example: 192.168.1.100
            required: false
          WhatsApp_Phone_Number:
            type: 'null'
            example: null
            required: false


