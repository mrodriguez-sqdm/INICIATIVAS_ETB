#%RAML 1.0 DataType 
type: object
properties:
  WSRequestHeader:
    type: !include objects/header.raml
    required: true
  WSRequestBody:
    type: object
    properties:
      Audit:
        type: object
        properties:
          Canal:
            type: string
            example: APP
            required: false
          Id_Device:
            type: string
            example: device-01
            required: false
          SO:
            type: string
            example: Android
            required: false
          IP_Address:
            type: string
            example: 10.0.0.1
            required: false
          WhatsApp_Phone_Number:
            type: string
            example: ''
            required: false
      Service_Account:
        type: string
        example: '6001234567'
        required: false
      Serial:
        type: string
        example: ZTEGC1234567
        required: false



