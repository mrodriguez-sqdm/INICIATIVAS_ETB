#%RAML 1.0 DataType 
type: object
properties:
  WSRequestHeader:
    type: !include objects/header.raml
    required: true
  WSRequestBody:
    type: object
    properties:
      Audit:
        type: object
        properties:
          Canal:
            type: string
            example: APP
            required: false
          Id_Device:
            type: string
            example: ''
            required: false
          SO:
            type: string
            example: ''
            required: false
          IP_Address:
            type: string
            example: ''
            required: false
          WhatsApp_Phone_Number:
            type: string
            example: ''
            required: false
      MAC:
        type: string
        example: AA:BB:CC:DD:EE:FF
        required: false
      Service_Account:
        type: string
        example: '6001234567'
        required: false
      Serial:
        type: string
        example: ZTEGC1234567
        required: false
      State:
        type: boolean
        example: true
        required: false



