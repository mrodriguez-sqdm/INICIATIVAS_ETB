#%RAML 1.0 DataType 
type: object
properties:
  WSRequestHeader:
    type: !include objects/header.raml
    required: true
  WSRequestBody:
    type: object
    properties:
      Service_Account:
        type: string
        example: '12345678'
        required: false
      Audit:
        type: object
        properties:
          User:
            type: string
            example: agente.sp1n
            required: false
          Channel:
            type: string
            example: SOPORTE1N
            required: false
