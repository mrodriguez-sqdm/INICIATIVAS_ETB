#%RAML 1.0 DataType 
type: object
properties:
  WSResponseHeader:
    type: !include objects/header.raml
    required: true
  WSResponseBody:
    type: object
    properties:
      Benefits:
        type: string
        example: 1GB de datos adicionales para navegación
        required: false
      Channel:
        type: string
        example: Móvil
        required: false
      Description:
        type: string
        example: Servicio de datos adicionales para navegación móvil
        required: false
      Id:
        type: integer
        example: 12345
        required: false
      Image:
        type: object
        properties:
          Icon:
            type: string
            example: https://cdn.etb.com/icons/pasagigas.png
            required: false
          Logo:
            type: string
            example: https://cdn.etb.com/logos/pasagigas-logo.png
            required: false
      Instructions:
        type: string
        example: Activar desde la aplicación MiETB o llamando al 123
        required: false
      Name:
        type: string
        example: PasaGigas 1GB
        required: false
      Technical_Conditions:
        type: string
        example: Válido por 30 días desde la activación
        required: false
      Tooltip:
        type: array
        items:
          type: string
      Validity:
        type: string
        example: 30 días
        required: false
      Value:
        type: integer
        example: 15000
        required: false
      Value_Str:
        type: string
        example: $15.000
        required: false
