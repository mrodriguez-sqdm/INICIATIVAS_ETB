<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">
<apikit:config name="warner-bros-sapi-services-config" api="resource::35a39a92-efa9-49b6-8f13-d66508fd2f35:warner-bros-sapi-services:1.0.11:raml:zip:warner-bros-sapi-services.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
	<!-- ================================================================== -->
	<!-- PROPERTY SOURCES -->
	<!-- order: secure props → environment → common -->
	<!-- ================================================================== -->

	<!-- Secure Properties (Blowfish/CBC encrypted) -->
	<secure-properties:config
		name="Secure_Properties_Config" doc:name="Secure Properties"
		doc:id="9f71883f-8f1c-464c-b025-34fd47ab4119"
		file="secureProperties/${env}-secure-properties.yaml"
		key="${secure.key}">
		<secure-properties:encrypt
			algorithm="Blowfish" />
	</secure-properties:config>
	
	<!-- Environment-specific properties -->
	<configuration-properties
		doc:name="Environment properties"
		doc:id="a24ed7fa-9fec-44f3-bbac-abae74f702ce"
		file="properties/${env}-properties.yaml" />
		
	<!-- Common properties (shared across all environments) -->
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="26a8eed0-dd9b-45df-8d7c-8acccdad1bee"
		file="properties/common-properties.yaml" />
		
	<!-- ================================================================== -->
	<!-- API AUTODISCOVERY -->
	<!-- ================================================================== -->
	<api-gateway:autodiscovery apiId="${api.id}"
		ignoreBasePath="true" doc:name="API Autodiscovery"
		doc:id="972634bc-727e-438b-97ae-343a40a24259"
		flowRef="warner-bros-sapi-services-main" />
		
	<!-- ================================================================== -->
	<!-- ETB COMMON LIB Imports -->
	<!-- ================================================================== -->
	<import doc:name="Error Handler v2"
		doc:id="e4d2ff34-b8c9-42cd-b0a5-08590f43668a"
		file="error-handler-v2.xml" />
	<import doc:name="ETB Common Lib"
		doc:id="b29290a0-c795-4e31-8fdd-7830960cfcc2"
		file="etb-common-lib.xml" />
	<import doc:name="Logging"
		doc:id="66022574-eb7e-4593-9002-96ce0071c060" file="loggin.xml" />
	<import doc:name="Audits SAPI Client"
		doc:id="c4161f99-69d0-4f27-9ffa-41d7942420d3"
		file="audits-sapi-client.xml" />
	<import doc:name="Insert Audits"
		doc:id="2b02c44e-82e9-408b-bd81-8248bf8471a0"
		file="insert-audit.xml" />

	<!-- ================================================================== -->
	<!-- HTTP LISTENER -->
	<!-- ================================================================== -->
    <http:listener-config name="warner-bros-sapi-services-httpListenerConfig" doc:name="HTTP Listener Config">
        <http:listener-connection host="${http.private.host}" port="${http.private.port}" readTimeout="${configurationTimeout.warner-bros-sapi-listener}" connectionIdleTimeout="${configurationTimeout.warner-bros-sapi-listener-ide}"/>
    </http:listener-config>
	<!-- ================================================================== -->
	<!-- HTTP REQUESTER -->
	<!-- TODO: This is an example, configure for your backend system -->
	<!-- ================================================================== -->
	<http:request-config
		name="HTTP_wbd_Request_Config"
		doc:name="HTTP Backend Request Config" basePath="${wbd.basePath}" responseTimeout="${wbd.responseTimeout}">
		<http:request-connection
			host="${wbd.host}"
			port="${wbd.port}"
			connectionIdleTimeout="${wbd.connectionIdleTimeout}" protocol="HTTPS">
			<reconnection>
				<reconnect frequency="${wbd.reconnection.frequency}"
					count="${wbd.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
	<http:request-config
		name="HTTP_jwks_wbd_Request_Config"
		doc:name="HTTP Backend Request Config" basePath="${wbd.jwks.basePath}">
		<http:request-connection
			host="${wbd.jwks.host}"
			port="${wbd.jwks.port}"
			connectionIdleTimeout="${wbd.connectionIdleTimeout}" protocol="HTTPS">
			<reconnection>
				<reconnect frequency="${wbd.reconnection.frequency}"
					count="${wbd.reconnection.count}" />
			</reconnection>
		</http:request-connection>
	</http:request-config>
</mule>
