<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:java="http://www.mulesoft.org/schema/mule/java"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/java http://www.mulesoft.org/schema/mule/java/current/mule-java.xsd">
	<sub-flow name="post-events-wbd-orchestrator"
		doc:id="029cce0a-392e-46ec-89b5-a5fe5979f941">
		<java:invoke-static method="generateHeaders(java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String)" doc:name="Invoke static" doc:id="cc4cc089-b64a-4f13-8fca-4a224478816f" class="com.etb.security.WbdSignatureUtil" target="wbdHeaders">
			<java:args><![CDATA[#[{
    arg0: "POST",
    arg1: p("wbd.host"),
    arg2: p("wbd.basePath")
        ++ (p("wbd.events.path") replace "{partnerId}" with p("wbd.partnerId")),
    arg3: p("wbd.api.keyId"),
    arg4: p("wbd.api.privateKey"),
    arg5: write(payload, "application/json")
}]]]></java:args>
		</java:invoke-static>
		<set-variable value="#[payload]" doc:name="Set Variable" doc:id="978711d6-0e32-4d31-872b-9d1e71942c60" variableName="request"/>
		<flow-ref doc:name="post-event-wbd-client"
			doc:id="5769df10-89f4-48d5-91d5-03dae0defab1"
			name="post-event-wbd-client" />
		<logger level="INFO" doc:name="Logger" doc:id="6aaa8736-c79f-4258-98da-670b00eb26a3" message="#[%dw 2.0&#10;output application/java&#10;---&#10;{&#10;    httpStatus: attributes.statusCode&#10;}]"/>
		<ee:transform doc:name="Transform Message" doc:id="cb98decf-33ba-4bfe-b3c5-c67484789684" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    code: (attributes.statusCode) as String,
    message: "Event accepted for processing",
    result: {
        eventId: vars.request.id default "",
        eventType: vars.request.event_type default "",
        status: if (attributes.statusCode == 202)
                    "ACCEPTED"
                else
                    "REJECTED"
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
