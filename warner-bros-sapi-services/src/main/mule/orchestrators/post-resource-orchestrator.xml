<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:java="http://www.mulesoft.org/schema/mule/java"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/java http://www.mulesoft.org/schema/mule/java/current/mule-java.xsd">
	<sub-flow name="events-wbd-orchestrator"
		doc:id="029cce0a-392e-46ec-89b5-a5fe5979f941">
		<logger level="INFO" doc:name="Log Orchestration Start"
			message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=POST /resources"]' />
		<java:invoke-static method="generateHeaders(java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String,java.lang.String)" doc:name="Invoke static" doc:id="cc4cc089-b64a-4f13-8fca-4a224478816f" class="com.etb.security.WbdSignatureUtil" target="wbdHeaders">
			<java:args><![CDATA[#[{
    arg0: "POST",
    arg1: p("wbd.host"),
    arg2: p("wbd.basePath")
        ++ (p("wbd.events.path") replace "{partnerId}" with p("wbd.partnerId")),
    arg3: p("wbd.api.keyId"),
    arg4: p("wbd.api.privateKey"),
    arg5: write(payload, "application/json")
}]]]></java:args>
		</java:invoke-static>
		<flow-ref doc:name="post-subscription-wbd-client"
			doc:id="5769df10-89f4-48d5-91d5-03dae0defab1"
			name="post-subscription-wbd-client" />
		<ee:transform doc:name="set response" doc:id="2443e73e-8ba8-4e37-b23f-81a803d4dc8f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if (attributes.statusCode == 202) {
	"Code": 202,
	"Message": "Operation accepted",
	"Result": "Accepted"
	}
else {
	"Code": attributes.statusCode,
	"Message": payload.error,
	"Result": payload.error_description
	}
]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/json
---
if (attributes.statusCode == 202)
	200
else
	400]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Log Orchestration End"
                message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=POST /resources | status=201"]' />
	</sub-flow>
</mule>
