<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="get-subscription-wbd-client"
		doc:id="a0ad8c52-b545-4454-b69c-aa6b485e2208">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=GET /subscriptions/parnertId"]' />

		<http:request config-ref="HTTP_wbd_Request_Config"
			method="${wbd.subscriptions.get.method}"
			path="${wbd.subscriptions.path}" target="backendResponse"
			doc:name="GET /subscriptions" sendCorrelationId="AUTO"
			responseTimeout="${wbd.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json",
    "Date": vars.getHeaders.date,
  	"Signature": vars.getHeaders.signature
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[vars.getUriParams]]]></http:uri-params>
			<http:query-params ><![CDATA[#[vars.getQueryParams]]]></http:query-params>
		</http:request>

		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=GET /subscriptions/parnertId | status=OK"]' />
	</sub-flow>
	<sub-flow name="post-subscription-wbd-client"
		doc:id="7555fd1f-d02c-4756-85d6-5329893b9eb9">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /events/parnertId"]' />

		<http:request doc:name="POST /events"
			doc:id="4d0df5c8-60eb-472b-b384-055faab94e81"
			config-ref="HTTP_wbd_Request_Config"
			method="${wbd.events.post.method}"
			path="${wbd.events.path}" sendCorrelationId="AUTO"
			target="backendResponse" responseTimeout="${wbd.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json",
    "Content-Type": vars.postHeaders."Content-Type",
    "Date": vars.postHeaders.Date,
    "Digest": vars.postHeaders.Digest,
    "Signature": vars.postHeaders.Signature
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[vars.postUriParams]]]></http:uri-params>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /events/parnertId | status=CREATED"]' />
	</sub-flow>
</mule>
