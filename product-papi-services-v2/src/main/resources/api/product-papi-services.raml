#%RAML 1.0
title: product-papi-services
version: "2"
protocols:
  - HTTP
mediaType:
  - application/json
baseUri: https://product-papi-services-v2-{env}.us-e2.cloudhub.io/{version}
description: API de productos PAPI v2 (recarga de saldo, recarga de paquete, promociones y oferta comercial).

/getpromotions:
  post:
    displayName: Get promotions
    description: |
      Consulta promociones en sisext-sapi.
      El campo type (movil|fijo|mobile|fixed) enruta a POST /v1/promotions/mobile o /v1/promotions/fixed.
      Si analytics=true (solo fijo), primero consulta analitica-sapi (/ofertasSugeridas) y fusiona los Id
      en predefinedPromotions antes de llamar PROM_Promociones_Fija.
      Headers X-CORRELATION-ID y systemId se reenvían a sisext.
    body:
      application/json:
        type: !include datatypes/request/post-promotions.raml
        example: !include examples/request/post-promotions-mobile.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/post-promotions.raml
            example: !include examples/response/post-promotions-mobile.json
      400:
        body:
          application/json:
            type: !include datatypes/response/notFoundError.raml
      500:
        body:
          application/json:
            type: !include datatypes/response/internalServerError.raml

/usageConsumptionReport:
  post:
    displayName: Recarga de saldo (Usage Consumption Report)
    description: Recarga de saldo en línea.
    body:
      application/json:
        type: !include datatypes/request/usageConsumptionReport.raml
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/usageConsumptionReport.raml
      404:
        body:
          application/json:
            type: !include datatypes/response/notFoundError.raml
      500:
        body:
          application/json:
            type: !include datatypes/response/internalServerError.raml
/usageConsumption:
  post:
    displayName: Recarga de paquete (Usage Consumption)
    description: Recarga de paquete(s) en línea.
    body:
      application/json:
        type: !include datatypes/request/usageConsumption.raml
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/usageConsumption.raml
      404:
        body:
          application/json:
            type: !include datatypes/response/notFoundError.raml
      500:
        body:
          application/json:
            type: !include datatypes/response/internalServerError.raml
            
/billingProductSynchronization:
  post:
    displayName: Sincronizar Catálogo Comercial en Facturación
    description: |
      Synchronizes the commercial catalog from CRM to ZSmart Billing in a single call.
      The request body accepts up to four independent synchronization arrays; at least one must be present:
        - **attributeSynchronization**: create or delete product/offer attributes and their allowed values (ZSmart V1.7 §7.1).
        - **productSynchronization**: create, modify, expire or delete products (ZSmart V1.7 §7.2).
        - **offerSynchronization**: create, modify or delete offers — main, additional, goods, bundle (ZSmart V1.7 §7.3).
        - **offerRelaSynchronization**: create or delete bundle-member and main-offer/additional-offer relationships (ZSmart V1.7 §7.4).
      The billing-papi orchestrates the ZSmart calls sequentially in dependency order for each array present.
    body:
      application/json:
        type: !include datatypes/request/post-billingProductSynchronization.raml
        example: !include examples/request/post-billingProductSynchronization.json
    responses:
      200:
        description: Catalog synchronization executed successfully.
        body:
          application/json:
            type: !include datatypes/response/post-billingProductSynchronization.raml
            example: !include examples/response/post-billingProductSynchronization-200.json
      400:
        description: Request validation error — missing required fields or invalid values.
        body:
          application/json:
            type: !include datatypes/response/error.raml
      401:
        description: OAuth token invalid or expired.
        body:
          application/json:
            type: !include datatypes/response/error.raml
      422:
        description: ZSmart returned a business error (e.g. duplicate offer code, invalid attribute).
        body:
          application/json:
            type: !include datatypes/response/error.raml
      503:
        description: ZSmart unavailable — circuit breaker open.
        body:
          application/json:
            type: !include datatypes/response/error.raml
      504:
        description: ZSmart response timeout exceeded 30 seconds.
        body:
          application/json:
            type: !include datatypes/response/error.raml
            
/subscription:
  /{msisdn}:
    uriParameters:
      msisdn:
        type: string
        description: Número MSISDN a consultar.
        example: "573001234567"
    get:
      displayName: Consultar suscripción por MSISDN
      description: Consulta suscripción en JSC (`/jsc/v1/subscription?msisdn=`) y devuelve solo los campos acordados (claves en inglés).
      queryParameters:
        ORIGIN:
          type: string
          required: false
          description: Canal u origen de la petición.
          example: "CATALOGO"
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/get-subscription-by-msisdn.raml
              example: !include examples/response/get-subscription-by-msisdn-200.json
        404:
          body:
            application/json:
              type: !include datatypes/response/notFoundError.raml
        500:
          body:
            application/json:
              type: !include datatypes/response/internalServerError.raml

/commercialOffer:
  get:
    displayName: Consultar oferta comercial
    description: |
      Consulta ofertas en mongo-sapi (`GET /mongo/v1/commercialOffer`) sobre CMP_OFERTA_COMERCIAL.
      Query params en inglés; se traducen a los filtros del SAPI.
      Respuesta en inglés con paginación limit/offset (perfil pagination.* en properties).
      Al menos uno de groupingNumber, name o commercialName es obligatorio.
    queryParameters:
      groupingNumber:
        type: number
        required: false
        description: Número de agrupación (SAPI numAgrupacion).
        example: 7636
      name:
        type: string
        required: false
        description: Nombre de la oferta (SAPI nombre).
        example: "prueba"
      commercialName:
        type: string
        required: false
        description: Nombre comercial (SAPI nombreComercial).
        example: "prueba"
      limit:
        type: integer
        required: false
        description: Máximo de registros a devolver (cap por pagination.profile).
        example: 25
      offset:
        type: integer
        required: false
        description: Desplazamiento para paginación.
        example: 0
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-commercialOffer.raml
            example: !include examples/response/get-commercialOffer-200.json
      400:
        body:
          application/json:
            type: !include datatypes/response/notFoundError.raml
      500:
        body:
          application/json:
            type: !include datatypes/response/internalServerError.raml
