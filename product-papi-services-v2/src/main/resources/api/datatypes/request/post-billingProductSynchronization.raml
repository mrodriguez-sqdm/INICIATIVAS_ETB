#%RAML 1.0 DataType
type: object
description: |
  Request body for POST /v2/billingProductSynchronization.
  A single call can carry any combination of the three synchronization arrays.
  The billing-papi resolves each array and calls the corresponding ZSmart operation:
    productSynchronization[]  → ZSmart productSynchronization
    attributeSynchronization[]  → ZSmart attributeSynchronization
    offerSynchronization[]      → ZSmart offerSynchronization
    offerRelaSynchronization[]  → ZSmart offerRelaSynchronization
  At least one of the four arrays must be present. The transactionId and creationDate will be handled internally.
properties:
  synchronizationId:
    type: string
    required: false
    example: "SYNC20260928200950"
  attributeSynchronization:
    type: array
    required: false
    description: |
      Synchronize attributes and their allowed values from CRM to ZSmart.
      ZSmart operation: attributeSynchronization → message.billAttrObj / message.billAttrValueList.
    items:
      type: object
      properties:
        billAttrObj:
          type: object
          required: false
          description: "Attribute definition to create or delete. -> message.billAttrObj"
          properties:
            id:
              type: string
              maxLength: 6
              description: "Unique ID of the attribute in CRM. -> billAttrObj.id"
              example: ATT001
              required: false
            attrCode:
              type: string
              maxLength: 30
              description: "Attribute code. -> billAttrObj.attrCode"
              example: DISCOUNT_FLAG
              required: true
            attrName:
              type: string
              maxLength: 60
              description: "Attribute name. -> billAttrObj.attrName"
              example: DISCOUNT_FLAG
              required: true
            defaultValue:
              type: string
              maxLength: 30
              description: "Default value of the attribute. -> billAttrObj.defaultValue"
              example: 'Yes'
              required: false
            inputType:
              type: string
              minLength: 1
              maxLength: 1
              description: "Input type: 1=Text, 2=Single choice, 3=Multi choice. -> billAttrObj.inputType"
              example: '2'
              required: true
            comments:
              type: string
              maxLength: 200
              description: "Comments. -> billAttrObj.comments"
              example: 'Whether it is a discount additional offer'
              required: false
            operate:
              type: string
              enum: [A, D]
              description: "Operation type. A=Add, D=Delete. -> billAttrObj.operate"
              example: A
              required: true
        billAttrValueList:
          type: array
          required: false
          description: "Allowed value list for the attribute. -> message.billAttrValueList"
          items:
            type: object
            properties:
              id:
                type: string
                maxLength: 16
                description: "Unique ID of the attribute-value relationship. -> id"
                example: ATTR_VAL_0000001
                required: true
              attrCode:
                type: string
                maxLength: 30
                description: "Attribute code. -> attrCode"
                example: DISCOUNT_FLAG
                required: true
              value:
                type: string
                maxLength: 30
                description: "Optional value of the attribute. -> value"
                example: 'Yes'
                required: true
              operate:
                type: string
                enum: [A, D, M]
                description: "Operation type. A=Add, D=Delete, M=Modify. -> operate"
                example: A
                required: true

  productSynchronization:
    type: array
    required: false
    description: |
      Synchronize products from CRM to ZSmart.
      ZSmart operation: productSynchronization → message.prodList
    items:
      type: object
      properties:
        prodType:
          type: string
          enum: ['1', '2']
          description: "Product type. 1=Main product, 2=Related product. -> prodType"
          example: '1'
          required: true
        id:
          type: string
          maxLength: 9
          description: "Unique product ID in CRM. -> id"
          example: PROD_0001
          required: false
        prodName:
          type: string
          maxLength: 60
          description: "Product name. -> prodName"
          example: POSTPAGO CTA CONTROL
          required: true
        prodCode:
          type: string
          maxLength: 30
          description: "Commercial product code. -> prodCode"
          example: POSTPAGO_CTA_CONTROL
          required: true
        networkType:
          type: string
          enum: [G, C, P, O, I, F, S, V]
          description: "Network type. G=GSM/WCDMA/CAMEL, C=CDMA, P=PSTN, O=Other, I=IMS, F=FTTH, S=ADSL, V=VDSL. -> networkType"
          example: G
          required: true
        comments:
          type: string
          maxLength: 200
          description: "Comments. -> comments"
          example: 'mobile postpaid'
          required: false
        operate:
          type: string
          enum: [A, D, E, M]
          description: "Operation type. A=Add, D=Delete, E=Expire, M=Modify. -> operate"
          example: A
          required: true
        productAttrList:
          type: array
          required: false
          description: "Product attribute list. -> productAttrList"
          items:
            type: object
            properties:
              id:
                type: string
                maxLength: 16
                description: "Product-attribute relationship ID. -> id"
                example: PROD_ATTR_000001
                required: false
              attrCode:
                type: string
                maxLength: 30
                description: "Attribute code. -> attrCode"
                example: DISCOUNT_FLAG
                required: true
              defaultValue:
                type: string
                maxLength: 30
                description: "Default value of the attribute. -> defaultValue"
                example: 'Yes'
                required: false
              operate:
                type: string
                enum: [A, D, M]
                description: "Operation type. A=Add, D=Delete, M=Modify. -> operate"
                example: A
                required: true

  offerSynchronization:
    type: array
    required: false
    description: |
      Synchronize products and offers from CRM to ZSmart.
      ZSmart operation: offerSynchronization → message.offerList.
    items:
      type: object
      properties:
        id:
          type: string
          maxLength: 9
          description: "Unique offer ID in CRM. -> id"
          example: OFFER_001
          required: false
        offerType:
          type: string
          enum: ['1', '2', '3', '4']
          description: "Offer type. 1=Main, 2=Additional, 3=Goods, 4=Bundle. -> offerType"
          example: '1'
          required: true
        offerName:
          type: string
          maxLength: 60
          description: "Offer name. -> offerName"
          example: MOVI 90 GB NEGOCIOS
          required: true
        offerCode:
          type: string
          maxLength: 30
          description: "Commercial offer code. -> offerCode"
          example: MOVI_90GB_NEGOCIOS
          required: true
        effDate:
          type: string
          maxLength: 19
          description: "Effective date. Format is YYYY-MM-DD HH:MM:SS"
          example: "2026-10-19 12:00:00"
          required: false
        expDate:
          type: string
          maxLength: 19
          description: "Expiration date. Format is YYYY-MM-DD HH:MM:SS"
          example: "2026-10-19 12:00:00"
          required: false
        effType:
          type: string
          enum: ['1', '2', '3']
          description: "Effective type. 1=Instant, 2=Next billing cycle, 3=Next day. Default 1. -> effType"
          example: '1'
          required: false
        saleListPrice:
          type: number
          description: "Basic sale list price. -> saleListPrice"
          example: 0
          required: false
        rentListPrice:
          type: number
          description: "Basic rent list price. -> rentListPrice"
          example: 90000
          required: false
        prodCode:
          type: string
          maxLength: 30
          description: "Related product code. Mandatory for main offers. -> prodCode"
          example: POSTPAGO_CTA_CONTROL
          required: false
        effDuration:
          type: string
          maxLength: 10
          description: "Effective duration (numeric value). -> effDuration"
          example: '5'
          required: false
        effDurationType:
          type: string
          maxLength: 19
          description: "Effective duration unit. Day, Biling Cycle, Month, Year. -> effDurationType"
          example: Month
          required: false
        comments:
          type: string
          maxLength: 200
          description: "Comments. -> comments"
          example: 'Comments'
          required: false
        operate:
          type: string
          enum: [A, D, M]
          description: "Operation type. A=Add, D=Delete, M=Modify. -> operate"
          example: A
          required: true
        offerAttrList:
          type: array
          required: false
          description: "Offer attribute association list. -> offerAttrList"
          items:
            type: object
            properties:
              id:
                type: string
                maxLength: 16
                description: "Offer-attribute relationship ID. -> id"
                example: OFFATTR_001
                required: false
              attrCode:
                type: string
                maxLength: 30
                description: "Attribute code. -> attrCode"
                example: DISCOUNT_FLAG
                required: true
              defaultValue:
                type: string
                maxLength: 30
                description: "Default value of the attribute. -> defaultValue"
                example: 'Yes'
                required: false
              operate:
                type: string
                enum: [A, D]
                description: "Operation type. A=Add, D=Delete. -> operate"
                example: A
                required: true

  offerRelaSynchronization:
    type: array
    required: false
    description: |
      Synchronize offer relationship structure from CRM to ZSmart.
      ZSmart operation: offerRelaSynchronization → message.bundleMemberList / message.mainOfferMemberList.
    items:
      type: object
      properties:
        bundleMemberList:
          type: array
          required: false
          description: "Bundle and its member main offers. -> message.bundleMemberList"
          items:
            type: object
            properties:
              bundleOfferCode:
                type: string
                maxLength: 30
                description: "Bundle offer code. -> bundleOfferCode"
                example: BUNDLE_TRIPLE_PLAY
                required: true
              bundleOfferName:
                type: string
                maxLength: 60
                description: "Bundle offer name. -> bundleOfferName"
                example: Triple Play Bundle
                required: false
              memMainOfferCode:
                type: string
                maxLength: 30
                description: "Bundle member offer code. -> memMainOfferCode"
                example: MOVI_90GB_NEGOCIOS
                required: true
              memMainOfferName:
                type: string
                maxLength: 60
                description: "Bundle member offer name. -> memMainOfferName"
                example: MOVI 90 GB NEGOCIOS
                required: false
              operate:
                type: string
                enum: [A, D]
                description: "Operation type. A=Add, D=Delete. -> operate"
                example: A
                required: true
        mainOfferMemberList:
          type: array
          required: false
          description: "Main/bundle offer and its additional/goods offer relationships. -> message.mainOfferMemberList"
          items:
            type: object
            properties:
              mainOfferCode:
                type: string
                maxLength: 30
                description: "Main or bundle offer code. -> mainOfferCode"
                example: MOVI_90GB_NEGOCIOS
                required: true
              mainOfferName:
                type: string
                maxLength: 60
                description: "Main or bundle offer name. -> mainOfferName"
                example: MOVI 90 GB NEGOCIOS
                required: false
              memAddOfferCode:
                type: string
                maxLength: 30
                description: "Additional or goods offer code. -> memAddOfferCode"
                example: Port_in_discount_20pct
                required: true
              memAddOfferName:
                type: string
                maxLength: 60
                description: "Additional or goods offer name. -> memAddOfferName"
                example: Port in discount 20%
                required: false
              operate:
                type: string
                enum: [A, D]
                description: "Operation type. A=Add, D=Delete. -> operate"
                example: A
