#%RAML 1.0 DataType

description: Respuesta de oferta comercial (campos en inglés) con paginación.
type: object
properties:
  code:
    type: integer
    example: 200
  commercialOffers:
    type: array
    items:
      type: object
      properties:
        id:
          type: string | nil
          required: false
        groupingNumber:
          type: number | nil
          required: false
        configurationCode:
          type: string | nil
          required: false
        name:
          type: string | nil
          required: false
        commercialName:
          type: string | nil
          required: false
        bundleType:
          type: string | nil
          required: false
        productType:
          type: string | nil
          required: false
        serviceType:
          type: string | nil
          required: false
        serviceSubtype:
          type: string | nil
          required: false
        planDescription:
          type: string | nil
          required: false
        mainServices:
          type: array
          required: false
          items:
            type: object
            properties:
              name:
                type: string | nil
                required: false
              productType:
                type: string | nil
                required: false
              products:
                type: array
                required: false
                items:
                  type: object
                  properties:
                    name:
                      type: string | nil
                      required: false
                    productType:
                      type: string | nil
                      required: false
                    products:
                      type: array
                      required: false
        price:
          type: object
          required: false
          properties:
            priceWithoutTax:
              type: number | nil
              required: false
            priceWithTax:
              type: number | nil
              required: false
            tax:
              type: number | nil
              required: false
            salesChannel:
              type: string | nil
              required: false
        channels:
          type: array
          required: false
        businessUnit:
          type: array
          required: false
        catalogBusinessUnit:
          type: array
          required: false
        profile:
          type: array
          required: false
        scoring:
          type: array
          required: false
        strata:
          type: array
          required: false
        procedures:
          type: array
          required: false
        technologies:
          type: array
          required: false
        billing:
          type: array
          required: false
        capabilities:
          type: object
          required: false
          properties:
            appointment:
              type: boolean | nil
              required: false
            availability:
              type: boolean | nil
              required: false
            provisioning:
              type: boolean | nil
              required: false
            billing:
              type: boolean | nil
              required: false
        characteristics:
          type: array
          required: false
        technicalSpecifications:
          type: array
          required: false
        promotions:
          type: array
          required: false
        image:
          type: object
          required: false
          properties:
            url:
              type: string | nil
              required: false
            blobName:
              type: string | nil
              required: false
            templateVersion:
              type: string | nil
              required: false
            generationDate:
              type: datetime | string | nil
              required: false
        status:
          type: string | nil
          required: false
        sourceBundleId:
          type: string | nil
          required: false
        creationDate:
          type: datetime | string | nil
          required: false
        modificationDate:
          type: datetime | string | nil
          required: false
        publicationDate:
          type: datetime | string | nil
          required: false
