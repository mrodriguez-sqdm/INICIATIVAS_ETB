#%RAML 1.0 DataType

description: Consulta de suscripción por MSISDN (campos mapeados desde JSC, salida en inglés).
type: object
properties:
  code:
    type: integer
    description: Código de resultado de la operación (p. ej. 200 en éxito).
    example: 200
  idSubscription:
    type: string
    description: Identificador de la suscripción en JSC.
    required: false
  planName:
    type: string
    description: Nombre del plan de precios (priceplan.pricePlanName).
    required: false
  status:
    type: string
    description: Estado de la suscripción.
    required: false
  billingType:
    type: string
    description: Tipo de facturación (PREPAY, POST, etc.).
    required: false
  balance:
    type: number
    description: Saldo de la suscripción.
    required: false
  externalId:
    type: string
    description: Identificador externo (externalID).
    required: false
  subscriberId:
    type: string
    description: Identificador del suscriptor (subscriber.id).
    required: false
