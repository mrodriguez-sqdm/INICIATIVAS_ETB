#%RAML 1.0 DataType
type: object
description: Response for POST /v2/billingProductSynchronization — product catalog synchronization item.
properties:
  transactionId:
    type: string
    description: "Transaction ID used in ZSmart Synchronization operation. -> result.transactionId"
  synchronizationDate:
    type: string
    description: "Creation Date in ZSmart Synchronization operation. -> result.synchronizationDate"
  responseCode:
    type: string
    description: "ZSmart operation result code. '0000' = success. -> result.responseCode"
    example: '0000'
  responseMessage:
    type: string
    description: "ZSmart operation result message. -> result.responseMessage"
    example: success