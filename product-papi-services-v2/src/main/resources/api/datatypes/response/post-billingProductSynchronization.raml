#%RAML 1.0 DataType
type: object
description: |
  Response for POST /v2/billingProductSynchronization — product catalog synchronization.
  Each array executed by the PAPI has an independent result entry under 'results'.
  Arrays not present in the request are absent from the response.
  Arrays skipped because a dependency failed will appear with responseCode 'SKIPPED'.
properties:
  transactionId:
    type: integer
    description: "Same transaction ID sent in the request (numeric). -> result.transactionId"
    example: 784202604240001
    required: true
  results:
    type: object
    required: true
    description: "Independent result per synchronization array executed."
    properties:
      attributeSynchronization:
        type: object
        required: false
        description: "Result of ZSmart attributeSynchronization call (V1.7 §7.1). Present only if array was sent."
        properties:
          responseCode:
            type: string
            description: "'0000' = success. Any other value = ZSmart business error."
            example: '0000'
            required: true
          responseMessage:
            type: string
            description: "ZSmart result message."
            example: success
            required: true
      productSynchronization:
        type: object
        required: false
        description: "Result of ZSmart productSynchronization call (V1.7 §7.2). Present only if array was sent."
        properties:
          responseCode:
            type: string
            description: "'0000' = success. 'SKIPPED' = skipped because attributeSynchronization failed."
            example: '0000'
            required: true
          responseMessage:
            type: string
            description: "ZSmart result message."
            example: success
            required: true
      offerSynchronization:
        type: object
        required: false
        description: "Result of ZSmart offerSynchronization call (V1.7 §7.3). Present only if array was sent."
        properties:
          responseCode:
            type: string
            description: "'0000' = success. 'SKIPPED' = skipped because a prior dependency failed."
            example: '0000'
            required: true
          responseMessage:
            type: string
            description: "ZSmart result message."
            example: success
            required: true
      offerRelaSynchronization:
        type: object
        required: false
        description: "Result of ZSmart offerRelaSynchronization call (V1.7 §7.4). Present only if array was sent."
        properties:
          responseCode:
            type: string
            description: "'0000' = success. 'SKIPPED' = skipped because offerSynchronization failed."
            example: '0000'
            required: true
          responseMessage:
            type: string
            description: "ZSmart result message."
            example: success
            required: true