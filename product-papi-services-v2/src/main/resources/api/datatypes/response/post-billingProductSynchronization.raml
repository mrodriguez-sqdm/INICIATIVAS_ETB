#%RAML 1.0 DataType
type: object
description: Response for POST /v2/billingProductSynchronization — product catalog synchronization.
properties:
  transactionId:
    type: string
    description: "Same transaction ID sent in the request. -> result.transactionId"
    example: SYNC20260424001
  results:
    type: object
    properties:
      attributeSynchronization:
        type: array
        required: false
        description: Synchronize attributes responses
        items:
          type: object
          properties:
            responseCode:
              type: string
              description: "ZSmart operation result code. '0000' = success. -> result.responseCode"
              example: '0000'
            responseMessage:
              type: string
              description: "ZSmart operation result message. -> result.responseMessage"
              example: success
      productSynchronization:
        type: object
        properties:
          responseCode:
            type: string
            description: "ZSmart operation result code. '0000' = success. -> result.responseCode"
            example: '0000'
          responseMessage:
            type: string
            description: "ZSmart operation result message. -> result.responseMessage"
            example: success
      offerSynchronization:
        type: object
        properties:
          responseCode:
            type: string
            description: "ZSmart operation result code. '0000' = success. -> result.responseCode"
            example: '0000'
          responseMessage:
            type: string
            description: "ZSmart operation result message. -> result.responseMessage"
            example: success
      offerRelaSynchronization:
        type: object
        properties:
          responseCode:
            type: string
            description: "ZSmart operation result code. '0000' = success. -> result.responseCode"
            example: '0000'
          responseMessage:
            type: string
            description: "ZSmart operation result message. -> result.responseMessage"
            example: success
example: !include ../../examples/response/post-billingProductSynchronization-200.json