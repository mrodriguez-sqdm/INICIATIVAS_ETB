<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-commercialOffer-handlerSub_Flow" doc:id="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
		<ee:transform doc:name="Validate query params" doc:id="b2c3d4e5-f6a7-8901-bcde-f12345678901">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="commercialOfferQuery"><![CDATA[%dw 2.0
output application/java
import * from dw::core::Strings
var numAgrupacion = attributes.queryParams.numAgrupacion
var nombre = attributes.queryParams.nombre
var nombreComercial = attributes.queryParams.nombreComercial
---
{
	(numAgrupacion: numAgrupacion as Number) if (!isBlank(numAgrupacion)),
	(nombre: nombre) if (!isBlank(nombre)),
	(nombreComercial: nombreComercial) if (!isBlank(nombreComercial))
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Has filter?" doc:id="c3d4e5f6-a7b8-9012-cdef-123456789012">
			<when expression="#[!isEmpty(vars.commercialOfferQuery)]">
				<flow-ref doc:name="Go to Orchestrator" doc:id="d4e5f6a7-b8c9-0123-def0-234567890123" name="get-commercialOffer-orchestratorSub_Flow" />
			</when>
			<otherwise>
				<ee:transform doc:name="Bad request" doc:id="e5f6a7b8-c9d0-1234-ef01-345678901234">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	codigo: "400",
	descripcion: "Debe enviar al menos un filtro: numAgrupacion, nombre o nombreComercial"
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
