#%RAML 1.0 DataType
type: object
displayName: coverageGIS
properties:
  GetCoverageGISOPInput:
    type: object
    properties:
      WSRequestHeader2:
        type: object
        properties:
          System: 
            type: object
            properties:
              correlationID:
                description: Correlation Id
                type: string
                minLength: 1
                required: true 
      GetCoverageGISRequest:
        type: object
        properties:
          Latitud:
            description: The latitude in order to obtain coverage
            type: string
            required: true
          Longitud:
            description: The longitude in order to obtain coverage  
            type: string
            required: true   
example:
  !include ../../examples/request/coverageGIS.raml