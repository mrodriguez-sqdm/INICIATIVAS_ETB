#%RAML 1.0 DataType
type: object
displayName: solicitarQResimRequest
properties:
  TipoDocumento?:
    type: string
    required: false
    description: Tipo de documento del cliente
  NumeroDocumento?:
    type: string
    required: false
    description: Número de documento del cliente
  NumeroOrden?:
    type: string
    required: false
    description: Número de orden asociada
  ICCID?:
    type: string
    required: false
    description: Código ICCID de la eSIM
  enviarCorreo:
    type: boolean
    required: true
    description: Indica si el documento debe enviarse por correo electrónico

example:
  TipoDocumento: "CC"
  NumeroDocumento: "123456789"
  NumeroOrden: "ORD-998877"
  ICCID: "89571234567890123456"
  enviarCorreo: true