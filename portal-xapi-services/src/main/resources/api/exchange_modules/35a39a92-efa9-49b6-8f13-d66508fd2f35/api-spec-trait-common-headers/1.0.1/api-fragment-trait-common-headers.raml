#%RAML 1.0 Trait
displayName: Atributos comúnes en las cabeceras de las peticiones API
description: Atributos que son comúnes en la cabecera de las peticiones realizadas sobre todas las API
usage: Atributos comúnes en las cabeceras de las peticiones API
headers:
  id-peticion:
    type: string
    description: Identificador de la petición
    displayName: Identificador de la petición
    required: true
  id-transaccion:
    type: string
    description: Una transacción refiere a una operación que es ejecutada entre varias invocaciones a diferentes APIs
    displayName: Identificador de la transacción
    required: false
  sistema:
    type: !include ./types/common-header-system.raml
    description: Aplicativo o sistema que ejecuta la petición
    displayName: Aplicativo o sistema que ejecuta la petición
    required: true
