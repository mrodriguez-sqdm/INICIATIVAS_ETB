<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:smallworld-sapi-services="http://www.mulesoft.org/schema/mule/smallworld-sapi-services"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/smallworld-sapi-services http://www.mulesoft.org/schema/mule/smallworld-sapi-services/current/mule-smallworld-sapi-services.xsd">
	<sub-flow name="smallworld-sapi-clientSub_Flow"
		doc:id="8c04b775-fda1-4b8a-bcbb-92938d76c876">
		<http:request method="GET" doc:name="Call smallworld client" doc:id="e9a2c575-cff4-435d-9712-426bc56b1e02" config-ref="smallworld_HTTP_Request_configuration" path="${smallworld-sapi.path}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"client_secret" : p('credentials.client_secret'),
	"client_id" : p('credentials.client_id'),
	"name": attributes.headers.name,
	"X-CORRELATION-ID": correlationId,
	"source": attributes.headers.source,
	"systemId": vars.systemId
}]]]></http:headers>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"address" : vars.address,
	"municipioCode" : vars.municipioCode,
	"departamentoCode" : vars.departamentoCode,
	"codigoIntegracion" : correlationId
}]]]></http:query-params>
		</http:request>
		<logger level="INFO" doc:name="Check response"
			doc:id="429f3441-9f06-4a4e-a3fa-b46fa85bf3ba" message="#[payload]" />
	</sub-flow>
</mule>
