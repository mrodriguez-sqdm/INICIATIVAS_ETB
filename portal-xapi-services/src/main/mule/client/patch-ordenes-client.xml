<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="patch-ordenes-clientSub_Flow" doc:id="393f82af-e186-4208-a63a-deedb74ef851" >
		<logger level="INFO" doc:name="Logger" doc:id="ad20b434-f2ec-45d8-bc7f-6bc90919e089" message="#[payload]" />
		<http:request method="PATCH" doc:name="Call operations-papi-services" doc:id="269a32db-9b96-4a58-9ae1-1acebf121141" config-ref="HTTP_Request_configuration_operations-papi" path="${operations-papi.path.patchOrdenes}" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"source" : attributes.headers.'source',
	"X-CORRELATION-ID": correlationId,
	"name" : attributes.headers.'name',
	"client_secret" : p('credentials.client_secret'),
	"client_id" : p('credentials.client_id'),
	"systemId": vars.systemId,
	"processName": vars.processname
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"numOrden" : vars.numOrden
}]]]></http:uri-params>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"accion" : vars.accion
}]]]></http:query-params>
		</http:request>
		<logger level="INFO" doc:name="Logger" doc:id="22e4502d-681f-44a0-b6c0-1784209dcebd" message="#[payload]" />
	</sub-flow>
	<sub-flow name="patch-ordenesId-clientSub_Flow" doc:id="104f2f72-0329-432e-9896-67acdbfe4feb" >
		<http:request method="PATCH" doc:name="Call mongo-db-sapi-services" doc:id="e911fadd-cbb1-4416-9f48-b328facc1880" config-ref="mongoDb-HTTP_Request_configuration" path="${mongoDb-sapi.path.ordenes}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"client_secret" : p('mongoDb-sapi.client_secret'),
	"client_id" : p('mongoDb-sapi.client_id'),
	"name": attributes.headers.name,
	"X-CORRELATION-ID": correlationId,
	"source": attributes.headers.source,
	"systemId": vars.systemId
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"orderNumber" : vars.orderNumber
}]]]></http:uri-params>
		</http:request>
	</sub-flow>
</mule>
