    <flow name="portal-xapi-services-main" doc:id="d1e66dc5-e9c2-40e4-b7db-729700c1e832">
        <http:listener path="/*" config-ref="portal-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <flow-ref doc:name="Call initial logger" doc:id="28d4e31e-e793-49e8-96ae-857f5bc75151" name="initial-loggin-Sub_Flow" />
        <apikit:router config-ref="portal-xapi-services-config" />
        <async doc:name="Async" doc:id="28e1f1e8-78ab-4616-9b54-de2e90eb3039">
            <flow-ref doc:name="Call logger" doc:id="1d67ad1a-2a82-4572-a2c5-7ea71ac58af4" name="loggin-client-call" />
        </async>
        <error-handler ref="common-error-handler-v2" />
    </flow>
    <flow name="portal-xapi-services-console">
        <http:listener path="/console/*" config-ref="portal-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="portal-xapi-services-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
