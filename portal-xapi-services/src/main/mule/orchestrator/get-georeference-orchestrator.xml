<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-georeference-orchestratorSub_Flow" doc:id="0cdbe335-cf63-4141-95df-a640f1b7a84d" >
		<logger level="INFO" doc:name="Check request" doc:id="115f4d7a-fdcc-4d8a-8df9-0a4ce130f444" message="#[payload]"/>
		<flow-ref doc:name="Go to client sapi" doc:id="8796e996-c419-4ec6-bc35-17c093d7fc1c" name="smallworld-sapi-clientSub_Flow"/>
		<choice doc:name="Choice" doc:id="d66a58a0-7472-4395-b270-d4dd47cf971c" >
			<when expression='#[payload.outPutMessage.messageCode == "GEOREFERR02"]'>
				<ee:transform doc:name="Case Error 02" doc:id="80db8ec4-190d-42e3-9165-a273ab32e589">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"GetGeoreferenceOut":{
		"Result":{
			"status": "FAIL",
			"messageCode": payload.outPutMessage.messageCode,
			"descripcion": "Error Integración"
		},
		"Adress":{
			"EstadoGeo":"",
			"CodigoDireccion":"",
			"Latitud":"",
			"Longitud":"",
			"Estrato":0,
			"CodigoLote":"",
			"Destino":"",
			"Chip":"",
			"Barrio":"",
			"Localidad":"",
			"TipoDistancia":""
		}
	}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
			</when>
			<when expression='#[payload.outPutMessage.messageCode == "GEOREFERR01"]'>
				<ee:transform doc:name="Case Error 01" doc:id="7053f2c9-5cad-4914-ab51-72cd2ddba915" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"GetGeoreferenceOut":{
		"Result":{
			"status": "PASS",
			"messageCode": payload.outPutMessage.messageCode,
			"descripcion": "Dirección No Encontrada"
		},
		"Adress":{
			"EstadoGeo":"",
			"CodigoDireccion":"",
			"Latitud":"",
			"Longitud":"",
			"Estrato":0,
			"CodigoLote":"",
			"Destino":"",
			"Chip":"",
			"Barrio":"",
			"Localidad":"",
			"TipoDistancia":""
		}
	}
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="Case OK" doc:id="6a93f5d4-e9b6-43b9-9bd6-6a956b53558a" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"georeferenceResponse":{
    	"GetGeoreferenceOut":{
	        "Result":{
	            "status": "PASS",
	            "messageCode": "OK",
	            "descripcion": ""
	        },
	        "Address":{
	            "EstadoGeo": payload.outputMessage."WSGeorreferenciarCR-RS".EstadoGeo,
	            "CodigoMunicipio": payload.outputMessage."WSGeorreferenciarCR-RS".CodigoMunicipio,
	            "CodigoDepartamento": payload.outputMessage."WSGeorreferenciarCR-RS".CodigoDepartamento,
	            "CodigoDireccion":payload.outputMessage."WSGeorreferenciarCR-RS".CodigoDireccion,
	            "Latitud": payload.outputMessage."WSGeorreferenciarCR-RS".Latitud,
	            "Longitud": payload.outputMessage."WSGeorreferenciarCR-RS".Longitud,
	            "Estrato": payload.outputMessage."WSGeorreferenciarCR-RS".Estrato,
	            "CodigoLote": payload.outputMessage."WSGeorreferenciarCR-RS".CodigoLote,
	            "Destino": payload.outputMessage."WSGeorreferenciarCR-RS".Destino,
	            "Chip": payload.outputMessage."WSGeorreferenciarCR-RS".Chip,
	            "Barrio": payload.outputMessage."WSGeorreferenciarCR-RS".Barrio,
	            "Localidad": payload.outputMessage."WSGeorreferenciarCR-RS".Localidad,
	            "TipoDistancia": payload.outputMessage."WSGeorreferenciarCR-RS".TipoDistancia
	        }
        }
    }    
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="Logger" doc:id="7358674a-5c46-41c4-ba0e-1b5240080188" message="#[payload]"/>
	</sub-flow>
</mule>
