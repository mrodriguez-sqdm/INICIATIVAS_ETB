<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-ordenes-orchestratorSub_Flow" doc:id="7ca2c02a-779e-42d2-bda7-f74d1e8f8ebb" >
		<try doc:name="Try" doc:id="b966b00f-1afb-4635-8816-4f8a2f19df95" >
			<flow-ref doc:name="Go to client" doc:id="dac30121-b817-4cc5-975a-00f57e299ef5" name="patch-ordenes-clientSub_Flow" />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="ce00ba75-1e97-467c-8093-fabd1368d719" >
					<ee:transform doc:name="Transform Message" doc:id="f9150c30-c754-4a14-8424-a85df5b879b9" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
error.muleMessage.typedValue.messageServer]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
		<async doc:name="Async" doc:id="3b4d2a75-6d43-4eb2-bf39-7e75fc073c39" >
			<flow-ref doc:name="Call logger before" doc:id="1e0f6104-c49d-4a2e-8f60-0df1650330cd" name="audits-mongo-log-before"/>
		</async>
	</sub-flow>
	<sub-flow name="patch-ordenesId-orchestratorSub_Flow" doc:id="81e6d2d4-5232-43d5-9e8e-a1557f71ebce" >
		<flow-ref doc:name="Go to client" doc:id="b154c1ee-9812-4c52-9cb3-4b10fa918d13" name="patch-ordenesId-clientSub_Flow"/>
	</sub-flow>
</mule>
