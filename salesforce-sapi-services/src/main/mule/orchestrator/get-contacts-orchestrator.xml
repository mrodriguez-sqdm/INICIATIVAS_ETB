<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<sub-flow name="get-contacts-orchestratorSub_Flow" doc:id="50678d3e-7621-4cff-b54a-047460a7acc1" >
		<flow-ref doc:name="Get Token" doc:id="35e05d38-7de3-4cc7-aeaf-c1a82821ae98" name="get-salesforce-token-clientSub_Flow" target="token_response" />
		<ee:transform doc:name="queryParams" doc:id="9e0623a7-0233-429d-acdc-468149653230" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="numeroId" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.numeroDocumento]]></ee:set-variable>
				<ee:set-variable variableName="accountId" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.idCuenta
]]></ee:set-variable>
				<ee:set-variable variableName="tipoDoc" ><![CDATA[%dw 2.0
output application/json
var tipoDoc = attributes.queryParams.tipoDocumento
var properties = "CC-Cédula de ciudadanía,CE-Cédula de extranjería,TI-Tarjeta de identidad"
---
((properties splitBy  ","
    map {
        clave: ($ splitBy  "-")[0],
        valor: ($ splitBy  "-")[1],
    }) filter upper($.clave) == upper(tipoDoc))[0].valor]]></ee:set-variable>
				<ee:set-variable variableName="recordType" ><![CDATA[%dw 2.0
output application/json
---
p('salesforce.servicioWhatsApp.recordType')
]]></ee:set-variable>
				<ee:set-variable variableName="estadoC" ><![CDATA[%dw 2.0
output application/json
---
p('salesforce.servicioWhatsApp.estadoC')]]></ee:set-variable>
				<ee:set-variable variableName="recordTypeContacto" ><![CDATA[%dw 2.0
output application/json
---
p('salesforce.servicioWhatsApp.recordTypeContacto')
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Go to client" doc:id="58986e22-718e-4c58-9d35-369a951ca5a8" name="get-contacts-clientSub_Flow"/>
		<ee:transform doc:name="Transform Message" doc:id="cdda8168-c1ca-4479-854d-c2f950c94f0e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
