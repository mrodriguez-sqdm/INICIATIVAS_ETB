		<flow-ref doc:name="Go to client" doc:id="b270e865-00b5-467b-88ae-854adc5a4cc8" name="patch-provisioning-clientSub_Flow"/>
		<set-payload value='#[output application/json&#10;---&#10;{&#10;  "resultado": "exitoso",&#10;  "fecha": now (),&#10;  "descripcion": "Actualización realizada en salesforce"&#10;}]' doc:name="Set Response" doc:id="cf4badae-e263-44cc-a4f6-3c0adf3760c5" />
	</sub-flow>
</mule>
