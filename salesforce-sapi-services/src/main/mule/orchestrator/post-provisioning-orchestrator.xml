<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-provisioning-orchestrator" doc:id="2c8fc18f-1582-4b5e-a054-0819b26a9385" >
		<set-variable value="#[payload.orderOM]" doc:name="OrdenOM" doc:id="f450af4c-fdb4-4385-b595-b35ddb120549" variableName="ordenOM" />
		<choice doc:name="Choice" doc:id="d9594ed6-a37b-417e-8bc6-2c27d662f8ab" >
			<when expression="#[vars.ordenOM != null]">
				<flow-ref doc:name="Get Order" doc:id="da1cb69a-8877-4345-a349-53cf5732cf22" name="obtain-order" target="responseOrderById" />
				<set-variable value="#[vars.responseOrderById.resultados[0].correlationId]" doc:name="correlationId" doc:id="af21d242-9c0b-42f1-8f90-696081108be7" variableName="correlationId" />
			</when>
		</choice>
		<flow-ref doc:name="Go to Client" doc:id="bf311294-3fa3-436a-a95c-3b888030cbc6" name="provisioning-clientSub_Flow" />
		<logger level="INFO" doc:name="Logger" doc:id="e548943d-b95e-4900-bdb3-013d0129f75a" message="#[payload]"/>
	</sub-flow>
</mule>
