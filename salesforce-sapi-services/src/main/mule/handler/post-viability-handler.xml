<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="post-viability-handler" doc:id="d77a072d-cc1d-4970-b8d8-c553f0685393" >
		<logger level="INFO" doc:name="Logger" doc:id="5d6c643d-d6e2-45dc-8263-4672b1893386" message="#[payload]" />
		<flow-ref doc:name="Call Orchestrator" doc:id="133c53ad-b404-45b9-99fa-309fb67bbe1e" name="post-viability-orchestratorSub_Flow" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="78424ad4-cf6c-42d8-bee3-01dc443cdc4d" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="f4ed2ffd-6cad-46f7-a00e-3df5108540f4" />
				<flow-ref doc:name="Error Logging" doc:id="a6e584d4-b633-482d-9017-d06beb0453da" name="loggin-client-call" />
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
