<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	<flow name="post-provisioning-handler" doc:id="c80d2434-3d31-477b-8e83-887210c658d7" >
		<logger level="INFO" doc:name="Logger" doc:id="66937fac-2d5e-4673-a8f8-5e35224ced54" message="#[payload]" />
		<flow-ref doc:name="Go to Orchestrator" doc:id="42347196-c67c-420b-b76e-30c3846abeb2" name="post-provisioning-orchestrator" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="b8d95586-a3f7-41ca-a1b4-e5be8dc2cdd4" >
				<set-payload value="#[error.detailedDescription as String]" doc:name="Error Info" doc:id="ac3c71c0-8726-4292-b827-cf80f38d4b8d" />
				<async doc:name="Async" doc:id="56a4df72-9a5f-42ef-8bf6-59dafa6be998" >
					<flow-ref doc:name="Error Logging" doc:id="4810d86b-179d-4c44-b909-75bcd0f0dca2" name="loggin-client-call" />
				</async>
			</on-error-propagate>
		</error-handler>
	</flow>
</mule>
