#%RAML 1.0 DataType
type: object
properties: 
    Id: 
      type: string
      example: "5004y00001us9etAAA"
    lstParametros: 
      type: string
      example: ""
    msgError: 
      type: object
      properties:
        codigoError:
          type: string
          example: "500"            
        mensajeError:
          type: string  
          example: "No se encontro el objeto"
    Name: 
      type: number
      example: 02858336
    resultado: 
      type: string
      example: "Fallido"