#%RAML 1.0 DataType
type: object
properties:
  ordenOM:
    type: string
    example: "ADMIN"
  agrupador:
    type: string
    example: "1"
  resultado:
    type: string
    example: "Positivo"
  fecha:
    type: string
    example: "2022-08-05T19:59:52.930833Z"
  descripcion:
    type: string
    required: false
    example: "Descripcion"