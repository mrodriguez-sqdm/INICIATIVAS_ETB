#%RAML 1.0 DataType
type: object
properties:
  resultado:
    type: string
    required: true
    minLength: 1
    example: resultado
  fecha:
    type: string
    required: true
    minLength: 1
    example: 2022-07-22T17:31:03.838318Z
  ordenOM:
    type: string
    required: true
    minLength: 1
    example: OR-12321
  descripcion:
    type: string
    required: false
    example: "descripcion"