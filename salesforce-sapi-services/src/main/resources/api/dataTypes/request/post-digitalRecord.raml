#%RAML 1.0 DataType
properties:
  idCanal:
    type: string
    maxLength: 50
    required: false
    pattern: ^[a-zA-Z0-9-_]*$
    example: "3052100101"
  Canal:
    type: string
    maxLength: 80
    required: false    
    example: "WhatsApp"
  idCuenta:
    type: string
    maxLength: 50
    required: false
    pattern: ^[a-zA-Z0-9-_]*$
    example: "0014000000uczFLAAY"
  idContacto:
    type: string
    maxLength: 50
    required: false
    pattern: ^[a-zA-Z0-9-_]*$
    example: "003RT00000JkBVNYA3"
  FechaRegistro__c:
    type: string
    required: true    
    example: "2024-09-12T13:46:35.000+0000"
