#%RAML 1.0 DataType
properties:
  Fechaderadicacion__c:
    type: date-only
    required: true
    example: "2024-09-03"
  TipoCaso__c:
    type: string
    required: true
    enum: ["SOPORTE TECNICO","CASO PQR"]
    example: "SOPORTE TECNICO"
  AccountId:
    type: string
    maxLength: 50
    required: true
    pattern: ^[a-zA-Z0-9-_]+$
    example: "0014000000uczFLAAY"
  ContactId:
    type: string
    maxLength: 50
    required: true
    pattern: ^[a-zA-Z0-9-_]+$
    example: "003RT00000JkB0kYAF"
  Subject:
    type: string
    maxLength: 250
    required: true
    example: "Registro de solicitud autoatención LEY 2300 DE 2023"
  Description:
    type: string
    required: true
    example: "En atención a su solicitud de actualización de los canales que autorizó para el envío de comunicaciones de acuerdo con lo dispuesto en la Ley 2300 de 2023, le informamos que se actualizó la información en el sistema.. El contacto eliminó la información del canal de comunicacion para la Ley 2300 para ser contactado por Whatsapp al número 3057889989. . El contacto registró la información del canal de comunicacion para la Ley 2300 para ser contactado por SMS al número 3057889988."
  IDServicio__c:
    type: string | nil
    required: false
    example: "ID0002536"
  Direccion_Instalacion__c:
    type: string | nil
    required: false
    example: "KR 8 20 00"
  Proceso__c:
    type: string | nil
    required: false
    example: "Datos"
  Agrupacion__c:
    type: string | nil
    required: false
    example: "Información Front"
  Tipologia__c:
    type: string | nil
    required: false
    example: "Negociado"
  Status:
    type: string
    enum: ["Abierto","Cerrado"]
    required: true
    example: "Cerrado"
  Nivel_1__c:
    type: string | nil
    required: false
    example: ""
  Nivel_2__c:
    type: string | nil
    required: false
    example: ""
  Nivel_3__c:
    type: string | nil
    required: false
    example: ""
  Causal__c:
    type: string | nil
    required: false
    example: ""
  FechaInicioAfectacion__c:
    type: string | nil
    required: false
    example: "2024-09-03T00:00:00Z"
  RecordType:
    type: object
    required: true
    properties:
      Name:
        type: string
        required: true
        example: "SOPORTE TECNICO"