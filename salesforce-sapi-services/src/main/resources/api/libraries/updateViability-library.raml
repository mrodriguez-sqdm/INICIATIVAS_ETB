#%RAML 1.0 Library
uses:
  producto: productUpdateRecursive-library.raml
types:
  updateViability:
    type: object
    properties:
      ordenOM:
        type: string
        required: true
        minLength: 1
        example: OR-12321
      fechaProcesamiento:
        type: string
        required: true
        minLength: 1
        example: 11/29/2021 10:31:19 AM
      identificador:
        type: string
        required: true
        minLength: 1
        example: OC-1438626, VIA-1234323
      tipoSolicitud:
        type: string
        required: true
        minLength: 1
        example: VIABILIDAD
      opportunityId:
        type: string
        required: false
        example: 0063K00000GuSmXQAV
      estadoSolicitud:
        type: string
        required: false
        example: EN OPERACIÓN
      estadoGestor:
        type: string
        required: false
        example: Por Asignar
      faseSolicitud:
        type: string
        required: false
        example: Inicial    
      grupoAsignacion:
        type: string
        required: false
        example: APV INGENIEROS DE SERVICIOS DE CONECTIVIDAD
      responsable:
        type: string
        required: false
        example: WILLIAM FLOREZ
      correoIngeniero:
        type: string
        required: false
        example: "abc@gmail.com"
      respuestaGestor:
        type: string
        required: false
        example: respuestaG1
      tipodeViabilidad:
        type: string
        required: false
        example: Por cobertura
      proceso:
        type: string
        required: true
        minLength: 1
        example: actualizarEstadoSolicitud
      parametros:
        type: array
        required: false
        items:
          properties:
            codigo:
              type: string
              required: true
              minLength: 1
              example: Atttr_numeroIMEI
            nombre:
              type: string
              required: true
              minLength: 1
              example: Número de IMEI
            valor:
              type: string
              required: false
              example: "98513324306"
            codigoAccion:
              type: string
              required: false
              example: Add
      productos:
        type: producto.productsProvisioningType []
        required: false
      datosAdicionales:
        type: array
        required: false
        items:
          type: object
          properties:
            key:
              type: string
              required: false
            value:
              type: string
              required: false
              example: Atttr_numeroIMEI
      urlsRecursos:
        type: array
        required: false
        items:
          type: object
          properties:
            key:
              type: string
              required: false
            value:
              type: string
              required: false
      agendamiento?:
        type: object
        required: false
        properties:
          fechaAgenda:
            required: false
            type: string | nil
          franjaAgenda:
            required: false
            type: string | nil
          estadoAgenda:
            required: false
            type: string | nil
  listofProducts:
    type: array
    items:
      type: object
      properties:
        Operacion:
          type: string | nil
          example: "string"
          required: false
        QuoteLineItemId:
          type: string | nil
          example: "string"
          required: false
        productCode:
          type: string | nil
          example: "string"
          required: false
        parentId:
          type: string | nil
          example: "string"
          required: false
        idOrigen:
          type: string | nil
          required: false
          example: "1"
        ServiceAccId:
          type: string | nil
          example: "string"
          required: false
        idContacto:
          type: string | nil
          example: "string"
          required: false
        billingAccId:
          type: string | nil
          example: "string"
          required: false
        listaConfiguraciones:
          type: array
          required: false
          items:
            type: object
            properties:
              Quantity:
                type: number | nil
                example: 1
                required: false 
              parametros:
                type: array
                required: false
                items:
                  type: object
                  properties:
                    atributo:
                      type: string | nil
                      example: "string" 
                      required: false
                    valor:
                      type: string | nil
                      example: "string"
                      required: false  