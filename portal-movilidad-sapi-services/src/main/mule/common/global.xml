	<import doc:name="Import" doc:id="c48f3361-b95c-4b8f-8c4c-58e1aed93e54" file="etb-common-lib.xml" />
	<import doc:name="error-handler-v2" doc:id="d3dabc22-4eb1-46e4-8feb-a21c5eb7e6e4" file="error-handler-v2.xml" />
</mule>
