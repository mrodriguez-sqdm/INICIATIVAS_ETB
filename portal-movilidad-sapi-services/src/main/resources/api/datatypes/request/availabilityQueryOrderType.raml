#%RAML 1.0 DataType
properties:
    Canal:
      type: string
      required: true
      minLength: 1
    Categoria:
      type: string
      required: true
      minLength: 1
    ICCID:
      type: string
      required: true
      minLength: 1
    IdPedido: 
      type: string
      required: true
      minLength: 1
    IdServicio: 
      type: string
      required: true
      minLength: 1
    MSISDN: 
      type: string | nil
      required: false
    NuevoIdent:
      type: string | nil
      required: false
    Operacion: 
      type: string
      required: true
      minLength: 1
    Subcategoria: 
      type: string
      required: true
      minLength: 1
    Tramite:     
      type: string
      required: true
      minLength: 1

