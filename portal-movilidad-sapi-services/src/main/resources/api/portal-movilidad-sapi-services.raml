#%RAML 1.0
title: portal-movilidad-sapi-services
baseUri: http://portal-movilidad-sapi-services-{env}.us-e2.cloudhub.io/movilidad
version: 1

mediaType: 
- application/json

protocols:
- HTTP

traits:
    security-client-id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
    tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml

/v1:
  /availabilityQueryOrder:
    post:      
      is:
        [security-client-id, tibcoHeaders]
      displayName: Availability query order
      description: Availability query order
      body:
        application/json:
            type: !include datatypes/request/availabilityQueryOrderType.raml
      responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/availabilityQueryOrderResponse.raml
                example: !include examples/response/availabilityQueryOrder201ResponseExample.json
          500:
            body:
              application/json:
                type: !include datatypes/response/availabilityQueryOrderResponse.raml
                example: !include examples/response/availabilityQueryOrder500ResponseExample.json
  /completeInventory:
    post:
      is: [security-client-id, tibcoHeaders]
      body:
        application/json:
          type: !include datatypes/request/completeInventoryType.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/response/completeInventoryResponse.raml
              example: !include examples/response/completeInventory201Response.raml
        500:
          body:
            application/json:
              type: !include datatypes/response/completeInventoryResponse.raml
              example: !include examples/response/completeInventory500Response.raml