#%RAML 1.0 DataType
properties:
  ProcessOPInput:
    type: object
    required: true
    properties:
      WSRequestHeader2:
        type: object
        required: true
        properties:
          System:
            type: object
            required: true
            properties:
              name:
                type: string
                required: true
                minLength: 1
              correlationID:
                type: string
                required: true
                minLength: 1
              processingServer:
                type: string
                required: true
                minLength: 1
          Property:
            type: object
            properties:
              name:
                type: string
                minLength: 1
              value:
                type: string
                minLength: 1
      ProcessRequest:
        type: object
        required: true
        properties:
          Action:
            type: string
            required: true
            minLength: 1
          Order:
            type: string
            required: true
            minLength: 1
          Reason:
            type: string
            required: true
            minLength: 1
          Comments:
            type: string
            required: true
            minLength: 1
        
