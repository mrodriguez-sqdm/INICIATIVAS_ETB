#%RAML 1.0 DataType
properties:
  NotifyBillInput:
    properties:
      Request:
        properties:
          Source:
            properties:
              system:
                type: string
                example: "08"
              billingAccount:
                required: false
                type: string
                example: "18381"
          Customer:
            properties:
              name:
                type: string
                example: PEDRO PABLO VELASQUEZ CESPEDES
              id:
                type: string
                example: "79354005"
              idType:
                type: string
                example: CC
          ServiceBill:
            required: false
            properties:
              barcode:
                required: false
                type: string | nil
                example: null
              number:
                type: string
                example: "7785733"
              amount:
                type: number
                example: 49590
              paymentDueDate:
                type: date-only
                example: "2022-01-28"
              paymentDeadline:
                type: date-only
                example: "2022-01-28"
              billNumber:
                required: false
                type: string | nil
                example: "18381"
              billStatus:
                required: false
                type: string | nil
                example: null
              connectionNumber:
                required: false
                type: string | nil
                example: "6086727470"
              billPeriod:
                required: false
                type: string | nil
                example: "211201"
          EquipmentBill:
            required: false
            properties:
              barcode:
                required: false
                type: string | nil
                example: null
              number:
                type: string
                example: "7785733"
              amount:
                type: number
                example: 49590
              paymentDueDate:
                type: date-only
                example: "2022-01-28"
              paymentDeadline:
                type: date-only
                example: "2022-01-28"    

