#%RAML 1.0 DataType
properties:
  aplicacion:
    type: string
    maxLength: 150
    required: true
    description: "Nombre de aplicación que realiza la solicitud"
    example: ""
  nombre_cliente: 
    type: string
    maxLength: 200
    required: false
    description: "Nombre del cliente que realiza la solicitud"
    example: ""
  identificacion_cliente:
    type: string
    maxLength: 150
    required: false
    description: "Identificacion del cliente que realiza la solicitud"
    example: ""
  id_almacenamiento: 
    type: string
    maxLength: 150
    required: true
    description: "Identificador del ObjectStore"
    example: ""
  tipo_canal: 
    type: string
    enum: ["EMAIL", "SMS"]
    maxLength: 150
    required: true
    description: "Canal para enviar el OTP EMAIL o SMS"
    example: "SMS"
  valor_canal:
    type: string
    maxLength: 500
    required: true
    description: "numero de teléfono o correo electrónico"
    example: ""