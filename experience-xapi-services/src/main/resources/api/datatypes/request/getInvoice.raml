#%RAML 1.0 DataType
properties:
  requestSystem:
    type: string | nil
    required: false 
    example: "WS.BillingLTECorporate"
  clientName:
    type: string
    required: false 
    example: "COLVATEL S.A. E.S.P."
  clientNumber:
    type: string
    required: false
    example: "NIT800196299"
  invoiceNumber:
    type: string
    required: false   
    example: "970000013270"
  invoiceDate:
    type: string
    required: false 
    example: "2024-02-19"
  PIN1:
    type: string
    required: false
    example: "970000013270"
  PIN2:
    type: string 
    required: false
    example: "00000000"
  amount:
    type: string 
    required: false
    example: "0.00"
  IVA:
    type: string 
    required: false
    example: "0"
  totalAmount:
    type: string 
    required: false
    example: "0.00"
  invoiceDetail:
    type: array 
    required: false
    items:
      type: object
      properties:
        description:
          type: string 
          required: true
          example: "Equipo Traido"
        IMEI:
          type: string 
          required: true
          example: "356800410332368"
        deviceCost:
          type: string 
          required: true
          example: "0.00"
        IVA:
          type: string 
          required: true
          example: "0"
        totalIVA:
          type: string 
          required: true
          example: "0.00"