#%RAML 1.0 DataType
  properties:
    aplicacion:
      type: string
      maxLength: 150
      required: true
      description: "Nombre de aplicación que realiza la solicitud"
      example: ""
    id_transaccion:
      type: string
      maxLength: 150
      required: true
      description: "Identificador de la transaccion que respondio la generacion del OTP"
      example: ""
    tipo_canal: 
      type: string
      enum: ["EMAIL", "SMS"]
      maxLength: 150
      required: true 
      description: "Canal para enviar el OTP EMAIL o SMS"
      example: "SMS"
    codigo:
      type: string
      maxLength: 500
      required: true
      description: "Codigo enviado por el front para validar"
      example: ""