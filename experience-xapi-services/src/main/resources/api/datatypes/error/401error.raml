#%RAML 1.0 DataType
type: object
properties:
  error:
    type: object
    properties:
      status:
        type: number
      code:
        type: string
      message:
        type: object
        properties:
          message:
            type: string
      cause:
        type: array
        items:
          properties:
            origin:
              type: string
            message: 
              type: string