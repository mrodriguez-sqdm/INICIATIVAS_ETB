#%RAML 1.0 DataType
properties:
  NotifyBillOutput:
    properties:
      WSResponseHeader2:
        properties:
          system:
            properties:
              name:
                type: string
                example: MDM_Data_Services
              correlationId:
                type: string
                example: "7785733"
              processingServer:
                type: string
                example: Mulesoft
          service:
            properties:
              status:
                type: string
                example: PASS
      Result:
        required: false
        properties:
          code:
            type: string
            example: "1"
          description:    
            type: string
            example: "Operacion Exitosa"
          