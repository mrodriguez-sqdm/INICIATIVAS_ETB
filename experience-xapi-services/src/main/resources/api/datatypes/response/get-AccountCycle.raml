#%RAML 1.0 DataType
properties:
  operation:
    type: string
    example: "C"
  result:
    type: string
    example: "E"
  status:
    type: string
    example: "FAIL"
  responseDate:
    type: string
    example: "2022-09-05"
  portalfija_data?:
    type: object
    properties:
      ciclo_cuenta:
        type: object
        properties:
          cuenta: 
            type: string
            example: "15052852546"
          ciclo:
            type: string
            example: "97"
  statusDetail:
    type: object
    properties:
      errorCode: 
        type: string
        example: "0"
      errorMessage:
        type: string
        example: "OK"

