#%RAML 1.0 DataType 
type: object
properties:
  codigo:
    type: integer
    example: 200
    required: false
  res-ley-intimidad:
    type: object
    properties:
      canales:
        type: array
        items:
          type: object
          properties:
            Codigo:
              type: string
              example: '1'
              required: false
            Nombre:
              type: string
              example: SMS
              required: false
            Descripcion:
              type: string
              example: '1'
              required: false
      horarios:
        type: array
        items:
          type: object
          properties:
            Codigo:
              type: string
              example: '1'
              required: false
            Nombre:
              type: string
              example: L-V 7-7 & S 8-3
              required: false
            Descripcion:
              type: string
              example: '1'
              required: false
