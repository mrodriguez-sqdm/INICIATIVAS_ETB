#%RAML 1.0 DataType
properties:
  codigo:
    type: number
    required: true
    example: 200
  res-ley-intimidad:
    type: array
    items:
      type: object
      properties:
        Codigo:
          type: string
          required: false
          example: "codigo"
        Nombre:
          type: string
          required: false
          example: "nombre"
        Descripcion:
          type: string
          required: false
          example: "descripcion"