#%RAML 1.0 DataType
type: object
properties:
  System:
    properties:
      correlationID:
        type: string
      processingServer:
        type: string
      responseDate: 
        type: datetime
  Response:
    properties:
      ResponseTramits:
        type: array
        items:
          properties:
            orderNumber:
              type: string
            responseCode:
              type: string
            responseDescription:
              type: string