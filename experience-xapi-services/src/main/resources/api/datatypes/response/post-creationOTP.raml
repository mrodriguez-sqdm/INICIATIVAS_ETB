#%RAML 1.0 DataType
  properties:
    codigo:
      type: string
      maxLength: 150
      required: true
      description: "Codigo de respuesta de la solicitud"
      example: "201"
    id_transaccion: 
      type: string
      maxLength: 150
      required: true
      description: "Identificacion de la creacion de OTP para validar"
      example: ""