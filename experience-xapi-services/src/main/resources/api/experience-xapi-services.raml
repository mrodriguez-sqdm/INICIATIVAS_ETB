#%RAML 1.0
title: experience-xapi-services
baseUri:  https://experience-xapi-services-{env}.us-e2.cloudhub.io
description: 
protocols:
  - HTTPS

traits:
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.4/tibcorequestheaders.raml
  imeiParams: !include traits/imeiQueryParameters.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

uses:
  insertPositiveRecord-lib: libraries/insertPositiveRecord-lib.raml    

/operations: 
  /v1:
    /servicios:
      /{id}:
        /estadocuenta:
          /certificado:
            get:
              is: [tibcoHeaders]
              securedBy: [etb_oauth_2_0]
              displayName: Expedición del estado de cuenta
              description: Expedición del estado de cuenta
              responses: 
                200:
                  description: Estado de cuenta o paz y salvo generados exitosamente
                  body: 
                    application/json:
                      example: {"url":"https://etb.com.co/accesodocumento.pdf"}
                400:
                  description: Servicio no existe o no fue encontrado
                  body: 
                    application/json:
                      displayName: No fue encontrado el servicio consultado
                      description: No fue encontrado ningún servicio con el número de la cuenta de facturación
                      example: !include examples/response/get-estadocuenta-certificadoerror-response.json
    /interaction:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Create interaction
        description: Create interaction
        body:
          application/json:
            type: !include datatypes/request/post-interaction.raml
            example: !include examples/request/postInteractionExample.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/post-interaction-201-Response.raml
                example: !include examples/response/postInteraction.json
          400:
            body:
              application/json:
                type: !include datatypes/error/error.raml
                example: !include examples/error/400error.json
          401:
            body:
              application/json:
                type: !include datatypes/error/401error.raml
                example: !include examples/error/401error.json
          500:
            body:
              application/json:
                type: !include datatypes/error/error.raml
                example: !include examples/error/500error.json
    /schedule/order:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: This method Create an Order on OCS.
        description: Method to Create an Order.    
        body:
          type: !include datatypes/request/createOrder.raml
          example: !include examples/request/createOrder.json
        responses:
          200:
            body:
              type: 
              example: !include examples/response/createOrder.json 
                         
    /availability:
      /confirm:
        post:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Availability
          description: Make the call of the XXX service of salesforce to obtain the data of the associated plan
          body:
            application/json:
              type: !include datatypes/request/Availability.raml
              example: !include examples/request/Availability.json
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/Availability.raml
                  example: !include examples/response/postAvailability.json
            400:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/400error.json
            401:
              body:
                application/json:
                  type: !include datatypes/error/401error.raml
                  example: !include examples/error/401error.json
            500:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/500error.json

    /inventory:
      /{serviceAccount}:
        uriParameters:
          serviceAccount:
            type: string
            example: GPONMAY_000001
        get:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Consult Inventory
          description: Consult the collection for information NAP, NAP PORT, OLT, OLT CARD, PTO OLT, UNIDO in MDM MDM INVENTORY CD associated with the service account.         
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/consultInventory.raml
                  example: !include examples/response/consultInventoryExample.json
            400:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/400error.json
            401:
              body:
                application/json:
                  type: !include datatypes/error/401error.raml
                  example: !include examples/error/401error.json
            500:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/500error.json
    /orders:
      /{orderNumber}:
        uriParameters:
          orderNumber:
            type: string
            example: MDM-MAY-00001
        get:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Get order status
          description: check order status in MDM
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/getOrderState.raml
                  example: !include examples/response/getOrderStatus.json
            400:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/400error.json
            401:
              body:
                application/json:
                  type: !include datatypes/error/401error.raml
                  example: !include examples/error/401error.json
            500:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/500error.json
        /poles:
          get:
            is: [tibcoHeaders]
            securedBy: [etb_oauth_2_0]
            displayName: Obtain Pole
            description: Obtains certain pole information from an order
            queryParameters:
              cuentaServicio?: string
              listadodeParametros?: string[]
            responses:
              200:
                body:
                  application/json:
                    type: !include datatypes/response/polesResponse.raml
                    example: !include examples/response/consultPole.json
          patch:
            is: [tibcoHeaders]
            securedBy: [etb_oauth_2_0]
            displayName: Update Pole state
            description: Update pole state in an order
            queryParameters:
              cuentaServicio?: string
              operacion:
                type: string
                enum: ["CAPTURA", "DESMONTE"]
            responses:
              200:
                body:
                  application/json:
                    type: !include datatypes/response/polesResponse.raml
                    example: !include examples/response/poleUpdate.json
          delete:
            is: [tibcoHeaders]
            securedBy: [etb_oauth_2_0]
            displayName: Delete poles
            description: Deletes poles from an order
            queryParameters:
              cuentaServicio?: string
            responses:
              200:
                body:
                  application/json:
                    type: !include datatypes/response/polesResponse.raml
                    example: !include examples/response/poleDelete.json     
          /{idPoste}:
            uriParameters:
              idPoste:
                type: string
                example: "Poste1"
                required: true
            patch:
              is: [tibcoHeaders]
              securedBy: [etb_oauth_2_0]
              displayName: Update parameters in postes
              description: This operation parameters in postes
              body:
                application/json:
                  type: !include datatypes/request/updateParameters.raml
              responses:
                200:
                  body:
                    application/json:
                      properties:
                        codigo:
                          type: string
                          example: "200"
                        descripcion:
                          type: string
                          example: "El poste fue actualizado correctamente en la orden 'MDM-MAY-0001'"
      /cancelOrder: 
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Cancel Order
          description: Cancel Order Request setting status to O117
          body:
            application/json:
              type: !include datatypes/request/cancelOrder.raml
              example: !include examples/request/CancelOrder.json
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/CancelOrder.raml
                  example: !include examples/response/CancelOrder_response200.json
            400:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/400error.json  
            401:
              body:
                application/json:
                  type: !include datatypes/error/401error.raml
                  example: !include examples/error/401error.json
            500:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/500error.json
      /poles:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Insert Pole
          description: Inserts a new pole into an order
          body:
            application/json:
              type: !include datatypes/request/insertPole.raml
              example: !include examples/request/insertPole.json
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/polesResponse.raml
                  example: !include examples/response/poleInsertion.json
        patch:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Updates Pole coordinates
          description: Updates pole coordinates in an order
          body:
            application/json:
              type: !include datatypes/request/updatePoleCoords.raml
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/polesResponse.raml
                  example: !include examples/response/poleUpdate.json
    /provisioning:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Provisioning
        description: This operation register the activations on the platform
        body:
          application/json:
            type: !include datatypes/request/Provisioning.raml
            example: !include examples/request/Provisioning.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/Provisioning.raml
                example: !include examples/response/Provisioning_response200.json
          400:
            body:
              application/json:
                type: !include datatypes/error/error.raml
                example: !include examples/error/400error.json  
          401:
            body:
              application/json:
                type: !include datatypes/error/401error.raml
                example: !include examples/error/401error.json
          500:
            body:
              application/json:
                type: !include datatypes/error/error.raml
                example: !include examples/error/500error.json
      /confirm:
        post:
          displayName: Confirm Provisioning
          description: This operation confirms the provisioning of Mayorista service
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          body:
            application/json:
              type: !include datatypes/request/postProvisioningConfirm.raml
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/postConfirmProvisioning.raml
                  example: !include examples/response/postConfirmProvisioning.json
            400:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/400error.json  
            401:
              body:
                application/json:
                  type: !include datatypes/error/401error.raml
                  example: !include examples/error/401error.json
            500:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/500error.json
    
    /incident:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Create incident
        description: This operation create incident in Remedy
        body:
          application/json:
            type: !include datatypes/request/Incident_request.raml
            example: !include examples/request/Inicident_requestExample.json
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/Incident_response.raml
                example: !include examples/response/Incident_responseExample.json
          400:
            body:
              application/json:
                type: !include datatypes/error/error.raml
                example: !include examples/error/400error.json
          401:
            body:
              application/json:
                type: !include datatypes/error/401error.raml
                example: !include examples/error/401error.json
          500:
            body:
              application/json:
                type: !include datatypes/error/error.raml
                example: !include examples/error/500error.json
              
      /{ticketNumber}:
        uriParameters:
          ticketNumber:
            type: string
            example: ""
        get:
          is: [tibcoHeaders]         
          securedBy: [etb_oauth_2_0]
          displayName: Get incident
          description: This operation create incident in Remedy
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/GetIncident_response.raml
                  example: !include /examples/response/GetIncident_responseExample.json
            400:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/400error.json
            401:
              body:
                application/json:
                  type: !include datatypes/error/401error.raml
                  example: !include examples/error/401error.json
            500:
              body:
                application/json:
                  type: !include datatypes/error/error.raml
                  example: !include examples/error/500error.json

    /cancelOrder:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: This method Cancel an Order on OCS
        description: Method to Cancel an Order
        body:
          type: !include datatypes/request/cancelOrderRequest.raml
          example: !include examples/request/cancelOrderExample.json
        responses:
          200:
            body:
                type: !include datatypes/response/cancelOrderSuccess.raml
                example: !include examples/response/cancelOrderSuccess.json
    /resInvList:
      /{externalId}:
        uriParameters:
          externalId:
            required: true
            type: string
            example: "900162721"
        get:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Get an RevInvList
          description: Get an RevInvList
          queryParameters:
            limit:
              type: string
              required: true
              example: "100"
            offset:
              type: string
              required: true
              example: "0"
          responses:
            200:
              body:
                  application/json:
                    type: !include datatypes/response/get-resInvList.raml   
    /invokeETADirectInbound:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Invoke ETA Direct Inbound
        description: This method invokeETADirectInbound on OCS
        body:
          type: !include datatypes/request/invokeETADirectInbound.raml
          example: !include examples/request/invokeETADirectInbound.json
        responses:
          200:
            body:
              example: !include examples/response/invokeETADirectInbound-response.json
    /getCapacity:
      post:
        is:
        - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Gets capacity according skill attribute
        description: This method gets the capacity based on the skill attribute
        body:
          application/json:
            type: !include datatypes/request/getCapacity.raml
        responses:
          200: 
            body:
              type: !include datatypes/response/getCapacity.raml
    /customer:
      /privacy:
        get:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Privacy law parameters query
          description: Privacy law parameters query to make registration available
          queryParameters:
            operation:
              type: string
              enum: ["CANALES_HORARIOS", "OBLIGATORIEDAD"]
              example: "CANALES_HORARIOS"
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/privacyLawQueryResponse.raml
        patch:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Privacy law parameters modification
          description: Privacy law parameters modification
          body:
            application/json:
              type: !include /datatypes/request/privacyLawParams.raml
          responses:
            200:
              body:
                applcation/json:
                  type: object
                  properties:
                    codigo:
                      type: number
                      required: true
                      example: 200
      /contact:
        get:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Customer contact information query
          description: Obtain information registered by user for contact.
          queryParameters:
            tipoDocumento:
              type: string
              example: "CC"
            numeroDocumento:
              type: string
              example: "123456789"
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/contactInformationQuery.raml
        patch:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Update contact information
          description: Update contact information
          body:
            application/json:
              type: !include /datatypes/request/patch-userContactInformation.raml
          responses:
            200:
              body:
                applcation/json:
                  type: object
                  properties:
                    codigo:
                      type: number
                      required: true
                      example: 200
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Add contact information
          description: Add contact information
          body:
            application/json:
              type: !include /datatypes/request/post-userContactInformation.raml
          responses:
            200:
              body:
                applcation/json:
                  type: object
                  properties:
                    codigo:
                      type: number
                      required: true
                      example: 200
      /checkChannel:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Check channel duplicity
          description: Checks if other user has the channel registered.
          body:
            application/json:
              type: !include datatypes/request/postDuplicidadCanal.raml
          responses:
            200:
              body:
                application/json:
                  type: object
                  properties:
                    codigo:
                      type: number
                      required: true
                      example: 200
      /otp:
        post:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Creacion y envio OTP
          description: Este servicio crea un otp y lo envia al canal indicado
          body:
            type: !include datatypes/request/post-creationOTP.raml
          responses:
            200:
              body:
                type: !include datatypes/response/post-creationOTP.raml
        /validation:
          post:
            is:
              - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            displayName: Validacion OTP
            description: Este servicio valida el codigo OTP
            body:
              type: !include datatypes/request/post-validateOTP.raml
            responses:
              200:
                body:
                  type: !include datatypes/response/post-validateOTP.raml
    /process:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Process
        description: Process Order
        body:
          application/json:
            type: !include datatypes/request/processRequestType.raml
            example: !include examples/request/processRequestExample.json   
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/processResponseTypes.raml
                example: !include examples/response/processResponseExample.json
          500:
            body:
              application/json:
                type: !include datatypes/response/processResponseTypes500.raml
                example: !include examples/response/processResponseExample500.json
                
  /v2:
    /customer:
      /privacy:
        get:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Privacy law parameters query
          description: Privacy law parameters query to make registration available
          queryParameters:
            operation:
              type: string
              enum: ["CANALES_HORARIOS", "OBLIGATORIEDAD"]
              example: "CANALES_HORARIOS"
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/privacyLawQueryResponse_v2.raml               
/support:
  /v1:
    /imei:
      get:
        is: [tibcoHeaders, imeiParams]
        securedBy: [etb_oauth_2_0]
        displayName: Consulta IMEI
        description: Consulta de los IMEI Registrados
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/ResponseBDO.raml
    /positiveRecord:
      post:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Insert positive record
          description: This method creates a positive record
          body:
            application/xml:
              type: insertPositiveRecord-lib.WSRegistroPositivo
              example: !include /examples/request/insertPositiveRecord.raml
          responses:
              201:
                description: Response for the status 201
                body: 
                  application/json:
                    example: !include examples/response/postPositiveRecord200Response.json
              500:
                description: Response for the status 500
                body:
                  application/json:
                    example: !include examples/response/postPositiveRecord500Response.json                      

/billing:
  /v1:
    /notifyMDM:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0] 
        displayName: NotifyBillToMDM
        description: Invoice notification to MDM SOAP input
        body:
          application/json:
            type: !include datatypes/request/post-NotifyBillToMDM.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/post-NotifyBillToMDM-200.raml
          
    /billing_accounts:
      /{account_id}:
        /cycles:
          get:
            is:
              - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            description: Obtains the billing cycle from Revchain
            responses:
              200:
                description: Client list returned by the method
                body:
                    application/json:
                      type: !include datatypes/response/get-AccountCycle.raml 
                      example: !include examples/response/get-AccountCycle_200.json
              500:
                description: Client list returned by the method
                body:
                    application/json:
                      type: !include datatypes/response/get-AccountCycle.raml 
                      example: !include examples/response/get-AccountCycle_500.json   
    /negociaciones:
      /solfact_getdata:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]   
          displayName: ZBAPI_SOLFACT_GETDATA_GP
          description: Consulta de facturas y datos del acreedor
          body:
            application/json:
              type: !include datatypes/request/ZBAPI_SOLFACT_GETDATA_GP.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/ZBAPI_SOLFACT_GETDATA_GPResponse.raml
                  example: !include examples/response/ZBAPI_SOLFACT_GETDATA_GPResponse.json
      /solfact_checkdata:
       post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]   
          displayName: ZBAPI_SOLFACT_CHECKDATA_GP
          description: Consulta de Integridad y Consistencia de la información con valor en MD5
          body:
            application/json:
              type: !include datatypes/request/ZBAPI_SOLFACT_CHECKDATA_GP.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/ZBAPI_SOLFACT_CHECKDATA_GPResponse.raml
                  example: !include examples/response/ZBAPI_SOLFACT_CHECKDATA_GPResponse.json
      /block_invoice:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]   
          displayName: ZBAPI_BLOCK_INVOICE_GP
          description: Bloqueo de Facturas que están en Affirmatum para ser negociadas
          body:
            application/json:
              type: !include datatypes/request/ZBAPI_BLOCK_INVOICE_GP.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/ZBAPI_BLOCK_INVOICE_GPResponse.raml
                  example: !include examples/response/ZBAPI_BLOCK_INVOICE_GPResponse.json
      /change_invoice:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]   
          displayName: ZBAPI_CHANGE_INVOICE_GP
          description: Cambio de Acreedor de factura, condiciones de pago y compensación en ERP
          body:
            application/json:
              type: !include datatypes/request/ZBAPI_CHANGE_INVOICE_GP.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/ZBAPI_CHANGE_INVOICE_GPResponse.raml
                  example: !include examples/response/ZBAPI_CHANGE_INVOICE_GPResponse.json
      /payment_notif:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]   
          displayName: ZBAPI_PAYMENT_NOTIF_GP
          description: Validar si ya se pago la factura negociada al fondeador en la fecha comprometida y libera cupo de  negociación.
          body:
            application/json:
              type: !include datatypes/request/ZBAPI_PAYMENT_NOTIF_GP.raml
          responses:    
            201:
              body:
                application/json:
                  type: !include datatypes/response/ZBAPI_PAYMENT_NOTIF_GPResponse.raml
                  example: !include examples/response/ZBAPI_PAYMENT_NOTIF_GPResponse.json      
    /hierarchy-account:    
      get:
        is:
            - tibcoHeaders
        securedBy: [etb_oauth_2_0]   
        displayName: Obtener un número (jerarquía de cuentas)
        description: Obtener la jerarquía de cuentas -> obtener un número
        queryParameters:
          source_account:
            type: string
            required: true
            example: "15052863470"
          external_serviceId:
            type: string
            required: true
            example: "AC-1001795"
          destination_account:
            type: string
            required: true
            example: "15052855047"
        headers:
          name:
            type: string
            required: true
            example: "Salesforce"
          X-CORRELATION-ID:
            type: string
            required: true
            example: "AC-1001795"
          processingServer:
            type: string
            required: true
            example: "Mulesoft"
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-HierarchyAccount200Response.raml
          500:
            body:
              application/json:
                type: !include /datatypes/response/get-HierarchyAccount500Response.raml
    /getInvoice:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Get invoice format
        description: Consulta recibo de pago
        body:
          application/json:
              type: !include datatypes/request/getInvoice.raml
        responses:
          201:
            body:
              application/json:
                example: !include examples/response/getInvoice.json
/fulfillment:
  /v1:
    /tramits:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Register tramit
        description: Register tramit
        body:
          application/json:
              type: !include datatypes/request/registerTramitsType.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/registerTramitsResponse.raml
                example: !include examples/response/registerTramits201Example.raml
          202:
            body:
              application/json:
                type: !include datatypes/response/registerTramitsResponse.raml
                example: !include examples/response/registerTramits202Example.raml
                
/v1:
  /logs:
    post:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Post a new log entry
      description: Adds a log entry
      body:
        type: !include datatypes/request/traceabilityLogEntry.raml
      responses:
        201:
          body:
            type: object
            properties:
              message_res:
                type: number
                example: 201
  /nonStandardAddress:  
    post:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Post an unnormalized address
      description: Adds a new un-normalized address to the list
      body:
        type: !include datatypes/request/addressRequest.raml
      responses:
        201:
          body:
            type: !include datatypes/response/addressResponse.raml

  /login:
    get:
      is: tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Authentication to access Portal Instalador
      description: Authentication to access Portal Instalador
      queryParameters:
        email:
          type: string
          example: "CU"
        password:
          type: string
          example: "Qd6s29XE86M3ZlAIQI7Yig=="
      responses:
        200:
          body:
            application/json:
              properties:
                codigo:
                  type: string
                  example: "200"
                descripcion:
                  type: string
                  example: "LOGIN CORRECTO"
        500:
          body:
            application/json:
              properties:
                codigo:
                  type: string
                  example: "500"
                descripcion:
                  type: string
                  example: "ERROR CONSULTA"                    
  /incident:
    post:
      is: tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Create incident.
      description: This method create incident
      body:
        application/json:
          type: !include datatypes/request/post-createIncident.raml
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/post-createIncident.raml
  /referred:
    get:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      queryParameters:
          tipoDocumento:
            type: string
            example: "CC"
          numeroDocumento:
            type: string
            example: "1090409964"
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/get-referrals.raml
        404:
          body:
            example: !include examples/error/404error.json
    post:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Post referrals
      description: Adds referrals
      body:
        application/json:
          type: !include datatypes/request/postReferrals.raml
      responses:
        201:
          body:
            application/json:
              example: !include examples/response/postReferrals.json
        404:
          body:
            application/json:
              example: !include examples/error/404error.json
        500:
          body:
            application/json:
              example: !include examples/error/postReferral500error.json
    delete:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Delete referrals
      description: Remove referrals
      queryParameters:
        tipoDocumento:
          type: string
          example: "CC"
          required: true
          minLength: 1
        numeroDocumento:
          type: string
          example: "1090409964"
          required: true
          minLength: 1
        tipoDocumentoReferido:
          type: string
          example: "CC"
          required: true
          minLength: 1
        numeroDocumentoReferido:
          type: string
          example: "19433246"
          required: true
          minLength: 1
      responses:
        201:
          body:
            application/json:
              example: !include examples/response/deleteReferrals.json
        404:
          body:
            application/json:
              example: !include examples/error/404error.json
        500:
          body:
            application/json:
              example: !include examples/error/deleteReferral500error.json
    /activeLines:
      get:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        queryParameters:
          tipoDocumento:
            type: string
            example: "CC"
          numeroDocumento:
            type: string
            example: "1090409964"
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-activeLinesReferrals.raml
          404:
            body:
              application/json:
                type: !include examples/error/404error.json
    /quotas:
      get:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        queryParameters:
          cantidadLineas: 
            type: string
            example: "2"
        responses:
          200:
            body:
              application/json:
                properties:
                  lineasRestantes:
                    type: string
                    example: "3"