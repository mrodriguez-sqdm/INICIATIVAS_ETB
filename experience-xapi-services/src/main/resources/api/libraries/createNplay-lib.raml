#%RAML 1.0 Library
types:  
  altKey: 
    type: object
    properties:
      id:
        type: string
        required: false
      altKeyName:
        type: string
        required: false
      altKeyValue:
        type: string
        required: false
        description:
      actionCode:
        type: string
        required: false
  identification:
    type: object
    properties:
      id:
        type: string
        required: true
        example: ""
      businessComponentID:
        type: string
        required: true
        example: ""
      applicationObjectKeyID:
        type: string
        required: true
        example: ""
  identificationCustomerId:
    type: identification
    example: !include /examples/request/CreateNplayOrder/IDs/customerID.raml
  identificationPartyId:
    type: identification
    example: !include /examples/request/CreateNplayOrder/IDs/partyID.raml
  identificationItemRefId:
    type: identification
    example: !include /examples/request/CreateNplayOrder/IDs/ItemRefID.raml
  identificationOwnerPartyId:
    type: identification
    example: !include /examples/request/CreateNplayOrder/IDs/ownerPartyID.raml
  identificationSalesOrderId:
    type: identification
    example: !include /examples/request/CreateNplayOrder/IDs/salesOrderID.raml
  address:
    type: object
    properties:
      identification:
        type: object
        required: false
        properties:
          id:
            type: string
            required: false
            description: 
          businessComponentID:
            type: string
            required: false
            description:
          applicationObjectKeyID:
            type: string
            required: false
            description:
      lineOne:
        type: string
        required: false
        description:
      cityName:
        type: string
        required: false
        description:
      stateName:
        type: string
        required: false
        description:
      countryCode:
        type: string
        required: false
        description:
      countryName:
        type: string
        required: false
        description:
      gisID:
        type: string
        required: false
        description:
      latitude:
        type: string
        required: false
        description:
      longitude:
        type: string
        required: false
        description:
      cityCode:
        type: string
        required: false
        description:
      stateCode:
        type: string
        required: false
        description:
      purposeCode:
        type: string
        required: false
        description:
      reference:
        type: string
        required: false
        description:
      technology:
        type: object
        required: false
        properties:
          'type':
            type: string
            required: true
            description:
          coverageType:
            type: string
            required: true
            description:
          coverageIndicator:
            type: boolean
            required: true
            description:
          coverageName:
            type: string
            required: true
            description:
          zone:
            type: string
            required: true
            description:
      daneCode:
        type: string
        required: false
      postcode:
        type: string
        required: false
      geoGroup:
        type: string
        required: false
  addressCustomer:
    type: address
    example: !include /examples/request/CreateNplayOrder/Addresses/customerAddress.raml
  addressService:
    type: address
    example: !include /examples/request/CreateNplayOrder/Addresses/serviceAddress.raml
  addressShipTo:
    type: address
    example: !include /examples/request/CreateNplayOrder/Addresses/shipToAddress.raml
  parameterType:
    type: object
    properties:
      name:
        type: string
        required: false
      value:
        type: string
        required: false
      description:
        type: string
        required: false
      validity:
        type: string
        required: false
      actionCode:
        type: string
        required: false
  discountsType:
    type: object
    properties:
      discount:
        type: array
        required: false
        items:
          type: object
          properties:
            feature:
              type: object
              required: false
              properties:
                typeName:
                  type: string
                  required: false
                id:
                  type: string
                  required: false
                index:
                  type: number
                  required: false
                startDate:
                  type: string
                  required: false
                validity:
                  type: number
                  required: false
                acumulateValidity:
                  type: number
                  required: false
                parameter:
                  type: array
                  required: false
                  items:
                    type: parameterType
  accountType:
    type: object
    properties:
      id:
        type: string
        required: false
      number:
        type: string
        required: false
      location:
        type: string
        required: false
      'type':
        type: string
        required: false
      address:
        type: address
        required: false
