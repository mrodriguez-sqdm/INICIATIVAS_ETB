<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-NotifyBillToMDM-handlerSub_Flow" doc:id="c35524ae-6939-48f9-8230-59378401e9f3" >
		<choice doc:name="Choice" doc:id="e73843f5-d1f8-43ad-b4c4-691edb861424" >
			<when expression="#[!isEmpty(payload.NotifyBillInput.Request.ServiceBill) or !isEmpty(payload.NotifyBillInput.Request.EquipmentBill)]">
				<flow-ref doc:name="Go to Orchestrator" doc:id="c968497c-3cd0-4702-8b67-26ed062bdef0" name="post-NotifyBillToMDM-orchestratorSub_Flow"/>
			</when>
			<otherwise >
				<raise-error doc:name="Raise error" doc:id="15d00b61-fc4d-41bf-adc1-9b8b9f94aba1" type='MDM:INVALID_DATA' description="Missing field: No ServiceBill or EquipmentBill found"/>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
