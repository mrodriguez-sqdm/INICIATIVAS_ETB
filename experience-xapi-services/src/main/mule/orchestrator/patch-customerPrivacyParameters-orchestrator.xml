<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-customerPrivacyParameters-orchestratorSub_Flow" doc:id="be5c935b-910e-4784-902c-3747e3f15c34" >
		<ee:transform doc:name="Prepare input payload" doc:id="9d1af191-fb17-4153-964b-20b5c29b4d14" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
[
	{
		"Codigo": payload.codigo as String,
		"Nombre": payload.valor,
		"Descripcion": payload.descripcion
	}
]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Go to Client" doc:id="fc84698b-f2f7-4c7c-bce3-4b99b79695ee" name="patch-customerPrivacyParameters-client"/>
		<ee:transform doc:name="Prepare output" doc:id="acf112e8-07bf-43bf-971c-3193ff129c89" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
if (payload.matched == 1 and payload.modified == 1)
{
	codigo: 200
}
else
{
	codigo: 500
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
