<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-customerContact-orchestratorSub_Flow" doc:id="413f07c0-05e3-4052-8ec1-f2a0fc6d4264" >
		<flow-ref doc:name="Go to Client" doc:id="b8aecb7f-60a8-44a4-8c28-b82772f05b1f" name="get-customerContact-client"/>
		<ee:transform doc:name="Prepare output" doc:id="88e2e9f2-7863-4029-bbfb-3479c549cae2" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"codigo": attributes.statusCode,
	"res-ley-intimidad": payload.Comunicaciones_Cobranza update {
        case [0]."Registro_Contacto" -> $ filter $.Autorizado == true
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
