	<flow name="experience-xapi-services-main">
        <http:listener path="/*" config-ref="experience-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <try doc:name="Try" doc:id="c3fc50cc-f7fa-4467-84a1-b7d74afd427c">
			<flow-ref doc:name="Call initial Logger" doc:id="cbe6fa84-8104-4234-9d92-4a2237eefb65" name="initial-loggin-Sub_Flow" />
			<error-handler>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="b5200d62-8eaf-4d8a-b832-c4e6204fd770">
					<logger level="INFO" doc:name="Logger" doc:id="e0340d78-f8e7-4a0f-adc3-00f41a8fcc9a" message="#[error]" category="error_loggin" />
				</on-error-continue>
			</error-handler>
		</try>
        <apikit:router config-ref="experience-xapi-services-config" />
        <try doc:name="Try" doc:id="453ab307-d47d-4754-826c-ec155252861c">
				<async doc:name="Async" doc:id="bd24aa1f-a9f2-447d-981a-64d85e8968ce">
					<flow-ref doc:name="Call logger" doc:id="c18184c0-9fce-4216-9f91-483ffe784c2f" name="loggin-client-call" />
				</async>
				<error-handler>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="7f190013-0969-461b-ac1e-1c9b8914efc3">
						<logger level="INFO" doc:name="Logger" doc:id="745361a8-6c00-47e8-9783-d635325efacd" message="#[error]" category="error_loggin" />
					</on-error-continue>
				</error-handler>
			</try>
		<error-handler ref="error-handlerError_Handler" />
    </flow>
