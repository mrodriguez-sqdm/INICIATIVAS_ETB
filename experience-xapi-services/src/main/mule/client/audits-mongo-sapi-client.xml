	<sub-flow name="audits-mongo-log-before" doc:id="a96c8146-7b20-4921-978a-a4d2025924ae" >
		<ee:transform doc:name="Transform Message" doc:id="dfd5a972-36d4-42f6-a8e5-10c07c940292">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "Identificador_Peticion": correlationId,
    "Sistema_Origen": "MULESOFT",
    "Servicio": vars.processname default "",
    "Operacion": flow.name,
    "TipoPista": "",
    "Fecha_Peticion": now() >> "America/Bogota",
    "Datos_Entrada": ((((write(payload.^raw, "application/json") default "NA")) replace "\n" with "") replace "\r" with "") replace "\t" with "",
    "Observaciones": "",
    "IP": ""
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request method="POST" doc:name="Call audits-mongo" doc:id="76ea6464-f5da-4115-bb76-2173452fcc64" config-ref="HTTP_Request_configuration_audits_mongo" path="${audits-mongo-sapi.path}">
			<http:headers ><![CDATA[#[output application/java
---
{
	"client_secret" : p('audits-mongo-sapi.client_secret'),
	"client_id" : p('audits-mongo-sapi.client_id')
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"api_id" : app.name
}]]]></http:uri-params>
		</http:request>
	</sub-flow>
