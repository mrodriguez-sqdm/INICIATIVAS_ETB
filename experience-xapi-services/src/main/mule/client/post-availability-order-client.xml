	"client_secret" : p('operations-papi.client_secret'),	
	"client_id" : p('operations-papi.client_id'),
	"X-CORRELATION-ID" : vars.correlationId,
	"name": attributes.headers.name,
	"source": attributes.headers.source,
	"systemId": vars.systemId
}]]]></http:headers>
			<http:uri-params><![CDATA[#[output application/java
---
{
	"orderNumber" : vars.orderNumber
}]]]></http:uri-params>
		</http:request>
