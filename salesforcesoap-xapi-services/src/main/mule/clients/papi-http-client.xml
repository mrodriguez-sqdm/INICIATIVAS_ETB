<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="papi-http-client-sub-flow"
		doc:id="7fc3bd48-ac49-4a61-bf77-ea09f8d9e37c">
		<http:request doc:name="PAPI HTTP Request"
			doc:id="6a22e15b-0f00-4de4-80f0-1bc59935cb6a"
			config-ref="PAPI_HTTP_Request_config"
			method="#[vars.httpRequest.method]" path="#[vars.httpRequest.path]"
			sendCorrelationId="ALWAYS">
			<http:headers><![CDATA[#[vars.httpRequest.headers default {}]]]></http:headers>
			<http:uri-params><![CDATA[#[vars.httpRequest.uriParams default {}]]]></http:uri-params>
			<http:query-params><![CDATA[#[vars.httpRequest.queryParams default {}]]]></http:query-params>
		</http:request>
	</sub-flow>
</mule>
