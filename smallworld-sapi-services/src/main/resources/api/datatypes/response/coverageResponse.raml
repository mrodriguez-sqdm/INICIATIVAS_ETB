#%RAML 1.0 DataType
type: object
properties:
  fechaSolicitud:
    type: datetime
    description: Request date
    required: false
    example: "2025-09-17T00:00:00Z"

  idNap:
    type: string
    description: NAP identifier
    required: false
    example: "612802304584424293"

  nombreNap:
    type: string
    description: NAP name
    required: false
    example: "N4CO34_C7"

  mayorista:
    type: string
    description: Wholesaler information
    required: false
    example: "ETB,TIGO"

  tecnologias:
    type: array
    description: Available technologies
    required: true
    items:
      type: object
      properties:
        tipo:
          type: string
          description: Technology type
          required: false
          example: "FIBRA"
        propietario:
          type: string
          description: Technology owner
          required: false
          example: "ETB"
        estratoPredominante:
          type: string
          description: Predominant stratum
          required: false
          example: ""
        tipoCobertura:
          type: string
          description: Coverage type
          required: false
          example: "MOLECULA"
        cobertura:
          type: string
          description: Coverage
          required: false
          example: "MOLECULA"
        nombreCobertura:
          type: string
          description: Coverage name
          required: false
          example: "FCO34"
        tipoArea:
          type: string
          description: Area type
          required: false
          example: "NODO"
        area:
          type: string
          description: Area
          required: false
          example: "CHICO"
        migracionOLT:
          type: string
          description: OLT migration status
          required: false
          example: "True"
        nombreOLT:
          type: string
          description: OLT name
          required: false
          example: "BOCOZTC30001"

  respuestaFactibilidad:
    type: object
    description: Feasibility response
    required: true
    properties:
      factible:
        type: string
        description: Feasibility status
        required: false
        example: "VIABLE"
      tecnologia:
        type: string
        description: Recommended technology
        required: false
        example: "FIBRA"
      motivo:
        type: string
        description: Reason for feasibility decision
        required: false
        example: "NO TIENE SPLITTER"

  informacionDireccion:
    type: object
    description: Address information
    required: true
    properties:
      codigoDireccion:
        type: string
        required: false
        example: "100000000000690051"
      estrato:
        type: string
        required: false
        example: "6"
      codigoLote:
        type: string
        required: false
        example: "01"
      chip:
        type: string
        required: false
        example: "SIN CHIP"
      barrio:
        type: string
        required: false
        example: "008307"
      localidad:
        type: string
        required: false
        example: "02"
      estadoGeo:
        type: string
        required: false
        example: "A"
      destino:
        type: string
        required: false
        example: "22"
      tipoDistancia:
        type: string
        required: false
        example: "AE"

  gisRespuestaProceso:
    type: object
    description: GIS process response
    required: true
    properties:
      codigoRespuesta:
        type: string
        description: Response message
        required: false
        example: "La transaccion se ejecuto exitosamente, tiempo transcurrido: 474 ms"

      fechaRespuesta:
        type: object
        description: Response date container
        required: false
        properties:
          date:
            type: datetime
            description: Response date
            required: false
            example: "2025-09-17T08:28:59Z"

      codigoError:
        type: string
        description: Error code
        required: false
        example: ""

      descripcionError:
        type: string
        description: Error description
        required: false
        example: ""
