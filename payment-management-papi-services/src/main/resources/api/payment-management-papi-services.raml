#%RAML 1.0
title: payment-management-papi-services
description: The following API will be in charge of create and retrive payment transaction
baseUri: payment-management-papi-services-dev.us-e2.cloudhub.io
version: "v1"

protocols:
    - HTTP

traits:
  security_client_id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  commonHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/commonheaders/1.0.0/commonheaders.raml
  tibcoRequestHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

/health-check:
    displayName: Health Check
    get:
        description: Get the current status of this API

/v1:
  /{paymentMethod}:
    uriParameters:
      paymentMethod:
        type: string
        required: true
        description: "Identificador de la pasarela de pagos"
        example: "pse"
    /banks:
      get:
        is: [security_client_id, commonHeaders]
        displayName: Get payment banks
        description: Get payment banks
        responses:
          200:
            body:
              application/json:
                #example: !include examples/responses/pseBanks.json
    /payment:
      post:
        is: [security_client_id, commonHeaders]
        displayName: Create payment transaction
        description: Create payment transaction
        body:
          application/json:
            type: object
        responses:
          201:
            body:
              application/json:
      /{paymentId}:
        get:
          # queryParameters:
          #  origin: string
          is: [security_client_id, commonHeaders]
          displayName: Get transaction By Id
          description: Get transaction By Id
          responses:
            200:
              body:
                application/json:
        patch:
              is: [security_client_id, commonHeaders]
              displayName: Update payment transaction
              description: Update payment transaction
              body:
                application/json:
                  type: object
              responses:
                201:
                  body:
                    application/json: