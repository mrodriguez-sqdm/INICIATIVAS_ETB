{
  "transactionId": "${logData.transactionId}",
  "correlation_id": "${correlationId}",
  "fecha_creacion": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "fecha": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyyMMdd",
      "timeZone": "UTC"
    }
  },
  "body_request": {
    "$resolver": "message",
    "stringified": false
  },
  "attributes_request": "${logData.attributes}",
  "http_code": "${logData.statusCode}",
  "apiName": "${app.name}",
  "host": "${logData.host}",
  "processname": "${logData.processname} ${flow.name}"
}
