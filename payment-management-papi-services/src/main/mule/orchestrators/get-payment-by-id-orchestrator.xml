<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-payment-by-id-orchestrator-sub-flow"
		doc:id="68eac157-8de3-4e96-be21-8d0cdae175d3">
		<ee:transform doc:name="set payment variables"
			doc:id="2e704274-3542-4158-ba72-83290c3be51b">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/getPayment/setPaymentId.dwl"
					variableName="paymentId" />
				<ee:set-variable
					resource="dwScripts/getPayment/setPaymentMethod.dwl"
					variableName="paymentMethod" />
			</ee:variables>
		</ee:transform>
		<choice doc:name="validate id origin"
			doc:id="ac7e11d9-5158-4c1c-8be4-389fb351555b">
			<when
				expression='#[attributes.uriParams.paymentMethod == "etb"]'>
				<ee:transform doc:name="set httpRequest"
					doc:id="13055898-6cac-4178-a347-b0c7dac0c100">
					<ee:variables>
						<ee:set-variable
							resource="dwScripts/getPayment/setMongoHttpRequest.dwl"
							variableName="httpRequest" />
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="sapi-http-client-sub-flow"
					doc:id="ec6ffe2a-0123-4b10-90cf-394986953673"
					name="sapi-http-client-sub-flow" />
			</when>
			<otherwise>
				<ee:transform doc:name="set request variables"
					doc:id="ad9b4f5c-9a50-4a12-91b2-89033833d521">
					<ee:variables>
						<ee:set-variable
							resource="dwScripts/getPayment/setPaymentResponsePath.dwl"
							variableName="responsePath" />
						<ee:set-variable
							resource="dwScripts/getPayment/setPaymentHttpRequest.dwl"
							variableName="httpRequest" />
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="sapi-http-client-sub-flow"
					doc:id="39eba747-2cff-43af-b1b1-030fe2c04306"
					name="sapi-http-client-sub-flow" />
				<choice doc:name="validate sapi response"
					doc:id="8d804533-8fb6-47d7-ac9d-9152e47e21fb">
					<when expression="#[isEmpty(payload.data)]">
						<raise-error doc:name="raise not found error"
							doc:id="274c72f4-37e8-49ba-80d0-0cac9d16a93a"
							type="GET_PAYMENT:PAYMENT_NOT_FOUND"
							description="El Id proporcionado no esta relacionado a ningun pago" />
					</when>
					<otherwise>
						<ee:dynamic-evaluate
							doc:name="dynamic evaluate response"
							doc:id="30dfd4a6-2d28-4632-9838-b78feb3ec878"
							expression="#[vars.responsePath]" />
					</otherwise>
				</choice>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
