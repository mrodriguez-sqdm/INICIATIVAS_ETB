<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-payment-orchestrator-sub-flow"
		doc:id="6fd28a28-94b3-447d-b610-9ad00414215c">
		<ee:transform doc:name="set payment request variables"
			doc:id="720f2415-4c10-4e26-826d-05763f790c61">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/postPayment/setPaymentHttpRequest.dwl"
					variableName="httpRequest" />
				<ee:set-variable
					resource="dwScripts/postPayment/setPaymentRequestPath.dwl"
					variableName="requestpath" />
				<ee:set-variable
					resource="dwScripts/postPayment/setPaymentMethod.dwl"
					variableName="paymentMethod" />
				<ee:set-variable
					resource="dwScripts/postPayment/setPayloadOri.dwl"
					variableName="payloadOri" />
			</ee:variables>
		</ee:transform>
		<ee:dynamic-evaluate
			doc:name="dynamic evaluate payment request"
			doc:id="2b0e8a8b-2bbd-4963-a0c1-e848b713a0ef"
			expression="#[vars.requestPath]" />
		<flow-ref doc:name="sapi-http-client-sub-flow"
			doc:id="75a16e22-8a5a-49a7-b838-80f03131db00"
			name="sapi-http-client-sub-flow" target="sapiResponse" />
		<choice doc:name="is duplicate" doc:id="caf5bb23-a696-4871-8055-027377eccf18" >
			<when expression='#[vars.sapiResponse.data.responseCode == "APPROVED"]'>
				<ee:transform doc:name="set mongo request variables" doc:id="70a1117c-67a2-4f2b-b284-bcf1cad9bb9e">
			<ee:variables>
				<ee:set-variable resource="dwScripts/postPayment/setMongoRequestPath.dwl" variableName="requestPath" />
				<ee:set-variable resource="dwScripts/postPayment/setMongoHttpRequest.dwl" variableName="httpRequest" />
			</ee:variables>
		</ee:transform>
				<ee:dynamic-evaluate doc:name="dynamic evaluate mongo request" doc:id="b3dc972f-938d-4f60-a07f-7846c1365d90" expression="#[vars.requestPath]" />
				<flow-ref doc:name="sapi-http-client-sub-flow" doc:id="72e75d68-6a57-429e-860a-a2871581483a" name="sapi-http-client-sub-flow" target="mongoResponse" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="response code" doc:id="5978a27b-ab1d-42aa-a6d8-840bd447d935" message='#[vars.sapiResponse.data.responseCode ++ " - not valid, transaction will not be registered"]'/>
			</otherwise>
		</choice>
		<ee:transform doc:name="set response" doc:id="f9719168-78d6-4fef-b1e0-c8d99cdfe34b">
			<ee:message>
				<ee:set-payload resource="dwScripts/postPayment/setPaymentResponse.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable resource="dwScripts/postPayment/setStatusResponse.dwl" variableName="httpStatus" />
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
