				<ee:set-variable resource="dwScripts/postPayment/setPayloadOri.dwl" variableName="payloadOri" />
			</ee:variables>
		</ee:transform>
		<ee:dynamic-evaluate doc:name="dynamic evaluate payment request" doc:id="769c90f2-1ef1-465a-a160-4628102b176c" expression="#[vars.requestPath&#93;" />
		<flow-ref doc:name="sapi-http-client-sub-flow" doc:id="79d1650b-50d3-4111-9402-697ea72e5a61" name="sapi-http-client-sub-flow" target="sapiResponse" />
		<choice doc:name="is duplicate" doc:id="78a5585c-6c2a-4d70-8644-fd377d1e3835" >
