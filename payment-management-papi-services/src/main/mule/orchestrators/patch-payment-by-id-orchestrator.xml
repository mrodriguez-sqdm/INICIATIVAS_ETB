<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-payment-by-id-orchestrator-sub-flow"
		doc:id="2383e43e-9a87-4555-bdc6-675bfac0fa1d">
		<ee:transform doc:name="set payment variables">
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/patchPayment/setPaymentId.dwl"
					variableName="paymentId" />
				<ee:set-variable
					resource="dwScripts/patchPayment/setPaymentMethod.dwl"
					variableName="paymentMethod" />
			</ee:variables>
		</ee:transform>
		<ee:transform doc:name="set get mongo request"
			doc:id="66f0d900-1999-47cd-8ad6-f6696a06fd3a">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/patchPayment/setGetMongoHttpRequest.dwl"
					variableName="httpRequest" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sapi-http-client-sub-flow"
			doc:id="cfbdaaa2-cf26-43cc-bb09-99ddb989ed7f"
			name="sapi-http-client-sub-flow" target="mongoGetResponse" />
		<ee:transform doc:name="set patch mongo request"
			doc:id="50b099f2-0be7-4071-b8ba-bb5859a4bda8">
			<ee:message>
				<ee:set-payload
					resource="dwScripts/patchPayment/setPatchMongoRequest.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/patchPayment/setPatchMongoHttpRequest.dwl"
					variableName="httpRequest" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sapi-http-client-sub-flow"
			doc:id="b48f32ef-b1cb-413f-ad7f-9565c7c50e07"
			name="sapi-http-client-sub-flow" target="mongoResponse" />
		<ee:transform doc:name="set response"
			doc:id="d1f49c76-8fda-4671-9fa1-5d99c06b1716">
			<ee:message>
				<ee:set-payload
					resource="dwScripts/patchPayment/setPaymentResponse.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/patchPayment/setStatusResponse.dwl"
					variableName="httpStatus" />
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
