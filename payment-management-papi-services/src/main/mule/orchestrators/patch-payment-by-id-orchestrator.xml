<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-payment-by-id-orchestrator-sub-flow"
		doc:id="2383e43e-9a87-4555-bdc6-675bfac0fa1d">
		<ee:transform doc:name="set payment variables" doc:id="585ac159-9ed2-4cae-baaf-17909c4f2943">
			<ee:variables>
				<ee:set-variable resource="dwScripts/patchPayment/setGetHttpRequest.dwl" variableName="httpRequest" />
				<ee:set-variable resource="dwScripts/patchPayment/setPaymentRequestPath.dwl" variableName="requestpath" />
			</ee:variables>
		</ee:transform>
		<ee:dynamic-evaluate doc:name="dynamic evaluate payment request" doc:id="5c295478-da2e-4e83-aee9-718652fd23df" expression="#[vars.requestPath]" />
		<flow-ref doc:name="sapi-http-client-sub-flow"
			doc:id="cfbdaaa2-cf26-43cc-bb09-99ddb989ed7f"
			name="sapi-http-client-sub-flow"/>
		<ee:transform doc:name="set response"
			doc:id="d1f49c76-8fda-4671-9fa1-5d99c06b1716">
			<ee:message>
				<ee:set-payload
					resource="dwScripts/patchPayment/setPaymentResponse.dwl" />
			</ee:message>
			<ee:variables>
				<ee:set-variable
					resource="dwScripts/patchPayment/setStatusResponse.dwl"
					variableName="httpStatus" />
			</ee:variables>
		</ee:transform>
	</sub-flow>
</mule>
