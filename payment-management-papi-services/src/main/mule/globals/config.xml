<?xml version="1.0" encoding="UTF-8"?>
<mule
	xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:json-logger="http://www.mulesoft.org/schema/mule/json-logger"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
						http://www.mulesoft.org/schema/mule/json-logger http://www.mulesoft.org/schema/mule/json-logger/current/mule-json-logger.xsd
						http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
						http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
						http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">
	<http:listener-config
		name="payment-management-papi-services-httpListenerConfig">
		<http:listener-connection
			host="${http.private.host}"
			port="${http.private.port}" />
	</http:listener-config>
	<apikit:config
		name="payment-management-papi-services-config"
		api="api\payment-management-papi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />		
	<global-property
		doc:name="Global Property"
		doc:id="edb331d2-018a-4e38-9211-e944a8c7532e"
		name="app.env"
		value="local" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="6526cb64-c3c4-4a0e-867d-05cc12dacca9"
		file="properties\common.yaml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="f3bf335a-b640-4975-be5c-7f60abe9101d"
		file="properties/${app.env}/config-${app.env}.yaml" />
	<secure-properties:config
		name="Secure_Properties_Config"
		doc:name="Secure Properties Config"
		doc:id="2784f3a7-9c46-406c-a51c-ba1cfb58ea21"
		file="properties/${app.env}/secure-${app.env}.yaml"
		key="${app.key}">
	</secure-properties:config>
	
	<api-gateway:autodiscovery
		apiId="${app.apiId}"
		ignoreBasePath="true"
		doc:name="API Autodiscovery"
		doc:id="c1e62ffc-71fb-4717-bb40-840ca3875444"
		flowRef="payment-management-papi-services-main" />
	<json-logger:config
		name="JSON_Logger_Config"
		doc:name="JSON Logger Config"
		doc:id="86e7e68e-ebc2-4a38-8ebf-995730276538"
		applicationName="${app.name}"
		applicationVersion="${app.version}"
		environment="${app.env}"
		disabledFields="${jsonLogger.disabledFields}"
		contentFieldsDataMasking="${jsonLogger.contentFieldsDataMasking}" />
	<http:request-config name="HTTP_Request_Sapi_configuration" doc:name="HTTP Request configuration" doc:id="a148ad7c-2167-4ac8-ac81-cde099991470" basePath="#[vars.requestVars.basePath]">
		<http:request-connection host="#[vars.requestVars.host]" port="#[vars.requestVars.port]" />
	</http:request-config>
	<http:request-config name="HTTP_Request_Mongo_configuration" doc:name="HTTP Request configuration" doc:id="ccfb877a-41a7-44b2-b2cb-7daef5a7e331" basePath="${mongo-db-sapi.basePath}">
		<http:request-connection host="${mongo-db-sapi.host}" port="${mongo-db-sapi.port}" />
	</http:request-config>

</mule>