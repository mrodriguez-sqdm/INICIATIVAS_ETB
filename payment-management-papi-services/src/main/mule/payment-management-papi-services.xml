<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:tracing="http://www.mulesoft.org/schema/mule/tracing"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd  http://www.mulesoft.org/schema/mule/tracing http://www.mulesoft.org/schema/mule/tracing/current/mule-tracing.xsd">
	<apikit:config
		name="payment-management-papi-services-config"
		api="resource::35a39a92-efa9-49b6-8f13-d66508fd2f35:payment-management-papi-services:1.0.3:raml:zip:payment-management-papi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<http:listener-config
		name="payment-management-papi-services-httpListenerConfig">
		<http:listener-connection
			host="${http.private.host}" port="${http.private.port}" />
	</http:listener-config>
	<flow name="payment-management-papi-services-main">
		<http:listener
			config-ref="payment-management-papi-services-httpListenerConfig"
			path="${app.listener.basepath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="call initial logger"
			doc:id="194ac007-5999-430c-99e2-47408178c121"
			name="initial-loggin-Sub_Flow" />
		<apikit:router
			config-ref="payment-management-papi-services-config" />
		<async doc:name="Async"
			doc:id="b3bb77bf-e7b3-40bc-8f01-eab0181fcff2">
			<flow-ref doc:name="call logger client"
				doc:id="d8847349-c58e-479e-a3e9-e76d4dc1e9d6"
				name="loggin-client-call" />
		</async>
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="payment-management-papi-services-console">
		<http:listener
			config-ref="payment-management-papi-services-httpListenerConfig"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			config-ref="payment-management-papi-services-config" />
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow
		name="get:\health-check:payment-management-papi-services-config">
		<flow-ref doc:name="get-health-check-orchestrator-sub-flow"
			doc:id="4819cbe6-3ef6-4b3a-9faf-064199c1655b"
			name="get-health-check-orchestrator-sub-flow" />
	</flow>
	<flow
		name="get:\v1\(paymentMethod)\banks:payment-management-papi-services-config">
		<flow-ref doc:name="get-payment-banks-orchestrator-sub-flow"
			doc:id="2fc39ba7-3eff-49b7-ad96-411e90c3d7c5"
			name="get-payment-banks-orchestrator-sub-flow" />
	</flow>
	<flow
		name="get:\v1\(paymentMethod)\payment\(paymentId):payment-management-papi-services-config">
		<flow-ref doc:name="get-payment-by-id-orchestrator-sub-flow"
			doc:id="7acafe59-0151-446e-aa35-7532a6da9368"
			name="get-payment-by-id-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\v1\(paymentMethod)\payment:application\json:payment-management-papi-services-config">
		<flow-ref doc:name="post-payment-orchestrator-sub-flow"
			doc:id="94162605-8bad-4f70-8af1-c96d79315246"
			name="post-payment-orchestrator-sub-flow" />
	</flow>
	<flow name="patch:\v1\(paymentMethod)\payment\(paymentId):application\json:payment-management-papi-services-config">
		<flow-ref doc:name="patch-payment-by-id-orchestrator-sub-flow" doc:id="3e24dc2e-c12f-4d8f-91bb-5f96b2aa6c02" name="patch-payment-by-id-orchestrator-sub-flow" />
    </flow>
</mule>
