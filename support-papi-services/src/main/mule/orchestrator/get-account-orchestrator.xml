		<choice doc:name="Choice" doc:id="4a95ec1b-693c-4954-9f96-3f60a675eb6b">
					<when expression="#[!isEmpty(vars.queryParams.tipo_documento) and !isEmpty(vars.queryParams.numero_documento)]">
				<flow-ref doc:name="Go to get-account-by-document-type-and-number" doc:id="f8a349d9-f709-4024-9e3f-1c21d92c534a" name="get-account-by-document-type-and-number"/>
					</when>
			<when expression="#[!isEmpty(vars.queryParams.correo_electronico)]">
