	<sub-flow name="get-account-by-document-type-and-number" doc:id="f5877386-2bfa-46ff-b14e-d2344989e5dc" >
		<flow-ref doc:name="Go to client" doc:id="29111429-ffe3-4872-bdce-a69e358e9d83" target="salesforce_resp" name="get-account-salesforce-clientSub_Flow" />
		<choice doc:name="Choice" doc:id="d60a0869-5898-4d3f-b0c9-d8738ae25a64">
			<when expression="#[vars.salesforce_resp.done != true]">
				<ee:transform doc:name="Salesforce Error" doc:id="68e4dfbf-4dfe-4bfe-8919-7187f0b2d3d9">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
var cause = ((vars.salesforce_resp default []) map ((item, index) -> 
        {
            "origin": "salesforce-sapi-services",
            "message": item.message default ""
        }
    ))
---
{
  "status": 409,
  "code": if(sizeOf(vars.salesforce_resp)!=1) "INTERNAL_SERVER_ERROR" else vars.salesforce_resp[0].errorCode default "INTERNAL_SERVER_ERROR",
  "message": {
    "message": ""
  },
  "messageServer": cause reduce ((i, acc = "") -> 
    if(acc == "") i.message else if(i.message != "") acc ++ " | " ++ i.message else acc
  ),
  "cause": cause ++ [{
      "origin": "support-papi-services",
      "message": ""
    }]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[409]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
							<when expression="#[vars.salesforce_resp.totalSize == 0]">
								<ee:transform doc:name="NOT_FOUND" doc:id="497bb5a0-0c92-49b5-b0a4-c9cc6d190fd7">
							<ee:message>
								<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": 404,
  "code": "NOT_FOUND",
  "message": {
    "message": ""
  },
  "messageServer": "Account does not exist",
  "cause": [
    {
      "origin": "support-papi-services",
      "message": ""
    }
  ]
}]]></ee:set-payload>
							</ee:message>
							<ee:variables>
								<ee:set-variable variableName="httpStatus"><![CDATA[404]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
							</when>
							<otherwise>
								<ee:transform doc:name="Set response" doc:id="ca46943c-fbda-4d96-b7b8-5f872a14b09a">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "id": vars.salesforce_resp.records[0].Id,
    "tipoDocumento": vars.salesforce_resp.records[0].Tipodedocumento__c,
    "numeroDocumento": vars.salesforce_resp.records[0].External_Id__c,
    "nombre": upper(vars.salesforce_resp.records[0].Name),
    "uen": vars.salesforce_resp.records[0].UEN__c,
    "segmento": upper(vars.salesforce_resp.records[0].Segmento__c),
    "integrationId": vars.salesforce_resp.records[0].Identificador_Cuenta_Mongo__c
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</otherwise>
		</choice>
	</sub-flow>
