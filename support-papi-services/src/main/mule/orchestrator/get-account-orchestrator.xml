			</when>
			<otherwise>
				<ee:transform doc:name="BAD_REQUEST" doc:id="bf8b367d-f50a-4950-b674-fe12539ec6fd">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": 400,
  "code": "BAD_REQUEST",
  "message": {
    "message": ""
  },
  "messageServer": "Invalid tipo_documento, numero_documento or correo_electronico",
  "cause": [
    {
      "origin": "support-papi-services",
      "message": "Wrong source"
    }
  ]
}]]></ee:set-payload>
									</ee:message>
									<ee:variables>
										<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
									</ee:variables>
								</ee:transform>
					</otherwise>
				</choice>
