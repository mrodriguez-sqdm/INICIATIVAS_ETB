	<sub-flow name="get-account-validate-source" doc:id="7fa0596e-1375-4fe5-8d42-152fcdfb5cb7" >
		<ee:transform doc:name="Set sources" doc:id="20fdbca5-06f5-4fd0-85cc-38e9ea6fe63a" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="sources" ><![CDATA[%dw 2.0
output application/json
---
p('global.get-account.sources') splitBy " | "]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="3dd43509-24f3-41a5-b894-3d22a09fe843">
			<when expression='#[vars.sources contains vars.headers.source]'>
				<flow-ref doc:name="Go to get-account-validate-params" doc:id="16cf6212-d166-4579-9aed-09f64d143b1a" name="get-account-validate-params"/>
					</when>
			<otherwise>
				<ee:transform doc:name="BAD_REQUEST" doc:id="fae23018-d3e4-41c3-8df9-d95b0b028b29">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": 400,
  "code": "BAD_REQUEST",
  "message": {
    "message": ""
  },
  "messageServer": "Wrong source",
  "cause": [
    {
      "origin": "support-papi-services",
      "message": "Wrong source"
    }
  ]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
					</otherwise>
				</choice>
	</sub-flow>
