<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-delivery-handlerSub_Flow" doc:id="3369b9e1-d3b1-4806-bfb0-4b3aa8f39575" >
		<choice doc:name='mock == "true"?' doc:id="2481dfa7-1065-48ab-b220-ad05cb5372a4" >
			<when expression="#[p('global.deliveryMock') == &quot;true&quot;]">
				<ee:transform doc:name="Mock Response" doc:id="955fe574-129b-40c2-92b7-3f1f98af27cc" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "DeliveryLTEResponse": {
        "OrderId": payload.inputMessage.OrderFulfilment.Identification.ID,
        "ResponseCode": 17,
        "ResponseDescription": "ENVIADO"
    }
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<set-variable value="#[trim(payload.inputMessage.OrderFulfilment.Scheduling.SubOrderType)]" doc:name="subOrder Type" doc:id="446b9c66-832d-430b-abd7-4220a96f847a" variableName="subOrderType"/>
				<set-variable value="#[payload]" doc:name="Set inputPayload" doc:id="39e0378d-8452-4522-96df-6bc840595c24" variableName="inputPayload" />
				<flow-ref doc:name="Go to Orchestrator" doc:id="841356b3-2efd-4ce2-80b9-407691cd96e2" name="post-delivery-orchestratorSub_Flow" />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
