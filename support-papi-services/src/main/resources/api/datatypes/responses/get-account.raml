#%RAML 1.0 DataType
properties:
  id:
    type: string
    example: "0014000000vWUqLAAW"
  tipoDocumento:
    type: string
    example: "NIT"
  numeroDocumento: 
    type: string
    example: "899999115"
  nombre: 
    type: string
    example: "ETB"
  uen: 
    type: string
    example: "Empresas y Ciudades Inteligentes"
  segmento: 
    type: string
    example: "Mayoristas"
  integrationId: 
    type: string
    example: ""