#%RAML 1.0 DataType
properties:
  activos:
    type: array
    items:
      type: object
      properties:
        CasosRelacionados:
          type: array
          items:
            type: object
            properties:
              DescripcionAvance:
                type: any
                example: null
              Estado:
                type: string
                example: "Abierto"
              CUN:
                type: any
                example: null
              NumeroCaso:
                type: string
                example: "02289190"
              Id:
                type: string
                example: "500RT000005jleIYAQ"
        Estado:
          type: string
          example: "Activo"
        CiudadInstalacion:
          type: string
          example: "BOGOTA, D.C."
        DireccionInstalacion:
          type: string
          example: "123 ABC - 56 °"
        NumeroCuentaFacturacion:
          type: string
          example: "15052890151"
        NumeroConexion:
          type: string
          example: "3057000447"
        Parent:
          type: string
          example: ""
        Root:
          type: string
          example: "a028C0000018HVEQA2"
        Producto:
          type: string
          example: "MIXTO 30GB NEGOCIOS"
        IDServicio:
          type: any
          example: null
        Name:
          type: string
          example: "AC-1030739"
        Id:
          type: string
          example: "a028C0000018HVEQA2"