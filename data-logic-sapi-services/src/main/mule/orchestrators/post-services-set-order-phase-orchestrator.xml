<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow
		name="post-services-set-order-phase-orchestrator-sub-flow"
		doc:id="55f80fa0-ca5f-4cd5-aadb-57a0800c8e5f">
		<ee:transform doc:name="set xml request"
			doc:id="688f33c2-2ee8-42fb-86d5-bfe17c37dcd6">
			<ee:message>
				<ee:set-payload
					resource="dwlScripts/mdmDataServices/postSetOrderPhaseXmlRequest.dwl" />
			</ee:message>
			<ee:variables>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="post-services-set-order-phase-orchestrator-sub-flow" doc:id="6059d6c4-1f33-4759-8fd2-5934ee021cf1" message="#[payload]"/>
		<flow-ref
			doc:name="post-set-order-phase-soap-client-sub-flow"
			doc:id="1a0d2f98-bb35-4cff-bf8a-5a83c66b3257"
			name="post-set-order-phase-soap-client-sub-flow" />
		<logger level="INFO" doc:name="post-services-set-order-phase-orchestrator-sub-flow" doc:id="1a9d6077-acc8-4d8d-b04c-a03d55353082" message="#[payload]"/>
		<choice doc:name="operation result"
			doc:id="66599bbe-6664-4923-b00e-b17ab510e5ac">
			<when
				expression='#[upper(payload.body.Set_Order_PhaseResponse.Set_Order_PhaseResult.WSResponseHeader.service.status default "") != "OK"]'>
				<ee:transform doc:name="Transform Message" doc:id="d874397d-8574-4d13-8d2b-afcb73a375a6" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 400,
  "code": "APP:BAD_REQUEST",
  "message": (payload.body.Set_Order_PhaseResponse.Set_Order_PhaseResult.WSResponseHeader.service.statusDetail default "Invalid gateway or payment flow combination") as String
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[400]]></ee:set-variable>
					</ee:variables>
				</ee:transform>			
			</when>
			<otherwise>
				<ee:transform doc:name="set json response"
					doc:id="44565bb5-129e-4b79-bd47-a18a776986cf">
					<ee:message>
						<ee:set-payload
							resource="dwlScripts/mdmDataServices/postSetOrderPhaseJsonResponse.dwl" />
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
