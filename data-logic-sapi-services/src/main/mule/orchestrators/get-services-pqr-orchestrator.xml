<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="get-services-pqr-orchestrator-sub-flow"
		doc:id="2447b527-ae51-4b5b-97e5-d700281c79d0">
		<ee:transform doc:name="set xml request"
			doc:id="7eff252e-fdfc-4035-9def-713ec0bebb7a">
			<ee:message>
				<ee:set-payload
					resource="dwlScripts/getServicesPqr/getPqrXmlRequest.dwl" />
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="get-pqr-soap-client-sub-flow"
			doc:id="7f0ece8b-48c4-4004-a04b-4dd99d354cd1"
			name="get-pqr-soap-client-sub-flow" />
		<choice doc:name="operation result"
			doc:id="96476cc5-0fd6-4380-bc17-f2d47381862f">
			<when
				expression='#[(payload.body.Get_PQRResponse.Get_PQRResult.WSResponseHeader.service.status as String) == "FAIL" or (payload.body.Get_PQRResponse.Get_PQRResult.WSResponseHeader.service.status as String) == "NO DATA"]'>
				<raise-error doc:name="GET_PQR:RESULT_ERROR"
					doc:id="3da30080-82a9-43fe-a80c-f0700f43c934"
					type="GET_PQR:RESULT_ERROR"
					description='#["OperationResult: " ++ (payload.body.Get_PQRResponse.Get_PQRResult.WSResponseHeader.service.statusDetail as String)]' />
			</when>
			<otherwise>
				<ee:transform doc:name="set json response"
					doc:id="2f6cbe30-7693-475c-811b-3b355060378e">
					<ee:message>
						<ee:set-payload
							resource="dwlScripts/getServicesPqr/getPqrJsonResponse.dwl" />
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
