<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-lte-resources-orchestrator-sub-flow"
		doc:id="55f80fa0-ca5f-4cd5-aadb-57a0800c8e5f">
		<ee:transform doc:name="set xml request"
			doc:id="688f33c2-2ee8-42fb-86d5-bfe17c37dcd6">
			<ee:message>
				<ee:set-payload
					resource="dwlScripts/inventarioServiceLTE/postLteResourceXmlRequest.dwl" />
			</ee:message>
			<ee:variables>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="post-lte-resources-orchestrator-sub-flow" doc:id="09b05b91-ff32-41fb-9e6c-634205c994f9" message="#[payload]" />
		<flow-ref doc:name="get-lte-resources-soap-client-sub-flow"
			doc:id="1a0d2f98-bb35-4cff-bf8a-5a83c66b3257"
			name="get-lte-resources-soap-client-sub-flow" />
		<logger level="INFO" doc:name="post-lte-resources-orchestrator-sub-flow" doc:id="5e51310e-5993-4604-b727-331a4d673f73" message="#[payload]" />
		<choice doc:name="operation result"
			doc:id="66599bbe-6664-4923-b00e-b17ab510e5ac">
			<when
				expression="#[(payload.body.GestionarInventarioLTEResponse.GestionarInventarioLTEResult.CodigoError as Number) != 0]">
				<ee:transform doc:name="Transform Message" doc:id="add27955-8f9a-4a17-b4bb-40b58d964691" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 400,
  "code": "APP:BAD_REQUEST",
  "message": (payload.body.Set_Order_PhaseResponse.Set_Order_PhaseResult.WSResponseHeader.service.statusDetail default "Invalid gateway or payment flow combination") as String
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[400]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="set json response"
					doc:id="44565bb5-129e-4b79-bd47-a18a776986cf">
					<ee:message>
						<ee:set-payload
							resource="dwlScripts/inventarioServiceLTE/postLteResourceJsonResponse.dwl" />
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
