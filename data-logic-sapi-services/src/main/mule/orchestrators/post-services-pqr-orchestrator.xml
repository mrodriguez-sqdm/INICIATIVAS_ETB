<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-services-pqr-orchestrator-sub-flow"
		doc:id="55f80fa0-ca5f-4cd5-aadb-57a0800c8e5f">
		<ee:transform doc:name="set xml request"
			doc:id="688f33c2-2ee8-42fb-86d5-bfe17c37dcd6">
			<ee:message>
				<ee:set-payload
					resource="dwlScripts/postServicesPqr/postPqrXmlRequest.dwl" />
			
</ee:message>
		</ee:transform>
		<flow-ref doc:name="pqr-soap-client-sub-flow"
			doc:id="1a0d2f98-bb35-4cff-bf8a-5a83c66b3257"
			name="pqr-soap-client-sub-flow" />
		<choice doc:name="operation result"
			doc:id="66599bbe-6664-4923-b00e-b17ab510e5ac">
			<when
				expression="#[(payload.body.Set_PQRResponse.Set_PQRResult.WSResponseBody.OperationResult as Number) != 0]">
				<raise-error doc:name="POST_PQR:RESULT_ERROR"
					doc:id="d4e8110d-ea88-4c9b-81b1-0793e2c5cd33"
					type="POST_PQR:RESULT_ERROR"
					description='#["OperationResult: " ++ (payload.body.Set_PQRResponse.Set_PQRResult.WSResponseBody.OperationResult as String) ++ " - " ++ (payload.body.Set_PQRResponse.Set_PQRResult.WSResponseBody.OperationResultDesc as String)]' />
			</when>
			<otherwise>
				<ee:transform doc:name="set json response"
					doc:id="44565bb5-129e-4b79-bd47-a18a776986cf">
					<ee:message>
						<ee:set-payload
							resource="dwlScripts/postServicesPqr/postPqrJsonResponse.dwl" />
			
</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
