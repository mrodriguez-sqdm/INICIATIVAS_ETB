<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd">
	<http:listener-config
		name="data-logic-sapi-services-httpListenerConfig">
		<http:listener-connection
			host="${http.private.host}" port="${http.private.port}"
			readTimeout="${http.private.readTimeout}" />
	</http:listener-config>
	<apikit:config name="data-logic-sapi-services-config"
		api="resource::35a39a92-efa9-49b6-8f13-d66508fd2f35:data-logic-sapi-services:1.0.3:raml:zip:data-logic-sapi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<wsc:config name="MDM_Data_Web_Service_Consumer_Config"
		doc:name="Web Service Consumer Config"
		doc:id="d7859eeb-2f95-4ecf-a1b6-f947b9f7f22e">
		<wsc:connection
			wsdlLocation="${mdm_data_services.soap.protocol}${mdm_data_services.soap.wsdlHost}:${mdm_data_services.soap.wsdlPort}${mdm_data_services.soap.wsdlPath}"
			service="${mdm_data_services.soap.service}"
			port="${mdm_data_services.soap.servicePort}"
			address="${mdm_data_services.soap.protocol}${mdm_data_services.soap.wsdlHost}:${mdm_data_services.soap.wsdlPort}${mdm_data_services.soap.address}" />
	</wsc:config>
	<wsc:config
		name="Consulta_Inventario_Web_Service_Consumer_Config"
		doc:name="Web Service Consumer Config"
		doc:id="6cbdcaec-8a29-4ae0-9247-182b66221fd1">
		<wsc:connection
			wsdlLocation="${consultaInventario.soap.protocol}${consultaInventario.soap.wsdlHost}:${consultaInventario.soap.wsdlPort}${consultaInventario.soap.wsdlPath}"
			service="${consultaInventario.soap.service}"
			port="${consultaInventario.soap.servicePort}"
			address="${consultaInventario.soap.protocol}${consultaInventario.soap.wsdlHost}:${consultaInventario.soap.wsdlPort}${consultaInventario.soap.address}" />
	</wsc:config>
	<wsc:config
		name="Gestionar_Inventario_LTE_Web_Service_Consumer_Config"
		doc:name="Web Service Consumer Config"
		doc:id="3895c906-48f1-40b8-8a03-f297dfa69378">
		<wsc:connection
			wsdlLocation="${gestionarInventarioLTE.soap.protocol}${gestionarInventarioLTE.soap.wsdlHost}:${gestionarInventarioLTE.soap.wsdlPort}${gestionarInventarioLTE.soap.wsdlPath}"
			service="${gestionarInventarioLTE.soap.service}"
			port="${gestionarInventarioLTE.soap.servicePort}"
			address="${gestionarInventarioLTE.soap.protocol}${gestionarInventarioLTE.soap.wsdlHost}:${gestionarInventarioLTE.soap.wsdlPort}${gestionarInventarioLTE.soap.address}" />
	</wsc:config>
	<wsc:config
		name="MDM_Orchestration_Web_Service_Consumer_Config"
		doc:name="Web Service Consumer Config"
		doc:id="4962c6cd-96c3-4df3-9314-d2a52cd7ab31">
		<wsc:connection
			wsdlLocation="${serviceOrchestrator.soap.protocol}${serviceOrchestrator.soap.wsdlHost}:${serviceOrchestrator.soap.wsdlPort}${serviceOrchestrator.soap.wsdlPath}"
			service="${serviceOrchestrator.soap.service}"
			port="${serviceOrchestrator.soap.servicePort}"
			address="${serviceOrchestrator.soap.protocol}${serviceOrchestrator.soap.wsdlHost}:${serviceOrchestrator.soap.wsdlPort}${serviceOrchestrator.soap.address}" />
	</wsc:config>
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="7f858ef0-82a6-4955-be1b-7223e4af6404"
		file="properties/${env}-properties.yaml" />
	<import doc:name="Import"
		doc:id="be57f8b4-3361-42d0-b18e-c02400e1d78f"
		file="error-handler-v2.xml" />
	<import doc:name="Import"
		doc:id="f0960df0-df57-4b6d-aec2-76617fc48607"
		file="error-handler-v2.xml" />
	<import doc:name="Import"
		doc:id="d09236f8-1b75-4e95-b76d-fecab32dc954" file="loggin.xml" />
	<import doc:name="Import"
		doc:id="488d0ea5-387b-4472-b426-521e1c3c81ae"
		file="audits-sapi-client.xml" />
	<import doc:name="Import"
		doc:id="f99a7c48-de64-41a7-aba0-4dfcb8292004"
		file="etb-common-lib.xml" />
	<api-gateway:autodiscovery apiId="${api.id}"
		ignoreBasePath="false" doc:name="API Autodiscovery"
		doc:id="e41e782a-1aa7-4b03-8c04-03203c24836f"
		flowRef="data-logic-sapi-services-main" />
</mule>
