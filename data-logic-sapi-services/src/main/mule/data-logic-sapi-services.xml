<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
	<flow name="data-logic-sapi-services-main">
		<http:listener
			config-ref="data-logic-sapi-services-httpListenerConfig"
			path="${api.basePath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<async doc:name="Async" doc:id="a0b18f72-73aa-4f80-8de1-aef228597ee7" >
			<flow-ref doc:name="initial-loggin-Sub_Flow" doc:id="7d7fdfb5-ba45-4374-ac8b-4941cd4ab16b" name="initial-loggin-Sub_Flow" />
		</async>
		<apikit:router
			config-ref="data-logic-sapi-services-config" />
		<async doc:name="Async"
			doc:id="2d89abe6-7508-487d-ad76-7d9bedd24f59">
			<flow-ref doc:name="loggin-client-call"
				doc:id="8c2be9c5-6111-40ee-9379-7a781672acf2"
				name="loggin-client-call" />
		</async>
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="data-logic-sapi-services-console">
		<http:listener
			config-ref="data-logic-sapi-services-httpListenerConfig"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			config-ref="data-logic-sapi-services-config" />
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow
		name="post:\services\pqr:application\json:data-logic-sapi-services-config">
		<flow-ref doc:name="post-services-pqr-orchestrator-sub-flow"
			doc:id="6be9461b-a7f1-418d-9325-25a10b862d4c"
			name="post-services-pqr-orchestrator-sub-flow" />
	</flow>
	<flow
		name="get:\resource-inventory\resources:data-logic-sapi-services-config">
		<flow-ref
			doc:name="get-resource-inventory-orchestrator-sub-flow"
			doc:id="1f6790cb-3610-4bdd-84cc-acff11edb539"
			name="get-resource-inventory-resources-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\lte-resources:application\json:data-logic-sapi-services-config">
		<flow-ref doc:name="post-lte-resources-orchestrator-sub-flow"
			doc:id="a71418bf-60f8-4c75-a1f9-8431b18d7977"
			name="post-lte-resources-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\order-bundles:application\json:data-logic-sapi-services-config">
		<flow-ref
			doc:name="post-services-set-order-bundle-orden-orchestrator-sub-flow"
			doc:id="3731bb75-ab4a-4bb3-94b2-e1dd3071755a"
			name="post-services-set-order-bundle-orden-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\order-phases:application\json:data-logic-sapi-services-config">
		<flow-ref
			doc:name="post-services-set-order-phase-orchestrator-sub-flow"
			doc:id="9d041c7b-6ee6-4e9f-9c53-0d1e8ab7d59a"
			name="post-services-set-order-phase-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\orders:application\json:data-logic-sapi-services-config">
		<flow-ref
			doc:name="post-services-set-order-orchestrator-sub-flow"
			doc:id="360abc23-dbd6-4c13-bd0b-c3af87296f7e"
			name="post-services-set-order-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\service-orchestrations:application\json:data-logic-sapi-services-config">
		<flow-ref
			doc:name="post-services-run-orch-service-orchestrator-sub-flow"
			doc:id="b0e52681-1d97-4894-a59a-13623160c703"
			name="post-services-run-orch-service-orchestrator-sub-flow" />
	</flow>
</mule>
