#%RAML 1.0 DataType

description: Request para recarga de paquete(s) (Usage Consumption)
properties:
  msisdn:
    description: Número de línea (Mobile Station International Subscriber Directory Number).
    type: string
    required: true
    example: "3336025009"
  svas:
    description: Lista de paquetes a recargar (SVAs).
    type: array
    required: true
    items:
      type: object
      properties:
        packageId:
          type: string
          description: Identificador del paquete (ej. numérico, se normaliza con prefijo D si aplica).
          example: "123"
  gestor:
    description: Gestor / canal de ventas (opcional).
    type: string
    required: false
    example: "PayU"
