#%RAML 1.0 DataType

description: Request to query promotions via product-papi (mobile or fixed)
type: object
properties:
  type:
    type: string
    required: true
    enum: ["movil", "fijo", "mobile", "fixed"]
    description: Promotion type. Routes to sisext /promotions/mobile or /promotions/fixed.
    example: "movil"
  channel?:
    type: string
    example: "Portal Movilidad"
  agreementCode?:
    type: string
  employeeCode?:
    type: string
  integrationId?:
    type: string
    description: Required for mobile promotions (integration_id)
    example: "MDM-MOV-1003579216"
  serviceAccountId?:
    type: string
    description: Required for fixed promotions (id cuenta servicio)
    example: "CS-100651473"
  documentNumber?:
    type: string
    example: "1234567890"
  optionals?:
    type: array
    items: string
  order?:
    type: string
    example: "ORD-001"
  plan?:
    type: string
    example: "7715"
  externalPromotions?:
    type: array
    items: string
  predefinedPromotions?:
    type: array
    items: string
  service?:
    type: string
    example: "MOVIL"
  orderSubtype?:
    type: string
    example: "VENTA"
  changeType?:
    type: string
    example: "ALTA"
  documentType?:
    type: string
    example: "CC"
  planType?:
    type: string
    example: "POSTPAGO"
