#%RAML 1.0 DataType

description: Request to query promotions via product-papi (mobile or fixed). When analytics=true (fixed only), validations is required.
type: object
properties:
  type:
    type: string
    required: true
    enum: ["movil", "fijo", "mobile", "fixed"]
    description: Promotion type. Routes to sisext /promotions/mobile or /promotions/fixed.
    example: "fijo"
  analytics?:
    type: boolean
    required: false
    description: Optional. Defaults to false. When true (fixed), Analitica is consulted before fixed promotions.
    example: true
  validations?:
    type: object
    required: false
    description: Required only when analytics=true.
    properties:
      municipalityCode:
        type: string
        required: true
        example: "25286"
      departmentCode:
        type: string
        required: true
        example: "25"
      latitude:
        type: string
        required: true
        example: "4,671102955"
      longitude:
        type: string
        required: true
        example: "-74,06212576"
      lotCode?:
        type: string
        example: "0024"
      district?:
        type: string | nil
      locality?:
        type: string | nil
      stratum?:
        type: string
        example: "2"
      gisAddress?:
        type: string
        example: "612802304578433316"
      molecule?:
        type: string
        example: "FCO34"
      purpose?:
        type: string
        example: "05"
      technology:
        type: string
        required: true
        example: "FTTH"
      originSystem:
        type: string
        required: true
        example: "PortalFija"
      clientUen:
        type: string
        required: true
        example: "Hogares y MiPymes"
      uenSegment:
        type: string
        required: true
        example: "Hogares"
      documentType:
        type: string
        required: true
        example: "CC"
      documentNumber:
        type: string
        required: true
        example: "79881777"
      procedureType:
        type: string
        required: true
        example: "VTA"
      groupingNumber:
        type: string
        required: true
        example: "6832"
      allianceCode?:
        type: string | nil
  channel?:
    type: string
    example: "Portal Movilidad"
  agreementCode?:
    type: string
  employeeCode?:
    type: string
  integrationId?:
    type: string
    description: Required for mobile promotions (integration_id)
    example: "MDM-MOV-1003579216"
  serviceAccountId?:
    type: string
    description: Required for fixed promotions (id cuenta servicio)
    example: "CS-100651473"
  documentNumber?:
    type: string
    example: "1234567890"
  optionals?:
    type: array
    items: string
  order?:
    type: string
    example: "ORD-001"
  plan?:
    type: string
    example: "7715"
  externalPromotions?:
    type: array
    items: string
  predefinedPromotions?:
    type: array
    items: string
  service?:
    type: string
    example: "MOVIL"
  orderSubtype?:
    type: string
    example: "VENTA"
  changeType?:
    type: string
    example: "ALTA"
  documentType?:
    type: string
    example: "CC"
  planType?:
    type: string
    example: "POSTPAGO"
