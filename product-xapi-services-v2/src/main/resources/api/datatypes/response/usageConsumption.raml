#%RAML 1.0 DataType

description: Respuesta de recarga de paquete(s)
type: object
properties:
  resultAdd:
    type: array
    description: Resultado por cada paquete aplicado
    items:
      type: object
      properties:
        packageId:
          type: string
          example: "D123"
        idInstanceJSC:
          type: string
          description: Identificador de instancia del paquete en JSC
          example: "inst-001"
