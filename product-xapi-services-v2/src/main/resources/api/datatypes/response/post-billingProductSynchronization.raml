#%RAML 1.0 DataType
type: object
description: Response for POST /v2/billingProductSynchronization — product catalog synchronization.
properties:
  transactionId:
    type: string
    description: "Same transaction ID sent in the request. -> result.transactionId"
    example: SYNC20260424001
  results:
    type: object
    properties:
      attributeSynchronization:
        type: array
        required: false
        description: Synchronized attributes responses
        items:
          type: !include post-billingProductSyncItem.raml
      productSynchronization:
        type: !include post-billingProductSyncItem.raml
        required: false
        description: Synchronized products responses
      offerSynchronization:
        type: !include post-billingProductSyncItem.raml
        required: false
        description: Synchronized offers responses
      offerRelaSynchronization:
        type: object
        required: false
        description: Synchronized offer relations responses 
        properties:
          bundleMemberList:
            type: array
            required: false
            description: Synchronize Bundle Member responses
            items:
              type: !include post-billingProductSyncItem.raml
          mainOfferMemberList:
            type: array
            required: false
            description: Synchronize attributes responses
            items:
              type: !include post-billingProductSyncItem.raml
example: !include ../../examples/response/post-billingProductSynchronization-200.json