<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="wompi-client-sub-flow" doc:id="51a25394-0742-48b7-a31e-037ec281ab59" >
		<http:request method="#[vars.httpRequest.method]" doc:name="Http wompi request" doc:id="168ca1f2-1740-451f-a140-d20bb5bce26a" config-ref="HTTP_Wompi_Request_configuration" path='#[vars.httpRequest.path]' >
			<http:headers ><![CDATA[#[%dw 2.0
output application/java
---
{
	"Authorization": 
		if (vars.httpRequest.path == "tokens/cards")
			"Bearer " ++ Mule::p('secure::wompi.auth.public_key')
		else
			"Bearer " ++ Mule::p('secure::wompi.auth.private_key')
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[vars.httpRequest.uriParams default {}]]]></http:uri-params>
			<http:query-params ><![CDATA[#[vars.httpRequest.queryParams default {}]]]></http:query-params>
		</http:request>
	</sub-flow>
</mule>
