<?xml version="1.0" encoding="UTF-8"?>
<mule
	xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:json-logger="http://www.mulesoft.org/schema/mule/json-logger"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
						http://www.mulesoft.org/schema/mule/json-logger http://www.mulesoft.org/schema/mule/json-logger/current/mule-json-logger.xsd
						http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
						http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
						http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="6526cb64-c3c4-4a0e-867d-05cc12dacca9"
		file="properties\common.yaml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="f3bf335a-b640-4975-be5c-7f60abe9101d"
		file="properties/${env}-properties.yaml" />
	<secure-properties:config
		name="Secure_Properties_Config"
		doc:name="Secure Properties Config"
		doc:id="2784f3a7-9c46-406c-a51c-ba1cfb58ea21"
		file="secureProperties/${env}-secure-properties.yaml"
		key="${secure.key}">
		<secure-properties:encrypt algorithm="Blowfish" />
	</secure-properties:config>
	<api-gateway:autodiscovery
		apiId="${app.id}"
		ignoreBasePath="true"
		doc:name="API Autodiscovery"
		doc:id="c1e62ffc-71fb-4717-bb40-840ca3875444"
		flowRef="wompi-sapi-services-main" />
	<http:request-config
		name="HTTP_Wompi_Request_configuration"
		doc:name="HTTP Request configuration"
		doc:id="3f8f9692-b2cb-4826-9088-43be52c9142f"
		basePath="/${wompi.basePath}">
		<http:request-connection
			host="${wompi.host}"
			port="${wompi.port}"
			protocol="HTTPS" />
	</http:request-config>
	<import doc:name="error-handler-v2" doc:id="5707346a-f3fd-46d2-b3d9-5ea0eccf43ca" file="error-handler-v2.xml" />
	<import doc:name="loggin" doc:id="ef575598-c0d0-495f-bf2c-f6a02b7478a1" file="loggin.xml" />
	<import doc:name="audits-sapi-client" doc:id="0411c82a-7f24-4b45-b4bc-c69b7fd2408e" file="audits-sapi-client.xml" />
	<import doc:name="etb-common-lib.xml" doc:id="351a7221-1016-49de-835c-30021b356b4e" file="etb-common-lib.xml" />
</mule>