#%RAML 1.0
title: mongo-sapi-services
description: The following API will be in charge of the comunications towards the mongo database
baseUri: mongo-sapi-services-dev.us-e2.cloudhub.io/mongo
version: "v1"

protocols:
    - HTTP

traits:
  security_client_id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  commonHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/commonheaders/1.0.0/commonheaders.raml
  tibcoRequestHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

uses:
    commonTypes: libraries/common-types.raml
    requestTypes: libraries/request-types.raml
    responseTypes: libraries/response-types.raml

/health-check:
    displayName: Health Check
    get:
        description: Get the current status of this API

/v1:
  /wompi:
    /acceptanceTokens:
      get:
        is: [security_client_id, commonHeaders]
        displayName: Get acceptance tokens
        description: Acquire the presigned acceptance tokens.
        responses:
          200:
            body:
              application/json:
                example: !include examples/responses/get-acceptance-tokens-response.json
    /paymentMethods:
      get:
        is: [security_client_id, commonHeaders]
        displayName: Get Payment Methods
        description: Get Payment Methods
        responses:
          200:
            body:
              application/json:
                example: !include examples/responses/get-payment-methods-response.json
    /banks:
      get:
        is: [security_client_id, commonHeaders]
        displayName: Get Wompi banks (Only for PSE)
        description: Get Wompi banks (Only for PSE)
        responses:
          200:
            body:
              application/json:
                example: !include examples/responses/get-banks-response.json
    /transactions:
      post:
        is: [security_client_id, commonHeaders]
        displayName: Create transaction
        description: Create transaction
        body:
          application/json:
            type: requestTypes.transaction
            example: !include examples/requests/post-transaction-request.json
        responses:
          201:
            body:
              application/json:
                example: !include examples/responses/post-transaction-response.json
      /{transaction_id}:
        uriParameters:
          transaction_id:
            type: string
            example: "123456"
        get:
          is: [security_client_id, commonHeaders]
          displayName: Get Transactions
          description: Get Transactions
          responses:
            200:
              body:
                application/json:
                  example: !include examples/responses/get-transaction-response.json
        patch:
          is: [security_client_id, commonHeaders]
          displayName: Finalize Transaction (Void)
          description: Finalize Transaction (Void)
          body:
            application/json:
              type: requestTypes.voidTransaction
              example: !include examples/requests/patch-transaction-request.json
          responses:
            201:
    /payment_links:
      post:
        is: [security_client_id, commonHeaders]
        displayName: Create a payment link
        description: Payment link creation
        body:
          application/json:
            type: requestTypes.paymentLink
            example: !include examples/requests/post-payment-links-request.json
        responses:
          201:
            body:
              application/json:
                example: !include examples/responses/post-payment-links-response.json
      /{payment_link_id}:
        uriParameters:
          payment_link_id:
            type: string
            example: "123456"
        get:
          is: [security_client_id, commonHeaders]
          displayName: Get a payment link
          description: Get a payment link
          responses:
            200:
              body:
                application/json:
                  example: !include examples/responses/get-payment-links-response.json
        patch:
          is: [security_client_id, commonHeaders]
          displayName: Activate or deactivate a payment link
          description: Activate or deactivate a payment link
          body:
            application/json:
              type: requestTypes.patchPaymentLink
              example: !include examples/requests/patch-payment-links-request.json
          responses:
            200: