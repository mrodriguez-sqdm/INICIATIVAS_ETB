<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:tns="urn:toatech:agent" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" name="toa_agent_interface" targetNamespace="urn:toatech:agent">
    <types>
        <xsd:schema elementFormDefault="qualified" targetNamespace="urn:toatech:agent">
			<!-- SHARED -->
            <xsd:complexType name="user_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="now" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="company" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="login" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="auth_string" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
			<!-- SEND MESSAGE -->
            <xsd:complexType name="message_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="app_host" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="app_port" type="xsd:long"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="app_url" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="message_id" type="xsd:long"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="company_id" type="xsd:long"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="address" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="send_to" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="subject" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="body" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="message_response_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="message_id" type="xsd:long"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="status" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="description" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="data" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="external_id" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="duration" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="sent" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="messages_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="unbounded" minOccurs="1" name="message" type="tns:message_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="send_message_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="user" type="tns:user_t"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="messages" type="tns:messages_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="send_message_response_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="unbounded" minOccurs="1" name="message_response" type="tns:message_response_t"/>
                </xsd:sequence>
            </xsd:complexType>
			<!-- DROP MESSAGE -->
            <xsd:complexType name="message_id_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="message_id" type="xsd:long"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="message_ids_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="unbounded" minOccurs="1" name="message" type="tns:message_id_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="drop_message_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="user" type="tns:user_t"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="messages" type="tns:message_ids_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="result_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="code" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="0" name="desc" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="message_id_response_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="message_id" type="xsd:long"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="result" type="tns:result_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="drop_message_response_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="unbounded" minOccurs="1" name="message_response" type="tns:message_id_response_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <!-- UPDATE TASK -->
            <xsd:complexType name="values_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="atribute" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="value" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="update_remedy_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="id" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="request_app" type="xsd:string"/>
                    <xsd:element maxOccurs="1" minOccurs="1" name="form_name" type="xsd:string"/>
                    <xsd:element maxOccurs="unbounded" minOccurs="1" name="values" type="tns:values_t"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="update_remedy_response_t">
                <xsd:sequence>
                    <xsd:element maxOccurs="1" minOccurs="1" name="codigo" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>
			<!-- ELEMENTS -->
            <xsd:element name="send_message" type="tns:send_message_t"/>
            <xsd:element name="send_message_response" type="tns:send_message_response_t"/>
            <xsd:element name="drop_message" type="tns:drop_message_t"/>
            <xsd:element name="drop_message_response" type="tns:drop_message_response_t"/>
            <xsd:element name="get_message_status" type="tns:drop_message_t"/>
            <xsd:element name="get_message_status_response" type="tns:drop_message_response_t"/>
            <xsd:element name="update_remedy" type="tns:update_remedy_t"/>
            <xsd:element name="update_remedy_response" type="tns:update_remedy_response_t"/>
        </xsd:schema>
    </types>
    <message name="send_message_m">
        <part element="tns:send_message" name="parameters"/>
    </message>
    <message name="send_message_response_m">
        <part element="tns:send_message_response" name="parameters"/>
    </message>
    <message name="drop_message_m">
        <part element="tns:drop_message" name="parameters"/>
    </message>
    <message name="drop_message_response_m">
        <part element="tns:drop_message_response" name="parameters"/>
    </message>
    <message name="get_message_status_m">
        <part element="tns:get_message_status" name="parameters"/>
    </message>
    <message name="get_message_status_response_m">
        <part element="tns:get_message_status_response" name="parameters"/>
    </message>
    <message name="update_remedy_m">
        <part element="tns:update_remedy" name="parameters"/>
    </message>
    <message name="update_remedy_response_m">
        <part element="tns:update_remedy_response" name="parameters"/>
    </message>
    <portType name="agent_port_type">
        <operation name="send_message">
            <input message="tns:send_message_m"/>
            <output message="tns:send_message_response_m"/>
        </operation>
        <operation name="drop_message">
            <input message="tns:drop_message_m"/>
            <output message="tns:drop_message_response_m"/>
        </operation>
        <operation name="get_message_status">
            <input message="tns:get_message_status_m"/>
            <output message="tns:get_message_status_response_m"/>
        </operation>
        <operation name="update_remedy">
            <input message="tns:update_remedy_m"/>
            <output message="tns:update_remedy_response_m"/>
        </operation>
    </portType>
    <binding name="agent_binding" type="tns:agent_port_type">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="send_message">
            <soap:operation soapAction="agent_service/send_message" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="drop_message">
            <soap:operation soapAction="agent_service/drop_message" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="get_message_status">
            <soap:operation soapAction="agent_service/get_message_status" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="update_remedy">
            <soap:operation soapAction="agent_service/update_remedy" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>
    <service name="agent_service">
        <port binding="tns:agent_binding" name="agent_interface">
            <soap:address location="SOAP_API_LOCATION"/>
        </port>
    </service>
</definitions>