				<http:headers ><![CDATA[#[output application/java
---
{
	"Content-Type" : p('mdm-ws-schedule.headers.contentTypeAction')
}]]]></http:headers>
				<http:query-params ><![CDATA[#[output application/java
---
{
	"server" : p('mdm-ws-schedule.queryParams.server'),
	"webService" : p('mdm-ws-schedule.queryParams.webService')
}]]]></http:query-params>
			</http:request>
			<choice doc:name="Choice" doc:id="84b168ad-9426-4c39-974d-335931d4643a" >
				<when expression="#[payload.Envelope.Body.Set_OperationResponse.Aknowledge == 'OK - Exitoso']">
					<ee:transform doc:name="Transform Message" doc:id="2921e57b-9037-43ab-8abb-cfa3041e3fea" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "Resultado": "Exitoso",
  "Descripcion": "Sin errores"
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</when>
				<when expression="#[payload.Envelope.Body.Set_OperationResponse.Error != null]">
					<ee:transform doc:name="Transform Message" doc:id="5e13bd4a-f243-4327-be1f-0367548eabb6" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "Resultado": "ERROR",
  "Descripcion": payload.Envelope.Body.Set_OperationResponse.Error
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</when>
				<otherwise >
					<ee:transform doc:name="Transform Message" doc:id="3d8aeca9-a5b2-49b8-b802-6428d40aee14" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "Resultado": "ERROR",
  "Descripcion": payload.Envelope.Body.Set_OperationResponse.Error_Remedy
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</otherwise>
			</choice>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="6d562660-0dd7-4bcd-b328-f8e86afc181f" type="HTTP:INTERNAL_SERVER_ERROR" when="error.muleMessage.typedValue.Envelope.Body.Fault != null" >
					<ee:transform doc:name="Xml to Json" doc:id="e79ee233-4fa0-44ad-a8b0-245d6a760347" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
error.muleMessage.typedValue]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</on-error-continue>
			</error-handler>
