<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="put-entries-orchestratorSub_Flow" doc:id="8d26d87f-9579-44c9-933e-ddb1ae1feeb0" >
		<flow-ref doc:name="Get token bmc" doc:id="c26248f6-5b02-4748-9c21-661a21fa3679" name="bmc-authenticator-clientSub_Flow" />
		<flow-ref doc:name="put-entries-bmc-clientSub_Flow" doc:id="bc6b0670-f055-4aa6-acf6-d5193f082a06" name="put-entries-bmc-clientSub_Flow" />
		<choice doc:name="Choice" doc:id="78dce1ab-5af0-4141-aca0-c3ce4436ed80" >
			<when expression="#[isEmpty(payload)]">
				<ee:transform doc:name="Transform Message" doc:id="03412582-c6c1-484f-965c-942c36fca303" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	codigo: "201",
	description: "Updated successful"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="Transform Message" doc:id="c9414a8f-9b65-4fb5-bad8-47679e2c25fb" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	codigo: "500",
	description: payload.messageText[0] ++ " " ++ payload.messageAppendedText[0]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
