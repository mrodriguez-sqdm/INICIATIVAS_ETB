#%RAML 1.0 Library
types:
  WSCancelScheduleIN:
    type: object
    properties:
      part1:
        properties:
          CancelScheduleInput:
            properties:
              WSRequestHeader2:
                properties:
                  System:
                    properties:
                      name: 
                        description: Name of the system calling the service
                        type: string
                        example: Salesforce
                        required: true
                        minLength: 1
                      correlationID: 
                        description: Id related with the current service 
                        type: string
                        example: 5004y00001itm6JAAQ
                        required: true
                        minLength: 1
                      processingServer:
                        description: Server or system controlling the service
                        type: string    
                        example: "Mulesoft"
                        required: true
                        minLength: 1
              CancelScheduleIN:
                properties:
                  IdIncidencia:
                    description: Id related to the incident that most be cancelled
                    type: string
                    example: INC000006073207
                    required: false
                  IdAgenda:
                    description: Internal Id related to the kind of incident into the client
                    type: integer
                    example: 10640276
                    required: false
                  Estado:
                    description: Current status of the incident
                    type: string
                    example: "Success"
                    required: false