#%RAML 1.0 Library
types:
  Envelope:
    type: object
    properties:
      Header:
        properties:
          userName:
            description: Name of the system calling the service
            type: string
            example: "User123"
            required: false
          password:
            description: Name of the system calling the service
            type: string
            example: "Pass1234"
            required: false
      Body:
        properties:
          Create:
            properties:
              ACCION: 
                description: Name of the system calling the service
                type: string
                example: "GENERA RELACION PADRE-HIJA"
                required: false
              IN_MDMPQR_Orig: 
                description: Id related with the current service 
                type: string
                example: "MDM-PQR-25147884"
                required: false
              IN_MDMPQR_Dup:
                description: Server or system controlling the service
                type: string    
                example: "MDM-PQR-25144867"
                required: false
              IN_TipoRelacion:
                description: Server or system controlling the service
                type: string    
                example: "Padre - Hija"
                required: false