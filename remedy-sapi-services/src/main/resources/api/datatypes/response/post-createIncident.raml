#%RAML 1.0 DataType
type: object
properties:
    CreateIncidentOutput:
      type: object
      properties:
        WSResponseHeader2:
          type: object
          properties:
            System:
              type: object
              properties:
                name:
                  type: string
                  example: "MuleSoft"
                correlationID:
                  type: string
                  example: "MDM-PQR-27184427"
                processingServer:
                  type: string
                  example: "MuleSoft MDM"
            Service:
              type: object
              properties:
                status:
                  type: string
                  example: "PASS"
                responseDate:
                  type: string
                  example: "2022-01-24T08:21:46.296-05:00"
            CreateResponse:
              type: object
              properties:
                Request_ID:
                  type: string
                  example: "INC000006276669"
                Aknowledge:
                  type: string
                  example: "Exitoso"
                Estado_Incidencia:
                  type: string
                  example: "Assigned"