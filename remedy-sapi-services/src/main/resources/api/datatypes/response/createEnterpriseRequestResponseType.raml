#%RAML 1.0 DataType
type: object
properties:
  createEnterpriseRequestOut:
    type: object
    required: true
    properties: 
      status:
        type: string
        description: Describes the result of creating an enterprise request.
        required: true
        minLength: 1
      workOrderId:
        type: string
        description: Returns the Id assigned to the new enterprise request.
        required: true
        minLength: 1
      responseDate:
        type: string
        description: Date of effective creation.
        required: true
        minLength: 1