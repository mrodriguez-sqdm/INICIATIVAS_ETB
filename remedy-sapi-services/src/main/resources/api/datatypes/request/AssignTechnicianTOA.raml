#%RAML 1.0 DataType
properties:
  IN_message_id:
    required: false    
    type: string
    example: "409359147"
  IN_appt_number:
    type: string
    example: "INC000004726616"
    required: false
  IN_external_id:
    type: string
    example: "80248143"
    required: false   
  IN_resource_name:
    required: false 
    type: string
    example: "SALOMON NEIRA SALGADO"
  IN_time_slot:
    type: string
    example: "03PM-04PM"
    required: false
  IN_resource_name_2:
    required: false
    type: string 
    example: "Chaises Morris"