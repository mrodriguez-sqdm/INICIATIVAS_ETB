#%RAML 1.0 DataType
properties:
  system:
    type: !include WSHeader.raml
  property:
    type: object
    properties:
      Property:
        type: object
        properties:
          name:
            type: string
            description: Name
            example: ""
            required: false
          value:
            type: string
            description: Value
            example: ""
            required: false
