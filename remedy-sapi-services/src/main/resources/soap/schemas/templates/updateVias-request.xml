<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_Update_INC_MDM">
   <soapenv:Header>
      <urn:AuthenticationInfo>
         <urn:userName>#[p('mdm-remedy.credentials.user')]</urn:userName> 
         <urn:password>#[p('mdm-remedy.credentials.password')]</urn:password>
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Set_Operation>
         <urn:ACCION>Crear Vias COBRE</urn:ACCION>
         <urn:IN_ID_INCIDENCIA>#[attributes.uriParams.'incidence_id']</urn:IN_ID_INCIDENCIA>
         <urn:IN_ETB_Consulta_Vias>#[vars.vias]</urn:IN_ETB_Consulta_Vias>
      </urn:Set_Operation>
   </soapenv:Body>
</soapenv:Envelope>