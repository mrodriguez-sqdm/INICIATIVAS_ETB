<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_ConsultaArrayTask_SF">
   <soapenv:Header>
      <urn:AuthenticationInfo>
        <urn:userName>#[p('mdm-remedy.credentials.user')]</urn:userName>
        <urn:password>#[p('mdm-remedy.credentials.password')]</urn:password>
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Consulta>
         <urn:startRecord>#[vars.startRecord]</urn:startRecord>
         <urn:maxLimit>#[vars.maxLimit]</urn:maxLimit>
         <urn:incident_Number>#[vars.incidence_id]</urn:incident_Number>
      </urn:Consulta>
   </soapenv:Body>
</soapenv:Envelope>