<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_Integracion_CreateNewTask_RMD">
   <soapenv:Header>
      <urn:AuthenticationInfo>
        <urn:userName>#[p('mdm-remedy.credentials.user')]</urn:userName>
        <urn:password>#[p('mdm-remedy.credentials.password')]</urn:password>
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Create_Task>
         <urn:IN_Accion>#[vars.initial.accion]</urn:IN_Accion>
         <urn:IN_Nombre_Task>#[vars.initial.nombreTask]</urn:IN_Nombre_Task>
         <urn:IN_Resumen_Task>#[vars.initial.resumenTask]</urn:IN_Resumen_Task>
         <urn:IN_Notas_Task>#[vars.initial.notasTask]</urn:IN_Notas_Task>
         <urn:IN_Numero_Incidente>#[vars.incidenceId]</urn:IN_Numero_Incidente>
         <urn:IN_ID_CasoSalesforce>#[vars.initial.idCasoSalesforce]</urn:IN_ID_CasoSalesforce>
         <urn:IN_ID_Tarea>#[vars.initial.idTarea]</urn:IN_ID_Tarea>
         <urn:IN_Grupo_Asg>#[vars.initial.grupoAsg]</urn:IN_Grupo_Asg>
      </urn:Create_Task>
   </soapenv:Body>
</soapenv:Envelope>