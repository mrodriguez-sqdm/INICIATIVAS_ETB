<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_Update_INC_MDM">
   <soapenv:Header>
      <urn:AuthenticationInfo>
         <urn:userName>#[p('mdm-ws-order.credentials.user')]</urn:userName>   
         <urn:password>#[p('mdm-ws-order.credentials.password')]</urn:password>   
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Set_Operation>
         <urn:ACCION>#[p('mdm-ws-order.action')]</urn:ACCION>
         <urn:IN_ID_INCIDENCIA>#[output application/java --- payload.IncidenceId]</urn:IN_ID_INCIDENCIA>
         <urn:IN_ETB_OSM_SummaryID>#[output application/java --- payload.OrderId]</urn:IN_ETB_OSM_SummaryID>
         <!--Optional:-->
         <urn:IN_ETB_OSM_StatusCode>#[output application/java --- payload.EstadoOT]</urn:IN_ETB_OSM_StatusCode>
         <!--Optional:-->
         <urn:IN_ETB_OSM_StatusComments>#[output application/java --- payload.Comentarios]</urn:IN_ETB_OSM_StatusComments>
      </urn:Set_Operation>
   </soapenv:Body>
</soapenv:Envelope>