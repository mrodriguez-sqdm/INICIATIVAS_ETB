<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_Update_INC_MDM">
   <soapenv:Header>
      <urn:AuthenticationInfo>
         <urn:userName>#[p('mdm-ws-schedule.credentials.user')]</urn:userName>
            <urn:password>#[p('mdm-ws-schedule.credentials.password')]</urn:password>
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Set_Operation>
         <urn:ACCION>#[p('mdm-ws-schedule.action')]</urn:ACCION>
         <!--Optional:-->
         <urn:IN_ID_INCIDENCIA>#[vars.incidence_id]</urn:IN_ID_INCIDENCIA>
         <!--Optional:-->
         <urn:IN_ETB_TOA_Resp_Message>#[vars.message]</urn:IN_ETB_TOA_Resp_Message>
         <!--Optional:-->
         <urn:IN_ETB_TOA_Resp_IDAgenda>#[vars.schedule_id]</urn:IN_ETB_TOA_Resp_IDAgenda>
         <!--Optional:-->
         <urn:IN_ETB_TOA_FechaAgendada>#[vars.scheduleDate]</urn:IN_ETB_TOA_FechaAgendada>
         <!--Optional:-->
         <urn:IN_ETB_TOA_Resp_TSlot>#[vars.Franja]</urn:IN_ETB_TOA_Resp_TSlot>
      </urn:Set_Operation>
   </soapenv:Body>
</soapenv:Envelope>