      <urn:AuthenticationInfo>
        <urn:userName>#[p('mdm-remedy.credentials.user')]</urn:userName>
        <urn:password>#[p('mdm-remedy.credentials.password')]</urn:password>
      </urn:AuthenticationInfo>
   </soapenv:Header>
   <soapenv:Body>
      <urn:Create_Req>
         <urn:ACCION>#[vars.initial.accion]</urn:ACCION>
         <urn:IN_ID_Salesforce>#[vars.initial.idSalesforce]</urn:IN_ID_Salesforce>
