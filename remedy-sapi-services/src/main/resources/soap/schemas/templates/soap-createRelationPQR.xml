<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:ETB_Integracion_SF_RMD_Create">
	<soapenv:Header>
		<urn:AuthenticationInfo>
			<urn:userName>#[p('mdm-remedy.credentials.user')]</urn:userName> 
			<urn:password>#[p('mdm-remedy.credentials.password')]</urn:password>
			<!--Optional:-->
			<urn:authentication>#[p('mdm-remedy.create-relation-pqr.headers.authentication')]</urn:authentication>
			<!--Optional:-->
			<urn:locale>#[p('mdm-remedy.create-relation-pqr.headers.locale')]</urn:locale>
			<!--Optional:-->
			<urn:timeZone>#[now ()]</urn:timeZone>
		</urn:AuthenticationInfo>
	</soapenv:Header>
	<soapenv:Body>
		<urn:Create>
			<!--Optional:-->
			<urn:ACCION>#[vars.ACCION]</urn:ACCION>
			<!--Optional:-->
			<urn:IN_MDMPQR_Orig>#[vars.IN_MDMPQR_Orig]</urn:IN_MDMPQR_Orig>
			<!--Optional:-->
			<urn:IN_MDMPQR_Dup>#[vars.IN_MDMPQR_Dup]</urn:IN_MDMPQR_Dup>
			<!--Optional:-->
			<urn:IN_TipoRelacion>#[vars.IN_TipoRelacion]</urn:IN_TipoRelacion>
		</urn:Create>
	</soapenv:Body>
</soapenv:Envelope>