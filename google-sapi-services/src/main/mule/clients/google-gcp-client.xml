	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="post-oauth-token-google-gcp-client" doc:id="e3e20819-4f42-4c83-abb6-d1e835851c33">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /token"]' />
		<http:request doc:name="POST /token"
			config-ref="HTTP_Google_OAuth_Request_Config"
			method="${oauth.resources.accessToken.post.method}"
			path="${oauth.resources.accessToken.path}" sendCorrelationId="AUTO"
			responseTimeout="${google.responseTimeout}">
			<http:body><![CDATA[#[output application/x-www-form-urlencoded
---
{
	grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
	assertion: vars.assertion
}]]]></http:body>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /token"]' />
	</sub-flow>

	<sub-flow name="post-lookup-google-gcp-client" doc:id="817ccabd-cec4-45cb-b0b7-252aa673eb7d">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /accounts:lookup"]' />
		<http:request doc:name="POST /accounts:lookup"
			config-ref="HTTP_Google_Identity_Request_Config"
			method="${google.resources.lookup.post.method}"
			path="${google.resources.lookup.path}" sendCorrelationId="AUTO"
			responseTimeout="${google.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
	"Authorization": "Bearer " ++ vars.getToken.access_token,
	"Content-Type": "application/json"
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /accounts:lookup"]' />
	</sub-flow>

