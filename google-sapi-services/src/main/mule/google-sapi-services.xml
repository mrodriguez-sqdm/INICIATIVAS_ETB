<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
	<apikit:config name="google-sapi-services-config"
		api="resource::35a39a92-efa9-49b6-8f13-d66508fd2f35:google-sapi-services:1.0.4:raml:zip:google-sapi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<flow name="google-sapi-services-main">
		<http:listener config-ref="HTTP_Listener_Config"
			path="${api.basePath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<!-- [STUDIO:"initial-loggin-Sub_Flow"]<flow-ref doc:name="initial-loggin-Sub_Flow"
			doc:id="839c9fe7-df84-4ea4-b4d4-a05288573b18"
			name="initial-loggin-Sub_Flow" /> [STUDIO] -->
		<apikit:router config-ref="google-sapi-services-config" />
		<!-- [STUDIO:"Async"]<async doc:name="Async"
			doc:id="b2ba2895-14c9-4ff2-a794-da5b7b7ffc64">
			<flow-ref doc:name="loggin-client-call"
				doc:id="5d4b0e4c-0972-484f-bcbb-789d83284dce"
				name="loggin-client-call" />
		</async> [STUDIO] -->
		<error-handler ref="common-error-handler-local" />
	</flow>
	<flow name="google-sapi-services-console">
		<http:listener config-ref="HTTP_Listener_Config"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			config-ref="google-sapi-services-config" />
		<error-handler ref="common-error-handler-local" />
	</flow>

	<flow
		name="post:\gcp\identity\users\create:application\json:google-sapi-services-config">
		<flow-ref doc:name="Flow Reference" doc:id="f76bea42-2841-493e-9d96-5af10844d872" name="post-create-user-orchestrator"/>
	</flow>
	<flow
		name="post:\gcp\identity\users\delete:application\json:google-sapi-services-config">
		<flow-ref doc:name="Flow Reference" doc:id="2f9f8df1-bfab-4dda-9436-f75e12d9290c" name="post-delete-user-orchestrator" />
	</flow>
	<flow
		name="post:\gcp\identity\login:application\json:google-sapi-services-config">
		<flow-ref doc:name="Flow Reference" doc:id="49bd2168-1a49-4ece-8a63-d3f6e83834e5" name="post-login-user-orchestrator"/>
	</flow>
	<flow
		name="post:\gcp\identity\users\search:application\json:google-sapi-services-config">
		<flow-ref doc:name="Flow Reference" doc:id="c74df634-33da-44b6-8773-bec0abce7bcb" name="post-search-user-orchestrator" />
	</flow>
	<flow
		name="post:\gcp\identity\users\update:application\json:google-sapi-services-config">
		<flow-ref doc:name="Flow Reference" doc:id="2f3c4ccc-e03b-416f-ada9-8d6ae3aa0bbc" name="post-update-user-orchestrator" />
	</flow>
</mule>
