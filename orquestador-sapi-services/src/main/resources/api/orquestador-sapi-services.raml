#%RAML 1.0
title: orquestador-sapi-services
baseUri: orquestador-sapi-services-{env}.us-e2.cloudhub.io/orquestador
description: The following API will handle all of the Orquestador system operations.
mediaType: 
- application/json
version: 1
protocols:
  - HTTP

traits: 
  security_client_id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  tibcoRequestHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

/v1:
  /order:
    /{orderNumber}:
      uriParameters:
        orderNumber:
          type: string
          example: "MDM-PQR-39876386"
      get:
        displayName: Get orderOFSC by orderNumber
        description: Get orderOFSC by orderNumber
        is: [security_client_id, tibcoRequestHeaders]
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/GetOrderOFSC.raml
                example: !include /examples/response/GetOrderOFSC.json
      /properties:
        patch:
          displayName: Update Properties
          description: Updates properties from a given order
          is: [security_client_id, tibcoRequestHeaders]
          body:
            application/json:
              type: !include /datatypes/request/updateProperties.raml
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/generalResponse.raml
                  example: !include /examples/response/updateProperties.raml
    /activate:
      post:
        displayName: Activacion orquestador
        description: Activacion orquestador
        is: [security_client_id, tibcoRequestHeaders]
        body:
          application/json:
            type: !include datatypes/request/post-orderActivate.raml
        responses:
          201:
            body:
              application/json:
                example: !include /examples/response/post-orderActive.json