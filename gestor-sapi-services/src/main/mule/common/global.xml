<!-- 		<http:request-connection host="${audits-sapi.host}" port="${audits-sapi.port}" /> -->
<!-- 	</http:request-config> -->
	<api-gateway:autodiscovery apiId="${autodiscovery}" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="5f1e8e4a-b867-4e4c-bbb1-a824af2722af" flowRef="gestor-sapi-services-main" />
	<import doc:name="Import" doc:id="c105a22c-4def-4cbe-93b9-f16b98f961a3" file="error-handler.xml" />
