	<import doc:name="Import" doc:id="1f75d458-e773-488b-9600-6aa4ab5512f7" file="audits-sapi-client.xml" />
	<import doc:name="Import" doc:id="95a700c1-92a2-43d0-acfb-4479b9b58716" file="etb-common-lib.xml" />
</mule>
