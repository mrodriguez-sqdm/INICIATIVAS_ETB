        <http:listener-connection host="${http.host}" port="${http.private.port}" />
    </http:listener-config>
    <apikit:config name="gestor-sapi-services-config" api="gestor-sapi-services.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <http:request-config name="HTTP_Request_configuration_inventario_ws" doc:name="HTTP Request configuration" doc:id="58bcaba6-4395-4100-9df2-955d1180b097" basePath="#[p('inventario-ws.basepath')]" responseTimeout="${configurationTimeout.inventario}">
		<http:request-connection host="#[p('inventario-ws.host')]" port="#[p('inventario-ws.port')]" />
	</http:request-config>
	<configuration-properties doc:name="Configuration properties" doc:id="a9a767d7-7ad2-4e7a-8d39-dd7849d6f607" file="${env}-properties.yaml" />
