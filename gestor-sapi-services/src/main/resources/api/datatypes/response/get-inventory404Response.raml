#%RAML 1.0 DataType
type: object
properties:
  System:
    properties:
      correlationID:
        type: string
        example: INC000006148440
      processingServer:
        type: string
        example: Mulesoft
      responseDate: 
        type: datetime
        example: 2021-12-01T01:19:39.436-05:00
  Response:
    properties:
      respuesta:
        type: string
        example: Error de consulta
      codRespuesta:
        type: string
        example: "404"