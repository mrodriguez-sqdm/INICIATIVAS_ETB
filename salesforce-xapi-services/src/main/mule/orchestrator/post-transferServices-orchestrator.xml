---
{
  "documentType": vars.inputPayload.TransferServicesSystemsBody.ClientDocumentTypeNew,
  "documentNumber": vars.inputPayload.TransferServicesSystemsBody.ClientDocumentNumberNew,
  "billingAccountNumber": vars.inputPayload.TransferServicesSystemsBody.SubscriberIdNew,
  "PAM": vars.inputPayload.TransferServicesSystemsBody.NewCycle as String,
  "integrationId": vars.inputPayload.TransferServicesSystemsBody.ExtServiceId,
  "msisdn": vars.inputPayload.TransferServicesSystemsBody.SubscriberNumber
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<ee:transform doc:name="Prepare jsc output" doc:id="8bc638a8-7297-4dbb-b687-84c5f941cd79">
					<ee:message />
					<ee:variables>
						<ee:set-variable variableName="jscOutput"><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<try doc:name="Try" doc:id="600756a5-a887-4b62-ba1c-0eab97231c7c" >
					<flow-ref doc:name="Go to JSC" doc:id="4ff45b94-e160-4312-b9fe-2c78e175f285" name="cambioSuscriptorLTECorp-clientSub_Flow" />
					<error-handler >
