						</on-error-continue>
					</error-handler>
				</try>
			</when>
			<otherwise >
				<set-variable value="#[null]" doc:name="JSC not processed" doc:id="935945e5-6396-4243-be5c-cbcd58cf57ee" variableName="jscOutput" />
			</otherwise>
		</choice>
		<ee:transform doc:name="Prepare output" doc:id="0ce7fba3-578a-4174-a0a1-1daae451b832">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
if ((vars.revchainOutput == null) and (vars.mdmOutput == null) and (vars.jscOutput == null))
{
	"ResponseData": {
	  "TransferServiceRVCResponse": {
            "Code": "-1",
            "Description": "Nada que ejecutar"
        },
        "TransferServiceMDMResponse": {
            "codigo": "-1",
            "descripcion": "Nada que ejecutar"
        },
        "TransferServiceJSCResponse": {
            "code": "-1",
            "description": "Nada que ejecutar"
        }
    }
}
else
{
    "ResponseData": (vars.revchainOutput default {}) ++ 
    (if(vars.mdmOutput != null) {
        "TransferServiceMDMResponse": vars.mdmOutput
    } else {}) ++ 
    (if(vars.jscOutput != null) {
        "TransferServiceJSCResponse": vars.jscOutput default {}
    } else {})
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
