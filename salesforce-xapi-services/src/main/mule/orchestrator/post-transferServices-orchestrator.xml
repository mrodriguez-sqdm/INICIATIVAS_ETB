				<ee:transform doc:name="Prepare input" doc:id="b1451f60-4a84-46d5-8d58-136412cb5f8a">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
var actualDate = now() as Date
---
{
  "wsInvokeServiceProvisioningIN": {
    "services": {
      "service_particulars": [
        {
          "subscriber_id": vars.inputPayload.TransferServicesSystemsBody.SubscriberId,
          "service": [
            {
              "action": "transfer", //property
              "finder": {
                "external_service_id": vars.inputPayload.TransferServicesSystemsBody.ExtServiceId, 
                "active_date": {
                  "month": actualDate.month as String, 
                  "day": actualDate.day as String,
                  "year": actualDate.year as String
                }
              },
              "service_transfer": {
                "transfer_type": "0", //property
                "transfer_to_subscriber": vars.inputPayload.TransferServicesSystemsBody.SubscriberIdNew,
                "transfer_date": {
                  "month": actualDate.month as String, 
                  "day": actualDate.day as String,
                  "year": actualDate.year as String
                }
              }
            }
          ]
        }
      ]
    }
  }
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<flow-ref doc:name="Go to Revchain" doc:id="a6927a5b-06f4-4d92-a1cd-991881de5d1d" name="revchain-sapi-clientSub_Flow" />
				<ee:transform doc:name="Prepare revchain output" doc:id="738c040f-38e7-49c2-bc0f-e87c9a1ef2cc" >
					<ee:message >
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="revchainOutput" ><![CDATA[%dw 2.0
output application/json
---
{
      "TransferServiceRVCResponse": {
      	  "Code": "0",
      	  "Description": "Success",
          "response": {
              "operation": payload.InvokeServiceProvisioningOutput.BodyResponse.response.operation,
              "system": "Mulesoft",
              "result": payload.InvokeServiceProvisioningOutput.BodyResponse.response.result,
              "faults": [
              	{
                  "subscriber_id": vars.inputPayload.TransferServicesSystemsBody.SubscriberId,
                  "fault_detail": {
                      "error_description": "success",
                      "error_code": "0"
                  }
              	}
              ]
          }
      }
}]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise >
				<set-variable value="#[null]" doc:name="Revchain not processed" doc:id="499c7141-8137-48b3-8e35-dc8fb7cc4bea" variableName="revchainOutput"/>
