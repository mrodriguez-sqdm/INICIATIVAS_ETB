    <flow name="salesforce-xapi-services-main">
        <http:listener path="/salesforce/*" config-ref="salesforce-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <try doc:name="Try" doc:id="f0b8906e-261d-443c-97bf-de65451fd0ac">
			<flow-ref doc:name="Call initial Logger" doc:id="54d0df19-f9a8-42b9-b6ed-eff9f415afee" name="initial-loggin-Sub_Flow" />
			<error-handler>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="1a613b1d-6e78-40b4-b113-559b7af6dbb3">
					<logger level="INFO" doc:name="Logger" doc:id="734a9b4b-1da8-4d00-95e1-b9b482e20233" message="#[error]" category="error_loggin" />
				</on-error-continue>
			</error-handler>
		</try>
        <apikit:router config-ref="salesforce-xapi-services-config" />
        <try doc:name="Try" doc:id="6f2104a4-c492-4d5e-94c6-3b9b9f0c989e">
				<async doc:name="Async" doc:id="9d0e4206-3a2c-4f30-8c69-f56f5f34df5c">
					<flow-ref doc:name="Call logger" doc:id="13f95c8c-73e5-482b-895f-87e5f23d4fbe" name="loggin-client-call" />
				</async>
				<error-handler>
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="e8ad9ffb-a8d0-4b2e-98f9-5010b6bb88fe">
						<logger level="INFO" doc:name="Logger" doc:id="94b5131a-51c1-4296-938f-a62947327462" message="#[error]" category="error_loggin" />
					</on-error-continue>
				</error-handler>
			</try>
		<error-handler ref="error-handlerError_Handler" />
    </flow>
    <flow name="salesforce-xapi-services-console">
        <http:listener path="/console/*" config-ref="salesforce-xapi-services-httpListenerConfig">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="salesforce-xapi-services-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
