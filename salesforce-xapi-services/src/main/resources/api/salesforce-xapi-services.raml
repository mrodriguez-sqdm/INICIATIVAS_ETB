#%RAML 1.0
title: salesforce-xapi-services
version: "1"
protocols:
  - HTTPS
mediaType: 
- application/json
baseUri: salesforce-xapi-services-{env}.us-e2.cloudhub.io/salesforce/
#description: This API has an interface for the operations that come from Salesforce
#baseUri: https://fulfillment-salesforce-xapi-services-dev.us-e2.cloudhub.io/fulfillment

uses:
  productOrder-lib: libraries/productOrder-library.raml
  createEnterpriseIncident-lib: libraries/createEnterpriseIncident-lib.raml

traits: 
  tibcoHeaders: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.4/tibcorequestheaders.raml
  consultTasksParameters: !include traits/consultTaskArrayParams.raml


securitySchemes:
  etb_oauth_2_0: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml


/operations:
  /v1:
    /migrated:
      /{connectionNumber}:
        get:
          securedBy: [etb_oauth_2_0] 
          displayName: Validate if a line is migrated.
          description:  This method validate if a line is migrated according to MDM_SERVICIO_ACTIVO.
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/migrated.raml
            404:
              body:
                application/json:
                  example: !include examples/response/migratedNotFound.json
    /incident:
      /{incidence_id}:
        patch:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0] 
          displayName: Update enterprise incident status.
          description:  This method update the enterprise incident status into Salesforce.
          body:
            application/json:
              type: !include datatypes/request/updateEntIncidentStatus.raml
              example:
                !include examples/request/updateEntIncidentStatusRequest.raml
          responses:
            200:
              body:
                application/json:
                  example: !include examples/response/updateEntIncidentStatusResponse.raml
    /productOrder:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0] 
          displayName: Register data from Salesforce applications
          description: Service to register data from saleforce applications
          body:
            type: 
              productOrder-lib.productOrder
            example: 
              !include examples/request/productOrderRequest.json
          responses:
            201:
              body:
                type:
                  !include datatypes/response/productOrderResponse.raml
                  
    /provisioning:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Register provisioning response.
        description: This method registers provisioning responses.
        body:
          application/json:
            type: !include datatypes/request/provisioningRequestTypes.raml
            example: !include examples/request/provisioningRequestExample.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/provisioningResponseTypes.raml
                example: !include examples/response/provisioningResponseExample.json
      /user:
        post:
          securedBy: [etb_oauth_2_0]
          is: [tibcoHeaders]
          displayName: User registration.
          description: user registration in Fractalia.
          body:
            application/json:
              type: !include datatypes/request/post-userKey-Fractalia.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/post-userKey-Fractalia.raml

    /viability:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Register viability response.
        description: This method registers viability responses.
        body:
          application/json:
            type: !include datatypes/request/viabilityRequestTypes.raml
            example: !include examples/request/viabilityRequestExample.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/viabilityResponseTypes.raml
                example: !include examples/response/viabilityResponseExample.json
    /scoring:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Solicitud Scoring
        description: Solicitud Scoring
        body:
          application/json:
              type: !include datatypes/request/scoringRequest.raml
              example: !include examples/request/scoringRequest.json
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/scoringResponse.raml
                example: !include examples/response/scoringResponse.json
    /remedy:
      /schedule:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0]
          displayName: Create Remedy Schedule
          description: Create Remedy Schedule
          body:
            application/json:
              type: !include datatypes/request/createScheduleRemedy.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/createScheduleRemedy.raml
    /negativeRecord:
      post:
        displayName: "Insert Negative Record"
        description: "Inserts client negative record"
        securedBy: [etb_oauth_2_0]
        is: [tibcoHeaders]
        body:
          application/json:
            type: !include datatypes/request/insertNegativeRecord.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/insertNegativeRecord.raml
    /fraudQuery:
      post:
        is: [tibcoHeaders]
        displayName: FraudQuery
        description: Consulta fraude
        body:
          application/json:
            type: !include datatypes/request/fraudQuery.raml
        responses:
          200:
            body:
              application/json:
                example: !include examples/response/fraudQuery.json

/billing:
  /v1:
    /billing_accounts:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Create Billing Accounts
        description: This process creates accounts in the systems of Revchain, RMCA and MDM
        body:
          application/json:
            type: !include /datatypes/request/postBillingAccounts.raml
        responses:
          201:
            body:
              application/json:
                type: !include /datatypes/response/postBillingAccounts.raml
      patch:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Update Billing Accounts
        description: This process update accounts in the systems of Revchain, RMCA and MDM
        body:
          application/json:
            type: !include datatypes/request/patch-updateAccountData.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/patch-updateAccountDataResponse.raml
    /billings:
      /{connection-number}:  
        /details:
          uriParameters:
            connection-number:
              example: "6012482773"
          get:
            is:
              - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            displayName: Connection Number
            description: Obtain service particulars from a connection number loaded into Salesforce
            responses:
              200:
                body:
                  application/json:
                    type: !include /datatypes/response/connectionNumberResponse.raml
                    example: !include /examples/response/connectionNumber200.raml
              404:
                body:
                  application/json:
                    type: !include /datatypes/response/connectionNumberResponse.raml
                    example: !include /examples/response/connectionNumber404.raml
              500:
                body:
                    type: !include /datatypes/response/ErrorResponseDataType.raml
                    example: !include /examples/response/connectionNumber500Response.raml
    /provisioning:
      /services:
        post:
          is: 
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Invoke Service Provisioning
          description: Invoke Service Provisioning
          body:
            application/json:
              type: !include datatypes/request/invokeServiceProvisioningType.raml
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/invokeServiceProvisioningResponse201.raml
                  example: !include examples/response/invokeServiceProvisioningExample201.json
            500:
              body:
                application/json:
                  type: !include datatypes/response/invokeServiceProvisioningResponse500.raml
                  example: !include examples/response/invokeServiceProvisioningExample500.json
    /numberAndPrice:
      patch:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Update Connection Number and Price
        description: Endpoint to update connectionNumber and price
        body:
          application/json:
            type: !include /datatypes/request/patchNumberAndPrice.raml
        responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/patchNumberAndPrice.raml
    /billingAdjustment:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Cobro Retiro Anticipado
        description: Registrar monto a cobrar al cliente por concepto de retiro anticipado.
        body:
          application/json:
            type: !include datatypes/request/postBillingAdjustment.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/postBillingAdjustment.raml
    /transferServices:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Transfer Services Systems
        description: Operacion para transferir el servicio.
        body:
          application/json:
            type: !include datatypes/request/transferService.raml
        responses:
          200:
            body:
              application/json:
                example: !include examples/response/transferService.json
          400:
            body:
              application/json:
                example: !include examples/response/transferServicesError400.json
          404:
            body:
              application/json:
                example: !include examples/response/transferServicesError404.json
          500:
            body:
              application/json:
                example: !include examples/response/transferServicesError500.json
/fulfillment:
  /v1:
    /incident:
      /enterprise:
        post:
          is: [tibcoHeaders]
          securedBy: [etb_oauth_2_0] 
          displayName: Create enterprise incident register into Remedy systems
          description: Based on input information, the method creates a register about an incident faced by a enterprise
          body:
            application/json:
              type: createEnterpriseIncident-lib.WSCreateEnterpriseIncidentIN
              example:
                !include examples/request/createEnterpriseIncidentRequest.raml
          responses:
            201:
              body:
                application/json:
                  example: !include examples/response/createEnterpriseIncidentResponse.json
      /{incidence_id}:
        /tasks:
          post:
            is:
              - tibcoHeaders
            securedBy: [etb_oauth_2_0] 
            displayName: Create a task related to an incident.
            description: This method creates a new task related to an incident.
            body:
              application/json:
                type: !include datatypes/request/createNewTaskType.raml
            responses:
              201:
                body:
                  application/json:
                    type: !include datatypes/response/createNewTaskResponse.raml
                    example: !include examples/response/createNewTask201ResponseExample.raml
              500:
                body:
                  application/json:
                    type: !include datatypes/response/ErrorResponseDataType.raml
                    example: !include examples/response/createNewTask500ResponseExample.raml
          get:
            is:
              - tibcoHeaders
              - consultTasksParameters
            securedBy: [etb_oauth_2_0] 
            displayName: Get tasks related to an incident
            description: This method gets tasks related to an incident.
            responses:
              200:
                body:
                  application/json:
                    type: !include datatypes/response/consultTaskArrayResponse.raml
                    example: !include examples/response/consultTaskArray200ResponseExample.raml
              500:
                body:
                  application/json:
                    type: !include datatypes/response/ErrorResponseDataType.raml
                    example: !include examples/response/consultTaskArray500ResponseExample.raml
      /note:
          post:
            is:
              - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            displayName: CreateIndicentNote
            description: This method create notes in PQRs 
            body:
              application/json:
                type: !include datatypes/request/post-createIncidentNote.raml
            responses:
              201:
                body:
                  application/json:
                    type: !include datatypes/response/createIncidentNoteStatus201ResponseExample.raml
              500:
                body:
                  application/json:
                    type: !include datatypes/response/createIncidentNoteStatus500ResponseExample.raml
    /tramits:
      /newQuery:
        post:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0] 
          displayName: Query tramits to siebel
          description: Service to send query tramits to siebel
          headers:
            sourceSystem:
              type: string
              example: "Siebel_NPLAY"
              required: true
              minLength: 1
            checkOrderHistory:
              type: boolean
              example: false
          body:
            application/json:
              type: !include datatypes/request/queryTramitsRequest.raml
              example: !include examples/request/tramitsRequest.json            
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/queryTramitsResponse.raml
                  example: !include examples/response/tramitsResponse.json
    /enterprise:
      /request:
        post:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Create requirements into Remedy.
          description: This method creates requirements (task and work orders) into Remedy.
          body:
            application/json:
              type: !include datatypes/request/createEnterpriseRequestType.raml
                
          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/createEnterpriseRequestResponseType.raml
                  example: !include examples/response/createEnterpriseRequest201Example.raml
            500:
              body:
                application/json:
                  type: !include datatypes/response/ErrorResponseDataType.raml
                  example: !include examples/response/createEnterpriseRequest500Example.raml
    /availabilityQueryOrder:
      post:
        is: [tibcoHeaders]
        securedBy: [etb_oauth_2_0]
        displayName: Availability query order
        description: Availability query order
        body:
          application/json:
              type: !include datatypes/request/availabilityQueryOrderType.raml
        responses:
          201:
            body:
              application/json:
                type: !include datatypes/response/availabilityQueryOrderResponse.raml
                example: !include examples/response/availabilityQueryOrder201ResponseExample.json
          500:
            body:
              application/json:
                example: !include examples/response/availabilityQueryOrder500ResponseExample.json
    /request:
      /note:
        post:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: CreateRequestNote
          description: This method creates request notes. 
          body:
            application/json:
              type: !include datatypes/request/createRequestNoteType.raml

          responses:
            201:
              body:
                application/json:
                  type: !include datatypes/response/createRequestNoteResponseType.raml
                  example: !include examples/response/createRequestNote201ResponseExample.raml
            500:
              body:
                application/json:
                  type: !include datatypes/response/createRequestNoteResponseType.raml
                  example: !include examples/response/createRequestNote500ResponseExample.raml
                  
/v1:
  /provisioningLTECorp:
    post:
      displayName: Provisioning Lte Corp
      description: Provisioning Lte Corp
      securedBy: [etb_oauth_2_0]
      is: [tibcoHeaders]
      body:
        application/json:
          type: !include datatypes/request/post-provisioningLTECorp.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/response/post-provisioningLTECorp.raml
  /serviceManagement:
    post:
      displayName: "Adición APN privado a línea LTE Corporativo"
      description: "Adición APN privado a línea LTE Corporativo"
      securedBy: [etb_oauth_2_0]
      is: [tibcoHeaders]
      body:
        application/json:
          type: !include datatypes/request/post-serviceManagement.raml
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/post-serviceManagement.raml
  /delivery:
    post:
      displayName: "Salesforce Delivery"
      description: "Unico servicio para ejecutar los tramites de Corporativo"
      securedBy: [etb_oauth_2_0]
      is: [tibcoHeaders]
      body:
        application/json:
          type: !include datatypes/request/post-delivery.raml
          example: !include examples/request/post-delivery.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/post-delivery.raml