#%RAML 1.0 DataType
type: array
items:
  type: object
  properties:
    Service:
      type: object
      properties:
        connectionNumber:
          type: number
          example: 16509229
        documentType:
          type: string
          example: "NIT"
        documentId:
          type: number
          example: 900150412
        activationDate:
          type: string
          example: "02/09/2021"
        tramit:
          type: string
          example: "Cancelacion Voluntaria"
    Order:
      type: object
      properties:
        id:
          type: string
          example: "1"
        code:
          type: string
          example: "1"
        startDate:
          type: string
          example: "02/09/2021"
    WorkPlan:
      type: object
      properties:
        code:
          type: string
          example: "1"
        description:
          type: string
          example: ""
    Action:
      type: object
      properties:
        code:
          type: string
          example: "1"
        description:
          type: string
          example: "Inactivar Entrantes y Salientes"
    Resultado:
      type: object
      properties:
        status:
          type: string
          example: "PASS"
        code:
          type: string
          example: "SUCCESS"
        description:
          type: string
          example: " SUCCESS"
            