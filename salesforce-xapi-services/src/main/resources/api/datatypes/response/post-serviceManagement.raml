#%RAML 1.0 DataType
properties:
  code:
    description: "Código del resultado de la transacción. Si la ejecución fue exitosa, retornar el código: 0. Si la ejecución no fue exitosa, retornar el código: 1."
    type: string
    example: "0"
  description:
    description: "Resultado del procesamiento de la solicitud.Si la ejecución fue exitosa, retornar: 'Procesamiento exitoso'. Si la ejecución no fue exitosa, retornar la descripción del error generado en el procesamiento."
    type: string
    example: "Procesamiento exitoso"