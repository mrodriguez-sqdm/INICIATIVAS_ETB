#%RAML 1.0 DataType
properties:
  codigo_respuesta:
    type: string
    required: true
    description: "0: Proceso ejecutado correctamente. 1: Proceso ejecutado con error."
    example: "0"
  descripcion_respuesta:
    type: string
    required: true
    description: "Descripción del error generado en el proceso."
    example: "Descripcion respuesta"