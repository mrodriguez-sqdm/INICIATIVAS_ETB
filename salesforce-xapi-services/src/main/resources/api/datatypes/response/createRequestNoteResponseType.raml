#%RAML 1.0 DataType
type: object
properties:
  createRequestNoteOut:
    type: object
    required: true
    properties: 
      status:
        type: string
        description: "Describes the result of creating a request note."
        required: true
        minLength: 1
      workLogId:
        type: string
        description: "Returns the Id assigned to the request note."
        required: false
        minLength: 1
      description:
        type: string
        description: "Detail of the transaction."
        required: false
        minLength: 1