#%RAML 1.0 DataType
properties:
  CreateScheduleRemedyOutput:
    type: object
    properties:
      WSResponseHeader2:
        type: object
        properties:
          System:
            type: object
            properties:
              name:
                type: string
                required: false
              correlationID:
                type: string
                required: false
              processingServer:
                type: string
                required: false
          Service:
            type: object
            properties:
              status:
                type: string
                required: false
              responseDate:
                type: string
                required: false
      response:
        type: object
        properties:
          CreacionAgendaRemedyResponse:
            type: object
            properties:
              Resultado:
                type: object
                properties:
                  Encabezado:
                    type: object
                    required: false
                    properties:
                      Propiedades:
                        type: array
                        required: false
                        items:
                          type: object
                          properties:
                            Nombre:
                              type: string
                              required: false
                            Valor:
                              type: string
                              required: false
                      Servicio:
                        type: object
                        required: false
                        properties:
                          Codigo:
                            type: string
                            required: false
                          DetalleEstado:
                            type: string
                            required: false
                          Estado:
                            type: string
                            required: false
                          FechaRespuesta:
                            type: string
                            required: false
                      Sistema:
                        type: object
                        required: false
                        properties:
                          IdCorrelacion:
                            type: string
                            required: false
                          Nombre:
                            type: string
                            required: false
                          Servidor:
                            type: string
                            required: false
                  CedulasTecnicos:
                    type: string
                    required: false
                  Estado:
                    type: string
                    required: false
                  EstadoProcesadoAgendamiento:
                    type: string
                    required: false
                  FechaHoraAgendaConfirmada:
                    type: string
                    required: false
                  GrupoAsignado:
                    type: string
                    required: false
                  IdAgenda:
                    type: string
                    required: false
                  IdTareaCreadaRemedy:
                    type: string
                    required: false
                  SoportesIngreso:
                    type: string
                    required: false
                  SubEstado:
                    type: string
                    required: false
                  TecnicosAsignados:
                    type: string
                    required: false
                  TipoSolicitud:
                    type: string
                    required: false 