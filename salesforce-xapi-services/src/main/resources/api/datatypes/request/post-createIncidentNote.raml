#%RAML 1.0 DataType
properties:
  status?:
    type: string
    example: "Proposed"
  origen?:
    type: string
    example: "Portafolio"
  description?:
    type: string
    example: "Nota Salesforce"
  detailDescription?:
    type: string
    example: "Hdp. Victor Bracho. Se realiza llamada al Sr Delford Brackman, Cel 3153665856, pero no contesta las llamadas y no fue posible dejarle nota de voz"
  submitDate?:
    type: string
    example: "2022-01-04T17:19:40-05:00"
  incidentNumber?:
    type: string
    example: "INC000006234698"
  workLogType?:
    type: string
    example: "Seguimiento"
  viewAccess?:
    type: string
    example: "Public"
  secureWorkLog?:
     type: string
     example: "No"