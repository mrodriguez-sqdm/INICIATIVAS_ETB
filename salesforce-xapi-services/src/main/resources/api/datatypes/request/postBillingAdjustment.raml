#%RAML 1.0 DataType
properties:
  cod_fact:
    type: string
    required: true
    example: "cod_fact"
  sub_id:
    type: number
    required: true
    example: 1234
  amt:
    type: number
    required: true
    example: 123.2340
  trans_desc:
    type: string
    required: true
    example: "trans_desc"
  trans_dttm:
    type: string
    required: true
    description: format (dd-mm-yyyy)
    example: "20-01-2024"