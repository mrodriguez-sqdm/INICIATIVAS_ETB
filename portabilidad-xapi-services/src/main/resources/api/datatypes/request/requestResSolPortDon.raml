#%RAML 1.0 DataType
type: object
properties:
  RequestResSolPortDon:
    type: object
    required: true
    properties:
      CabeceraMensaje:
        type: object
        required: true
        properties:
          IdentificadorProceso:
            type: string
            required: true
            example: "123450000000054321"
          FechaCreacionMsg:
            type: string
            required: true
            example: "20240203000000"
          TipoMsg:
            type: string
            required: true
            example: "1003"
          Emisor:
            type: string
            required: true
            example: "00007"
          Observaciones:
            type: string | nil
            required: false
            example: "" 
      CuerpoMensaje:
        type: object
        required: true
        properties:
          RespuestaSolicitudPortacionDonante:
            type: object
            required: true
            properties:
              RespuestaABD:
                type: string
                required: true
                example: "0"
              ListaNumeracionRechazada:
                type: object
                required: false
                properties:
                  NumeracionRechazada:
                    type: array
                    required: false
                    items:
                      type: object
                      properties:
                        Numero:
                          type: string
                          required: true
                          example: "3114267"
                        CodigosRechazo:
                          type: object
                          properties:
                            CodigoRechazo:
                              type: string[]
                              required: true
                        DocumentoFC:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-FC.pdf"
                        DocumentoDC:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-DC.pdf" 
                        DocumentoFR:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-FR.pdf"
                        DocumentoUO:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-UO.pdf"
                        DocumentoLD:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-LD.pdf"
                        DocumentoLS:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-LS.pdf"
                        DocumentoNA:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-NA.pdf"
                        DocumentoNI:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-NI.pdf"
                        DocumentoLA:
                          type: string
                          required: false
                          example: "OOOOOYYYYMMDDNNNNN-LA.pdf"   