<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="patch-update-master-data-orchestratorSub_Flow" doc:id="38ff4f3c-7721-4f70-bcf2-498194e67e2e" >
		<ee:transform doc:name="Json to XML" doc:id="80ed2483-7c91-415c-8ae7-2d966910bfc6" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
ns soapenv http://schemas.xmlsoap.org/soap/envelope/
ns urn urn:sap-com:document:sap:rfc:functions
---
{
    soapenv#Envelope:{
        soapenv#Header: {},
        soapenv#Body: {
            urn#ZRFC_BP_UPDATE_DATA: payload.ZRFC_BP_UPDATE_DATA
        }
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="patch-update-master-data" doc:id="357b968e-6267-4900-8f47-69a66c131201" name="patch-update-master-data"/>
		<ee:transform doc:name="XML to JSON" doc:id="87c5fb30-3ca2-4964-98af-75c2fd78ef8e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	ZRFC_BP_UPDATE_DATAResponse:
	{
	    Item: payload.Envelope.Body.ZRFC_BP_UPDATE_DATAResponse.RETURN pluck ($) 
	}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
