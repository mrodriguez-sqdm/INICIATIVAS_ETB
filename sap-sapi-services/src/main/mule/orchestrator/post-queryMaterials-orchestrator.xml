<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-queryMaterials-orchestratorSub_Flow" doc:id="6d668aad-57ce-4dc3-9cff-841d0ba3214e" >
		<ee:transform doc:name="Prepare request" doc:id="ccb3f336-4399-43d2-9075-9198f88b7a05" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
ns soapenv http://schemas.xmlsoap.org/soap/envelope/
ns urn urn:sap-com:document:sap:soap:functions:mc-style
---
soapenv#Envelope: {
    soapenv#Header: null,
    soapenv#Body: {
        urn#ZmmPorsupWs: {
            PMaterial: payload.QueryMaterialsInput.ZmmPorsupWs.PMaterial,
            TsMateriales: payload.QueryMaterialsInput.ZmmPorsupWs.TsMateriales
        }
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Go to Client" doc:id="73b6f80f-4dbb-4932-8c0e-3ff24e0a32a5" name="post-queryMaterialsClient"/>
		<ee:transform doc:name="Prepare output" doc:id="b0967203-198f-4eec-8a34-fa4f240e739f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "QueryMaterialsOutput": {
        "ResponseHeader": {
            "System": {
                "name": vars.name,
                "correlationId": vars.correlation_id,
                "processingServer": "MULESOFT"
            },
            "Service": {
                "status": "PASS",
                "responseDate": now() >> "America/Bogota"
            }
        },
        "BodyResponse": {
        "ZmmPorsupWsResponse": {
            "Return": payload.Envelope.Body.ZmmPorsupWsResponse.Return,
            "TsMateriales": payload.Envelope.Body.ZmmPorsupWsResponse.TsMateriales.*item
        }
    }
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
