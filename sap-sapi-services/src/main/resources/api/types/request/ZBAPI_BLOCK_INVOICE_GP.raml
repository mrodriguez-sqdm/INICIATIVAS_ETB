                  type: string
                  required: true
                MESSAGE_V1:
                  type: string
                  required: true
                MESSAGE_V2:
                  type: string
                  required: true
                MESSAGE_V3:
                  type: string
                  required: true
                MESSAGE_V4:
                  type: string
                  required: true
                PARAMETER:
                  type: string
                  required: true
