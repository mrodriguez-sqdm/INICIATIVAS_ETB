#%RAML 1.0
title: sap-sapi-services

mediaType:
  - application/xml
version: "1"
protocols:
  - HTTP
baseUri: sap-sapi-services-dev.us-e2.cloudhub.io/sap/
description: The present API has an interface for the SAP CRUD operations 

traits:
  security_client_id: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/security-clientid/1.0.2/security-clientid.raml
  request_headers: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.5/tibcorequestheaders.raml
uses:
  definitions: types/library.raml
 
/v1:
  /materials:
    put:
      is: [security_client_id,request_headers]
      body:
        application/json:
          type: !include datatypes/request/updateMaterials.raml
      responses:
        201:
          body:
            application/json:
              example: !include examples/response/update_materials.json
            
  /rfc:
    /create_master_data:
      post:
        is: [security_client_id,request_headers]
        body:
          application/xml:
            example: !include examples/request/Z_RM_RFC_CREATE_MASTER_DATA.xml
            type: definitions.Z_RM_RFC_CREATE_MASTER_DATA
        responses:
          201:
            body:
              application/json:
                example: !include examples/response/Z_RM_RFC_CREATE_MASTER_DATA_Response.json
                type: definitions.Z_RM_RFC_CREATE_MASTER_DATA_Response
    /solfact_getdata:
      post:
        is: [security_client_id, request_headers]
        displayName: ZBAPI_SOLFACT_GETDATA_GP
        description: Consulta de facturas y datos del acreedor
        body:
          application/xml:
            type: definitions.ZBAPI_SOLFACT_GETDATA_GP
        responses:
          201:
            body:
              application/json:
                type: definitions.ZBAPI_SOLFACT_GETDATA_GPResponse
                example: !include examples/response/ZBAPI_SOLFACT_GETDATA_GPResponse.json
                  
    /solfact_checkdata:
      post:
        is: [security_client_id, request_headers]
        displayName: ZBAPI_SOLFACT_CHECKDATA_GP
        description: Consulta de Integridad y Consistencia de la información con valor en MD5
        body:
          application/xml:
            type: definitions.ZBAPI_SOLFACT_CHECKDATA_GP
        responses:
          201:
            body:
              application/json:
                type: definitions.ZBAPI_SOLFACT_CHECKDATA_GPResponse
                example: !include examples/response/ZBAPI_SOLFACT_CHECKDATA_GPResponse.json
          
    /block_invoice:
      post:
          is: [security_client_id, request_headers]
          displayName: ZBAPI_BLOCK_INVOICE_GP
          description: Bloqueo de Facturas que están en Affirmatum para ser negociadas
          body:
            application/xml:
              type: definitions.ZBAPI_BLOCK_INVOICE_GP
          responses:
            201:
              body:
                application/json:
                  type: definitions.ZBAPI_BLOCK_INVOICE_GPResponse
                  example: !include examples/response/ZBAPI_BLOCK_INVOICE_GPResponse.json
                
    /change_invoice:
      post:
        is: [security_client_id, request_headers]
        displayName: ZBAPI_CHANGE_INVOICE_GP
        description: Cambio de Acreedor de factura, condiciones de pago y compensación en ERP
        body:
          application/xml:
            type: definitions.ZBAPI_CHANGE_INVOICE_GP
        responses:                          
          201:
            body:
              application/json:
                type: definitions.ZBAPI_CHANGE_INVOICE_GPResponse
                example: !include examples/response/ZBAPI_CHANGE_INVOICE_GPResponse.json
         
    /payment_notif:
      post:
        is: [security_client_id, request_headers]
        displayName: ZBAPI_PAYMENT_NOTIF_GP
        description: Validar si ya se pago la factura negociada al fondeador en la fecha comprometida y libera cupo de negociación.
        body:
          application/xml:
            type: definitions.ZBAPI_PAYMENT_NOTIF_GP
        responses:
          201:
            body:
              application/json:
                type: definitions.ZBAPI_PAYMENT_NOTIF_GPResponse
                example: !include examples/response/ZBAPI_PAYMENT_NOTIF_GPResponse.json                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                        
    /update_master_data:
      patch:
        is: [security_client_id,request_headers]
        body:
          application/json:
            example: !include examples/request/ZRFC_BP_UPDATE_DATA.json
            type: definitions.ZRFC_BP_UPDATE_DATA
        responses:
          201:
            body:
              application/json:
                example: !include examples/response/ZRFC_BP_UPDATE_DATAResponse.json
          
  /health_check:
    get:
      displayName: Health Check
      description: Check the connectivity of calls
      responses:
        200:
          description: Status of legacies and dependencies
          body:
            application/json:
              type: !include types/response/healthcheckobjectresponse.raml
              example: !include examples/response/get_healthcheck_response.json
  /bills:
    get:
      is: [security_client_id,request_headers]
      displayName: SAPBills
      description: Get SAP bills
      headers:
        name:
          type: string
          required: true
          example: "ETB.MDM.Payment.Interface"
        X-CORRELATION-ID:
          required: true
          type: string
          example: "20220201060011"
        processingServer:
          required: true
          type: string
          example: "Tibco"
      queryParameters:
        date:
          type: date-only
          example: 2022-08-01
      responses:
        200:
          body:
            application/json:
              type: !include types/response/bills_response.raml
  /queryMaterials:
    post:
      is: [security_client_id,request_headers]
      displayName: Query Materials
      description: Query Materials
      body:
        application/json:
          type: !include datatypes/request/queryMaterials.raml
      responses:
        201:
          body:
            application/json:
              type: !include datatypes/response/queryMaterials.raml
/rmca:
  /v1:
    /process:
      /reconnection:
        patch:
          is:
            - security_client_id
            - request_headers
          displayName: ReconnectionRMCAIntf
          description: ReconnectionRMCAIntf
          body:
            application/json:
              type: !include datatypes/request/reconnectionRMCA-dataType.raml
              example: !include examples/request/reconnectionRMCA-example.raml
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/reconnectionRMCA-200responseDataType.raml
                  example: !include examples/response/reconnectionRMCA-Response200.json
            500:
              body:
                application/json:
                  type: !include datatypes/response/reconnectionRMCA-500responseDataType.raml
                  example: !include examples/response/reconnectionRMCA-Response500.json