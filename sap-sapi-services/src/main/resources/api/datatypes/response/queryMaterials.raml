#%RAML 1.0 DataType
properties:
  QueryMaterialsOutput:
    type: object
    properties:
      ResponseHeader:
        type: object
        required: true
        properties:
          System:
            type: object
            required: true
            properties:
              name:
                type: string
                required: false
              correlationId:
                type: string
                required: false
              processingServer:
                type: string
                required: false
          Service:
            type: object
            required: true
            properties:
              status:
                type: string
                required: false
              responseDate:
                type: string
                required: false
      BodyResponse:
        type: object
        required: true
        properties:
          ZmmPorsupWsResponse:
            type: object
            required: true
            properties:
              Return:
                type: object
                required: true
