                  Type:
                    type: string
                    maxLength: 1
                    required: true
                  Code:
                    type: string
                    maxLength: 3
                    required: true
                  Message:
                    type: string
                    maxLength: 220
                    required: true
              TsMateriales:
                type: array
                required: false
                items:
                  type: object
                  properties:
                    Matnr:
                      type: string
                      maxLength: 18
                      required: true
                    Maktx:
                      type: string
                      maxLength: 40
                      required: true
                    Mfrnr:
                      type: string
                      maxLength: 10
                      required: true
                    Mfrpn:
                      type: string
                      maxLength: 40
                      required: true
                    Meins:
                      type: string
                      maxLength: 3
                      required: true
                    Sernp:
                      type: string
                      maxLength: 4
                      required: true
                    Ersda:
                      type: string
                      maxLength: 10
                      required: true
                    Pstat:
                      type: string
                      maxLength: 15
                      required: true
                    Lvorm:
                      type: string
                      maxLength: 1
                      required: true
                    Mtart:
                      type: string
                      maxLength: 4
                      required: true
                    Mbrsh:
                      type: string
                      maxLength: 1
                      required: true
                    Matkl:
                      type: string
                      maxLength: 9
                      required: true
                    Spart:
                      type: string
                      maxLength: 2
                      required: true
                    Zztipeqp:
                      type: string
                      maxLength: 20
                      required: false
                    Zzmodelo: 
                      type: string
                      maxLength: 30
