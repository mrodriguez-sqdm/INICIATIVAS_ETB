#%RAML 1.0 DataType

properties:
  status: 
    type: integer
  code:
    type: string
  message: 
    type: object
    properties:
      message: 
        type: string
  messageServer:
    type: object
    properties:
      Envelope:
        type: object
        properties:
          Header: 
            type: nil
          Body: 
            type: object
            properties:
              Fault:
                type: object
                properties:
                  faultcode:
                    type: string
                  faultstring:
                    type: string
                  detail:
                    type: nil
  cause:
    type: array
    items:
      properties:
        origin:
          type: string
        message:
          type: string