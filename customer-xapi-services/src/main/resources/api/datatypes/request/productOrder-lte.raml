#%RAML 1.0 DataType 
type: object
properties:
  updatedBy:
    type: string
    example: adricas3
    required: false
  createdBy:
    type: string
    example: adricas3
    required: false
  channel:
    type: string
    example: MDM
    required: false
  subcategory:
    type: string
    example: PORTAL LTE
    required: false
  category:
    type: string
    example: LTE
    required: false
  requestCustomer:
    type: object
    properties:
      documentType:
        type: string
        example: CC
        required: false
      documentNumber:
        type: string
        example: '3180438905'
        required: false
  through:
    type: object
    properties:
      throughType:
        type: string
        example: Venta LTE
        required: false
      throughSubtype:
        type: string
        example: Venta LTE
        required: false
  requestService:
    type: object
    properties:
      productGroupingNumber:
        type: integer
        example: 6365
        required: false
      planType:
        type: string
        example: Prepago
        required: false
  requestBillingAccount:
    type: object
    properties:
      deliveryType:
        type: string
        example: Fisica
        required: false
      billingCycle:
        type: string
        example: ''
        required: false
  featureOrder:
    type: array
    items:
      type: object
      properties:
        feature:
          type: string
          example: ATDP
          required: false
        value:
          type: boolean | string | integer
          example: true
          required: false
  setType:
    type: string
    example: I
    required: false
