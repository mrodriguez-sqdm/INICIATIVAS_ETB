#%RAML 1.0 DataType
type: object
properties:
  token:
    type: string
    required: false
    description: "Token generado en PSE"
  financialInstitutionCode:
    type: string
    maxLength: 9
    required: true
    description: "Codigo entidad financiera"
  entityCode:
    type: string
    maxLength: 13
    required: true
    description: "Codigo o NIT de la empresa registrado en PSE"
  serviceCode:
    type: string
    maxLength: 10
    required: true
    description: "Codigo recaudo o servicio"
  transactionValue:
    type: number
    required: true
    description: "Valor transaccion"
  vatValue: 
    type: number
    required: true
    description: "Valor IVA"
  ticketId:
    type: integer
    required: true
    description: "Numero de factura generado en la empresa"
  entityurl:
    type: string
    maxLength: 512
    required: true
    description: "Redireccionamiento al terminar transaccion"
  userType:
    type: string
    required: true
    enum:
      - person
      - company
  soliciteDate:
    type: string
    maxLength: 30
    required: true
    description: "tipo datetime"
  paymentDescription:
    type: string
    maxLength: 80
    required: true
    description: "descripcion del pago"
  referenceNumber1:
    type: string
    maxLength: 80
    required: true
    description: "Referencia 1 del comercio"
  referenceNumber2:
    type: string
    maxLength: 80
    required: true
    description: "Referencia 1 del comercio"
  referenceNumber3:
    type: string
    maxLength: 80
    required: true
    description: "Referencia 1 del comercio"
  identificationType:
    type: string
    required: true
    enum:
      - RegistroCivilDeNacimiento
      - TarjetaDeIdentidad
      - CedulaDeCiudadania
      - TarjetaDeExtranjeria
      - CedulaDeExtranjeria
      - Pasaporte
      - DocumentoDeIdentificacionExtranjero
      - NIT
  identificationNumber:
    type: string
    maxLength: 15
    required: true
    description: "Numero identificacion cliente"
  fullName:
    type: string
    maxLength: 64
    required: true
    description: "Nombre completo del cliente final"
  cellphoneNumber:
    type: integer
    required: true
    description: "Numero telefono celular"
  address:
    type: string
    maxLength: 64
    required: true
    description: "Direccion"
  email:
    type: string
    maxLength: 120
    required: true
    description: "Correo electronico"
  beneficiaryEntityIdentificationType:
    type: string
    required: true
    enum:
      - CedulaDeCiudadania
      - CedulaDeExtranjeria
      - Pasaporte
      - DocumentoDeIdentificacionExtranjero
      - NIT
      - IdentificacionComercioExtranjero
  beneficiaryEntityIdentification:
    type: string
    maxLength: 15
    required: true
    description: "Numero identificacion comercio final"
  beneficiaryEntityName:
    type: string
    maxLength: 64
    required: true
    description: "Nombre o razon social comercio"
  beneficiaryEntityCIIUCategory:
    type: string
    maxLength: 6
    required: true
    description: "Codigo de actividad economica CIIU"
  beneficiaryIdentificationType:
    type: string
    required: true
    enum:
      - RegistroCivilDeNacimiento
      - TarjetaDeIdentidad
      - CedulaDeCiudadania
      - TarjetaDeExtranjeria
      - CedulaDeExtranjeria
      - Pasaporte
      - DocumentoDeIdentificacionExtranjero
      - NIT
  beneficiaryIdentification:
    type: string
    maxLength: 15
    required: true
    description: "Numero identificacion beneficiario de la compra"
  indicator4per1000:
    type: number
    required: false
    description: "Solo valido los valores 0 (para no) y 1 (para si)"