#%RAML 1.0 DataType
type: object
properties:
  adviser:
    type: string
    required: true
    example: "1"
  document_number:
    type: string
    required: true
    example: "12345678"
  document_type:
    type: integer
    required: true
    example: 1
  date_expedition:
    type: string
    required: true
    example: "2020-01-01T00:00:00"
  surname:
    type: string
    required: true
    example: "PEREZ"
  cellphone:
    type: string
    required: true
    example: "3001234567"
  channel:
    type: integer
    required: true
    example: 1
  provider:
    type: integer
    required: true
    example: 1
  portal:
    type: integer
    required: true
    example: 1