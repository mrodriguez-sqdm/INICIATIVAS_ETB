#%RAML 1.0 DataType
type: object
properties:
  result:
    type: object
    properties:
      id:
        type: integer
        example: 13985
      type:
        type: integer
        example: 1
      questions:
        type: any
        required: false
        example: "null"
      otpCode:
        type: string
        example: "2630"
      matchType:
        type: integer
        example: 1