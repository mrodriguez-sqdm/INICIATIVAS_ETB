	<sub-flow name="patch-pseTransaction-orchestratorSub_Flow" doc:id="036cc042-dd14-4d92-ac89-78ca0bccb1a4" >
		<ee:transform doc:name="Body and var request" doc:id="2c683822-52a5-4d3c-924a-8301ce0f938d" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	entityCode: p('pse.params.entityCode'),
	trazabilityCode: vars.id,
	(entityAuthorizationId: payload.entityAuthorizationId) if (!isBlank(payload.entityAuthorizationId))
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable resource="dwl/pse/requests/put-transaction.dwl" variableName="httpRequest" />
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="encryption-encrypt-sub-flow" doc:id="7a5c0fe8-2bd1-4402-bcee-9946189e2f96" name="encryption-encrypt-sub-flow"/>
