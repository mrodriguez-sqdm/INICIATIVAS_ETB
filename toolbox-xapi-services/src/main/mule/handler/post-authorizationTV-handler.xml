<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-authorizationTV-handlerSub_Flow" doc:id="827550b4-2a4f-4db3-b3d1-417c1be8e638" >
		<set-variable value="#[payload]" doc:name="Set inputPayload" doc:id="761e670e-22db-4fc1-9537-54945f244397" variableName="inputPayload"/>
		<choice doc:name="Choice" doc:id="b5e99d53-f4d0-4488-9a93-09bb987346dc" >
			<when expression='#[vars.inputPayload.action_id == "hasAccessTo"]'>
				<flow-ref doc:name="Go to orchestrator" doc:id="b5aecd66-5fe4-440d-8896-74e585a077d0" name="post-authorizationTV-orchestratorSub_Flow" />
			</when>
			<otherwise >
				<ee:transform doc:name="Error response" doc:id="62a6232a-1b64-412e-ba74-b9a3f6abd264" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 402,
  "code": "NOT_ACCEPTABLE",
  "message": {
    "message": "action_id no tiene un valor correcto"
  },
  "messageServer": "",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
    }
  ]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
402]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
