#%RAML 1.0 ResourceType
get?:
  displayName: List <<resourcePathName | !uppercamelcase>>
  description: List <<resourcePathName | !uppercamelcase>>
  securedBy:
    - gestor-xapi-services.etb_oauth_2_0
  is:
    - gestor-xapi-services.RequestHeaders
    #- gestor-xapi-services.<<resourcePathName | !singularize | !uppercamelcase>>QueryParameters:
  responses:
    200:
      #is:
        #- billing-experience-xapi-services.ResponseHeaders:
      body:
        type: <<resourcePathName | !singularize | !uppercamelcase>>Response[]
post?:
  displayName: Create <<resourcePathName | !singularize | !uppercamelcase>>
  description: Create <<resourcePathName | !singularize | !uppercamelcase>>
  securedBy:
    - gestor-xapi-services.etb_oauth_2_0
  is:
    - gestor-xapi-services.RequestHeaders
  body:
    type: <<resourcePathName | !singularize | !uppercamelcase>>Request
  responses:
    201:
      body:
        type: <<resourcePathName | !singularize | !uppercamelcase>>Response
put?:
  displayName: Update <<resourcePathName | !singularize | !uppercamelcase>>
  description: Update <<resourcePathName | !singularize | !uppercamelcase>>
  securedBy:
    - gestor-xapi-services.etb_oauth_2_0
  is:
    - gestor-xapi-services.RequestHeaders
  body:
    type: <<resourcePathName | !singularize | !uppercamelcase>>Request
  responses:
    201:
      body:
        type: <<resourcePathName | !singularize | !uppercamelcase>>Response