#%RAML 1.0 DataType

properties:
  ordenOM: 
    type: string
    example: 
      "123654789"
  numeroOC: 
    type: string
    example: 
      OC-1331048
  fechaInicioFacturacion: 
    type: string
    example: 
      25/05/2022
  grupoAsignacion: 
    type: string
    example: 
      VALIDACION APV
  idServicio: 
    type: string
    example: 
      IGPON00001759
  responsable: 
    type: string
    example: 
      OC-migualva
  detallesInicioFacturacion:
    type: array
    items:
      type: object
      properties:
        nombre?: 
          type: string 
        valor?: 
          type: string        
  lineas:
    type: array
    items:
      type: object
      properties:
        valor?: 
          type: string    
          example: 
            "601242315"
 
example:
  !include ../../examples/request/post-BillingAccounts.json