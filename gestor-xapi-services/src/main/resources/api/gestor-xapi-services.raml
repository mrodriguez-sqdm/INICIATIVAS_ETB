#%RAML 1.0
title: gestor-xapi-services
protocols:
  - HTTPS
mediaType: 
- application/json
- application/xml

baseUri: https://gestor-xapi-services-{env}.us-e2.cloudhub.io/

securitySchemes:
  etb_oauth_2_0: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

traits:
  request_headers: !include exchange_modules/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.4/tibcorequestheaders.raml

uses:
  gestor-xapi-services: libraries/gestor-xapi-services-library.raml
  processViability-lib: libraries/processViability-library.raml
  updateViability-lib: libraries/updateViability-library.raml
  provisioning-lib: libraries/provisioning-library.raml
  syncProduct-lib: libraries/syncProduct-library.raml

/billing:
  /v1:
    /services:
      /revchain:
        post:
        type: gestor-xapi-services.collection
        description: This process creates service billing notification
    /billing_accounts:
      post:
      type: gestor-xapi-services.collection
      description: This process creates accounts in the systems of Revchain, RMCA and MDM.


/v1:  
  /viability:        
    post:
      securedBy: [etb_oauth_2_0] 
      displayName: Process a viability response.
      description: Service to process response from saleforce applications.
      body:
        application/json:
          type: processViability-lib.processViability
      responses:
        201:
          body:
            type: !include dataTypes/response/processViabilityResponse.raml
    patch:
      securedBy: [etb_oauth_2_0] 
      displayName: Service to update viability data from manager to salesforce.
      description: Service to update viability data from manager to salesforce.
      body:
        application/json:
          type:  updateViability-lib.updateViability
          example: !include examples/request/updateViability.json
      responses:
        200:
          body:
            type: !include dataTypes/response/updateRequestResponse.raml
            example: !include examples/response/updateRequestResponse.json

  /provisioning:
    post:
      securedBy: [etb_oauth_2_0] 
      displayName: Provisioning response process.
      description: Service to process provisioning response, consult and update OM order.
      body:
        application/json:
          type: provisioning-lib.provisioningPost
          example: !include examples/request/provisioningPost.json
      responses:
        200:
          body:
            type: !include dataTypes/response/provisioningResponse.raml
            example: !include examples/response/provisioningResponse.json
    patch:
      securedBy: [etb_oauth_2_0] 
      displayName: Service to update provisioning data from manager.
      description: Service to process a request of provisioning from manager to salesforce.
      body:
        application/json:
          type: provisioning-lib.provisioning
          example: !include examples/request/provisioning.json
      responses:
        200:
          body:
            type: !include dataTypes/response/updateRequestResponse.raml
            example: !include examples/response/updateRequestResponse.json

  /syncProduct:
    patch:
      securedBy: [etb_oauth_2_0] 
      displayName: Process a list of assets from manager to be updated in salesforce.
      description: Service to update assets received from manager to salesforce.
      body:
        application/json:
          type: syncProduct-lib.syncProduct
          example: !include examples/request/syncProduct.json
      responses:
        200:
          body:
            type: !include dataTypes/response/updateRequestResponse.raml
            example: !include examples/response/updateRequestResponse.json
  /queryMaterials:
    post:
      securedBy: [etb_oauth_2_0]
      is: [request_headers]
      displayName: Query Materials
      description: Query Materials
      body:
        application/json:
          type: !include dataTypes/request/queryMaterials.raml
      responses:
        201:
          body:
            application/json:
              type: !include dataTypes/response/queryMaterials.raml