		<flow-ref doc:name="Go to handler" doc:id="0fcbf47c-01ea-42bf-b75b-a686da8e4869" name="patch-updateProvisioning-handlerSub_Flow"/>
	</flow>
	<flow name="patch:\v1\syncProduct:application\json:gestor-xapi-services-config" doc:id="2618b757-dc9d-46e0-9fd4-9ea2a1bea158" >
		<flow-ref doc:name="Go to handler" doc:id="d4fc7dcb-015d-49c9-a0af-2f0fbeaae901" name="patch-syncProduct-handlerSub_Flow"/>
	</flow>
	<flow name="post:\v1\queryMaterials:application\json:gestor-xapi-services-config" doc:id="e4b0b897-7056-41bf-8057-f11c3a191d09" >
		<flow-ref doc:name="Go to handler" doc:id="60b4d39c-4573-4482-8cdb-4f743565fe01" name="post-queryMaterials-handlerSub_Flow"/>
	</flow>
</mule>
