<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="post-provisioning-clientSub_Flow" doc:id="e8a41916-3175-48bd-9197-5c6b8f8b158a" >
		<logger level="INFO" doc:name="Before operations papi" doc:id="a7cb70ac-6055-4d78-a825-ccd79af6add8" message="#[payload]"/>
		<http:request method="POST" doc:name="Go to operations papi services" doc:id="64ef12ba-33af-4332-a047-b67a1a8f0560" config-ref="operation-papi" path="#[p('operation-papi.basepath') ++ p('operation-papi.path-processProvisioning')]">
			<http:headers ><![CDATA[#[output application/java
---
{
	client_secret : p('operation-papi.client_secret'),
	source : "gestor-xapi-services",
	client_id : p('operation-papi.client_id'),
	"name": attributes.headers.name,
	"X-CORRELATION-ID": payload.respuestaAprovisionamiento.correlationId default correlationId,
	"systemId": vars.systemId
}]]]></http:headers>
		</http:request>
		<choice doc:name="is result negative?" doc:id="35e92311-9510-4b21-a0b3-86b81150d58a" >
			<when expression='#[payload.resultado == "Negativo"]'>
				<set-variable value="202" doc:name="Http Status" doc:id="eeb49534-1af5-4597-a63b-fb0a2536053f" variableName="httpStatus"/>
			</when>
		</choice>
	</sub-flow>
</mule>
