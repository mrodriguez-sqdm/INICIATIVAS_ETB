#%RAML 1.0
title: ETB Customer Experience API
version: v2
baseUri: https://customer-xapi-services-{env}.us-e2.cloudhub.io/{version}
description: |
  **ETB Customer Experience API - Comprehensive Customer Management**

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/riskValidation:                
  /otp:
    /resend:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Reenvío de OTP
        description: |
          Reenvía el código OTP asociado a una validación de identidad.
        body:
          application/json:
            type: !include datatypes/request/otpResendRequest.raml
            example: !include examples/request/otpResendRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpResendResponse.raml
                example: !include examples/response/otpResendResponse.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validación de OTP
        description: |
          Valida el código OTP ingresado por el cliente.
        body:
          application/json:
            type: !include datatypes/request/otpValidationRequest.raml
            example: !include examples/request/otpValidationRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpValidationResponse.raml
                example: !include examples/response/otpValidationResponse.json
  /identityValidation:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Validación de Identidad
      description: |
        Realiza la validación de identidad del cliente en el sistema LISIM.
        Retorna un objeto JSON con información de la validación.
      body:
        application/json:
          type: !include datatypes/request/identityValidationRequest.raml
          example: !include examples/request/identityValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/identityValidationResponse.raml
              examples:
                validClient: !include examples/response/identityValidationValidResponse.json
                notValidClient: !include examples/response/identityValidationNotValidResponse.json
  /score:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Consulta de Score
      description: |
        Consulta el score del cliente a partir de una validación de identidad.
      body:
        application/json:
          type: !include datatypes/request/scoreValidationRequest.raml
          example: !include examples/request/scoreValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/scoreValidationResponse.raml
              example: !include examples/response/scoreValidationResponse.json
  /questionnaire:
    get:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Solicitud de cuestionario
      description: Solicitud de cuestionario
      queryParameters:
        IdentificationType:
          type: string
          example: "CC"
        Identification:
          type: string
          example: "1235413456"
        ValidationReg:
          type: string
          example: "?"
        LastName:
          type: string
          example: "PEREZ"
        IssueDate:
          type: string
          example: "24/09/2008 02:40:50.3456"
          minLength: 1
        FirstName?:
          type: string | nil
          example: "JUAN"
        Model?:
          type: string | nil
          example: "2"
        Department?:
          type: integer | nil
          example: 1
        City?:
          type: integer | nil
          example: 1
        Advisor?:
          type: string | nil
          example: "?"
        SalesChannel?:
          type: string | nil
          example: "?"
        Provider?:
          type: string | nil
          example: "?"
        Portal?:
          type: string | nil
          example: "?"
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/questionnaireResponse.raml
              example: !include examples/response/questionnaireResponse.json
  /questionaries:
    /{identityValidation}:
      uriParameters:
        identityValidation:
          type: number
          example: 2652
      get:
        is: 
          - tibcoHeaders
        displayName: Solicitud de cuestionario
        description: Solicitud de cuestionario
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-questionaries.raml
                example: !include examples/response/get-questionaries.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validate Evidence LISIM
        description: Validate Evidence LISIM
        body:
          application/json:
            type: !include datatypes/request/evidentVerificationLISIM.raml
            example: !include examples/request/evidentVerificationLISIM.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/evidentVerificationLISIM.raml
                example: !include examples/response/evidentVerificationLISIM.json
  /mecna:
    get:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: risk
      description: Valida si un cliente existe en listas negras MECNA; recibe datos de cliente y retorna resultado de validación.
      queryParameters:
          document_id:
            type: string
            example: "12552454"
            description: Customer identification number can be ID card or tax ID number
            required: true
          document_id_type:
            type: string
            enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
            example: "CC"
            description: Type of customer identification document
            required: true
      responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/get-risk-management.raml
                  example: !include /examples/response/get-risk-management.json
                  
/serviceOrder:
    /orquestator:
      /mobile:
        /processOrder:
          post:
            displayName: Orquestator MOBILE process order
            description: Orquestator MOBILE process order
            is: 
             - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            body:
              application/json:
                type: !include datatypes/request/post-mobile-processOrder.raml
                example: !include /examples/request/post-mobile-processOrder.json
            responses:
              200:
                body:
                  application/json:
                    example: !include /examples/response/post-mobile-processOrder.json
      /fix:
        /processOrder:
          post:
            displayName: Orquestator FIX process order
            description: Orquestator FIX process order
            is: 
             - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            body:
              application/json:
                type: !include datatypes/request/post-fix-processOrder.raml
                example: !include /examples/request/post-fix-processOrder.json
            responses:
              201:
                body:
                  application/json:
                    example: !include /examples/response/post-fix-processOrder.json

/productOrderV2:
  description: |
    TMF622 Product Order Management API - State-Driven Orchestration

    NUEVO MODELO DE ORQUESTACIÓN BASADO EN ESTADOS:
    Los endpoints bajo /tmf implementan el estándar TMF622 con orquestación state-driven.
    Los estados enviados determinan automáticamente qué procesos ejecutar en el Process Layer.

    DIFERENCIAS CON /productOrder LEGACY:
    - /productOrder: Modelo simple, no TMF622, para compatibilidad con integraciones existentes
    - /productOrderV2: Modelo TMF622 completo con orquestación state-driven
    
  post:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Create TMF622 Product Order (State-Driven)
    description: |
      Crea una orden de producto usando TMF622 con ORQUESTACIÓN BASADA EN ESTADOS.

      IMPORTANTE - CAMBIO DE PARADIGMA:
      Este endpoint NO ejecuta acciones específicas - en su lugar, los ESTADOS enviados
      en orderState determinan automáticamente qué procesos ejecutar:

      FLUJO DE ORQUESTACIÓN:
      1. Experience API recibe la orden con estados en orderState
      2. Experience API valida y enriquece los datos
      3. Experience API invoca Process API con estados
      4. Process API interpreta estados y ejecuta procesos correspondientes automáticamente
      5. Process API retorna estados resultantes
      6. Experience API retorna orden completa con información de orquestación

      EJEMPLOS DE ESTADOS → PROCESOS:
      - commercialState: I50 → validateCustomer (TMF629, TMF717)
      - commercialState: I60 → scoreCustomer (TMF696, centrales de riesgo)
      - commercialState: I70 → processPlanSelection (TMF620, TMF671)
      - serviceState: 010 → validateAvailability (TMF641)
      - serviceState: 040 → queryAppointmentSlots (TMF626)
      - serviceState: 070 → triggerBackendOrchestration (OrquestadorFija/LTE)

      CATEGORÍAS SOPORTADAS:
      - FIXED_SERVICE: Servicios fijos (FTTH, COBRE) → MongoDB MDM_CD_ORDEN
      - MOBILE_SERVICE: Servicios móviles (LTE) → MongoDB MDM_ORDEN + MDM_ORDEN_SERVICIO
      - FIXED_MOBILE: Convergente (fijo + móvil)
      - DTH: Televisión satelital
      - VALUE_ADDED: Servicios de valor agregado (SVA)

      PERSISTENCIA:
      Todas las órdenes se persisten en MongoDB MDM según categoría y estado.
    queryParameters:
      ORIGIN:
        type: string
        example: "WEB"
        description: Parameter that allows the origin of the request to be identified
        required: false
    body:
      application/json:
        type: !include /datatypes/tmf622/request/ProductOrderCreate.raml
        description: |
          TMF622 Product Order con estados que determinan la orquestación.

          CRÍTICO: El campo orderState determina qué procesos ejecutar.
    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/tmf622/response/ProductOrderResponse.raml   
            description: |
              Orden creada con estados resultantes e información de orquestación ejecutada.
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      422:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            description: |
              Unprocessable Entity - Transición de estados inválida.

              Este error ocurre cuando:
              - Se intenta saltar estados requeridos
              - La transición de estados no es válida según reglas de negocio
              - Estados inconsistentes entre commercialState y serviceState
            example: !include /examples/response/error-422.json
              
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json

  /{orderId}:
    get:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Get TMF622 Product Order by ID
      description: |
        Consulta una orden específica por su orderId (ej: PO-000123).

        BÚSQUEDA UNIFICADA FIJA/MÓVIL:
        Busca automáticamente en las colecciones según el orderId o CATEGORY:
        - FIXED_SERVICE: MDM_CD_ORDEN (formato MDM-FIBRA-XXXXXXXXX)
        - MOBILE_SERVICE: MDM_ORDEN + MDM_ORDEN_SERVICIO (formato MDM_MOV-XXXXXX)

        Si CATEGORY no se especifica, busca en todas las colecciones.

        FILTROS DE VALIDACIÓN:
        Los parámetros STATE, COMMERCIAL_STATE y SERVICE_STATE validan que la orden
        encontrada coincida con los criterios. Si no coincide, retorna 404.

        Retorna la orden completa con:
        - Estados actuales (commercialState, serviceState)
        - Historial de transiciones de estado
        - Información de procesos ejecutados
        - Datos de orquestación
      queryParameters:
        ORIGIN:
          type: string
          example: "WEB"
          description: Parameter that allows the origin of the request to be identified
          required: false
        STATE:
          type: string
          required: false
          enum: [acknowledged, inProgress, pending, held, completed, failed, cancelled, rejected, partial]
          example: "inProgress"
          description: |
            Filter by TMF622 standard order state.
        CATEGORY:
          type: string
          required: false
          enum: [FIXED_SERVICE, MOBILE_SERVICE, FIXED_MOBILE, DTH, VALUE_ADDED]
          example: "FIXED_SERVICE"
          description: |
            Hint for collection search optimization:
            - FIXED_SERVICE: MDM_CD_ORDEN
            - MOBILE_SERVICE: MDM_ORDEN + MDM_ORDEN_SERVICIO
            If not provided, searches all collections.
        COMMERCIAL_STATE:
          type: string
          required: false
          enum: [I10, I30, I40, I50, I60, I61, I62, I70, "005", I90, C10, R10]
          example: "I70"
          description: Filter by commercial state (ETB-specific)
        SERVICE_STATE:
          type: string
          required: false
          enum: ["000", "010", "020", "030", "035", "040", "050", "055", "060", "061", "070", "100"]
          example: "050"
          description: Filter by service/provisioning state (ETB-specific)
        FIELDS:
          type: string
          required: false
          example: "orderId,state,orderState,category,relatedParty"
          description: |
            Comma-separated list of fields to return (partial response TMF620).
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/tmf622/response/ProductOrderResponse.raml
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

    patch:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Update TMF622 Product Order (State-Driven)
      description: |
        Actualiza una orden existente con nuevos estados (state-driven orchestration).

        IMPORTANTE: Al igual que POST, los nuevos estados en orderState determinan
        automáticamente qué procesos ejecutar para avanzar la orden.

        CASOS DE USO:
        - Avanzar orden al siguiente estado comercial (ej: I50 → I60 → I70)
        - Cambiar estado de servicio (ej: 010 → 040 → 070)
        - Actualizar datos de la orden (relatedParty, productOrderItem)
        - Registrar notas y comentarios

        VALIDACIONES:
        - Se valida que la transición de estados sea válida
        - No se permiten saltos de estados no autorizados
        - Estados terminales (C10, R10, I90+100) no pueden cambiar
      queryParameters:
        ORIGIN:
          type: string
          example: "WEB"
          description: Parameter that allows the origin of the request to be identified
          required: false
      body:
        application/json:
          type: object
          description: |
            Actualización parcial de la orden.
            Solo se actualizan los campos enviados.
          properties:
            orderState:
              type: object
              required: false
              properties:
                commercialState:
                  type: string
                  required: false
                  enum: [ I10, I30, I40, I50, I60, I61, I62, I70, "O05", "O10", "O35", "O60", "O70", C10, R10 ]
                serviceState:
                  type: string
                  required: false
                  enum: [ "000", "010", "020", "030", "035", "040", "050", "055", "060", "061", "070", "100" ]
                activationState:
                  type: string
                  required: false
                  enum: [ EN_PROCESO, APROBADA, RECHAZADA, EN_EVALUACION ]
            description:
              type: string
              required: false
            priority:
              type: string
              required: false
            relatedParty:
              type: array
              required: false
            productOrderItem:
              type: array
              required: false
            note:
              type: array
              required: false
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/tmf622/response/ProductOrderResponse.raml
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        422:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-422.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json


/customer:
  get:
    is: 
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: getCustomer
    description: view customer 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        FILTERS:
          type: string
          example: "MobilePhone:3222233322;Phone:542545454;AccountNumber:12452145"
          description: String used to apply filters to the query (follow example), separate the filter type and its value with a colon, and separate the number of filters with a semicolon.
          required: false
        LIMIT:
          type: number
          description: Limit on orders to display
          required: false
        OFFSET:
          type: string
          description: used to organize information and establish a logical order
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-customer.raml
                example: !include /examples/response/get-customer.json    
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json