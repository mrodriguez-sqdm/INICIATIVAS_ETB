#%RAML 1.0
title: ETB Customer Experience API
version: v2
baseUri: https://customer-xapi-services-{env}.us-e2.cloudhub.io/{version}
description: |
  **ETB Customer Experience API - Comprehensive Customer Management**

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType:
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/customer360:
  get:
    is:
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: getCustomer360
    description: view customer
    queryParameters:
      fields:
        type: array
        required: false
      documentNumber:
        type: string
        example: "12552454"
        description: Official identification number of the customer, such as ID card, passport, or tax ID.
        required: true
      documentType:
        type: string
        enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
        example: "CC"
        description: Type of official document used for customer identification, such as ID card, passport, or tax certificate.
        required: true
      limit:
        type: number
        description: Specifies the maximum number of items to return in the response
        default: 10
        required: false
        example: 10
    responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/get-customer-360.raml
              example: !include /examples/response/get-customer-360.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

/customer:
  get:
    is:
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: getCustomer
    description: view customer
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        FILTERS:
          type: string
          example: "MobilePhone:3222233322;Phone:542545454;AccountNumber:12452145"
          description: String used to apply filters to the query (follow example), separate the filter type and its value with a colon, and separate the number of filters with a semicolon.
          required: false
        LIMIT:
          type: number
          description: Limit on orders to display
          required: false
        OFFSET:
          type: string
          description: used to organize information and establish a logical order
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-customer.raml
                example: !include /examples/response/get-customer.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json

/payment:
  /{paymentMethod}:
    uriParameters:
      paymentMethod:
        type: string
        required: true
        description: "Payment platform or gateway identifier. Specifies the payment provider to be used for the transaction (e.g., PSE, Wompi, PayU)."
        example: "pse"
    /banks:
      get:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Get Payment Banks
        description: |
          Retrieves the list of available banks for the specified payment method.
          This endpoint is essential for providing users with bank options when initiating payment transactions.
        responses:
          200:
            body:
              application/json:
                description: List of available banks for the payment method
                example: !include examples/response/get-banks.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
    /payment:
      post:
        is:
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Create Payment Transaction
        description: |
          Creates a new payment transaction for the specified payment method.
          This endpoint initiates the payment process and returns transaction details including payment URL and reference.
        body:
          application/json:
            type: object
            description: Payment transaction request payload
            examples: 
              Payu: !include examples/request/post-transaction-payu.json
              Wompi: !include examples/request/post-transaction-wompi.json
              PSE: !include examples/request/post-transaction-pse.json
        responses:
          201:
            body:
              application/json:
                description: Successfully created payment transaction
                example: !include examples/response/post-transaction.json
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
      /{paymentId}:
        uriParameters:
          paymentId:
            type: string
            required: true
            description: "Unique identifier of the payment transaction"
            example: "TXN-123456789"
        get:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Get Transaction By ID
          description: |
            Retrieves detailed information about a specific payment transaction using its unique identifier.
            This endpoint allows tracking the status and details of previously created payment transactions.
          responses:
            200:
              body:
                application/json:
                  description: Payment transaction details
            400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
            401:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-401.json
            404:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-404.json
            500:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json
        patch:
          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          displayName: Update Payment Transaction
          description: |
            Updates an existing payment transaction. This endpoint can be used to modify transaction status,
            add additional information, or update payment details after initial creation.
          body:
            application/json:
              type: object
              description: Fields to update in the payment transaction
          responses:
            200:
              body:
                application/json:
                  description: Successfully updated payment transaction
            400:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-400.json
            401:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-401.json
            404:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-404.json
            500:
              body:
                application/json:
                  type: !include /datatypes/response/error.raml
                  example: !include /examples/response/error-500.json
/riskValidation:                
  /otp:
    /resend:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Reenvío de OTP
        description: |
          Reenvía el código OTP asociado a una validación de identidad.
        body:
          application/json:
            type: !include datatypes/request/otpResendRequest.raml
            example: !include examples/request/otpResendRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpResendResponse.raml
                example: !include examples/response/otpResendResponse.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validación de OTP
        description: |
          Valida el código OTP ingresado por el cliente.
        body:
          application/json:
            type: !include datatypes/request/otpValidationRequest.raml
            example: !include examples/request/otpValidationRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpValidationResponse.raml
                example: !include examples/response/otpValidationResponse.json
  /identityValidation:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Validación de Identidad
      description: |
        Realiza la validación de identidad del cliente en el sistema LISIM.
        Retorna un objeto JSON con información de la validación.
      body:
        application/json:
          type: !include datatypes/request/identityValidationRequest.raml
          example: !include examples/request/identityValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/identityValidationResponse.raml
              examples:
                validClient: !include examples/response/identityValidationValidResponse.json
                notValidClient: !include examples/response/identityValidationNotValidResponse.json
  /score:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Consulta de Score
      description: |
        Consulta el score del cliente a partir de una validación de identidad.
      body:
        application/json:
          type: !include datatypes/request/scoreValidationRequest.raml
          example: !include examples/request/scoreValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/scoreValidationResponse.raml
              example: !include examples/response/scoreValidationResponse.json
  /questionaries:
    /{identityValidation}:
      uriParameters:
        identityValidation:
          type: number
          example: 2652
      get:
        is: 
          - tibcoHeaders
        displayName: Solicitud de cuestionario
        description: Solicitud de cuestionario
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-questionaries.raml
                example: !include examples/response/get-questionaries.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validate Evidence LISIM
        description: Validate Evidence LISIM
        body:
          application/json:
            type: !include datatypes/request/evidentVerificationLISIM.raml
            example: !include examples/request/evidentVerificationLISIM.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/evidentVerificationLISIM.raml
                example: !include examples/response/evidentVerificationLISIM.json