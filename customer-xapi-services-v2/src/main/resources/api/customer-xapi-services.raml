#%RAML 1.0
title: ETB Customer Experience API
version: v2
baseUri: https://customer-xapi-services-{env}.us-e2.cloudhub.io/{version}
description: |
  **ETB Customer Experience API - Comprehensive Customer Management**

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/riskValidation:                
  /otp:
    /resend:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Reenvío de OTP
        description: |
          Reenvía el código OTP asociado a una validación de identidad.
        body:
          application/json:
            type: !include datatypes/request/otpResendRequest.raml
            example: !include examples/request/otpResendRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpResendResponse.raml
                example: !include examples/response/otpResendResponse.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validación de OTP
        description: |
          Valida el código OTP ingresado por el cliente.
        body:
          application/json:
            type: !include datatypes/request/otpValidationRequest.raml
            example: !include examples/request/otpValidationRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpValidationResponse.raml
                example: !include examples/response/otpValidationResponse.json
  /identityValidation:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Validación de Identidad
      description: |
        Realiza la validación de identidad del cliente en el sistema LISIM.
        Retorna un objeto JSON con información de la validación.
      body:
        application/json:
          type: !include datatypes/request/identityValidationRequest.raml
          example: !include examples/request/identityValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/identityValidationResponse.raml
              examples:
                validClient: !include examples/response/identityValidationValidResponse.json
                notValidClient: !include examples/response/identityValidationNotValidResponse.json
  /score:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Consulta de Score
      description: |
        Consulta el score del cliente a partir de una validación de identidad.
      body:
        application/json:
          type: !include datatypes/request/scoreValidationRequest.raml
          example: !include examples/request/scoreValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/scoreValidationResponse.raml
              example: !include examples/response/scoreValidationResponse.json
  /questionnaire:
    get:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Solicitud de cuestionario
      description: Solicitud de cuestionario
      queryParameters:
        IdentificationType:
          type: string
          example: "CC"
        Identification:
          type: string
          example: "1235413456"
        ValidationReg:
          type: string
          example: "?"
        LastName:
          type: string
          example: "PEREZ"
        IssueDate:
          type: string
          example: "24/09/2008 02:40:50.3456"
          minLength: 1
        FirstName?:
          type: string | nil
          example: "JUAN"
        Model?:
          type: string | nil
          example: "2"
        Department?:
          type: integer | nil
          example: 1
        City?:
          type: integer | nil
          example: 1
        Advisor?:
          type: string | nil
          example: "?"
        SalesChannel?:
          type: string | nil
          example: "?"
        Provider?:
          type: string | nil
          example: "?"
        Portal?:
          type: string | nil
          example: "?"
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/questionnaireResponse.raml
              example: !include examples/response/questionnaireResponse.json
  /questionaries:
    /{identityValidation}:
      uriParameters:
        identityValidation:
          type: number
          example: 2652
      get:
        is: 
          - tibcoHeaders
        displayName: Solicitud de cuestionario
        description: Solicitud de cuestionario
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-questionaries.raml
                example: !include examples/response/get-questionaries.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validate Evidence LISIM
        description: Validate Evidence LISIM
        body:
          application/json:
            type: !include datatypes/request/evidentVerificationLISIM.raml
            example: !include examples/request/evidentVerificationLISIM.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/evidentVerificationLISIM.raml
                example: !include examples/response/evidentVerificationLISIM.json
  /mecna:
    get:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: risk
      description: Valida si un cliente existe en listas negras MECNA; recibe datos de cliente y retorna resultado de validación.
      queryParameters:
          document_id:
            type: string
            example: "12552454"
            description: Customer identification number can be ID card or tax ID number
            required: true
          document_id_type:
            type: string
            enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
            example: "CC"
            description: Type of customer identification document
            required: true
      responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/get-risk-management.raml
                  example: !include /examples/response/get-risk-management.json
                  
/serviceOrder:
    /orquestator:
      /mobile:
        /processOrder:
          post:
            displayName: Orquestator MOBILE process order
            description: Orquestator MOBILE process order
            is: 
             - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            body:
              application/json:
                type: !include datatypes/request/post-mobile-processOrder.raml
                example: !include /examples/request/post-mobile-processOrder.json
            responses:
              200:
                body:
                  application/json:
                    example: !include /examples/response/post-mobile-processOrder.json
      /fix:
        /processOrder:
          post:
            displayName: Orquestator FIX process order
            description: Orquestator FIX process order
            is: 
             - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            body:
              application/json:
                type: !include datatypes/request/post-fix-processOrder.raml
                example: !include /examples/request/post-fix-processOrder.json
            responses:
              201:
                body:
                  application/json:
                    example: !include /examples/response/post-fix-processOrder.json
/customer:
  get:
    is: 
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: getCustomer
    description: view customer 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        FILTERS:
          type: string
          example: "MobilePhone:3222233322;Phone:542545454;AccountNumber:12452145"
          description: String used to apply filters to the query (follow example), separate the filter type and its value with a colon, and separate the number of filters with a semicolon.
          required: false
        LIMIT:
          type: number
          description: Limit on orders to display
          required: false
        OFFSET:
          type: string
          description: used to organize information and establish a logical order
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-customer.raml
                example: !include /examples/response/get-customer.json    
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
/productOrder:
 post:
  is: 
   - tibcoHeaders
  securedBy: [etb_oauth_2_0]
  description: |
    crea una orden de venta
  body:
    application/json:
      type: !include datatypes/request/productOrder.raml
      example: !include /examples/request/productOrder.json
  responses:
    200:
      body:
        application/json:
            type: !include datatypes/response/productOrder.raml
    400:
      body:
        application/json:
          type: !include /datatypes/response/error.raml
          example: !include /examples/response/error-400.json
    401:
      body:
        application/json:
          type: !include /datatypes/response/error.raml
          example: !include /examples/response/error-401.json
    404:
      body:
        application/json:
          type: !include /datatypes/response/error.raml
          example: !include /examples/response/error-404.json
    500:
      body:
        application/json:
          type: !include /datatypes/response/error.raml
          example: !include /examples/response/error-500.json
/billingBalance:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar saldo de cuenta de facturación
    description: |
      Query postpaid billing account balance from ZSmart (queryAccountbalance — v0.8).
      Expired balances are not returned.
      Negative balance = account has money; positive = account has debt.
      At least one search key must be provided:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: true
      CONNECTION_NUMBER:
        type: string
        example: "6015551234"
        description: |
          Service MSISDN (area code + number). Search key.
          ZSmart: msisdn. At least one search key must be present.
        required: false
      BILLING_ACCOUNT:
        type: string
        example: "14000001234"
        description: |
          ZSmart billing account number. Search key.
          ZSmart: accountCode. At least one search key must be present.
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID.
          ZSmart: resolved to msisdn or accountCode via customer lookup.
        required: false
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved to msisdn or accountCode via customer lookup.
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingBalance.raml
            example: !include examples/response/get-billingBalance.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingHistory:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar historial de facturas
    description: |
      Query postpaid account bill history from ZSmart (billHistoryQuery — v0.8).
      Default: returns last 6 billed billing cycles when no date range is specified.
      Max date range: 6 months between START_TIME and END_TIME.
      At least one search key must be provided:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
      If INVOICE_NUMBER is provided, other filters still apply as additional constraints.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: true
      CONNECTION_NUMBER:
        type: string
        example: "6015551234"
        description: |
          Service MSISDN (area code + number). Search key.
          ZSmart: msisdn. At least one search key must be present.
        required: false
      BILLING_ACCOUNT:
        type: string
        example: "14000001234"
        description: |
          ZSmart billing account number. Search key.
          ZSmart: accountNumber. At least one search key must be present.
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID.
          ZSmart: resolved to accountNumber via customer lookup.
        required: false
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved to accountNumber via customer lookup.
        required: false
      INVOICE_NUMBER:
        type: string
        example: "INV-2026-001234"
        description: "Filter by specific invoice number. ZSmart: invoiceNumber."
        required: false
      START_TIME:
        type: string
        example: "2026-01-01"
        description: |
          Filter start date YYYY-MM-DD. If provided, END_TIME is also required.
          Bills filtered by billing cycle end date within the range.
          ZSmart: startTime.
        required: false
      END_TIME:
        type: string
        example: "2026-03-31"
        description: |
          Filter end date YYYY-MM-DD. If provided, START_TIME is also required.
          Max range: 6 months from START_TIME. ZSmart: endTime.
        required: false
      BILL_TYPE:
        type: string
        enum: ["1","2","3"]
        example: "1"
        description: |
          Invoice type filter. 1=Monthly invoice, 2=Sales invoice, 3=Instant Bill.
          Omit to return all types. ZSmart: billType.
        required: false
      LIMIT:
        type: number
        example: 10
        description: Maximum number of invoices to return.
        required: false
      OFFSET:
        type: number
        example: 0
        description: Pagination offset.
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingHistory.raml
            example: !include examples/response/get-billingHistory.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json
