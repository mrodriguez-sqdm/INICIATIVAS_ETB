/payment:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]

    displayName: Get Customer Payments
    description: |
      Retrieves payments made by a customer according to the provided
      customer, date, transaction type and channel filters.

    queryParameters:
      msisdn:
        type: string
        required: false
        minLength: 1
        maxLength: 60
        pattern: ^[0-9]+$
        example: "573001234567"
        description: |
          Customer service identifier. Either msisdn or accountNumber
          must be provided.

      accountNumber:
        type: string
        required: false
        minLength: 1
        maxLength: 15
        pattern: ^[0-9]+$
        example: "5201"
        description: |
          Customer billing account number. Either msisdn or accountNumber
          must be provided.

      startTime:
        type: string
        required: false
        maxLength: 20
        example: "2026-07-01 00:00:00"
        description: Start date and time of the payment inquiry.

      endTime:
        type: string
        required: false
        maxLength: 20
        example: "2026-07-17 23:59:59"
        description: End date and time of the payment inquiry.

      transType:
        type: string
        required: false
        maxLength: 20
        example: "IN"
        description: Transaction type used to filter the inquiry.

      channelCode:
        type: string
        required: true
        maxLength: 60
        example: "Point of Sale"
        description: Payment channel.

      channelFilter:
        type: string
        required: false
        enum: [Y, N]
        example: "Y"
        description: Indicates whether the inquiry must filter by channel.

    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/get-customer-payments.raml
            example: !include /examples/response/get-customer-payments.json

      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json

      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json

      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json

      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
  post:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]

    displayName: Create Payment Transaction
    description: |
      Creates a new payment transaction for the specified payment method.
      This endpoint initiates the payment process and returns transaction details including payment URL and reference.

    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Parameter that allows the origin of the request to be identified

    body:
      application/json:
        description: Payment transaction request payload
        type: !include /datatypes/request/post-transaction.raml
        examples:
          Payu: !include examples/request/post-transaction-payu.json
          WompiTansaction: !include examples/request/post-transaction-wompiTansaction.json
          WompiCheckoutWeb: !include examples/request/post-transaction-wompiCheckoutWeb.json
          PSE: !include examples/request/post-transaction-pse.json
          Mongo: !include examples/request/post-transaction-mongo.json

    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/post-transaction.raml
            examples:
              Payu: !include examples/response/post-transaction-payu.json
              WompiTansaction: !include examples/response/post-transaction-wompiTansaction.json
              WompiCheckoutWeb: !include examples/response/post-transaction-wompiCheckoutWeb.json
              PSE: !include examples/response/post-transaction-pse.json
              Mongo: !include examples/response/post-transaction-mongo.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json

  /{paymentId}:
    uriParameters:
      paymentId:
        type: string
        required: true
        description: "Unique identifier of the payment transaction"
        example: "TXN-123456789"
    patch:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]

      displayName: Update Payment Transaction
      description: |
        Updates an existing payment transaction. This endpoint can be used to modify transaction status,
        add additional information, or update payment details after initial creation.

      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified

      body:
        application/json:
          type: !include /datatypes/request/patch-transaction.raml

      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/patch-transaction.raml
              examples:
                WompiTansaction: !include examples/response/patch-transaction-wompiTansaction.json
                WompiCheckoutWeb: !include examples/response/patch-transaction-wompiCheckoutWeb.json
                PSE: !include examples/response/patch-transaction-pse.json
                Mongo: !include examples/response/patch-transaction-mongo.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
              
    get:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]

      displayName: Get Transaction By ID
      description: |
        Retrieves detailed information about a specific payment transaction using its unique identifier.
        This endpoint allows tracking the status and details of previously created payment transactions.

      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified

        PAYMENT_FLOW:
          type: string
          enum: [API, CHECKOUT]
          example: "API"
          required: false
          description: Parameter that allows the origin of the request to be identified
        
        GATEWAY_PAYMENT:
          type: string
          enum: [PSE, WOMPI, PAYU, ETB]
          example: "PSE"
          required: false
          description: Parameter that allows the origin of the request to be identified

      responses:
        200:
          body:
            application/json:
              type: object
              examples:
                Payu: !include examples/response/get-transaction-payu.json
                WompiTansaction: !include examples/response/get-transaction-wompiTansaction.json
                WompiCheckoutWeb: !include examples/response/get-transaction-wompiCheckoutWeb.json
                PSE: !include examples/response/get-transaction-pse.json
                Mongo: !include examples/response/get-transaction-mongo.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
  /banksBasicAuth:
    post:
      is:
        - tibcoHeaders
      displayName: Notificacion de Pago bancario
      description: the interface is used to accept the payment and settle the related invoices (cycle, finance, payment plan).
      body:
        application/json:
          type: !include datatypes/request/post-payment-banks-basic-auth.raml
          example: !include examples/request/post-payment-banks-basic-auth.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/post-payment-banks.raml
              example: !include examples/response/post-payment-banks.json
        400:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-500.json
  /banks:
    post:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Notificacion de Pago bancario
      description: the interface is used to accept the payment and settle the related invoices (cycle, finance, payment plan).
      body:
        application/json:
          type: !include datatypes/request/post-payment-banks.raml
          example: !include examples/request/post-payment-banks.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/post-payment-banks.raml
              example: !include examples/response/post-payment-banks.json
        400:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include datatypes/response/error.raml
              example: !include examples/response/error-500.json
    get:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Get Payment Banks
      description: |
        Retrieves the list of available banks for the specified payment method.
        This endpoint is essential for providing users with bank options when initiating payment transactions.
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified

        GATEWAY_PAYMENT:
          type: string
          enum: [PSE, WOMPI, PAYU, ETB]
          example: "PSE"
          required: false
          description: Parameter that allows the origin of the request to be identified
      responses:
        200:
          body:
            application/json:
              description: List of available banks for the payment method
              example: !include examples/response/get-banks.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
  /webhook:
    post:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Payment Transaction Webhook
      description: |
        Receives payment transaction webhook events
      body:
        application/json:
          type: object
          examples:
            payu: !include /examples/request/post-transaction-webhook-payu.json
            wompi: !include /examples/request/post-transaction-webhook-wompi.json
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/post-transaction-webhook.raml
              example: !include /examples/response/post-transaction-webhook.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

    /confirmation:
      /payu:
        post:
          securedBy: [etb_oauth_2_0]
          displayName: PayU Payment Confirmation Webhook
          description: Receives PayU payment confirmation notifications
          body:
            application/x-www-form-urlencoded:
              type: !include /datatypes/request/post-payu-confirmation.raml
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/post-transaction-webhook.raml
                  example: !include /examples/response/post-transaction-webhook.json

/balance:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar balance
    description: |
      Experience API — consulta de balance por MSISDN; delega en customer-papi-services-v2 (JSC subscription).
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: false
      clientIp:
        type: string
        example: "192.168.1.1"
        description: IP del cliente
        required: false
      MSISDN:
        type: string
        example: "573001234567"
        description: MSISDN de la línea
        required: true
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-balance.raml
            example: !include examples/response/get-balance-200.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/transferBalance:
  post:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Transferencia de saldo
    description: |
      Transfiere saldo entre dos líneas. Valida que los MSISDN de origen y destino existan y tengan suscripción válida antes de ejecutar la transferencia.
    body:
      application/json:
        type: !include datatypes/request/transferBalanceRequest.raml
        example: !include examples/request/transferBalanceRequest.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/transferBalanceResponse.raml
            example: !include examples/response/transferBalanceResponse.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml

/billingBalance:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar saldo de cuenta de facturación
    description: |
      Query postpaid billing account balance from ZSmart (queryAccountbalance — v0.8).
      Expired balances are not returned.
      Negative balance = account has money; positive = account has debt.
      At least one search key must be provided:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: true
      CONNECTION_NUMBER:
        type: string
        example: "6015551234"
        description: |
          Service MSISDN (area code + number). Search key.
          ZSmart: msisdn. At least one search key must be present.
        required: false
      BILLING_ACCOUNT:
        type: string
        example: "14000001234"
        description: |
          ZSmart billing account number. Search key.
          ZSmart: accountCode. At least one search key must be present.
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","NIT","PEP","PPT"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID. ZSmart spec values:
          - CC: CEDULA DE CIUDADANIA
          - CE: CEDULA DE EXTRANJERIA
          - NIT: NIT
          - PEP: PERMISO ESPECIAL PERMANENCIA
          - PPT: PERMISO PROECCION TEMPORAL
        required: false
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved to msisdn or accountCode via customer lookup.
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingBalance.raml
            example: !include examples/response/get-billingBalance.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingHistory:
  post:
    is:
      - tibcoHeaders
      - trafficControlled
    securedBy: [ basicAuth ]
    displayName: Consultar historial de facturas
    description: |
      Query postpaid account bill history from ZSmart (billHistoryQuery — v0.8).
      Default: returns last 6 billed billing cycles when no date range is specified.
      Max date range: 6 months between START_TIME and END_TIME.
      At least one search key must be provided:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
      If INVOICE_NUMBER is provided, other filters still apply as additional constraints.
    body:
      application/json:
        type: !include datatypes/request/post-billingHistory.raml
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingHistory.raml
            example: !include examples/response/get-billingHistory.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar historial de facturas
    description: |
      Query postpaid account bill history from ZSmart (billHistoryQuery — v0.8).
      Default: returns last 6 billed billing cycles when no date range is specified.
      Max date range: 6 months between START_TIME and END_TIME.
      At least one search key must be provided:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
      If INVOICE_NUMBER is provided, other filters still apply as additional constraints.
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: true
      CONNECTION_NUMBER:
        type: string
        example: "6015551234"
        description: |
          Service MSISDN (area code + number). Search key.
          ZSmart: msisdn. At least one search key must be present.
        required: false
      BILLING_ACCOUNT:
        type: string
        example: "14000001234"
        description: |
          ZSmart billing account number. Search key.
          ZSmart: accountNumber. At least one search key must be present.
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","NIT","PEP","PPT"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID. ZSmart spec values:
          - CC: CEDULA DE CIUDADANIA
          - CE: CEDULA DE EXTRANJERIA
          - NIT: NIT
          - PEP: PERMISO ESPECIAL PERMANENCIA
          - PPT: PERMISO PROECCION TEMPORAL
        required: false
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved to accountNumber via customer lookup.
        required: false
      INVOICE_NUMBER:
        type: string
        example: "INV-2026-001234"
        description: "Filter by specific invoice number. ZSmart: invoiceNumber."
        required: false
      START_TIME:
        type: string
        example: "2026-01-01"
        description: |
          Filter start date YYYY-MM-DD. If provided, END_TIME is also required.
          Bills filtered by billing cycle end date within the range.
          ZSmart: startTime.
        required: false
      END_TIME:
        type: string
        example: "2026-03-31"
        description: |
          Filter end date YYYY-MM-DD. If provided, START_TIME is also required.
          Max range: 6 months from START_TIME. ZSmart: endTime.
        required: false
      BILL_TYPE:
        type: string
        enum: ["1","2","3"]
        example: "1"
        description: |
          Invoice type filter. 1=Monthly invoice, 2=Sales invoice, 3=Instant Bill.
          Omit to return all types. ZSmart: billType.
        required: false
      LIMIT:
        type: number
        example: 10
        description: Maximum number of invoices to return.
        required: false
      OFFSET:
        type: number
        example: 0
        description: Pagination offset.
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingHistory.raml
            example: !include examples/response/get-billingHistory.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingSubscriberProfile:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar Perfil del Suscriptor
    description: |
      Retrieves the current profile of a subscriber from ZSmart, including state, account,
      customer data, active balances, additional offers and product attributes.
      ZSmart operation: querySubscriberProfile — v0.9.
    queryParameters:
      serviceNumber:
        type: string
        description: "Service number (MSISDN) of the subscriber. ZSmart: querySubscriberProfile.serviceNumber"
        example: '6015551234'
        required: true
      areaCode:
        type: string
        example: '1'
        required: true
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingSubscriberProfile.raml
            example: !include examples/response/get-billingSubscriberProfile.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingClearance:
  post:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Solicitar Paz y Salvo de Facturación
    description: |
      Queries the customer's due amount in ZSmart and, if the customer is not in dunning status,
      sends a billing clearance certificate (paz y salvo) to the provided email address.
      ZSmart operation: applyETBCertification.
    body:
      application/json:
        type: !include datatypes/request/post-billingClearance.raml
        example: !include examples/request/post-billingClearance.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/post-billingClearance.raml
            example: !include examples/response/post-billingClearance-200.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingAccountItem:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar Items de Cuenta de Facturación (Desglose de Cargos)
    description: |
      Query detailed billing account items (line items breakdown) from ZSmart (queryBillAcctItem — v1.1).
      Returns the detailed breakdown of charges, taxes, adjustments, and disputes for a specific invoice.
      Per ZSmart spec §6.8, requires INVOICE_NUMBER (mandatory) and at least one search key:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
      If searching by document, multiple accounts may be resolved; items are returned for each account.
    queryParameters:
      ORIGIN:
        type: string
        example: "WEB"
        description: Canal de origen (requerido)
        required: true
      CONNECTION_NUMBER:
        type: string
        example: "6015551234"
        description: |
          Service MSISDN (area code + number). Search key.
          ZSmart: msisdn. At least one search key must be present.
        required: false
      BILLING_ACCOUNT:
        type: string
        example: "14000001234"
        description: |
          ZSmart billing account number. Search key.
          ZSmart: accountNumber. At least one search key must be present.
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","NIT","PEP","PPT"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID.
          - CC: CEDULA DE CIUDADANIA
          - CE: CEDULA DE EXTRANJERIA
          - NIT: NIT
          - PEP: PERMISO ESPECIAL PERMANENCIA
          - PPT: PERMISO PROECCION TEMPORAL
        required: false
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved via MDM lookup to msisdn or accountNumber.
        required: false
      INVOICE_NUMBER:
        type: string
        example: "INV-2026-001234"
        description: |
          Invoice/Bill number to retrieve line items for. MANDATORY — specifies which invoice's detailed breakdown to return.
          ZSmart: billNumber.
        required: true
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingAccountItem.raml
            example: !include examples/response/get-billingAccountItem.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include examples/response/error-500.json            

/billingDispute:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar disputas de cuenta de facturación
    description: |
      Query dispute records for a billing account from ZSmart (qryDispute — v1.1, §6.11).
      Returns open and/or closed disputes within an optional date range.
      At least one search key must be provided:
        - CONNECTION_NUMBER (MSISDN)
        - BILLING_ACCOUNT (ZSmart account number)
        - CUSTOMER_ID_TYPE + CUSTOMER_ID (compound key — both required together)
      queryClosedFlag=Y (default) returns open AND closed disputes.
      queryClosedFlag=N returns only open/active disputes.
    queryParameters:
      ORIGIN:
        type: string
        example: "WEB"
        description: Canal de origen ZSmart channelCode (M)
        required: true
      CONNECTION_NUMBER:
        type: string
        example: "6015551234"
        description: |
          Service MSISDN (area code + number). Search key.
          ZSmart: msisdn. At least one search key must be present.
        required: false
      BILLING_ACCOUNT:
        type: string
        example: "14000001234"
        description: |
          ZSmart billing account number. Search key.
          ZSmart: accountNumber. At least one search key must be present.
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","NIT","PEP","PPT"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID.
          - CC: CEDULA DE CIUDADANIA
          - CE: CEDULA DE EXTRANJERIA
          - NIT: NIT
          - PEP: PERMISO ESPECIAL PERMANENCIA
          - PPT: PERMISO PROECCION TEMPORAL
        required: false
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved via MDM lookup to msisdn or accountNumber.
        required: false
      QUERY_CLOSED_FLAG:
        type: string
        enum: ["Y","N"]
        example: "Y"
        description: |
          Whether closed disputes are included in the response.
          Y (default): returns open AND closed disputes.
          N: returns only open/active disputes.
          ZSmart: queryClosedFlag (O)
        required: false
      START_DATE:
        type: string
        example: "2026-01-01 00:00:00"
        description: |
          Start date filter YYYY-MM-DD HH:MM:SS. If provided, END_DATE is required.
          ZSmart: beginDate (O)
        required: false
      END_DATE:
        type: string
        example: "2026-06-30 23:59:59"
        description: |
          End date filter YYYY-MM-DD HH:MM:SS. If provided, START_DATE is required.
          ZSmart: endDate (O)
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingDispute.raml
            example: !include examples/response/get-billingDispute.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingInvoicePDF:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar facturas en formato PDF de un cliente.
    description: |
      Service will make a request to one of two Zsmart services, based on BILLING_INVOICE(POSTPAID, PREPAID) parameter:
      
      POSTPAID will use Query Bill PDF from ZSmart (queryBillPDF — v1.7).
      Keys must be provided
        - INVOICE_NUMBER (Mandatory)
        - BILLING_ACCOUNT (Mandatory)
      
      PREPAID will use Query Invoice PDF from Zsmart (queryInvoicePDF - v1.7).
      Keys must be provided
        - TRANSACTION_ID (Mandatory)
        - INVOICE_TYPE (Mandatory)
        - COMMENTS (Optional)
      
      NOTE - Keys validation will be handled by flow.
    
    queryParameters:
      BILLING_INVOICE:
        type: string
        enum:
          - POSTPAID
          - PREPAID
        example: "POSTPAID"
        description: Billing Invoice Type
        required: true
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Origin channel
        required: true
      TRANSACTION_ID:
        type: string
        minLength: 1
        maxLength: 30
        example: "6015551234"
        description: transaction ID generated by the external system. A unique sequence identify a request, and it cannot be repeat.
        required: false
      INVOICE_TYPE:
        type: string
        enum: ["1", "2"]
        example: "1"
        description: ZSmart Invoice type - Search key must be present. 1 for recharge invoice and 2 for sale invoice
        required: false
      INVOICE_NUMBER:
        type: string
        minLength: 1
        maxLength: 30
        example: "18561445465"
        description: ZSmart Invoice number - Search key must be present. 1 for recharge invoice and 2 for sale invoice
        required: false
      BILLING_ACCOUNT:
        type: string
        minLength: 1
        maxLength: 30
        example: "98653221548"
        description: ZSmart billing account number - Search key must be present.
        required: false
      COMMENTS:
        type: string
        minLength: 1
        maxLength: 200
        example: "Comments related"
        description: Comments of description.
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingInvoicePdf.raml
            examples:
              postpaidExample:
                displayName: POSTPAID - Bill PDF (queryBillPDF)
                value: !include examples/response/get-billingInvoicePdf-postpaid.json
              prepaidExample:
                displayName: PREPAID - Invoice PDF (queryInvoicePDF)
                value: !include examples/response/get-billingInvoicePdf-prepaid.json
            
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingRechargeHistory:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar historial de recargas
    description: |
      Query recharge history, if the BeginDate, EndDate are not specified in API, system will response the transactions of latest 30 days. Only recharge history within the previous year can be queried, the duration between beginDate and endDate cannot larger than 6 months..
      At least one search key must be provided:
        - SERVICE_NUMBER (serviceNumber)
        - START_TIME (ZSmart BeginDate)
        - END_TIME (ZSmart EndDate)
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: true
      SERVICE_NUMBER:
        type: string
        example: "6015551234"
        maxLength: 60
        description: |
          The service number that the recharge transaction is made to - Search key.
          ZSmart: serviceNumber.
        required: true
      START_TIME:
        type: string
        example: "2026-01-01"
        description: |
          Filter start date YYYY-MM-DD. If provided, END_TIME is also required.
          Bills filtered by billing cycle end date within the range.
          ZSmart: startTime.
        required: false
      END_TIME:
        type: string
        example: "2026-03-31"
        description: |
          Filter end date YYYY-MM-DD. If provided, START_TIME is also required.
          Max range: 6 months from START_TIME. ZSmart: endTime.
        required: false
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingRechargeHistory.raml
            example: !include examples/response/get-billingRechargeHistory.json
            
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/billingAccountStatement:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar estado de cuenta ETB
    description: |
      ETB Account Statement, the service is provided to response account statement document, it’s only applied for B2C customer, which has postpaid subscriber and no postpaid account in ZSmart billing. For the request from whatsapp which requires to send url of file to customer’s whatsapp client app, it should be handled by ETB frontend system. ZSmart billing only response pdf file.
      All search key must be provided:
        - CUSTOMER_ID_TYPE (serviceNumber)
        - CUSTOMER_ID (ZSmart BeginDate)
        - CHANNEL_CODE (ZSmart EndDate)
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: true
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","NIT","PEP","PPT"]
        example: "CC"
        description: |
          Document type. Compound key — must be sent together with CUSTOMER_ID. ZSmart spec values:
          - CC: CEDULA DE CIUDADANIA
          - CE: CEDULA DE EXTRANJERIA
          - NIT: NIT
          - PEP: PERMISO ESPECIAL PERMANENCIA
          - PPT: PERMISO PROECCION TEMPORAL
        required: true
      CUSTOMER_ID:
        type: string
        example: "1023456789"
        description: |
          Document number. Compound key — must be sent together with CUSTOMER_ID_TYPE.
          ZSmart: resolved to docNumber.
        required: true
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-billingAccountStatement.raml
            example: !include examples/response/get-billingAccountStatement.json
            
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

