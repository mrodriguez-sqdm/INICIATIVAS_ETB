#%RAML 1.0
title: ETB Customer Experience API
version: v2
baseUri: https://customer-xapi-services-{env}.us-e2.cloudhub.io/{version}
description: |
  **ETB Customer Experience API - Comprehensive Customer Management**

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType: 
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

/riskValidation:                
  /otp:
    /resend:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Reenvío de OTP
        description: |
          Reenvía el código OTP asociado a una validación de identidad.
        body:
          application/json:
            type: !include datatypes/request/otpResendRequest.raml
            example: !include examples/request/otpResendRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpResendResponse.raml
                example: !include examples/response/otpResendResponse.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validación de OTP
        description: |
          Valida el código OTP ingresado por el cliente.
        body:
          application/json:
            type: !include datatypes/request/otpValidationRequest.raml
            example: !include examples/request/otpValidationRequest.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/otpValidationResponse.raml
                example: !include examples/response/otpValidationResponse.json
  /identityValidation:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Validación de Identidad
      description: |
        Realiza la validación de identidad del cliente en el sistema LISIM.
        Retorna un objeto JSON con información de la validación.
      body:
        application/json:
          type: !include datatypes/request/identityValidationRequest.raml
          example: !include examples/request/identityValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/identityValidationResponse.raml
              examples:
                validClient: !include examples/response/identityValidationValidResponse.json
                notValidClient: !include examples/response/identityValidationNotValidResponse.json
  /score:
    post:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Consulta de Score
      description: |
        Consulta el score del cliente a partir de una validación de identidad.
      body:
        application/json:
          type: !include datatypes/request/scoreValidationRequest.raml
          example: !include examples/request/scoreValidationRequest.json
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/scoreValidationResponse.raml
              example: !include examples/response/scoreValidationResponse.json
  /questionnaire:
    get:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Solicitud de cuestionario
      description: Solicitud de cuestionario
      queryParameters:
        IdentificationType:
          type: string
          example: "CC"
        Identification:
          type: string
          example: "1235413456"
        ValidationReg:
          type: string
          example: "?"
        LastName:
          type: string
          example: "PEREZ"
        IssueDate:
          type: string
          example: "24/09/2008 02:40:50.3456"
          minLength: 1
        FirstName?:
          type: string | nil
          example: "JUAN"
        Model?:
          type: string | nil
          example: "2"
        Department?:
          type: integer | nil
          example: 1
        City?:
          type: integer | nil
          example: 1
        Advisor?:
          type: string | nil
          example: "?"
        SalesChannel?:
          type: string | nil
          example: "?"
        Provider?:
          type: string | nil
          example: "?"
        Portal?:
          type: string | nil
          example: "?"
      responses:
        200:
          body:
            application/json:
              type: !include datatypes/response/questionnaireResponse.raml
              example: !include examples/response/questionnaireResponse.json
  /questionaries:
    /{identityValidation}:
      uriParameters:
        identityValidation:
          type: number
          example: 2652
      get:
        is: 
          - tibcoHeaders
        displayName: Solicitud de cuestionario
        description: Solicitud de cuestionario
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/get-questionaries.raml
                example: !include examples/response/get-questionaries.json
    /validation:
      post:
        is: 
          - tibcoHeaders
        securedBy: [etb_oauth_2_0]
        displayName: Validate Evidence LISIM
        description: Validate Evidence LISIM
        body:
          application/json:
            type: !include datatypes/request/evidentVerificationLISIM.raml
            example: !include examples/request/evidentVerificationLISIM.json
        responses:
          200:
            body:
              application/json:
                type: !include datatypes/response/evidentVerificationLISIM.raml
                example: !include examples/response/evidentVerificationLISIM.json
  /mecna:
    get:
      is: 
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: risk
      description: Valida si un cliente existe en listas negras MECNA; recibe datos de cliente y retorna resultado de validación.
      queryParameters:
          document_id:
            type: string
            example: "12552454"
            description: Customer identification number can be ID card or tax ID number
            required: true
          document_id_type:
            type: string
            enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
            example: "CC"
            description: Type of customer identification document
            required: true
      responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/get-risk-management.raml
                  example: !include /examples/response/get-risk-management.json
                  
/serviceOrder:
    /orquestator:
      /mobile:
        /processOrder:
          post:
            displayName: Orquestator MOBILE process order
            description: Orquestator MOBILE process order
            is: 
             - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            body:
              application/json:
                type: !include datatypes/request/post-mobile-processOrder.raml
                example: !include /examples/request/post-mobile-processOrder.json
            responses:
              200:
                body:
                  application/json:
                    example: !include /examples/response/post-mobile-processOrder.json
      /fix:
        /processOrder:
          post:
            displayName: Orquestator FIX process order
            description: Orquestator FIX process order
            is: 
             - tibcoHeaders
            securedBy: [etb_oauth_2_0]
            body:
              application/json:
                type: !include datatypes/request/post-fix-processOrder.raml
                example: !include /examples/request/post-fix-processOrder.json
            responses:
              201:
                body:
                  application/json:
                    example: !include /examples/response/post-fix-processOrder.json
/customer:
  get:
    is: 
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: getCustomer
    description: view customer 
    queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified
        CUSTOMER_ID:
          type: string
          example: "12552454"
          description: Customer identification number can be ID card or tax ID number
          required: false
        CUSTOMER_ID_TYPE:
          type: string
          enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
          example: "CC"
          description: Type of customer identification document
          required: false
        FILTERS:
          type: string
          example: "MobilePhone:3222233322;Phone:542545454;AccountNumber:12452145"
          description: String used to apply filters to the query (follow example), separate the filter type and its value with a colon, and separate the number of filters with a semicolon.
          required: false
        LIMIT:
          type: number
          description: Limit on orders to display
          required: false
        OFFSET:
          type: string
          description: used to organize information and establish a logical order
          required: false
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-customer.raml
                example: !include /examples/response/get-customer.json    
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json

/customer360:
  get:
    is:
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: getCustomer360
    description: view customer
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Parameter that allows the origin of the request to be identified
        required: false
      CUSTOMER_ID:
        type: string
        example: "12552454"
        description: Customer identification number can be ID card or tax ID number
        required: false
      CUSTOMER_ID_TYPE:
        type: string
        enum: ["CC","CE","PASAPORTE","NIT","RUT","TI"]
        example: "CC"
        description: Type of customer identification document
        required: false
      FIELDS:
        type: string
        required: false
        description: String used to 
      LIMIT:
        type: number
        description: Limit on orders to display
        required: false
      OFFSET:
        type: string
        description: used to organize information and establish a logical order
        required: false
    responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/get-customer-360.raml
              example: !include /examples/response/get-customer-360.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

/productOrder:
  post:
    is: 
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    description: |
      crea una orden de venta
    body:
      application/json:
        type: !include datatypes/request/productOrder.raml
        example: !include /examples/request/productOrder.json
    responses:
      200:
        body:
          application/json:
              type: !include datatypes/response/productOrder.raml
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
  patch:
    is: 
     - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: update order
    description: |
      actualiza una orden de venta
    body:
      application/json:
        type: !include datatypes/request/productOrder.raml
        example: !include /examples/request/productOrder.json
    responses:
      200:
        body:
          application/json:
              type: !include datatypes/response/productOrder.raml
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json
  get:
    is: 
       - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: get order
    description: obtiene una orden de venta
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Parameter that allows the origin of the request to be identified
      ORDER_NUMBER:
        type: string
        required: false
        description: Numero de orden
        example: ""
      FILTERS:
        type: string
        example: "Chanel:value;ThroughType:value;"
        description: String used to apply filters to the query (follow example), separate the filter type and its value with a colon, and separate the number of filters with a semicolon.
        required: false
      LIMIT:
        type: number
        description: Limit on orders to display
        required: true
      OFFSET:
        type: string
        description: used to organize information and establish a logical order
        required: true
    responses:
          200:
            body:
              application/json:
                type: !include /datatypes/response/get-productOrder.raml
                example: !include /examples/response/get-productOrder.json    
          400:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-400.json
          401:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-401.json
          404:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-404.json
          500:
            body:
              application/json:
                type: !include /datatypes/response/error.raml
                example: !include /examples/response/error-500.json
  /wholesale:
    /{orderNumber}:
      uriParameters:
        orderNumber:
          type: string
          description: |
            Wholesale product order identifier to cancel.
            Must be owned by the operator in the origin header.
          pattern: "MDM-MAY-\\d+"
          example: "MDM-MAY-0080"
      /cancellation:
        patch:
          displayName: Wholesale cancel product order
          description: |
            Cancels an active wholesale product order by updating its status to O117
            and notifying the Orquestador ETB via SOAP ProcesarOrden.
            Standard: TMF622 — PATCH /productOrder/{id}.
            The body is empty; the order is identified by {orderNumber} in the path.
            If the order is already cancelled (Orquestador code 10609), returns HTTP 200 with warning.

          is:
            - tibcoHeaders
          securedBy: [etb_oauth_2_0]
          headers:
            origin:
              type: string
              description: |
                Wholesale operator identifier. Used by the PAPI to validate that the
                requesting operator owns the order being cancelled.
              example: "1"
              required: true
          responses:
            200:
              body:
                application/json:
                  type: !include datatypes/response/patch-wholesale-cancel-order-response.raml
                  examples:
                    success:
                      value: !include examples/response/patch-wholesale-cancel-order-response-200.json
                    alreadyCancelled:
                      value: !include examples/response/patch-wholesale-cancel-order-response-200-warning.json
            400:
              body:
                application/json:
                  type: !include datatypes/response/error.raml
            401:
              body:
                application/json:
                  type: !include datatypes/response/error.raml
            500:
              body:
                application/json:
                  type: !include datatypes/response/error.raml
                  example: !include examples/response/error-500.json
/payment:
  post:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]

    displayName: Create Payment Transaction
    description: |
      Creates a new payment transaction for the specified payment method.
      This endpoint initiates the payment process and returns transaction details including payment URL and reference.

    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Parameter that allows the origin of the request to be identified

    body:
      application/json:
        description: Payment transaction request payload
        type: !include /datatypes/request/post-transaction.raml
        examples:
          Payu: !include examples/request/post-transaction-payu.json
          WompiTansaction: !include examples/request/post-transaction-wompiTansaction.json
          WompiCheckoutWeb: !include examples/request/post-transaction-wompiCheckoutWeb.json
          PSE: !include examples/request/post-transaction-pse.json
          Mongo: !include examples/request/post-transaction-mongo.json

    responses:
      200:
        body:
          application/json:
            type: !include /datatypes/response/post-transaction.raml
            examples:
              Payu: !include examples/response/post-transaction-payu.json
              WompiTansaction: !include examples/response/post-transaction-wompiTansaction.json
              WompiCheckoutWeb: !include examples/response/post-transaction-wompiCheckoutWeb.json
              PSE: !include examples/response/post-transaction-pse.json
              Mongo: !include examples/response/post-transaction-mongo.json
      400:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-401.json
      500:
        body:
          application/json:
            type: !include /datatypes/response/error.raml
            example: !include /examples/response/error-500.json

  /{paymentId}:
    uriParameters:
      paymentId:
        type: string
        required: true
        description: "Unique identifier of the payment transaction"
        example: "TXN-123456789"
    patch:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]

      displayName: Update Payment Transaction
      description: |
        Updates an existing payment transaction. This endpoint can be used to modify transaction status,
        add additional information, or update payment details after initial creation.

      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified

      body:
        application/json:
          type: !include /datatypes/request/patch-transaction.raml

      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/patch-transaction.raml
              examples:
                WompiTansaction: !include examples/response/patch-transaction-wompiTansaction.json
                WompiCheckoutWeb: !include examples/response/patch-transaction-wompiCheckoutWeb.json
                PSE: !include examples/response/patch-transaction-pse.json
                Mongo: !include examples/response/patch-transaction-mongo.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
              
    get:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]

      displayName: Get Transaction By ID
      description: |
        Retrieves detailed information about a specific payment transaction using its unique identifier.
        This endpoint allows tracking the status and details of previously created payment transactions.

      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified

        PAYMENT_FLOW:
          type: string
          enum: [API, CHECKOUT]
          example: "API"
          required: false
          description: Parameter that allows the origin of the request to be identified
        
        GATEWAY_PAYMENT:
          type: string
          enum: [PSE, WOMPI, PAYU, ETB]
          example: "PSE"
          required: false
          description: Parameter that allows the origin of the request to be identified

      responses:
        200:
          body:
            application/json:
              type: object
              examples:
                Payu: !include examples/response/get-transaction-payu.json
                WompiTansaction: !include examples/response/get-transaction-wompiTansaction.json
                WompiCheckoutWeb: !include examples/response/get-transaction-wompiCheckoutWeb.json
                PSE: !include examples/response/get-transaction-pse.json
                Mongo: !include examples/response/get-transaction-mongo.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
  /banks:
    get:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Get Payment Banks
      description: |
        Retrieves the list of available banks for the specified payment method.
        This endpoint is essential for providing users with bank options when initiating payment transactions.
      queryParameters:
        ORIGIN:
          type: string
          example: "WHATSAPP"
          description: Parameter that allows the origin of the request to be identified

        GATEWAY_PAYMENT:
          type: string
          enum: [PSE, WOMPI, PAYU, ETB]
          example: "PSE"
          required: false
          description: Parameter that allows the origin of the request to be identified
      responses:
        200:
          body:
            application/json:
              description: List of available banks for the payment method
              example: !include examples/response/get-banks.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json
  /webhook:
    post:
      is:
        - tibcoHeaders
      securedBy: [etb_oauth_2_0]
      displayName: Payment Transaction Webhook
      description: |
        Receives payment transaction webhook events
      body:
        application/json:
          type: object
          examples:
            payu: !include /examples/request/post-transaction-webhook-payu.json
            wompi: !include /examples/request/post-transaction-webhook-wompi.json
      responses:
        200:
          body:
            application/json:
              type: !include /datatypes/response/post-transaction-webhook.raml
              example: !include /examples/response/post-transaction-webhook.json
        400:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-400.json
        401:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-401.json
        404:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-404.json
        500:
          body:
            application/json:
              type: !include /datatypes/response/error.raml
              example: !include /examples/response/error-500.json

    /confirmation:
      /payu:
        post:
          securedBy: [etb_oauth_2_0]
          displayName: PayU Payment Confirmation Webhook
          description: Receives PayU payment confirmation notifications
          body:
            application/x-www-form-urlencoded:
              type: !include /datatypes/request/post-payu-confirmation.raml
          responses:
            200:
              body:
                application/json:
                  type: !include /datatypes/response/post-transaction-webhook.raml
                  example: !include /examples/response/post-transaction-webhook.json

/balance:
  get:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Consultar balance
    description: |
      Experience API — consulta de balance por MSISDN; delega en customer-papi-services-v2 (JSC subscription).
    queryParameters:
      ORIGIN:
        type: string
        example: "WHATSAPP"
        description: Canal de origen
        required: false
      clientIp:
        type: string
        example: "192.168.1.1"
        description: IP del cliente
        required: false
      MSISDN:
        type: string
        example: "573001234567"
        description: MSISDN de la línea
        required: true
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/get-balance.raml
            example: !include examples/response/get-balance-200.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-404.json
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-500.json

/transferBalance:
  post:
    is:
      - tibcoHeaders
    securedBy: [etb_oauth_2_0]
    displayName: Transferencia de saldo
    description: |
      Transfiere saldo entre dos líneas. Valida que los MSISDN de origen y destino existan y tengan suscripción válida antes de ejecutar la transferencia.
    body:
      application/json:
        type: !include datatypes/request/transferBalanceRequest.raml
        example: !include examples/request/transferBalanceRequest.json
    responses:
      200:
        body:
          application/json:
            type: !include datatypes/response/transferBalanceResponse.raml
            example: !include examples/response/transferBalanceResponse.json
      404:
        body:
          application/json:
            type: !include datatypes/response/error.raml
      500:
        body:
          application/json:
            type: !include datatypes/response/error.raml