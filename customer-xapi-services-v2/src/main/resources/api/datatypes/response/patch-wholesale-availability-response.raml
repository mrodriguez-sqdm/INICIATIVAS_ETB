#%RAML 1.0 DataType
type: object
properties:
  status:
    type: string
    required: true
    description: Commercial status code after availability processing.
    example: "O70"
  orderNumber:
    type: string
    required: true
    description: Wholesale product order number.
    pattern: "MDM-MAY-\\d+"
    example: "MDM-MAY-0040"
  serviceAccountId:
    type: string
    required: true
    description: Service account ID generated during availability confirmation.
    example: "GPONMAY_000002"
  description:
    type: string
    required: true
    description: Human-readable status description.
    example: "Availability OK"
