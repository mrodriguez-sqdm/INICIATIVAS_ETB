#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Questionario generado con exito
    required: false
  questions:
    type: array
    items:
      type: object
      properties:
        id:
          type: integer
          example: 95
          required: false
        description:
          type: string
          example: >-
            ¿En los ultimos seis meses, en cuantas entidades bancarias distintas
            tiene cuenta de ahorro?
          required: false
        answers:
          type: array
          items:
            type: object
            properties:
              id:
                type: integer
                example: 1
                required: false
              description:
                type: string
                example: '0'
                required: false
              questionId:
                type: integer
                example: 0
                required: false
