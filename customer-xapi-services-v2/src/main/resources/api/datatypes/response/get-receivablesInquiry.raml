#%RAML 1.0 DataType
type: object
description: |
  Account bill history from ZSmart (billHistoryQuery — v0.8).
  Default: last 6 billed billing cycles when no date range is specified.
  Max date range: 6 months between startTime and endTime.

  **Single Account (by CONNECTION_NUMBER or BILLING_ACCOUNT):**
  Returns invoice data in `accounts[0].invoices[]` array for that single account.

  **Multiple Accounts (Document Lookup by CUSTOMER_ID_TYPE + CUSTOMER_ID):**
  customer-papi resolves document to multiple billing accounts via mongo-sapi (MDM_CUENTA_FACTURACION).
  For each account, ZSmart billHistoryQuery is called independently.
  Returns array of account results in `accounts[]`, where each item contains accountNumber + invoices[].
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: 'OK'
    required: false
  result:
    type: array
    required: false
    description: |
      List of billing accounts with their invoice history.
      - Single account query (by CONNECTION_NUMBER or BILLING_ACCOUNT): array with 1 item
      - Multiple account query (by CUSTOMER_ID_TYPE + CUSTOMER_ID): array with N items (one per resolved account from MDM)
    items:
      type: object
      properties:
        accountNumber:
          type: string
          description: "Billing account number (from ZSmart or MDM_CUENTA_FACTURACION)"
          example: '14000001234'
          required: true
        lastInvoice:
          type: string
          description: "Invoice number. ZSmart: invoiceNumber"
          example: INV-2026-001234
          required: false
        invoiceDate:
          type: string
          description: "Invoice generation date YYYY-MM-DD HH:MM:SS. ZSmart: dueDate"
          example: '2026-03-01 00:00:00'
          required: false
        totalOpenAmount:
          type: object
          required: false
          description: "Sum of all pending (arrears) amounts across invoices. ZSmart source: openAmount (sum)"
          properties:
            value:
              type: string
              required: false
              description: "Raw sum of arrears. ZSmart: openAmount"
              example: '258000'
            formatted:
              type: string
              required: false
              description: "Formatted sum. ZSmart: formatOpenAmount"
              example: '$ 258,000'