#%RAML 1.0 DataType
type: object
description: Response for billingClearance (paz y salvo / applyETBCertification) operation.
properties:
  codeResponse:
    type: string
    description: "HTTP-level response code."
    example: '200'
  messageResponse:
    type: string
    description: "HTTP-level response message."
    example: OK
  resultCode:
    type: string
    description: "ZSmart operation result code. '0000' = success. -> resultCode"
    example: '0000'
  resultMsg:
    type: string
    description: "ZSmart operation result message. -> resultMsg"
    example: Success
  dueAmount:
    type: string
    description: "Customer due amount with 2 decimals. '0' if customer owes nothing. -> dueAmount"
    example: '234334.90'
