#%RAML 1.0 DataType
type: object
description: |
  Account bill history from ZSmart (billHistoryQuery — v0.8).
  Default: last 6 billed billing cycles when no date range is specified.
  Max date range: 6 months between startTime and endTime.

  **Single Account (by CONNECTION_NUMBER or BILLING_ACCOUNT):**
  Returns invoice data in `accounts[0].invoices[]` array for that single account.

  **Multiple Accounts (Document Lookup by CUSTOMER_ID_TYPE + CUSTOMER_ID):**
  customer-papi resolves document to multiple billing accounts via mongo-sapi (MDM_CUENTA_FACTURACION).
  For each account, ZSmart billHistoryQuery is called independently.
  Returns array of account results in `accounts[]`, where each item contains accountNumber + invoices[].
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: 'OK'
    required: false
  accounts:
    type: array
    required: false
    description: |
      List of billing accounts with their invoice history.
      - Single account query (by CONNECTION_NUMBER or BILLING_ACCOUNT): array with 1 item
      - Multiple account query (by CUSTOMER_ID_TYPE + CUSTOMER_ID): array with N items (one per resolved account from MDM)
    items:
      type: object
      properties:
        accountNumber:
          type: string
          description: "Billing account number (from ZSmart or MDM_CUENTA_FACTURACION)"
          example: '14000001234'
          required: true
        invoices:
          type: array
          required: false
          description: "List of invoices matching the query criteria for this account. ZSmart: billExParamList"
          items:
            type: object
            properties:
              billId:
                type: string
                description: "Bill ID. ZSmart: billID"
                example: '987654'
                required: false
              billType:
                type: string
                description: "1=Monthly invoice, 2=Sales invoice, 3=Instant Bill. ZSmart: billType"
                enum: ['1', '2', '3']
                example: '1'
                required: false
              invoiceNumber:
                type: string
                description: "Invoice number. ZSmart: billNumber"
                example: INV-2026-001234
                required: false
              accountId:
                type: string
                description: "ZSmart account ID. ZSmart: acctId"
                example: '14000001234'
                required: false
              cycleBeginDate:
                type: string
                description: "Billing cycle begin date YYYY-MM-DD HH:MM:SS. ZSmart: cycleBeginDate"
                example: '2026-02-01 00:00:00'
                required: false
              cycleEndDate:
                type: string
                description: "Billing cycle end date YYYY-MM-DD HH:MM:SS. ZSmart: cycleEndDate"
                example: '2026-02-28 23:59:59'
                required: false
              invoiceDate:
                type: string
                description: "Invoice generation date YYYY-MM-DD HH:MM:SS. ZSmart: entryDate"
                example: '2026-03-01 00:00:00'
                required: false
              dueDate:
                type: string
                description: "Payment due date YYYY-MM-DD HH:MM:SS. ZSmart: dueDate"
                example: '2026-03-15 23:59:59'
                required: false
              amount:
                type: object
                required: false
                description: "Invoice amount. ZSmart: due / formatDue"
                properties:
                  value:
                    type: string
                    description: "Raw amount. ZSmart: due"
                    example: '145000'
                    required: false
                  formatted:
                    type: string
                    description: "Formatted amount by channel unit. ZSmart: formatDue"
                    example: '$ 145,000'
                    required: false
              openAmount:
                type: object
                required: false
                description: "Amount of arrears (pending payment). ZSmart: openAmount / formatOpenAmount"
                properties:
                  value:
                    type: string
                    description: "ZSmart: openAmount"
                    example: '0'
                    required: false
                  formatted:
                    type: string
                    description: "ZSmart: formatOpenAmount"
                    example: '$ 0'
                    required: false
              paidAmount:
                type: object
                required: false
                description: "Paid amount during the billing period. ZSmart: paidCharge / formatPaidCharge"
                properties:
                  value:
                    type: string
                    description: "ZSmart: paidCharge"
                    example: '145000'
                    required: false
                  formatted:
                    type: string
                    description: "ZSmart: formatPaidCharge"
                    example: '$ 145,000'
                    required: false
              status:
                type: string
                description: "Derived from openAmount: Pagada (openAmount=0), Pendiente (openAmount>0)"
                example: Pagada
                required: false
              currencyCode:
                type: string
                description: "Currency code. ZSmart: currencyCode"
                example: COP
                required: false
              downloadUrl:
                type: string
                description: "PDF invoice download URL. ZSmart: downloadUrl"
                example: 'https://billing.etb.net.co/invoices/INV-2026-001234.pdf'
                required: false
