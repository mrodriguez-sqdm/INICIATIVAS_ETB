#%RAML 1.0 DataType
# Wholesale Status Order — response contract
# Endpoint: GET /v2/productOrder/wholesale/{orderNumber}
# Standard: TMF622 — Product Ordering Management

type: object
properties:
  status:
    type: string
    required: true
    description: |
      Commercial status code of the product order.
      I10–I69: creation in progress
      O70–O89: availability confirmed
      A90–A99: scheduling confirmed
      P00–P99: provisioning / activation
    example: "O75"

  orderNumber:
    type: string
    required: true
    description: Wholesale product order identifier.
    pattern: "MDM-MAY-\\d+"
    example: "MDM-MAY-000001"

  serviceAccountId:
    type: string
    required: false
    description: |
      Service account ID generated during availability confirm.
      May be empty if availability has not been processed yet.
    example: "GPONMAY_000002"
