#%RAML 1.0 DataType
# Wholesale Cancel Order — success response contract
# Migrated from: operations-papi-services/datatypes/responses/postCancelOrder.raml

type: object
properties:
  status:
    type: string
    required: true
    description: |
      Result of the cancellation operation.
      SUCCESS : cancellation processed successfully by Orquestador.
      OK : cancellation processed with warning
           (Orquestador code 10609 — already cancelled).
    enum: [ SUCCESS, OK ]
    example: "SUCCESS"

  orderNumber:
    type: string
    required: true
    description: |
      Wholesale product order identifier. Matches the {orderNumber} path param.
    pattern: "MDM-MAY-\\d+"
    example: "MDM-MAY-0080"

  serviceAccountId:
    type: string
    required: false
    description: |
      Service account ID from Servicio_Tramite.Id_Cuenta_Servicio in MDM_CD_ORDEN.
      Present if availability was previously confirmed for this order.
    example: "GPONMAY_000002"

  message:
    type: string
    required: false
    description: |
      Warning message from Orquestador.
      Only present when status is "OK" (code 10609).
    example: "Orden ya se encuentra en estado de cancelacion"
