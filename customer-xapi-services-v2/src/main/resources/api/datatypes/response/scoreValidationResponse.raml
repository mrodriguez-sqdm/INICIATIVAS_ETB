#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: validacion exitosa
    required: false
  result:
    type: object
    properties:
      score:
        type: integer
        example: 842
        required: false
      offer:
        type: string
        example: Toda la Oferta
        required: false
