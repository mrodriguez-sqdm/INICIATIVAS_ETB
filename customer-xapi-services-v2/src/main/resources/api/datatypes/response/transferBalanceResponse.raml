#%RAML 1.0 DataType
displayName: Transfer Balance Response
type: object
properties:
  codigo:
    type: string
    example: "OK"
  topupDonor:
    type: string
    description: Identificador de la recarga del donante
    example: "1508758"
  topupDonee:
    type: string
    description: Identificador de la recarga del receptor
    example: "1508761"
  description:
    type: string
    example: "Transferencia de saldo exitosa"
