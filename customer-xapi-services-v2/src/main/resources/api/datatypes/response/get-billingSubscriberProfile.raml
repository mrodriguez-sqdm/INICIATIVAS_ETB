#%RAML 1.0 DataType
type: object
description: Response for querySubscriberProfile operation. Returns the current profile of a subscriber in ZSmart.
properties:
  codeResponse:
    type: string
    description: "HTTP-level response code."
    example: '200'
  messageResponse:
    type: string
    description: "HTTP-level response message."
    example: OK
  resultCode:
    type: string
    description: "ZSmart operation result code. '0000' = success. -> resultCode"
    example: '0000'
  resultMsg:
    type: string
    description: "ZSmart operation result message. -> resultMsg"
    example: Success
  subscriberProfile:
    type: object
    description: "Subscriber profile detail. -> subscriberProfile"
    properties:
      serviceNumber:
        type: string
        description: "Service number of the subscriber. -> subscriberProfile.serviceNumber"
        example: '6015551234'
      state:
        type: string
        description: "Current network state. A=Active, D=One-Way Block, E=Two-Way Block, G=Valid(pre-active/inactive), B=Termination. -> subscriberProfile.state"
        example: A
      activeDate:
        type: string
        description: "First activation date of the subscription. -> subscriberProfile.activeDate"
        example: '2026-01-15'
      updateDate:
        type: string
        description: "Last update date of the subscription. -> subscriberProfile.updateDate"
        example: '2026-03-10'
      accountCode:
        type: string
        description: "Billing account code. -> subscriberProfile.accountCode"
        example: '14000001234'
      custCode:
        type: string
        description: "Customer code in ZSmart. -> subscriberProfile.custCode"
        example: '12345678'
      customerName:
        type: string
        description: "Full name of the customer using the service. -> subscriberProfile.customerName"
        example: Juan Perez
      preFlag:
        type: string
        description: "Subscriber type. Y=Prepaid, N=Postpaid, 3=Hybrid. -> subscriberProfile.preFlag"
        example: 'N'
      prodInstId:
        type: string
        description: "CRM product instance ID (service ID). -> subscriberProfile.prodInstId"
        example: '987654321'
      balList:
        type: array
        required: false
        description: "Balance list of the subscriber. -> subscriberProfile.balList"
        items:
          type: object
          properties:
            balId:
              type: string
              description: "Balance instance ID. -> balId"
              example: '1105'
            acctResCode:
              type: string
              description: "Balance type code (e.g. LOCAL_CURRENCY, DATA_QUOTA_MONTHLY). -> acctResCode"
              example: LOCAL_CURRENCY
            acctResName:
              type: string
              description: "Balance type name. -> acctResName"
              example: Local Currency
            unitType:
              type: string
              description: "Unit type: Currency, Data, Voice, SMS. -> unitType"
              example: Currency
            currencyType:
              type: string
              required: false
              description: "Currency type when unitType=Currency. USD or PSO (PESO). -> currencyType"
              example: PSO
            balance:
              type: string
              description: "Current available balance. Negative=credit (company owes customer), positive=debt (customer owes). 'UL' if unlimited. -> balance"
              example: '-145000.000000'
            effDate:
              type: string
              description: "Effective date of the balance. YYYY-MM-DD HH:MM:SS. -> effDate"
              example: '2026-01-01 00:00:00'
            expDate:
              type: string
              required: false
              description: "Expiration date of the balance. YYYY-MM-DD HH:MM:SS. -> expDate"
              example: '2049-12-31 23:59:59'
            updateDate:
              type: string
              required: false
              description: "Date of latest update. YYYY-MM-DD HH:MM:SS. -> updateDate"
              example: '2026-03-10 13:56:44'
            offerCode:
              type: string
              required: false
              description: "Offer code that granted this balance. -> offerCode"
              example: PLAN_POSTPAGO_50GB
            offerName:
              type: string
              required: false
              description: "Offer name that granted this balance. -> offerName"
              example: Plan Postpago 50GB
      additionalOfferList:
        type: array
        required: false
        description: "Additional offer (VA/addon) list active for the subscriber. -> additionalOfferList"
        items:
          type: object
          properties:
            offerCode:
              type: string
              description: "Offer code. -> offerCode"
              example: VA_ROAMING_AMERICAS
            offerName:
              type: string
              description: "Offer name. -> offerName"
              example: Roaming Americas
            effDate:
              type: string
              description: "Effective date. YYYY-MM-DD HH:MM:SS. -> effDate"
              example: '2026-02-01 00:00:00'
            expDate:
              type: string
              required: false
              description: "Expiry date. YYYY-MM-DD HH:MM:SS. -> expDate"
              example: '2026-08-01 23:59:59'
            saleListPrice:
              type: string
              required: false
              description: "One-off sale list price. -> saleListPrice"
              example: '0'
            rentListPrice:
              type: string
              required: false
              description: "Recurring rent list price. Value > 0 means recurring IPP. -> rentListPrice"
              example: '15000'
            offerAttrList:
              type: array
              required: false
              description: "Attribute list of the additional offer. -> offerAttrList"
              items:
                type: object
                properties:
                  attrCode:
                    type: string
                    description: "Attribute code. -> attrCode"
                    example: PLAN_CODE
                  attrName:
                    type: string
                    description: "Attribute name. -> attrName"
                    example: Subscription Plan
                  attrValue:
                    type: string
                    description: "Attribute value. -> attrValue"
                    example: ROAMING_AMERICAS_MONTHLY
      prodAttrList:
        type: array
        required: false
        description: "Attribute list of the main product (independent product). -> prodAttrList"
        items:
          type: object
          properties:
            attrCode:
              type: string
              description: "Attribute code of the main product. -> attrCode"
              example: PLAN_CODE
            attrName:
              type: string
              description: "Attribute name. -> attrName"
              example: Subscription Plan
            attrValue:
              type: string
              description: "Attribute value. -> attrValue"
              example: PLAN_POSTPAGO_50GB
