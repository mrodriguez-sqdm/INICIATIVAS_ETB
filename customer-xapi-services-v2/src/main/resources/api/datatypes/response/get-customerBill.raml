#%RAML 1.0 DataType
type: object
description: |
  Unified Customer Bill response supporting customer bill from RMCA
  and ZSMART queryBillHistory, queryInvoicePDF and queryBillPDF structures:
  - RMCA Customer Bill response includes invoices details (value, payment and adjustments).
  - ZSMART queryBillHistory response includes accounts details and summary details.
  - ZSMART queryBillPDF response includes billing PDF details.
  - ZSMART queryInvoicePDF response includes invoice PDF details.
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: ''
    required: false
  invoices:
    type: array
    required: false
    description: |
      Invoices array, container for customer bill invoices. Used for RMCA customerBill.
    items:
      type: object
      properties:
        billingNumber:
          type: string
          example: '5879271031187'
          required: false
        billingDate:
          type: date-only
          example: '2024-11-01'
          required: false
        dueDate:
          type: date-only
          example: '2024-11-15'
          required: false
        status:
          type: string
          example: Pagada
          required: false
        value:
          type: object
          properties:
            amount:
              type: integer
              example: 145000
              required: false
            currency:
              type: string
              example: COP
              required: false
            formatted:
              type: string
              example: $ 145,000
              required: false
        payments:
          type: array
          items:
            type: object
            properties:
              paymentDate:
                type: date-only
                example: '2024-11-10'
                required: false
              amount:
                type: integer
                example: 145000
                required: false
              type:
                type: string
                example: Efectivo
                required: false
        adjustments:
          type: array
          items:
            type: object
            properties:
              adjustmentDate:
                type: string
                example: ''
                required: false
              amount:
                type: integer
                example: 5454
                required: false
              type:
                type: string
                example: ''
                required: false
              description:
                type: string
                example: ''
                required: false
  file:
    type: object
    required: false
    description: |
      Invoice link file object, container for customer bill invoice link. Used for RMCA customerBill.{
    properties:
      link:
        type: string
        required: false
        description: Invoice file link 
        example: ".../invoices/files?link=6f0b61c1d2d4e0f8a34d9d9d3d0f2f4b3e5a6c7d8e9f0a1b2c3d4e5f6a7b8c9d"
  billingInvoicePdf:
    type: object
    required: false
    description: |
      Billing Invoice PDF Object, used for ZSMART RqueryBillPDF and queryInvoicePDF.
    properties:
      transactionID:
        type: string
        description: transaction Id
        example: "9865563215487"
        required: false
      uuid:
        type: string
        description: Invoice document identifier
        example: "INV0001"
        required: false
      timeSignature:
        type: string
        description: Time when the signature of the document was made
        example: "2026-04-30 10:37:13"
        required: false
      documentNumber:
        type: string
        description: Invoice document number
        example: "14000001234"
        required: false
      documentName:
        type: string
        description: Invoice document name
        example: "INV-001.pdf"
        required: false
      invoice:
        type: string
        description: |
          Binary content of the invoice document (invoice/CFDI).
          In the source API (backend), this field is defined as `byte[]`
          (Java). Since the transport is JSON, a `byte[]` has no
          native representation and is serialized as a **Base64 string**
          (standard behavior of Jackson/Gson and RAML, which does not have 
          a `byte[]` type).
          The consumer must decode this string with Base64 to
          obtain the actual binary of the invoice.
          
          **Validation note (confirmed with a real API sample):**
          The decoded content corresponds to a **PDF** (signature
          `%PDF-1.4`), regardless of the extension indicated in
          `documentName` (which arrives as `.xml` in the source system).
          Do not use `documentName` to infer the actual content type;
          the consumer should always treat `invoice` as a PDF.
        example: "JVBERi0xLjQKJcOkw7zDtsO2CjIgMCBvYmoK... (Base64, ~20000+ chars)"
        required: false  
  accounts:
    type: array
    required: false
    description: |
      List of billing accounts with their invoice history.
      - Single account query (by CONNECTION_NUMBER or BILLING_ACCOUNT): array with 1 item
      - Multiple account query (by CUSTOMER_ID_TYPE + CUSTOMER_ID): array with N items (one per resolved account from MDM)
    items:
      type: object
      properties:
        accountNumber:
          type: string
          description: "Billing account number (from ZSmart or MDM_CUENTA_FACTURACION)"
          example: '14000001234'
          required: true
        invoices:
          type: array
          required: false
          description: "List of invoices matching the query criteria for this account. ZSmart: billExParamList"
          items:
            type: object
            properties:
              billId:
                type: string
                description: "Bill ID. ZSmart: billID"
                example: '987654'
                required: false
              billType:
                type: string
                description: "1=Monthly invoice, 2=Sales invoice, 3=Instant Bill. ZSmart: billType"
                enum: ['1', '2', '3']
                example: '1'
                required: false
              invoiceNumber:
                type: string
                description: "Invoice number. ZSmart: billNumber"
                example: INV-2026-001234
                required: false
              accountId:
                type: string
                description: "ZSmart account ID. ZSmart: acctId"
                example: '14000001234'
                required: false
              cycleBeginDate:
                type: string
                description: "Billing cycle begin date YYYY-MM-DD HH:MM:SS. ZSmart: cycleBeginDate"
                example: '2026-02-01 00:00:00'
                required: false
              cycleEndDate:
                type: string
                description: "Billing cycle end date YYYY-MM-DD HH:MM:SS. ZSmart: cycleEndDate"
                example: '2026-02-28 23:59:59'
                required: false
              invoiceDate:
                type: string
                description: "Invoice generation date YYYY-MM-DD HH:MM:SS. ZSmart: entryDate"
                example: '2026-03-01 00:00:00'
                required: false
              dueDate:
                type: string
                description: "Payment due date YYYY-MM-DD HH:MM:SS. ZSmart: dueDate"
                example: '2026-03-15 23:59:59'
                required: false
              amount:
                type: object
                required: false
                description: "Invoice amount. ZSmart: due / formatDue"
                properties:
                  value:
                    type: string
                    description: "Raw amount. ZSmart: due"
                    example: '145000'
                    required: false
                  formatted:
                    type: string
                    description: "Formatted amount by channel unit. ZSmart: formatDue"
                    example: '$ 145,000'
                    required: false
              openAmount:
                type: object
                required: false
                description: "Amount of arrears (pending payment). ZSmart: openAmount / formatOpenAmount"
                properties:
                  value:
                    type: string
                    description: "ZSmart: openAmount"
                    example: '0'
                    required: false
                  formatted:
                    type: string
                    description: "ZSmart: formatOpenAmount"
                    example: '$ 0'
                    required: false
              paidAmount:
                type: object
                required: false
                description: "Paid amount during the billing period. ZSmart: paidCharge / formatPaidCharge"
                properties:
                  value:
                    type: string
                    description: "ZSmart: paidCharge"
                    example: '145000'
                    required: false
                  formatted:
                    type: string
                    description: "ZSmart: formatPaidCharge"
                    example: '$ 145,000'
                    required: false
              status:
                type: string
                description: "Derived from openAmount: Pagada (openAmount=0), Pendiente (openAmount>0)"
                example: Pagada
                required: false
              currencyCode:
                type: string
                description: "Currency code. ZSmart: currencyCode"
                example: COP
                required: false
              downloadUrl:
                type: string
                description: "PDF invoice download URL. ZSmart: downloadUrl"
                example: 'https://billing.etb.net.co/invoices/INV-2026-001234.pdf'
                required: false
        summary:
          type: object
          required: false
          description: |
            Aggregated totals and payment status across all invoices[] for this account.
            Present only when invoices[] contains more than one invoice.
            All monetary values are summed as numbers and formatted by MuleSoft.

            **status derivation rule (evaluated in priority order):**
            1. totalOpenAmount == "0"                                  → "Al día"
            2. totalOpenAmount > 0 AND any invoice dueDate < now()     → "Vencido"
            3. totalOpenAmount > 0 AND all invoice dueDates >= now()   → "Pendiente"

            **nextDueDate derivation rule:**
            min(dueDate) among invoices where openAmount > 0.
            null when status is "Al día" (no pending invoices).
          properties:
            accountNumber:
              type: string
              required: false
              description: |
                Billing account number. Populated only when BILLING_ACCOUNT is the sole
                search key in the request — confirms which account the summary belongs to.
                Omitted for CONNECTION_NUMBER or CUSTOMER_ID_TYPE+CUSTOMER_ID searches
                (accountNumber is already the top-level key of the accounts[] item).
              example: '14000001234'
            invoiceCount:
              type: integer
              required: false
              description: "Total number of invoices returned for this account."
              example: 3
            status:
              type: string
              required: false
              enum: ['Al día', 'Pendiente', 'Vencido']
              description: |
                Overall payment status derived by MuleSoft (not from ZSmart).
                - "Al día"   : totalOpenAmount == 0 — no pending debt across all invoices
                - "Pendiente": totalOpenAmount > 0 AND all pending dueDate >= today
                - "Vencido"  : totalOpenAmount > 0 AND at least one pending dueDate < today
              example: 'Vencido'
            nextDueDate:
              type: string
              required: false
              description: |
                Earliest dueDate among invoices with openAmount > 0 (most urgent debt).
                Format: YYYY-MM-DD HH:MM:SS. Null when status is "Al día".
              example: '2026-01-15 23:59:59'
            totalDue:
              type: object
              required: false
              description: "Sum of all invoice amounts (due). ZSmart source: due (sum)"
              properties:
                value:
                  type: string
                  required: false
                  description: "Raw sum. ZSmart: due"
                  example: '403000'
                formatted:
                  type: string
                  required: false
                  description: "Formatted sum by channel unit. ZSmart: formatDue"
                  example: '$ 403,000'
            totalOpenAmount:
              type: object
              required: false
              description: "Sum of all pending (arrears) amounts across invoices. ZSmart source: openAmount (sum)"
              properties:
                value:
                  type: string
                  required: false
                  description: "Raw sum of arrears. ZSmart: openAmount"
                  example: '258000'
                formatted:
                  type: string
                  required: false
                  description: "Formatted sum. ZSmart: formatOpenAmount"
                  example: '$ 258,000'
            totalPaidAmount:
              type: object
              required: false
              description: "Sum of all paid amounts across invoices. ZSmart source: paidCharge (sum)"
              properties:
                value:
                  type: string
                  required: false
                  description: "Raw sum of paid charges. ZSmart: paidCharge"
                  example: '145000'
                formatted:
                  type: string
                  required: false
                  description: "Formatted sum. ZSmart: formatPaidCharge"
                  example: '$ 145,000'
            totalAdjustCharge:
              type: object
              required: false
              description: "Sum of all adjustments/credits across invoices. ZSmart source: adjustCharge (sum)"
              properties:
                value:
                  type: string
                  required: false
                  description: "Raw sum of adjustments. ZSmart: adjustCharge"
                  example: '0'
                formatted:
                  type: string
                  required: false
                  description: "Formatted sum. ZSmart: formatAdjustCharge"
                  example: '$ 0'
            currencyCode:
              type: string
              required: false
              description: "Currency code shared by all invoices in this account. ZSmart: currencyCode"
              example: 'COP'
examples: 
  RMCA_CUSTOMER_BILL_INVOICES: !include ../../examples/response/get-customerBill-invoices.json
  RMCA_CUSTOMER_BILL_INVOICE_LINK: !include ../../examples/response/get-customerBill-invoices-link.json
  ZSMART_CUSTOMER_BILL_PDF: !include ../../examples/response/get-customerBill-billPdf.json
  ZSMART_CUSTOMER_INVOICE_PDF: !include ../../examples/response/get-customerBill-invoicePdf.json
  ZSMART_CUSTOMER_BILLING_HISTORY: !include ../../examples/response/get-customerBill-billingHistory.json