#%RAML 1.0 DataType
type: object
description: Billing Invoice PDF Response
properties:
  codeResponse:
    type: string
    example: "200"
    required: false
  messageResponse:
    type: string
    example: "OK"
    required: false
  billingInvoicePdf:
    type: object
    required: false
    description:
    properties:
      transactionID:
        type: string
        description: transaction Id
        example: "9865563215487"
        required: true
      uuid:
        type: string
        description: Invoice document identifier
        example: "INV0001"
        required: true
      timeSignature:
        type: string
        description: Time when the signature of the document was made
        example: "2026-04-30 10:37:13"
        required: false
      documentNumber:
        type: string
        description: Invoice document number
        example: "14000001234"
        required: true
      documentName:
        type: string
        description: Invoice document name
        example: "INV-001.pdf"
        required: false
      invoice:
        type: string
        description: |
          Contenido binario del documento de factura (invoice/CFDI).
          En la API origen (backend) este campo está definido como `byte[]`
          (Java). Dado que el transporte es JSON, un `byte[]` no tiene
          representación nativa y se serializa como **string Base64**
          (comportamiento estándar de Jackson/Gson y de RAML, que no posee
          un tipo `byte[]`).
          El consumidor debe decodificar este string con Base64 para
          obtener el binario real del comprobante.

          **Nota de validación (confirmada con muestra real del API):**
          el contenido decodificado corresponde a un **PDF** (firma
          `%PDF-1.4`), independientemente de la extensión indicada en
          `documentName` (que en el sistema origen llega como `.xml`).
          No usar `documentName` para inferir el tipo de contenido real;
          el consumidor debe tratar `invoice` siempre como PDF.
        example: "JVBERi0xLjQKJcOkw7zDtsO2CjIgMCBvYmoK... (Base64, ~20000+ chars)"
        required: true
examples:
  postpaidExample:
    displayName: POSTPAID - Bill PDF (queryBillPDF)
    value: !include ../../examples/response/get-billingInvoicePdf-postpaid.json
  prepaidExample:
    displayName: PREPAID - Invoice PDF (queryInvoicePDF)
    value: !include ../../examples/response/get-billingInvoicePdf-prepaid.json