#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Services retrieved successfully
    required: false
  result:
    type: object
    properties:
      gateway:
        type: string
        example: WOMPI
        required: false
      transactionId:
        type: string
        example: 1292-1602113476-10985
        required: false
      reference:
        type: string
        example: ORDER-2024-001
        required: false
      orderId:
        type: string
        example: '1400449660'
        required: false
      status:
        type: string
        example: PENDING
        required: false
      statusMessage:
        type: string
        example: Transaction is being processed
        required: false
      amount:
        type: integer
        example: 50000
        required: false
      currency:
        type: string
        example: COP
        required: false
      customerEmail:
        type: string
        example: juan@example.com
        required: false
      paymentMethodType:
        type: string
        example: CARD
        required: false
      authorizationCode:
        type: string
        example: '123238'
        required: false
      traceabilityCode:
        type: string
        example: CRED - 666039677
        required: false
      redirectUrl:
        type: string
        example: https://registro.pse.com.co/PSENF/StartTransaction?id=AC3738B2AE8743E
        required: false
      createdAt:
        type: datetime
        example: '2024-01-15T14:30:45.000Z'
        required: false
      updatedAt:
        type: datetime
        example: '2020-08-16T20:40:36.667Z'
        required: false
      merchant:
        type: object
        required: false
        properties:
          id:
            type: string
            example: pub_prod_xxx
            required: false
          name:
            type: string
            example: Mi Comercio
            required: false
          legalName:
            type: string
            example: Mi Comercio SAS
            required: false
      paymentMethod:
        type: object
        required: false
        properties:
          type:
            type: string
            example: CARD
            required: false
          brand:
            type: string
            example: VISA
            required: false
          lastFour:
            type: string
            example: '4242'
            required: false
      gatewayResponse:
        type: object
        required: false
        properties:
          paymentNetwork:
            type: string
            example: CREDIBANCO
            required: false
          responseCode:
            type: string
            example: APPROVED
            required: false
          networkResponseCode:
            type: string
            example: '81'
            required: false
          bankReferenceCode:
            type: string
            example: CREDIT
            required: false
          transactionCycle:
            type: integer
            example: 1
            required: false
