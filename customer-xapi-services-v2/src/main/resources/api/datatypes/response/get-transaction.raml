#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: Transaction retrieved successfully
    required: false
  result:
    type: object
    properties:
      id:
        type: string
        example: 67c6f9e2b9d1a1c2e4a12345
        required: false
      gateway:
        type: string
        example: WOMPI
        required: false
      transactionId:
        type: string
        example: 1292-1602113476-10985
        required: false
      CUS:
        type: string
        example: link_prod_8f3b9c2a1d
        required: false
      references:
        type: object
        required: false
        properties:
          reference:
            type: string
            example: ORDER-2024-002
            required: false
          description:
            type: string
            example: Consolidated service payment
            required: false
          currency:
            type: string
            example: COP
            required: false
          amountToPay:
            type: string
            example: '120000'
            required: false
          taxes:
            type: array
            required: false
            items:
              type: object
              properties:
                type:
                  type: string
                  example: IVA
                  required: false
                percentage:
                  type: integer
                  example: 19
                  required: false
                value:
                  type: string
                  example: '19000'
                  required: false
          referenceDetails:
            type: array
            required: false
            items:
              type: object
              properties:
                reference:
                  type: string
                  example: FAC-1001
                  required: false
                description:
                  type: string
                  example: Internet service payment
                  required: false
                currency:
                  type: string
                  example: COP
                  required: false
                amountToPay:
                  type: string
                  example: '60000'
                  required: false
                taxes:
                  type: array
                  required: false
                  items:
                    type: object
                    properties:
                      type:
                        type: string
                        example: IVA
                        required: false
                      percentage:
                        type: integer
                        example: 19
                        required: false
                      value:
                        type: string
                        example: '11400'
                        required: false
      status:
        type: string
        example: PENDING
        required: false
      statusMessage:
        type: string
        example: Transaction processed successfully
        required: false
      amount:
        type: integer
        example: 3000000
        required: false
      taxAmount:
        type: integer
        example: 100000
        required: false
      currency:
        type: string
        example: COP
        required: false
      description:
        type: string
        example: Internet service payment
        required: false
      authorizationCode:
        type: string
        example: '170921'
        required: false
      traceabilityCode:
        type: string
        example: '77821'
        required: false
      paymentMethod:
        type: object
        required: false
        properties:
          type:
            type: string
            example: CARD
            required: false
          installments:
            type: integer
            example: 1
            required: false
      customer:
        type: object
        required: false
        properties:
          fullName:
            type: string
            example: Juan Perez
            required: false
          email:
            type: string
            example: juan@example.com
            required: false
          documentType:
            type: string
            example: CC
            required: false
          documentNumber:
            type: string
            example: '111111111'
            required: false
          phoneNumber:
            type: string
            example: '3000000000'
            required: false
          address:
            type: string
            example: Calle 3 1c-37
            required: false
          userType:
            type: string
            example: person
            required: false
      bank:
        type: object
        required: false
        properties:
          entityCode:
            type: string
            example: '8349032221'
            required: false
          financialInstitutionCode:
            type: string
            example: '1007'
            required: false
          serviceCode:
            type: string
            example: '1002'
            required: false
          entityName:
            type: string
            example: BANCOLOMBIA
            required: false
      shippingAddress:
        type: object
        required: false
        properties:
          addressLine1:
            type: string
            example: Calle 45 23 - 10
            required: false
          city:
            type: string
            example: Bogotá
            required: false
          region:
            type: string
            example: Cundinamarca
            required: false
          country:
            type: string
            example: CO
            required: false
          phoneNumber:
            type: string
            example: '573307654321'
            required: false
      redirectUrl:
        type: string
        example: https://registro.pse.com.co/PSENF/StartTransaction
        required: false
      imageUrl:
        type: string
        example: https://micomercio.co/tienda/logo
        required: false
      sku:
        type: string
        example: CDX-812345-1ADD
        required: false
      active:
        type: boolean
        example: true
        required: false
      expiresAt:
        type: datetime-only
        example: '2022-12-10T14:30:00'
        required: false
      createdAt:
        type: string
        example: '2018-07-01T23:49:45Z'
        required: false
      processedAt:
        type: string
        example: '2020-07-14T18:10:55Z'
        required: false
      updatedAt:
        type: string
        example: '2026-03-04T18:30:02Z'
        required: false
      registrationDate:
        type: string
        example: '2026-03-05T10:30:00Z'
        required: false
      gatewayResponseDate:
        type: string
        example: '2026-03-05T10:30:00Z'
        required: false
      lastUpdateDate:
        type: string
        example: '2026-03-05T10:30:00Z'
        required: false
      transactionCycle:
        type: integer
        example: 1
        required: false
      gatewayResponse:
        type: object
        required: false
        properties:
          paymentNetworkResponseCode:
            type: string
            example: '000'
            required: false
          responseCode:
            type: string
            example: APPROVED
            required: false
          pendingReason:
            type: 'null'
            example: null
            required: false
          errorCode:
            type: 'null'
            example: null
            required: false
          operationDate:
            type: integer
            example: 1620069958670
            required: false
