#%RAML 1.0 DataType
# The design says this must be an exact copy of the existing
# post-interaction-201-Response.raml, but the PDF does not include
# the complete original datatype. These are the fields explicitly
# shown in the design's HTTP 201 example.

type: object
properties:
  status:
    type: string
    required: true
    description: Commercial order status.
    example: "I20"

  orderNumber:
    type: string
    required: true
    description: Wholesale order number generated for the transaction.
    example: "MDM-MAY-0000001"

  description:
    type: string
    required: false
    description: Human-readable description of the resulting order state.
    example: "Coverage OK"
