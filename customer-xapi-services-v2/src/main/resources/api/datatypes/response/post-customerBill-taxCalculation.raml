#%RAML 1.0 DataType 
type: object
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: ''
    required: false
  taxCalculation:
    type: object
    properties:
      accountId:
        type: string
        required: true
        description: Account Id of input.
        example: "120090090"
      accountName:
        type: string
        required: true
        description: Account name of related device.
        example: "120090090"
      chargeList:
        type: array
        required: true
        items:
          type: object
          properties:
            sequence:
              type: string
              description: sequence of the request
              example: '1'
              required: false
              minLength: 1
              maxLength: 5
            basicCharge:
              type: string
              description: This value of charge before tax, the amount should be positive, unit is peso, value is the amount with 2 decimal. For example, 1000 PESO should be sent by 1000.00. 
              example: '1000.00'
              required: true
              minLength: 1
              maxLength: 30
            acctItemTypeCode:
              type: string
              description: Acct item type code, it will not respond in case of no penalty.
              example: AIT-MONTHLY_FEE
              required: true
              minLength: 1
              maxLength: 30
            taxList:
              type: array
              required: false
              items:
                type: object
                properties:
                  taxType:
                    type: string
                    required: true
                    minLength: 1
                    maxLength: 6
                    description: |
                      Tax type, possible values:
                      1:VAT
                      2:ICO
                      21:STAMP TYPE
                    example: "1"
                  taxRate:
                    type: string
                    required: true
                    minLength: 1
                    maxLength: 6
                    description: |
                      Tax Rate, calculated over taxType:
                      19.00
                      0.00
                      4.00
                    example: '19.00'
                  taxAmount:
                    type: string
                    description: This value of charge before tax, the amount should be positive, unit is peso, value is the amount with 2 decimal. For example, 1000 PESO should be sent by 1000.00. 
                    example: '1000.00'
                    required: true
                    minLength: 1
                    maxLength: 30
example: !include ../../examples/response/post-customerBill-taxCalculation.json