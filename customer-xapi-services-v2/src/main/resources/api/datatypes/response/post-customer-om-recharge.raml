#%RAML 1.0 DataType
type: object
properties:
  codeResponse:
    type: string
    example: '200'
    required: false
  messageResponse:
    type: string
    example: 'OK'
    required: false
  id:
    type: string
    required: true
    example: "12345"
  status:
    type: string
    required: true
    example: "Successful"

example: !include ../../examples/response/post-customer-om-recharge.json