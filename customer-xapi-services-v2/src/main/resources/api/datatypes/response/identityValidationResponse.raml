#%RAML 1.0 DataType 
type: object
properties:
  code:
    type: string
    example: '200'
    required: false
  message:
    type: string
    example: validacion exitosa
    required: false
  result:
    type: object
    properties:
      id:
        type: integer
        example: 13985
        required: false
      type:
        type: integer
        example: 1
        required: false
      questions:
        type: 'null'
        example: null
        required: false
      otpCode:
        type: string
        example: '2630'
        required: false
      matchType:
        type: integer
        example: 1
        required: false
