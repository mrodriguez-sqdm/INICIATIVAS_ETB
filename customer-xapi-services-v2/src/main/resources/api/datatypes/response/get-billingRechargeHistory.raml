#%RAML 1.0 DataType
type: object
description: |
  Query Recharge history from ZSmart (billRechargeHistory — v0.8).
  Default: last 30 days when no date range is specified.
properties:
  codeResponse:
    type: string
    example: "200"
  messageResponse:
    type: string
    example: "OK"
  serviceNumber:
    type: string
    example: "5618014487670"
  recharges:
    type: array
    items:
      type: object
      properties:
        channelId:
          type: string
          example: "POS"
        amount:
          type: string
          example: "10000"
        beforeAmount:
          type: string
          example: "5000"
        beforeExpireDate:
          type: string
          required: false
          example: "2026-04-19 23:59:59"
        afterAmount:
          type: string
          example: "15000"
        afterExpireDate:
          type: string
          required: false
          example: "2026-04-19 23:59:59"
        dealerCode:
          type: string
          required: false
          example: "ETB_DEALER_001"
        rechargeDate:
          type: string
          example: "2026-03-19 10:32:45"
    