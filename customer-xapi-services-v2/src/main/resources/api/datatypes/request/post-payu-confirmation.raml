#%RAML 1.0 DataType

type: object
additionalProperties: true

description: |
  PayU Confirmation URL payload.

  Minimum required fields for signature validation:
  - merchant_id
  - reference_sale
  - value
  - currency
  - state_pol
  - sign

properties:
  response_code_pol:
    type: string
    required: false
    example: "5"

  phone:
    type: string
    required: false
    example: ""

  additional_value:
    type: string
    required: false
    example: "0.00"

  test:
    type: string
    required: false
    example: "1"

  transaction_date:
    type: string
    required: false
    example: "2015-05-27 13:07:35"

  cc_number:
    type: string
    required: false
    example: "************0004"

  cc_holder:
    type: string
    required: false
    example: "test_buyer"

  error_code_bank:
    type: string
    required: false
    example: ""

  billing_country:
    type: string
    required: false
    example: "CO"

  bank_referenced_name:
    type: string
    required: false
    example: ""

  description:
    type: string
    required: false
    example: "test_payu_01"

  administrative_fee_tax:
    type: string
    required: false
    example: "0.00"

  value:
    type: string
    required: true
    example: "100.00"

  administrative_fee:
    type: string
    required: false
    example: "0.00"

  payment_method_type:
    type: string
    required: false
    example: "2"

  office_phone:
    type: string
    required: false
    example: ""

  email_buyer:
    type: string
    required: false
    example: "test@payulatam.com"

  response_message_pol:
    type: string
    required: false
    example: "ENTITY_DECLINED"

  error_message_bank:
    type: string
    required: false
    example: ""

  shipping_city:
    type: string
    required: false
    example: ""

  transaction_id:
    type: string
    required: false
    example: "f5e668f1-7ecc-4b83-a4d1-0aaa68260862"

  sign:
    type: string
    required: true
    example: "e1b0939bbdc99ea84387bee9b90e4f5c"

  tax:
    type: string
    required: false
    example: "0.00"

  payment_method:
    type: string
    required: false
    example: "10"

  billing_address:
    type: string
    required: false
    example: "cll 93"

  payment_method_name:
    type: string
    required: false
    example: "VISA"

  pse_bank:
    type: string
    required: false
    example: ""

  state_pol:
    type: string
    required: true
    example: "6"

  date:
    type: string
    required: false
    example: "2015.05.27 01:07:35"

  nickname_buyer:
    type: string
    required: false
    example: ""

  reference_pol:
    type: string
    required: false
    example: "7069375"

  currency:
    type: string
    required: true
    example: "USD"

  risk:
    type: string
    required: false
    example: "1.0"

  shipping_address:
    type: string
    required: false
    example: ""

  bank_id:
    type: string
    required: false
    example: "10"

  payment_request_state:
    type: string
    required: false
    example: "R"

  customer_number:
    type: string
    required: false
    example: ""

  administrative_fee_base:
    type: string
    required: false
    example: "0.00"

  attempts:
    type: string
    required: false
    example: "1"

  merchant_id:
    type: string
    required: true
    example: "508029"

  exchange_rate:
    type: string
    required: false
    example: "2541.15"

  shipping_country:
    type: string
    required: false
    example: ""

  installments_number:
    type: string
    required: false
    example: "1"

  franchise:
    type: string
    required: false
    example: "VISA"

  payment_method_id:
    type: string
    required: false
    example: "2"

  extra1:
    type: string
    required: false
    example: ""

  extra2:
    type: string
    required: false
    example: ""

  antifraudMerchantId:
    type: string
    required: false
    example: ""

  extra3:
    type: string
    required: false
    example: ""

  nickname_seller:
    type: string
    required: false
    example: ""

  ip:
    type: string
    required: false
    example: "190.242.116.98"

  airline_code:
    type: string
    required: false
    example: ""

  billing_city:
    type: string
    required: false
    example: "Bogota"

  pse_reference1:
    type: string
    required: false
    example: ""

  reference_sale:
    type: string
    required: true
    example: "2015-05-27 13:04:37"

  pse_reference3:
    type: string
    required: false
    example: ""

  pse_reference2:
    type: string
    required: false
    example: ""