#%RAML 1.0 DataType
type: object
properties:
  productId:
    type: string
    required: true
    description: Salesforce product external ID.
    example: "0001"
  speed:
    type: string
    required: false
    description: Contracted speed label.
    example: "10M"
  uploadSpeed:
    type: string
    required: true
    description: Upload speed.
    example: "10M"
  downloadSpeed:
    type: string
    required: true
    description: Download speed.
    example: "100M"
  serviceType:
    type: string
    required: false
    description: Service type.
    example: "Pymes"
