#%RAML 1.0 DataType
type: object
description: |
  Request body for billingClearance (paz y salvo / debt-free certificate).
  Queries the customer's due amount in ZSmart (applyETBCertification).
  If the customer is not in dunning status, a certification document is sent to the provided email.
properties:
  msisdn:
    type: string
    description: "MSISDN number of the subscriber (with area code). -> applyETBCertification.msisdn"
    example: '6015551234'
    required: true
  email:
    type: string
    description: "Email address where the certification document will be sent. -> applyETBCertification.email"
    example: 'juan.perez@email.com'
    required: true
