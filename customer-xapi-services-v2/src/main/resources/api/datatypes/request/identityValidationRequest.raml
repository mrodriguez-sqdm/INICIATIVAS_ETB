#%RAML 1.0 DataType 
type: object
properties:
  adviser:
    type: string
    example: '1'
    required: false
  documentNumber:
    type: string
    example: '12345678'
    required: false
  documentType:
    type: integer
    example: 1
    required: false
  dateExpedition:
    type: datetime-only
    example: '2020-01-01T00:00:00'
    required: false
  surname:
    type: string
    example: PEREZ
    required: false
  cellphone:
    type: string
    example: '3001234567'
    required: false
  channel:
    type: integer
    example: 1
    required: false
  provider:
    type: integer
    example: 1
    required: false
  portal:
    type: integer
    example: 1
    required: false
