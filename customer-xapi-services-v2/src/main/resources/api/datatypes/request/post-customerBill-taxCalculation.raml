#%RAML 1.0 DataType
type: object
properties:
  accountId:
    type: string
    required: true
    description: Account Id.
    example: "120090090"
  notes:
    type: string
    required: false
    description: Notes related to the device return
    example: "Device returned by client"
  chargeType:
    type: string
    required: false
    description: Charge type to be calculated, use to identify the consumer is performing the request.
    example: "charge type"
  chargeList:
    type: array
    required: true
    items:
      type: object
      properties:
        sequence:
          type: string
          description: sequence of the request
          example: '1'
          required: false
          minLength: 1
          maxLength: 5
        basicCharge:
          type: string
          description: This value of charge before tax, the amount should be positive, unit is peso, value is the amount with 2 decimal. For example, 1000 PESO should be sent by 1000.00. 
          example: '1000.00'
          required: true
          minLength: 1
          maxLength: 30
        acctItemTypeCode:
          type: string
          description: Acct item type code, it will not respond in case of no penalty.
          example: AIT-MONTHLY_FEE
          required: true
          minLength: 1
          maxLength: 30
example: !include ../../examples/request/post-customerBill-taxCalculation.json