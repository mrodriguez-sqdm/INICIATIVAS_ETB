#%RAML 1.0 DataType
type: object
properties:
  id:
    type: integer
    required: true
    example: 1234
  city:
    type: integer
    required: true
    example: 11001
  department:
    type: integer
    required: true
    example: 11
  model:
    type: integer
    required: true
    enum: [1, 2]
    description: |
      Model type used for client score validation:
        - 1 = Móvil  
        - 2 = Fija
    example: 2
  stratum:
    type: integer
    required: true
    example: 3