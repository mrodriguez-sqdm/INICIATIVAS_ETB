#%RAML 1.0 DataType
# Wholesale Product Order — request contract
# New endpoint: POST /v2/productOrder/wholesale

type: object
properties:
  mayoristaId:
    type: string
    required: true
    description: |
      Wholesale operator identifier. Used to:
      1. Filter the Salesforce account (External_Id__c == mayoristaId)
      2. Store as Caracteristica_Orden[ID_MAYORISTA] in MongoDB
      3. Build the keyObjectStore for origin validation in post-sale operations.
    example: "1"

  transactType:
    type: string
    required: true
    description: |
      Transaction type. Determines which operations-papi sub-flow is invoked:
      VTAM -> /interaction/coverage
      PRCHM -> /interaction/changeSpeed
      ASEGM -> /interaction/changeONT
      TESRM -> /interaction/cancelService
    enum: [VTAM, PRCHM, ASEGM, TESRM]
    example: "VTAM"

  departmentId:
    type: string
    required: false
    description: DANE department code. Required for VTAM (GIS coverage query).
    example: "11"

  cityId:
    type: string
    required: false
    description: DANE municipality code. Required for VTAM (GIS coverage query).
    example: "11001"

  normalizedAddress:
    type: string
    required: false
    description: |
      Normalized address string. Required for VTAM
      (address normalization and coverage check).
    example: "CL 163 BIS 2 60 ESTE"

  serviceAccount:
    type: string
    required: false
    description: |
      Service account ID.
      Required for PRCHM, ASEGM and TESRM.
      Not sent for VTAM.
    example: "GPONMAY_000001"
