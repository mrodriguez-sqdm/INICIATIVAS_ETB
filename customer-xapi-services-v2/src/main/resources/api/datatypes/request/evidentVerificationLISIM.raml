#%RAML 1.0 DataType 
type: object
properties:
  identityValidationId:
    type: integer
    example: 14220
    required: false
  answers:
    type: array
    items:
      type: object
      properties:
        id:
          type: integer
          example: 4
          required: false
        questionId:
          type: integer
          example: 95
          required: false
