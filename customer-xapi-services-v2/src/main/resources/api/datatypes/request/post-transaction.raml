#%RAML 1.0 DataType 
type: object
properties:
  transactions:
    type: array
    items:
      type: object
      properties:
        origin:
          required: false
          type: object
          properties:
            channel:
              type: string
              example: WEB
              required: false
            ipAddress:
              type: string
              example: 192.168.1.100
              required: false
            userAgent:
              type: string
              example: Mozilla/5.0
              required: false
            deviceSessionId:
              type: string
              example: vghs6tvkcle931686k1900o6e1
              required: false
            cookie:
              type: string
              example: pt1t38347bs6jc9ruv2ecpv7o2
              required: false
        gateway:
          type: object
          properties:
            gatewayName:
              type: string
              example: WOMPI
              required: false
            paymentFlow:
              type: string
              example: API
              required: false
        transaction:
          type: object
          required: false
          properties:
            transactionId:
              type: string
              example: TX-30001
              required: false
            reference:
              type: string
              example: ORDER-2024-002
              required: false
            invoiceNumber:
              type: string
              example: FAC-1001
              required: false
            description:
              type: string
              example: Internet service payment
              required: false
            currency:
              type: string
              example: COP
              required: false
            totalAmount:
              type: integer
              example: 120000
              required: false
            taxes:
              required: false
              type: array
              items:
                type: object
                properties:
                  type:
                    type: string
                    example: IVA
                    required: false
                  percentage:
                    type: integer
                    example: 19
                    required: false
        customer:
          type: object
          required: false
          properties:
            fullName:
              type: string
              example: Juan Perez
              required: false
            email:
              type: string
              example: juan@email.com
              required: false
            phoneNumber:
              type: string
              example: '3000000000'
              required: false
            documentType:
              type: string
              example: CC
              required: false
            documentNumber:
              type: string
              example: '111111111'
              required: false
            billingAddress:
              required: false
              type: object
              properties:
                addressLine1:
                  type: string
                  example: Cr 23 No. 53-50
                  required: false
                addressLine2:
                  type: string
                  example: Apto 505
                  required: false
                city:
                  type: string
                  example: Bogotá
                  required: false
                state:
                  type: string
                  example: Bogotá D.C.
                  required: false
                country:
                  type: string
                  example: CO
                  required: false
                postalCode:
                  type: string
                  example: '110111'
                  required: false
        paymentMethod:
          type: object
          required: false
          properties:
            type:
              type: string
              example: CARD
              required: false
            cardBrand:
              type: string
              example: VISA
              required: false
            card:
              required: false
              type: object
              properties:
                installments:
                  type: integer
                  example: 1
                  required: false
                token:
                  type: string
                  example: tok_prod_ABC123456
                  required: false
                cardData:
                  type: object
                  properties:
                    cardNumber:
                      type: string
                      example: '4111111111111111'
                      required: false
                    expMonth:
                      type: string
                      example: '12'
                      required: false
                    expYear:
                      type: string
                      example: '29'
                      required: false
                    cvc:
                      type: string
                      example: '123'
                      required: false
                    cardHolder:
                      type: string
                      example: Juan Perez
                      required: false
            pse:
              required: false
              type: object
              properties:
                financialInstitutionCode:
                  type: string
                  example: '1007'
                  required: false
                serviceCode:
                  type: string
                  example: '1002'
                  required: false
                userType:
                  type: string
                  example: person
                  required: false
            link:
              required: false
              type: object
              properties:
                singleUse:
                  type: boolean
                  example: false
                  required: false
                collectShipping:
                  type: boolean
                  example: false
                  required: false
                expirationDate:
                  type: datetime-only
                  example: '2040-12-10T14:30:00'
                  required: false
                imageUrl:
                  type: string
                  example: https://midominio.com/result
                  required: false
                redirectUrl:
                  type: string
                  example: https://midominio.com/result
                  required: false
                sku:
                  type: string
                  example: RENT-APT-505
                  required: false
                customFields:
                  type: array
                  items:
                    type: object
                    properties:
                      label:
                        type: string
                        example: Apartment Number
                        required: false
                      required:
                        type: boolean
                        example: true
                        required: false
        extraParameters:
          required: false
          type: object
          properties:
            INSTALLMENTS_NUMBER:
              type: integer
              example: 1
              required: false
        threeDomainSecure:
          required: false
          type: object
          properties:
            eci:
              type: string
              example: '05'
              required: false
            cavv:
              type: string
              example: AAABBIIFmAAAAAAAAAAAAAAAAAA=
              required: false
            xid:
              type: string
              example: MDAwMDAwMDAwMDAwMDAwMzIyNzY=
              required: false
            directoryServerTransactionId:
              type: string
              example: 3d5c2c78-1234-5678
              required: false
        id:
          type: string
          example: 67c6f9e2b9d1a1c2e4a12345
          required: false
        cus:
          type: string
          example: link_prod_8f3b9c2a1d
          required: false
        gatewayAttributes:
          type: array
          required: false
          items:
            type: object
            properties:
              id:
                type: string
                example: link_prod_8f3b9c2a1d
                required: false
              gateway:
                type: string
                example: WOMPI
                required: false
              paymentMethod:
                type: string
                example: CARD
                required: false
        paymentReferences:
          type: array
          required: false
          items:
            type: string
        documentType:
          type: string
          example: CC
          required: false
        documentNumber:
          type: string
          example: '111111111'
          required: false
        amountToPay:
          type: string
          example: '120000'
          required: false
        taxAmount:
          type: string
          example: '22800'
          required: false
        description:
          type: string
          example: Internet service payment
          required: false
        bankEntity:
          type: string
          example: BANCOLOMBIA
          required: false
        gatewayType:
          type: string
          example: CARD
          required: false
        transactionStatus:
          type: string
          example: PENDING
          required: false
        statusHistory:
          type: array
          required: false
          items:
            type: object
            properties:
              transactionStatus:
                type: string
                example: PENDING
                required: false
              status:
                type: string
                example: PENDING
                required: false
              date:
                type: datetime
                example: '2026-03-04T18:30:00.000Z'
                required: false
        registrationDate:
          type: datetime
          example: '2026-03-04T18:30:00.000Z'
          required: false
        gatewayResponseDate:
          type: datetime
          example: '2026-03-04T18:30:02.000Z'
          required: false
        lastUpdateDate:
          type: 'null'
          example: null
          required: false

