<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-interaction-orchestratorSub_Flow"
		doc:id="3c694d42-d8b4-47ab-964b-4505a34dadc1">
		<choice doc:name="Choice"
			doc:id="80b4af85-66b6-4720-ab59-da1ea54c01a5">
			<when
				expression="#[payload.transactType == p('interaction-transactType.coverage')]">
				<flow-ref doc:name="post-interaction-coverage-client"
					doc:id="ec908e2a-c791-4f07-b42f-85a0bb418866"
					name="post-interaction-coverage-client" />
			</when>
			<when
				expression="#[payload.transactType == p('interaction-transactType.cancelService')]">
				<flow-ref doc:name="post-interaction-cancelService-client"
					doc:id="e8dbfd6e-2b1f-4dfe-aa10-06e283fb59ca"
					name="post-interaction-cancelService-client" />
			</when>
			<when
				expression="#[payload.transactType == p('interaction-transactType.changeSpeed')]">
				<flow-ref doc:name="post-interaction-changeSpeed-client"
					doc:id="e9932e5b-dab8-404c-a4ed-1780124a9e18"
					name="post-interaction-changeSpeed-client" />
			</when>
			<when
				expression="#[payload.transactType == p('interaction-transactType.changeONT')]">
				<flow-ref doc:name="post-interaction-changeONT"
					doc:id="a83b0ad9-5976-4ae6-8c2f-5852edd5ebf1"
					name="post-interaction-changeONT-client" />
			</when>
			<otherwise>
				<ee:transform doc:name="Response FAIL transactType"
					doc:id="71d3ba28-8d7c-40c0-a46e-5250c2f75a33">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": 500,
  "code": "INTERNAL_SERVER_ERROR",
  "message": {
    "message": "Transact type is not validate"
  },
  "messageServer": "",
  "cause": [
    {
      "origin": app.name,
      "message": "org.mule.extension.http.api.request.validator.ResponseValidatorTypedException"
    }
  ]
}

]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
