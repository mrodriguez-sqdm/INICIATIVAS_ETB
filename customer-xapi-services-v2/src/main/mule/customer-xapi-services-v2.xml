<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="customer-xapi-services-main"
		doc:id="b4e109cd-8655-4099-91ad-1959dac6fd85">
		<http:listener doc:name="Listener"
			doc:id="0e2db5ba-354c-4923-aa48-6e7ed8117703"
			config-ref="customer-xapi-services-httpListenerConfig"
			path="${app.listener.basePath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="call initial Logger"
			doc:id="d1fa78e7-f9c5-4bae-bbcb-795fbcbb678a"
			name="initial-loggin-Sub_Flow" />
		<apikit:router
			doc:id="8e720648-434b-4ef1-a826-a267c5dc88a8"
			config-ref="customer-xapi-services-config" doc:name="APIkit Router" />
		<async doc:name="Async"
			doc:id="55adffd5-960f-4f92-91bb-8276f90d1d05">
			<flow-ref doc:name="call logger client"
				doc:id="950f4e55-0479-4c53-8292-2d38e4766000"
				name="loggin-client-call" />
		</async>
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="customer-xapi-services-console"
		doc:id="6420b9da-b14e-4e61-bbe5-916aa27e89fa">
		<http:listener doc:name="Listener"
			doc:id="bb122c5c-3fe7-4ce5-ad37-48bcc273483d"
			config-ref="customer-xapi-services-httpListenerConfig"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			doc:id="fe632ccd-7ffe-4aad-8068-cc411b8d7344"
			config-ref="customer-xapi-services-config" doc:name="APIkit Console" />
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="get:\customer:customer-xapi-services-config"
		doc:id="e113b5cf-1545-4f7b-8cf4-afbd32bbe86e">
		<flow-ref doc:name="get-customer-orchestrator-sub-flow"
			doc:id="38bf7e9e-f7a1-4184-bafa-6edaf84b8a32"
			name="get-customer-orchestrator-sub-flow" />
	</flow>
	<flow
		name="patch:\payment\(paymentMethod)\payment\(paymentId):application\json:customer-xapi-services-config"
		doc:id="754975b0-a80c-4c51-aa1e-14175d07135d">
		<flow-ref
			doc:name="patch-payment-by-id-orchestrator-sub-flow"
			doc:id="be48c1a1-71a1-413d-bf20-1e874f5238fe"
			name="patch-payment-by-id-orchestrator-sub-flow" />
	</flow>
	<flow
		name="get:\payment\(paymentMethod)\banks:customer-xapi-services-config"
		doc:id="b7f96b00-f15c-432e-88cb-24a6cd40727c">
		<flow-ref doc:name="get-payment-banks-orchestrator-sub-flow"
			doc:id="59626ed4-f191-42f3-9397-34d59dcc8e9f"
			name="get-payment-banks-orchestrator-sub-flow" />
	</flow>
	<flow
		name="get:\payment\(paymentMethod)\payment\(paymentId):customer-xapi-services-config"
		doc:id="713d3a8d-1a61-4808-be1d-98212872eb39">
		<flow-ref doc:name="get-payment-by-id-orchestrator-sub-flow"
			doc:id="a9565fc4-3171-42c0-9b14-6cce302c1764"
			name="get-payment-by-id-orchestrator-sub-flow" />
	</flow>
	<flow
		name="post:\payment\(paymentMethod)\payment:application\json:customer-xapi-services-config"
		doc:id="60a49e62-fae0-453e-af16-06d197544802">
		<flow-ref doc:name="post-payment-orchestrator-sub-flow"
			doc:id="6a1b1990-2d27-4b64-b61c-8c309a2b642e"
			name="post-payment-orchestrator-sub-flow" />
	</flow>
	<flow name="get:\customer360:customer-xapi-services-config"
		doc:id="2d185edd-cbbc-4dae-9f5e-45118436c42d">
		<flow-ref doc:name="get-customer-360-orchestrator-sub-flow"
			doc:id="22a5dec1-5511-44ab-9128-9db8967efd78"
			name="get-customer-360-orchestrator-sub-flow" />
	</flow>
</mule>
