<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">
	<apikit:config name="customer-xapi-services-config"
		api="customer-xapi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<http:listener-config
		name="customer-xapi-services-httpListenerConfig">
		<http:listener-connection host="0.0.0.0"
			port="${https.port}"
			readTimeout="${configurationTimeout.customer-xapi-v2-listener}"
			tlsContext="TLS_Context" protocol="HTTPS" />
	</http:listener-config>
	<http:request-config
		name="HTTP_Request_configuration_customer-papi-services-v2"
		doc:name="HTTP Request configuration"
		doc:id="4e9f2c32-6ea3-4e7f-8934-9d0783b447ee"
		basePath="${customer-papi-v2.base-path}"
		responseTimeout="${configurationTimeout.customer-papi-v2.responseTimeout}">
		<http:request-connection
			protocol="${customer-papi-v2.protocol}"
			host="${customer-papi-v2.host}" port="${customer-papi-v2.port}"
			connectionIdleTimeout="${configurationTimeout.customer-papi-v2.connectionIdleTimeout}" />
	</http:request-config>
	<tls:context name="TLS_Context" doc:name="TLS Context"
		doc:id="312e71ef-73b7-4c72-8558-0ed57498bf41">
		<tls:key-store type="${tls.type}" path="${tls.path}"
			keyPassword="${tls.keyPassword}" password="${tls.keyPassword}" />
	</tls:context>
	<import doc:name="Import"
		doc:id="665edfd6-a1a7-4ade-8596-4b0826b5928b"
		file="error-handler-v2.xml" />
	<import doc:name="Import"
		doc:id="23d2c57c-6882-4ae8-8563-7a0af33e8ca9" file="loggin.xml" />
	<import doc:name="Import"
		doc:id="6cf125d8-ae49-427a-a088-3e31c9ea72fa"
		file="audits-sapi-client.xml" />
	<import doc:name="Import"
		doc:id="7c840b7a-a9f0-4012-aedc-ae3e77fbe9c2"
		file="etb-common-lib.xml" />
	<import doc:name="Import"
		doc:id="4e339cfc-bb5a-486e-b52d-fb8d362745d9" file="insert-audit.xml" />
	<configuration-properties
		doc:name="Configuration properties"
		doc:id="f889eb8b-0acc-45c9-894e-cdac134cc616"
		file="${env}-properties.yaml" />
	<http:listener-config name="HTTP_DLB_Listener"
		doc:name="HTTP DLB Listener">
		<http:listener-connection
			host="${http-dlb.host}" port="${http-dlb.port}" protocol="HTTP" />
	</http:listener-config>
	<http:request-config name="HTTP_Self_Request"
		doc:name="HTTP Self Request" basePath="/">
		<http:request-connection host="localhost"
			port="${https.port}" protocol="HTTPS">
			<tls:context>
				<tls:trust-store insecure="true" />
			</tls:context>
		</http:request-connection>
	</http:request-config>
	<api-gateway:autodiscovery
		apiId="${autodiscovery}" ignoreBasePath="true"
		doc:name="API Autodiscovery"
		doc:id="573a15b6-4b14-4f71-a070-757788e6013a"
		flowRef="customer-xapi-services-main" />
	<http:request-config
		name="HTTP_Request_configuration_customers_papi_risk"
		doc:name="HTTP Request configuration"
		doc:id="17ccab8b-fc26-4630-b266-faa29620faca"
		responseTimeout="${configurationTimeout.customer-papi-v2.responseTimeout}"
		basePath="${customer-papi-v2.base-path}">
		<http:request-connection
			protocol="${customer-papi-v2.protocol}"
			host="${customer-papi-v2.host}" port="${customer-papi-v2.port}" />
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_service-papi"
		doc:name="HTTP Request configuration"
		doc:id="fcea363d-8a33-439e-b2f9-0ac767478d49"
		basePath="${service-papi-v2.base-path}"
		responseTimeout="${configurationTimeout.service-papi-v2.responseTimeout}">
		<http:request-connection
			protocol="${service-papi-v2.protocol}" host="${service-papi-v2.host}"
			port="${service-papi-v2.port}" />
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_service-papi-v1"
		doc:name="HTTP Request configuration"
		doc:id="d07ee686-a6d0-43a8-a120-1240f9cd721a"
		basePath="${service-papi.base-path}"
		responseTimeout="${configurationTimeout.service-papi.responseTimeout}">
		<http:request-connection
			protocol="${service-papi.protocol}" host="${service-papi.host}"
			port="${service-papi.port}"
			connectionIdleTimeout="${configurationTimeout.service-papi.connectionIdleTimeout}" />
	</http:request-config>
	<http:request-config
		name="HTTP_Request_configuration_payments"
		doc:name="HTTP Request configuration"
		doc:id="826b5f18-e431-4040-8206-623bf6b7e222"
		basePath="${payment-papi.basepath}" responseTimeout="45000">
		<http:request-connection
			protocol="${payment-papi.protocol}" host="${payment-papi.host}"
			port="${payment-papi.port}" />
	</http:request-config>
	<http:request-config
		name="Operations_HTTP_Request_configuration"
		doc:name="HTTP Request configuration"
		doc:id="1af63c0c-042b-454e-84d7-c47857ea3020"
		basePath="${operations-papi.basePath}"
		responseTimeout="${configurationTimeout.operations-papi.responseTimeout}">
		<http:request-connection
			protocol="${operations-papi.protocol}" host="${operations-papi.host}"
			port="${operations-papi.port}"
			connectionIdleTimeout="${configurationTimeout.operations-papi.connectionIdleTimeout}" />
	</http:request-config>
	<!-- Secure Properties (Blowfish/CBC encrypted) -->
	<secure-properties:config
		name="Secure_Properties_Config" doc:name="Secure Properties"
		doc:id="f3bb8319-08f6-4212-9b20-d5693aece9e5"
		file="${env}-secure-properties.yaml" key="${secure.key}">
		<secure-properties:encrypt
			algorithm="Blowfish" />
	</secure-properties:config>
</mule>
