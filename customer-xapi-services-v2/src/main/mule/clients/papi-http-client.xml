<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="papi-http-client-sub-flow"
		doc:id="e95faac2-016c-43b3-9b85-34a42d2105be">
		<http:request method="#[vars.httpRequest.method]"
			doc:name="PAPI HTTP Request"
			doc:id="d1df4b84-9bf3-4e14-9ae3-3e009615f774"
			config-ref="PAPI_HTTP_Request_configuration"
			path="#[vars.httpRequest.path]"
			responseTimeout="#[vars.httpRequest.responseTimeout]"
			sendCorrelationId="AUTO">
			<http:headers><![CDATA[#[vars.httpRequest.headers default {}]]]></http:headers>
			<http:uri-params><![CDATA[#[vars.httpRequest.uriParams default {}]]]></http:uri-params>
			<http:query-params><![CDATA[#[vars.httpRequest.queryParams default {}]]]></http:query-params>
		</http:request>
	</sub-flow>
</mule>
