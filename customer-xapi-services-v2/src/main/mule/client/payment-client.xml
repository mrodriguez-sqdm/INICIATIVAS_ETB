<?xml version="1.0" encoding="UTF-8"?>
<mule
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow
		name="get-payments-banks-clientSub_Flow"
		doc:id="deb04a0b-a4e5-47d1-a6ca-e41d12a06ca4">
		<ee:transform
			doc:name="Transform Message"
			doc:id="021e2158-542b-44b3-93b1-d79721ad7268">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="paymentMethod"><![CDATA[attributes.uriParams.paymentMethod]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="GET" doc:name="Call GET banks" doc:id="753add5d-37c7-4840-9b3f-ab359f798b70" config-ref="HTTP_Request_configuration_payments" path="${payment-papi.paths.getBanks}" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"source" : attributes.headers.source,
	"name" : attributes.headers.name,
	"X-CORRELATION-ID" : attributes.headers.'x-correlation-id' default correlationId,
	"processName" : vars.processname,
	"client_secret" : p('credentials.client_secret'),
	"systemId" : vars.systemId,
	"client_id" : p('credentials.client_id')
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"paymentMethod" : vars.paymentMethod
}]]]></http:uri-params>
		</http:request>
	</sub-flow>
	<sub-flow name="post-payment-clientSub_Flow" doc:id="a7898d07-8413-452a-8c01-69dadc235784" >
		<ee:transform doc:name="Set paymentMethod" doc:id="b64c3dac-eb50-4f63-a6d3-770499db532a">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="paymentMethod"><![CDATA[attributes.uriParams.paymentMethod]]></ee:set-variable>
				<ee:set-variable variableName="systemId"><![CDATA[attributes.uriParams.paymentMethod]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="POST" doc:name="Call POST Payment" doc:id="12dd5773-bdac-4340-8bb4-a0633e29c178" config-ref="HTTP_Request_configuration_payments" path="${payment-papi.paths.postPayment}" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"source" : attributes.headers.source,
	"name" : attributes.headers.name,
	"X-CORRELATION-ID" : attributes.headers.'x-correlation-id' default correlationId,
	"processName" : attributes.headers.processname,
	"client_secret" : p('credentials.client_secret'),
	"systemId" : attributes.headers.systemId,
	"client_id" : p('credentials.client_id')
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"paymentMethod" : vars.paymentMethod
}]]]></http:uri-params>
		</http:request>
	</sub-flow>
	<sub-flow name="get-payment-by-id-clientSub_Flow" doc:id="0142b3ad-ce00-4af8-ab1e-2ed56b847f7f" >
		<ee:transform doc:name="Set Vars" doc:id="20dcb49f-dc25-4060-b8f0-4622263098b2">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="paymentMethod"><![CDATA[attributes.uriParams.paymentMethod]]></ee:set-variable>
				<ee:set-variable variableName="paymentId"><![CDATA[attributes.uriParams.paymentId]]></ee:set-variable>
				<ee:set-variable variableName="paymentOrigin"><![CDATA[attributes.queryParams.origin]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<http:request method="GET" doc:name="Call GET Payment By Id" doc:id="9cf48d89-7f32-4cac-87e7-96a8411f71c1" config-ref="HTTP_Request_configuration_payments" path="${payment-papi.paths.getPayment}" >
			<http:headers ><![CDATA[#[output application/java
---
{
	"source" : attributes.headers.source,
	"name" : attributes.headers.name,
	"X-CORRELATION-ID" : attributes.headers.'x-correlation-id' default correlationId,
	"processName" : vars.processname,
	"client_secret" : p('credentials.client_secret'),
	"systemId" : vars.systemId,
	"client_id" : p('credentials.client_id')
}]]]></http:headers>
			<http:uri-params ><![CDATA[#[output application/java
---
{
	"paymentId" : vars.paymentId,
	"paymentMethod" : vars.paymentMethod
}]]]></http:uri-params>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"origin" : vars.paymentOrigin
}]]]></http:query-params>
		</http:request>
	</sub-flow>
	<sub-flow name="patch-payment-by-id-clientSub_Flow" doc:id="7b88c558-d58f-458e-a50a-5ae5d54c9326" >
		<ee:transform doc:name="Set Vars" doc:id="c1493b80-314d-44cf-8ccc-15ab4859ae9a">
