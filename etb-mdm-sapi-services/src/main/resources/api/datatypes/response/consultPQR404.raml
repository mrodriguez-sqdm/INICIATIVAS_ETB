#%RAML 1.0 DataType
properties:
  status:
    type: number
    example: 404
  code:
    type: string
    example: "NOT FOUND"
  response:
        type: object
        properties:
          getPQRResponse:
            type: object
            properties:
              getPQRResult:
                type: object
                properties:
                  wsResponseHeader:
                    type: object
                    properties:
                      system:
                        type: object
                        properties:
                          name:
                            type: string
                            example: "MDM_Data_Services"         
                          correlationId:
                            type: string
                            example: "?"
                          processingServer:
                            type: string
                            example: "?"
                      service:
                        type: object
                        properties:
                          status:
                            type: string
                            example: "NO DATA"         
                          responseDate:
                            type: string
                            example: "2022-07-18 13:22:37"
                          statusDetail:
                            type: string
                            example: "No se encuentra información para la búsqueda"
                      property:
                        type: string
                        example: "?"
