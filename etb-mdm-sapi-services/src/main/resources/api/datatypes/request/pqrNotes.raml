#%RAML 1.0 DataType
properties:
  pqrActivityNotes:
    type: object
    properties:
      requestHeader:
        type: object
        properties:
          system:
            type: object
            properties:
              name:
                type: string
                required: false
                example: "MDM_Data_Services"
              correlationId:
                type: string
                required: false
                example: "MDM-PQR-4091830"
              processingServer:
                type: string
                required: false
                example: ""
          property:
            type: array
            items:
              properties:
                name:
                  type: string
                  required: false
                  example: ""
                value:
                  type: string
                  required: false
                  example: ""
      requestBody:
        type: object
        properties:
          id:
            type: string | nil
            required: false
            example: null
          pqrNumber: 
            type: string | nil
            required: false
            example: "MDM-PQR-4091830"
          activityNumber: 
            type: string | nil
            required: false
            example: "MDM-PQR-ACT-2178090"
          activityNotes: 
            type: array
            items:
              properties:
                note:
                  type: string | nil
                  required: false
                  example: null
          setType:
            type: string | nil
            required: false
            example: "I" 

example: !include ../../examples/request/pqrNotes.json
  