#%RAML 1.0 DataType
type: object
properties:
  updateOrderCharacteristics:
    type: object
    required: true
    properties:
      characteristics:
        type: array
        required: false
        
        items:
          type: object
          properties:
            orderCharacteristic:
              type: object
              required: true
              properties:
                characteristic:
                  type: string
                  required: true
                  minLength: 1
                value:
                  type: string
                  required: true
                  minLength: 1
      user:
        type: string
        required: false
example:
  !include ../../examples/request/updateOrderCharacteristics.raml