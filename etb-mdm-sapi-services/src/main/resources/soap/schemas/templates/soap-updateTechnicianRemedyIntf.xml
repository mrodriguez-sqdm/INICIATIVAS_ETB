<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:mdm="http://www.etb.com.co/Gateway/MDM_Logic_Services">
   <soapenv:Header/>
   <soapenv:Body>
      <ns0:OFSC_OSM_Message xmlns:ns0="http://www.etb.com.co/Gateway/MDM_Logic_Services">
    <ns0:WSRequestHeader>
        <ns0:system>
            <ns0:name>#[payload.system.name]</ns0:name>
            <ns0:correlationId>#[payload.system.correlationId]</ns0:correlationId>
            <ns0:processingServer>#[payload.system.processingServer]</ns0:processingServer>
        </ns0:system>
    </ns0:WSRequestHeader>
    <ns0:WSRequestBody>
        <ns0:OrderId>#[payload.orderId]</ns0:OrderId>
        <ns0:MessageId>#[payload.messageId]</ns0:MessageId>
        <ns0:RequestDate>#[payload.requestDate]</ns0:RequestDate>
        <ns0:RequestType>#[payload.requestType]</ns0:RequestType>
        <ns0:Message>#[vars.transformedXml]</ns0:Message>
    </ns0:WSRequestBody>
</ns0:OFSC_OSM_Message>
   </soapenv:Body>
</soapenv:Envelope>
