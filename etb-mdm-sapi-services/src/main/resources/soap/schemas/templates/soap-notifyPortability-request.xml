<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:mdm="MDM_ETB">
   <soapenv:Header/>
   <soapenv:Body>
      <mdm:Recepcion_Mensajes_Portabilidad>
         <!--Optional:-->
         <mdm:Header>
            <mdm:IdentificadorPeticion>#[attributes.headers.'X-CORRELATION-ID']</mdm:IdentificadorPeticion>
            <mdm:SistemaPeticion>#[attributes.headers.'name']</mdm:SistemaPeticion>
            <mdm:UsuarioMDM>#[p('mdm.notifyPortability.credentials.usuarioMDM')]</mdm:UsuarioMDM>
            <mdm:PasswordMDM>#[p('mdm.notifyPortability.credentials.passwordMDM')]</mdm:PasswordMDM>
         </mdm:Header>
         <mdm:Informacion>
            <mdm:MensajeXML>#[vars.body]
</mdm:MensajeXML>
         </mdm:Informacion>
      </mdm:Recepcion_Mensajes_Portabilidad>
   </soapenv:Body>
</soapenv:Envelope>