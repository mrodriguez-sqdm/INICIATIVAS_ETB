<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/" xmlns:tier="http://schemas.datacontract.org/2004/07/Tier.Common" xmlns:ws="http://schemas.datacontract.org/2004/07/WS.Inventario.DataContracts">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Consulta_detalle_inventario>
         <!--Optional:-->
         <tem:WSRequestHeader>
            <!--Optional:-->
            <tier:system>
               <!--Optional:-->
               <tier:correlationId>#[attributes.headers.'x-correlation-id']</tier:correlationId>
               <!--Optional:-->
               <tier:name>#[attributes.headers.'name']</tier:name>
               <!--Optional:-->
               <tier:processingServer>#[attributes.headers.'source']</tier:processingServer>
            </tier:system>
         </tem:WSRequestHeader>
         <!--Optional:-->
         <tem:parametros>
            <!--Optional:-->
            <ws:id_inventario>#[vars.id_inventory]</ws:id_inventario>
            <!--Optional:-->
            <ws:identificador_transaccion>#[vars.id_transaction]</ws:identificador_transaccion>
         </tem:parametros>
      </tem:Consulta_detalle_inventario>
   </soapenv:Body>
</soapenv:Envelope>