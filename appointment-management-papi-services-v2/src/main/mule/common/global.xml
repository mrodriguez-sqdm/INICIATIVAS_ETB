	<http:request-config name="mongo_db_sapi_config" doc:name="HTTP Request configuration" doc:id="33baa6cc-8240-4289-b9d3-789101a4eaba" basePath="${mongo-db-sapi.base-path}" responseTimeout="${configurationTimeout.mongo-db-sapi.responseTimeout}">
		<http:request-connection protocol="${mongo-db-sapi.protocol}" host="${mongo-db-sapi.host}" port="${mongo-db-sapi.port}" connectionIdleTimeout="${configurationTimeout.mongo-db-sapi.connectionIdleTimeout}"/>
	</http:request-config>
	<apikit:config name="appointment-management-papi-services-config" api="appointment-management-papi-services.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
	<import doc:name="Import"
		doc:id="7df6aa95-4799-482d-b946-4923d5e1ebcd"
		file="error-handler-v2.xml" />
	<import doc:name="Import"
		doc:id="e98f936d-76d0-4074-a13d-6597bddeae84" file="loggin.xml" />
	<import doc:name="Import"
		doc:id="fdc7b1e8-d367-44ac-ab64-c257c96f048d"
		file="audits-sapi-client.xml" />
	<import doc:name="Import"
		doc:id="8f486731-451d-407a-a102-dd3dd081d1ea"
		file="etb-common-lib.xml" />
	<import doc:name="Import"
		doc:id="d44ae663-d1f5-408d-862f-47eb38064a5c" file="insert-audit.xml" />
	<configuration-properties doc:name="Configuration properties" doc:id="670b7056-76f0-44ca-ab66-31833ea4560a" file="${env}-properties.yaml" />
	<api-gateway:autodiscovery apiId="${autodiscovery}" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="189abc19-a5f1-43e9-9527-3eedc55a0128" flowRef="appointment-management-papi-services-main" />
	
	<http:request-config name="orquestador_sapi_config" doc:name="HTTP Request configuration" doc:id="eab93956-1cbd-4816-9971-4c4a24726a3e" basePath="${orquestador-sapi.base-path}" responseTimeout="${configurationTimeout.orquestador-sapi.responseTimeout}">
		<http:request-connection protocol="${orquestador-sapi.protocol}" host="${orquestador-sapi.host}" port="${orquestador-sapi.port}" connectionIdleTimeout="${configurationTimeout.orquestador-sapi.connectionIdleTimeout}"/>
	</http:request-config>
	<http:request-config name="Oracle-Sapi-HTTP_Request_configuration" doc:name="HTTP Request configuration" doc:id="360fbdaa-3fb6-4a9d-a182-4924cbee9a77" basePath="${oracle-sapi.basepath}" responseTimeout="${configurationTimeout.oracle-sapi.responseTimeout}">
		<http:request-connection host="${oracle-sapi.host}" port="${oracle-sapi.port}" protocol="${oracle-sapi.protocol}" connectionIdleTimeout="${configurationTimeout.oracle-sapi.connectionIdleTimeout}"/>
	</http:request-config>
</mule>
