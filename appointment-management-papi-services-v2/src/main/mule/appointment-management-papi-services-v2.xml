	<flow name="appointment-management-papi-services-main" doc:id="2e6fc766-61ce-48a5-9ff8-5392acfe5321" >
		<http:listener doc:name="Listener" doc:id="4fee5428-b4c6-4728-b796-3e0e95af177d" config-ref="appointment-management-papi-services-v2-httpListenerConfig" path="/v2/*" >
			<http:response statusCode="#[vars.httpStatus default 200]" >
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="Call initial Logger" doc:id="d10ea226-0b98-4f5b-bacb-495e8dbf16e5" name="initial-loggin-Sub_Flow" />
		<apikit:router doc:name="APIkit Router" doc:id="509229b1-1ea2-4597-a914-85973dd3ddaa" config-ref="appointment-management-papi-services-config" />
		<async doc:name="Async" doc:id="de2f950e-94d3-428f-9531-ce7ea99b6f64" >
			<flow-ref doc:name="Call logger" doc:id="502ea899-4be0-4f64-ad04-20f41ed58cad" name="loggin-client-call" />
		</async>
		<error-handler ref="error-handlerError_Handler" />
	</flow>
	<flow name="appointment-management-papi-services-console" doc:id="12ba89ae-ffbb-4ff3-867d-04aa317089f3" >
		<http:listener doc:name="Listener" doc:id="b557a224-64d2-433a-8647-715b81b6373f" config-ref="appointment-management-papi-services-v2-httpListenerConfig" path="/console/*" >
			<http:response statusCode="#[vars.httpStatus default 200]" >
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
				<http:headers ><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console doc:name="APIkit Console" doc:id="84cdc2f3-5b74-40a6-b52b-6a67dbd5e1ed" config-ref="appointment-management-papi-services-config" />
	</flow>
	<flow name="get:\appointment:appointment-management-papi-services-config" doc:id="06597f75-8527-4778-8def-aa203dbbbd3c" >
