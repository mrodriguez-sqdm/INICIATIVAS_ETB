	<sub-flow name="post-mietb-usuario-orchestratorSub_Flow" doc:id="f1d64d43-a740-409a-9244-74916dabb1ac" >
		<ee:transform doc:name="Validate required fields" doc:id="95f55f99-a73f-4e1e-8689-69c42e11cc4d" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="inputValidations" ><![CDATA[%dw 2.0
output application/json
---
if ( upper(vars.segmento) == "HOGAR" and 
     !isBlank(vars.inputBody.cliente.fechaExpedicion) and 
     (isEmpty(vars.inputBody.representanteLegal))
    )
   "HOGAR"
else if ( upper(vars.segmento) == "MIPYMES" and
          isBlank(vars.inputBody.cliente.fechaExpedicion) and
          !isEmpty(vars.inputBody.representanteLegal) and
          !isBlank(vars.inputBody.representanteLegal.fechaExpedicion)
        )
    "MIPYMES"
else "INVALID"

]]></ee:set-variable>
			</ee:variables>
