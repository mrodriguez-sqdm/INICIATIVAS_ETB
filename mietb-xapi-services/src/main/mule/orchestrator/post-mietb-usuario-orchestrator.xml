	<sub-flow name="validateLisim" doc:id="0c10e6d1-3613-40d0-84f3-64b1f2a277f6" >
		<ee:transform doc:name="Prepare input scoring" doc:id="deb226dd-226d-4f4f-9d19-0ab62bf6bc3b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import * from dw::core::Dates
var myDateCL = if(upper(vars.segmento) == "HOGAR") vars.inputBody.cliente.fechaExpedicion as Date {format: "dd/MM/yyyy"} as String {format: "yyyy-MM-dd"} else null
var myDateRL = if(upper(vars.segmento) == "MIPYMES") vars.inputBody.representanteLegal.fechaExpedicion as Date {format: "dd/MM/yyyy"} as String {format: "yyyy-MM-dd"} else null
---
if(upper(vars.segmento) == "MIPYMES") 
{
  "Properties": {
    "CIUDAD": "-1",
    "DEPARTAMENTO": "-1",
    "MODELO": "2"
  },
  "Body": {
    "GestionClientes": {
      "head": {},
      "body": {
        "Cliente": {
          "TipoDocumento": vars.inputBody.representanteLegal.tipoIdentificacion,
          "NumeroDocumento": vars.inputBody.representanteLegal.numeroIdentificacion,
          "FechaExpedicionDocumento": dateTime({year: myDateRL.year, month: myDateRL.month, day: myDateRL.day, hour: 0, minutes: 0, seconds: 0 , timeZone: |-05:00|}),
          "PrimerApellido": vars.inputBody.cliente.apellido
        }
      }
    }
  }
}else{
  "Properties": {
    "CIUDAD": "-1",
    "DEPARTAMENTO": "-1",
    "MODELO": "2"
  },
  "Body": {
    "GestionClientes": {
      "head": {},
      "body": {
        "Cliente": {
          "TipoDocumento": vars.inputBody.cliente.tipoIdentificacion,
          "NumeroDocumento": vars.inputBody.cliente.numeroIdentificacion,
          "FechaExpedicionDocumento": dateTime({year: myDateCL.year, month: myDateCL.month, day: myDateCL.day, hour: 0, minutes: 0, seconds: 0 , timeZone: |-05:00|}),
          "PrimerApellido": vars.inputBody.cliente.apellido
        }
      }
    }
  }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<async doc:name="Async" doc:id="ee41aa93-9d19-4870-a44c-0f1f051726c9">
			<ee:transform doc:name="Map Log Body" doc:id="1f7ce8c4-15c4-4e28-8eee-66250192af1e">
				<ee:message>
					<ee:set-payload><![CDATA[output application/json
---
{
	correlationId: correlationId,
	path: p('lisim-sapi.path.scoring'),
	(payload: payload) if (!isEmpty(payload))
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<flow-ref doc:name="Call logger before" doc:id="65984067-7501-4f13-8322-a80c8382603c" name="audits-mongo-log-before" />
		</async>
		<try doc:name="Try" doc:id="8b0b6206-e400-48ba-a232-13926add0c89" >
			<flow-ref doc:name="Go to lisim client" doc:id="e5f84f10-b5e6-46f9-a8c4-9a265ad50484" name="lisim-clientSub_Flow" />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="2b8635a1-20f0-47c3-b2f0-90118d792d8f" >
					<async doc:name="Async" doc:id="5b3d3e02-2ee1-4ae9-9ef4-c3f86c9d2482">
						<flow-ref doc:name="Call logger error" doc:id="9453be36-6374-44e8-80fc-c8450244236f" name="audits-mongo-log-error" />
					</async>
					<set-variable value='#["ERROR"]' doc:name="outError" doc:id="45882edb-1901-4327-9684-1daeafd8af0b" variableName="outScoring"/>
				</on-error-continue>
			</error-handler>
		</try>
		<async doc:name="Async" doc:id="697a95b0-5378-477a-9549-526344df4c4a">
			<flow-ref doc:name="Call logger after" doc:id="6ba1382e-30a6-4c69-a588-1d2ad7b927b5" name="audits-mongo-log-before" />
		</async>
		<choice doc:name="Valid response from scoring?" doc:id="de9617ea-ef6c-4da0-bb49-13ab602ec8d7" >
			<when expression="#[payload.WSResponseScoring.GestionClientes.head.Respuesta.CodigoRespuesta == 'VIGENTE' and vars.outScoring != &quot;ERROR&quot;]">
				<flow-ref doc:name="Go to Validate Services" doc:id="1dfd6992-ca6a-45ba-89fd-21347627ee87" name="validateServices"/>
			</when>
			<otherwise >
				<ee:transform doc:name="Negative 409 Bad Request" doc:id="806e0ca1-a092-4d95-ac5b-473fe8a0291c" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 409,
  "code": "CONFLICT",
  "message": {
    "message": "Could not validate against LISIM"
  },
  "messageServer": "Conflict.",
  "cause": [
    {
      "origin": "mietb-xapi-services",
    }
  ]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
409]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="validateServices" doc:id="668a864c-0891-4e0d-b18b-89ee6296bb5f" >
		<set-variable value="#[p('correspondencia.' ++ vars.tipoDocumento)]" doc:name="tipoDocumento" doc:id="5dd988a8-8ec7-4ecf-9adb-280886f7583f" variableName="tipoDocumento"/>
		<set-variable value='#["N"]' doc:name='Set activo "N"' doc:id="911cc061-16a3-465d-ae23-b95bf666bb0d" variableName="activo"/>
		<try doc:name="Try" doc:id="c2cb7f3d-0f9f-4b08-980a-54d2ad002eab" >
			<flow-ref doc:name="Get Service" doc:id="58c4b750-3a0e-4fc1-a198-654b5a625c3a" name="get-services_mongo-clientSub_Flow" target="service" />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="0e958ce6-67ab-411b-a6d0-799e5877c255" type="HTTP:NOT_FOUND">
					<set-variable value="#[[]]" doc:name="Service [ ]" doc:id="f9fa8aaa-df56-47a9-9244-5fd6f2a9e97d" variableName="service"/>
				</on-error-continue>
			</error-handler>
		</try>
		<set-variable value='#["Y"]' doc:name='Set activo "Y"' doc:id="75bb98b3-45b7-4350-bbcd-db242862eb1e" variableName="activo" />
		<try doc:name="Try" doc:id="60cf6f6b-641b-47ef-aae1-2d37534d21b2" >
			<flow-ref doc:name="Get ActiveService" doc:id="05c01ddb-bf93-4e90-bc22-c74e8ae0001b" name="get-services_mongo-clientSub_Flow" target="activeService" />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="81ec0c25-836f-4fbd-8b86-bbefba692255" type="HTTP:NOT_FOUND">
					<set-variable value="#[[]]" doc:name="Active Service [ ]" doc:id="f9bc1506-dcac-41b1-922a-33a632e3c1f7" variableName="activeService" />
				</on-error-continue>
			</error-handler>
		</try>
		<ee:transform doc:name="Service Validations" doc:id="1e7ed01d-8f92-46d8-a2f6-ff27e480d8b2" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="serValidations" ><![CDATA[%dw 2.0
output application/json
import * from dw::core::Arrays
var validStatus = ["1","2","12","18","5","6","7","9"]
var service = vars.service filter (v,i) -> ( validStatus some $ == v.Estado.Principal.Codigo)
var activeService = vars.activeService filter ( upper($.Estado) == "ACTIVO" or upper($.Estado) == "ACTIVO" or upper($.Estado) == "ACTIVO")
---
sizeOf(service) + sizeOf(activeService) >= 1]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="Validations ok?" doc:id="799f696e-f1f9-4e6b-a1f6-61978dd1b79d" >
			<when expression="#[vars.serValidations == true]">
				<flow-ref doc:name="Flow Reference to registerUser" doc:id="b18e999f-b8a6-4637-83ba-721ad6b2723b" name="registerUser"/>
			</when>
			<otherwise >
				<ee:transform doc:name="Negative 409 Bad Request" doc:id="8d8788dd-b953-4ce7-a1fb-e24bc53ea090" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": 409,
  "code": "CONFLICT",
  "message": {
    "message": "Could not validate the services"
  },
  "messageServer": "Conflict.",
  "cause": [
    {
      "origin": "mietb-xapi-services",
    }
  ]
}]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
409]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="registerUser" doc:id="488f374d-0746-4521-a76b-8c2dc5fbe00a" >
		<java:invoke-static method="decrypt(java.lang.String, java.lang.String)" doc:name="Decrypt" doc:id="712981a2-a71e-4157-a8c4-df936504880e" class="com.etb.EncryptionUtils" target="decryptedPassword">
					<java:args><![CDATA[#[{
	arg0: vars.inputBody.cliente.password,
	arg1: p('registrarHogar.key2')
}]]]></java:args>
				</java:invoke-static>
		<java:invoke-static method="encrypt(java.lang.String, java.lang.String)" doc:name="Encrypt" doc:id="509a89d8-ca29-479b-92a4-c689b52cda9f" class="com.etb.EncryptionUtils" target="encryptedPassword">
					<java:args><![CDATA[#[{
	arg0: vars.decryptedPassword,
	arg1: p('registrarHogar.key1')
}]]]></java:args>
				</java:invoke-static>
		<ee:transform doc:name="Prepare User" doc:id="fc2dc3f5-c29a-4c89-9f9a-96c9393b34a7" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "Actualizacion_Contraseña": true,
    "FechaActivacion": now() >> "America/Bogota",
    "FechaExpedicion": if(upper(vars.segmento) == "HOGAR") vars.inputBody.cliente.fechaExpedicion else vars.inputBody.representanteLegal.fechaExpedicion,
    "Estado": false,
    "Estado_Registro": "Pre-Registro",
    "Identificador_Peticion_Creacion": vars.headers.'X-CORRELATION-ID',
    "Mail": vars.inputBody.cliente.correoElectronico,
    "NumIdentificacion": if(upper(vars.segmento) == "HOGAR") vars.inputBody.cliente.numeroIdentificacion else vars.inputBody.representanteLegal.numeroIdentificacion,
    "Password": vars.encryptedPassword,
    "Requiere_Actualizar_Pwd": false,
    "TipoIdentificacion":  if(upper(vars.segmento) == "HOGAR") p('correspondencia.' ++ vars.inputBody.cliente.tipoIdentificacion) else p('correspondencia.' ++ vars.inputBody.representanteLegal.tipoIdentificacion),
    "TipoRegistro": "Registro Light",
    "Widgets": [
        {
            "Application_Date": "2023-01-03T16:07:29.4524664Z",
            "Widget": {
                "_id": "6217d775f3893c92053f231e",
                "Widget": "Servicios"
            }
        }
    ]
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="Insert new User" doc:id="61ae78f4-520c-422d-9824-1345c1ce86f2" name="post-client_mongo-clientSub_Flow" />
		<ee:transform doc:name="Set output" doc:id="310d701c-8e72-4224-914e-ccd1a1e8f1ee" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	result: 1,
	description: "Usuario creado."
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<async doc:name="Async" doc:id="855503ff-ca45-4dcf-9b54-9748eb5c533f" >
			<ee:transform doc:name="Set mail params" doc:id="3caed0d5-355a-45e4-94d2-241aa13a38b6">
				<ee:message />
				<ee:variables>
					<ee:set-variable variableName="mailBody"><![CDATA[%dw 2.0
output application/json
---
{
    "tipo_canal": "EMAIL",
    "addId": p('oracle-sapi.sendMail.addId'),
    "triggerId": p('oracle-sapi.sendMail.triggerId'),
    "fields": [
              "EMAIL_ADDRESS_",
              "NOMBRE",
              "CEDULA",
              "URL_MIETB",
              "PLAN_OPCIONAL1"
          ],
    "records": [
        vars.inputBody.cliente.correoElectronico,
        upper(vars.inputBody.cliente.nombre),
        if(vars.segmento == "HOGAR") vars.inputBody.cliente.numeroIdentificacion else vars.inputBody.representanteLegal.numeroIdentificacion,
    ],
    "flagRegistro": true
  }]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="Send email" doc:id="05c98dae-ceb5-46ca-929f-80f3b9fae3b7" name="oracle-clientSub_Flow" />
		</async>
	</sub-flow>
