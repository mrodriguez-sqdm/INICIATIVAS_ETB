<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="post-login-pau-client"
		doc:id="7555fd1f-d02c-4756-85d6-5329893b9eb9">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /login"]' />

		<http:request doc:name="POST /login"
			doc:id="4d0df5c8-60eb-472b-b384-055faab94e81"
			config-ref="HTTP_Pau_Request_Config"
			method="${pau.login.post.method}"
			path="${pau.login.path}" sendCorrelationId="AUTO"
			target="backendResponse" responseTimeout="${pau.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json"
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /login | status=AUTHENTICATED"]' />
	</sub-flow>
	<sub-flow name="post-connector-by-id-pau-client"
		doc:id="d5e1e0da-5f49-4bc0-b6ee-4c0e5f192de7">
		<logger level="INFO" doc:name="Log Request"
			doc:id="a5c3b496-8c98-49a1-8575-6c41499e0712"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /conector-by-identificador"]' />
		<http:request doc:name="POST /conector-by-identificador"
			doc:id="78a893ff-cce2-403f-8eba-bfc6bad6994c"
			config-ref="HTTP_Pau_Request_Config"
			method="${pau.connectorById.post.method}"
			path="${pau.connectorById.path}" sendCorrelationId="AUTO"
			responseTimeout="${pau.responseTimeout}" target="backendResponse">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json",
    "token": vars.pauToken
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			doc:id="d6d3d533-80f7-42c6-9da3-f5d224564ec4"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /conector-by-identificator | status=CREATED"]' />
	</sub-flow>
	<sub-flow name="post-notification-pau-client"
		doc:id="ec9d900a-9e89-46b5-93a0-a61f889c04b4">
		<logger level="INFO" doc:name="Log Request"
			doc:id="546bf155-e115-4d06-9caa-525adc6d7bb9"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /notificacion-set"]' />
		<http:request doc:name="POST /notificacion-set"
			doc:id="c33b2c8d-5af9-45cc-8c3d-77605b472b37"
			config-ref="HTTP_Pau_Request_Config"
			method="${pau.notification.post.method}"
			path="${pau.notification.path}" sendCorrelationId="AUTO"
			responseTimeout="${pau.responseTimeout}" target="backendResponse">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json",
    "token": vars.pauToken
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			doc:id="3a3a73a5-1b0c-44a0-9e9c-8fa45f43a98b"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /notificacion-set | status=CREATED"]' />
	</sub-flow>
</mule>
