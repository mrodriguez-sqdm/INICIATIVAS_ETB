<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<apikit:config name="silice-sapi-services-config"
		api="resource::35a39a92-efa9-49b6-8f13-d66508fd2f35:silice-sapi-services:1.0.3:raml:zip:silice-sapi-services.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<flow name="silice-sapi-services-main">
		<http:listener config-ref="HTTP_Listener_Config"
			path="${api.basePath}">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<flow-ref doc:name="initial-loggin-Sub_Flow"
			doc:id="839c9fe7-df84-4ea4-b4d4-a05288573b18"
			name="initial-loggin-Sub_Flow" />
		<apikit:router config-ref="silice-sapi-services-config" />
		<async doc:name="Async"
			doc:id="b2ba2895-14c9-4ff2-a794-da5b7b7ffc64">
			<flow-ref doc:name="loggin-client-call"
				doc:id="5d4b0e4c-0972-484f-bcbb-789d83284dce"
				name="loggin-client-call" />
		</async>
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow name="silice-sapi-services-console">
		<http:listener config-ref="HTTP_Listener_Config"
			path="/console/*">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			config-ref="silice-sapi-services-config" />
		<error-handler ref="common-error-handler-v2" />
	</flow>
	<flow
		name="post:\notifications:application\json:silice-sapi-services-config">
		<flow-ref doc:name="post-notifications-orchestrator"
			doc:id="9e6208cd-1b4d-4a94-b296-1030c05fe317"
			name="post-notifications-orchestrator" />
	</flow>
	<flow name="token-cleanup-flow">
		<scheduler doc:name="710 Minute Token Expiry Trigger">
			<scheduling-strategy>
				<fixed-frequency frequency="710" timeUnit="MINUTES" />
			</scheduling-strategy>
		</scheduler>

		<logger level="INFO" doc:name="Log Cleanup Start"
			message="Starting scheduled Object Store token cleanup..." />

		<!-- Instantly wipes all cached tokens from the partition -->
		<os:clear doc:name="Clear Expired Tokens"
			objectStore="Token_Object_Store" />
		<logger level="INFO" doc:name="Log Cleanup End"
			message="Object Store token partition successfully cleared. Next request will fetch a fresh token." />
	</flow>

</mule>
