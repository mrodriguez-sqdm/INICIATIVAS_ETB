<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<sub-flow name="post-notifications-orchestrator"
		doc:id="029cce0a-392e-46ec-89b5-a5fe5979f941">
		<logger level="INFO" doc:name="Log Orchestration Start"
			message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=POST /notifications"]' />
		<ee:transform doc:name="set initial payload"
			doc:id="122708ee-3139-4c9d-b8b1-7b2d8a4a24d3">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="initialPayload"><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="get-auth-token"
			doc:id="02fdbc9b-9d46-4cc0-bd29-a109142dc33b" name="get-auth-token" />
		<flow-ref doc:name="set-connector-by-id"
			doc:id="077ce273-762d-4ad8-8a34-d33124d42264"
			name="set-connector-by-id" />
		<flow-ref doc:name="send-pau-notification"
			doc:id="79b4e169-4dc0-4c7f-8bd6-f81b6d0370a7"
			name="send-pau-notification" />
		<ee:transform doc:name="set response"
			doc:id="2443e73e-8ba8-4e37-b23f-81a803d4dc8f">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	status: "200",
	message: "Notification Sent Successfully",
	result: {
		notificationStatus: "ok",
		notificationId: payload[0].data.'notifiacion_id'
	}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Log Orchestration End"
			message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=POST /notifications | status=201"]' />
	</sub-flow>
	<sub-flow name="get-auth-token"
		doc:id="64149dd6-b518-4551-9200-029491b9801a">
		<os:retrieve doc:name="retrieve OS token"
			doc:id="07dde943-2df1-410b-b7db-4bc59482a89b" key="apiToken"
			objectStore="Token_Object_Store" target="osToken">
			<os:default-value><![CDATA[#[{
	"accessToken": null,
	"expiryTime": null,
	"pauDomain": null
}]]]></os:default-value>
		</os:retrieve>
		<choice doc:name="validate token from OS"
			doc:id="34332513-e057-49e6-be6f-5e74ea3b3b9a">
			<when
				expression="#[vars.osToken.accessToken != null and (now() &lt; vars.osToken.expiryTime) and vars.osToken.pauDomain != null]">
				<ee:transform doc:name="set pauToken and pauDomain"
					doc:id="b972c7c6-063e-49f9-8a63-a77f45051af0">
					<ee:message>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="pauToken"><![CDATA[%dw 2.0
output application/json
---
vars.osToken.accessToken]]></ee:set-variable>
						<ee:set-variable variableName="pauDomain"><![CDATA[%dw 2.0
output application/json
---
vars.osToken.pauDomain]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="set pau login request"
					doc:id="8fe97d8d-2558-4804-9c48-eb02f3ce68aa">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/x-www-form-urlencoded
---
{
	"username": p('secure::pau.user'),
	"password": p('secure::pau.pass')
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<flow-ref doc:name="post-login-pau-client"
					doc:id="e9c12c62-0d49-46cf-b255-ec82bd4baceb"
					name="post-login-pau-client" />
				<ee:transform doc:name="set token to store"
					doc:id="5ca566d8-6c7b-48fe-a067-1964d4b1de90">
					<ee:message>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="tokenToStore"><![CDATA[%dw 2.0
output application/json
---
{
	"accessToken": payload.token,
	"expiryTime": now() >> "UTC" + |PT710M|,
	"pauDomain": (payload.cookie.dominio default "" ++ payload.cookie.path default "")
}]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<os:store doc:name="store OS token"
					doc:id="4638a728-3295-403f-bc24-9869e3936d4f" key="apiToken"
					objectStore="Token_Object_Store">
					<os:value><![CDATA[#[vars.tokenToStore]]]></os:value>
				</os:store>
				<ee:transform doc:name="set pauToken and pauDomain"
					doc:id="d7542fb4-b7d9-4130-be53-869021183d8d">
					<ee:message>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="pauToken"><![CDATA[%dw 2.0
output application/json
---
vars.tokenToStore.accessToken]]></ee:set-variable>
						<ee:set-variable variableName="pauDomain"><![CDATA[%dw 2.0
output application/json
---
vars.tokenToStore.pauDomain]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="set-connector-by-id"
		doc:id="d4404199-6595-4b1f-97c5-81d7ee7eb86e">
		<ee:transform doc:name="set pau connector by id request"
			doc:id="799747cf-199a-428b-bbd5-03c198f190b6">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/x-www-form-urlencoded
---
{
	"identificador": vars.initialPayload.notification.receiverPhoneNumber,
	"interface_id": "21",
	"entidad_interface_id": "5"
}]]></ee:set-payload>
			</ee:message>
			<ee:variables>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="post-connector-by-id-pau-client"
			doc:id="5769df10-89f4-48d5-91d5-03dae0defab1"
			name="post-connector-by-id-pau-client" />
		<flow-ref doc:name="validate-pau-response"
			doc:id="a8fc999d-5c0d-4e8b-869d-07e22be6a12a"
			name="validate-pau-response" />
	</sub-flow>
	<sub-flow name="send-pau-notification"
		doc:id="becf615c-abeb-4970-a0fb-57af8664f13e">
		<ee:transform doc:name="set pau notification request"
			doc:id="a7212cc9-19c4-41ec-98df-516d82c0e2c4">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/x-www-form-urlencoded
---
{
	"conector_id": payload.data.id,
	"tipo": "1",
	"texto": '&SEND_TEMPLATE#WABA#{"plantilla":"$(vars.initialPayload.notification.templateName)","body_param":["$(vars.initialPayload.notification.receiverName)","$(vars.pauDomain)"]}'
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="post-notification-pau-client"
			doc:id="618cac09-dab1-40fb-82fb-7d3ea8fa9cbb"
			name="post-notification-pau-client" />
		<flow-ref doc:name="validate-pau-response"
			doc:id="76bde8db-9a90-41b3-a189-386cc28f8949"
			name="validate-pau-response" />
	</sub-flow>
	<sub-flow name="validate-pau-response"
		doc:id="b1f86d7c-2cc0-4fd5-894e-224b3a04539a">
		<ee:transform doc:name="normalize pau response"
			doc:id="61cdcd23-0dc3-4b94-a69e-7e7490ef5aa3">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="pauResponse"><![CDATA[%dw 2.0
output application/json
---
if(payload is Array) payload else [payload]]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<choice doc:name="check pau response status"
			doc:id="fd23fdb8-323a-4495-90d8-4137d9a0253f">
			<when expression='#[vars.pauResponse[0].estado == "fail"]'>
				<ee:transform doc:name="get error message"
					doc:id="88e3544b-7bd9-4b0d-b80d-23865e6b5c93">
					<ee:message>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="pauError"><![CDATA[%dw 2.0
output application/json
---
vars.pauResponse[0].parametros.tipo[0] default vars.pauResponse[0].error]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<raise-error doc:name="SILICE:REQUEST_ERROR"
					doc:id="88c33f12-c242-4e00-b79a-c98744be1884"
					description="#[vars.pauError]" type="SILICE:REQUEST_ERROR" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Sucess Log"
					doc:id="2e5da503-5371-4427-8c1d-8a34d60c5e78"
					message='#["ORCHESTRATION | cid=" ++ correlationId ++ " | step=Validate PAU Response | status=PAU Request Completed Successfully"]' />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
