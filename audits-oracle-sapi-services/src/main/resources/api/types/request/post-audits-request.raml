#%RAML 1.0 DataType 
type: object
properties:
  ID:
    type: integer
    example: 1001
    required: false
  PAYLOAD:
    type: string
    example: '{"customerId":"123456","status":"SUCCESS"}'
    required: false
  FECHA:
    type: string
    example: '2026-08-13T08:20:00.000'
    required: false
  ATTRIBUTES:
    type: string
    example: >-
      {"queryParams":{"customerId":"123456"},"headers":{"content-type":"application/json"}}
    required: false
  HTTPCODE:
    type: integer
    example: 200
    required: false
  HOST:
    type: string
    example: customer-papi-services
    required: false
  CORRELATIONID:
    type: string
    example: 4d7e8a21-92d5-4c61-b8b3-456789abcdef
    required: false
  APINAME:
    type: string
    example: customer-papi-services
    required: false
  PROCESSNAME:
    type: string
    example: getCustomer
    required: false
  PATH:
    type: string
    example: /customers/123456
    required: false
  HTTPMETHOD:
    type: string
    example: GET
    required: false
  TIEMPO_RESPUESTA_MS:
    type: integer
    example: 350
    required: false
  IP:
    type: string
    example: '192.168.1.1'
    required: false