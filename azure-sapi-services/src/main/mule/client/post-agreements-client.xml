	<sub-flow name="post-agreements-clientSub_Flow" doc:id="c16e4b38-9db5-48cf-a9be-63b4ff30d4fc" >
		<async doc:name="Async" doc:id="bb7e4cf8-39ba-4bc5-8cd5-f6892fde343b">
			<flow-ref doc:name="Call logger" doc:id="e9e14586-c147-42fe-8239-ba5a77b5d9bc" name="loggin-client-call" />
		</async>
		<azure-storage:upload-blob doc:name="Upload" doc:id="f7263b8f-d77d-46ca-8753-03ed0ff18901" config-ref="Azure_Storage_Config_agreements" contentType="application/pdf">
			<azure-storage:storblob container='#[vars.container]' fileName='#[vars.fileName]' fileStream="#[vars.fileContent]"/>
		</azure-storage:upload-blob>
		<java:invoke-static method="makeBlobPublicWithContentType(String, String, String, String)" doc:name="Invoke static" doc:id="e61fd778-7ac2-430d-b544-fd70ef023759" class="com.etb.AzureHandler" >
			<java:args ><![CDATA[#[{
	"accountName": p('azureStorage-agreements.accountName'),
	"accountKey": p('azureStorage-agreements.accountKey'),
	"containerName": vars.container,
	"blobName" : vars.fileName
}]]]></java:args>
		</java:invoke-static>
	</sub-flow>
