<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:azure-storage="http://www.mulesoft.org/schema/mule/azure-storage"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/azure-storage http://www.mulesoft.org/schema/mule/azure-storage/current/mule-azure-storage.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
		<sub-flow name="post-payment-event-client"
		doc:id="1273b0a4-2909-469d-bf13-50e31b8e2f7d">
		<async doc:name="Async"
			doc:id="defbeab5-3c6b-41a9-a070-1f0fbaec3cc8">
			<flow-ref doc:name="Call logger"
				doc:id="d255edf4-d6d1-42d1-be15-cc1e3fd8b020"
				name="loggin-client-call" />
		</async>
		<azure-storage:add-message-to-queue doc:name="Add message to queue" doc:id="3a79351c-8201-4f06-848d-98a1de35d976" config-ref="Azure_Storage_Config">
			<azure-storage:message queueMessage='#[(payload.attributes map ((item) -&gt; item.value)) joinBy "|"]' queueName="#[p('azureStorage.payment.queue.name')]"/>
		</azure-storage:add-message-to-queue>
		<ee:transform doc:name="Transform Message" doc:id="08358343-3699-4fc3-9f1f-e39b78c593fc" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    code: "202",
    message: "Payment transaction queued successfully"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<async doc:name="Async"
			doc:id="dd99d3be-f0fb-4806-9b92-8d315b91412c">
			<flow-ref doc:name="Call logger"
				doc:id="f89cbcdd-665a-4cb1-8b04-6dea4879e918"
				name="loggin-client-call" />
		</async>

	</sub-flow>
	</mule>
