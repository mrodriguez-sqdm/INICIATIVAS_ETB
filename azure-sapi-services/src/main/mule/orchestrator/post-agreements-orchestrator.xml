<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-agreements-orchestratorSub_Flow" doc:id="be84b30f-4f38-4e73-b0d1-c462b67bd9b4" >
		<flow-ref doc:name="Go to client" doc:id="1f62dfd1-acb7-4b99-b813-c67d5755d7c1" name="post-agreements-clientSub_Flow"/>
		<ee:transform doc:name="Response" doc:id="10b7d6d8-3ac0-4885-8059-35b7dea685d0">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
if(payload == true)
{
	codigo: "200",
	descripcion: "Se actualizó el documento firmado en: " ++ p('azureStorage-agreements.accountName')
}
else
{
	codigo: "500",
	descripcion: "No se pudo actualizar el documento firmado en: " ++ p('azureStorage-agreements.accountName')
}]]></ee:set-payload>
					</ee:message>
			<ee:variables >
				<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
if(payload == true) 200 else 500]]></ee:set-variable>
			</ee:variables>
				</ee:transform>
		<async doc:name="Async" doc:id="cad0527f-e0f5-49b3-8579-94129f6bc8b3" >
			<flow-ref doc:name="Call logger" doc:id="dea8f216-2026-46bb-a5df-a8bacb9b33e8" name="loggin-client-call" />
		</async>
	</sub-flow>
</mule>
