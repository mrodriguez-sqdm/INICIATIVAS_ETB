<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="post-accountState-handlerSub_Flow" doc:id="88e34ab2-5481-4474-a607-25bebe3cca40" >
		<ee:transform doc:name="Capture vars" doc:id="45676f0d-7320-485a-95b9-9ada4082f876" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="filename" ><![CDATA[%dw 2.0
output application/java
---
p('azureStorage.bills.accountStateFolder') ++ payload.parts.filename.content]]></ee:set-variable>
				<ee:set-variable variableName="container" ><![CDATA[%dw 2.0
output application/java
---
payload.parts.container.content]]></ee:set-variable>
				<ee:set-variable variableName="fileContent" ><![CDATA[%dw 2.0
output application/java
---
payload.parts.file.content]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="Go to Orchestrator" doc:id="d641006f-e06e-4908-9348-ed35c092b807" name="post-duplicateBill-orchestratorSub_Flow" />
	</sub-flow>
</mule>
