#%RAML 1.0 DataType
type: object
properties:
  op:
    type: string
    example: "add"
  path:
    type: array
    items:
      type: object
      properties:
        id:
          type: string
          example: "/fields/System.AssignedTo"
        valor: 
          type: any
          example: "BAU"
  requestApp:
    type: string
    example: "REMEDY"
