    <flow name="get:\ETB-certification:zsmart-sapi-services-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "200",
  message: "Success",
  result: {
    res_code: "00000",
    res_message: "Operation success",
    result: {
      resultCode: "0000",
      resultMsg: "success",
      dueAmount: "100.00"
    }
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
