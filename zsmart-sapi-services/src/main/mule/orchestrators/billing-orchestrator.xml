<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="billing-zsmart-orchestrator"
		doc:id="b0e897a3-8eea-4d15-bb57-b70849ad3977">
		<try doc:name="Try" doc:id="46bd68d6-caef-452e-a233-a536ebd7bc40" >
			<logger level="INFO" doc:name="Log Orchestration Start" doc:id="6b65110c-6855-4b7d-a8cb-47ffda1dda93" message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=POST /billing"]' />
			<ee:transform doc:name="set initialPayload" doc:id="8b1e41a5-f3db-4ac9-b0b1-01475f785bbf">
				<ee:message>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="initialPayload"><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<choice doc:name="validate serviceEventId" doc:id="f27f2594-8061-4bd1-969a-68686edd410b" >
				<when expression="#[(vars.initialPayload.header.serviceEventId default null) != null]">
					<ee:transform doc:name="set userProfile auth parameters" doc:id="7c3727c0-f5a9-4b6f-a2fd-844dc912aa11">
						<ee:message>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="zsmartAuthParams" ><![CDATA[%dw 2.0
output application/java
---
{
	appCode: p('zsmartToken.auth.userProfile.appCode'),
	appSecret: p('secure::zsmartToken.auth.userProfile.appSecret')
}]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<flow-ref doc:name="zsmart-auth-get-token" doc:id="0f808620-f738-4490-80da-8347b6e9a1f8" name="zsmart-auth-get-token"/>
					<ee:transform doc:name="set zsmart userProfile request" doc:id="830a09e5-e27f-46d1-8ac9-73fe64426362" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json  
---
{
  access_token: vars.zsmartToken,
  method: "UserProfile",
  version: "1.0",
  content: vars.initialPayload
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</when>
				<otherwise >
					<ee:transform doc:name="set zsmart chargeAdditionalFee request" doc:id="bc3a848e-fc81-44ca-b753-3c054dfb589c">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json  
---
{
  access_token: p('secure::zsmart.addChargeToken'),
  method: "chargeAdditionalFee",
  version: "1.0",
  content: payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
				</otherwise>
			</choice>
			<flow-ref doc:name="billing-zsmart-client" doc:id="8bab1859-5f03-497a-a951-63f7e855e59a" name="billing-zsmart-client" />
			<choice doc:name="validate zsmart response" doc:id="6305409e-a871-4517-929f-9a81ff5cb9a1">
			<when expression='#[(payload.res_code != "00000" or payload.result.responseCode != "0000")]'>
				<ee:transform doc:name="set zsmartEror" doc:id="2d55d0d4-eb4b-41bd-b387-7d82311e03c0">
					<ee:message>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="zsmartError"><![CDATA[%dw 2.0
output application/json
var resCode = payload.res_code default "SYSTEM"
var resultResCode = payload.result.responseCode default "BUSINESS"
var resMessage = payload.res_message default "System Unexpected Error"
var resultResMessage = payload.result.responseMessage  default "Business Unexpected Error"
---
if(payload.result?)
    resultResCode ++ ": " ++ resultResMessage
else
    resCode ++ ": " ++ resMessage]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<choice doc:name="error type" doc:id="1b23199b-fd03-4808-b53f-b3fb2814111a">
					<when expression="#[payload.result?]">
						<raise-error doc:name="ZSMART:BUSINESS_ERROR" doc:id="bc186507-ae47-40bb-9049-9c46c4ec3a12" type="ZSMART:BUSINESS_ERROR" description="#[vars.zsmartError]" />
					</when>
					<otherwise>
						<raise-error doc:name="ZSMART:SYSTEM_ERROR" doc:id="e1e89528-600f-4277-9496-a882d661b86f" type="ZSMART:SYSTEM_ERROR" description="#[vars.zsmartError]" />
					</otherwise>
				</choice>
			</when>
			<otherwise>
				<ee:transform doc:name="set response" doc:id="55a72c06-52e8-4cd1-84c5-ffa90c945118">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "status": "200",
  "message": "Success",
  "result": payload
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
			</otherwise>
		</choice>
			<logger level="INFO" doc:name="Log Orchestration End" message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=POST /billing"]' />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="8b260b11-1b27-4ab2-ad0a-2c17e2da73c2" type="ZSMART:BUSINESS_ERROR">
					<ee:transform doc:name="set business error" doc:id="07aa8028-df13-40ef-9fd8-086310539dce" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "400",
    "code": "ZSMART:BUSINESS_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="e0ba24a0-bace-409e-b898-b3995e34ac66" type="ZSMART:SYSTEM_ERROR">
					<ee:transform doc:name="set system error" doc:id="28c589e6-30f8-454d-9a15-8fe0f11e739a" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "500",
    "code": "ZSMART:SYSTEM_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
</mule>
