<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="querySubscriberProfile-zsmart-orchestrator" doc:id="51b81551-a1ed-4c2b-bedb-b11d4879b083" >
		<try doc:name="Try" doc:id="3421b48e-8cfa-4e67-bb98-1fec11f767ad" >
			<logger level="INFO" doc:name="Log Orchestration Start" doc:id="d3ddfbad-510d-4c32-b416-0c61f9f0fa48" message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=GET /querySubscriberProfile"]'/>
			<ee:transform doc:name="set zsmart request" doc:id="10d29202-12b2-443d-8d5a-d37f9f8caf32" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"
---
{
	access_token: p('secure::zsmart.subscriberProfileToken'),
  	method: "querySubscriberProfile",
  	version: "1.0",
  	content: {
		serviceNumber: attributes.queryParams.serviceNumber,
		areaCode: attributes.queryParams.areaCode
	}
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<flow-ref doc:name="billing-zsmart-client" doc:id="dd9ee6e3-9571-467b-af15-af0b0cb40cfb" name="billing-zsmart-client"/>
			<choice doc:name="validate zsmart response" doc:id="fbdf100f-6ba9-4bb2-9a5f-a9acd6be8434" >
				<when expression='#[(payload.res_code != "00000" or payload.result.resultCode != "0000")]'>
					<ee:transform doc:name="set zsmartError" doc:id="facd5e33-c43f-4ff2-8565-08980a401e02" >
						<ee:message >
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="zsmartError" ><![CDATA[%dw 2.0
output application/json
var resCode = payload.res_code default "99999"
var resultResCode = payload.result.responseCode default "99999"
var resMessage = payload.res_message default "System Unexpected Error"
var resultResMessage = payload.result.responseMessage  default "Business Unexpected Error"
---
if(payload.result?)
    resultResCode ++ ": " ++ resultResMessage
else
    resCode ++ ": " ++ resMessage]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<choice doc:name="error type" doc:id="076c22a8-7083-4dd1-bdd4-ef3585096725" >
						<when expression="#[payload.result?]">
							<raise-error doc:name="ZSMART:BUSINESS_ERROR" doc:id="07bd3c73-0f52-40ec-a0f9-614965cb0666" type="ZSMART:BUSINESS_ERROR" description="#[vars.zsmartError]"/>
						</when>
						<otherwise >
							<raise-error doc:name="ZSMART:SYSTEM_ERROR" doc:id="3bf90b4c-4eb2-474a-b06a-8d86651be84f" type="ZSMART:SYSTEM_ERROR" description="#[vars.zsmartError]"/>
						</otherwise>
					</choice>
				</when>
				<otherwise >
					<ee:transform doc:name="set response" doc:id="62887574-9fb9-4dab-a0fc-9aa947a987bb" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": "200",
  "message": "Success",
  "result": payload
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</otherwise>
			</choice>
			<logger level="INFO" doc:name="Log Orchestration End" doc:id="2100e759-7e0c-4508-8c4d-664db5a8f034" message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=GET /querySubscriberProfile"]'/>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="e9abeaa2-c795-4c08-bb02-2211e3f35123" type="ZSMART:BUSINESS_ERROR">
					<ee:transform doc:name="set business error" doc:id="81bcf71f-2003-4747-a27f-3a0a9369a1a7" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "400",
    "code": "ZSMART:BUSINESS_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="3c99aeed-05f6-4a1e-a4b3-f6171d9e2074" type="ZSMART:SYSTEM_ERROR">
					<ee:transform doc:name="set system error" doc:id="5aee07b0-f007-490e-bba9-cb1d4e8618f2" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "500",
    "code": "ZSMART:SYSTEM_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
</mule>
