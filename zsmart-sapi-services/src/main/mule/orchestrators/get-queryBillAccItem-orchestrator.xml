<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="billAccItem-zsmart-orchestrator" doc:id="1ffcb285-de5b-490d-acde-a7d20d803b5e" >
		<try doc:name="Try" doc:id="7fcd967d-cf3d-4e9e-a262-733f50cb543c" >
			<logger level="INFO" doc:name="Log Orchestration Start" doc:id="5954f5a6-1721-4225-8e93-c7b1ca85586b" message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=GET /billAccItem"]' />
			<ee:transform doc:name="set zsmart request" doc:id="df0320fc-f23f-4f36-8913-61b2af1c133d" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"

var transId =
	if (!isEmpty(attributes.queryParams.msisdn))
		attributes.queryParams.msisdn
	else
		attributes.queryParams.accountNumber

---
{
  access_token: p('secure::zsmart.billAccItemToken'),
  method: "queryBillAcctItem",
  version: "1.0",
  content: {
  	transactionID: transId ++ (now() as String {format: "YYYYMMddHHmmss"}),
	msisdn: attributes.queryParams.msisdn,
	accountNumber: attributes.queryParams.accountNumber,
	billNumber: attributes.queryParams.billNumber,
	channelCode: attributes.queryParams.channelCode
  }
}]]></ee:set-payload>
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="offset" ><![CDATA[%dw 2.0
output application/json
---

attributes.queryParams.offset default 0
]]></ee:set-variable>
					<ee:set-variable variableName="limit" ><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.limit default 10]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="billing-zsmart-client" doc:id="09562414-36ba-4371-b66f-1aaffe9e7333" name="billing-zsmart-client" />
			<choice doc:name="validate zsmart response" doc:id="f107dbbc-2a72-4089-baa2-1df28ea23695" >
				<when expression='#[(payload.res_code != "00000" or payload.result.resultCode != "0000")]' >
					<ee:transform doc:name="set zsmartError" doc:id="d2339ba0-9f0a-4b58-8fe5-cdf5709d6963" >
						<ee:message />
						<ee:variables >
							<ee:set-variable variableName="zsmartError" ><![CDATA[%dw 2.0
output application/json
var resCode = payload.res_code default "99999"
var resultResCode = payload.result.responseCode default "99999"
var resMessage = payload.res_message default "System Unexpected Error"
var resultResMessage = payload.result.responseMessage  default "Business Unexpected Error"
---
if(payload.result?)
    resultResCode ++ ": " ++ resultResMessage
else
    resCode ++ ": " ++ resMessage]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<choice doc:name="error type" doc:id="f4ac63ba-f27c-4ded-bef2-a72e29c65313" >
						<when expression="#[payload.result?]" >
							<raise-error doc:name="ZSMART:BUSINESS_ERROR" doc:id="c9589579-7fb9-495f-9b0f-b9a347acd578" type="ZSMART:BUSINESS_ERROR" description="#[vars.zsmartError]" />
						</when>
						<otherwise >
							<raise-error doc:name="ZSMART:SYSTEM_ERROR" doc:id="9a51b569-e183-4e64-9779-2d2fa9746ca0" type="ZSMART:SYSTEM_ERROR" description="#[vars.zsmartError]" />
						</otherwise>
					</choice>
				</when>
				<otherwise >
					<ee:transform doc:name="set response" doc:id="2c40edd1-dac8-4a95-9ec7-d4da080415c0" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": "200",
  "message": "Success",
  "result": payload
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</otherwise>
			</choice>
			<logger level="INFO" doc:name="Log Orchestration End" doc:id="c8c88ee5-55fc-4f63-b0a5-b4956450bc59" message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=GET /billAccItem"]' />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="ab3b3ad7-b972-4f39-8f67-f78461b3ef9f" type="ZSMART:BUSINESS_ERROR" >
					<ee:transform doc:name="set business error" doc:id="50c01b79-c51c-43f9-9d90-c02831a87d0b" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "400",
    "code": "ZSMART:BUSINESS_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="149e2bc0-18b1-4ba2-aeb4-50b721d85cff" type="ZSMART:SYSTEM_ERROR" >
					<ee:transform doc:name="set system error" doc:id="8657edfe-4137-4d14-9edc-7a3e7c572354" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "500",
    "code": "ZSMART:SYSTEM_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
</mule>
