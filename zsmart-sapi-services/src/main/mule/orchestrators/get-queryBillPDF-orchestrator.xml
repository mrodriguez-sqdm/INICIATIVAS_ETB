<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="queryBillPDF-zsmart-orchestrator" doc:id="e40dc0f6-530b-4cf7-b5e0-ecf01ac9f2ef" >
		<try doc:name="Try" doc:id="91542438-0a0e-4381-b7ce-7978e66c0476" >
			<logger level="INFO" doc:name="Log Orchestration Start" doc:id="e96a2b5b-d2e2-497e-bbc0-8d4dee9b3848" message='#["ORCHESTRATOR START | cid=" ++ correlationId ++ " | operation=GET /queryBillPDF"]' />
			<ee:transform doc:name="set initialParams" doc:id="bbeb2b4e-818d-438c-8378-b60356e9911f">
				<ee:message />
				<ee:variables>
					<ee:set-variable variableName="initialParams"><![CDATA[%dw 2.0
output application/java
---
attributes.queryParams
]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<ee:transform doc:name="set accountReceivableProfile auth parameters" doc:id="3cf9c694-6a91-48d1-b962-db3c38767098">
				<ee:message />
				<ee:variables>
					<ee:set-variable variableName="zsmartAuthParams"><![CDATA[%dw 2.0
output application/java
---
{
  appCode: p('zsmartToken.auth.accountReceivableProfile.appCode'),
  appSecret: p('secure::zsmartToken.auth.accountReceivableProfile.appSecret'),
  privateKey: p('secure::zsmartToken.auth.accountReceivableProfile.privateKey')
}]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="zsmart-auth-get-token" doc:id="957eb0a3-eeaf-46c3-b48a-fa00e0e66b17" name="zsmart-auth-get-token"/>
			<ee:transform doc:name="set zsmart request" doc:id="3bb63700-4e01-4dee-8eb9-161604bd05df" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json skipNullOn="everywhere"
---
{
	access_token: vars.zsmartToken,
  	method: "queryBillPDF",
  	version: "1.0",
  	content: {
  		transactionID: vars.initialParams.accountNumber ++ (now() as String {format: "YYYYMMddHHmmss"}),
		invoiceNumber:vars.initialParams.invoiceNumber,
		accountNumber: vars.initialParams.accountNumber
	}
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<flow-ref doc:name="billing-zsmart-client" doc:id="3ca98c95-31d3-43ab-9251-d6f69b90593d" name="billing-zsmart-client" />
			<choice doc:name="validate zsmart response" doc:id="c1943b23-e584-453a-8411-ed92d2895890" >
				<when expression='#[(payload.res_code != "00000" or payload.result.resultCode != "0000")]' >
					<ee:transform doc:name="set zsmartError" doc:id="c370088a-2cee-492f-8533-b8765717aefb" >
						<ee:message />
						<ee:variables >
							<ee:set-variable variableName="zsmartError" ><![CDATA[%dw 2.0
output application/json
var resCode = payload.res_code default "99999"
var resultResCode = payload.result.responseCode default "99999"
var resMessage = payload.res_message default "System Unexpected Error"
var resultResMessage = payload.result.responseMessage  default "Business Unexpected Error"
---
if(payload.result?)
    resultResCode ++ ": " ++ resultResMessage
else
    resCode ++ ": " ++ resMessage]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
					<choice doc:name="error type" doc:id="b57bddfc-ca42-4d9f-ab16-fdaccf007dfa" >
						<when expression="#[payload.result?]" >
							<raise-error doc:name="ZSMART:BUSINESS_ERROR" doc:id="ea3a89af-dc1d-42e9-acbd-9d0c0154d624" type="ZSMART:BUSINESS_ERROR" description="#[vars.zsmartError]" />
						</when>
						<otherwise >
							<raise-error doc:name="ZSMART:SYSTEM_ERROR" doc:id="43de5b72-7dd3-4950-b4de-44988e88a93b" type="ZSMART:SYSTEM_ERROR" description="#[vars.zsmartError]" />
						</otherwise>
					</choice>
				</when>
				<otherwise >
					<ee:transform doc:name="set response" doc:id="b20cc04a-f8a1-4367-b413-942f7bdb1d40" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  "status": "200",
  "message": "Success",
  "result": payload
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</otherwise>
			</choice>
			<logger level="INFO" doc:name="Log Orchestration End" doc:id="9fc38800-3272-4a4b-a6c7-148c1cd0826a" message='#["ORCHESTRATOR END | cid=" ++ correlationId ++ " | operation=GET /queryBillPDF"]' />
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="001364cd-5290-4215-8fa6-50fdee6ed337" type="ZSMART:BUSINESS_ERROR" >
					<ee:transform doc:name="set business error" doc:id="6ae239e4-df6e-4119-bbdc-289136fd4a5a" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "400",
    "code": "ZSMART:BUSINESS_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
400]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue1" doc:id="259c35f9-afaa-4052-a209-57548d0bd558" type="ZSMART:SYSTEM_ERROR" >
					<ee:transform doc:name="set system error" doc:id="ef97ca0e-3983-4f27-8794-1aedd91afc3d" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "status": "500",
    "code": "ZSMART:SYSTEM_ERROR",
    "message": error.description,
    "messageServer": error.description,
    "cause": [
        {
            "origin": "zsmart-sapi-services",
            "message": error.description
        }
    ]
}]]></ee:set-payload>
						</ee:message>
						<ee:variables >
							<ee:set-variable variableName="httpStatus" ><![CDATA[%dw 2.0
output application/java
---
500]]></ee:set-variable>
						</ee:variables>
					</ee:transform>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
</mule>
