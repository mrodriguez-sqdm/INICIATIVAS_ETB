<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<sub-flow name="get-resources-backend-client"
		doc:id="a0ad8c52-b545-4454-b69c-aa6b485e2208">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=GET /resources"]' />

		<http:request config-ref="HTTP_Backend_Request_Config"
			method="${backend.resources.get.method}"
			path="${backend.resources.path}" target="backendResponse"
			doc:name="GET /resources" sendCorrelationId="AUTO"
			responseTimeout="${backend.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json"
}]]]></http:headers>
		</http:request>

		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=GET /resources | status=OK"]' />
	</sub-flow>
	<sub-flow name="post-resources-backend-client"
		doc:id="7555fd1f-d02c-4756-85d6-5329893b9eb9">
		<logger level="INFO" doc:name="Log Request"
			message='#["HTTP CLIENT START | cid=" ++ correlationId ++ " | operation=POST /resources"]' />

		<http:request doc:name="POST /resources"
			doc:id="4d0df5c8-60eb-472b-b384-055faab94e81"
			config-ref="HTTP_Backend_Request_Config"
			method="${backend.resources.post.method}"
			path="${backend.resources.path}" sendCorrelationId="AUTO"
			target="backendResponse" responseTimeout="${backend.responseTimeout}">
			<http:headers><![CDATA[#[output application/java
---
{
    "X-Correlation-Id": correlationId,
    "Accept": "application/json"
}]]]></http:headers>
		</http:request>
		<logger level="INFO" doc:name="Log Response"
			message='#["HTTP CLIENT END | cid=" ++ correlationId ++ " | operation=POST /resources | status=CREATED"]' />
	</sub-flow>
</mule>
