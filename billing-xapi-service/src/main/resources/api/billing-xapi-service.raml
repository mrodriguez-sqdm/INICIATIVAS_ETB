#%RAML 1.0
title: billing-xapi-service
version: v1
baseUri: https://billing-xapi-service-{env}.us-e2.cloudhub.io/{version}
protocols:
  - HTTPS

description: |
  # Billing Experience API
  Unified entry point for all ETB Colombia billing processes with ZSmart.
  The processCode field in the request body discriminates the business process to execute:
  SALE, PLAN_CHANGE, SVA, SUSPENSION, RESTORATION, NUMBER_CHANGE, VOLUNTARY_CANCELLATION.

annotationTypes:
  operationId: string

traits:
  tibcoHeaders: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/tibcorequestheaders/1.0.6/tibcorequestheaders.raml

mediaType:
  - application/json

securitySchemes:
  etb_oauth_2_0: !include exchange_module/35a39a92-efa9-49b6-8f13-d66508fd2f35/etb-oauth-20/1.0.1/etb-oauth-20.raml

types:
  BillingProcessBase:         !include datatypes/request/billing-process-base.raml
  BillingSaleRequest:         !include datatypes/request/processes/sale.raml
  BillingPlanChangeRequest:   !include datatypes/request/processes/plan-change.raml
  BillingSvaRequest:          !include datatypes/request/processes/sva.raml
  BillingSuspensionRequest:   !include datatypes/request/processes/suspension.raml
  BillingRestorationRequest:  !include datatypes/request/processes/restoration.raml
  BillingNumberChangeRequest: !include datatypes/request/processes/number-change.raml
  BillingVolCancRequest:      !include datatypes/request/processes/voluntary-cancellation.raml

/billing-process:
  post:
    (operationId): execute-BillingProcess
    is:
      - tibcoHeaders
    securedBy: [ etb_oauth_2_0 ]
    displayName: Execute Billing Process
    description: |
      Executes a billing process in ZSmart determined by the processCode field.
      Each processCode maps to a specific ZSmart operation sequence:
        - SALE                  → F2 (customer + account) → A1 (service). Saga pattern.
        - PLAN_CHANGE           → C6 (modify active offer).
        - SVA                   → B6 (add/remove value-added services).
        - SUSPENSION            → B4 (suspend service).
        - RESTORATION           → B5 (restore suspended service).
        - NUMBER_CHANGE         → A7 | A4 | A5 (change service number).
        - VOLUNTARY_CANCELLATION → A8 (terminate service and close account).
      Idempotent — send X-Correlation-Id to avoid duplicate processing within 24h.
    body:
      application/json:
        type: !include datatypes/request/billing-process-request.raml
        examples:
         SALE:                   !include examples/request/sale.json
         PLAN_CHANGE:            !include examples/request/plan-change.json
         SVA:                    !include examples/request/sva.json
         SUSPENSION:             !include examples/request/suspension.json
         RESTORATION:            !include examples/request/restoration.json
         NUMBER_CHANGE:          !include examples/request/number-change.json
         VOLUNTARY_CANCELLATION: !include examples/request/voluntary-cancellation.json
    responses:
      200:
        description: Process executed successfully (PLAN_CHANGE, SVA, SUSPENSION, RESTORATION, NUMBER_CHANGE, VOLUNTARY_CANCELLATION).
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            examples:
              PLAN_CHANGE:            !include examples/response/plan-change-200.json
              SVA:                    !include examples/response/sva-200.json
              SUSPENSION:             !include examples/response/suspension-200.json
              RESTORATION:            !include examples/response/restoration-200.json
              NUMBER_CHANGE:          !include examples/response/number-change-200.json
              VOLUNTARY_CANCELLATION: !include examples/response/voluntary-cancellation-200.json
      201:
        description: Resource created successfully (SALE).
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            example: !include examples/response/sale-201.json
      400:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-400.json
      401:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-401.json
      409:
        description: Duplicate request detected — idempotency key already processed.
        body:
          application/json:
            type: !include datatypes/response/billing-process-response.raml
            example: !include examples/response/sale-201.json
      422:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-422.json
      503:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-503.json
      504:
        body:
          application/json:
            type: !include datatypes/response/error.raml
            example: !include examples/response/error-504.json

/health:
  get:
    (operationId): get-Health
    displayName: Get Health
    description: Health check endpoint polled by the Load Balancer every 30s.
    responses:
      200:
        body:
          application/json:
            example: !include examples/response/health-200.json