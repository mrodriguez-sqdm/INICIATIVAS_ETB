#%RAML 1.0 DataType 
type: object
properties:
  transactionId:
    type: string
    example: 3fa85f64-...
    required: false
  status:
    type: string
    example: ERROR
    required: false
  error:
    type: object
    properties:
      code:
        type: string
        example: VALIDATION_ERROR
        required: false
      message:
        type: string
        example: El campo customer.documentNumber es requerido
        required: false
      details:
        type: array
        required: false
        items:
          type: object
          properties:
            field:
              type: string
              example: customer.documentNumber
              required: false
            issue:
              type: string
              example: must not be blank
              required: false
