#%RAML 1.0 DataType 
type: object
properties:
  transactionId:
    type: string
    example: 3fa85f64-5717-4562-b3fc-2c963f66afa6
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  createdAt:
    type: string
    example: '2026-03-16T10:30:05Z'
    required: false
  result:
    type: object
    properties:
      customerId:
        type: string
        example: '12345678'
        required: false
      accountId:
        type: string
        example: ACC-001-2026
        required: false
      serviceId:
        type: string
        example: '98765'
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false
