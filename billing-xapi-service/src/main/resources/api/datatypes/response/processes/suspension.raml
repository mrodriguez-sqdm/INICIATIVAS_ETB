#%RAML 1.0 DataType
type: object
discriminatorValue: SUSPENSION
properties:
  transactionId:
    type: string
    example: d4e5f6a7-b8c9-0123-defa-123456789012
    required: false
  processCode:
    type: string
    required: false
  status:
    type: string
    example: SUCCESS
    required: false
  updatedAt:
    type: string
    example: '2026-03-19T10:00:01Z'
    required: false
  result:
    type: object
    required: false
    properties:
      customerId:
        type: string
        example: '12345678'
        required: false
      serviceId:
        type: string
        example: '98765'
        required: false
      serviceStatus:
        type: string
        example: SUSPENDED
        required: false
      zsmartResponseCode:
        type: string
        example: '0'
        required: false
      zsmartMessage:
        type: string
        example: Success
        required: false