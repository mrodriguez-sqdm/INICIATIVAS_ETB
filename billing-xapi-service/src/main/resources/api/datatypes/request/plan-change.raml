#%RAML 1.0 DataType
type: object
description: Plan Change process request — canonical contract between CRM and billing-xapi-service
properties:
  transaction:
    type: object
    properties:
      id:
        type: string
        description: UUID — transaction correlationId
        pattern: "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        example: "7bc91f32-3a4d-4891-b1fa-9e8d7c5af021"
      timestamp:
        type: datetime
        description: ISO-8601 timestamp
        example: "2026-03-16T14:00:00Z"
  customer:
    type: object
    properties:
      externalId:
        type: string
        description: Customer ID in ZSmart (custId)
        example: "12345678"
  service:
    type: object
    properties:
      externalId:
        type: string
        description: Service instance ID in ZSmart (prodInstId)
        example: "98765"
      effectiveDate:
        type: string
        description: Plan change effective date in YYYYMMDDHHMMSS format
        pattern: "^[0-9]{14}$"
        example: "20260316140000"
      currentOffer:
        type: object
        description: Active offer to be removed
        properties:
          offerInstanceId:
            type: string
            description: Current offer instance ID
            example: "OFFER-2026-001"
          offerCode:
            type: string
            description: Current plan code
            example: "GPON_300MB_BASIC"
      newOffer:
        type: object
        description: New offer to be activated
        properties:
          offerInstanceId:
            type: string
            description: New offer instance ID
            example: "OFFER-2026-002"
          offerCode:
            type: string
            description: New plan code
            example: "GPON_500MB_PLUS"
      charges?:
        type: array
        items:
          type: object
          properties:
            type?:
              type: string
              enum: [ONE_OFF, ADVANCE]
              example: "ONE_OFF"
            amount?:
              type: number
              description: Charge amount. Positive = debit
              example: 15000
            itemTypeCode:
              type: string
              description: Required when at least one charge is present
              example: "PLAN_CHANGE_FEE_001"
