#%RAML 1.0 DataType 
type: object
properties:
  transaction:
    type: object
    properties:
      id:
        type: string
        example: string (UUID) — M — correlationId
        required: false
      timestamp:
        type: string
        example: datetime ISO-8601 — M
        required: false
  customer:
    type: object
    properties:
      externalId:
        type: string
        example: string — M — custId en ZSmart
        required: false
      name:
        type: string
        example: string — M
        required: false
      type:
        type: string
        example: 'enum: PERSONAL | BUSINESS — M'
        required: false
      documentType:
        type: string
        example: 'enum: CC | NIT | PASSPORT — M'
        required: false
      documentNumber:
        type: string
        example: string — M
        required: false
      birthDate:
        type: string
        example: string YYYYMMDD — O
        required: false
      isVip:
        type: string
        example: boolean — M
        required: false
      status:
        type: string
        example: 'enum: ACTIVE | INACTIVE — M'
        required: false
  account:
    type: object
    properties:
      externalId:
        type: string
        example: string — M — acctId en ZSmart
        required: false
      paymentMode:
        type: string
        example: 'enum: POSTPAID | PREPAID — M'
        required: false
      creditLimit:
        type: string
        example: number — O
        required: false
      billingCycleId:
        type: string
        example: string default '-1' — M
        required: false
  service:
    type: object
    properties:
      externalId:
        type: string
        example: string — M — prodInstId en ZSmart
        required: false
      productCode:
        type: string
        example: string — M — PSTN | DSL | GPON | IPTV...
        required: false
      areaCode:
        type: string
        example: 'string — M — ej: 601'
        required: false
      serviceNumber:
        type: string
        example: string — M — sin prefijo
        required: false
      effectiveDate:
        type: string
        example: string YYYYMMDDHHMMSS — M
        required: false
      offerCode:
        type: string
        example: string — M — código plan principal
        required: false
      offerInstanceId:
        type: string
        example: string — M — ID instancia oferta CRM
        required: false
      charges:
        type: array
        items:
          type: object
          properties:
            type:
              type: string
              example: 'enum: ONE_OFF | DEPOSIT | ADVANCE — O'
              required: false
            amount:
              type: string
              example: number — O
              required: false
            itemTypeCode:
              type: string
              example: string — M si hay cargos
              required: false
