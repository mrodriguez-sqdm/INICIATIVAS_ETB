#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SALE
description: |
  New Connection. ZSmart sequence: F2 (customer + account) -> A1 (service).
  billing-papi resolves: serviceEventId, operate, statusCd, paymentModeCd mapping,
  chargeType mapping, prodInstAcctRelList defaults, currencyId.
properties:
  processCode:
    type: string
    enum: [SALE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> Header.transactionId"
        example: TRX20260319001234
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYYMMDDHHMMSS. -> Header.createDate"
        example: '20260319100000'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> Header.orderItemId"
        example: OI20260319001234-001
        required: true
      contactChannel:
        type: string
        description: "Channel ID defined in ZSmart. -> Header.contactChannel"
        example: '1'
        required: false
      salesDepartment:
        type: string
        description: "DANE department code of sales agent. -> Header.salesDepartment"
        example: '11'
        required: false
      salesCity:
        type: string
        description: "DANE city code of sales agent. -> Header.salesCity"
        example: '11001'
        required: false
  customer:
    type: object
    required: true
    description: "New customer data. -> cust node (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM customer ID. -> cust.custId"
        example: '12345678'
        required: true
      typeFlag:
        type: string
        enum: ['1', '2']
        description: "1=Personal, 2=Business. -> cust.typeFlag"
        example: '1'
        required: true
      firstName:
        type: string
        description: "First name (individual). -> cust.First Name"
        example: Juan
        required: false
      lastName:
        type: string
        description: "Last name (individual). -> cust.Last Name"
        example: Perez
        required: false
      middleName:
        type: string
        description: "Middle name. -> cust.Middle Name"
        example: Carlos
        required: false
      secondLastName:
        type: string
        description: "Second last name. -> cust.2nd last Name"
        example: Gomez
        required: false
      custName:
        type: string
        description: "Business name (B2B only). -> cust.custName"
        example: Empresa SAS
        required: false
      nombreJuridico:
        type: string
        description: "Legal registered name (B2B). -> cust.Nombre Juridico"
        example: Empresa S.A.S.
        required: false
      docType:
        type: string
        description: "Document type. Mandatory for new customer. -> cust.Doc Type"
        example: CC
        required: false
      docNumber:
        type: string
        description: "Document number. Mandatory for new customer. -> cust.Doc Number"
        example: '1023456789'
        required: false
      birthday:
        type: string
        description: "Birth date yyyy-mm-dd. -> cust.Birthday"
        example: '1990-05-15'
        required: false
      gender:
        type: string
        description: "Male|Female|Company. -> cust.Gender"
        example: Male
        required: false
      contactPhone:
        type: string
        description: "Primary mobile phone. -> cust.Contact Phone"
        example: '3001234567'
        required: true
      email:
        type: string
        description: "Primary email. -> cust.Email"
        example: juan.perez@email.com
        required: true
      country:
        type: string
        description: "Country of residential address. -> cust.Country"
        example: Colombia
        required: true
      department:
        type: string
        description: "DANE department code. -> cust.Departament"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code. -> cust.City"
        example: '11001'
        required: true
      district:
        type: string
        description: "Locality/Commune. -> cust.District"
        example: Chapinero
        required: false
      address:
        type: string
        description: "Registered address. -> cust.Address"
        example: Cra 7 # 32-16
        required: false
      customerSegment:
        type: string
        description: "Customer segment. -> cust.Customer Segment"
        example: RESIDENCIAL
        required: true
      subsegmento:
        type: string
        description: "Customer subsegment. -> cust.Subsegmento"
        example: MASS
        required: true
      categoria:
        type: string
        description: "Gold|Silver|Bronze|Platinum. -> cust.Categoria"
        example: Bronze
        required: true
      habeasData:
        type: string
        description: "Data treatment consent Y/N. -> cust.Habeas Data"
        example: 'Y'
        required: true
  account:
    type: object
    required: true
    description: "New billing account. -> account node (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM account ID. -> account.acctId"
        example: ACC-001-2026
        required: false
      acctName:
        type: string
        description: "Account name. Auto-generated by ZSmart if omitted. -> account.acctName"
        example: Juan Perez 001
        required: false
      billDeliveryType:
        type: string
        description: "1=Email, 2=Post, 3=Whatsapp, 4=SMS, 5=Email+Post. Default 1. -> account.billDeliveryType"
        example: '1'
        required: false
      billingCycleId:
        type: string
        description: "Billing cycle (corte). Mandatory for postpaid. -> account.Corte"
        example: '15'
        required: false
      defaultAccount:
        type: string
        description: "Is default account: Yes/No. -> account.Default Account"
        example: 'Yes'
        required: true
      billFlag:
        type: string
        description: "Payment responsible: Yes/No. -> account.Bill Flag"
        example: 'Yes'
        required: true
      country:
        type: string
        description: "Country. -> account.Country"
        example: Colombia
        required: true
      department:
        type: string
        description: "DANE department code. -> account.Departament"
        example: '11'
        required: true
      city:
        type: string
        description: "DANE city code. -> account.City"
        example: '11001'
        required: true
      district:
        type: string
        description: "Locality/Commune. -> account.District"
        example: Chapinero
        required: false
      address:
        type: string
        description: "Account address. -> account.Address"
        example: Cra 7 # 32-16
        required: false
      taxExempt:
        type: string
        description: "Tax exempt: Yes/No. -> account.TaxExempt"
        example: 'No'
        required: false
      paymentTerm:
        type: string
        description: "Payment period days. Default 0. -> account.PaymentTerm"
        example: '0'
        required: false
  service:
    type: object
    required: true
    description: "Service instance. -> billProdInstHisList (operate=A) + billOfferInstList (operate=A) + prodInstAcctRelList (operate=A)"
    properties:
      externalId:
        type: string
        description: "CRM product instance ID. -> billProdInstHis.prodInstId"
        example: '98765'
        required: true
      productCode:
        type: string
        description: "Main product code: PSTN|DSL|GPON|IPTV... -> billProdInstHis.prodCode"
        example: PSTN
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. -> billProdInstHis.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInstHis.serviceNumber"
        example: '5551234'
        required: true
      paymentMode:
        type: string
        enum: [POSTPAID, PREPAID]
        description: "billing-papi maps POSTPAID->1200, PREPAID->2100. -> billProdInstHis.paymentModeCd"
        example: POSTPAID
        required: true
      effectiveDate:
        type: string
        description: "Service effective date YYYYMMDDHHMMSS. -> billProdInstHis.effDate"
        example: '20260319100000'
        required: false
      offerCode:
        type: string
        description: "Main offer code. -> billProdInstHis.offerCode"
        example: PLAN_PSTN_100
        required: true
      offerInstanceId:
        type: string
        description: "CRM offer instance ID. -> billOfferInstList.offerInstId"
        example: OFFER-2026-001
        required: true
      department:
        type: string
        description: "DANE department where service is installed (O in ZSmart). -> billProdInstHis.Department"
        example: '11'
        required: false
      city:
        type: string
        description: "DANE city where service is installed (O in ZSmart). -> billProdInstHis.City"
        example: '11001'
        required: false
      address:
        type: string
        description: "Address where service is installed (O in ZSmart). -> billProdInstHis.Address"
        example: Cra 7 # 32-16
        required: false
      charges:
        type: array
        required: false
        minItems: 1
        description: "One-off or advance charges. -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> chargeList.chargeType"
              example: ONE_OFF
              required: false
            amount:
              type: string
              description: "Charge amount in PESO. -> chargeList.basicCharge"
              example: '15000'
              required: false
            itemTypeCode:
              type: string
              description: "Account item type code. -> chargeList.acctItemTypeCode"
              example: CONN_FEE
              required: false
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> chargeList.paidFlag"
              example: 'N'
              required: false