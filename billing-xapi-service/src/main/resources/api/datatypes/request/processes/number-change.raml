#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: NUMBER_CHANGE
description: |
  Change service number (same exchange). ZSmart operation: A7.
  billing-papi resolves: serviceEventId=A7, operate=M, statusCd, paymentModeCd mapping,
  billOfferInstList (operate=D for current offer, operate=A for new offer),
  ownerCustId from custId, currencyId.
  Note: Address change with number change (A4/A5) is out of scope — pending future processCode ADDRESS_CHANGE.
properties:
  processCode:
    type: string
    enum: [NUMBER_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> Header.transactionId"
        example: TRX20260319006789
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYYMMDDHHMMSS. -> Header.createDate"
        example: '20260319100000'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> Header.orderItemId"
        example: OI20260319006789-001
        required: true
      contactChannel:
        type: string
        description: "Channel ID. -> Header.contactChannel"
        example: '1'
        required: false
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> Header.custId / billProdInst.ownerCustId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=M) + billOfferInstList (operate=D then operate=A)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> Header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      productCode:
        type: string
        description: "Main product code. -> billProdInst.prodCode"
        example: PSTN
        required: true
      paymentMode:
        type: string
        enum: [POSTPAID, PREPAID]
        description: "billing-papi maps POSTPAID->1200, PREPAID->2100. -> billProdInst.paymentModeCd"
        example: POSTPAID
        required: true
      offerCode:
        type: string
        description: "Active offer code. -> billProdInst.offerCode + billOfferInstList[operate=D].offerCode"
        example: PLAN_PSTN_100
        required: true
      offerInstanceId:
        type: string
        description: "ZSmart instance ID of the active offer (tracked by CRM). -> billOfferInstList[operate=D].offerInstId"
        example: OFFER-2026-001
        required: true
      newOfferInstanceId:
        type: string
        description: "New offer instance ID generated by CRM. -> billOfferInstList[operate=A].offerInstId"
        example: OFFER-2026-010
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYYMMDDHHMMSS. -> billProdInst.effDate"
        example: '20260319100000'
        required: false
      newNumber:
        type: object
        required: true
        description: "New number to assign. -> billProdInst.areaCode + billProdInst.serviceNumber"
        properties:
          areaCode:
            type: string
            description: "New area code prefix. -> billProdInst.areaCode"
            example: '601'
            required: true
          serviceNumber:
            type: string
            description: "New service number without prefix. -> billProdInst.serviceNumber"
            example: '5559999'
            required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "-> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> chargeList.chargeType"
              example: ONE_OFF
              required: false
            amount:
              type: string
              description: "Charge amount in PESO. -> chargeList.basicCharge"
              example: '8000'
              required: false
            itemTypeCode:
              type: string
              description: "-> chargeList.acctItemTypeCode"
              example: NUM_CHANGE_FEE
              required: false
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> chargeList.paidFlag"
              example: 'N'
              required: false