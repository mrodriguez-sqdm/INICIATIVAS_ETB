#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SUSPENSION
description: |
  Suspend service (Two-Way Block). ZSmart operation: B4.
  billing-papi resolves: serviceEventId, operate=M, statusCd=120002, stopType=150000,
  paymentModeCd mapping, ownerCustId from custId, currencyId.
properties:
  processCode:
    type: string
    enum: [SUSPENSION]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> Header.transactionId"
        example: TRX20260319004567
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYYMMDDHHMMSS. -> Header.createDate"
        example: '20260319100000'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> Header.orderItemId"
        example: OI20260319004567-001
        required: true
      contactChannel:
        type: string
        description: "Channel ID. -> Header.contactChannel"
        example: '1'
        required: false
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> Header.custId / billProdInstHis.ownerCustId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInstHis (operate=M, statusCd=120002)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> Header.prodInstId / billProdInstHis.prodInstId"
        example: '98765'
        required: true
      productCode:
        type: string
        description: "Main product code. -> billProdInstHis.prodCode"
        example: PSTN
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. -> billProdInstHis.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInstHis.serviceNumber"
        example: '5551234'
        required: true
      paymentMode:
        type: string
        enum: [POSTPAID, PREPAID]
        description: "billing-papi maps POSTPAID->1200, PREPAID->2100. -> billProdInstHis.paymentModeCd"
        example: POSTPAID
        required: true
      offerCode:
        type: string
        description: "Active offer code. Required by ZSmart billProdInstHis structure on any status change. -> billProdInstHis.offerCode"
        example: PLAN_PSTN_100
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYYMMDDHHMMSS. -> billProdInstHis.effDate"
        example: '20260319100000'
        required: false
      charges:
        type: array
        required: false
        minItems: 1
        description: "-> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> chargeList.chargeType"
              example: ONE_OFF
              required: false
            amount:
              type: string
              description: "Charge amount in PESO. -> chargeList.basicCharge"
              example: '0'
              required: false
            itemTypeCode:
              type: string
              description: "-> chargeList.acctItemTypeCode"
              example: SUSPENSION_FEE
              required: false
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> chargeList.paidFlag"
              example: 'N'
              required: false