#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: SVA
description: |
  Add/Remove Value-Added Services. ZSmart operation: B6.
  billing-papi resolves: serviceEventId, operate per item (A=addition, D=removal),
  billOfferInstList.instanceId (from prodInstId), billOfferInstList.statusCd (1000=add, 1100=remove),
  currencyId.
  At least one of additions or removals must be present.
properties:
  processCode:
    type: string
    enum: [SVA]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> Header.transactionId"
        example: TRX20260319003456
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYYMMDDHHMMSS. -> Header.createDate"
        example: '20260319100000'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> Header.orderItemId"
        example: OI20260319003456-001
        required: true
      contactChannel:
        type: string
        description: "Channel ID. -> Header.contactChannel"
        example: '1'
        required: false
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> Header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billOfferInstList (operate=A for additions, operate=D for removals)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> Header.prodInstId / billOfferInstList.instanceId"
        example: '98765'
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYYMMDDHHMMSS. -> billOfferInstList.effDate"
        example: '20260319100000'
        required: false
      additions:
        type: array
        required: false
        description: "SVAs to add. -> billOfferInstList (operate=A, statusCd=1000)"
        items:
          type: object
          properties:
            offerCode:
              type: string
              description: "SVA offer code. -> billOfferInstList.offerCode"
              example: SVA_VOICEMAIL
              required: true
            offerInstanceId:
              type: string
              description: "CRM offer instance ID. -> billOfferInstList.offerInstId"
              example: SVA-INST-2026-001
              required: true
      removals:
        type: array
        required: false
        description: "SVAs to remove. -> billOfferInstList (operate=D, statusCd=1100)"
        items:
          type: object
          properties:
            offerCode:
              type: string
              description: "SVA offer code to remove. -> billOfferInstList.offerCode"
              example: SVA_CALLWAIT
              required: true
            offerInstanceId:
              type: string
              description: "ZSmart instance ID of the SVA (tracked by CRM). -> billOfferInstList.offerInstId"
              example: SVA-INST-2025-099
              required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "-> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> chargeList.chargeType"
              example: ONE_OFF
              required: false
            amount:
              type: string
              description: "Charge amount in PESO. -> chargeList.basicCharge"
              example: '3000'
              required: false
            itemTypeCode:
              type: string
              description: "-> chargeList.acctItemTypeCode"
              example: SVA_ADD_FEE
              required: false
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> chargeList.paidFlag"
              example: 'N'
              required: false