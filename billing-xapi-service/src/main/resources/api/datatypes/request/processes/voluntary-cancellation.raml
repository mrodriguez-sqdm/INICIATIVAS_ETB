#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: VOLUNTARY_CANCELLATION
description: |
  Permanent service termination. ZSmart operation: A8.
  billing-papi resolves: serviceEventId=A8, operate=D, statusCd=110000,
  billOfferInstList (operate=D, statusCd=1100), prodInstAcctRelList (operate=D, statusCd=2),
  paymentModeCd mapping, ownerCustId from custId, currencyId.
properties:
  processCode:
    type: string
    enum: [VOLUNTARY_CANCELLATION]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> Header.transactionId"
        example: TRX20260319007890
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYYMMDDHHMMSS. -> Header.createDate"
        example: '20260319100000'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> Header.orderItemId"
        example: OI20260319007890-001
        required: true
      contactChannel:
        type: string
        description: "Channel ID. -> Header.contactChannel"
        example: '1'
        required: false
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> Header.custId / billProdInst.ownerCustId"
        example: '12345678'
        required: true
  account:
    type: object
    required: true
    description: "Required to delete prodInstAcctRelList. -> Header.acctId"
    properties:
      externalId:
        type: string
        description: "ZSmart billing account ID. -> Header.acctId / prodInstAcctRelList.acctId"
        example: '14000001234'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=D) + billOfferInstList (operate=D) + prodInstAcctRelList (operate=D)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> Header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      productCode:
        type: string
        description: "Main product code. -> billProdInst.prodCode"
        example: PSTN
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      paymentMode:
        type: string
        enum: [POSTPAID, PREPAID]
        description: "billing-papi maps POSTPAID->1200, PREPAID->2100. -> billProdInst.paymentModeCd"
        example: POSTPAID
        required: true
      offerCode:
        type: string
        description: "Active offer code to terminate. -> billProdInst.offerCode + billOfferInstList[operate=D].offerCode"
        example: PLAN_PSTN_100
        required: true
      offerInstanceId:
        type: string
        description: "ZSmart instance ID of the active offer (tracked by CRM). -> billOfferInstList[operate=D].offerInstId"
        example: OFFER-2026-001
        required: true
      effectiveDate:
        type: string
        description: "Termination effective date YYYYMMDDHHMMSS. -> billProdInst.effDate"
        example: '20260319100000'
        required: false
      charges:
        type: array
        required: false
        minItems: 1
        description: "Final charges (e.g. early termination fee). -> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> chargeList.chargeType"
              example: ONE_OFF
              required: false
            amount:
              type: string
              description: "Charge amount in PESO. -> chargeList.basicCharge"
              example: '0'
              required: false
            itemTypeCode:
              type: string
              description: "-> chargeList.acctItemTypeCode"
              example: CANCELLATION_FEE
              required: false
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> chargeList.paidFlag"
              example: 'N'
              required: false
  confirmation:
    type: object
    required: true
    description: "Explicit confirmation required before executing irreversible termination"
    properties:
      confirmed:
        type: boolean
        description: "Must be true to proceed with cancellation"
        example: true
        required: true
      reason:
        type: string
        description: "Cancellation reason provided by the customer"
        example: Cliente solicita baja del servicio por traslado
        required: true