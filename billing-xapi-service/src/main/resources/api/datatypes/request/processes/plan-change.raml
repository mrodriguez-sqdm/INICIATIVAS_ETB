#%RAML 1.0 DataType
type: !include ../billing-process-base.raml
discriminatorValue: PLAN_CHANGE
description: |
  Change Plan (Pre to Post, Post to Pre). ZSmart operation: C6.
  billing-papi resolves: serviceEventId, operate, billOfferInstList statusCd and instanceId,
  paymentModeCd mapping, statusCd of billProdInst, currencyId.
properties:
  processCode:
    type: string
    enum: [PLAN_CHANGE]
    required: true
  transaction:
    type: object
    required: true
    properties:
      id:
        type: string
        description: "Unique transaction ID. -> Header.transactionId"
        example: TRX20260319002345
        required: true
      timestamp:
        type: string
        description: "Operation timestamp YYYYMMDDHHMMSS. -> Header.createDate"
        example: '20260319100000'
        required: true
      orderItemId:
        type: string
        description: "CRM order item ID. -> Header.orderItemId"
        example: OI20260319002345-001
        required: true
      contactChannel:
        type: string
        description: "Channel ID. -> Header.contactChannel"
        example: '1'
        required: false
  customer:
    type: object
    required: true
    properties:
      externalId:
        type: string
        description: "ZSmart customer ID. -> Header.custId"
        example: '12345678'
        required: true
  service:
    type: object
    required: true
    description: "-> billProdInst (operate=M) + billOfferInstList (operate=D then operate=A)"
    properties:
      externalId:
        type: string
        description: "ZSmart product instance ID. -> Header.prodInstId / billProdInst.prodInstId"
        example: '98765'
        required: true
      productCode:
        type: string
        description: "Main product code. -> billProdInst.prodCode"
        example: PSTN
        required: true
      areaCode:
        type: string
        description: "Service number area prefix. -> billProdInst.areaCode"
        example: '601'
        required: true
      serviceNumber:
        type: string
        description: "Service number without prefix. -> billProdInst.serviceNumber"
        example: '5551234'
        required: true
      paymentMode:
        type: string
        enum: [POSTPAID, PREPAID]
        description: "billing-papi maps POSTPAID->1200, PREPAID->2100. -> billProdInst.paymentModeCd"
        example: POSTPAID
        required: true
      effectiveDate:
        type: string
        description: "Effective date YYYYMMDDHHMMSS. -> billProdInst.effDate"
        example: '20260319100000'
        required: false
      currentOfferCode:
        type: string
        description: "Active offer code to be removed. -> billOfferInstList[operate=D].offerCode"
        example: PLAN_PSTN_100
        required: true
      currentOfferInstanceId:
        type: string
        description: "ZSmart instance ID of the active offer (tracked by CRM). -> billOfferInstList[operate=D].offerInstId"
        example: OFFER-2026-001
        required: true
      newOfferCode:
        type: string
        description: "New offer code to activate. -> billProdInst.offerCode + billOfferInstList[operate=A].offerCode"
        example: PLAN_PSTN_200
        required: true
      newOfferInstanceId:
        type: string
        description: "New offer instance ID generated by CRM. -> billOfferInstList[operate=A].offerInstId"
        example: OFFER-2026-002
        required: true
      charges:
        type: array
        required: false
        minItems: 1
        description: "-> chargeList node"
        items:
          type: object
          properties:
            type:
              type: string
              enum: [ONE_OFF, ADVANCE]
              description: "billing-papi maps ONE_OFF->1, ADVANCE->7. -> chargeList.chargeType"
              example: ONE_OFF
              required: false
            amount:
              type: string
              description: "Charge amount in PESO. -> chargeList.basicCharge"
              example: '5000'
              required: false
            itemTypeCode:
              type: string
              description: "-> chargeList.acctItemTypeCode"
              example: PLAN_CHANGE_FEE
              required: false
            paidFlag:
              type: string
              enum: ['Y', 'N']
              description: "Y=paid in CRM, N=collect in ZSmart. -> chargeList.paidFlag"
              example: 'N'
              required: false