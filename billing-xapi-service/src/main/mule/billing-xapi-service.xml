<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
	
<flow name="billing-xapi-service-main">
        <http:listener config-ref="billing-xapi-service-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="billing-xapi-service-config" />
		<error-handler ref="common-error-handler-v2" />
    
</flow>
    <flow name="billing-xapi-service-console">
        <http:listener config-ref="billing-xapi-service-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="billing-xapi-service-config" />
    </flow>
    <flow name="get:\health:billing-xapi-service-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "UP",
  timestamp: "2026-03-16T10:00:00Z"
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="post:\billing-process:application\json:billing-xapi-service-config">
        <choice doc:name="Choice" doc:id="94e17461-a35a-406c-9d20-519a05904344" >
			<when expression='#[payload.processCode == "SALE"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
"transactionId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
"status": "SUCCESS",
"createdAt": "2026-03-16T10:30:05Z",
"result": {
"customerId": "12345678",
"accountId": "ACC-001-2026",
"serviceId": "98765",
"zsmartResponseCode": "0",
"zsmartMessage": "Success"
}
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<when expression='#[payload.processCode == "NUMBER_CHANGE"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "transactionId": "f6a7b8c9-d0e1-2345-fabc-345678901234",
  "status": "SUCCESS",
  "updatedAt": "2026-03-19T10:00:01Z",
  "result": {
    "customerId": "12345678",
    "serviceId": "98765",
    "serviceOfferId": "A7",
    "newAreaCode": "601",
    "newServiceNumber": "5559999",
    "zsmartResponseCode": "0",
    "zsmartMessage": "Success"
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<when expression='#[payload.processCode == "PLAN_CHANGE"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "transactionId": "7bc91f32-3a4d-4891-b1fa-9e8d7c5af021",
  "status": "SUCCESS",
  "updatedAt": "2026-03-16T14:00:03Z",
  "result": {
    "customerId": "12345678",
    "serviceId": "98765",
    "previousOfferCode": "GPON_300MB_BASIC",
    "newOfferCode": "GPON_500MB_PLUS",
    "zsmartResponseCode": "0",
    "zsmartMessage": "Success"
  }
}
 as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<when expression='#[payload.processCode == "RESTORATION"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "transactionId": "e5f6a7b8-c9d0-1234-efab-234567890123",
  "status": "SUCCESS",
  "updatedAt": "2026-03-19T10:00:01Z",
  "result": {
    "customerId": "12345678",
    "serviceId": "98765",
    "serviceStatus": "ACTIVE",
    "zsmartResponseCode": "0",
    "zsmartMessage": "Success"
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<when expression='#[payload.processCode == "SUSPENSION"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "transactionId": "d4e5f6a7-b8c9-0123-defa-123456789012",
  "status": "SUCCESS",
  "updatedAt": "2026-03-19T10:00:01Z",
  "result": {
    "customerId": "12345678",
    "serviceId": "98765",
    "serviceStatus": "SUSPENDED",
    "zsmartResponseCode": "0",
    "zsmartMessage": "Success"
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<when expression='#[payload.processCode == "SVA"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "transactionId": "c3d4e5f6-a7b8-9012-cdef-012345678901",
  "status": "SUCCESS",
  "updatedAt": "2026-03-19T10:00:01Z",
  "result": {
    "customerId": "12345678",
    "serviceId": "98765",
    "added": [
      { "itemTypeCode": "SVA_VOICEMAIL" }
    ],
    "removed": [
      { "itemTypeCode": "SVA_CALLWAIT" }
    ],
    "zsmartResponseCode": "0",
    "zsmartMessage": "Success"
  }
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<when expression='#[payload.processCode == "VOLUNTARY_CANCELLATION"]'>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "transactionId": "a7b8c9d0-e1f2-3456-abcd-456789012345",
  "status": "SUCCESS",
  "updatedAt": "2026-03-19T10:00:01Z",
  "result": {
    "customerId": "12345678",
    "accountId": "ACC-001-2026",
    "serviceId": "98765",
    "finalStatus": "TERMINATED",
    "zsmartResponseCode": "0",
    "zsmartMessage": "Success"
  }
}as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
		</choice>
    </flow>	
	
	
</mule>
